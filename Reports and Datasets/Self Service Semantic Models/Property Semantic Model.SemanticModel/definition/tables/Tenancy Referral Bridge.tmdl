	/// Referrer name with internal-transfer inheritance. Returns the row's own Referrer Name when populated. When blank (typical for internal transfers), inherits the Referrer Name of the same client's prior referral with the latest discharge date among those whose accepted date is on or after this chain's start date minus 3 days and whose discharge date is on or before this referral's accepted date; blank if none qualifies.
	column 'Effective Referrer Name' =
			VAR _CurrentReferrerName = 'Tenancy Referral Bridge'[Referrer Name]
			VAR _CurrentAccepted = 'Tenancy Referral Bridge'[Referral Accepted Date]
			VAR _CurrentClientID = 'Tenancy Referral Bridge'[Referral Tangata Whaiora ID]
			VAR _ChainStart = 'Tenancy Referral Bridge'[Chain Start Date]
			VAR _InheritedName =
			    MAXX(
			        TOPN(
			            1,
			            FILTER(
			                ALL('Transitional Housing Referrals'),
			                'Transitional Housing Referrals'[Tangata Whaiora ID] = _CurrentClientID &&
			                NOT(ISBLANK('Transitional Housing Referrals'[Tangata Whaiora Referrer Name])) &&
			                NOT(ISBLANK('Transitional Housing Referrals'[Tangata Whaiora Referral Discharge Date])) &&
			                'Transitional Housing Referrals'[Tangata Whaiora Referral Accepted Date] >= _ChainStart - 3 &&
			                'Transitional Housing Referrals'[Tangata Whaiora Referral Discharge Date] <= _CurrentAccepted
			            ),
			            'Transitional Housing Referrals'[Tangata Whaiora Referral Discharge Date], DESC
			        ),
			        'Transitional Housing Referrals'[Tangata Whaiora Referrer Name]
			    )
			RETURN
			    IF(
			        NOT(ISBLANK(_CurrentReferrerName)),
			        _CurrentReferrerName,
			        _InheritedName
			    )
		dataType: string
		lineageTag: 68e315b5-5d41-460c-967f-9cf96e9112c7
		summarizeBy: none

	column 'Chain Start Date'
