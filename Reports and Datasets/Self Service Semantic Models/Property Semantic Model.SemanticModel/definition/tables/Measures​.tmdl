	/// Total outstanding aged-debt balance - SUM of 'Aged Debt'[Total Balance] across all ageing buckets. Snapshot measure: the Aged Debt fact holds multiple monthly snapshots, so slice to a single snapshot ('Aged Debt'[Current Date] = "Today", or one As At Year Month) or it sums across every snapshot. Does not respond to the Date Table slicer. A negative balance is an amount owed by the tenant.
	measure 'Total Outstanding' = SUM('Aged Debt'[Total Balance])
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Aged Debt
		lineageTag: 4e07c46f-d384-40c6-900b-c9557e46d951

		annotation PBI_FormatHint = {"currencyCulture":"en-NZ"}

	/// Count of distinct tenancies ('Aged Debt'[Property Tenancy ID]) that are BOTH net-overdue and net-in-debt in the aged-debt snapshot: the sum of the 7-14 through 91+ day buckets is negative (amount owed) AND Total Balance is negative. Excludes the Current 0-6 day bucket from 'overdue'. Snapshot measure - slice the Aged Debt fact to a single snapshot ('Aged Debt'[Current Date] = "Today", or one As At Year Month) or the per-tenancy sums combine across all stored monthly snapshots. Does not respond to the Date Table slicer.
	measure 'Tenancies Overdue Count' =
			VAR TenanciesWithBalances =
			    ADDCOLUMNS(
			        VALUES('Aged Debt'[Property Tenancy ID]),
			        "@NetOverdueAmount",
			            CALCULATE(
			                SUM('Aged Debt'[7-14 Days])
			                    + SUM('Aged Debt'[15-21 Days])
			                    + SUM('Aged Debt'[22-28 Days])
			                    + SUM('Aged Debt'[29-60 Days])
			                    + SUM('Aged Debt'[61-90 Days])
			                    + SUM('Aged Debt'[91 Plus Days])
			            ),
			        "@TotalBalance",
			            CALCULATE(SUM('Aged Debt'[Total Balance]))
			    )
			RETURN
			    COUNTROWS(
			        FILTER(
			            TenanciesWithBalances,
			            [@NetOverdueAmount] < 0
			                && [@TotalBalance] < 0
			        )
			    )
		formatString: #,0
		displayFolder: 04. Financial\Aged Debt
		lineageTag: 9997dd6a-2758-4691-a89f-1a639ade25e9

		annotation PBI_FormatHint = {"isDecimal":true}

	/// Distinct count of tenancies ('Aged Debt'[Property Tenancy ID]) flagged No Recent Payment = TRUE in the aged-debt snapshot. IMPORTANT: the No Recent Payment flag is only ever set TRUE on the latest snapshot ('Aged Debt'[Current Date] = "Today"); on every historical monthly snapshot the flag is left blank/unset (null), never TRUE. Consequently this measure returns a value only for the latest snapshot and in neutral (no-slicer) context, and is BLANK for any earlier As At Date / As At Year Month selection - do not use it in a month-over-month trend. Counts by the distinct tenancy key so counts are accurate. Does not respond to the Date Table slicer.
	measure 'No Recent Payment Count' =
			CALCULATE(
			    DISTINCTCOUNT('Aged Debt'[Property Tenancy ID]),
			    'Aged Debt'[No Recent Payment] = TRUE()
			)
		formatString: #,0
		displayFolder: 04. Financial\Aged Debt
		lineageTag: fa27e790-a26b-4f2a-a35f-ee895abd86f0

	/// Text helper for the Aged Debt report: builds a human-readable summary of the filters currently applied, for display on a report card or title. When filtered, reports Property Program, Sub Program, Service Region, Service District, Property Service, Tenancy Manager, Charge Type, Has No Overall Debt, No Recent Payment, Tenancy Status, and the As At Date range; segments are joined with ' | '. Returns 'No filters applied' when none of these are filtered. Presentation-only (no numeric aggregation); ignores the disconnected central Date Table.
	measure 'Aged Debt Filters Applied' =
			VAR PropertyProgram =
			    IF(
			        ISFILTERED('Property'[Program]),
			        "Program: " & CONCATENATEX(VALUES('Property'[Program]), 'Property'[Program], ", "),
			        BLANK()
			    )
			VAR PropertySubProgram =
			    IF(
			        ISFILTERED('Property'[Sub Program]),
			        "Sub Program: " & CONCATENATEX(VALUES('Property'[Sub Program]), 'Property'[Sub Program], ", "),
			        BLANK()
			    )
			VAR ServiceRegion =
			    IF(
			        ISFILTERED('Property'[Service Region]),
			        "Region: " & CONCATENATEX(VALUES('Property'[Service Region]), 'Property'[Service Region], ", "),
			        BLANK()
			    )
			VAR ServiceDistrict =
			    IF(
			        ISFILTERED('Property'[Service District]),
			        "District: " & CONCATENATEX(VALUES('Property'[Service District]), 'Property'[Service District], ", "),
			        BLANK()
			    )
			VAR PropertyService =
			    IF(
			        ISFILTERED('Property'[Property Service Name]),
			        "Service: " & CONCATENATEX(VALUES('Property'[Property Service Name]), 'Property'[Property Service Name], ", "),
			        BLANK()
			    )
			VAR TenancyManager =
			    IF(
			        ISFILTERED('Tenancy'[Tenancy Manager]),
			        "Tenancy Manager: " & CONCATENATEX(VALUES('Tenancy'[Tenancy Manager]), 'Tenancy'[Tenancy Manager], ", "),
			        BLANK()
			    )
			VAR ChargeType =
			    IF(
			        ISFILTERED('Aged Debt'[Charge Type]),
			        "Charge Type: " & CONCATENATEX(VALUES('Aged Debt'[Charge Type]), 'Aged Debt'[Charge Type], ", "),
			        BLANK()
			    )
			VAR DebtStatus =
			    IF(
			        ISFILTERED('Aged Debt'[Has No Overall Debt]),
			        "Has No Overall Debt: " & CONCATENATEX(VALUES('Aged Debt'[Has No Overall Debt]), 'Aged Debt'[Has No Overall Debt], ", "),
			        BLANK()
			    )
			VAR RecentPayment =
			    IF(
			        ISFILTERED('Aged Debt'[No Recent Payment]),
			        "No Recent Payment: " & CONCATENATEX(VALUES('Aged Debt'[No Recent Payment]), IF('Aged Debt'[No Recent Payment], "True", "False"), ", "),
			        BLANK()
			    )
			VAR TenancyStatus =
			    IF(
			        ISFILTERED('Tenancy'[Tenancy Status]),
			        "Tenancy Status: " & CONCATENATEX(VALUES('Tenancy'[Tenancy Status]), 'Tenancy'[Tenancy Status], ", "),
			        BLANK()
			    )
			VAR AsAtDate =
			    IF(
			        ISFILTERED('Aged Debt'[As At Date])
			            || ISFILTERED('Aged Debt'[As At Year])
			            || ISFILTERED('Aged Debt'[As At Month])
			            || ISFILTERED('Aged Debt'[As At Month Name Short])
			            || ISFILTERED('Aged Debt'[As At Year Month])
			            || ISFILTERED('Aged Debt'[Current Date]),
			        "As At Date: " & FORMAT(MIN('Aged Debt'[As At Date]), "d mmm yyyy") & " - " & FORMAT(MAX('Aged Debt'[As At Date]), "d mmm yyyy"),
			        BLANK()
			    )
			VAR AppliedFilters =
			    FILTER(
			        {
			            PropertyProgram,
			            PropertySubProgram,
			            ServiceRegion,
			            ServiceDistrict,
			            PropertyService,
			            TenancyManager,
			            ChargeType,
			            DebtStatus,
			            RecentPayment,
			            TenancyStatus,
			            AsAtDate
			        },
			        NOT ISBLANK([Value])
			    )
			RETURN
			    IF(
			        COUNTROWS(AppliedFilters) = 0,
			        "No filters applied",
			        CONCATENATEX(AppliedFilters, [Value], " | ")
			    )
		displayFolder: 04. Financial\Aged Debt
		lineageTag: 9349b138-545a-4ef7-8440-3bb593a19373

	/// Returns the tenancy name for the current single-tenancy row/selection (SELECTEDVALUE of 'Tenancy'[Tenancy Name]). Returns the raw, unmasked name - this is NOT a masked value; the Aged Debt tooltip uses Property Tenancy Tenancy Name Masked instead. Internal presentation helper, hidden from the field list.
	measure 'Selected Tenancy Name' = SELECTEDVALUE('Tenancy'[Tenancy Name])
		isHidden
		displayFolder: _Internal
		lineageTag: 09f71c9b-3788-4fc9-b491-fb20fd37ef20

	/// Returns 1 when the signed-in user (USERPRINCIPALNAME, trimmed and lower-cased) is listed in 'Executive Masking', otherwise 0. Drives the Waharoa Aged Debt masking through Is Executive User (Aged Debt), the visual-level filter: visuals that show tenancy names keep = 0 and the Exec View visuals keep = 1, so executives see property names and tenancy IDs instead of tenant names. Presentation only, not security: the underlying columns stay readable through Build permission, and a sign-in name that does not match the list (an alias or a guest account) is treated as non-executive.
	measure 'Is Executive User' =
			VAR _User = LOWER(TRIM(USERPRINCIPALNAME()))
			RETURN
			    IF(CONTAINSROW(ALL('Executive Masking'[User Principal Name]), _User), 1, 0)
		formatString: 0
		isHidden
		displayFolder: _Internal
		lineageTag: a281f09e-4b25-46e6-a4b9-fa63863ea7ee

	/// Period occupancy rate for the same dates one year earlier. Shifts the Date Table window back 12 months and recomputes Occupancy Rate (Period) %. Needs a Date Table slicer to be meaningful.
	measure 'Occupancy Rate (Period) % PY' =
			VAR _PeriodStart = MIN('Date Table'[Calendar Date])
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			VAR _PYStart = EDATE(_PeriodStart, -12)
			VAR _PYEnd = EDATE(_PeriodEnd, -12)
			RETURN
			CALCULATE(
			    [Occupancy Rate (Period) %],
			    REMOVEFILTERS('Date Table'),
			    'Date Table'[Calendar Date] >= _PYStart,
			    'Date Table'[Calendar Date] <= _PYEnd
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 01. Property Portfolio\Date-Aware
		lineageTag: 9c497b08-3321-464e-b4c3-ad550bd7d376

	/// Year-on-year change in period occupancy rate, in percentage points (current minus prior year). Read the % as points. Pair with Occupancy Rate (Period) %.
	measure 'Occupancy Rate (Period) % YoY pts' = [Occupancy Rate (Period) %] - [Occupancy Rate (Period) % PY]
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 01. Property Portfolio\Date-Aware
		lineageTag: 570d8676-dfc9-4425-b407-bed0b3e117c0

	/// Day-weighted vacancy rate for the selected period (Period: responds to the Date Table slicer, NZ FY 1 Jul-30 Jun): Unoccupied Days (Period) over Available Property Days (Period), across all programs. Because Unoccupied Days is floored at zero, this is the exact complement of Occupancy Rate (Period) % only where occupancy is at or below 100% (portfolio/aggregate levels, where the two sum to 100%); where concurrent tenancies push a single property's occupancy above 100% the vacancy floors at 0 and the two no longer sum to 100%.
	measure 'Vacancy Rate (Period) %' = DIVIDE([Unoccupied Days (Period)], [Available Property Days (Period)], 0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 01. Property Portfolio\Date-Aware
		lineageTag: 7f30d610-f91a-4ef2-8042-ce725aa56e51

	/// Count of properties in the active portfolio (Acquired on/before the reference date and not yet disposed per Confirmed Disposal Date) that have been continuously unoccupied for more than 30 elapsed days as at the end of the selected Date-Table period; when no date is selected the reference date is today. Excludes cancelled tenancies; a property never tenanted is measured from its Acquired Date. Days are elapsed (exclusive, no +1), so a boundary case can differ by one day from cumulative period measures. Generalises the trusted TH >20-day void pattern to all programs.
	measure 'Properties Vacant Over 30 Days (Period End)' =
			VAR _IsDateFiltered = ISFILTERED('Date Table')
			VAR _AsAtDate = IF(_IsDateFiltered, MAX('Date Table'[Calendar Date]), TODAY())
			VAR _ActiveProperties =
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= _AsAtDate &&
			        (ISBLANK('Property'[Confirmed Disposal Date]) || 'Property'[Confirmed Disposal Date] >= _AsAtDate)
			    )
			RETURN
			SUMX(
			    _ActiveProperties,
			    VAR _PropertyTenancies =
			        FILTER(
			            RELATEDTABLE('Tenancy'),
			            'Tenancy'[Tenancy Status] <> "Cancelled" &&
			            'Tenancy'[Tenancy Start Date] <= _AsAtDate
			        )
			    VAR _HasActiveTenancy =
			        COUNTROWS(
			            FILTER(
			                _PropertyTenancies,
			                ISBLANK('Tenancy'[Vacated Date]) || 'Tenancy'[Vacated Date] >= _AsAtDate
			            )
			        ) > 0
			    VAR _LastVacatedDate =
			        MAXX(
			            FILTER(
			                _PropertyTenancies,
			                NOT(ISBLANK('Tenancy'[Vacated Date])) && 'Tenancy'[Vacated Date] <= _AsAtDate
			            ),
			            'Tenancy'[Vacated Date]
			        )
			    VAR _UnoccupiedSince =
			        IF(
			            _HasActiveTenancy,
			            BLANK(),
			            IF(ISBLANK(_LastVacatedDate), 'Property'[Acquired Date], _LastVacatedDate)
			        )
			    VAR _UnoccupiedDays =
			        IF(ISBLANK(_UnoccupiedSince), 0, DATEDIFF(_UnoccupiedSince, _AsAtDate, DAY))
			    RETURN IF(_UnoccupiedDays > 30, 1, 0)
			)
		formatString: #,0
		displayFolder: 01. Property Portfolio\Date-Aware
		lineageTag: 383c7f8d-f90b-41fe-a05a-12f7a68d12d1

	/// Count of tenancies that started within the selected period (move-ins / lettings), including internal transfers. Excludes Cancelled. Sliceable by property attributes; unsliced returns all-time.
	measure 'Tenancies Started (Period)' =
			VAR _PeriodStart = MIN('Date Table'[Calendar Date])
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			RETURN
			CALCULATE(
			    COUNTROWS('Tenancy'),
			    'Tenancy'[Tenancy Start Date] >= _PeriodStart,
			    'Tenancy'[Tenancy Start Date] <= _PeriodEnd,
			    'Tenancy'[Tenancy Status] <> "Cancelled"
			)
		formatString: #,0
		displayFolder: 02. Tenancy\Movement
		lineageTag: b4a5ec81-a61b-4dce-bad1-9a3377d231ad

	/// Count of tenancies that ended (tenant vacated) within the selected period, including internal transfers. Excludes Cancelled. Pair with Tenancies Started (Period) for churn.
	measure 'Tenancies Ended (Period)' =
			VAR _PeriodStart = MIN('Date Table'[Calendar Date])
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			RETURN
			CALCULATE(
			    COUNTROWS('Tenancy'),
			    'Tenancy'[Vacated Date] >= _PeriodStart,
			    'Tenancy'[Vacated Date] <= _PeriodEnd,
			    'Tenancy'[Tenancy Status] <> "Cancelled"
			)
		formatString: #,0
		displayFolder: 02. Tenancy\Movement
		lineageTag: 9e4f1128-2ecb-47bb-8e28-6be2823db756

	/// Tenancies started minus tenancies ended in the period. Positive = portfolio filling; negative = emptying. Internal transfers largely net out.
	measure 'Net Tenancy Movement (Period)' = [Tenancies Started (Period)] - [Tenancies Ended (Period)]
		formatString: #,0
		displayFolder: 02. Tenancy\Movement
		lineageTag: 50c632f7-b5e0-4ef7-b48a-56ab7617780f

	/// Tenancies ended in the period as a share of properties available in that period. Can exceed 100% for fast-cycling stock. Includes internal transfers. Responds to the Date Table slicer (both counts span the selected period). Covers all programs, not just Transitional Housing. Denominator is properties active during the period (Active Properties (Period)); numerator (Tenancies Ended (Period)) excludes Cancelled tenancies.
	measure 'Tenancy Turnover Rate (Period) %' = DIVIDE([Tenancies Ended (Period)], [Active Properties (Period)], 0)
		formatString: 0.0%
		displayFolder: 01. Property Portfolio\Date-Aware
		lineageTag: dbec48f5-723f-4dcc-a5b4-fffcb72fc5c2

	/// Current snapshot - ignores the Date Table slicer. People currently housed across the active portfolio (sum of Number Of Household Members for the PRIMARY tenant of each active tenancy - Tenancy Status New/Active/Active Arrears) as a share of total Maximum People Allowed To Reside. Currency is taken from Tenancy Status because Occupant Status is not populated for primary tenants. Household size is counted once per primary tenant; a property with concurrent active tenancies can exceed 100%. Grain still needs domain confirmation before the % is trusted.
	measure 'Capacity Utilisation Rate (Current) %' =
			VAR _ActiveProperties =
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= TODAY() &&
			        (ISBLANK('Property'[Confirmed Disposal Date]) || 'Property'[Confirmed Disposal Date] > TODAY())
			    )
			VAR _MaxCapacity = SUMX(_ActiveProperties, 'Property'[Maximum People Allowed To Reside])
			VAR _HouseholdMembers =
			    CALCULATE(
			        SUM('Tenant'[Number Of Household Members]),
			        KEEPFILTERS(_ActiveProperties),
			        'Tenant'[Is Primary Tenant] = 1,
			        'Tenancy'[Tenancy Status] IN {"New", "Active", "Active Arrears"}
			    )
			RETURN DIVIDE(_HouseholdMembers, _MaxCapacity, 0)
		formatString: 0.0%
		displayFolder: 01. Property Portfolio\Current Snapshot
		lineageTag: cb00e38f-aece-4629-a805-ca58464974d3

	/// New transitional-housing households (primary-tenant grain) that entered service over the rolling 12 months ending at the reference date; only the first tenancy of each continuous stay chain counts (Is New Chain = 1), so internal room or property moves are excluded, and Cancelled tenancies are excluded. Rolling-12-month equivalent of TH Households Entered (Period). Responds to the Date Table slicer - the 12 calendar months ending with the month of the latest selected date; defaults to the 12 calendar months ending with the current month when no date is selected. Chain identity depends on Tangata Whaiora ID, which is blank on much of the historical TH data, so entry counts for older windows are indicative.
	measure 'TH Households Entered (12M)' = VAR _IsDateFiltered = ISFILTERED('Date Table') VAR _ReferenceDate = IF(_IsDateFiltered, MAX('Date Table'[Calendar Date]), TODAY()) VAR _StartDate = EOMONTH(_ReferenceDate, -12) + 1 VAR _EndDate = EOMONTH(_ReferenceDate, 0) RETURN CALCULATE(COUNTROWS('Tenancy'), 'Property'[Program] = "Transitional Housing", 'Tenant'[Is Primary Tenant] = 1, 'Tenancy'[Tenancy Status] <> "Cancelled", 'Tenancy'[Tenancy Start Date] >= _StartDate, 'Tenancy'[Tenancy Start Date] <= _EndDate, 'Tenancy'[Is New Chain] = 1)
		formatString: #,0
		displayFolder: 09. THVM Dashboard\Service Flows
		lineageTag: 4692bff4-5db0-42d7-9e15-de9e32dfaf36

	/// Directional net-flow indicator over the rolling 12 months: new TH households entering (chain-start / primary-tenant grain via Is New Chain) minus GROSS TH tenancy exits (every non-internal-transfer tenancy vacate, counted at tenancy-row grain). The two sides are NOT the same grain: a household with two or more separate stays in the window counts as one entry but two or more exits, so this figure overstates exits and understates true household net flow. Treat as directional only, not a clean household in-minus-out count. Responds to the Date Table slicer; defaults to the current date if none selected. A grain-symmetric version requires a chain-end exit measure (see model note).
	measure 'TH Net Flow (Household Entries minus Gross Tenancy Exits) (12M)' = [TH Households Entered (12M)] - [TH Exits Last 12 Months]
		formatString: #,0
		displayFolder: 09. THVM Dashboard\Service Flows
		lineageTag: 37e12e1f-d7aa-465a-ad1a-7332792c97ea

	/// Of all Transitional Housing tenancy exits in the rolling 12 months (internal transfers excluded; exits whose outcome is Unclassified or blank stay in the count), the share whose exit outcome is Positive. Window: the 12 calendar months ending with the month of the latest selected date (the current month when none is selected). Exits are counted at tenancy-exit grain, not chain or household grain.
	measure 'TH Positive Exit Rate (12M) %' = DIVIDE([TH Positive Exits (12M)], [TH Exits Last 12 Months], BLANK())
		formatString: 0.0%
		displayFolder: 09. THVM Dashboard\Exits
		lineageTag: a77eb873-6160-432e-9d79-8b4d49cbfb7b

	/// Rolling-12-month TH positive-exit rate minus the target, expressed in percentage points (e.g. 0.056 = +5.6 pts above target). (Period): inherits the rate's window - responds to the Date Table slicer (12 months ending at the latest selected date) and defaults to the 12 months ending today when no date is selected; blank when there are no exits in the window. The 60% target is a BI placeholder - confirm against the HUD/MSD TH contract or board target before presenting.
	measure 'TH Positive Exit Rate (12M) vs Target %' =
			VAR _Target = 0.60
			VAR _Actual = [TH Positive Exit Rate (12M) %]
			RETURN IF(ISBLANK(_Actual), BLANK(), _Actual - _Target)
		formatString: 0.0%
		displayFolder: 09. THVM Dashboard\Exits
		lineageTag: 29bde5dc-df6d-43c3-8bac-e00af76bee8a

	/// Share of available TH place-nights actually occupied over the selected period (bed-night utilisation). Numerator is Occupied Bed Nights (Period) constrained to Transitional Housing, measured at property-day grain (a day with two concurrent tenancies on one property counts twice, so utilisation can exceed 100%). Denominator is TH property place-nights active during the period, one place-night per TH property per day, clamped to each property's Acquired Date and Confirmed Disposal Date (same lifecycle pattern as Available Property Days (Period)); numerator and denominator share the selected-period horizon so it is safe to read for any historical period. Stored 0-1 and shown as a percentage; DIVIDE guards a zero denominator (returns 0). Responds to the Date Table slicer.
	measure 'TH Place Utilisation Rate (Period) %' =
			VAR _PeriodStart = MIN('Date Table'[Calendar Date])
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			VAR _ContractedPlaceNights =
			    SUMX(
			        FILTER(
			            'Property',
			            'Property'[Program] = "Transitional Housing" &&
			            'Property'[Acquired Date] <= _PeriodEnd &&
			            (ISBLANK('Property'[Confirmed Disposal Date]) ||
			             'Property'[Confirmed Disposal Date] >= _PeriodStart)
			        ),
			        VAR _s = MAX('Property'[Acquired Date], _PeriodStart)
			        VAR _e = MIN(COALESCE('Property'[Confirmed Disposal Date], DATE(9999,12,31)), _PeriodEnd)
			        RETURN IF(_e >= _s, DATEDIFF(_s, _e, DAY) + 1, 0)
			    )
			VAR _OccupiedNights =
			    CALCULATE(
			        [Occupied Bed Nights (Period)],
			        'Property'[Program] = "Transitional Housing"
			    )
			RETURN DIVIDE(_OccupiedNights, _ContractedPlaceNights, 0)
		formatString: 0.0%
		displayFolder: 09. THVM Dashboard\Occupancy
		lineageTag: 50d2e28e-107e-4658-b13d-cfe8cdc04fcf

	/// Count of TH exits in the selected period whose exit outcome is Positive and whose household includes at least one Maori or Pasifika member. (Period): responds to the Date Table slicer on Vacated Date across the whole selected range; with no date selected it covers a single day (today) and is effectively blank, so always view it with a date range. NOTE: ethnicity is recorded on household-member (non-primary) tenant rows, not on the primary tenant, so the household is classified by any member's ethnicity; ethnicity is sparsely captured (blank for about 97% of households), so treat this as a conservative floor and pair it with an ethnicity-completeness check rather than turning it into a naive rate. Excludes internal transfers between Emerge services.
	measure 'TH Positive Exits - Maori & Pasifika (Period)' =
			VAR _IsDateFiltered = ISFILTERED('Date Table')
			VAR _StartDate = IF(_IsDateFiltered, MIN('Date Table'[Calendar Date]), TODAY())
			VAR _EndDate = IF(_IsDateFiltered, MAX('Date Table'[Calendar Date]), TODAY())
			// Ethnicity is captured on household-member (non-primary) tenant rows, never on the primary tenant,
			// so household ethnicity must be read from ANY member. Value list aligned to the actual Ethnicity domain.
			VAR _MaoriPacificValues = {"Maori", "New Zealand Maori", "NZ European / Maori", "Maori / Tongan", "Maori / Scottish", "Samoan", "Tongan", "Cook Islander", "Cook Island / Maori", "New Zealander / Cook Islander", "Niuean", "Tokelauan", "Fijian"}
			RETURN
			COUNTROWS(
			    FILTER(
			        'Tenancy',
			        NOT(ISBLANK('Tenancy'[Vacated Date])) &&
			        'Tenancy'[Vacated Date] >= _StartDate &&
			        'Tenancy'[Vacated Date] <= _EndDate &&
			        RELATED('Property'[Program]) = "Transitional Housing" &&
			        'Tenancy'[Exit Outcome] = "Positive" &&
			        CALCULATE(
			            COUNTROWS('Tenant'),
			            'Tenant'[Ethnicity] IN _MaoriPacificValues
			        ) > 0
			    )
			)
		formatString: #,0
		displayFolder: 09. THVM Dashboard\Exits
		lineageTag: 5f0fc949-e744-4d35-a5d2-7ec27b8abf1b

	/// Average household (whanau) size, in persons, of the TH households that entered service over the rolling 12 months ending at the reference date. For each entering tenancy (Transitional Housing, Is New Chain = 1, start date within the window) it takes the primary tenant's Number Of Household Members and averages across those tenancies; tenancies whose primary tenant has no recorded household size are ignored by the average. Responds to the Date Table slicer - the 12 calendar months ending with the month of the latest selected date; defaults to the 12 calendar months ending with the current month when no date is selected. Shares the historical chain caveat: chain identity is unreliable where Tangata Whaiora ID is blank (~75% of older TH tenancies).
	measure 'TH Households Entered - Avg Whanau Size (12M)' =
			VAR _IsDateFiltered = ISFILTERED('Date Table')
			VAR _ReferenceDate = IF(_IsDateFiltered, MAX('Date Table'[Calendar Date]), TODAY())
			VAR _StartDate = EOMONTH(_ReferenceDate, -12) + 1
			VAR _EndDate = EOMONTH(_ReferenceDate, 0)
			VAR _EnteringTenancies =
			    CALCULATETABLE(
			        'Tenancy',
			        'Property'[Program] = "Transitional Housing",
			        'Tenancy'[Is New Chain] = 1,
			        'Tenancy'[Tenancy Start Date] >= _StartDate,
			        'Tenancy'[Tenancy Start Date] <= _EndDate
			    )
			RETURN
			AVERAGEX(
			    _EnteringTenancies,
			    CALCULATE(
			        MAX('Tenant'[Number Of Household Members]),
			        'Tenant'[Is Primary Tenant] = 1
			    )
			)
		formatString: 0.0
		displayFolder: 09. THVM Dashboard\Service Flows
		lineageTag: 26c2bda4-2a75-42fd-8cb8-2c59131e3569

	/// Count of TH stay chains (households) whose chain start date falls in the rolling 12 months ending at the reference date and whose client (Tangata Whaiora ID) has at least one earlier TH chain - i.e. returns to the service. Counted at chain grain. Responds to the Date Table slicer - the 12 calendar months ending with the month of the latest selected date; defaults to the 12 calendar months ending with the current month when no date is selected. Requires a non-blank Tangata Whaiora ID (blank on ~75% of historical TH tenancies, which are excluded), so this is a conservative floor - treat as directional.
	measure 'TH Repeat Entries (12M)' =
			VAR _IsDateFiltered = ISFILTERED('Date Table')
			VAR _ReferenceDate = IF(_IsDateFiltered, MAX('Date Table'[Calendar Date]), TODAY())
			VAR _StartDate = EOMONTH(_ReferenceDate, -12) + 1
			VAR _EndDate = EOMONTH(_ReferenceDate, 0)
			VAR _AllTHChains =
			    CALCULATETABLE(
			        SUMMARIZE(
			            'Tenancy',
			            'Tenancy'[Tangata Whaiora ID],
			            'Tenancy'[Chain ID],
			            'Tenancy'[Chain Start Date]
			        ),
			        'Property'[Program] = "Transitional Housing",
			        NOT ISBLANK('Tenancy'[Tangata Whaiora ID])
			    )
			RETURN
			COUNTROWS(
			    FILTER(
			        _AllTHChains,
			        VAR _ThisClient = 'Tenancy'[Tangata Whaiora ID]
			        VAR _ThisChainStart = 'Tenancy'[Chain Start Date]
			        RETURN
			            _ThisChainStart >= _StartDate &&
			            _ThisChainStart <= _EndDate &&
			            COUNTROWS(
			                FILTER(
			                    _AllTHChains,
			                    'Tenancy'[Tangata Whaiora ID] = _ThisClient &&
			                    'Tenancy'[Chain Start Date] < _ThisChainStart
			                )
			            ) > 0
			    )
			)
		formatString: #,0
		displayFolder: 09. THVM Dashboard\Service Flows
		lineageTag: 8b14a76c-8a7e-4920-abdf-9f565ed7dd49

	/// Total yearly rent the active portfolio is scheduled to bring in (current weekly rent x 52). Builds on Total Current Rent (Weekly), which already applies the active-portfolio filter. Potential (annualised), not billed, revenue.
	measure 'Annualised Rent Roll (Current)' = [Total Current Rent (Weekly, Current)] * 52
		formatString: \$#,0
		displayFolder: 04. Financial\Rent
		lineageTag: 337475eb-bec7-48a0-b0e7-cb4b7e602a8b

	/// Share of the active portfolio's gross rent funded by IRRS rather than paid by tenants, computed as IRRS / (Current Weekly Rent + IRRS). Current-portfolio snapshot (as at today; does not respond to the Date slicer). WARNING - basis mismatch: 'Total Current Rent (Weekly)' is a weekly total (avg ~$103/property/week) but 'Total IRRS' averages ~$12,056/property - about 117x weekly rent - so IRRS is NOT on a weekly basis. Its true basis is unconfirmed: treating it as annual (IRRS/52) implies an implausible ~$1,162/week average market rent for the 429 IRRS-bearing properties (max ~$2,577/week), which suggests 'Total IRRS' is instead a cumulative all-time subsidy total. As currently written the mixed basis forces reliance to a meaningless ~99% artefact; a naive weekly (IRRS/52) recompute gives ~69% but is equally unreliable until the basis is known. Do NOT use this measure at face value: confirm with finance both the IRRS time basis and whether Current Rent already nets the subsidy; the metric likely needs a genuine weekly-IRRS input. Only 429 of ~1,913 active properties carry non-zero IRRS.
	measure 'IRRS Subsidy Reliance %' = DIVIDE([Total IRRS Subsidy (Current)], [Total Current Rent (Weekly, Current)] + [Total IRRS Subsidy (Current)], 0)
		formatString: 0.0%
		displayFolder: 04. Financial\Rent
		lineageTag: aa281566-9c1b-4839-86fc-5b2852bb7d35

	/// Proportion of rent billed in the selected period that was collected: (Rent Payment + Arrears Payment Rent) / Rent Charged, windowed on 'Tenancy Transaction'[Transaction Date] (inclusive bounds). Excludes adjustments and write-offs. (Period): responds to the Date Table slicer (NZ financial year 1 Jul-30 Jun); when no Date Table slicer is applied it defaults to the trailing 12 months (EOMONTH(TODAY(),-12)+1 -> today). Can exceed 100% because arrears payments settling earlier-period charges are counted against the current period's charges only (observed 105.0% trailing-12M, 105.7% FY2024-25).
	measure 'Rent Collection Rate % (Period)' =
			VAR _IsDateFiltered = ISFILTERED('Date Table')
			VAR _PeriodStart = IF(_IsDateFiltered, MIN('Date Table'[Calendar Date]), EOMONTH(TODAY(), -12) + 1)
			VAR _PeriodEnd = IF(_IsDateFiltered, MAX('Date Table'[Calendar Date]), TODAY())
			VAR _Charged =
			    CALCULATE(
			        SUM('Tenancy Transaction'[Amount]),
			        'Tenancy Transaction'[Transaction Type] = "Rent Charge",
			        'Tenancy Transaction'[Transaction Date] >= _PeriodStart,
			        'Tenancy Transaction'[Transaction Date] <= _PeriodEnd
			    )
			VAR _Paid =
			    CALCULATE(
			        SUM('Tenancy Transaction'[Amount]),
			        'Tenancy Transaction'[Transaction Type] IN {"Rent Payment", "Arrears Payment Rent"},
			        'Tenancy Transaction'[Transaction Date] >= _PeriodStart,
			        'Tenancy Transaction'[Transaction Date] <= _PeriodEnd
			    )
			RETURN DIVIDE(_Paid, -_Charged, 0)
		formatString: 0.0%
		displayFolder: 04. Financial\Rent
		lineageTag: db046dda-a326-4509-bd31-6061c897c49c

	/// Total rent currently owed by tenants (gross arrears), shown as a positive figure. Iterates per tenancy over [Current Rent Balance] (Is Latest Balance) and sums only the tenancies in arrears, so tenant credits are NOT netted against amounts owed - this is gross rent owed in the filter context. Snapshot as at the latest balance; does not respond to the Date slicer.
	measure 'Current Rent Arrears (Owed)' = SUMX(VALUES('Tenancy'[Property Tenancy ID]), VAR _Bal = [Current Rent Balance] RETURN IF(_Bal < 0, -_Bal, 0))
		formatString: \$#,0
		displayFolder: 04. Financial\Arrears
		lineageTag: 374bce5a-418f-46ea-9990-62228710d3de

	/// Current rent owed as a % of the annual rent roll. Directionally sound for trend; numerator (snapshot arrears) and denominator (annualised active rent) are different populations. Placeholder target <= 2% - confirm with finance.
	measure 'Rent Arrears % of Rent Roll' = DIVIDE([Current Rent Arrears (Owed)], [Annualised Rent Roll (Current)], 0)
		formatString: 0.0%
		displayFolder: 04. Financial\Arrears
		lineageTag: babd2d8e-4bd1-4ea2-b0f4-86bbaf5be86c

	/// Share of the outstanding aged-debt balance that is aged 29 or more days (Total 29 Plus divided by Total Outstanding), expressed as a percentage. Aged Debt is a monthly snapshot fact disconnected from the central Date Table, so it does not respond to the Date Table slicer; slice to a single snapshot ('Aged Debt'[Current Date] = "Today", or one As At Year Month) or both totals aggregate across every stored snapshot. Caveat: the numerator and denominator sum all charge types, and Rent balances are held with the opposite sign to Non Rent in this fact, so at the all-charge-type grand total the two partly offset to a net figure and the ratio can exceed 100%; within a single Charge Type (Rent or Non Rent on its own) it stays in a normal 0-100% range. The intended cross-charge-type headline is not yet confirmed with finance.
	measure 'Serious Arrears % (29+ Days)' = DIVIDE([Total 29 Plus], [Total Outstanding], 0)
		formatString: 0.0%
		displayFolder: 04. Financial\Aged Debt
		lineageTag: 214a0ffd-79c5-43e9-a561-a2aaa49c044a

	/// Count of distinct tenancies (by Property Tenancy ID) whose net Total Balance across all charge types is non-zero in the aged-debt snapshot. Aged Debt is a monthly snapshot fact disconnected from the central Date Table, so slice 'Aged Debt'[Current Date] = "Today" (or one As At Year Month) for a single snapshot or it evaluates across all stored snapshots; it does not respond to the Date Table slicer. The count combines tenancies with a net-negative balance (an amount owed) and tenancies with a net-positive balance (in credit or overpaid), so on its own it is not a clean arrears count - for net debtors filter to net Total Balance < 0. Caveat: because the non-zero test uses the net across charge types and Rent and Non Rent carry opposite signs, tenancies whose Rent and Non Rent balances offset to exactly zero are treated as having no overall balance and excluded; the cross-charge-type sign convention is not yet confirmed.
	measure 'Tenancies with Outstanding Balance (Aged Debt)' =
			CALCULATE(
			    DISTINCTCOUNT('Aged Debt'[Property Tenancy ID]),
			    FILTER(
			        VALUES('Aged Debt'[Property Tenancy ID]),
			        CALCULATE(SUM('Aged Debt'[Total Balance])) <> 0
			    )
			)
		formatString: #,0
		displayFolder: 04. Financial\Aged Debt
		lineageTag: 99e6bbb6-7fd7-4572-bb26-fd192bddabe9

	/// For active TH properties, the weekly gap between market rent and rent charged (subsidy absorbed). Current snapshot of the active TH portfolio as at today; ignores the Date Table slicer. Active = Acquired on/before today and not yet disposed (Confirmed Disposal Date only). Review completeness of Transitional Housing Market Rent first - blank/zero values understate (and can turn negative) the gap. Weekly figure; x52 for annual.
	measure 'TH Market Rent Subsidy Gap (Weekly, Current)' =
			CALCULATE(
			    SUMX(
			        FILTER(
			            'Property',
			            'Property'[Program] = "Transitional Housing"
			                && 'Property'[Acquired Date] <= TODAY()
			                && (ISBLANK('Property'[Confirmed Disposal Date]) || 'Property'[Confirmed Disposal Date] > TODAY())
			                && 'Property'[Transitional Housing Market Rent] > 0
			        ),
			        'Property'[Transitional Housing Market Rent] - 'Property'[Current Rent]
			    )
			)  -- excludes active TH properties with no recorded market rent (currently ~50%) so blanks do not net -CurrentRent into the gap; confirm intended treatment with the TH team.
		formatString: \$#,0
		displayFolder: 04. Financial\Rent
		lineageTag: 1ffbe7df-a907-46f8-9a7e-fe10a9d0640c

	/// Change, in percentage points, between the current-period rent collection rate and the same period one year earlier. Rent collection rate = rent paid (Rent Payment + Arrears Payment Rent) divided by rent charged (Rent Charge), windowed on 'Tenancy Transaction'[Transaction Date] because the Date Table is disconnected. Responds to the Date Table slicer via MIN/MAX of Calendar Date; when no date slicer is applied it defaults to the trailing 12 months (current) versus the preceding 12 months (prior). Prior-year bounds are derived with EDATE(-12). Returns BLANK when no rent was charged in the prior-year window. Positive = collection rate improved year on year.
	measure 'Rent Collection Rate % YoY Change' =
			VAR _IsDateFiltered = ISFILTERED('Date Table')
			VAR _PeriodStart = IF(_IsDateFiltered, MIN('Date Table'[Calendar Date]), EOMONTH(TODAY(), -12) + 1)
			VAR _PeriodEnd = IF(_IsDateFiltered, MAX('Date Table'[Calendar Date]), TODAY())
			VAR _PriorStart = EDATE(_PeriodStart, -12)
			VAR _PriorEnd = EDATE(_PeriodEnd, -12)
			VAR _CurrentRate = [Rent Collection Rate % (Period)]
			VAR _PriorCharged =
			    CALCULATE(
			        SUM('Tenancy Transaction'[Amount]),
			        'Tenancy Transaction'[Transaction Type] = "Rent Charge",
			        'Tenancy Transaction'[Transaction Date] >= _PriorStart,
			        'Tenancy Transaction'[Transaction Date] <= _PriorEnd
			    )
			VAR _PriorPaid =
			    CALCULATE(
			        SUM('Tenancy Transaction'[Amount]),
			        'Tenancy Transaction'[Transaction Type] IN {"Rent Payment", "Arrears Payment Rent"},
			        'Tenancy Transaction'[Transaction Date] >= _PriorStart,
			        'Tenancy Transaction'[Transaction Date] <= _PriorEnd
			    )
			VAR _PriorRate = DIVIDE(_PriorPaid, -_PriorCharged, 0)
			RETURN IF(_PriorCharged <> 0, _CurrentRate - _PriorRate, BLANK())
		formatString: 0.0%
		displayFolder: 04. Financial\Rent
		lineageTag: 5cb3e2d1-7e49-48fa-aeca-5bcb8d3a83d9

	/// Current-state cost-intensity index: all-time maintenance spend (SUM of Property Maintenance Task Amount) divided by the count of currently active portfolio properties (acquired and not yet disposed, as at today). This is a snapshot ratio and does NOT respond to the Date Table slicer (the Date Table is disconnected and maintenance spend has no date relationship). Use it as a portfolio-level intensity indicator, not a trend.
	measure 'Maintenance Cost per Active Property' = DIVIDE([Total Maintenance Cost], [Total Properties (Current)], 0)
		formatString: \$#,0
		displayFolder: 05. Maintenance
		lineageTag: 9e669749-a4ab-420f-9f2b-66b78d4ee2be

	/// Intended to report the share of total maintenance spend attributable to reactive repairs: it divides the SUM of Property Maintenance Task[Amount] where Property Maintenance[Maintenance Type] = "Reactive" by Total Maintenance Cost, as a percentage. In the currently loaded data the Maintenance Type column holds only the value "Work Task" (there is no "Reactive" value), so the numerator is always empty and the measure returns blank in every filter context. It is not date-aware (the Date Table is disconnected) and cannot report a meaningful percentage until a reactive or responsive classification is populated in the field the filter targets.
	measure 'Reactive Maintenance Cost %' =
			VAR _Reactive =
			    CALCULATE(
			        SUM('Property Maintenance Task'[Amount]),
			        'Property Maintenance'[Maintenance Type] = "Reactive"
			    )
			RETURN DIVIDE(_Reactive, [Total Maintenance Cost], 0)
		formatString: 0.0%
		displayFolder: 05. Maintenance
		lineageTag: 0f5380c9-c53d-4155-b426-11f15f49655b

	/// Snapshot count of maintenance tasks that are past their Expected Completion Date (Expected Completion Date < today) and not yet completed (blank Actual Contractor Completion Date). Grain: one row per maintenance task. Current-state snapshot as at today - uses TODAY() and does NOT respond to the Date Table slicer. DATA CAVEAT: 'Expected Completion Date' is populated for only 2 of ~24,937 tasks (0.008%), so this measure currently returns a near-zero, non-representative count (2) and cannot reflect true overdue volumes until that source column is populated upstream; treat the current figure as unreliable, not as evidence of strong timeliness.
	measure 'Maintenance Tasks Overdue' =
			CALCULATE(
			    COUNTROWS('Property Maintenance Task'),
			    FILTER(
			        'Property Maintenance Task',
			        NOT(ISBLANK('Property Maintenance Task'[Expected Completion Date]))
			            && 'Property Maintenance Task'[Expected Completion Date] < TODAY()
			            && ISBLANK('Property Maintenance Task'[Actual Contractor Completion Date])
			    )
			)
		formatString: #,0
		displayFolder: 05. Maintenance\Completion
		lineageTag: f278531f-61bd-4cf9-85bb-c6f803568e10

	/// Of maintenance tasks that have both an Actual Contractor Completion Date and an Expected Completion Date, the share completed on or before the Expected Completion Date. All-time rate at task grain; it is not date-filtered and has no TODAY() logic, so it does NOT respond to the Date Table slicer (ignores the FY range). DATA CAVEAT: no task in the model currently has both dates populated - 'Expected Completion Date' is set on only 2 of ~24,937 tasks and neither of those has an Actual Contractor Completion Date - so the denominator is 0 and the measure ALWAYS returns BLANK (DIVIDE returns BLANK rather than the 0 alternate result because the numerator is blank too). It cannot be presented until Expected Completion Date (or an agreed completion-target/SLA date) is populated upstream, or the KPI is rebuilt against a populated target date. The '90% target' is a report-side placeholder, not encoded in this measure.
	measure 'Maintenance On-Time Completion %' =
			VAR _CompletedWithTarget =
			    CALCULATE(
			        COUNTROWS('Property Maintenance Task'),
			        NOT(ISBLANK('Property Maintenance Task'[Actual Contractor Completion Date])),
			        NOT(ISBLANK('Property Maintenance Task'[Expected Completion Date]))
			    )
			VAR _OnTime =
			    CALCULATE(
			        COUNTROWS('Property Maintenance Task'),
			        FILTER(
			            'Property Maintenance Task',
			            NOT(ISBLANK('Property Maintenance Task'[Actual Contractor Completion Date]))
			                && NOT(ISBLANK('Property Maintenance Task'[Expected Completion Date]))
			                && 'Property Maintenance Task'[Actual Contractor Completion Date] <= 'Property Maintenance Task'[Expected Completion Date]
			        )
			    )
			RETURN DIVIDE(_OnTime, _CompletedWithTarget, 0)
		formatString: 0.0%
		displayFolder: 05. Maintenance\Completion
		lineageTag: d12dd2c9-12fa-4bd2-b5cd-5a27730acd1a

	/// Total cumulative days that active-portfolio properties have been under maintenance (unavailable for letting), summed from the per-property [Days Under Maintenance] snapshot column. Active portfolio = acquired on/before today and not yet disposed (Confirmed Disposal Date blank or after today). This is a lifetime cumulative total, NOT a count of days properties are under maintenance right now (some active properties carry 365+ cumulative days). Current snapshot: ignores the Date Table slicer. SUM companion to Avg Days Under Maintenance (Current).
	measure 'Total Days Under Maintenance (Current)' =
			CALCULATE(
			    SUM('Property'[Days Under Maintenance]),
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= TODAY()
			            && (ISBLANK('Property'[Confirmed Disposal Date]) || 'Property'[Confirmed Disposal Date] > TODAY())
			    )
			)
		formatString: #,0
		displayFolder: 01. Property Portfolio\Current Snapshot
		lineageTag: ab26ae29-c7db-4eca-ac58-0ef6ef7a16e2

	/// Number of properties that reached Healthy Homes compliance in the last rolling 12 months (by Compliance Date). Makes the compliance trajectory visible vs the static HH - Compliance Rate %. Responds to the Date Table slicer: the 12-month window ends at the month of the latest selected date, or the current month if no date is selected.
	measure 'HH - Newly Compliant (12M)' =
			VAR _IsDateFiltered = ISFILTERED('Date Table')
			VAR _ReferenceDate = IF(_IsDateFiltered, MAX('Date Table'[Calendar Date]), TODAY())
			VAR _WindowStart = EOMONTH(_ReferenceDate, -12) + 1
			VAR _WindowEnd = EOMONTH(_ReferenceDate, 0)
			RETURN
			CALCULATE(
			    COUNTROWS('Healthy Homes'),
			    NOT(ISBLANK('Healthy Homes'[Healthy Homes Compliance Date])),
			    'Healthy Homes'[Healthy Homes Compliance Date] >= _WindowStart,
			    'Healthy Homes'[Healthy Homes Compliance Date] <= _WindowEnd
			)
		formatString: #,0
		displayFolder: 07. Healthy Homes
		lineageTag: c9f28670-4e4c-4282-83a3-4b2d876085d6

	/// Count of routine-inspection records (Category = "Tenancy Routine Inspection") whose Next Routine Inspection date is non-blank and earlier than today. Grain = inspection records, NOT distinct properties: the 1,206 counted rows map to only 629 properties, so a property with several past-due schedules is counted more than once (for a property-level figure use DISTINCTCOUNT('Property Inspection'[Property ID])). Current snapshot - uses TODAY() and ignores the Date Table slicer. Almost every counted row is itself a Status="Completed" historical inspection (1,205 of 1,206); only a minority of records carry a populated Next Routine Inspection and every populated value currently lies in the past, so the <today test is presently non-binding. Treat as a rough worklist / coverage signal, not an exact compliance count - a later inspection may already satisfy the schedule.
	measure 'Routine Inspections Overdue' =
			CALCULATE(
			    COUNTROWS('Property Inspection'),
			    FILTER(
			        'Property Inspection',
			        NOT(ISBLANK('Property Inspection'[Next Routine Inspection]))
			            && 'Property Inspection'[Next Routine Inspection] < TODAY()
			            && 'Property Inspection'[Category] = "Tenancy Routine Inspection"
			    )
			)
		formatString: #,0
		displayFolder: 06. Inspections\By Status
		lineageTag: b61b167e-7ebf-4dd0-bbdd-472da75f5768

	/// Inspections actually conducted in the last rolling 12 months (by Actual Inspection Date, Status = Completed). Time-bounded companion to Inspections Completed. Responds to the Date Table slicer: the 12-month window ends at the month of the latest selected date, or the current month if no date is selected.
	measure 'Inspections Completed (12M)' =
			VAR _IsDateFiltered = ISFILTERED('Date Table')
			VAR _ReferenceDate = IF(_IsDateFiltered, MAX('Date Table'[Calendar Date]), TODAY())
			VAR _WindowStart = EOMONTH(_ReferenceDate, -12) + 1
			VAR _WindowEnd = EOMONTH(_ReferenceDate, 0)
			RETURN
			CALCULATE(
			    COUNTROWS('Property Inspection'),
			    'Property Inspection'[Status] = "Completed",
			    NOT(ISBLANK('Property Inspection'[Actual Inspection Date])),
			    'Property Inspection'[Actual Inspection Date] >= _WindowStart,
			    'Property Inspection'[Actual Inspection Date] <= _WindowEnd
			)
		formatString: #,0
		displayFolder: 06. Inspections\By Status
		lineageTag: 4ea22b53-b33a-4565-806b-53529b12094e

	/// Current snapshot - does NOT respond to the Date Table slicer. Of active-portfolio properties currently vacant (Total Properties Vacant = tenantable + un-tenantable), the share flagged VACANT: Un-tenantable (not yet ready to let; needing maintenance/work). Built on the snapshot measures Properties Vacant Untenantable and Total Properties Vacant. A high value points to turnaround bottlenecks. Returns 0 when there are no vacant properties.
	measure 'Vacant Untenantable Rate % (Current)' = DIVIDE([Properties Vacant Untenantable (Current)], [Total Properties Vacant (Current)], 0)
		formatString: 0.0%
		displayFolder: 01. Property Portfolio\Current Snapshot
		lineageTag: 4d656bbd-517a-43b7-8c8c-ff373c63df17

	/// Independent, timeline-based day-weighted occupancy for the selected period (Period: responds to the Date Table slicer): Timeline Tenancy Days (Period) / (Timeline Tenancy Days (Period) + Timeline Void Days (Period)). This does NOT reconcile with Occupancy Rate (Period) %: it reads materially higher (about 88% all-time / 83% FY24-25 vs about 68% / 70% for the Date-Aware measure) because its denominator counts only days covered by a tenancy or void interval on the Property Timeline - roughly a third of the portfolio's available property-days - and vacancy is captured only where a Void Checklist record exists. Treat it as a distinct interval-based view of occupancy, not a control that ties back to the Date-Aware occupancy family.
	measure 'Timeline Occupancy Rate (Period) %' = DIVIDE([Timeline Tenancy Days (Period)], [Timeline Tenancy Days (Period)] + [Timeline Void Days (Period)], 0)
		formatString: 0.0%
		displayFolder: 01. Property Portfolio\Timeline
		lineageTag: ecfcd1c8-457b-4108-8855-74f21a8ee5ce

	/// Average days between a void becoming ready-to-let and the next interval starting (the re-let / marketing lag), from Days Between Intervals on void rows. Completed lags only - keeps voids with Reverse Row Number > 1, so it excludes each property's most-recent/open void (Reverse Row Number = 1, which has no following interval), and it includes RTLL intervals. Excludes negative gaps (Days Between Intervals >= 0): a subset of source voids overlap the following interval and carry a negative gap, which are filtered out - including them would pull the average sharply down. Not date-aware; ignores the Date Table slicer and is computed across all timeline history in the current Property context.
	measure 'Timeline Avg Ready-to-Let Gap Days' = CALCULATE(AVERAGE('Property Timeline'[Days Between Intervals]), 'Property Timeline'[Record Type] = "VoidInterval", 'Property Timeline'[Reverse Row Number] > 1, 'Property Timeline'[Days Between Intervals] >= 0)
		formatString: #,0.0
		displayFolder: 01. Property Portfolio\Timeline
		lineageTag: 7194ece2-f3c3-4e9e-80ee-86557d97d056

	/// Distinct count of properties whose most-recent timeline interval (Reverse Row Number = 1) is a still-OPEN void: Record Type = VoidInterval with Interval End Date >= TODAY() (an open void carries a TODAY() end sentinel). Counts only properties actively in an open void interval; it EXCLUDES properties whose most-recent void has already closed — e.g. now ready-to-let awaiting a tenant, or disposed — so it is narrower than 'all empty properties'. Current snapshot: uses TODAY() and ignores the Date Table slicer. Counterpart to Properties Currently Tenanted; together they partition the properties that have an open most-recent interval.
	measure 'Properties Currently Void' =
			CALCULATE(
			    DISTINCTCOUNT('Property Timeline'[Property ID]),
			    'Property Timeline'[Reverse Row Number] = 1,
			    'Property Timeline'[Record Type] = "VoidInterval",
			    'Property Timeline'[Interval End Date] >= TODAY()
			)
		formatString: #,0
		displayFolder: 01. Property Portfolio\Timeline
		lineageTag: c2efed1e-fee1-46c7-a7ae-fdfe79c513f0

	/// Distinct properties whose current (most recent, still-open) interval is a tenancy — i.e. occupied as at today. Current snapshot: uses TODAY() and ignores the Date Table slicer. Counterpart to Properties Currently Void.
	measure 'Properties Currently Tenanted' =
			CALCULATE(
			    DISTINCTCOUNT('Property Timeline'[Property ID]),
			    'Property Timeline'[Reverse Row Number] = 1,
			    'Property Timeline'[Record Type] = "TenancyInterval",
			    'Property Timeline'[Interval End Date] >= TODAY()
			)
		formatString: #,0
		displayFolder: 01. Property Portfolio\Timeline
		lineageTag: 24cd4799-aa93-4a72-9540-efc35daeef79

	/// Count of void intervals whose duration exceeds 90 days (Days Interval > 90) - chronic voids. Counts void interval ROWS, not distinct properties: a property with two 90+ day voids counts twice. Excludes RTLL (Returned-To-Landlord) intervals to match the other void/turnaround KPIs; still-open voids are included, their duration measured to today. All-time: ignores the Date Table slicer and responds to Property-level slicers via the Property relationship - slice by Void Category to see the breakdown of chronic voids.
	measure 'Timeline Long-Term Voids (>90 Days)' =
			CALCULATE(
			    COUNTROWS('Property Timeline'),
			    'Property Timeline'[Record Type] = "VoidInterval",
			    'Property Timeline'[Days Interval] > 90,
			    'Property Timeline'[Void Category] <> "RTLL"
			)
		formatString: #,0
		displayFolder: 01. Property Portfolio\Timeline
		lineageTag: f5331d19-ea7b-4ce8-952b-311f30fdae88

	/// Average number of timeline intervals (voids + tenancies) per property — a churn-intensity index. A high value flags chronically cycling / hard-to-let stock. All-time figure: ignores the Date Table slicer; responds to Property/Program filters. Uses DISTINCTCOUNT of Property ID as the denominator (DIVIDE with a 0 fallback).
	measure 'Timeline Avg Intervals per Property' = DIVIDE(COUNTROWS('Property Timeline'), DISTINCTCOUNT('Property Timeline'[Property ID]), 0)
		formatString: #,0.0
		displayFolder: 01. Property Portfolio\Timeline
		lineageTag: 618c2cb5-ba16-4528-bcaa-b24c05cf93fd

	/// Occupied place-nights (bed-nights) for Transitional Housing within the selected Date Table period, summed at tenancy grain. Iterates non-Cancelled tenancies on TH-program properties (RELATED('Property'[Program]) = "Transitional Housing"); open tenancies are clamped to the period end via a 2099-12-31 sentinel and days are counted inclusively (DATEDIFF+1, both endpoints). Because it is per-tenancy, a day with two concurrent tenancies on one property is counted twice (bed-nights can exceed contracted place-nights). Responds to the Date Table slicer (period-scoped). Feeds [Vacant Bed Nights (Reporting Month)]. Occupancy basis: a tenancy counts towards occupancy only once the household has taken up the place - that is, the tenancy has been activated, or it is recorded as Active, Active Arrears, Vacated, Vacated Arrears or Vacated Closed Account. Agreements that have been created but not yet activated, and cancelled agreements, are not counted as occupying a place.
	measure 'TH Occupied Bed Nights (Period)' =
			SUMX (
			    FILTER (
			        'Tenancy',
			        'Tenancy'[Is Occupying Tenancy] = 1
			            && RELATED ( 'Property'[Program] ) = "Transitional Housing"
			    ),
			    VAR TenancyStart = ( 'Tenancy'[Tenancy Start Date] )
			    VAR TenancyEnd =
			        COALESCE ( ( 'Tenancy'[Vacated Date] ), DATE ( 2099, 12, 31 ) )
			    VAR MonthStart = MIN ( 'Date Table'[Calendar Date] )
			    VAR MonthEnd = MAX ( 'Date Table'[Calendar Date] )
			    RETURN
			        IF (
			            TenancyEnd >= MonthStart
			                && TenancyStart <= MonthEnd,
			            DATEDIFF ( MAX ( TenancyStart, MonthStart ), MIN ( TenancyEnd, MonthEnd ), DAY ) + 1,
			            0
			        )
			)
		formatString: #,0
		displayFolder: 09. THVM Dashboard\Occupancy
		lineageTag: b0833db3-9091-431c-8d5f-49ddac693c48

	/// Average elapsed length of stay in weeks for tenancies active at the selected month end (started on or before month end, not yet vacated, excluding Cancelled). Responds to the Date Table slicer. Measured per tenancy row, not per continuous client chain - a client with multiple tenancies is counted once per tenancy.
	measure 'Avg Length of Stay (Active, Period End)' =
			VAR MonthEnd = MAX('Date Table'[Calendar Date])
			RETURN
			ROUND(
			    AVERAGEX(
			        FILTER(
			            'Tenancy',
			            COALESCE('Tenancy'[Vacated Date], DATE(2099,12,31)) > MonthEnd
			                && 'Tenancy'[Tenancy Start Date] <= MonthEnd
			                && 'Tenancy'[Tenancy Status] <> "Cancelled"
			        ),
			        MAX(
			            0,
			            DATEDIFF('Tenancy'[Tenancy Start Date], MonthEnd, DAY) / 7
			        )
			    ),
			    0
			)
		formatString: #,0.0
		displayFolder: 02. Tenancy\Length of Stay
		lineageTag: db2e1f8c-cd2f-4014-b044-056a1370e7e5

	/// Longest elapsed length of stay in weeks among tenancies active at the selected month end (started on or before month end, not yet vacated, excluding Cancelled). Responds to the Date Table slicer. Measured per tenancy row, not per continuous client chain.
	measure 'Max Length of Stay (Active, Period End)' =
			VAR MonthEnd = MAX('Date Table'[Calendar Date])
			RETURN
			ROUND(
			    MAXX(
			        FILTER(
			            'Tenancy',
			            COALESCE('Tenancy'[Vacated Date], DATE(2099,12,31)) > MonthEnd
			                && 'Tenancy'[Tenancy Start Date] <= MonthEnd
			                && 'Tenancy'[Tenancy Status] <> "Cancelled"
			        ),
			        MAX(
			            0,
			            DATEDIFF('Tenancy'[Tenancy Start Date], MonthEnd, DAY) / 7
			        )
			    ),
			    0
			)
		formatString: #,0.0
		displayFolder: 02. Tenancy\Length of Stay
		lineageTag: 0311670d-dd13-488c-8e51-1d006cab94c2

	/// Mean of 'Tenancy'[Rent] (a weekly dollar amount) across tenancies active at the selected month end - Tenancy Start Date on or before month end, Vacated Date after month end (or still open), excluding Cancelled tenancies. Period End: responds to the Date Table slicer with month end = MAX of Calendar Date; with no date slicer it falls back to the last date in the Date Table (currently 31 Dec 2036). Caveat: in the current data a large share of active tenancies carry a negative Rent (down to several thousand dollars) and over half are non-positive once zero/blank rents are included, which pulls the raw mean well below the mean across paying tenancies (Rent > 0). Treat the figure as indicative only.
	measure 'Average Weekly Contribution (Active, Period End)' =
			VAR MonthEnd = MAX('Date Table'[Calendar Date])
			RETURN
			ROUND(
			    AVERAGEX(
			        FILTER(
			            'Tenancy',
			            COALESCE('Tenancy'[Vacated Date], DATE(2099,12,31)) > MonthEnd
			                && 'Tenancy'[Tenancy Start Date] <= MonthEnd
			                && 'Tenancy'[Tenancy Status] <> "Cancelled"
			        ),
			        'Tenancy'[Rent]
			    ),
			    2
			)
		formatString: \$#,0.00
		displayFolder: 04. Financial\Rent
		lineageTag: 82d64d0c-12c7-4cd6-a962-54d2cb5e333e

	/// Distinct count of tenancies (by Property Tenancy ID) whose occupancy interval overlaps the selected Date Table period: Tenancy Start Date on/before the period end AND Vacated Date - or, for still-open tenancies, an assumed far-future end (31 Dec 2099) - on/after the period start. Excludes cancelled agreements and agreements that have not yet been activated. (Period): responds to the Date Table slicer over any selected range and is not fixed to a financial year. Period-overlap count: additive across tenancy attributes such as status (parts reconcile to the period total), but NOT additive over time - a tenancy active in several months is counted in each, so monthly values must not be summed to a period total. Occupancy basis: a tenancy counts towards occupancy only once the household has taken up the place - that is, the tenancy has been activated, or it is recorded as Active, Active Arrears, Vacated, Vacated Arrears or Vacated Closed Account. Agreements that have been created but not yet activated, and cancelled agreements, are not counted as occupying a place.
	measure 'Tenancies in Service (Period)' =
			CALCULATE (
			    DISTINCTCOUNT ( 'Tenancy'[Property Tenancy ID] ),
			    FILTER (
			        'Tenancy',
			        'Tenancy'[Tenancy Start Date] <= MAX ( 'Date Table'[Calendar Date] )
			            && COALESCE ( 'Tenancy'[Vacated Date], DATE ( 2099, 12, 31 ) ) >= MIN ( 'Date Table'[Calendar Date] )
			            && 'Tenancy'[Is Occupying Tenancy] = 1
			    )
			)
		formatString: #,0
		displayFolder: 02. Tenancy\Occupancy
		lineageTag: 8695ed0e-0698-4d81-b96e-f419cb419101

	/// Internal helper (hidden). Distinct tenancies by Property Tenancy ID, intended to be sliced by a stay-category filter inside a specific visual. Note: 'Stay Category' is a disconnected slicer table with no relationship to 'Tenancy', so this measure does not self-filter by stay bucket when used standalone. Removed the no-op FILTER(TRUE()) and fixed grain from Tenancy Name to Property Tenancy ID.
	measure TenantsByStay = DISTINCTCOUNT ( 'Tenancy'[Property Tenancy ID] )
		formatString: #,0
		isHidden
		displayFolder: _Internal
		lineageTag: 0adb026b-4d48-4249-8469-b724ac36f31a

	/// Per-property continuous days vacant as at the selected month end: days since the property last became vacant - the most recent vacate date, or the Acquired Date for newly acquired stock that has never been tenanted (blank if a tenancy is active at month end, or if the property was acquired after the month end). Responds to the Date Table slicer. Excludes properties confirmed-disposed before the month start and ignores cancelled and not-yet-activated tenancies. Grain: one property in context. Used by CLS Vacancy (filters). Occupancy basis: a tenancy counts towards occupancy only once the household has taken up the place - that is, the tenancy has been activated, or it is recorded as Active, Active Arrears, Vacated, Vacated Arrears or Vacated Closed Account. Agreements that have been created but not yet activated, and cancelled agreements, are not counted as occupying a place.
	measure 'Continuous Vacant Days (Period End)' =
			VAR MonthStart =
			    MIN ( 'Date Table'[Calendar Date] )
			VAR MonthEnd =
			    MAX ( 'Date Table'[Calendar Date] )
			
			/* Exclude properties confirmed disposed before the start of the reporting month (Confirmed Disposal Date only) */
			VAR ConfirmedDisposalDate =
			    CALCULATE ( MAX ( 'Property'[Confirmed Disposal Date] ) )
			VAR DisposedBeforeMonthStart =
			    NOT ISBLANK ( ConfirmedDisposalDate )
			        && ConfirmedDisposalDate < MonthStart
			
			/* Any tenancy active at MonthEnd? (exclude Cancelled per house pattern) */
			VAR HasActiveTenancy =
			    CALCULATE (
			        COUNTROWS ( Tenancy ),
			        FILTER (
			            Tenancy,
			            Tenancy[Is Occupying Tenancy] = 1
			                && Tenancy[Tenancy Start Date] <= MonthEnd
			                && (
			                    ISBLANK ( Tenancy[Vacated Date] )
			                    || Tenancy[Vacated Date] > MonthEnd
			                )
			        )
			    ) > 0
			
			/* Latest vacate date on/before MonthEnd (exclude Cancelled) */
			VAR LastVacatedDate =
			    CALCULATE (
			        MAX ( Tenancy[Vacated Date] ),
			        Tenancy[Is Occupying Tenancy] = 1,
			        Tenancy[Vacated Date] <= MonthEnd
			    )
			
			/* Vacant since: the last vacate date, or - for stock that has never been tenanted - the
			   Acquired Date. Without this fallback a never-tenanted property returned BLANK and was
			   silently dropped from the 'Places Unoccupied at Period End' list while still being
			   counted by Count of Unoccupied Properties (Period End). */
			VAR _UnoccupiedSince =
			    IF (
			        ISBLANK ( LastVacatedDate ),
			        CALCULATE ( MIN ( 'Property'[Acquired Date] ) ),
			        LastVacatedDate
			    )
			
			RETURN
			IF (
			    DisposedBeforeMonthStart,
			    BLANK (),
			    IF (
			        HasActiveTenancy
			            || ISBLANK ( _UnoccupiedSince )
			            || _UnoccupiedSince > MonthEnd,
			        BLANK (),
			        DATEDIFF ( _UnoccupiedSince, MonthEnd, DAY )
			    )
			)
		formatString: #,0
		displayFolder: 08. Void Management\Vacancy
		lineageTag: 43b83d38-3c5e-460e-988f-ed1b53fda09c

	/// Available minus occupied bed-nights for the selected period ([Total Available Bed Nights (Reporting Month)] - [TH Occupied Bed Nights (Period)]). Responds to the Date Table slicer. Can be slightly negative in edge cases where recorded occupancy exceeds contracted capacity (e.g. overlapping tenancies on one property, or occupancy after a mid-period disposal).
	measure 'Vacant Bed Nights (Reporting Month)' = [Total Available Bed Nights (Reporting Month)] - [TH Occupied Bed Nights (Period)]
		formatString: #,0
		displayFolder: 08. Void Management\Occupancy
		lineageTag: 4a100def-a821-480d-8072-f9045f94c374

	/// Distinct properties under TH contract during the selected month — acquired on/before period end and not disposed before period start (uses Confirmed Disposal Date only; counted at Property ID grain). Responds to the Date Table slicer.
	measure 'TH Places Contracted (Period)' =
			VAR MonthStart =
			    MIN ( 'Date Table'[Calendar Date] )
			VAR MonthEnd =
			    MAX ( 'Date Table'[Calendar Date] )
			RETURN
			CALCULATE (
			    DISTINCTCOUNT ( 'Property'[Property ID] ),
			    FILTER (
			        VALUES ( 'Property'[Property ID] ),
			        VAR DisposalDate =
			            CALCULATE ( MAX ( 'Property'[Confirmed Disposal Date] ) )
			        VAR AcquisitionDate =
			            CALCULATE ( MAX ( 'Property'[Acquired Date] ) )
			        VAR Prog =
			            CALCULATE ( MAX ( 'Property'[Program] ) )
			        RETURN
			            ( ISBLANK ( DisposalDate ) || DisposalDate >= MonthStart )
			            && ( ISBLANK ( AcquisitionDate ) || AcquisitionDate <= MonthEnd )
			            && Prog = "Transitional Housing"
			    )
			)
		formatString: #,0
		displayFolder: 09. THVM Dashboard\Occupancy
		lineageTag: 489f5327-33e1-45c4-9757-ca11dc20c966

	/// Available bed-nights capacity denominator for the selected period: for each calendar month in the Date slicer it multiplies the number of days in that month by the count of contracted transitional-housing properties active that month ([TH Places Contracted (Period)], which is scoped to Program = "Transitional Housing"). Additive across months, so a multi-month selection returns the sum and a partial edge month counts only the days that fall inside the slicer. Responds to the Date Table slicer (financial year set by the slicer range, 1 Jul-30 Jun) and excludes properties disposed before, or acquired after, each month; with no date selection it iterates every month in the Date Table and returns an unbounded figure, so it is meant to be used with a Date slicer. Caveat: capacity is counted at Property ID grain (one place per property), so this is effectively property-nights rather than per-bed capacity.
	measure 'Total Available Bed Nights (Reporting Month)' =
			SUMX(
			    SUMMARIZE('Date Table', 'Date Table'[Calendar Year Month]),
			    VAR DaysInMonth = CALCULATE(COUNTROWS('Date Table'))
			    RETURN DaysInMonth * [TH Places Contracted (Period)]
			)
		formatString: #,0
		displayFolder: 08. Void Management\Occupancy
		lineageTag: 97ab5a50-6feb-4e04-9dfc-0baf15b0f615

	/// Vacant days at month end, sourced from [Continuous Vacant Days (Period End)]. At a Property (name) row it shows that property's continuous vacant days as at the selected month end; at any total / non-property grain it sums vacant days across all properties (iterated over Property ID). Responds to the Date Table slicer (Period End: uses MAX Calendar Date as the month end); excludes properties confirmed-disposed before the month start and ignores Cancelled tenancies. Units: days. Caveat: the per-row branch keys on Property Name via ISINSCOPE, and Property Names are non-unique (3,408 names vs 3,746 IDs); where one name maps to several Property IDs the name row combines those IDs and returns blank if ANY of them is occupied, so name-level rows sum to LESS than the ID-grain grand total (e.g. Jun-2025 name rows = 49,103 vs total = 53,958; the same under-count recurs in other months). Break down by Property ID for row-to-total consistency, or use the sibling [Total Continuous Days Vacant (Period End)] - an independent ID-grain portfolio total that reconciles exactly. Note: an earlier version returned a property COUNT at the total rather than a day total; that has since been fixed.
	measure 'Days Vacant at Month End' =
			VAR RowValue = [Continuous Vacant Days (Period End)]
			RETURN
			IF (
			    ISINSCOPE ( 'Property'[Property Name] ),
			    RowValue,
			    SUMX ( VALUES ( 'Property'[Property ID] ), [Continuous Vacant Days (Period End)] )
			)
		formatString: #,0
		displayFolder: 08. Void Management\Vacancy
		lineageTag: edc4b195-eca5-40f3-a446-66e375635860

	/// Number of properties unoccupied at the end of the selected period, each property counted once. A property counts when it has no tenancy in place at the end of that day. This includes a property whose tenancy ends on the last day of the period, which shows 0 unoccupied days, and a property that has never been tenanted, counted from when it was acquired. A property disposed of during the period is also counted, which keeps the occupancy row on the CLS vacancy report overview adding up (places contracted equals places occupied plus places unoccupied at the period end); properties disposed of before the period started are not counted. Responds to the date slicer, using the last selected date as the period end. Ignores cancelled tenancies and those not yet activated.
	measure 'Places Unoccupied (Period End)' =
			COUNTROWS (
			    FILTER (
			        VALUES ( 'Property'[Property ID] ),
			        NOT ISBLANK ( [Continuous Vacant Days (Period End)] )
			    )
			)
		formatString: #,0
		displayFolder: 08. Void Management\Vacancy
		lineageTag: e7a5f36d-e689-4c06-884d-1ab5b91b1aba

	/// Internal helper: the start of the selected date range (MIN of 'Date Table'[Calendar Date]). Building block for period measures; hidden from the field list.
	measure 'Period Start Date' = MIN('Date Table'[Calendar Date])
		formatString: d/mm/yyyy
		isHidden
		displayFolder: _Internal
		lineageTag: a39fa433-6610-4f48-a745-af2bfc042590

	/// Internal helper flag: returns 1 when a tenancy's latest Vacated Date falls within the selected date range, else 0. Used as a visual-level filter on the CLS Vacancy report; hidden from the field list (name deliberately unchanged so the existing report filter reference still resolves).
	measure VacatedDateInRange =
			IF(
			    MAX(Tenancy[Vacated Date]) >= [Period Start Date]
			    && MAX(Tenancy[Vacated Date]) <= [Period End Date],
			    1,
			    0
			)
		formatString: 0
		isHidden
		displayFolder: _Internal
		lineageTag: ed33b34d-7ffd-46b0-ae77-38eb017a2b6a

	/// Internal helper: the end of the selected date range (MAX of 'Date Table'[Calendar Date]). Building block for period measures; hidden from the field list.
	measure 'Period End Date' = MAX('Date Table'[Calendar Date])
		formatString: d/mm/yyyy
		isHidden
		displayFolder: _Internal
		lineageTag: 639d226e-9262-4470-bc67-5fc3fa9df999

	/// Portfolio total of continuous days vacant as at the selected month end, summed per property (grain: Property ID). Responds to the Date Table slicer (uses the latest date in context as the month end). Excludes properties confirmed-disposed before the month start and ignores Cancelled tenancies. See the per-property Continuous Vacant Days (Period End) measure for the row-level value.
	measure 'Total Continuous Days Vacant (Period End)' =
			SUMX (
			    VALUES ( 'Property'[Property ID] ),
			    [Continuous Vacant Days (Period End)]
			)
		formatString: #,0
		displayFolder: 08. Void Management\Vacancy
		lineageTag: a7c6b9bb-66e2-44af-a024-c06b67b82309

	/// Serves CHRA KPM 1.1 Total Rent Charged. FY-PERIOD measure summing all Rent Charge transactions whose Transaction Date falls in the selected Date Table window; set the slicer to the financial year of 1 July to 30 June, where the period start is the MIN and the period end the MAX of Date Table Calendar Date, never TODAY. Filters Tenancy Transaction Transaction Type to Rent Charge and negates the stored Amount, which is held negative as a charge, to report a positive value. Includes rent charged to tenants who vacated during the period, per CHRA. Rent per CHRA includes IRRS and excludes bond and other charges. Caveats: the rent versus non-rent split is FIFO-approximate because receipts are applied to rent first and staff can mis-tag transactions, so this figure is approximate until the Savanti bank-import clean-up lands; it is not confirmed that the Rent Charge transaction type captures the IRRS subsidy component, so rent may be understated relative to the CHRA definition; and rent is attributed to the period by Transaction Date, the charge-raised date, rather than the rent-from or rent-to period.
	measure 'CHRA 1.1 Total Rent Charged (Period)' =
			VAR _PeriodStart = MIN('Date Table'[Calendar Date])
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			RETURN
			-CALCULATE(
			    SUM('Tenancy Transaction'[Amount]),
			    'Tenancy Transaction'[Transaction Type] = "Rent Charge",
			    'Tenancy Transaction'[Transaction Date] >= _PeriodStart,
			    'Tenancy Transaction'[Transaction Date] <= _PeriodEnd
			)
		formatString: \$#,0
		displayFolder: 11. CHRA KPM Reporting\KPM 1 - Rent Arrears
		lineageTag: 2fe4d3ee-53c4-4224-9d97-42c2c1ef4426

	/// Serves CHRA KPM 1.2 Total Rent Outstanding as an as-at-period-end snapshot (the last day of the selected range, 30 June for a full financial year; it uses the period end, never today). It takes the latest Aged Debt snapshot dated on or before the period end, filters to Charge Type = Rent, and excludes Cancelled tenancies and any tenancy already vacated by the period end (keeping only a blank Vacated Date or a Vacated Date after the period end). For each remaining tenancy it keeps only an owed (negative) balance, floored at zero, then negates so arrears read as a positive dollar amount; tenancies in credit contribute zero and do not offset other tenancies' arrears, so the result is always greater than or equal to zero and represents gross rent arrears rather than a net portfolio position. Responds to the Date slicer as a period-end snapshot (financial year 1 Jul-30 Jun); caveats: the rent versus non-rent split is FIFO-approximate, and the unbounded 91-plus ageing bucket lumps current-year debt together with prior-year debt.
	measure 'CHRA 1.2 Rent Outstanding (Period End)' =
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			VAR _Snapshot = CALCULATE(MAX('Aged Debt'[As At Date]), 'Aged Debt'[As At Date] <= _PeriodEnd)
			VAR _PerTenancy =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES('Aged Debt'[Property Tenancy ID]), "@bal", CALCULATE(SUM('Aged Debt'[Total Balance]))),
			        'Aged Debt'[As At Date] = _Snapshot,
			        'Aged Debt'[Charge Type] = "Rent",
			        FILTER('Tenancy', (ISBLANK('Tenancy'[Vacated Date]) || 'Tenancy'[Vacated Date] > _PeriodEnd) && 'Tenancy'[Tenancy Status] <> "Cancelled")
			    )
			RETURN
			-SUMX(_PerTenancy, MIN([@bal], 0))
		formatString: \$#,0
		displayFolder: 11. CHRA KPM Reporting\KPM 1 - Rent Arrears
		lineageTag: 1f9a45c2-9ae6-4959-bfd3-696f8cbbf2c8

	/// Serves CHRA KPM 1.3 Number of households as at 30 June. AS-AT-30-JUN snapshot counting distinct active households, meaning tenancies by Property Tenancy ID rather than individual tenants, that started on or before the period end and were not yet vacated at the period end, being a blank Vacated Date or a Vacated Date after the period end. The period end is the MAX of Date Table Calendar Date and never TODAY. Excludes Cancelled tenancies and households who vacated during the reporting period. This is the active-household denominator for the CHRA KPM 1 arrears proportion.
	measure 'CHRA 1.3 Households as at Period End (Period End)' =
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('Tenancy'[Property Tenancy ID]),
			    FILTER(
			        'Tenancy',
			        'Tenancy'[Tenancy Start Date] <= _PeriodEnd
			            && (ISBLANK('Tenancy'[Vacated Date]) || 'Tenancy'[Vacated Date] > _PeriodEnd)
			            && 'Tenancy'[Tenancy Status] <> "Cancelled"
			    )
			)
		formatString: #,0
		displayFolder: 11. CHRA KPM Reporting\KPM 1 - Rent Arrears
		lineageTag: ab612f75-94e1-4e47-9ce0-8b2bb1804c38

	/// Serves CHRA KPM 1.4 Number of households in rent arrears more than 21 days as at 30 June. AS-AT-30-JUN snapshot taking the latest Aged Debt As At Date on or before the period end (the MAX of Date Table Calendar Date, never TODAY), restricted to Charge Type of Rent, excluding Cancelled tenancies and excluding tenancies vacated by the period end (blank Vacated Date or a Vacated Date after the period end). Counts distinct tenancies whose combined 22-28, 29-60, 61-90 and 91-plus day ageing buckets are net negative, i.e. net rent owed for more than 21 calendar days including weekends and public holidays; the 15-21 day bucket is deliberately not treated as over 21 days. Being a per-tenancy count, this is not affected by the portfolio credit-netting that can make the CHRA 1.2 dollar total negative. At FY2024-25 this returns 26 tenancies (about 2.0% of the 1,295 active households in CHRA 1.3). Caveats: the rent versus non-rent split is FIFO-approximate; the unbounded 91-plus bucket cannot fully exclude arrears accumulated in the previous reporting period, so the count is an accepted approximation (an earlier management estimate put the true figure near ~1% / 14-16 tenancies). The vacated and Cancelled exclusions propagate through the active Aged Debt to Tenancy relationship on Property Tenancy ID.
	measure 'CHRA 1.4 Households in Rent Arrears >21 Days (Period End)' =
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			VAR _Snapshot =
			    CALCULATE(
			        MAX('Aged Debt'[As At Date]),
			        'Aged Debt'[As At Date] <= _PeriodEnd
			    )
			VAR _TenanciesOver21 =
			    CALCULATETABLE(
			        ADDCOLUMNS(
			            VALUES('Aged Debt'[Property Tenancy ID]),
			            "@Over21",
			                CALCULATE(
			                    SUM('Aged Debt'[22-28 Days])
			                        + SUM('Aged Debt'[29-60 Days])
			                        + SUM('Aged Debt'[61-90 Days])
			                        + SUM('Aged Debt'[91 Plus Days])
			                )
			        ),
			        'Aged Debt'[As At Date] = _Snapshot,
			        'Aged Debt'[Charge Type] = "Rent",
			        FILTER(
			            'Tenancy',
			            (ISBLANK('Tenancy'[Vacated Date]) || 'Tenancy'[Vacated Date] > _PeriodEnd)
			                && 'Tenancy'[Tenancy Status] <> "Cancelled"
			        )
			    )
			RETURN
			COUNTROWS(FILTER(_TenanciesOver21, [@Over21] < 0))
		formatString: #,0
		displayFolder: 11. CHRA KPM Reporting\KPM 1 - Rent Arrears
		lineageTag: 44af7899-344d-4d88-a377-6e3946e93db7

	/// CHRA KPM 2.1 Number of tenancy terminations (evictions). FY-PERIOD measure that counts tenancies which vacated within the selected financial year window, where Vacated Date falls between the disconnected Date Table slicer MIN and MAX (set the slicer to the financial year 1 Jul to 30 Jun; period end is the slicer MAX date, never TODAY). A termination is defined as Leaving Reason equal to Client was asked to leave / evicted, which is the sole eviction value across all programs. Cancelled tenancies are excluded. Inclusion follows the actual Vacated Date, so a tenant who vacated in-year on a termination notice issued in a prior year is counted, while a household under a termination notice but not due to vacate until after 30 June is excluded. Grain is one row per tenancy (households equal tenancies, not individual tenants). Note: CHRA 2.2 reasons for terminations is degenerate in this model because only one eviction Leaving Reason value exists, so there is no sub-reason breakdown and the 2.2 reason count equals 2.1. This measure also feeds CHRA 4.4 Tenancy Exits together with CHRA 2.3. CAVEAT: relies on Leaving Reason being correctly recorded at vacate.
	measure 'CHRA 2.1 Tenancy Terminations (Period)' =
			VAR _PeriodStart = MIN('Date Table'[Calendar Date])
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			RETURN
			CALCULATE(
			    COUNTROWS('Tenancy'),
			    'Tenancy'[Vacated Date] >= _PeriodStart,
			    'Tenancy'[Vacated Date] <= _PeriodEnd,
			    'Tenancy'[Leaving Reason] = "Client was asked to leave / evicted",
			    'Tenancy'[Tenancy Status] <> "Cancelled"
			)
		formatString: #,0
		displayFolder: 11. CHRA KPM Reporting\KPM 2 - Tenancy Turnover
		lineageTag: e84e11fe-4bf3-4382-a71c-d70b0a2eed12

	/// CHRA KPM 2.3 Number of tenancy exits. FY-PERIOD measure that counts tenancies which vacated within the selected financial year window, where Vacated Date falls between the disconnected Date Table slicer MIN and MAX (set the slicer to the financial year 1 Jul to 30 Jun; period end is the slicer MAX date, never TODAY). An exit is any tenancy that ended for a reason OTHER THAN eviction, so it excludes Leaving Reason Client was asked to leave / evicted, and it also excludes Internal transfer between Emerge services because internal transfers are not counted as exits under the resolved build decision (they remain in scope for CHRA 4.3 new tenancies). Tenancies with a blank Leaving Reason are included as exits, since a blank reason is not an eviction. Includes exits such as abandonment and death of a tenant. Cancelled tenancies are excluded. Grain is one row per tenancy (households equal tenancies, not individual tenants). CHRA 2.4 reasons for exits is this same measure sliced by Tenancy Leaving Reason on the visual axis, with no separate measure built; per the resolved decision the exit-reason axis uses Leaving Reason rather than the sparse Exit Point, and the 2.4 total must equal 2.3. This measure also feeds CHRA 4.4 Tenancy Exits together with CHRA 2.1. CAVEATS: relies on Leaving Reason being correctly recorded; internal transfers are identified only by the Leaving Reason value, so a blank-reason internal transfer cannot be separated and would be counted as an exit.
	measure 'CHRA 2.3 Tenancy Exits (Period)' =
			VAR _PeriodStart = MIN('Date Table'[Calendar Date])
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			RETURN
			CALCULATE(
			    COUNTROWS('Tenancy'),
			    'Tenancy'[Vacated Date] >= _PeriodStart,
			    'Tenancy'[Vacated Date] <= _PeriodEnd,
			    NOT('Tenancy'[Leaving Reason] IN {"Client was asked to leave / evicted", "Internal transfer between Emerge services"}),
			    'Tenancy'[Tenancy Status] <> "Cancelled"
			)
		formatString: #,0
		displayFolder: 11. CHRA KPM Reporting\KPM 2 - Tenancy Turnover
		lineageTag: db711b5b-085b-4780-8a0d-70cac28e4432

	/// Serves CHRA sub-measure 3.1, the count of tenantable vacancies. Period measure: responds to the disconnected Date Table slicer (financial year 1 Jul-30 Jun). Counts void intervals (Property Timeline Record Type = VoidInterval, excluding Void Category RTLL) whose tenantable-vacant re-let lag overlaps the selected period - the lag runs from the Property Is Ready milestone (the interval end date) to the next interval start (interval end date plus Days Between Intervals), and a void is counted when that lag, clipped to the period with the period end made exclusive, is greater than zero; the grain is the void interval, so a property with several voids counts each, and it pairs with CHRA 3.2 as average tenantable-vacant days per vacancy (3.2 / 3.1). Because it counts any lag overlapping the period rather than lags that ended in-period, it is meaningful only at whole-financial-year grain and is not additive across sub-periods, so on a monthly axis a lag spanning several months is counted in each month and the twelve monthly values exceed the annual total.
	measure 'CHRA 3.1 Tenantable Vacancies Ended (Period)' =
			VAR _PeriodStart = MIN('Date Table'[Calendar Date])
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			RETURN
			SUMX(
			    FILTER(
			        'Property Timeline',
			        'Property Timeline'[Record Type] = "VoidInterval"
			            && 'Property Timeline'[Void Category] <> "RTLL"
			    ),
			    VAR _ReadyDate = 'Property Timeline'[Interval End Date]
			    VAR _LagEnd = 'Property Timeline'[Interval End Date] + 'Property Timeline'[Days Between Intervals]
			    VAR _ClampedStart = MAX(_ReadyDate, _PeriodStart)
			    VAR _ClampedEnd = MIN(_LagEnd, _PeriodEnd + 1)
			    VAR _LagDays = MAX(0, DATEDIFF(_ClampedStart, _ClampedEnd, DAY))
			    RETURN IF(_LagDays > 0, 1, 0)
			)
		formatString: #,0
		displayFolder: 11. CHRA KPM Reporting\KPM 3 - Turnaround Time
		lineageTag: d9829f8b-4f06-4a78-8711-fe583397d7a1

	/// Serves CHRA sub-measure 3.2 (total tenantable days vacant). Period-type Period (set the disconnected Date Table slicer to the financial year, 1 Jul to 30 Jun). Sums the calendar days on which properties were tenantable (ready to let) and still vacant during the selected financial year. Tenantable-vacant time is the re-let lag that FOLLOWS a void: a void interval ends at the Property Is Ready milestone, so the days counted here sit outside the void interval, between a property becoming ready and the next interval starting. Measured per void interval excluding Returned-To-Landlord voids, clipped to the financial year with the period end made exclusive so month buckets are additive, and floored at zero. Because this lag lies outside the void interval, 3.2 and 3.4 do not sum to Timeline Void Days; CHRA 3.4 alone equals the untenantable in-void days.
	measure 'CHRA 3.2 Tenantable Days Vacant (Period)' =
			VAR _PeriodStart = MIN('Date Table'[Calendar Date])
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			RETURN
			SUMX(
			    FILTER(
			        'Property Timeline',
			        'Property Timeline'[Record Type] = "VoidInterval"
			            && 'Property Timeline'[Void Category] <> "RTLL"
			    ),
			    VAR _ReadyDate = 'Property Timeline'[Interval End Date]
			    VAR _LagEnd = 'Property Timeline'[Interval End Date] + 'Property Timeline'[Days Between Intervals]
			    VAR _ClampedStart = MAX(_ReadyDate, _PeriodStart)
			    VAR _ClampedEnd = MIN(_LagEnd, _PeriodEnd + 1)
			    RETURN MAX(0, DATEDIFF(_ClampedStart, _ClampedEnd, DAY))
			)
		formatString: #,0
		displayFolder: 11. CHRA KPM Reporting\KPM 3 - Turnaround Time
		lineageTag: 47120a01-25bb-49c3-98c2-8d3bd14213fe

	/// Serves CHRA sub-measure 3.3 (number of untenantable vacancies). Period-type Period (set the disconnected Date Table slicer to the financial year, 1 Jul to 30 Jun). Counts void intervals (Property Timeline Record Type VoidInterval) that ENDED within the selected FY (Interval End Date between period start and period end) and had an untenantable phase within the window. The untenantable phase is the portion before the Void Checklist milestone Property Is Ready - Convert To Vacant: Tenantable (resolved by LOOKUPVALUE on Void Checklist ID), or the whole interval when the milestone is blank; a void is counted when its clipped start-to-ready days are greater than zero. Excludes Void Category RTLL. Includes vacancies that started in a prior period. Grain is the void interval, so a property with several voids counts each. Not mutually exclusive with 3.1 - a void spanning both phases is counted in both. MAX of zero floors negative or future-dated data quirks. CAVEAT: intended for whole-FY reporting - the count is NOT perfectly additive across sub-periods. It is anchored on Interval End Date (which lands in a single month), but the qualifying untenantable-days test re-clips each interval to the reporting window, so a void whose untenantable (start-to-ready) phase fell in a month EARLIER than the month its interval ended contributes zero untenantable days in that end-month and qualifies at whole-FY scope but in no single month. The monthly parts therefore fall slightly short of the annual total (FY24-25: annual 2,057 vs sum of months 2,014). This is NOT caused by the inclusive period-end clamp - making that boundary exclusive (+1) leaves both figures unchanged (still 2,057 vs 2,014), because the ended-in-period FILTER already bounds Interval End Date to the window.
	measure 'CHRA 3.3 Untenantable Vacancies Ended (Period)' =
			VAR _PeriodStart = MIN('Date Table'[Calendar Date])
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			RETURN
			SUMX(
			    FILTER(
			        'Property Timeline',
			        'Property Timeline'[Record Type] = "VoidInterval"
			            && 'Property Timeline'[Void Category] <> "RTLL"
			            && 'Property Timeline'[Interval End Date] >= _PeriodStart
			            && 'Property Timeline'[Interval End Date] <= _PeriodEnd
			    ),
			    VAR _Ready =
			        LOOKUPVALUE(
			            'Void Checklist'[Property Is Ready - Convert To Vacant: Tenantable],
			            'Void Checklist'[Void Checklist ID], 'Property Timeline'[Void Checklist ID]
			        )
			    VAR _ClampedStart = MAX('Property Timeline'[Interval Start Date], _PeriodStart)
			    VAR _ClampedEnd = MIN('Property Timeline'[Interval End Date], _PeriodEnd)
			    VAR _UntenantableEnd = IF(ISBLANK(_Ready), _ClampedEnd, MIN(_Ready, _ClampedEnd))
			    VAR _UntenantableDays = MAX(0, DATEDIFF(_ClampedStart, _UntenantableEnd, DAY))
			    RETURN IF(_UntenantableDays > 0, 1, 0)
			)
		formatString: #,0
		displayFolder: 11. CHRA KPM Reporting\KPM 3 - Turnaround Time
		lineageTag: dc9ec6ed-beb6-41a8-a62c-bd4155837ad9

	/// Serves CHRA sub-measure 3.4, total untenantable days vacant. Period measure: responds to the disconnected Date Table slicer (financial year 1 Jul-30 Jun). It sums the calendar days a property was untenantable and still vacant within the selected period by iterating non-RTLL void intervals (Property Timeline Record Type = VoidInterval) overlapping the period, clipping each to the period with the end made exclusive so month buckets stay additive, and summing the days from the clipped interval start to the Void Checklist milestone Property Is Ready - Convert To Vacant: Tenantable (resolved by LOOKUPVALUE on Void Checklist ID); when that milestone is blank all clipped days count as untenantable, and a zero floor removes negative or future-dated quirks. Because CHRA 3.2's tenantable re-let lag lies outside the void interval, the earlier control that 3.2 plus 3.4 reconciles to Timeline Void Days (Period) excluding RTLL is retired, but 3.4 alone equals the untenantable in-void days and closely matches Timeline Void Days excluding RTLL.
	measure 'CHRA 3.4 Untenantable Days Vacant (Period)' =
			VAR _PeriodStart = MIN('Date Table'[Calendar Date])
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			RETURN
			SUMX(
			    FILTER(
			        'Property Timeline',
			        'Property Timeline'[Record Type] = "VoidInterval"
			            && 'Property Timeline'[Void Category] <> "RTLL"
			            && 'Property Timeline'[Interval Start Date] <= _PeriodEnd
			            && 'Property Timeline'[Interval End Date] >= _PeriodStart
			    ),
			    VAR _Ready =
			        LOOKUPVALUE(
			            'Void Checklist'[Property Is Ready - Convert To Vacant: Tenantable],
			            'Void Checklist'[Void Checklist ID], 'Property Timeline'[Void Checklist ID]
			        )
			    VAR _ClampedStart = MAX('Property Timeline'[Interval Start Date], _PeriodStart)
			    VAR _ClampedEnd = MIN('Property Timeline'[Interval End Date], _PeriodEnd + 1)
			    VAR _UntenantableEnd = IF(ISBLANK(_Ready), _ClampedEnd, MIN(_Ready, _ClampedEnd))
			    RETURN MAX(0, DATEDIFF(_ClampedStart, _UntenantableEnd, DAY))
			)
		formatString: #,0
		displayFolder: 11. CHRA KPM Reporting\KPM 3 - Turnaround Time
		lineageTag: 7493f0fb-b018-49a8-a6c8-3ec87062014d

	/// CHRA KPM 4 sub-measure 4.1 (Number of properties owned or leased as at 30 June). Period-type Period End: as-at the last date of the Date Table slicer, which the user sets to the financial year 1 Jul to 30 Jun, so as at 30 June equals the period end and never TODAY. Distinct count of Property ID in the active portfolio at period end, where a property is active when Acquired Date is on or before period end AND (Confirmed Disposal Date is blank OR on or after period end). The greater-than-or-equal disposal boundary is deliberate so that 4.2 equals 4.1 minus the period-end vacancy count. Includes all properties across ALL programs, including vacancies and properties whose management is contracted out, with no ownership or program exclusion (Management ownership is treated as Emerge own portfolio). Excludes properties managed on behalf of other organisations. Uses Confirmed Disposal Date only and ignores the separate Disposal Date column; Property Status is current-only and is not used for this historical snapshot.
	measure 'CHRA 4.1 Properties Owned or Leased (Period End)' =
			VAR _PeriodEnd = MAX ( 'Date Table'[Calendar Date] )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'Property'[Property ID] ),
			        FILTER (
			            'Property',
			            'Property'[Acquired Date] <= _PeriodEnd
			                && (
			                    ISBLANK ( 'Property'[Confirmed Disposal Date] )
			                        || 'Property'[Confirmed Disposal Date] >= _PeriodEnd
			                )
			        )
			    )
		formatString: #,0
		displayFolder: 11. CHRA KPM Reporting\KPM 4 - Occupancy Rate
		lineageTag: 0fffd9ad-568d-4f89-aeae-6406d0b37bd0

	/// CHRA KPM 4 sub-measure 4.2 (Number of tenanted properties as at 30 June, equal to total owned or leased minus current vacancies). Period-type Period End: as-at the last date of the Date Table slicer set to the financial year, so as at 30 June equals the period end and never TODAY. Counts active-portfolio properties that have an active tenancy agreement in place at period end, across ALL programs with no ownership or program exclusion. It reuses the trusted Count of Unoccupied Properties (Period End) active-portfolio and active-tenancy pattern and returns the tenanted complement: a property counts when it has at least one non-Cancelled tenancy that started on or before period end and has either a blank Vacated Date or a Vacated Date on or after period end. Active portfolio uses Acquired Date on or before period end AND (Confirmed Disposal Date blank OR on or after period end); the greater-than-or-equal disposal boundary matches 4.1 so that 4.2 equals 4.1 minus the period-end vacancy count. Excludes Cancelled tenancies and properties managed on behalf of others.
	measure 'CHRA 4.2 Properties Tenanted (Period End)' =
			VAR _AsAtDate = MAX ( 'Date Table'[Calendar Date] )
			VAR _ActiveProperties =
			    FILTER (
			        'Property',
			        'Property'[Acquired Date] <= _AsAtDate
			            && (
			                ISBLANK ( 'Property'[Confirmed Disposal Date] )
			                    || 'Property'[Confirmed Disposal Date] >= _AsAtDate
			            )
			    )
			RETURN
			    SUMX (
			        _ActiveProperties,
			        VAR _PropertyTenancies =
			            FILTER (
			                RELATEDTABLE ( 'Tenancy' ),
			                'Tenancy'[Tenancy Status] <> "Cancelled"
			                    && 'Tenancy'[Tenancy Start Date] <= _AsAtDate
			            )
			        VAR _HasActiveTenancy =
			            COUNTROWS (
			                FILTER (
			                    _PropertyTenancies,
			                    ISBLANK ( 'Tenancy'[Vacated Date] )
			                        || 'Tenancy'[Vacated Date] >= _AsAtDate
			                )
			            ) > 0
			        RETURN
			            IF ( _HasActiveTenancy, 1, 0 )
			    )
		formatString: #,0
		displayFolder: 11. CHRA KPM Reporting\KPM 4 - Occupancy Rate
		lineageTag: 4edae37a-ce3f-4d9b-87f6-aef77d80fd9b

	/// CHRA KPM 4 sub-measure 4.3 (Number of new tenancies commenced during the period). Period-type Period: aggregated across the Date Table slicer range set to the financial year 1 Jul to 30 Jun. This is a thin CHRA-named alias of the existing Tenancies Started (Period) measure, keeping the whole CHRA return in one folder: it counts tenancies whose Tenancy Start Date falls within the selected period, across ALL programs, excluding Cancelled tenancies. Per CHRA, internal transfers (tenants transferring from one tenancy to another within Emerge) are included, and tenancy length does not matter, so a tenancy that commenced and ended within the same year still counts. Temporary relocations, where a tenant is temporarily housed elsewhere during maintenance, cannot be separated in the source and are therefore not excluded as CHRA requires.
	measure 'CHRA 4.3 New Tenancies (Period)' = [Tenancies Started (Period)]
		formatString: #,0
		displayFolder: 11. CHRA KPM Reporting\KPM 4 - Occupancy Rate
		lineageTag: f4dabcd5-b143-47da-b542-4ebb24eaf19a

	/// Serves CHRA KPM 4.4 Number of tenancy exits. FY-PERIOD total equal to CHRA 2.1 Tenancy Terminations (Period) plus CHRA 2.3 Tenancy Exits (Period) - evictions plus non-eviction exits, both excluding the internal-transfer leaving reason and Cancelled tenancies. Auto-populates from the KPM 2 measures per CHRA. Set the Date Table slicer to the financial year 1 July to 30 June.
	measure 'CHRA 4.4 Tenancy Exits (Period)' = [CHRA 2.1 Tenancy Terminations (Period)] + [CHRA 2.3 Tenancy Exits (Period)]
		formatString: #,0
		displayFolder: 11. CHRA KPM Reporting\KPM 4 - Occupancy Rate
		lineageTag: 498f4fd3-a1c5-4233-ab0b-7e12a7a6aeab

	/// Serves CHRA KPM 6.1 Number of urgent repair requests received. Period-type FY-PERIOD: counts maintenance work orders whose Created Date falls inside the disconnected Date Table slicer window, which the user sets to the financial year 1 July to 30 June (period read as MIN and MAX of Calendar Date, never TODAY). Grain is one row per Property Maintenance work order (work-order grain, not the finer Property Maintenance Task grain). Includes work orders whose Task Urgency is Urgent or Emergency; excludes cancelled work orders (Is Work Task Cancelled not equal to 1) and excludes Standard, Cyclical, Planned, Void and Minor upgrade urgencies which are planned or cyclical work rather than repair requests. Caveat: the mapping of Urgent and Emergency to the CHRA definition of disrepair likely to cause injury to people or property is a best-guess and is not yet validated; the received date is the work-order Created Date at calendar-day grain with no time component.
	measure 'CHRA 6.1 Urgent Repairs Received (Period)' =
			VAR _S = MIN('Date Table'[Calendar Date])
			VAR _E = MAX('Date Table'[Calendar Date])
			RETURN
			CALCULATE(
			    COUNTROWS('Property Maintenance'),
			    'Property Maintenance'[Task Urgency] IN {"Urgent", "Emergency"},
			    'Property Maintenance'[Is Work Task Cancelled] <> 1,
			    'Property Maintenance'[Created Date] >= _S,
			    'Property Maintenance'[Created Date] <= _E
			)
		formatString: #,0
		displayFolder: 11. CHRA KPM Reporting\KPM 6 - Repair Timeframes
		lineageTag: b840b71e-c747-43be-9a22-21524d01a58d

	/// Serves CHRA KPM 6.2 Number of urgent repair requests completed within 24 hours. Period-type FY-PERIOD over the same urgent work orders received in the financial-year window as CHRA 6.1 (Task Urgency Urgent or Emergency, not cancelled, Created Date between the Date Table slicer MIN and MAX). Grain is work-order grain, kept identical to 6.1 so the completed count can never exceed the received count. Completion is resolved at day grain: each work order is treated as completed on the latest Actual Contractor Completion Date across its Property Maintenance Task rows (matched by Property Maintenance ID), and the work order counts when that completion falls on or within 1 calendar day of its Created Date. Prominent best-guess caveats: contractor completion dates are populated on only about 27 percent of tasks and the maintenance data only begins in March 2022, so this materially understates true completions; Created Date carries no time component so within 24 hours is approximated as a zero or one day-grain difference; the closed-off versus built and interim versus final completion semantics are unreliable, and the latest task completion is taken as the work-order completion which can under-count interim repairs that CHRA directs be included.
	measure 'CHRA 6.2 Urgent Repairs Completed <=24h (Period)' =
			VAR _S = MIN('Date Table'[Calendar Date])
			VAR _E = MAX('Date Table'[Calendar Date])
			RETURN
			COUNTROWS(
			    FILTER(
			        'Property Maintenance',
			        VAR _pmid = 'Property Maintenance'[Property Maintenance ID]
			        VAR _created = 'Property Maintenance'[Created Date]
			        VAR _completion =
			            CALCULATE(
			                MAX('Property Maintenance Task'[Actual Contractor Completion Date]),
			                FILTER(
			                    ALL('Property Maintenance Task'),
			                    'Property Maintenance Task'[Property Maintenance ID] = _pmid
			                )
			            )
			        VAR _days = DATEDIFF(_created, _completion, DAY)
			        RETURN
			            'Property Maintenance'[Task Urgency] IN {"Urgent", "Emergency"}
			                && 'Property Maintenance'[Is Work Task Cancelled] <> 1
			                && _created >= _S
			                && _created <= _E
			                && NOT(ISBLANK(_completion))
			                && _days >= 0
			                && _days <= 1
			    )
			)
		formatString: #,0
		displayFolder: 11. CHRA KPM Reporting\KPM 6 - Repair Timeframes
		lineageTag: 0b126beb-07cb-48b0-9f6a-a3a3dad846a5

	/// Serves CHRA KPM 6.3 Number of non-urgent repair requests received. Period-type FY-PERIOD: counts maintenance work orders whose Created Date falls inside the disconnected Date Table slicer window set to the financial year 1 July to 30 June (period read as MIN and MAX of Calendar Date, never TODAY). Grain is one row per Property Maintenance work order (work-order grain, not the Property Maintenance Task grain). Includes work orders whose Task Urgency is Standard; excludes cancelled work orders (Is Work Task Cancelled not equal to 1) and excludes Urgent, Emergency, Cyclical, Planned, Void and Minor upgrade urgencies, so planned and cyclical maintenance is out of scope per the CHRA non-urgent definition. Caveat: the mapping of Standard to the CHRA definition of non-urgent (disrepair unlikely to cause injury and not part of planned or cyclical maintenance) is a best-guess and is not yet validated; the received date is the work-order Created Date at calendar-day grain.
	measure 'CHRA 6.3 Non-Urgent Repairs Received (Period)' =
			VAR _S = MIN('Date Table'[Calendar Date])
			VAR _E = MAX('Date Table'[Calendar Date])
			RETURN
			CALCULATE(
			    COUNTROWS('Property Maintenance'),
			    'Property Maintenance'[Task Urgency] = "Standard",
			    'Property Maintenance'[Is Work Task Cancelled] <> 1,
			    'Property Maintenance'[Created Date] >= _S,
			    'Property Maintenance'[Created Date] <= _E
			)
		formatString: #,0
		displayFolder: 11. CHRA KPM Reporting\KPM 6 - Repair Timeframes
		lineageTag: 7dfc9e77-94ac-4fe5-8be8-d4156dc6cf23

	/// Serves CHRA KPM 6.4 Number of non-urgent repair requests completed within 14 days. Period-type FY-PERIOD over the same non-urgent work orders received in the financial-year window as CHRA 6.3 (Task Urgency Standard, not cancelled, Created Date between the Date Table slicer MIN and MAX). Grain is work-order grain, kept identical to 6.3 so the completed count can never exceed the received count. Completion is resolved at day grain: each work order is treated as completed on the latest Actual Contractor Completion Date across its Property Maintenance Task rows (matched by Property Maintenance ID), and the work order counts when that completion falls on or within 14 calendar days of its Created Date. Prominent best-guess caveats: contractor completion dates are populated on only about 27 percent of tasks and the maintenance data only begins in March 2022, so this materially understates true completions; Created Date carries no time component so within 14 days is approximated as a day-grain difference of 14 or fewer; the closed-off versus built and interim versus final completion semantics are unreliable, and the latest task completion is taken as the work-order completion which can under-count interim repairs that CHRA directs be included.
	measure 'CHRA 6.4 Non-Urgent Repairs Completed <=14d (Period)' =
			VAR _S = MIN('Date Table'[Calendar Date])
			VAR _E = MAX('Date Table'[Calendar Date])
			RETURN
			COUNTROWS(
			    FILTER(
			        'Property Maintenance',
			        VAR _pmid = 'Property Maintenance'[Property Maintenance ID]
			        VAR _created = 'Property Maintenance'[Created Date]
			        VAR _completion =
			            CALCULATE(
			                MAX('Property Maintenance Task'[Actual Contractor Completion Date]),
			                FILTER(
			                    ALL('Property Maintenance Task'),
			                    'Property Maintenance Task'[Property Maintenance ID] = _pmid
			                )
			            )
			        VAR _days = DATEDIFF(_created, _completion, DAY)
			        RETURN
			            'Property Maintenance'[Task Urgency] = "Standard"
			                && 'Property Maintenance'[Is Work Task Cancelled] <> 1
			                && _created >= _S
			                && _created <= _E
			                && NOT(ISBLANK(_completion))
			                && _days >= 0
			                && _days <= 14
			    )
			)
		formatString: #,0
		displayFolder: 11. CHRA KPM Reporting\KPM 6 - Repair Timeframes
		lineageTag: 5422a998-5500-43fb-b320-7f2f90757a81

	/// Serves the KPM 6 total: count of repair requests received (by work-order Created Date) within the Date Table financial-year window (1 Jul to 30 Jun; period read as MIN and MAX of Calendar Date, never TODAY), urgent and non-urgent combined. Equals [CHRA 6.1 Urgent Repairs Received (Period)] + [CHRA 6.3 Non-Urgent Repairs Received (Period)]. At aggregate grain it returns the total received count; at Property Maintenance work-order grain it returns 1 for a received work order (else blank), so it doubles as the visual-level scope filter (> 0) on the KPM 6 Work Order detail drill-through page. Work-order grain; excludes cancelled work orders and any urgency other than Urgent, Emergency or Standard (matching 6.1 and 6.3).
	measure 'CHRA 6 Repairs Received (Period)' = [CHRA 6.1 Urgent Repairs Received (Period)] + [CHRA 6.3 Non-Urgent Repairs Received (Period)]
		formatString: #,0
		displayFolder: 11. CHRA KPM Reporting\KPM 6 - Repair Timeframes
		lineageTag: c6a01d00-0000-4c6a-9e00-000000000006

	/// Serves CHRA KPM 4 occupancy rate as a percentage. Point-in-time at the period end (30 Jun): tenanted divided by owned or leased, across the active portfolio for all in-scope programs. Set the Date Table slicer to the financial year; period end is its MAX date, never TODAY.
	measure 'CHRA 4.2 Occupancy Rate % (Period End)' = DIVIDE([CHRA 4.2 Properties Tenanted (Period End)], [CHRA 4.1 Properties Owned or Leased (Period End)])
		formatString: 0.0%
		displayFolder: 11. CHRA KPM Reporting\KPM 4 - Occupancy Rate
		lineageTag: a1a5ba4c-5695-425c-9a38-d0737c1857f5

	/// CHRA KPM 4 supporting measure: number of vacant properties as at the period end = [CHRA 4.1 Properties Owned or Leased (Period End)] minus [CHRA 4.2 Properties Tenanted (Period End)]. Period-type Period End: as-at the last date of the Date Table slicer, which the user sets to the financial year 1 Jul to 30 Jun, so as at 30 June equals the period end and never TODAY. A property is vacant when it is in the active portfolio (Acquired Date on or before period end AND Confirmed Disposal Date blank or on or after period end) but has no non-Cancelled tenancy in place at period end. Excludes Cancelled tenancies and properties managed on behalf of other organisations; counts across all programs including contracted-out management. Cannot be negative because the tenanted set is a subset of the owned or leased set (equal when the portfolio is fully tenanted) and Property is one row per Property ID. Units: count of properties.
	measure 'CHRA 4 Vacancies (Period End)' = [CHRA 4.1 Properties Owned or Leased (Period End)] - [CHRA 4.2 Properties Tenanted (Period End)]
		formatString: #,0
		displayFolder: 11. CHRA KPM Reporting\KPM 4 - Occupancy Rate
		lineageTag: c195d913-b29e-4703-b8fe-9c66743a71fd

	/// Period-end pinned rent outstanding in the 0-21 day ageing band (Current 0-6 + 7-14 + 15-21), counting only tenancies whose total rent balance is net owed. Uses the same per-tenancy floor as CHRA 1.2 Rent Outstanding, so the five CHRA 1.2 Rent NN Days buckets now sum EXACTLY to CHRA 1.2 Rent Outstanding (Period End). As-at-30-Jun snapshot (latest Aged Debt As At Date <= period end), Charge Type Rent, excludes Cancelled and already-vacated tenancies. The four >21-day buckets (22-28 + 29-60 + 61-90 + 91+) are the arrears behind CHRA 1.4. Rent/non-rent split FIFO-approximate.
	measure 'CHRA 1.2 Rent 0-21 Days (Period End)' =
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			VAR _Snapshot = CALCULATE(MAX('Aged Debt'[As At Date]), 'Aged Debt'[As At Date] <= _PeriodEnd)
			VAR _PerTenancy =
			    CALCULATETABLE(
			        ADDCOLUMNS(
			            VALUES('Aged Debt'[Property Tenancy ID]),
			            "@bal", CALCULATE(SUM('Aged Debt'[Total Balance])),
			            "@bucket", CALCULATE(SUM('Aged Debt'[Current 0-6 Days]) + SUM('Aged Debt'[7-14 Days]) + SUM('Aged Debt'[15-21 Days]))
			        ),
			        'Aged Debt'[As At Date] = _Snapshot,
			        'Aged Debt'[Charge Type] = "Rent",
			        FILTER('Tenancy', (ISBLANK('Tenancy'[Vacated Date]) || 'Tenancy'[Vacated Date] > _PeriodEnd) && 'Tenancy'[Tenancy Status] <> "Cancelled")
			    )
			RETURN -SUMX(FILTER(_PerTenancy, [@bal] < 0), [@bucket])
		formatString: \$#,0
		displayFolder: 11. CHRA KPM Reporting\KPM 1 - Rent Arrears
		lineageTag: c12b0000-0000-4c12-b000-000000000021

	/// Period-end pinned rent outstanding in the 22-28 day ageing band (22-28 Days), counting only tenancies whose total rent balance is net owed. Uses the same per-tenancy floor as CHRA 1.2 Rent Outstanding, so the five CHRA 1.2 Rent NN Days buckets now sum EXACTLY to CHRA 1.2 Rent Outstanding (Period End). As-at-30-Jun snapshot (latest Aged Debt As At Date <= period end), Charge Type Rent, excludes Cancelled and already-vacated tenancies. The four >21-day buckets (22-28 + 29-60 + 61-90 + 91+) are the arrears behind CHRA 1.4. Rent/non-rent split FIFO-approximate.
	measure 'CHRA 1.2 Rent 22-28 Days (Period End)' =
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			VAR _Snapshot = CALCULATE(MAX('Aged Debt'[As At Date]), 'Aged Debt'[As At Date] <= _PeriodEnd)
			VAR _PerTenancy =
			    CALCULATETABLE(
			        ADDCOLUMNS(
			            VALUES('Aged Debt'[Property Tenancy ID]),
			            "@bal", CALCULATE(SUM('Aged Debt'[Total Balance])),
			            "@bucket", CALCULATE(SUM('Aged Debt'[22-28 Days]))
			        ),
			        'Aged Debt'[As At Date] = _Snapshot,
			        'Aged Debt'[Charge Type] = "Rent",
			        FILTER('Tenancy', (ISBLANK('Tenancy'[Vacated Date]) || 'Tenancy'[Vacated Date] > _PeriodEnd) && 'Tenancy'[Tenancy Status] <> "Cancelled")
			    )
			RETURN -SUMX(FILTER(_PerTenancy, [@bal] < 0), [@bucket])
		formatString: \$#,0
		displayFolder: 11. CHRA KPM Reporting\KPM 1 - Rent Arrears
		lineageTag: c12b0000-0000-4c12-b000-000000002228

	/// Period-end pinned rent outstanding in the 29-60 day ageing band (29-60 Days), counting only tenancies whose total rent balance is net owed. Uses the same per-tenancy floor as CHRA 1.2 Rent Outstanding, so the five CHRA 1.2 Rent NN Days buckets now sum EXACTLY to CHRA 1.2 Rent Outstanding (Period End). As-at-30-Jun snapshot (latest Aged Debt As At Date <= period end), Charge Type Rent, excludes Cancelled and already-vacated tenancies. The four >21-day buckets (22-28 + 29-60 + 61-90 + 91+) are the arrears behind CHRA 1.4. Rent/non-rent split FIFO-approximate.
	measure 'CHRA 1.2 Rent 29-60 Days (Period End)' =
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			VAR _Snapshot = CALCULATE(MAX('Aged Debt'[As At Date]), 'Aged Debt'[As At Date] <= _PeriodEnd)
			VAR _PerTenancy =
			    CALCULATETABLE(
			        ADDCOLUMNS(
			            VALUES('Aged Debt'[Property Tenancy ID]),
			            "@bal", CALCULATE(SUM('Aged Debt'[Total Balance])),
			            "@bucket", CALCULATE(SUM('Aged Debt'[29-60 Days]))
			        ),
			        'Aged Debt'[As At Date] = _Snapshot,
			        'Aged Debt'[Charge Type] = "Rent",
			        FILTER('Tenancy', (ISBLANK('Tenancy'[Vacated Date]) || 'Tenancy'[Vacated Date] > _PeriodEnd) && 'Tenancy'[Tenancy Status] <> "Cancelled")
			    )
			RETURN -SUMX(FILTER(_PerTenancy, [@bal] < 0), [@bucket])
		formatString: \$#,0
		displayFolder: 11. CHRA KPM Reporting\KPM 1 - Rent Arrears
		lineageTag: c12b0000-0000-4c12-b000-000000002960

	/// Period-end pinned rent outstanding in the 61-90 day ageing band (61-90 Days), counting only tenancies whose total rent balance is net owed. Uses the same per-tenancy floor as CHRA 1.2 Rent Outstanding, so the five CHRA 1.2 Rent NN Days buckets now sum EXACTLY to CHRA 1.2 Rent Outstanding (Period End). As-at-30-Jun snapshot (latest Aged Debt As At Date <= period end), Charge Type Rent, excludes Cancelled and already-vacated tenancies. The four >21-day buckets (22-28 + 29-60 + 61-90 + 91+) are the arrears behind CHRA 1.4. Rent/non-rent split FIFO-approximate.
	measure 'CHRA 1.2 Rent 61-90 Days (Period End)' =
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			VAR _Snapshot = CALCULATE(MAX('Aged Debt'[As At Date]), 'Aged Debt'[As At Date] <= _PeriodEnd)
			VAR _PerTenancy =
			    CALCULATETABLE(
			        ADDCOLUMNS(
			            VALUES('Aged Debt'[Property Tenancy ID]),
			            "@bal", CALCULATE(SUM('Aged Debt'[Total Balance])),
			            "@bucket", CALCULATE(SUM('Aged Debt'[61-90 Days]))
			        ),
			        'Aged Debt'[As At Date] = _Snapshot,
			        'Aged Debt'[Charge Type] = "Rent",
			        FILTER('Tenancy', (ISBLANK('Tenancy'[Vacated Date]) || 'Tenancy'[Vacated Date] > _PeriodEnd) && 'Tenancy'[Tenancy Status] <> "Cancelled")
			    )
			RETURN -SUMX(FILTER(_PerTenancy, [@bal] < 0), [@bucket])
		formatString: \$#,0
		displayFolder: 11. CHRA KPM Reporting\KPM 1 - Rent Arrears
		lineageTag: c12b0000-0000-4c12-b000-000000006190

	/// Period-end pinned rent outstanding in the 91+ day ageing band (91 Plus Days), counting only tenancies whose total rent balance is net owed. Uses the same per-tenancy floor as CHRA 1.2 Rent Outstanding, so the five CHRA 1.2 Rent NN Days buckets now sum EXACTLY to CHRA 1.2 Rent Outstanding (Period End). As-at-30-Jun snapshot (latest Aged Debt As At Date <= period end), Charge Type Rent, excludes Cancelled and already-vacated tenancies. The four >21-day buckets (22-28 + 29-60 + 61-90 + 91+) are the arrears behind CHRA 1.4. Rent/non-rent split FIFO-approximate.
	measure 'CHRA 1.2 Rent 91+ Days (Period End)' =
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			VAR _Snapshot = CALCULATE(MAX('Aged Debt'[As At Date]), 'Aged Debt'[As At Date] <= _PeriodEnd)
			VAR _PerTenancy =
			    CALCULATETABLE(
			        ADDCOLUMNS(
			            VALUES('Aged Debt'[Property Tenancy ID]),
			            "@bal", CALCULATE(SUM('Aged Debt'[Total Balance])),
			            "@bucket", CALCULATE(SUM('Aged Debt'[91 Plus Days]))
			        ),
			        'Aged Debt'[As At Date] = _Snapshot,
			        'Aged Debt'[Charge Type] = "Rent",
			        FILTER('Tenancy', (ISBLANK('Tenancy'[Vacated Date]) || 'Tenancy'[Vacated Date] > _PeriodEnd) && 'Tenancy'[Tenancy Status] <> "Cancelled")
			    )
			RETURN -SUMX(FILTER(_PerTenancy, [@bal] < 0), [@bucket])
		formatString: \$#,0
		displayFolder: 11. CHRA KPM Reporting\KPM 1 - Rent Arrears
		lineageTag: c12b0000-0000-4c12-b000-000000000091

	/// Count of properties still held at the END of the selected period: acquired on or before the period end and not disposed of before it. Companion to Active Properties (Period), which counts a property if it was held at any point during the period and is shown on the CLS vacancy report as Places Contracted. The difference between the two is the number of properties disposed of part-way through the period. Use this where the figure needs to line up with the period-end occupancy and vacancy counts, which are also taken as at the period end. Requires a date selection: with no date filter it reads the latest date in the Date table.
	measure 'Places Active (Period End)' =
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			RETURN
			COUNTROWS(
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= _PeriodEnd &&
			        (ISBLANK('Property'[Confirmed Disposal Date]) ||
			         'Property'[Confirmed Disposal Date] >= _PeriodEnd)
			    )
			)
		formatString: #,0
		displayFolder: 01. Property Portfolio\Date-Aware
		lineageTag: f4000000-0000-4f40-b400-000000000001

	/// Number of properties disposed of part-way through the selected period: held at some point during the period but no longer held at the period end. Calculated as Active Properties (Period) minus Places Active (Period End). It makes the occupancy card row on the CLS vacancy report add up, where the row reads Places Contracted = Places Occupied at Period End + Count of Unoccupied Properties + Places Disposed During Period. Reads zero in a period with no disposals. Two conditions apply: the occupied figure only ever covers Transitional Housing properties, so the row balances on pages filtered to Transitional Housing, which is how that report is set up; and a date range must be selected.
	measure 'Places Disposed During Period' = COALESCE([Active Properties (Period)], 0) - COALESCE([Places Active (Period End)], 0)
		formatString: #,0
		displayFolder: 01. Property Portfolio\Date-Aware
		lineageTag: f4000000-0000-4f40-b400-000000000002

	/// Days a property stood unoccupied inside the selected period and was not yet ready to let. It splits the same count as Unoccupied Days (Period), shown in reports as Count of Unoccupied Days, and together with Tenantable Unoccupied Days (Period) it adds up to that count for every property, name, city and total. Every vacancy that falls inside the period is counted, not only the one in force at the end, so two or more vacancies add together, each clipped to the period and split at its own ready to let milestone. That milestone is the latest recorded on the void checklists for that vacancy, leaving out any on a checklist marked as reverted to untenantable, or, if they have none, on those they replaced when the category was changed, and it counts even when entered later. Untenantable days come first, from the first unoccupied day up to and including the ready to let day. The day a household moves out counts as occupied. A milestone dated before the vacancy leaves it no untenantable days. The split is designed for programs that use void checklists: a vacancy with no void checklist, or one that never reached the milestone, is untenantable for every one of its days inside the period. Where two tenancies of one property overlap the count being split is short by the days they share, usually one and sometimes months, so the property can show no tenantable days. Occupied properties and properties not held show zero. Past periods can restate after later updates in Waharoa.
	measure 'Untenantable Unoccupied Days (Period)' =
			VAR _PeriodStart = MIN('Date Table'[Calendar Date])
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			VAR _FarFuture = DATE(9999, 12, 31)
			VAR _ActiveProperties =
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= _PeriodEnd &&
			        (ISBLANK('Property'[Confirmed Disposal Date]) ||
			         'Property'[Confirmed Disposal Date] >= _PeriodStart)
			    )
			VAR _Unoccupied = [Unoccupied Days (Period)]
			VAR _AllUntenantable =
			    CALCULATE(
			        SUMX(
			            _ActiveProperties,
			            VAR _PropStart = MAX('Property'[Acquired Date], _PeriodStart)
			            VAR _PropEnd =
			                MIN(
			                    IF(ISBLANK('Property'[Confirmed Disposal Date]), _FarFuture, 'Property'[Confirmed Disposal Date]),
			                    _PeriodEnd
			                )
			            VAR _Tenancies =
			                SELECTCOLUMNS(
			                    FILTER(
			                        RELATEDTABLE('Tenancy'),
			                        'Tenancy'[Is Occupying Tenancy] = 1 &&
			                        COALESCE('Tenancy'[Vacated Date], _FarFuture) >= 'Tenancy'[Tenancy Start Date]
			                    ),
			                    "@TenStart", 'Tenancy'[Tenancy Start Date],
			                    "@TenEnd", COALESCE('Tenancy'[Vacated Date], _FarFuture),
			                    "@TenVacated", 'Tenancy'[Vacated Date],
			                    "@TenID", 'Tenancy'[Property Tenancy ID]
			                )
			            VAR _AvailableDays =
			                IF(_PropEnd >= _PropStart, DATEDIFF(_PropStart, _PropEnd, DAY) + 1, 0)
			            VAR _OccupiedDays =
			                SUMX(
			                    FILTER(_Tenancies, [@TenStart] <= _PropEnd && [@TenEnd] >= _PropStart),
			                    VAR _OccFrom = MAX([@TenStart], _PropStart)
			                    VAR _OccTo = MIN([@TenEnd], _PropEnd)
			                    RETURN IF(_OccTo >= _OccFrom, DATEDIFF(_OccFrom, _OccTo, DAY) + 1, 0)
			                )
			            VAR _PropertyUnoccupied = MAX(0, _AvailableDays - _OccupiedDays)
			            VAR _HasReadyMilestone =
			                NOT(
			                    ISEMPTY(
			                        FILTER(
			                            RELATEDTABLE('Void Checklist'),
			                            LEN('Void Checklist'[Void Category]) > 0 &&
			                            'Void Checklist'[Void Category] <> "PROV" &&
			                            NOT(ISBLANK('Void Checklist'[Property Is Ready - Convert To Vacant: Tenantable]))
			                        )
			                    )
			                )
			            VAR _Checklists =
			                SELECTCOLUMNS(
			                    RELATEDTABLE('Void Checklist'),
			                    "@ExitTenancy", 'Void Checklist'[Void Checklist Vacated Tenancy ID],
			                    "@IsRealCategory",
			                        LEN('Void Checklist'[Void Category]) > 0 && 'Void Checklist'[Void Category] <> "PROV",
			                    "@Status", 'Void Checklist'[Void Status],
			                    "@Created", 'Void Checklist'[Created On],
			                    "@Effective",
			                        COALESCE('Void Checklist'[Date Tenancy Terminated], 'Void Checklist'[Created On]),
			                    "@Ready", 'Void Checklist'[Property Is Ready - Convert To Vacant: Tenantable]
			                )
			            VAR _PropertyChecklists =
			                ADDCOLUMNS(
			                    _Checklists,
			                    "@ExitVacated", MAXX(FILTER(_Tenancies, [@TenID] = [@ExitTenancy]), [@TenVacated])
			                )
			            VAR _VacatedDates =
			                DISTINCT(
			                    SELECTCOLUMNS(
			                        FILTER(_Tenancies, NOT(ISBLANK([@TenVacated]))),
			                        "@V", [@TenVacated]
			                    )
			                )
			            VAR _PriorVacancy = MAXX(FILTER(_VacatedDates, [@V] < _PropStart - 1), [@V])
			            VAR _Vacancies =
			                UNION(
			                    SELECTCOLUMNS(
			                        FILTER(
			                            _VacatedDates,
			                            [@V] < _PropEnd && ([@V] >= _PropStart - 1 || [@V] = _PriorVacancy)
			                        ),
			                        "@VacancyStart", [@V],
			                        "@FirstDay", [@V] + 1,
			                        "@NeverTenanted", 0
			                    ),
			                    ROW(
			                        "@VacancyStart", 'Property'[Acquired Date],
			                        "@FirstDay", 'Property'[Acquired Date],
			                        "@NeverTenanted", 1
			                    )
			                )
			            VAR _PropertyUntenantable =
			                SUMX(
			                    _Vacancies,
			                    VAR _VacancyStart = [@VacancyStart]
			                    VAR _FirstDay = [@FirstDay]
			                    VAR _NeverTenanted = [@NeverTenanted] = 1
			                    VAR _StillOccupied =
			                        NOT(ISEMPTY(FILTER(_Tenancies, [@TenStart] <= _FirstDay && [@TenEnd] >= _FirstDay)))
			                    VAR _NextTenancyStart = MINX(FILTER(_Tenancies, [@TenStart] >= _FirstDay), [@TenStart])
			                    VAR _StretchStart = MAX(_FirstDay, _PropStart)
			                    VAR _StretchEnd =
			                        IF(ISBLANK(_NextTenancyStart), _PropEnd, MIN(_NextTenancyStart - 1, _PropEnd))
			                    VAR _LinkedChecklists =
			                        FILTER(
			                            _PropertyChecklists,
			                            [@IsRealCategory] &&
			                            IF(
			                                _NeverTenanted,
			                                LEN([@ExitTenancy]) = 0 &&
			                                (ISBLANK(_NextTenancyStart) || [@Created] <= _NextTenancyStart),
			                                [@ExitVacated] = _VacancyStart
			                            )
			                        )
			                    VAR _UseNearbyChecklists = NOT(_NeverTenanted) && ISEMPTY(_LinkedChecklists)
			                    VAR _EventChecklists =
			                        FILTER(
			                            _PropertyChecklists,
			                            [@IsRealCategory] &&
			                            IF(
			                                _UseNearbyChecklists,
			                                LEN([@ExitTenancy]) = 0 &&
			                                [@Effective] >= _VacancyStart - 7 &&
			                                (ISBLANK(_NextTenancyStart) || [@Effective] < _NextTenancyStart),
			                                IF(
			                                    _NeverTenanted,
			                                    LEN([@ExitTenancy]) = 0 &&
			                                    (ISBLANK(_NextTenancyStart) || [@Created] <= _NextTenancyStart),
			                                    [@ExitVacated] = _VacancyStart
			                                )
			                            )
			                        )
			                    VAR _ReadyDate =
			                        COALESCE(
			                            MAXX(FILTER(_EventChecklists, NOT([@Status] IN {"Void Category Change", "Reverted to Untenantable"})), [@Ready]),
			                            MAXX(FILTER(_EventChecklists, [@Status] = "Void Category Change"), [@Ready])
			                        )
			                    VAR _UntenantableEnd =
			                        IF(ISBLANK(_ReadyDate), _StretchEnd, MIN(_StretchEnd, _ReadyDate))
			                    RETURN
			                        IF(
			                            _StillOccupied || _StretchEnd < _StretchStart,
			                            0,
			                            MAX(0, DATEDIFF(_StretchStart, _UntenantableEnd, DAY) + 1)
			                        )
			                )
			            RETURN
			                IF(
			                    _PropertyUnoccupied = 0,
			                    0,
			                    IF(
			                        NOT(_HasReadyMilestone),
			                        _PropertyUnoccupied,
			                        MIN(_PropertyUntenantable, _PropertyUnoccupied)
			                    )
			                )
			        ),
			        REMOVEFILTERS('Void Checklist')
			    )
			RETURN
			IF(_Unoccupied = 0, 0, MIN(_AllUntenantable, _Unoccupied))
		formatString: #,0
		displayFolder: 08. Void Management\Vacancy
		lineageTag: 64a5c5e7-48d6-4b50-acfd-053f420db5d8

	/// Days a property stood unoccupied inside the selected period after it was ready to let. It splits the same count as Unoccupied Days (Period), shown in reports as Count of Unoccupied Days, and together with Untenantable Unoccupied Days (Period) it adds up to that count for every property, name, city and total. Every vacancy that falls inside the period is counted, not only the one in force at the end, so two or more vacancies add together, each clipped to the period and split at its own ready to let milestone. Untenantable days come first and include the ready to let day, so tenantable days run from the day after it to the end of the vacancy or of the period, whichever comes first, including days reserved but not yet moved into. The milestone is the latest recorded on the void checklists for that vacancy, leaving out any on a checklist marked as reverted to untenantable, or, if they have none, on those they replaced when the category was changed; one dated before the vacancy makes all of its days tenantable. The split is designed for programs that use void checklists: a vacancy with no void checklist, or one that never reached the milestone, has no tenantable days. Where two tenancies of one property overlap the count being split is short by the days they share, usually one and sometimes months, so the property can show no tenantable days at all. Occupied properties and properties not held show zero. Past periods can restate after later updates in Waharoa.
	measure 'Tenantable Unoccupied Days (Period)' = [Unoccupied Days (Period)] - [Untenantable Unoccupied Days (Period)]
		formatString: #,0
		displayFolder: 08. Void Management\Vacancy
		lineageTag: e68b2ba8-1603-47be-84e1-cb687425db6b

	/// Days this vacancy left the property unoccupied inside the selected period. Every vacancy that overlaps the period counts, cut back to the days that fall inside it, so one property can show several rows in a long period. The count includes the first and the last empty day, and a vacancy that has not ended is counted to the end of the period. A vacancy that lies wholly outside the period is blank rather than zero, which keeps a table of vacancies to the ones the period is about. For the same properties and period the vacancy rows add up to Unoccupied Days (Period), with two exceptions: Unoccupied Days (Period) is short by the days two tenancies of one property share, usually one and sometimes months, and it counts days for a property whose acquisition date is missing, which cannot be given a vacancy. Because the vacancies are rebuilt when the model refreshes, this measure does not respond to filters on tenancies or void checklists, and a past period can restate after later updates in Waharoa.
	measure 'Vacancy Unoccupied Days (Period)' =
			VAR _PeriodStart = MIN('Date Table'[Calendar Date])
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			VAR _FarFuture = DATE(9999, 12, 31)
			VAR _Overlapping =
			    FILTER(
			        'Property Vacancy',
			        'Property Vacancy'[Vacancy Start Date] <= _PeriodEnd &&
			        COALESCE('Property Vacancy'[Vacancy End Date], _FarFuture) >= _PeriodStart
			    )
			RETURN
			SUMX(
			    _Overlapping,
			    VAR _Start = MAX('Property Vacancy'[Vacancy Start Date], _PeriodStart)
			    VAR _End = MIN(COALESCE('Property Vacancy'[Vacancy End Date], _FarFuture), _PeriodEnd)
			    RETURN IF(_End >= _Start, DATEDIFF(_Start, _End, DAY) + 1, 0)
			)
		formatString: #,0
		displayFolder: 08. Void Management\Vacancy\By Vacancy
		lineageTag: d1d54b78-bf81-4958-8b38-f848d6af2641

	/// Days inside the selected period when this vacancy was untenantable, that is the days up to and including the day the property was made ready to let. Every vacancy that overlaps the period counts, cut back to the days that fall inside it, so one property can show several rows in a long period. The ready to let day comes from the void checklists of that vacancy, leaving out any on a checklist marked as reverted to untenantable, or, where they carry none, from the checklists they replaced when the category was changed, and it counts even when entered later, so a past period can restate. The split is designed for programs that use void checklists: a vacancy with no void checklist, or one not yet made ready, is untenantable for every day it lasts. A property made ready on the day it fell empty carries that one untenantable day; only a ready to let day before the vacancy began leaves none. With Vacancy Tenantable Days (Period) it adds up to Vacancy Unoccupied Days (Period) at every level. A vacancy that lies wholly outside the period is blank rather than zero.
	measure 'Vacancy Untenantable Days (Period)' =
			VAR _PeriodStart = MIN('Date Table'[Calendar Date])
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			VAR _FarFuture = DATE(9999, 12, 31)
			VAR _Overlapping =
			    FILTER(
			        'Property Vacancy',
			        'Property Vacancy'[Vacancy Start Date] <= _PeriodEnd &&
			        COALESCE('Property Vacancy'[Vacancy End Date], _FarFuture) >= _PeriodStart
			    )
			RETURN
			SUMX(
			    _Overlapping,
			    VAR _VacancyEnd = COALESCE('Property Vacancy'[Vacancy End Date], _FarFuture)
			    VAR _ReadyDate = 'Property Vacancy'[Vacancy Relettable Date]
			    VAR _UntenantableEnd = IF(ISBLANK(_ReadyDate), _VacancyEnd, MIN(_VacancyEnd, _ReadyDate))
			    VAR _Start = MAX('Property Vacancy'[Vacancy Start Date], _PeriodStart)
			    VAR _End = MIN(_UntenantableEnd, _PeriodEnd)
			    RETURN IF(_End >= _Start, DATEDIFF(_Start, _End, DAY) + 1, 0)
			)
		formatString: #,0
		displayFolder: 08. Void Management\Vacancy\By Vacancy
		lineageTag: 1e974e24-a5da-4757-a25a-6955adc10e57

	/// Days inside the selected period when this vacancy was tenantable, that is the days after the property was made ready to let, including days reserved but not yet moved into. It is Vacancy Unoccupied Days (Period) less Vacancy Untenantable Days (Period), so the two always add up to the days of the vacancy that fall inside the period, at vacancy, property and total level. Tenantable days begin the day after the property was made ready, because the ready to let day itself counts as untenantable, and a property made ready on the day it fell empty is tenantable from the next day. A vacancy with no void checklist, or one not yet made ready, has no tenantable days, which is what programs that do not use void checklists will show. A ready to let day on a void checklist marked as reverted to untenantable does not count, so the vacancy has no tenantable days until a new one is recorded. A vacancy that lies wholly outside the period is blank rather than zero.
	measure 'Vacancy Tenantable Days (Period)' = [Vacancy Unoccupied Days (Period)] - [Vacancy Untenantable Days (Period)]
		formatString: #,0
		displayFolder: 08. Void Management\Vacancy\By Vacancy
		lineageTag: 870cf2e5-8096-41b0-b920-601b4f72fb9b

	/// Number of vacancies that left a property unoccupied for more than twenty days inside the selected period. Only the days that fall inside the period count, so a vacancy that is long in total but short inside the period does not qualify, and one that straddles the start or the end of the period is judged on the part that belongs to it. It counts vacancies rather than properties: on a row showing one vacancy it reads one when that vacancy passes twenty days and is blank otherwise, which lets a table be filtered to the vacancies worth reviewing, and on a property it counts the qualifying vacancies of that property, so a long period can show several rows for one property, each with its own ready to let day and void category. A vacancy of twenty days or fewer inside the period, or one lying wholly outside it, is blank rather than zero.
	measure 'Vacancies >20 Days (Period)' =
			VAR _PeriodStart = MIN('Date Table'[Calendar Date])
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			VAR _FarFuture = DATE(9999, 12, 31)
			VAR _Overlapping =
			    FILTER(
			        'Property Vacancy',
			        'Property Vacancy'[Vacancy Start Date] <= _PeriodEnd &&
			        COALESCE('Property Vacancy'[Vacancy End Date], _FarFuture) >= _PeriodStart
			    )
			RETURN
			COUNTROWS(
			    FILTER(
			        _Overlapping,
			        VAR _Start = MAX('Property Vacancy'[Vacancy Start Date], _PeriodStart)
			        VAR _End = MIN(COALESCE('Property Vacancy'[Vacancy End Date], _FarFuture), _PeriodEnd)
			        RETURN _End >= _Start && DATEDIFF(_Start, _End, DAY) + 1 > 20
			    )
			)
		formatString: #,0
		displayFolder: 08. Void Management\Vacancy\By Vacancy
		lineageTag: bac7cd85-b383-4bf6-b925-55972f117760

	/// Days the property stood unoccupied inside the selected period, counting every vacancy it had, shown beside a single vacancy so a table of vacancies reconciles with the property it belongs to. It is the same count as Unoccupied Days (Period), shown in reports as Count of Unoccupied Days. On a vacancy row it repeats the figure for the whole property, so it does not add up down the column: the vacancy days of one property normally add up to it, and the total shows the days for every property the filters allow, including any that has no vacancy row. It is blank where the property had no vacancy touching the period, and blank for a property that has no vacancy on record. Where two tenancies of one property overlap the count it repeats is short by the days they share, so the vacancy rows of that property can add up to more than it shows. A filter on tenancies moves it while the vacancy days beside it stay put, so the two stop reconciling. Past periods can restate after later updates in Waharoa.
	measure 'Property Unoccupied Days (Period)' =
			IF(
			    NOT(ISBLANK([Vacancy Unoccupied Days (Period)])),
			    [Unoccupied Days (Period)]
			)
		formatString: #,0
		displayFolder: 08. Void Management\Vacancy\By Vacancy
		lineageTag: 5f9e7e3e-4dd0-4c2e-af60-9ec9424137e0

	/// Original void category code (such as MAJD) of the vacancy counted in Count of Continuous Unoccupied Days, as at the end of the selected period. It is the first category other than PROV recorded on the void checklists of the tenancy that ended, including at notice to vacate, so later category changes do not alter it. Failing that, it uses void checklists not tied to a tenancy, if their tenancy end date (or raised date, if blank) is from 7 days before the vacate date to the day before the next tenancy starts. A never-tenanted property uses void checklists not tied to a tenancy and raised by the next tenancy start. PROV: only a provisional void checklist is recorded for the vacancy. No checklist: none is recorded for the vacancy, as in programs without void checklists. A name with several vacant properties lists their distinct codes alphabetically. A property whose tenancy ends on the last day of the period shows the category of the vacancy that starts with that move-out, with 0 days. Blank for properties occupied or not held at the end of the period, and any total, card, tooltip or visual not broken down by property name or ID, such as a table by address. Untenantable and Tenantable Unoccupied Days (Period End) split the day count, untenantable first, including the ready to let day; with no ready to let milestone, all are untenantable. Past periods can change after later updates in Waharoa; a milestone on a void checklist marked as reverted to untenantable does not count, and a later milestone makes every day up to it untenantable.
	measure 'Void Category (Period End)' =
			VAR _AsAtDate = MAX('Date Table'[Calendar Date])
			VAR _ActiveProperties =
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= _AsAtDate &&
			        (ISBLANK('Property'[Confirmed Disposal Date]) ||
			         'Property'[Confirmed Disposal Date] >= _AsAtDate)
			    )
			VAR _PropertyCategories =
			    CALCULATETABLE(
			        FILTER(
			            SELECTCOLUMNS(
			                _ActiveProperties,
			                "@Category",
			                VAR _PropertyTenancies =
			                    FILTER(
			                        RELATEDTABLE('Tenancy'),
			                        'Tenancy'[Is Occupying Tenancy] = 1 &&
			                        'Tenancy'[Tenancy Start Date] <= _AsAtDate
			                    )
			                VAR _HasActiveTenancy =
			                    COUNTROWS(
			                        FILTER(
			                            _PropertyTenancies,
			                            ISBLANK('Tenancy'[Vacated Date]) || 'Tenancy'[Vacated Date] > _AsAtDate
			                        )
			                    ) > 0
			                VAR _LastVacatedDate =
			                    MAXX(
			                        FILTER(
			                            _PropertyTenancies,
			                            NOT(ISBLANK('Tenancy'[Vacated Date])) && 'Tenancy'[Vacated Date] <= _AsAtDate
			                        ),
			                        'Tenancy'[Vacated Date]
			                    )
			                VAR _UnoccupiedSince =
			                    IF(
			                        _HasActiveTenancy,
			                        BLANK(),
			                        IF(ISBLANK(_LastVacatedDate), 'Property'[Acquired Date], _LastVacatedDate)
			                    )
			                VAR _NextTenancyStart =
			                    MINX(
			                        FILTER(
			                            RELATEDTABLE('Tenancy'),
			                            'Tenancy'[Is Occupying Tenancy] = 1 &&
			                            'Tenancy'[Tenancy Start Date] > _AsAtDate
			                        ),
			                        'Tenancy'[Tenancy Start Date]
			                    )
			                VAR _ExitTenancies =
			                    SELECTCOLUMNS(
			                        FILTER(_PropertyTenancies, 'Tenancy'[Vacated Date] = _LastVacatedDate),
			                        "@TenancyID", 'Tenancy'[Property Tenancy ID]
			                    )
			                VAR _Checklists =
			                    ADDCOLUMNS(
			                        RELATEDTABLE('Void Checklist'),
			                        "@IsRealCategory",
			                            LEN('Void Checklist'[Void Category]) > 0 &&
			                            'Void Checklist'[Void Category] <> "PROV",
			                        "@IsLinked",
			                            IF(
			                                ISBLANK(_LastVacatedDate),
			                                LEN('Void Checklist'[Void Checklist Vacated Tenancy ID]) = 0 &&
			                                (ISBLANK(_NextTenancyStart) || 'Void Checklist'[Created On] <= _NextTenancyStart),
			                                'Void Checklist'[Void Checklist Vacated Tenancy ID] IN _ExitTenancies
			                            )
			                    )
			                VAR _UseNearbyChecklists =
			                    NOT(ISBLANK(_LastVacatedDate)) &&
			                    ISEMPTY(FILTER(_Checklists, [@IsLinked] && [@IsRealCategory]))
			                VAR _EventChecklists =
			                    FILTER(
			                        _Checklists,
			                        [@IsRealCategory] &&
			                        IF(
			                            _UseNearbyChecklists,
			                            LEN('Void Checklist'[Void Checklist Vacated Tenancy ID]) = 0 &&
			                            COALESCE('Void Checklist'[Date Tenancy Terminated], 'Void Checklist'[Created On]) >= _LastVacatedDate - 7 &&
			                            (ISBLANK(_NextTenancyStart) ||
			                             COALESCE('Void Checklist'[Date Tenancy Terminated], 'Void Checklist'[Created On]) < _NextTenancyStart),
			                            [@IsLinked]
			                        )
			                    )
			                VAR _Candidates =
			                    ADDCOLUMNS(
			                        _EventChecklists,
			                        "@RecordedAt", MID('Void Checklist'[Void Checklist ID], 18, 1) & MID('Void Checklist'[Void Checklist ID], 15, 2) & MID('Void Checklist'[Void Checklist ID], 12, 2) & MID('Void Checklist'[Void Checklist ID], 10, 2) & MID('Void Checklist'[Void Checklist ID], 7, 2) & MID('Void Checklist'[Void Checklist ID], 5, 2) & MID('Void Checklist'[Void Checklist ID], 3, 2) & MID('Void Checklist'[Void Checklist ID], 1, 2),
			                        "@IsSuperseded", 'Void Checklist'[Void Status] = "Void Category Change"
			                    )
			                VAR _FirstCreatedOn = MINX(_Candidates, 'Void Checklist'[Created On])
			                VAR _FirstDayChecklists = FILTER(_Candidates, 'Void Checklist'[Created On] = _FirstCreatedOn)
			                VAR _FirstRecord =
			                    TOPN(1, FILTER(_FirstDayChecklists, NOT [@IsSuperseded]), [@RecordedAt], ASC)
			                VAR _FirstRecordAt = MAXX(_FirstRecord, [@RecordedAt])
			                VAR _FirstRecordIsNoticeStage =
			                    MAXX(_FirstRecord, 'Void Checklist'[Void Status]) = "Tenant Vacated"
			                VAR _NextRecordAt =
			                    MINX(
			                        FILTER(_FirstDayChecklists, NOT [@IsSuperseded] && [@RecordedAt] > _FirstRecordAt),
			                        [@RecordedAt]
			                    )
			                VAR _FirstRecordSnapshots =
			                    FILTER(
			                        _FirstDayChecklists,
			                        [@IsSuperseded] &&
			                        [@RecordedAt] > _FirstRecordAt &&
			                        (NOT _FirstRecordIsNoticeStage || ISBLANK(_NextRecordAt) || [@RecordedAt] < _NextRecordAt)
			                    )
			                VAR _OriginalCategory =
			                    IF(
			                        ISEMPTY(_FirstRecordSnapshots),
			                        MAXX(_FirstRecord, 'Void Checklist'[Void Category]),
			                        MAXX(TOPN(1, _FirstRecordSnapshots, [@RecordedAt], ASC), 'Void Checklist'[Void Category])
			                    )
			                VAR _Category =
			                    IF(
			                        NOT(ISEMPTY(_Candidates)),
			                        _OriginalCategory,
			                        IF(
			                            NOT(ISEMPTY(FILTER(_Checklists, [@IsLinked] && 'Void Checklist'[Void Category] = "PROV"))),
			                            "PROV",
			                            "No checklist"
			                        )
			                    )
			                RETURN IF(ISBLANK(_UnoccupiedSince), BLANK(), _Category)
			            ),
			            NOT(ISBLANK([@Category]))
			        ),
			        REMOVEFILTERS('Void Checklist')
			    )
			RETURN
			IF(
			    ISINSCOPE('Property'[Property Name]) || ISINSCOPE('Property'[Property ID]),
			    CONCATENATEX(DISTINCT(_PropertyCategories), [@Category], ", ", [@Category], ASC)
			)
		displayFolder: 08. Void Management\Vacancy
		lineageTag: f1e5146d-bf01-4a2e-beec-58fac8543361

	/// Untenantable days of the vacancy of each unoccupied property as at the end of the selected period. It covers the same vacancy as Unoccupied Days (Period End), shown in reports as Count of Continuous Unoccupied Days, and together with Tenantable Unoccupied Days (Period End) adds up to that count for every property and total. Untenantable days come first: from the vacancy start up to the ready to let milestone, which is the latest on the void checklists for that vacancy or, if they have none, on those they replaced when the category changed, even if entered after the period. The split is designed for programs that use void checklists: in any program, a vacancy with no void checklist, or whose milestone is blank or after the end of the period, is untenantable throughout. The day the vacancy starts is not counted and the ready to let day counts as untenantable, but a milestone dated on or before the vacancy start makes every day tenantable. Occupied properties show 0; those not held at the end of the period show blank. A placeholder acquisition date on a never-tenanted property inflates the count. Past periods can change after later updates in Waharoa. A milestone on a void checklist marked as reverted to untenantable does not count, so the vacancy stays untenantable until a later milestone is recorded, which then makes every day up to it untenantable.
	measure 'Untenantable Unoccupied Days (Period End)' =
			VAR _AsAtDate = MAX('Date Table'[Calendar Date])
			VAR _ActiveProperties =
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= _AsAtDate &&
			        (ISBLANK('Property'[Confirmed Disposal Date]) ||
			         'Property'[Confirmed Disposal Date] >= _AsAtDate)
			    )
			RETURN
			CALCULATE(
			    SUMX(
			        _ActiveProperties,
			        VAR _PropertyTenancies =
			            FILTER(
			                RELATEDTABLE('Tenancy'),
			                'Tenancy'[Is Occupying Tenancy] = 1 &&
			                'Tenancy'[Tenancy Start Date] <= _AsAtDate
			            )
			        VAR _HasActiveTenancy =
			            COUNTROWS(
			                FILTER(
			                    _PropertyTenancies,
			                    ISBLANK('Tenancy'[Vacated Date]) || 'Tenancy'[Vacated Date] >= _AsAtDate
			                )
			            ) > 0
			        VAR _LastVacatedDate =
			            MAXX(
			                FILTER(
			                    _PropertyTenancies,
			                    NOT(ISBLANK('Tenancy'[Vacated Date])) && 'Tenancy'[Vacated Date] <= _AsAtDate
			                ),
			                'Tenancy'[Vacated Date]
			            )
			        VAR _UnoccupiedSince =
			            IF(
			                _HasActiveTenancy,
			                BLANK(),
			                IF(ISBLANK(_LastVacatedDate), 'Property'[Acquired Date], _LastVacatedDate)
			            )
			        VAR _NextTenancyStart =
			            MINX(
			                FILTER(
			                    RELATEDTABLE('Tenancy'),
			                    'Tenancy'[Is Occupying Tenancy] = 1 &&
			                    'Tenancy'[Tenancy Start Date] > _AsAtDate
			                ),
			                'Tenancy'[Tenancy Start Date]
			            )
			        VAR _ExitTenancies =
			            SELECTCOLUMNS(
			                FILTER(_PropertyTenancies, 'Tenancy'[Vacated Date] = _LastVacatedDate),
			                "@TenancyID", 'Tenancy'[Property Tenancy ID]
			            )
			        VAR _Checklists =
			            ADDCOLUMNS(
			                RELATEDTABLE('Void Checklist'),
			                "@IsRealCategory",
			                    LEN('Void Checklist'[Void Category]) > 0 &&
			                    'Void Checklist'[Void Category] <> "PROV",
			                "@IsLinked",
			                    IF(
			                        ISBLANK(_LastVacatedDate),
			                        LEN('Void Checklist'[Void Checklist Vacated Tenancy ID]) = 0 &&
			                        (ISBLANK(_NextTenancyStart) || 'Void Checklist'[Created On] <= _NextTenancyStart),
			                        'Void Checklist'[Void Checklist Vacated Tenancy ID] IN _ExitTenancies
			                    )
			            )
			        VAR _UseNearbyChecklists =
			            NOT(ISBLANK(_LastVacatedDate)) &&
			            ISEMPTY(FILTER(_Checklists, [@IsLinked] && [@IsRealCategory]))
			        VAR _EventChecklists =
			            FILTER(
			                _Checklists,
			                [@IsRealCategory] &&
			                IF(
			                    _UseNearbyChecklists,
			                    LEN('Void Checklist'[Void Checklist Vacated Tenancy ID]) = 0 &&
			                    COALESCE('Void Checklist'[Date Tenancy Terminated], 'Void Checklist'[Created On]) >= _LastVacatedDate - 7 &&
			                    (ISBLANK(_NextTenancyStart) ||
			                     COALESCE('Void Checklist'[Date Tenancy Terminated], 'Void Checklist'[Created On]) < _NextTenancyStart),
			                    [@IsLinked]
			                )
			            )
			        VAR _ReadyDate =
			            COALESCE(
			                MAXX(
			                    FILTER(_EventChecklists, NOT('Void Checklist'[Void Status] IN {"Void Category Change", "Reverted to Untenantable"})),
			                    'Void Checklist'[Property Is Ready - Convert To Vacant: Tenantable]
			                ),
			                MAXX(
			                    FILTER(_EventChecklists, 'Void Checklist'[Void Status] = "Void Category Change"),
			                    'Void Checklist'[Property Is Ready - Convert To Vacant: Tenantable]
			                )
			            )
			        VAR _TenantableFrom =
			            IF(
			                ISBLANK(_ReadyDate) || _ReadyDate > _AsAtDate,
			                _AsAtDate,
			                MAX(_ReadyDate, _UnoccupiedSince)
			            )
			        RETURN
			            IF(
			                ISBLANK(_UnoccupiedSince),
			                0,
			                DATEDIFF(_UnoccupiedSince, _TenantableFrom, DAY)
			            )
			    ),
			    REMOVEFILTERS('Void Checklist')
			)
		formatString: #,0
		displayFolder: 08. Void Management\Vacancy
		lineageTag: f66d01d3-c21c-4265-9906-41371e577344

	/// Tenantable days of the vacancy of each unoccupied property as at the end of the selected period. It covers the same vacancy as Unoccupied Days (Period End), shown in reports as Count of Continuous Unoccupied Days, and together with Untenantable Unoccupied Days (Period End) adds up to that count for every property and total. Untenantable days come first and include the ready to let day, so a property ready on the last day of the period shows 0. Tenantable days run from the day after the ready to let day to the end of the period, including days reserved but not yet moved into. The ready to let milestone is the latest on the void checklists for that vacancy or, if they have none, on those they replaced when the category changed, even if entered after the period; a milestone dated on or before the vacancy start makes every day tenantable. The split is designed for programs that use void checklists: in any program, a vacancy with no void checklist, or whose milestone is blank or after the end of the period, has no tenantable days. Occupied properties show 0; those not held at the end of the period show blank. Past periods can change after later updates in Waharoa. A milestone on a void checklist marked as reverted to untenantable does not count, so the vacancy has no tenantable days until a later milestone is recorded, which then makes every day up to it untenantable.
	measure 'Tenantable Unoccupied Days (Period End)' = [Unoccupied Days (Period End)] - [Untenantable Unoccupied Days (Period End)]
		formatString: #,0
		displayFolder: 08. Void Management\Vacancy
		lineageTag: ceebed21-eae5-472a-a571-66c27b467bde

	/// Is Executive User limited to rows that have Aged Debt: 1 or 0 where Aged Debt rows exist, blank elsewhere. Use this, not Is Executive User, as the visual-level gate on Aged Debt visuals (= 0 on the standard visuals, = 1 on the Exec View visuals). A gate that is never blank makes Power BI cross join every grouping column before it filters, which on the tenancy tables runs to tens of millions of rows.
	measure 'Is Executive User (Aged Debt)' = IF(NOT ISEMPTY('Aged Debt'), [Is Executive User])
		formatString: 0
		isHidden
		displayFolder: _Internal
		lineageTag: 18b84c53-6e13-4098-a38b-34c5afffd889

	/// Tenancy name for the current single-tenancy row, masked for executives. When Is Executive User = 1 it returns the tenancy's property name instead, "Name Masked" if that name spans more than one property, and blank when the row covers several tenancies; everyone else gets the raw Tenancy Name. Used by the Waharoa Aged Debt tooltip.
	measure 'Property Tenancy Tenancy Name Masked' =
			VAR _Raw = SELECTEDVALUE('Tenancy'[Tenancy Name])
			VAR _Properties = SUMMARIZE('Tenancy', 'Property'[Property Name])
			VAR _Property = IF(COUNTROWS(_Properties) = 1, MAXX(_Properties, 'Property'[Property Name]))
			RETURN
			    IF(
			        [Is Executive User] = 1,
			        IF(ISBLANK(_Raw), BLANK(), COALESCE(_Property, "Name Masked")),
			        _Raw
			    )
		isHidden
		displayFolder: _Internal
		lineageTag: 72a3cc96-8764-4955-9c86-96f98dcd2b85

	/// Share of Transitional Housing exits in the selected period whose exit outcome is Positive, measured against exits whose outcome is Positive or Negative only, as the funder's Housing Outcome Score requires. Neutral exits, internal transfers and exits whose outcome is Unclassified or blank are left out of both parts, so this rate and TH Negative Exit Rate (Excl Neutral, Period) % add to 100%. Each tenancy that ended in the period is counted, not each household. Responds to the date slicer; with no date selected it covers today only. Shows 0% when every counted exit was negative, and is blank when there were no positive or negative exits. For the share of all classified exits including neutral ones, use TH Positive Exit Rate (Period) %.
	measure 'TH Positive Exit Rate (Excl Neutral, Period) %' =
			VAR _Positive = [TH Positive Exits (Period)] + 0
			VAR _Negative = [TH Negative Exits (Period)] + 0
			VAR _Counted = _Positive + _Negative
			RETURN
			IF(_Counted > 0, DIVIDE(_Positive, _Counted))
		formatString: 0.0%
		displayFolder: 09. THVM Dashboard\Exits\Housing Outcome Score
		lineageTag: 5e07ac3c-ebcd-4ad9-8883-b250c1f40e2a

	/// Share of Transitional Housing exits in the selected period whose exit outcome is Negative, measured against exits whose outcome is Positive or Negative only, as the funder's Housing Outcome Score requires. Neutral exits, internal transfers and exits whose outcome is Unclassified or blank are left out of both parts, so this rate and TH Positive Exit Rate (Excl Neutral, Period) % add to 100%. Each tenancy that ended in the period is counted, not each household. Responds to the date slicer; with no date selected it covers today only. Shows 0% when every counted exit was positive, and is blank when there were no positive or negative exits. For the share of all classified exits including neutral ones, use TH Negative Exit Rate (Period) %.
	measure 'TH Negative Exit Rate (Excl Neutral, Period) %' =
			VAR _Positive = [TH Positive Exits (Period)] + 0
			VAR _Negative = [TH Negative Exits (Period)] + 0
			VAR _Counted = _Positive + _Negative
			RETURN
			IF(_Counted > 0, DIVIDE(_Negative, _Counted))
		formatString: 0.0%
		displayFolder: 09. THVM Dashboard\Exits\Housing Outcome Score
		lineageTag: 1c249fb2-b9d8-4f87-a688-7cea7cbbea19

	/// The funder's Housing Outcome Score for Transitional Housing over the selected period: the positive exit rate minus the negative exit rate, both measured against exits whose exit outcome is Positive or Negative only, so neutral exits count neither way. Internal transfers and exits whose outcome is Unclassified or blank are also left out. It runs from -100% (every counted exit negative) to +100% (every counted exit positive), and the funder's minimum is 50%. Each tenancy that ended in the period is counted, not each household. Responds to the date slicer; with no date selected it covers today only. With only a few exits in a period the score can swing widely. It is sensitive to how completely leaving reasons are recorded: an unknown reason, or no reason with an unknown destination, counts as negative, and an exit with no recognised reason or destination, or a reason not yet given an outcome, is left out. Blank when the period has no positive or negative exits.
	measure 'TH Housing Outcome Score (Period) %' =
			VAR _Positive = [TH Positive Exits (Period)] + 0
			VAR _Negative = [TH Negative Exits (Period)] + 0
			VAR _Counted = _Positive + _Negative
			RETURN
			IF(_Counted > 0, DIVIDE(_Positive, _Counted) - DIVIDE(_Negative, _Counted))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 09. THVM Dashboard\Exits\Housing Outcome Score
		lineageTag: 86629d5a-566e-4cb7-9ce6-07ad9cf6b996

	/// The funder's minimum Housing Outcome Score of 50%, for drawing a target line beside TH Housing Outcome Score (Period) %. Blank wherever the score is blank, so the line only appears where there is a score to compare.
	measure 'TH Housing Outcome Score Minimum %' = IF(NOT ISBLANK([TH Housing Outcome Score (Period) %]), 0.5)
		formatString: 0.0%
		displayFolder: 09. THVM Dashboard\Exits\Housing Outcome Score
		lineageTag: 6b945eb1-25f3-4fa0-a889-ef436ad9b3e4

	/// How far the Housing Outcome Score for the selected period sits above (positive) or below (negative) the funder's 50% minimum, in percentage points. Blank when the score is blank, that is when the period has no positive or negative exits.
	measure 'TH Housing Outcome Score (Period) vs Minimum %' =
			VAR _Score = [TH Housing Outcome Score (Period) %]
			RETURN
			IF(NOT ISBLANK(_Score), _Score - [TH Housing Outcome Score Minimum %])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 09. THVM Dashboard\Exits\Housing Outcome Score
		lineageTag: 6532d83f-8cbe-4683-a241-811c03449b30

	column Placeholder
		isHidden
