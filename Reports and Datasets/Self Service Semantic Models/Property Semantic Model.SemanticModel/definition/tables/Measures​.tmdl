	/// Count of primary-tenant records with a recorded ethnicity that is not classified as Māori, Pacific Peoples, European/Pākehā or Asian (e.g. Middle Eastern, Latin American, African) whose tenancy overlaps the selected period; excludes blank ethnicity and cancelled tenancies. (Period): responds to the Date Table slicer, FY 1 Jul–30 Jun; with no slicer counts all-time. CAVEAT: currently returns BLANK — Ethnicity is 100% NULL for primary tenants (captured only on non-primary household-member rows), so the breakdown is non-functional until the source/grain is fixed. Note: this measure excludes Cancelled whereas Maori/European/Asian/Not-Recorded and Total Active Tenants do not — align the family.
	measure 'Tenants - Other Ethnicity (Period)' =
			VAR MinDate = MIN('Date Table'[Calendar Date])
			VAR MaxDate = MAX('Date Table'[Calendar Date])
			VAR MaoriValues = {"Maori", "New Zealand Maori"}
			VAR PacificValues = {"Samoan", "Tongan", "Cook Island Maori", "Niuean", "Tokelauan", "Fijian", "Pacific Peoples", "Pacific Islander", "Other Pacific Peoples"}
			VAR EuropeanValues = {"NZ European", "New Zealand European", "European", "Pakeha", "Other European", "British", "Australian", "Dutch", "German", "Irish", "South African"}
			VAR AsianValues = {"Chinese", "Indian", "Filipino", "Korean", "Japanese", "Vietnamese", "Thai", "Cambodian", "Malaysian", "Indonesian", "Asian", "Other Asian", "Southeast Asian"}
			RETURN
			IF(
			    ISBLANK(MinDate) || ISBLANK(MaxDate),
			    COUNTROWS(
			        FILTER(
			            Tenant,
			            Tenant[Is Primary Tenant] = 1 &&
			            Tenant[Tenancy Status] <> "Cancelled" &&
			            NOT(ISBLANK(Tenant[Ethnicity])) &&
			            NOT(Tenant[Ethnicity] IN MaoriValues) &&
			            NOT(Tenant[Ethnicity] IN PacificValues) &&
			            NOT(Tenant[Ethnicity] IN EuropeanValues) &&
			            NOT(Tenant[Ethnicity] IN AsianValues)
			        )
			    ),
			    CALCULATE(
			        COUNTROWS(Tenant),
			        FILTER(
			            Tenant,
			            Tenant[Tenancy Start Date] <= MaxDate &&
			            (ISBLANK(RELATED(Tenancy[Vacated Date])) || RELATED(Tenancy[Vacated Date]) >= MinDate) &&
			            Tenant[Is Primary Tenant] = 1 &&
			            Tenant[Tenancy Status] <> "Cancelled" &&
			            NOT(ISBLANK(Tenant[Ethnicity])) &&
			            NOT(Tenant[Ethnicity] IN MaoriValues) &&
			            NOT(Tenant[Ethnicity] IN PacificValues) &&
			            NOT(Tenant[Ethnicity] IN EuropeanValues) &&
			            NOT(Tenant[Ethnicity] IN AsianValues)
			        ),
			        REMOVEFILTERS('Date Table')
			    )
			)
		formatString: #,0
		displayFolder: 10. Tenant Demographics\Ethnicity
		lineageTag: 8f392d08-5937-468c-9c6f-8d71206ea33f

	/// Count of primary-tenant records with no Ethnicity recorded (NULL), excluding cancelled tenancies, whose tenancy overlaps the selected period. (Period): responds to the Date Table slicer, FY 1 Jul to 30 Jun. Data-quality indicator: in the current data this is effectively all active primary tenants (primary-tenant Ethnicity is 100% NULL; ethnicity is captured only on non-primary household-member rows), so the ethnicity breakdown is not yet usable.
	measure 'Tenants - Ethnicity Not Recorded (Period)' =
			VAR MinDate = MIN('Date Table'[Calendar Date])
			VAR MaxDate = MAX('Date Table'[Calendar Date])
			RETURN
			IF(
			    ISBLANK(MinDate) || ISBLANK(MaxDate),
			    COUNTROWS(
			        FILTER(
			            Tenant,
			            Tenant[Is Primary Tenant] = 1 &&
			            Tenant[Tenancy Status] <> "Cancelled" &&
			            ISBLANK(Tenant[Ethnicity])
			        )
			    ),
			    CALCULATE(
			        COUNTROWS(Tenant),
			        FILTER(
			            Tenant,
			            Tenant[Tenancy Start Date] <= MaxDate &&
			            (ISBLANK(RELATED(Tenancy[Vacated Date])) || RELATED(Tenancy[Vacated Date]) >= MinDate) &&
			            Tenant[Is Primary Tenant] = 1 &&
			            Tenant[Tenancy Status] <> "Cancelled" &&
			            ISBLANK(Tenant[Ethnicity])
			        ),
			        REMOVEFILTERS('Date Table')
			    )
			)
		formatString: #,0
		displayFolder: 10. Tenant Demographics\Ethnicity
		lineageTag: 6da3e411-ab49-4473-8d9f-7040b8e7ac77

	/// Count of primary tenants with gender 'Wahine/Female' whose tenancy overlaps the selected date range, aggregated across the period. Excludes cancelled tenancies. With no date selected, counts across the full calendar range. Note: 'Wahine/Female' is a single combined value in the data, not two separate 'Wahine' and 'Female' values being consolidated.
	measure 'Tenants - Wahine (Female) (Period)' =
			VAR MinDate = MIN('Date Table'[Calendar Date])
			VAR MaxDate = MAX('Date Table'[Calendar Date])
			VAR GenderValues = {"Wahine/Female"}
			RETURN
			IF(
			    ISBLANK(MinDate) || ISBLANK(MaxDate),
			    COUNTROWS(
			        FILTER(
			            Tenant,
			            Tenant[Is Primary Tenant] = 1 &&
			            Tenant[Tenancy Status] <> "Cancelled" &&
			            Tenant[Gender] IN GenderValues
			        )
			    ),
			    CALCULATE(
			        COUNTROWS(Tenant),
			        FILTER(
			            Tenant,
			            Tenant[Tenancy Start Date] <= MaxDate &&
			            (ISBLANK(RELATED(Tenancy[Vacated Date])) || RELATED(Tenancy[Vacated Date]) >= MinDate) &&
			            Tenant[Is Primary Tenant] = 1 &&
			            Tenant[Tenancy Status] <> "Cancelled" &&
			            Tenant[Gender] IN GenderValues
			        ),
			        REMOVEFILTERS('Date Table')
			    )
			)
		formatString: 0
		displayFolder: 10. Tenant Demographics\Gender
		lineageTag: bf4cfba5-f1a5-435d-b4e7-aa2a12a85ee4

	/// Count of primary tenants with gender 'Tane/Male' whose tenancy overlaps the selected date range, aggregated across the period. Excludes cancelled tenancies. With no date selected, counts across the full calendar range. Note: 'Tane/Male' is a single combined value in the data, not two separate 'Tane' and 'Male' values being consolidated.
	measure 'Tenants - Tane (Male) (Period)' =
			VAR MinDate = MIN('Date Table'[Calendar Date])
			VAR MaxDate = MAX('Date Table'[Calendar Date])
			VAR GenderValues = {"Tane/Male"}
			RETURN
			IF(
			    ISBLANK(MinDate) || ISBLANK(MaxDate),
			    COUNTROWS(
			        FILTER(
			            Tenant,
			            Tenant[Is Primary Tenant] = 1 &&
			            Tenant[Tenancy Status] <> "Cancelled" &&
			            Tenant[Gender] IN GenderValues
			        )
			    ),
			    CALCULATE(
			        COUNTROWS(Tenant),
			        FILTER(
			            Tenant,
			            Tenant[Tenancy Start Date] <= MaxDate &&
			            (ISBLANK(RELATED(Tenancy[Vacated Date])) || RELATED(Tenancy[Vacated Date]) >= MinDate) &&
			            Tenant[Is Primary Tenant] = 1 &&
			            Tenant[Tenancy Status] <> "Cancelled" &&
			            Tenant[Gender] IN GenderValues
			        ),
			        REMOVEFILTERS('Date Table')
			    )
			)
		formatString: 0
		displayFolder: 10. Tenant Demographics\Gender
		lineageTag: e84bd6c2-e839-4f91-9182-278550c30866

	/// Count of primary tenants recording a gender other than Wahine/Female or Tane/Male (e.g. 'Another Gender / He ira Ke ano') whose tenancy overlaps the selected Date Table period. Grain: primary-tenant records (approx. one per active tenancy; a tenant with multiple overlapping tenancies is counted per tenancy). Excludes cancelled tenancies and tenants with no gender recorded (blank or 'Unspecified/Unknown'). (Period): responds to the Date Table slicer (FY 1 Jul-30 Jun); with no date selected, counts across the full calendar range.
	measure 'Tenants - Other Gender (Period)' =
			VAR MinDate = MIN('Date Table'[Calendar Date])
			VAR MaxDate = MAX('Date Table'[Calendar Date])
			VAR FemaleValues = {"Wahine/Female"}
			VAR MaleValues = {"Tane/Male"}
			VAR NotRecordedValues = {"Unspecified/Unknown"}
			RETURN
			IF(
			    ISBLANK(MinDate) || ISBLANK(MaxDate),
			    COUNTROWS(
			        FILTER(
			            Tenant,
			            Tenant[Is Primary Tenant] = 1 &&
			            Tenant[Tenancy Status] <> "Cancelled" &&
			            NOT(ISBLANK(Tenant[Gender])) &&
			            NOT(Tenant[Gender] IN FemaleValues) &&
			            NOT(Tenant[Gender] IN MaleValues) &&
			            NOT(Tenant[Gender] IN NotRecordedValues)
			        )
			    ),
			    CALCULATE(
			        COUNTROWS(Tenant),
			        FILTER(
			            Tenant,
			            Tenant[Tenancy Start Date] <= MaxDate &&
			            (ISBLANK(RELATED(Tenancy[Vacated Date])) || RELATED(Tenancy[Vacated Date]) >= MinDate) &&
			            Tenant[Is Primary Tenant] = 1 &&
			            Tenant[Tenancy Status] <> "Cancelled" &&
			            NOT(ISBLANK(Tenant[Gender])) &&
			            NOT(Tenant[Gender] IN FemaleValues) &&
			            NOT(Tenant[Gender] IN MaleValues) &&
			            NOT(Tenant[Gender] IN NotRecordedValues)
			        ),
			        REMOVEFILTERS('Date Table')
			    )
			)
		formatString: 0
		displayFolder: 10. Tenant Demographics\Gender
		lineageTag: 8da313af-1fa4-4503-aba0-f718fa2b792b

	/// Count of primary tenants with no gender recorded - Gender is blank or 'Unspecified/Unknown' - whose tenancy overlaps the selected Date Table period. Grain: primary-tenant records (approx. one per active tenancy). Excludes cancelled tenancies. (Period): responds to the Date Table slicer (FY 1 Jul-30 Jun); with no date selected, counts across the full calendar range. Data-quality indicator: high values mean gender is not being captured at intake.
	measure 'Tenants - Gender Not Recorded (Period)' =
			VAR MinDate = MIN('Date Table'[Calendar Date])
			VAR MaxDate = MAX('Date Table'[Calendar Date])
			VAR NotRecordedValues = {"Unspecified/Unknown", BLANK()}
			RETURN
			IF(
			    ISBLANK(MinDate) || ISBLANK(MaxDate),
			    COUNTROWS(
			        FILTER(
			            Tenant,
			            Tenant[Is Primary Tenant] = 1 &&
			            Tenant[Tenancy Status] <> "Cancelled" &&
			            (ISBLANK(Tenant[Gender]) || Tenant[Gender] IN NotRecordedValues)
			        )
			    ),
			    CALCULATE(
			        COUNTROWS(Tenant),
			        FILTER(
			            Tenant,
			            Tenant[Tenancy Start Date] <= MaxDate &&
			            (ISBLANK(RELATED(Tenancy[Vacated Date])) || RELATED(Tenancy[Vacated Date]) >= MinDate) &&
			            Tenant[Is Primary Tenant] = 1 &&
			            Tenant[Tenancy Status] <> "Cancelled" &&
			            (ISBLANK(Tenant[Gender]) || Tenant[Gender] IN NotRecordedValues)
			        ),
			        REMOVEFILTERS('Date Table')
			    )
			)
		formatString: 0
		displayFolder: 10. Tenant Demographics\Gender
		lineageTag: a0308d12-e175-4fae-962e-3eccc96d16f9

	/// Percentage of active primary tenants with ethnicity recorded. Higher values indicate better data quality. Calculated as (Total - Not Recorded) / Total. Counts any non-blank Ethnicity as recorded; if the source uses a sentinel value (e.g. Unknown/Not Stated) instead of NULL for unrecorded ethnicity, this overstates completeness. See Tenants - Ethnicity Not Recorded (Period).
	measure 'Ethnicity Data Completeness % (Period)' =
			VAR TotalTenants = [Total Active Tenants (Period)]
			VAR TenantsWithoutEthnicity = [Tenants - Ethnicity Not Recorded (Period)]
			RETURN
			IF(
			    TotalTenants = 0,
			    BLANK(),
			    DIVIDE(TotalTenants - TenantsWithoutEthnicity, TotalTenants)
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 10. Tenant Demographics\Data Quality
		lineageTag: e6a492a8-cb42-4e26-8e95-8bd4d2fd0027

	/// Share of active primary tenants whose gender is recorded, over the selected Date Table period. Calculated as recorded genders (Wahine/Female + Tane/Male + Other Gender) divided by all non-cancelled active primary tenants (recorded + Gender Not Recorded); cancelled tenancies are excluded from both the numerator and denominator so they share a consistent basis. Grain: primary-tenant records (approx. one per active tenancy). Stored 0-1, higher is better. (Period): responds to the Date Table slicer (FY 1 Jul-30 Jun); with no date selected, covers the full calendar range.
	measure 'Gender Data Completeness % (Period)' =
			VAR Recorded = [Tenants - Wahine (Female) (Period)] + [Tenants - Tane (Male) (Period)] + [Tenants - Other Gender (Period)]
			VAR NotRecorded = [Tenants - Gender Not Recorded (Period)]
			VAR Total = Recorded + NotRecorded
			RETURN
			IF(
			    Total = 0,
			    BLANK(),
			    DIVIDE(Recorded, Total)
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 10. Tenant Demographics\Data Quality
		lineageTag: 3e0bab27-b946-42e2-961e-8c11b7e875cd

	/// Total Transitional Housing tenancy exits whose Vacated Date falls in the selected Date Table period, counting only exits whose exit outcome is Positive, Negative or Neutral. Internal transfers between Emerge services, exits whose leaving reason has not yet been given an outcome (Unclassified) and exits with no recorded outcome (blank) are left out. Covers the whole selected date range and defaults to today when no date is selected. Tenancy grain: each vacated tenancy is counted, not each chain, so it will not reconcile with the chain-grain 'TH Exited ... Stay (12M)' measures.
	measure 'TH Exits (Period)' =
			VAR _IsDateFiltered = ISFILTERED('Date Table')
			VAR _StartDate =
			    IF(_IsDateFiltered, MIN('Date Table'[Calendar Date]), TODAY())
			VAR _EndDate =
			    IF(_IsDateFiltered, MAX('Date Table'[Calendar Date]), TODAY())
			VAR _Exits =
			    COUNTROWS(
			        FILTER(
			            'Tenancy',
			            'Tenancy'[Vacated Date] >= _StartDate &&
			            'Tenancy'[Vacated Date] <= _EndDate &&
			            NOT(ISBLANK('Tenancy'[Vacated Date])) &&
			            RELATED('Property'[Program]) = "Transitional Housing" &&
			            'Tenancy'[Exit Outcome] IN {"Positive", "Negative", "Neutral"}
			        )
			    )
			RETURN _Exits
		formatString: #,0
		displayFolder: 09. THVM Dashboard\Exits
		lineageTag: 56b6a1f4-757a-4a0d-8fb3-2e1986b31dc6

	/// Count of Transitional Housing tenancy exits whose exit outcome is Positive, within the period selected on the Date Table (the whole selected range; defaults to today when no date is selected). An exit = a tenancy with a Vacated Date in the period, Program = Transitional Housing, internal transfers excluded. Responds to the Date slicer.
	measure 'TH Positive Exits (Period)' =
			VAR _IsDateFiltered = ISFILTERED('Date Table')
			VAR _StartDate =
			    IF(_IsDateFiltered, MIN('Date Table'[Calendar Date]), TODAY())
			VAR _EndDate =
			    IF(_IsDateFiltered, MAX('Date Table'[Calendar Date]), TODAY())
			VAR _Exits =
			    COUNTROWS(
			        FILTER(
			            'Tenancy',
			            'Tenancy'[Vacated Date] >= _StartDate &&
			            'Tenancy'[Vacated Date] <= _EndDate &&
			            NOT(ISBLANK('Tenancy'[Vacated Date])) &&
			            RELATED('Property'[Program]) = "Transitional Housing" &&
			            'Tenancy'[Exit Outcome] = "Positive"
			        )
			    )
			RETURN _Exits
		formatString: #,0
		displayFolder: 09. THVM Dashboard\Exits
		lineageTag: 5faee497-1477-45aa-83b6-ae3c2d747c49

	/// Count of Transitional Housing tenancy exits whose exit outcome is Negative, within the period selected on the Date Table (the whole selected range; defaults to today when no date is selected). An exit = a Tenancy row with a Vacated Date in the period, Program = Transitional Housing, internal transfers excluded. Tenancy grain (each vacated tenancy counted). Responds to the Date slicer.
	measure 'TH Negative Exits (Period)' =
			VAR _IsDateFiltered = ISFILTERED('Date Table')
			VAR _StartDate =
			    IF(_IsDateFiltered, MIN('Date Table'[Calendar Date]), TODAY())
			VAR _EndDate =
			    IF(_IsDateFiltered, MAX('Date Table'[Calendar Date]), TODAY())
			VAR _Exits =
			    COUNTROWS(
			        FILTER(
			            'Tenancy',
			            'Tenancy'[Vacated Date] >= _StartDate &&
			            'Tenancy'[Vacated Date] <= _EndDate &&
			            NOT(ISBLANK('Tenancy'[Vacated Date])) &&
			            RELATED('Property'[Program]) = "Transitional Housing" &&
			            'Tenancy'[Exit Outcome] = "Negative"
			        )
			    )
			RETURN _Exits
		formatString: #,0
		displayFolder: 09. THVM Dashboard\Exits
		lineageTag: 7d276339-1b13-499e-a39d-a46848fb3c66

	/// Count of Transitional Housing tenancy exits whose exit outcome is Neutral, within the period selected on the Date Table (the whole selected range; defaults to today when no date is selected). An exit = a Tenancy row with a Vacated Date in the period, Program = Transitional Housing, internal transfers excluded. Responds to the Date slicer.
	measure 'TH Neutral Exits (Period)' =
			VAR _IsDateFiltered = ISFILTERED('Date Table')
			VAR _StartDate =
			    IF(_IsDateFiltered, MIN('Date Table'[Calendar Date]), TODAY())
			VAR _EndDate =
			    IF(_IsDateFiltered, MAX('Date Table'[Calendar Date]), TODAY())
			VAR _Exits =
			    COUNTROWS(
			        FILTER(
			            'Tenancy',
			            'Tenancy'[Vacated Date] >= _StartDate &&
			            'Tenancy'[Vacated Date] <= _EndDate &&
			            NOT(ISBLANK('Tenancy'[Vacated Date])) &&
			            RELATED('Property'[Program]) = "Transitional Housing" &&
			            'Tenancy'[Exit Outcome] = "Neutral"
			        )
			    )
			RETURN _Exits
		formatString: #,0
		displayFolder: 09. THVM Dashboard\Exits
		lineageTag: ed061a71-cc6b-4b3e-87f9-26645ac12ef5

	/// Share of Transitional Housing exits in the selected Date Table period whose exit outcome is Positive: TH Positive Exits (Period) divided by TH Exits (Period), blank when there are no exits in the period. The denominator is every TH exit in the period whose exit outcome is Positive, Negative or Neutral, so the three rates share it and add to 100%; internal transfers and exits whose outcome is Unclassified or blank are left out of both parts. Responds to the Date slicer across the whole selected range; defaults to today when no date is selected.
	measure 'TH Positive Exit Rate (Period) %' =
			VAR _TotalExits = [TH Exits (Period)]
			VAR _PositiveExits = [TH Positive Exits (Period)]
			RETURN DIVIDE(_PositiveExits, _TotalExits, BLANK())
		formatString: 0.0%
		displayFolder: 09. THVM Dashboard\Exits
		lineageTag: ef9bd699-e166-4508-83cc-444220af68b2

	/// Share of Transitional Housing exits in the selected Date Table period whose exit outcome is Negative: TH Negative Exits (Period) divided by TH Exits (Period), blank when there are no exits in the period. The denominator is every TH exit in the period whose exit outcome is Positive, Negative or Neutral, so the three rates share it and add to 100%; internal transfers and exits whose outcome is Unclassified or blank are left out of both parts. Responds to the Date slicer across the whole selected range; defaults to today when no date is selected.
	measure 'TH Negative Exit Rate (Period) %' =
			VAR _TotalExits = [TH Exits (Period)]
			VAR _NegativeExits = [TH Negative Exits (Period)]
			RETURN DIVIDE(_NegativeExits, _TotalExits, BLANK())
		formatString: 0.0%
		displayFolder: 09. THVM Dashboard\Exits
		lineageTag: 71c852b4-53db-4754-9f3f-5f99217a8934

	/// Share of Transitional Housing exits in the selected Date Table period whose exit outcome is Neutral: TH Neutral Exits (Period) divided by TH Exits (Period), blank when there are no exits in the period. The denominator is every TH exit in the period whose exit outcome is Positive, Negative or Neutral, so the three rates share it and add to 100%; internal transfers and exits whose outcome is Unclassified or blank are left out of both parts. Responds to the Date slicer across the whole selected range; defaults to today when no date is selected.
	measure 'TH Neutral Exit Rate (Period) %' =
			VAR _TotalExits = [TH Exits (Period)]
			VAR _NeutralExits = [TH Neutral Exits (Period)]
			RETURN DIVIDE(_NeutralExits, _TotalExits, BLANK())
		formatString: 0.0%
		displayFolder: 09. THVM Dashboard\Exits
		lineageTag: 2738b3da-a3ef-4e13-9636-8a2e8c3e1e12

	/// Total occupied bed nights across all properties during the selected date period. Calculates the number of days each property was occupied and sums across all properties. A property is considered occupied on a day if it had an active tenancy (started before/on that day and not vacated before that day). Counts one occupied-day per property per day (property-level bed nights); it does NOT multiply by the number of beds/units within a property, and would double-count any day a property has two overlapping tenancies. Responds to the Date slicer only; not filtered to a Program (counts all properties). Occupancy basis: a tenancy counts towards occupancy only once the household has taken up the place - that is, the tenancy has been activated, or it is recorded as Active, Active Arrears, Vacated, Vacated Arrears or Vacated Closed Account. Agreements that have been created but not yet activated, and cancelled agreements, are not counted as occupying a place.
	measure 'Occupied Bed Nights (Period)' =
			VAR _PeriodStart = MIN('Date Table'[Calendar Date])
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			RETURN
			SUMX(
			    'Property',
			    VAR _PropertyTenancies =
			        FILTER(
			            RELATEDTABLE('Tenancy'),
			            'Tenancy'[Is Occupying Tenancy] = 1 &&
			            'Tenancy'[Tenancy Start Date] <= _PeriodEnd &&
			            (ISBLANK('Tenancy'[Vacated Date]) || 'Tenancy'[Vacated Date] >= _PeriodStart)
			        )
			    RETURN
			    SUMX(
			        _PropertyTenancies,
			        VAR _TenancyStart = 'Tenancy'[Tenancy Start Date]
			        VAR _TenancyEnd = COALESCE('Tenancy'[Vacated Date], DATE(2099, 12, 31))
			        VAR _OverlapStart = MAX(_TenancyStart, _PeriodStart)
			        VAR _OverlapEnd = MIN(_TenancyEnd, _PeriodEnd)
			        RETURN
			        IF(
			            _OverlapEnd >= _OverlapStart,
			            DATEDIFF(_OverlapStart, _OverlapEnd, DAY) + 1,
			            0
			        )
			    )
			)
		formatString: #,0
		displayFolder: 09. THVM Dashboard\Occupancy
		lineageTag: 20d7b164-e11b-406e-828e-92325d087e6f

	/// Portfolio-wide share of Transitional Housing chains that were in service at the reference date whose continuous stay falls in the short band - 12 weeks or fewer from Chain Start Date - restricted to tenancies with occupied bed nights greater than zero in the selected period. Wraps [TH In Service - Short Stay %] and neutralizes only the Tenancy (Property Tenancy ID) row grain, so a tenancy-level visual or a card shows the single overall figure; it does not collapse a Property- or Tenant-level breakdown to the grand total (each such row returns a degenerate 100%), so use it as a card or grand total rather than on those breakdowns. Responds to the Date slicer (reference date = latest selected date, otherwise today); expressed as a percentage, and the four stay bands (Short/Medium/Long/Ultra-Long) sum to 100%. Stay length is chain-based (chains keyed on Chain ID, Tangata Whaiora ID and Chain Start Date) and most historical TH tenancies have a blank Tangata Whaiora ID, so chain grouping is unreliable for those rows.
	measure 'TH Short Stay % (Grand Total)' =
			CALCULATE(
			    [TH In Service - Short Stay %],
			    FILTER(
			        ALL('Tenancy'[Property Tenancy ID]),
			        CALCULATE([Occupied Bed Nights (Period)]) > 0
			    ),
			    ALL('Property'[Property Name]),
			    ALL('Tenant'[Full Name]),
			    ALL('Tenant'[Property Tenant ID])
			)
		formatString: 0.0%
		displayFolder: 09. THVM Dashboard\Length of Stay\Continuous Length Of Stay
		lineageTag: 3167a36f-5ce7-4036-99a9-b72daadb0ab4

	/// Portfolio-wide share of Transitional Housing chains that were in service at the reference date whose continuous stay falls in the medium band - over 12 up to 52 weeks from Chain Start Date (a chain of exactly 12 weeks counts as Short) - restricted to tenancies with occupied bed nights greater than zero in the selected period. Wraps [TH In Service - Medium Stay %] and neutralizes only the Tenancy (Property Tenancy ID) row grain, so a tenancy-level visual or a card shows the single overall figure; it does not collapse a Property- or Tenant-level breakdown to the grand total (each such row returns a degenerate 100%), so use it as a card or grand total rather than on those breakdowns. Responds to the Date slicer (reference date = latest selected date, otherwise today); expressed as a percentage, and the four stay bands (Short/Medium/Long/Ultra-Long) sum to 100%. Stay length is chain-based (chains keyed on Chain ID, Tangata Whaiora ID and Chain Start Date) and most historical TH tenancies have a blank Tangata Whaiora ID, so chain grouping is unreliable for those rows.
	measure 'TH Medium Stay % (Grand Total)' =
			CALCULATE(
			    [TH In Service - Medium Stay %],
			    FILTER(
			        ALL('Tenancy'[Property Tenancy ID]),
			        CALCULATE([Occupied Bed Nights (Period)]) > 0
			    ),
			    ALL('Property'[Property Name]),
			    ALL('Tenant'[Full Name]),
			    ALL('Tenant'[Property Tenant ID])
			)
		formatString: 0.0%
		displayFolder: 09. THVM Dashboard\Length of Stay\Continuous Length Of Stay
		lineageTag: 55b95cf1-e98b-4da7-9425-1e198d66c62f

	/// Portfolio-wide share of Transitional Housing chains that were in service at the reference date whose continuous stay falls in the long band - over 52 up to 104 weeks from Chain Start Date - restricted to tenancies with occupied bed nights greater than zero in the selected period. Wraps [TH In Service - Long Stay %] and neutralizes only the Tenancy (Property Tenancy ID) row grain, so a tenancy-level visual or a card shows the single overall figure; it does not collapse a Property- or Tenant-level breakdown to the grand total (each such row returns a degenerate 100%), so use it as a card or grand total rather than on those breakdowns. Responds to the Date slicer (reference date = latest selected date, otherwise today); expressed as a percentage, and the four stay bands (Short/Medium/Long/Ultra-Long) sum to 100%. Stay length is chain-based (chains keyed on Chain ID, Tangata Whaiora ID and Chain Start Date) and most historical TH tenancies have a blank Tangata Whaiora ID, so chain grouping is unreliable for those rows.
	measure 'TH Long Stay % (Grand Total)' =
			CALCULATE(
			    [TH In Service - Long Stay %],
			    FILTER(
			        ALL('Tenancy'[Property Tenancy ID]),
			        CALCULATE([Occupied Bed Nights (Period)]) > 0
			    ),
			    ALL('Property'[Property Name]),
			    ALL('Tenant'[Full Name]),
			    ALL('Tenant'[Property Tenant ID])
			)
		formatString: 0.0%
		displayFolder: 09. THVM Dashboard\Length of Stay\Continuous Length Of Stay
		lineageTag: 9b91a9de-a907-421c-b8f7-5f248a62bb81

	/// Portfolio-wide share of Transitional Housing chains that were in service at the reference date whose continuous stay falls in the ultra-long band - over 104 weeks from Chain Start Date - restricted to tenancies with occupied bed nights greater than zero in the selected period. Wraps [TH In Service - Ultra-Long Stay %] and neutralizes only the Tenancy (Property Tenancy ID) row grain, so a tenancy-level visual or a card shows the single overall figure; it does not collapse a Property- or Tenant-level breakdown to the grand total (each such row returns a degenerate 100%), so use it as a card or grand total rather than on those breakdowns. Responds to the Date slicer (reference date = latest selected date, otherwise today); expressed as a percentage, and the four stay bands (Short/Medium/Long/Ultra-Long) sum to 100%. Stay length is chain-based (chains keyed on Chain ID, Tangata Whaiora ID and Chain Start Date) and most historical TH tenancies have a blank Tangata Whaiora ID, so chain grouping is unreliable for those rows.
	measure 'TH Ultra-Long Stay % (Grand Total)' =
			CALCULATE(
			    [TH In Service - Ultra-Long Stay %],
			    FILTER(
			        ALL('Tenancy'[Property Tenancy ID]),
			        CALCULATE([Occupied Bed Nights (Period)]) > 0
			    ),
			    ALL('Property'[Property Name]),
			    ALL('Tenant'[Full Name]),
			    ALL('Tenant'[Property Tenant ID])
			)
		formatString: 0.0%
		displayFolder: 09. THVM Dashboard\Length of Stay\Continuous Length Of Stay
		lineageTag: e9ad49a0-f947-4356-b9e3-9124345ebeee

	/// Portfolio-wide count of unique Transitional Housing chains (households) in service at any point in the rolling 12 months ending at the reference date. Wraps [TH Households Serviced (12M)] - primary-tenant chains, excluding tenancies with Tenancy Status = Cancelled - restricted to tenancies with occupied bed nights greater than zero in the period, and neutralizes only the Tenancy (Property Tenancy ID) row grain, so a tenancy-level visual or a card shows the single overall total; it does not collapse a Property- or Tenant-level breakdown to the grand total, where it instead returns per-property or per-tenant counts. Responds to the Date slicer (reference date = latest selected date, otherwise today); the result is a whole-number count. Chain-based: chains are keyed on Chain ID, Tangata Whaiora ID and Chain Start Date, and most historical TH tenancies have a blank Tangata Whaiora ID, so distinct households sharing a Chain ID and Chain Start Date cannot be separated and the count may be understated for older or blank-client records.
	measure 'TH Households Serviced (12M) (Grand Total)' =
			CALCULATE(
			    [TH Households Serviced (12M)],
			    FILTER(
			        ALL('Tenancy'[Property Tenancy ID]),
			        CALCULATE([Occupied Bed Nights (Period)]) > 0
			    ),
			    ALL('Property'[Property Name]),
			    ALL('Tenant'[Full Name]),
			    ALL('Tenant'[Property Tenant ID])
			)
		formatString: #,0
		displayFolder: 09. THVM Dashboard\Length of Stay
		lineageTag: b3e35ef6-9f55-4880-bbae-5ef3941cdc89

	/// Count of Transitional Housing chain EXITS in the 12 calendar months ending at the selected date (responds to the Date Table slicer; defaults to today if no date is selected) whose total continuous stay was 365-728 days (>52 to 104 weeks, inclusive). A 'chain' links tenancies with gaps <=3 days into one continuous stay, keyed on Chain ID + Tangata Whaiora ID + Chain Start Date; stay length runs from Chain Start Date to the final tenancy's Vacated Date using inclusive day counting (DATEDIFF+1). Only chains that have actually exited are counted (a blank final Vacated Date = still in service, excluded); internal transfers between Emerge services are excluded. CAVEAT: chain grain, not tenancy grain, so this will NOT sum to the tenancy-grain 'TH Exits Last 12 Months'. CAVEAT: ~75% of historical TH tenancies have a blank Tangata Whaiora ID, so chain identity - and therefore stay length and this count - is unreliable for the blank-client majority; treat historical figures with caution. Per HUD THVM Dashboard specifications.
	measure 'TH Exited Long Stay (12M)' = ```
			VAR _IsDateFiltered = ISFILTERED('Date Table')
			VAR _ReferenceDate = 
			    IF(
			        _IsDateFiltered,
			        MAX('Date Table'[Calendar Date]),
			        TODAY()
			    )
			VAR _StartDate = EOMONTH(_ReferenceDate, -12) + 1
			VAR _EndDate = EOMONTH(_ReferenceDate, 0)
			VAR _LongStayMinDays = 364   -- >52 weeks inclusive: DATEDIFF 364 = 365 days
			VAR _LongStayMaxDays = 727   -- 104 weeks (728 days) inclusive: DATEDIFF 727 = 728 days
			
			// All TH tenancies
			VAR AllTHTenancies = 
			    CALCULATETABLE(
			        'Tenancy',
			        'Property'[Program] = "Transitional Housing"
			    )
			
			// Get chain-level summary
			VAR ChainInfo =
			    GROUPBY(
			        AllTHTenancies,
			        'Tenancy'[Chain ID],
			        'Tenancy'[Tangata Whaiora ID],
			        'Tenancy'[Chain Start Date],
			        "MaxTenancyStart", MAXX(CURRENTGROUP(), 'Tenancy'[Tenancy Start Date])
			    )
			
			// FIX: exit = the LAST tenancy's Vacated Date (blank => still in service), not MAX(Vacated) across the chain
			VAR ChainWithLastReason =
			    ADDCOLUMNS(
			        ChainInfo,
			        "ChainExitDate",
			        VAR _ChainID = 'Tenancy'[Chain ID]
			        VAR _TangataID = 'Tenancy'[Tangata Whaiora ID]
			        VAR _ChainStart = 'Tenancy'[Chain Start Date]
			        VAR _MaxStart = [MaxTenancyStart]
			        RETURN
			            MAXX(
			                FILTER(
			                    AllTHTenancies,
			                    'Tenancy'[Chain ID] = _ChainID &&
			                    'Tenancy'[Tangata Whaiora ID] = _TangataID &&
			                    'Tenancy'[Chain Start Date] = _ChainStart &&
			                    'Tenancy'[Tenancy Start Date] = _MaxStart
			                ),
			                'Tenancy'[Vacated Date]
			            ),
			        // Tenancies sharing the last start date: the highest Leaving Reason, then Exit Point, sets the outcome
			        "LastExitOutcome",
			        VAR _ChainID = 'Tenancy'[Chain ID]
			        VAR _TangataID = 'Tenancy'[Tangata Whaiora ID]
			        VAR _ChainStart = 'Tenancy'[Chain Start Date]
			        VAR _MaxStart = [MaxTenancyStart]
			        RETURN
			            MAXX(
			                TOPN(
			                    1,
			                    FILTER(
			                        AllTHTenancies,
			                        'Tenancy'[Chain ID] = _ChainID &&
			                        'Tenancy'[Tangata Whaiora ID] = _TangataID &&
			                        'Tenancy'[Chain Start Date] = _ChainStart &&
			                        'Tenancy'[Tenancy Start Date] = _MaxStart
			                    ),
			                    'Tenancy'[Leaving Reason], DESC,
			                    'Tenancy'[Exit Point], DESC
			                ),
			                'Tenancy'[Exit Outcome]
			            )
			    )
			
			// Filter to chains that exited in 12-month window with long stay duration (excluding internal transfers)
			// Using inclusive day counting: DATEDIFF + 1 for actual days stayed
			VAR LongStayExitedChains = 
			    FILTER(
			        ChainWithLastReason,
			        NOT ISBLANK([ChainExitDate]) &&
			        [ChainExitDate] >= _StartDate &&
			        [ChainExitDate] <= _EndDate &&
			        NOT([LastExitOutcome] = "Internal Transfer") &&
			        DATEDIFF('Tenancy'[Chain Start Date], [ChainExitDate], DAY) >= _LongStayMinDays &&
			        DATEDIFF('Tenancy'[Chain Start Date], [ChainExitDate], DAY) <= _LongStayMaxDays
			    )
			
			RETURN
			    COUNTROWS(LongStayExitedChains)
			```
		formatString: #,0
		displayFolder: 09. THVM Dashboard\Exits
		lineageTag: 42bde262-a09e-40b0-9316-57b3a74e722c

	/// (Period): Total number of days that active Transitional Housing properties were unoccupied within the selected Date Table range. Works at property level (days for that property) and total level (sum). Responds to the Date Table slicer (MIN..MAX of the selection); when no Date slicer is applied it defaults to the current month-to-date (1st of the current month through today). Restricted to the active portfolio (acquired on or before period end and not disposed before period start) and clamped to each property's in-portfolio window; occupancy excludes cancelled tenancies. Respects all Property filters.
	measure 'TH Property Unoccupied Days (Period)' =
			// Total unoccupied days for active TH properties within the selected date range
			// Works at property level (days for that property) and total level (sum of all)
			VAR _IsDateFiltered = ISFILTERED('Date Table')
			VAR _EndDate = IF(_IsDateFiltered, MAX('Date Table'[Calendar Date]), TODAY())
			VAR _StartDate = IF(_IsDateFiltered, MIN('Date Table'[Calendar Date]), DATE(YEAR(_EndDate), MONTH(_EndDate), 1))
			VAR _ActiveTHProperties =
			    FILTER(
			        'Property',
			        'Property'[Program] = "Transitional Housing" &&
			        'Property'[Acquired Date] <= _EndDate &&
			        (ISBLANK('Property'[Confirmed Disposal Date]) ||
			         'Property'[Confirmed Disposal Date] >= _StartDate)
			    )
			RETURN
			SUMX(
			    _ActiveTHProperties,
			    VAR _PropStart = MAX('Property'[Acquired Date], _StartDate)
			    VAR _PropEnd = MIN(
			        IF(ISBLANK('Property'[Confirmed Disposal Date]), DATE(9999,12,31), 'Property'[Confirmed Disposal Date]),
			        _EndDate
			    )
			    VAR _TotalDaysInPeriod = DATEDIFF(_PropStart, _PropEnd, DAY) + 1
			    VAR _OccupiedDays =
			        SUMX(
			            FILTER(
			                RELATEDTABLE('Tenancy'),
			                'Tenancy'[Tenancy Status] <> "Cancelled" &&
			                'Tenancy'[Tenancy Start Date] <= _PropEnd &&
			                (ISBLANK('Tenancy'[Vacated Date]) || 'Tenancy'[Vacated Date] >= _PropStart)
			            ),
			            VAR _TenStart = MAX('Tenancy'[Tenancy Start Date], _PropStart)
			            VAR _TenEnd = MIN(
			                COALESCE('Tenancy'[Vacated Date], DATE(9999,12,31)),
			                _PropEnd
			            )
			            RETURN IF(_TenEnd >= _TenStart, DATEDIFF(_TenStart, _TenEnd, DAY) + 1, 0)
			        )
			    RETURN MAX(0, _TotalDaysInPeriod - _OccupiedDays)
			)
		formatString: #,0
		displayFolder: 09. THVM Dashboard\Occupancy
		lineageTag: 8718f9d4-d6af-4afd-ab37-76c525f3dac6

	/// Count of distinct properties in the active portfolio at any point during the selected period. A property is counted if its Acquired Date is on or before the period end AND its Confirmed Disposal Date is blank or on or after the period start. (Period): responds to the Date Table slicer; the period is the MIN..MAX of the selected Calendar Date (NZ financial year 1 Jul-30 Jun when the FY range is selected). Property-level count, so no tenancy-status filter applies.
	measure 'Active Properties (Period)' =
			VAR _PeriodStart = MIN('Date Table'[Calendar Date])
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			RETURN
			COUNTROWS(
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= _PeriodEnd &&
			        (ISBLANK('Property'[Confirmed Disposal Date]) ||
			         'Property'[Confirmed Disposal Date] >= _PeriodStart)
			    )
			)
		formatString: #,0
		displayFolder: 01. Property Portfolio\Date-Aware
		lineageTag: aa1dbb33-a73f-40d6-bc02-44ccb2f54fe6

	/// Total available (active) property-days across all properties within the selected period, expressed in days. For each active property, days are counted inclusively (DATEDIFF + 1) from MAX(Acquired Date, period start) to MIN(Confirmed Disposal Date, period end), so partial-lifecycle properties are clamped to the portion of the period they were owned. (Period): responds to the Date Table slicer (period = MIN..MAX of the selected Calendar Date; NZ FY 1 Jul-30 Jun). This is the denominator of Occupancy Rate (Period) %.
	measure 'Available Property Days (Period)' =
			VAR _PeriodStart = MIN('Date Table'[Calendar Date])
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			RETURN
			SUMX(
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= _PeriodEnd &&
			        (ISBLANK('Property'[Confirmed Disposal Date]) ||
			         'Property'[Confirmed Disposal Date] >= _PeriodStart)
			    ),
			    VAR _PropStart = MAX('Property'[Acquired Date], _PeriodStart)
			    VAR _PropEnd = MIN(
			        IF(ISBLANK('Property'[Confirmed Disposal Date]), DATE(9999,12,31), 'Property'[Confirmed Disposal Date]),
			        _PeriodEnd
			    )
			    RETURN IF(_PropEnd >= _PropStart, DATEDIFF(_PropStart, _PropEnd, DAY) + 1, 0)
			)
		formatString: #,0
		displayFolder: 01. Property Portfolio\Date-Aware
		lineageTag: 6b24e962-b806-4b42-bb97-f1b6c2606268

	/// Sum of occupied days across all properties within the selected period. Respects property lifecycle dates (Acquired/Disposal) and excludes tenancies that are cancelled or not yet activated. Sums occupied days per occupying tenancy; if a property has concurrent tenancies these days are counted per tenancy and can exceed its available days (occupancy can exceed 100%). Occupancy basis: a tenancy counts towards occupancy only once the household has taken up the place - that is, the tenancy has been activated, or it is recorded as Active, Active Arrears, Vacated, Vacated Arrears or Vacated Closed Account. Agreements that have been created but not yet activated, and cancelled agreements, are not counted as occupying a place.
	measure 'Occupied Days (Period)' =
			VAR _PeriodStart = MIN('Date Table'[Calendar Date])
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			RETURN
			SUMX(
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= _PeriodEnd &&
			        (ISBLANK('Property'[Confirmed Disposal Date]) ||
			         'Property'[Confirmed Disposal Date] >= _PeriodStart)
			    ),
			    VAR _PropAcquired = 'Property'[Acquired Date]
			    VAR _PropDisposal = IF(ISBLANK('Property'[Confirmed Disposal Date]), DATE(9999,12,31), 'Property'[Confirmed Disposal Date])
			    VAR _PropStart = MAX(_PropAcquired, _PeriodStart)
			    VAR _PropEnd = MIN(_PropDisposal, _PeriodEnd)
			    VAR _PropertyTenancies =
			        FILTER(
			            RELATEDTABLE('Tenancy'),
			            'Tenancy'[Is Occupying Tenancy] = 1 &&
			            'Tenancy'[Tenancy Start Date] <= _PropEnd &&
			            (ISBLANK('Tenancy'[Vacated Date]) || 'Tenancy'[Vacated Date] >= _PropStart)
			        )
			    RETURN
			    SUMX(
			        _PropertyTenancies,
			        VAR _TenStart = MAX('Tenancy'[Tenancy Start Date], _PropStart)
			        VAR _TenEnd = MIN(
			            COALESCE('Tenancy'[Vacated Date], DATE(9999,12,31)),
			            _PropEnd
			        )
			        RETURN IF(_TenEnd >= _TenStart, DATEDIFF(_TenStart, _TenEnd, DAY) + 1, 0)
			    )
			)
		formatString: #,0
		displayFolder: 01. Property Portfolio\Date-Aware
		lineageTag: 512e2705-4277-4bfb-9f17-1a7c4e11c6cb

	/// Total unoccupied days within the selected period, calculated as Available Property Days minus Occupied Days and floored at zero. The zero floor prevents a negative result when Occupied Days (summed per non-cancelled tenancy) exceeds Available Property Days due to concurrent tenancies or overlapping data; it is a no-op in the normal case where available days are at least occupied days. Consistent with the MAX(0,...) floor already used inside Count of Unoccupied Properties (Period).
	measure 'Unoccupied Days (Period)' = MAX(0, [Available Property Days (Period)] - [Occupied Days (Period)])
		formatString: #,0
		displayFolder: 01. Property Portfolio\Date-Aware
		lineageTag: 6bf53c0b-2b3b-408c-adcf-e2b78b5961e1

	/// Share of available property-days that were occupied within the selected period, as a percentage. Calculated as Occupied Days (Period) / Available Property Days (Period) using DIVIDE (returns 0 when there are no available days). Inherits the numerator's rules: respects property lifecycle dates and excludes cancelled tenancies. (Period): responds to the Date Table slicer (NZ FY 1 Jul-30 Jun). Can exceed 100% at property/visual grain because concurrent tenancies on one property are counted per tenancy (observed up to ~169% for a single property). At portfolio (grand-total) grain the rate is well below 100% in practice (about 68-70% in recent financial years) because this concurrent-tenancy inflation is marginal across the full portfolio; note this is an empirical observation, not a guaranteed mathematical ceiling.
	measure 'Occupancy Rate (Period) %' = DIVIDE([Occupied Days (Period)], [Available Property Days (Period)], 0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 01. Property Portfolio\Date-Aware
		lineageTag: 61bd8963-3ebe-477f-aa96-3aa45b5e423f

	/// Status of a property at the end of the selected date: Occupied, Unoccupied, or Not Active. Evaluated at the latest selected date, so it responds to the date slicer. A property is Not Active if it had not been acquired by that date, or had already been disposed of. A property is Occupied when a tenancy that has started is still in place at the end of that day, so a property whose tenancy ends on that date shows Unoccupied unless another tenancy starts on or before it. Where several property records share one address, the address counts as active if any of those records was active on the date, and as occupied if any of them had a tenancy in place - matching how the occupancy and vacancy totals count. Occupancy basis: a tenancy counts towards occupancy only once the household has taken up the place - that is, the tenancy has been activated, or it is recorded as Active, Active Arrears, Vacated, Vacated Arrears or Vacated Closed Account. Agreements that have been created but not yet activated, and cancelled agreements, are not counted as occupying a place. Read this on property or address rows: at a grand total, or any grain covering several addresses, it describes the group as a whole - active or occupied if any member is - rather than a single property.
	measure 'Property Status at Date' =
			VAR _AsAtDate = MAX('Date Table'[Calendar Date])
			VAR _IsActive =
			    COUNTROWS (
			        FILTER (
			            'Property',
			            NOT ISBLANK ( 'Property'[Acquired Date] )
			                && 'Property'[Acquired Date] <= _AsAtDate
			                && ( ISBLANK ( 'Property'[Confirmed Disposal Date] )
			                     || 'Property'[Confirmed Disposal Date] >= _AsAtDate )
			        )
			    ) > 0
			VAR _HasActiveTenancy =
			    COUNTROWS(
			        FILTER(
			            RELATEDTABLE('Tenancy'),
			            'Tenancy'[Is Occupying Tenancy] = 1 &&
			            'Tenancy'[Tenancy Start Date] <= _AsAtDate &&
			            (ISBLANK('Tenancy'[Vacated Date]) || 'Tenancy'[Vacated Date] > _AsAtDate)
			        )
			    ) > 0
			RETURN
			IF(NOT(_IsActive), "Not Active",
			    IF(_HasActiveTenancy, "Occupied", "Unoccupied")
			)
		displayFolder: 01. Property Portfolio\Date-Aware
		lineageTag: 8be20ad6-8a8a-4506-932d-a9c530fd6445

	/// Average number of distinct households that occupied each active Transitional Housing property during the rolling 12 months ending at the reference date. For each active TH property (Acquired Date on/before period end and not disposed before period start) it counts the household already in residence at the start of the period (0 or 1) plus each new household that moved in during the period (new chains, Is New Chain = 1), then averages across those active TH properties. Higher values indicate shorter stays / more movement. Responds to the Date Table slicer - the 12 calendar months ending with the month of the latest selected date; defaults to the 12 calendar months ending with the current month when no date is selected. Caveat: new-household counting relies on Is New Chain, which is unreliable where Tangata Whaiora ID is blank (~75% of historical TH tenancies), so turnover may be over- or under-stated for that cohort. Occupancy basis: a tenancy counts towards occupancy only once the household has taken up the place - that is, the tenancy has been activated, or it is recorded as Active, Active Arrears, Vacated, Vacated Arrears or Vacated Closed Account. Agreements that have been created but not yet activated, and cancelled agreements, are not counted as occupying a place.
	measure 'TH Avg Household Turnover (12M)' = ```
			VAR _IsDateFiltered = ISFILTERED('Date Table')
			VAR _ReferenceDate = 
			    IF(
			        _IsDateFiltered,
			        MAX('Date Table'[Calendar Date]),
			        TODAY()
			    )
			VAR _StartDate = EOMONTH(_ReferenceDate, -12) + 1
			VAR _EndDate = EOMONTH(_ReferenceDate, 0)
			VAR ActiveTHProperties = 
			    FILTER(
			        CALCULATETABLE(
			            'Property',
			            'Property'[Program] = "Transitional Housing"
			        ),
			        'Property'[Acquired Date] <= _EndDate &&
			        (ISBLANK('Property'[Confirmed Disposal Date]) || 
			         'Property'[Confirmed Disposal Date] >= _StartDate)
			    )
			RETURN
			AVERAGEX(
			    ActiveTHProperties,
			    VAR _NewStarts =
			        CALCULATE(
			            COUNTROWS('Tenancy'),
			            'Tenancy'[Is Occupying Tenancy] = 1,
			            'Tenancy'[Tenancy Start Date] >= _StartDate,
			            'Tenancy'[Tenancy Start Date] <= _EndDate,
			            'Tenancy'[Is New Chain] = 1
			        )
			    VAR _AlreadyOccupied =
			        CALCULATE(
			            COUNTROWS(
			                FILTER(
			                    'Tenancy',
			                    'Tenancy'[Is Occupying Tenancy] = 1 &&
			                    'Tenancy'[Tenancy Start Date] < _StartDate &&
			                    (ISBLANK('Tenancy'[Vacated Date]) || 'Tenancy'[Vacated Date] >= _StartDate)
			                )
			            )
			        )
			    RETURN
			    0 + _NewStarts + IF(_AlreadyOccupied > 0, 1, 0)
			)
			```
		formatString: #,0.00
		displayFolder: 09. THVM Dashboard\Service Flows
		lineageTag: 86ba7875-2ce3-42b5-b48a-b61129e15163

	/// Average days between a Transitional Housing household vacating and the next household moving into the same property, over the rolling 12 months ending at the reference date (reference date = latest date selected in the Date slicer, else today). Vacancies not yet re-filled are measured to the reference date (right-censored), which understates their true time-to-fill. Uses ALL('Tenancy') for the next-tenancy lookup so per-row values stay correct when sliced by Tenancy Name.
	measure 'TH Avg Time to Fill Days (12M)' =
			VAR _IsDateFiltered = ISFILTERED('Date Table')
			VAR _ReferenceDate = IF(_IsDateFiltered, MAX('Date Table'[Calendar Date]), TODAY())
			VAR _StartDate = EOMONTH(_ReferenceDate, -12) + 1
			VAR _EndDate = EOMONTH(_ReferenceDate, 0)
			VAR AllTHTenancies =
			    CALCULATETABLE(
			        SELECTCOLUMNS(
			            'Tenancy',
			            "PropertyID", 'Tenancy'[Property ID],
			            "TenancyStart", 'Tenancy'[Tenancy Start Date],
			            "VacatedDate", 'Tenancy'[Vacated Date]
			        ),
			        ALL('Tenancy'),
			        'Property'[Program] = "Transitional Housing"
			    )
			VAR CurrentTenancies =
			    CALCULATETABLE(
			        SELECTCOLUMNS(
			            'Tenancy',
			            "PropertyID", 'Tenancy'[Property ID],
			            "TenancyStart", 'Tenancy'[Tenancy Start Date],
			            "VacatedDate", 'Tenancy'[Vacated Date]
			        ),
			        'Property'[Program] = "Transitional Housing"
			    )
			VAR ExitsInPeriod =
			    FILTER(
			        CurrentTenancies,
			        NOT(ISBLANK([VacatedDate])) &&
			        [VacatedDate] >= _StartDate &&
			        [VacatedDate] <= _EndDate
			    )
			VAR GapDays =
			    ADDCOLUMNS(
			        ExitsInPeriod,
			        "NextStart",
			        VAR _PropID = [PropertyID]
			        VAR _VacDate = [VacatedDate]
			        RETURN
			            MINX(
			                FILTER(AllTHTenancies, [PropertyID] = _PropID && [TenancyStart] > _VacDate),
			                [TenancyStart]
			            )
			    )
			RETURN
			    AVERAGEX(
			        GapDays,
			        VAR _EndPoint = IF(ISBLANK([NextStart]), _ReferenceDate, [NextStart])
			        RETURN MAX(0, DATEDIFF([VacatedDate], _EndPoint, DAY))
			    )
		formatString: #,0.0
		displayFolder: 09. THVM Dashboard\Occupancy
		lineageTag: c93695a5-61a6-4721-9d2b-497826ae0e41

	/// All-time total days properties spent in void, summing Days Interval over the Property Timeline void intervals (Record Type = VoidInterval), excluding RTLL (Returned-To-Landlord) intervals to match the other void/turnaround KPIs. Includes each property's most-recent still-open void, whose end date is TODAY(), so the total grows daily. Does not respond to the disconnected Date Table slicer; it sums across all history in the current Property context and responds to Property-level slicers (Program, Service, Suburb) via the Property relationship. A few source intervals carry a negative Days Interval (end before start) from upstream data-quality issues; for a date-filtered figure use 'Timeline Void Days (Period)'.
	measure 'Timeline Total Void Days' = CALCULATE(SUM('Property Timeline'[Days Interval]), 'Property Timeline'[Record Type] = "VoidInterval", 'Property Timeline'[Void Category] <> "RTLL")
		formatString: #,0
		displayFolder: 01. Property Portfolio\Timeline
		lineageTag: f2d005fb-7c42-403e-b473-9cd38ceb428f

	/// All-time total days properties were tenanted, summing Days Interval over the precomputed Property Timeline tenancy intervals (Record Type = TenancyInterval). Includes each property's most-recent still-open tenancy, whose end date is TODAY(), so the total grows daily. Does NOT respond to the Date Table slicer (Property Timeline has no relationship to it); it sums across all history in the current Property context and responds to Property-level slicers via the Property relationship. A small number of source intervals have a negative Days Interval (end before start) from upstream data-quality issues. For a date-filtered figure use 'Timeline Tenancy Days (Period)'.
	measure 'Timeline Total Tenancy Days' = CALCULATE(SUM('Property Timeline'[Days Interval]), 'Property Timeline'[Record Type] = "TenancyInterval")
		formatString: #,0
		displayFolder: 01. Property Portfolio\Timeline
		lineageTag: f9d20290-2933-4a7d-93a9-8e397c3b4324

	/// All-time average length in days of void intervals from the Property Timeline (mean of Days Interval where Record Type = VoidInterval), excluding RTLL (Returned-To-Landlord) intervals to match the other void/turnaround KPIs. Includes each property's still-open void, measured to TODAY(). Does not respond to the disconnected Date Table slicer; it returns the mean void duration across all history in the current Property context and responds to Property-level slicers (Program, Service, Suburb) via the Property relationship. There is no date-filtered average sibling - 'Timeline Void Days (Period)' is a period SUM, not an average.
	measure 'Timeline Avg Void Days' = CALCULATE(AVERAGE('Property Timeline'[Days Interval]), 'Property Timeline'[Record Type] = "VoidInterval", 'Property Timeline'[Void Category] <> "RTLL")
		formatString: #,0.0
		displayFolder: 01. Property Portfolio\Timeline
		lineageTag: 7886c193-7444-4465-8041-ff35c7852303

	/// Average Days Between Intervals across timeline rows that have a following interval (Reverse Row Number > 1, i.e. excluding each property's most-recent/open interval), mixing void and tenancy rows regardless of record type. Excludes negative gaps (Days Between Intervals >= 0): where consecutive source intervals overlap and produce a negative gap those rows are filtered out, so they do not lower the figure - including them would drag the average down. Not date-aware; computed across all timeline history in the current Property context. Treat as an approximate diagnostic and prefer 'Timeline Avg Ready-to-Let Gap Days' for the void re-let lag.
	measure 'Timeline Avg Gap Days' = CALCULATE(AVERAGE('Property Timeline'[Days Between Intervals]), 'Property Timeline'[Reverse Row Number] > 1, 'Property Timeline'[Days Between Intervals] >= 0)
		formatString: #,0.0
		displayFolder: 01. Property Portfolio\Timeline
		lineageTag: 007200e3-3e84-47d3-8382-8b599b6f4072

	/// Date-aware void days (Period): responds to the Date Table slicer, NZ FY 1 Jul-30 Jun. For each void interval that overlaps the selected period it clamps the interval to the period start/end and sums DATEDIFF(clampedStart, clampedEnd, DAY) - an exclusive count with no +1, so a single-day overlap contributes 0, and it excludes RTLL (Returned-To-Landlord) intervals to match the other void/turnaround KPIs. Because of the exclusive count it is not perfectly additive across sub-periods - summing months slightly undercounts the full-period figure at each month boundary. Independent of property lifecycle dates; it sums raw timeline void intervals, unlike the Date-Aware Unoccupied Days family.
	measure 'Timeline Void Days (Period)' =
			VAR _PeriodStart = MIN('Date Table'[Calendar Date])
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			RETURN
			SUMX(
			    FILTER(
			        'Property Timeline',
			        'Property Timeline'[Record Type] = "VoidInterval"
			            && 'Property Timeline'[Void Category] <> "RTLL"
			            && 'Property Timeline'[Interval Start Date] <= _PeriodEnd
			            && 'Property Timeline'[Interval End Date] >= _PeriodStart
			    ),
			    VAR _ClampedStart = MAX('Property Timeline'[Interval Start Date], _PeriodStart)
			    VAR _ClampedEnd = MIN('Property Timeline'[Interval End Date], _PeriodEnd)
			    RETURN DATEDIFF(_ClampedStart, _ClampedEnd, DAY)
			)
		formatString: #,0
		displayFolder: 01. Property Portfolio\Timeline
		lineageTag: 54c7635c-2f76-4e98-8737-60a70c075231

	/// Date-aware tenancy days (Period: responds to the Date Table slicer, NZ FY 1 Jul-30 Jun). For each tenancy interval that overlaps the selected period it clamps the interval to the period start/end and sums DATEDIFF(clampedStart, clampedEnd, DAY) - an exclusive count with no +1, so a single-day overlap contributes 0. Because of the exclusive count it is NOT perfectly additive across sub-periods: summing months undercounts the full-period figure by roughly one day per interval per month boundary. Independent of property lifecycle dates - it sums raw timeline tenancy intervals, unlike the Date-Aware Occupied Days family.
	measure 'Timeline Tenancy Days (Period)' =
			VAR _PeriodStart = MIN('Date Table'[Calendar Date])
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			RETURN
			SUMX(
			    FILTER(
			        'Property Timeline',
			        'Property Timeline'[Record Type] = "TenancyInterval"
			            && 'Property Timeline'[Interval Start Date] <= _PeriodEnd
			            && 'Property Timeline'[Interval End Date] >= _PeriodStart
			    ),
			    VAR _ClampedStart = MAX('Property Timeline'[Interval Start Date], _PeriodStart)
			    VAR _ClampedEnd = MIN('Property Timeline'[Interval End Date], _PeriodEnd)
			    RETURN DATEDIFF(_ClampedStart, _ClampedEnd, DAY)
			)
		formatString: #,0
		displayFolder: 01. Property Portfolio\Timeline
		lineageTag: 721a11b5-d875-4a7e-a8f2-6d673b729c01

	/// Count of active Transitional Housing properties continuously unoccupied for more than 20 days as at the selected date (MAX Calendar Date; falls back to today when no Date slicer is applied). Looks backwards from the reference date to find when the property last became unoccupied. Days are measured as elapsed days since the last Vacated Date (exclusive of the reference date, no +1), which can differ by one day at the boundary from the cumulative 'TH Places Unoccupied >20 Days (Period)' measure. Respects the property lifecycle (Confirmed Disposal Date only), uses model relationships, and excludes tenancies that are cancelled or not yet activated. If no tenancy ever existed, counts from Acquired Date. Occupancy basis: a tenancy counts towards occupancy only once the household has taken up the place - that is, the tenancy has been activated, or it is recorded as Active, Active Arrears, Vacated, Vacated Arrears or Vacated Closed Account. Agreements that have been created but not yet activated, and cancelled agreements, are not counted as occupying a place.
	measure 'TH Places Unoccupied >20 Days (Period End)' =
			// Count of TH properties continuously unoccupied for >20 days as of the selected date
			// Looks backwards from the reference date to find when property last became unoccupied
			VAR _AsAtDate = IF(ISFILTERED('Date Table'), MAX('Date Table'[Calendar Date]), TODAY())
			VAR _ActiveTHProperties =
			    FILTER(
			        'Property',
			        'Property'[Program] = "Transitional Housing" &&
			        'Property'[Acquired Date] <= _AsAtDate &&
			        (ISBLANK('Property'[Confirmed Disposal Date]) ||
			         'Property'[Confirmed Disposal Date] >= _AsAtDate)
			    )
			RETURN
			SUMX(
			    _ActiveTHProperties,
			    VAR _PropertyTenancies =
			        FILTER(
			            RELATEDTABLE('Tenancy'),
			            'Tenancy'[Is Occupying Tenancy] = 1 &&
			            'Tenancy'[Tenancy Start Date] <= _AsAtDate
			        )
			    VAR _HasActiveTenancy =
			        COUNTROWS(
			            FILTER(
			                _PropertyTenancies,
			                ISBLANK('Tenancy'[Vacated Date]) || 'Tenancy'[Vacated Date] >= _AsAtDate
			            )
			        ) > 0
			    VAR _LastVacatedDate =
			        MAXX(
			            FILTER(
			                _PropertyTenancies,
			                NOT(ISBLANK('Tenancy'[Vacated Date])) && 'Tenancy'[Vacated Date] <= _AsAtDate
			            ),
			            'Tenancy'[Vacated Date]
			        )
			    VAR _UnoccupiedSince =
			        IF(
			            _HasActiveTenancy,
			            BLANK(),
			            IF(ISBLANK(_LastVacatedDate), 'Property'[Acquired Date], _LastVacatedDate)
			        )
			    VAR _UnoccupiedDays =
			        IF(
			            ISBLANK(_UnoccupiedSince),
			            0,
			            DATEDIFF(_UnoccupiedSince, _AsAtDate, DAY)
			        )
			    RETURN IF(_UnoccupiedDays > 20, 1, 0)
			)
		formatString: #,0
		displayFolder: 09. THVM Dashboard\Occupancy
		lineageTag: 1059acb1-4be9-43a7-a9a1-4a52a560e2c9

	/// Total consecutive unoccupied days across all active properties as at the selected end date (MAX Calendar Date). For each active property with no occupying tenancy in force at the reference date, counts days from when it last became unoccupied - the most recent Vacated Date, or the Acquired Date if it has never been tenanted - up to the reference date (DATEDIFF in days, not +1 inclusive). Occupied properties contribute 0. (Period End): as at MAX selected Calendar Date, defaulting to the Date Table max when no slicer is set. Caveat: never-tenanted properties count from their Acquired Date, so placeholder acquisition dates (e.g. 1985-07-01) can substantially inflate the total. Uses the Date-Aware pattern: respects property lifecycle, uses model relationships, excludes tenancies that are cancelled or not yet activated. Occupancy basis: a tenancy counts towards occupancy only once the household has taken up the place - that is, the tenancy has been activated, or it is recorded as Active, Active Arrears, Vacated, Vacated Arrears or Vacated Closed Account. Agreements that have been created but not yet activated, and cancelled agreements, are not counted as occupying a place.
	measure 'Unoccupied Days (Period End)' =
			VAR _AsAtDate = MAX('Date Table'[Calendar Date])
			VAR _ActiveProperties =
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= _AsAtDate &&
			        (ISBLANK('Property'[Confirmed Disposal Date]) ||
			         'Property'[Confirmed Disposal Date] >= _AsAtDate)
			    )
			RETURN
			SUMX(
			    _ActiveProperties,
			    VAR _PropertyTenancies =
			        FILTER(
			            RELATEDTABLE('Tenancy'),
			            'Tenancy'[Is Occupying Tenancy] = 1 &&
			            'Tenancy'[Tenancy Start Date] <= _AsAtDate
			        )
			    VAR _HasActiveTenancy =
			        COUNTROWS(
			            FILTER(
			                _PropertyTenancies,
			                ISBLANK('Tenancy'[Vacated Date]) || 'Tenancy'[Vacated Date] >= _AsAtDate
			            )
			        ) > 0
			    VAR _LastVacatedDate =
			        MAXX(
			            FILTER(
			                _PropertyTenancies,
			                NOT(ISBLANK('Tenancy'[Vacated Date])) && 'Tenancy'[Vacated Date] <= _AsAtDate
			            ),
			            'Tenancy'[Vacated Date]
			        )
			    VAR _UnoccupiedSince =
			        IF(
			            _HasActiveTenancy,
			            BLANK(),
			            IF(ISBLANK(_LastVacatedDate), 'Property'[Acquired Date], _LastVacatedDate)
			        )
			    VAR _UnoccupiedDays =
			        IF(
			            ISBLANK(_UnoccupiedSince),
			            0,
			            DATEDIFF(_UnoccupiedSince, _AsAtDate, DAY)
			        )
			    RETURN _UnoccupiedDays
			)
		formatString: #,0
		displayFolder: 01. Property Portfolio\Date-Aware
		lineageTag: 399554e6-9e51-4cd9-b9fc-b8c6dcc64046

	/// Count of active properties that had any unoccupied days within the selected date range. A property is counted if its Available Days minus Occupied Days is greater than zero. Uses Date-Aware pattern: respects property lifecycle, clamps to period boundaries, uses model relationships, excludes tenancies that are cancelled or not yet activated. Occupancy basis: a tenancy counts towards occupancy only once the household has taken up the place - that is, the tenancy has been activated, or it is recorded as Active, Active Arrears, Vacated, Vacated Arrears or Vacated Closed Account. Agreements that have been created but not yet activated, and cancelled agreements, are not counted as occupying a place.
	measure 'Count of Unoccupied Properties (Period)' =
			VAR _PeriodStart = MIN('Date Table'[Calendar Date])
			VAR _PeriodEnd = MAX('Date Table'[Calendar Date])
			VAR _ActiveProperties =
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= _PeriodEnd &&
			        (ISBLANK('Property'[Confirmed Disposal Date]) ||
			         'Property'[Confirmed Disposal Date] >= _PeriodStart)
			    )
			RETURN
			SUMX(
			    _ActiveProperties,
			    VAR _PropStart = MAX('Property'[Acquired Date], _PeriodStart)
			    VAR _PropEnd = MIN(
			        IF(ISBLANK('Property'[Confirmed Disposal Date]), DATE(9999,12,31), 'Property'[Confirmed Disposal Date]),
			        _PeriodEnd
			    )
			    VAR _TotalDaysInPeriod = DATEDIFF(_PropStart, _PropEnd, DAY) + 1
			    VAR _OccupiedDays =
			        SUMX(
			            FILTER(
			                RELATEDTABLE('Tenancy'),
			                'Tenancy'[Is Occupying Tenancy] = 1 &&
			                'Tenancy'[Tenancy Start Date] <= _PropEnd &&
			                (ISBLANK('Tenancy'[Vacated Date]) || 'Tenancy'[Vacated Date] >= _PropStart)
			            ),
			            VAR _TenStart = MAX('Tenancy'[Tenancy Start Date], _PropStart)
			            VAR _TenEnd = MIN(
			                COALESCE('Tenancy'[Vacated Date], DATE(9999,12,31)),
			                _PropEnd
			            )
			            RETURN IF(_TenEnd >= _TenStart, DATEDIFF(_TenStart, _TenEnd, DAY) + 1, 0)
			        )
			    VAR _UnoccupiedDays = MAX(0, _TotalDaysInPeriod - _OccupiedDays)
			    RETURN IF(_UnoccupiedDays > 0, 1, 0)
			)
		formatString: #,0
		displayFolder: 01. Property Portfolio\Date-Aware
		lineageTag: ad0995c6-2669-4516-9ec6-871e7ad7abe6

	/// Number of properties held at the end of the selected period (acquired by then and not disposed of before it) that have no tenancy in place at the end of that day. A property whose tenancy ends on the last day of the period counts as unoccupied, with 0 unoccupied days, while a property with a tenancy starting that day counts as occupied. Responds to the date slicer, using the last selected date. Occupancy basis: a tenancy counts towards occupancy only once the household has taken up the place - that is, the tenancy has been activated, or it is recorded as Active, Active Arrears, Vacated, Vacated Arrears or Vacated Closed Account. Agreements that have been created but not yet activated, and cancelled agreements, are not counted as occupying a place.
	measure 'Count of Unoccupied Properties (Period End)' =
			VAR _AsAtDate = MAX('Date Table'[Calendar Date])
			VAR _ActiveProperties =
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= _AsAtDate &&
			        (ISBLANK('Property'[Confirmed Disposal Date]) ||
			         'Property'[Confirmed Disposal Date] >= _AsAtDate)
			    )
			RETURN
			SUMX(
			    _ActiveProperties,
			    VAR _PropertyTenancies =
			        FILTER(
			            RELATEDTABLE('Tenancy'),
			            'Tenancy'[Is Occupying Tenancy] = 1 &&
			            'Tenancy'[Tenancy Start Date] <= _AsAtDate
			        )
			    VAR _HasActiveTenancy =
			        COUNTROWS(
			            FILTER(
			                _PropertyTenancies,
			                ISBLANK('Tenancy'[Vacated Date]) || 'Tenancy'[Vacated Date] > _AsAtDate
			            )
			        ) > 0
			    RETURN IF(_HasActiveTenancy, 0, 1)
			)
		formatString: #,0
		displayFolder: 01. Property Portfolio\Date-Aware
		lineageTag: ebdba746-3d07-4fad-a392-5f945a57edac

	/// Returns the Tenancy Manager name from the most recent non-cancelled tenancy (by Tenancy Start Date) for the property in the current filter context. Excludes Cancelled and blank-status tenancies, consistent with other tenancy measures. Uses CROSSFILTER to enable bidirectional filtering between Property and Tenancy for this measure only. Designed for use in property tooltips.
	measure 'Latest Tenancy Manager' =
			CALCULATE(
			    VAR FilteredTenancies =
			        FILTER(
			            'Tenancy',
			            NOT ISBLANK('Tenancy'[Tenancy Status]) &&
			            'Tenancy'[Tenancy Status] <> "Cancelled"
			        )
			    VAR LatestStartDate =
			        MAXX(
			            FilteredTenancies,
			            'Tenancy'[Tenancy Start Date]
			        )
			    RETURN
			        MAXX(
			            FILTER(
			                FilteredTenancies,
			                'Tenancy'[Tenancy Start Date] = LatestStartDate
			            ),
			            'Tenancy'[Tenancy Manager]
			        ),
			    CROSSFILTER('Tenancy'[Property ID], 'Property'[Property ID], Both)
			)
		displayFolder: 02. Tenancy
		lineageTag: 7f5ccfbf-e5f1-47d2-bd9b-dd12a5f6fa79

	/// Sum of the current (0-6 day) aged-debt bucket ('Aged Debt'[Current 0-6 Days]) - amounts within the 0-6 day window that are not yet overdue. Snapshot measure - slice the Aged Debt fact to a single snapshot ('Aged Debt'[Current Date] = "Today" or one As At Year Month) or it sums across all stored monthly snapshots. Does not respond to the Date Table slicer. Sign convention: a negative amount is owed by the tenant; this current bucket is typically a net credit and shows positive.
	measure 'Total Current' = SUM('Aged Debt'[Current 0-6 Days])
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Aged Debt\Ageing Buckets
		lineageTag: dcb90ed4-ff46-41d7-b3db-fb36ea11e693

		annotation PBI_FormatHint = {"currencyCulture":"en-NZ"}

	/// Sum of aged debt in the 7-14 day overdue bucket ('Aged Debt'[7-14 Days]). Snapshot measure - slice the Aged Debt fact to a single snapshot ('Aged Debt'[Current Date] = "Today" or one As At Year Month) or it sums across all stored monthly snapshots. Does not respond to the Date Table slicer. A negative amount is owed by the tenant.
	measure 'Total 7 to 14' = SUM('Aged Debt'[7-14 Days])
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Aged Debt\Ageing Buckets
