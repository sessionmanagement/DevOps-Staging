	/// Counts Void Checklist records where 'Signed Lease Or Agreement Received' is recorded (signed lease/tenancy agreement received from the new tenant). Grain: void events, not distinct properties. Responds to Property-attribute slicers (Program, Service, Suburb) via the Property relationship. NOT date-aware: does not respond to the Date slicer; counts all voids in the current filter context.
	measure 'Leases Signed' =
			CALCULATE(
			    COUNTROWS('Void Checklist'),
			    NOT(ISBLANK('Void Checklist'[Signed Lease Or Agreement Received]))
			)
		formatString: #,##0
		displayFolder: 08. Void Management\Milestones
