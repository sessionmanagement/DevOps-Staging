			        MAX('Date Table'[Calendar Date]),
			        TODAY()
			    )
			VAR _StartDate = EOMONTH(_ReferenceDate, -12) + 1
			VAR _EndDate = EOMONTH(_ReferenceDate, 0)
			VAR _PositiveExits = 
			    COUNTROWS(
			        FILTER(
			            'Tenancy',
			            'Tenancy'[Vacated Date] >= _StartDate &&
			            'Tenancy'[Vacated Date] <= _EndDate &&
			            NOT(ISBLANK('Tenancy'[Vacated Date])) &&
			            RELATED('Property'[Program]) = "Transitional Housing" &&
			            'Tenancy'[Exit Outcome] = "Positive"
			        )
			    )
			RETURN
			    _PositiveExits
