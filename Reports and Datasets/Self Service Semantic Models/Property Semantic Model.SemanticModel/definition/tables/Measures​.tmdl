/// Central repository for all calculated measures in this semantic model. Contains KPIs, aggregations, and business logic calculations used across reports. Measures are organised into display folders by functional area (e.g., Property Portfolio, Maintenance, Tenancy). This table holds no data rows - it exists solely to house measure definitions.
table Measures​
	lineageTag: 620dcdda-0015-4aff-a044-307090a82f49

	/// Snapshot of the date and time the semantic model's data was last refreshed, converted to New Zealand local time (handles NZST/NZDT). Returns MAX of the single-row helper table LastRefreshed[Date Last Refreshed], which is captured server-side at refresh time; it is a fixed point-in-time value that does NOT respond to the Date Table slicer or any other filter. Displayed as dd/MM/yyyy HH:mm:ss (24-hour). Use to show a 'data as at' banner on reports.
	measure 'Last Refreshed' = MAX ( 'LastRefreshed'[Date Last Refreshed] )
		formatString: dd/MM/yyyy HH:mm:ss
		displayFolder: 00. Model Info
		lineageTag: 51ac8ddb-95c0-426c-bf93-7c912ec6d0f0

	/// Current snapshot. Count of properties in the ACTIVE portfolio (acquired on/before today and not yet disposed per Confirmed Disposal Date); excludes disposed and not-yet-acquired stock. Does NOT respond to the Date Table slicer — for a count active over a selected date range use Active Properties (Period).
	measure 'Total Properties (Current)' =
			CALCULATE(
			    COUNTROWS('Property'),
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= TODAY()
			            && ( ISBLANK('Property'[Confirmed Disposal Date]) || 'Property'[Confirmed Disposal Date] > TODAY() )
			    )
			)
		formatString: #,0
		displayFolder: 01. Property Portfolio\Current Snapshot
		lineageTag: 5052cb9d-edcf-4fb2-9f5f-0fa642fcc235

	/// Count of active-portfolio properties with Status = OCCUPIED, as at today. Active portfolio = Acquired Date <= today and not yet disposed (Confirmed Disposal Date blank or after today). Current snapshot — does NOT respond to the Date slicer.
	measure 'Properties Occupied (Current)' =
			CALCULATE(
			    COUNTROWS('Property'),
			    'Property'[Status] = "OCCUPIED",
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= TODAY()
			            && ( ISBLANK('Property'[Confirmed Disposal Date]) || 'Property'[Confirmed Disposal Date] > TODAY() )
			    )
			)
		formatString: #,0
		displayFolder: 01. Property Portfolio\Current Snapshot
		lineageTag: 05d641eb-4952-4c87-808e-7ac4aa8628b8

	/// Count of active-portfolio properties currently flagged Status = "VACANT: Tenantable" (ready to let). Current snapshot — ignores the Date slicer.
	measure 'Properties Vacant Tenantable (Current)' =
			CALCULATE(
			    COUNTROWS('Property'),
			    'Property'[Status] = "VACANT: Tenantable",
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= TODAY()
			            && ( ISBLANK('Property'[Confirmed Disposal Date]) || 'Property'[Confirmed Disposal Date] > TODAY() )
			    )
			)
		formatString: #,0
		displayFolder: 01. Property Portfolio\Current Snapshot
		lineageTag: fa04897a-343a-4bc6-b6ed-d4dd1502ea0d

	/// Count of active-portfolio properties currently flagged Status = "VACANT: Un-tenantable" (not ready to let; require maintenance or other work). Current snapshot — ignores the Date slicer.
	measure 'Properties Vacant Untenantable (Current)' =
			CALCULATE(
			    COUNTROWS('Property'),
			    'Property'[Status] = "VACANT: Un-tenantable",
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= TODAY()
			            && ( ISBLANK('Property'[Confirmed Disposal Date]) || 'Property'[Confirmed Disposal Date] > TODAY() )
			    )
			)
		formatString: #,0
		displayFolder: 01. Property Portfolio\Current Snapshot
		lineageTag: 854d9274-8522-40d0-abc8-48f3eca9aac5

	/// Count of active-portfolio properties currently vacant as at today = Properties Vacant Tenantable + Properties Vacant Untenantable. Current snapshot — does NOT respond to the Date slicer.
	measure 'Total Properties Vacant (Current)' = [Properties Vacant Tenantable (Current)] + [Properties Vacant Untenantable (Current)]
		formatString: #,0
		displayFolder: 01. Property Portfolio\Current Snapshot
		lineageTag: 94fb02d4-21f2-4db2-8856-5ffb0e784515

	/// Percentage of active-portfolio properties whose Status = OCCUPIED, as at today (Occupied / Total Properties). Current snapshot — does NOT respond to the Date slicer. Because Total Properties counts all active statuses, Occupancy % + Vacancy % need not sum to 100%.
	measure 'Occupancy Rate % (Current)' = DIVIDE([Properties Occupied (Current)], [Total Properties (Current)], 0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01. Property Portfolio\Current Snapshot
		lineageTag: ff35be02-da3b-4176-9fb2-e84703552685

	/// Percentage of active-portfolio properties currently vacant (tenantable + un-tenantable), as at today, over Total Properties. Current snapshot — does NOT respond to the Date slicer. Because Total Properties counts all active statuses, Occupancy % + Vacancy % need not sum to 100%.
	measure 'Vacancy Rate % (Current)' = DIVIDE([Total Properties Vacant (Current)], [Total Properties (Current)], 0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01. Property Portfolio\Current Snapshot
		lineageTag: bd2a4177-cb57-4029-be48-c80c05dbec9c

	/// Current snapshot. Average of the lifetime-cumulative 'Total Days Vacant' column across the ACTIVE portfolio (properties acquired on/before today and not yet disposed per Confirmed Disposal Date). The average spans ALL active properties, including currently-occupied ones whose accumulated historical vacant days are included, not only properties vacant today — it therefore reflects average lifetime vacancy burden per property rather than current vacancy duration. Does NOT respond to the Date Table slicer; responds to Property attribute slicers (e.g. Program, Suburb). Units: days.
	measure 'Avg Days Vacant (Current)' =
			CALCULATE(
			    AVERAGE('Property'[Total Days Vacant]),
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= TODAY()
			            && ( ISBLANK('Property'[Confirmed Disposal Date]) || 'Property'[Confirmed Disposal Date] > TODAY() )
			    )
			)
		formatString: #,0.0
		displayFolder: 01. Property Portfolio\Current Snapshot
		lineageTag: 9d6efa5e-6116-4548-875c-b4a1c6f7e97d

	/// Current snapshot. Sum of the lifetime-cumulative 'Total Days Vacant' column (per-property days ever vacant) across the ACTIVE portfolio only (properties acquired on/before today and not yet disposed per Confirmed Disposal Date). Does NOT respond to the Date Table slicer — for vacancy within a selected period use the period/void measures (e.g. Unoccupied Days (Period)). Units: days.
	measure 'Total Days Vacant (Current)' =
			CALCULATE(
			    SUM('Property'[Total Days Vacant]),
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= TODAY()
			            && ( ISBLANK('Property'[Confirmed Disposal Date]) || 'Property'[Confirmed Disposal Date] > TODAY() )
			    )
			)
		formatString: #,0
		displayFolder: 01. Property Portfolio\Current Snapshot
		lineageTag: 10b857b1-9004-4c2d-9185-ce87188c76a1

	/// Current snapshot. Average of the cumulative 'Days Under Maintenance' column across the ACTIVE portfolio (properties acquired on/before today and not yet disposed per Confirmed Disposal Date). The average spans ALL active properties, including currently-occupied ones whose accumulated maintenance days are included, not only properties under maintenance today. Does NOT respond to the Date Table slicer; responds to Property attribute slicers (e.g. Program, Suburb). Units: days.
	measure 'Avg Days Under Maintenance (Current)' =
			CALCULATE(
			    AVERAGE('Property'[Days Under Maintenance]),
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= TODAY()
			            && ( ISBLANK('Property'[Confirmed Disposal Date]) || 'Property'[Confirmed Disposal Date] > TODAY() )
			    )
			)
		formatString: #,0.0
		displayFolder: 01. Property Portfolio\Current Snapshot
		lineageTag: 6475fa59-156f-41d7-9e41-ff6152a5cf82

	/// Current snapshot. Count of Transitional Housing properties in the ACTIVE portfolio only (acquired on/before today and not yet disposed per Confirmed Disposal Date); does not respond to the Date Table slicer.
	measure 'Properties - Transitional Housing (Current)' =
			CALCULATE(
			    COUNTROWS('Property'),
			    'Property'[Program] = "Transitional Housing",
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= TODAY()
			            && ( ISBLANK('Property'[Confirmed Disposal Date]) || 'Property'[Confirmed Disposal Date] > TODAY() )
			    )
			)
		formatString: #,0
		displayFolder: 01. Property Portfolio\By Program
		lineageTag: e65cbfd5-df16-44f4-bfda-bb5724fc1cf7

	/// Current snapshot. Count of IRRS (Income Related Rent Subsidy) properties in the ACTIVE portfolio only (acquired on/before today and not yet disposed per Confirmed Disposal Date); does not respond to the Date Table slicer.
	measure 'Properties - IRRS (Current)' =
			CALCULATE(
			    COUNTROWS('Property'),
			    'Property'[Program] = "IRRS",
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= TODAY()
			            && ( ISBLANK('Property'[Confirmed Disposal Date]) || 'Property'[Confirmed Disposal Date] > TODAY() )
			    )
			)
		formatString: #,0
		displayFolder: 01. Property Portfolio\By Program
		lineageTag: d07d5b86-7cf7-4201-87ec-a53d14bef055

	/// Current snapshot. Count of Commercial Lease properties in the ACTIVE portfolio only (acquired on/before today and not yet disposed per Confirmed Disposal Date); does not respond to the Date Table slicer.
	measure 'Properties - Commercial Lease (Current)' =
			CALCULATE(
			    COUNTROWS('Property'),
			    'Property'[Program] = "Commercial Lease",
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= TODAY()
			            && ( ISBLANK('Property'[Confirmed Disposal Date]) || 'Property'[Confirmed Disposal Date] > TODAY() )
			    )
			)
		formatString: #,0
		displayFolder: 01. Property Portfolio\By Program
		lineageTag: 08a96617-b5e7-486c-911e-159d6b0fab5c

	/// Count of Affordable Housing properties (includes Affordable Rental and Affordable Housing Management). Current snapshot over the ACTIVE portfolio only (properties acquired on/before today and not yet disposed per Confirmed Disposal Date); does not respond to the Date Table slicer.
	measure 'Properties - Affordable Housing (Current)' =
			CALCULATE(
			    COUNTROWS('Property'),
			    'Property'[Program] IN {"Affordable Rental", "Affordable Housing Management"},
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= TODAY()
			            && ( ISBLANK('Property'[Confirmed Disposal Date]) || 'Property'[Confirmed Disposal Date] > TODAY() )
			    )
			)
		formatString: #,0
		displayFolder: 01. Property Portfolio\By Program
		lineageTag: 1d29fc49-9a6c-49a0-8b00-61b47a246e03

	/// Average current weekly rent across the ACTIVE portfolio (properties acquired on/before today and not yet disposed per Confirmed Disposal Date). Uses AVERAGE, so properties with no current rent (typically vacant properties, which carry a blank rent) are excluded from the denominator — the average is over active properties that have a rent value (currently ~1,361 of ~1,913 active). Current snapshot — does NOT respond to the Date slicer; responds to Property attribute slicers (e.g. Program, Suburb). Units: NZD per week.
	measure 'Avg Current Rent (Current)' =
			CALCULATE(
			    AVERAGE('Property'[Current Rent]),
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= TODAY()
			            && ( ISBLANK('Property'[Confirmed Disposal Date]) || 'Property'[Confirmed Disposal Date] > TODAY() )
			    )
			)
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 01. Property Portfolio\Current Snapshot
		lineageTag: 444f6dac-93ac-4d73-88cc-d925e4188504

	/// Sum of current weekly rent across the active portfolio (properties acquired and not yet disposed as at today). Current snapshot — does not respond to the Date slicer; responds to Property attribute slicers (e.g. Program, Suburb).
	measure 'Total Current Rent (Weekly, Current)' =
			CALCULATE(
			    SUM('Property'[Current Rent]),
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= TODAY()
			            && ( ISBLANK('Property'[Confirmed Disposal Date]) || 'Property'[Confirmed Disposal Date] > TODAY() )
			    )
			)
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 01. Property Portfolio\Current Snapshot
		lineageTag: 2cb6a16f-f559-45ac-9271-a1874350d023

	/// Current snapshot. Sum of Property[Total IRRS] across the ACTIVE portfolio only (acquired on/before today and not yet disposed per Confirmed Disposal Date). Does NOT respond to the Date Table slicer, but DOES respond to Property attribute slicers (Program, Suburb). UNITS: Total IRRS is an accumulated / stored total Income Related Rent Subsidy amount held per property (a periodically-refreshed stored value - see Total IRRS (Last Updated On)/(State)), NOT a weekly or annual rate; do NOT compare it directly with, or divide it by, Total Current Rent (Weekly) - it is ~117x the weekly-rent sum. Across the 429 subsidised active properties the per-property figure is right-skewed: median ~$59.5k, interquartile ~$35k-$76k, min non-zero ~$105, max ~$134k.
	measure 'Total IRRS Subsidy (Current)' =
			CALCULATE(
			    SUM('Property'[Total IRRS]),
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= TODAY()
			            && ( ISBLANK('Property'[Confirmed Disposal Date]) || 'Property'[Confirmed Disposal Date] > TODAY() )
			    )
			)
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 01. Property Portfolio\Current Snapshot
		lineageTag: e1fdfb82-56b6-4949-8709-377db473ca1e

	/// Average of each property's maximum permitted residents (Maximum People Allowed To Reside) across the active portfolio, as at today. This is permitted capacity, not actual occupancy. Current snapshot — ignores the Date slicer.
	measure 'Avg Max Occupancy (Current)' =
			CALCULATE(
			    AVERAGE('Property'[Maximum People Allowed To Reside]),
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= TODAY()
			            && ( ISBLANK('Property'[Confirmed Disposal Date]) || 'Property'[Confirmed Disposal Date] > TODAY() )
			    )
			)
		formatString: #,0.0
		displayFolder: 01. Property Portfolio\Current Snapshot
		lineageTag: b69eee20-2f67-4267-877a-cb03e32d8de1

	/// Count of all tenancy records (one row per tenancy) in the current filter context, across every lifecycle state - Active, Active Arrears, New, Vacated, Vacated Arrears and Vacated Closed Account, plus a small number of blank-status rows. Cancelled tenancies are already excluded from the model at source. All-time / historical scope - a cumulative count of every tenancy ever recorded, not an as-at-today snapshot. Does not respond to the Date Table slicer (the Date Table is disconnected from Tenancy); responds to Property / Program / Tenancy Type filters.
	measure 'Total Tenancies' = COUNTROWS('Tenancy')
		formatString: #,0
		displayFolder: 02. Tenancy
		lineageTag: 3727c178-2ece-4951-a04a-a3eddadaa5d3

	/// Current count of active tenancies (Tenancy Status = New, Active, or Active Arrears) for the current filter context. Point-in-time snapshot of the latest tenancy state — it does NOT respond to the Date Table slicer; use 'Active Tenancies (Period)' for a date-windowed count. Responds to Property / Program / Tenancy Type filters.
	measure 'Active Tenancies (Current)' = CALCULATE(COUNTROWS('Tenancy'), 'Tenancy'[Tenancy Status] IN {"New", "Active", "Active Arrears"})
		formatString: #,0
		displayFolder: 02. Tenancy\By Status
		lineageTag: ce234335-f552-40b2-8640-6f54ab07cacc

	/// Count of tenancies whose Tenancy Status = 'Active'. In this model 'Active Arrears' is a SEPARATE status, so arrears tenancies are excluded here and are counted by 'Tenancies - Active Arrears (Current)'. Current-status snapshot; does not respond to the Date slicer.
	measure 'Tenancies - Active (Current)' = CALCULATE(COUNTROWS('Tenancy'), 'Tenancy'[Tenancy Status] = "Active")
		formatString: #,0
		displayFolder: 02. Tenancy\By Status
		lineageTag: ca186486-ae06-4aaf-b32f-fee309de15cb

	/// Point-in-time count of tenancies whose current Tenancy Status is "Active Arrears" (an active tenancy carrying rent arrears). In this model "Active Arrears" is a SEPARATE status from "Active", so these tenancies are excluded from 'Tenancies - Active (Current)' and counted only here; together with New and Active they make up 'Active Tenancies (Current)'. Reflects the latest status only and does NOT respond to the Date slicer (the Date Table is disconnected from Tenancy); it does respond to Program, Property and other non-date slicers.
	measure 'Tenancies - Active Arrears (Current)' = CALCULATE(COUNTROWS('Tenancy'), 'Tenancy'[Tenancy Status] = "Active Arrears")
		formatString: #,0
		displayFolder: 02. Tenancy\By Status
		lineageTag: 437441cb-72ce-440f-a538-820a228b9b08

	/// Point-in-time count of tenancies whose current Tenancy Status is "Vacated" (tenant has vacated; not yet in the "Vacated Arrears" or "Vacated Closed Account" states). Reflects the latest status only and does NOT respond to the Date slicer (the Date Table is disconnected from Tenancy); it does respond to Program, Property and other non-date slicers.
	measure 'Tenancies - Vacated (Current)' = CALCULATE(COUNTROWS('Tenancy'), 'Tenancy'[Tenancy Status] = "Vacated")
		formatString: #,0
		displayFolder: 02. Tenancy\By Status
		lineageTag: f2dede4e-530d-4020-bdf6-03c957087de1

	/// Point-in-time count of tenancies whose current Tenancy Status is "Vacated Arrears" (vacated with outstanding arrears). Reflects the latest status only and does NOT respond to the Date slicer (the Date Table is disconnected from Tenancy); it does respond to Program, Property and other non-date slicers.
	measure 'Tenancies - Vacated Arrears (Current)' = CALCULATE(COUNTROWS('Tenancy'), 'Tenancy'[Tenancy Status] = "Vacated Arrears")
		formatString: #,0
		displayFolder: 02. Tenancy\By Status
		lineageTag: 17c991b9-b47c-4fd3-bd8d-dec56316551f

	/// Point-in-time count of tenancies whose current Tenancy Status is "Vacated Closed Account" (a fully closed tenancy account). Reflects the latest status only and does NOT respond to the Date slicer (the Date Table is disconnected from Tenancy); it does respond to Program, Property and other non-date slicers.
	measure 'Tenancies - Vacated Closed (Current)' = CALCULATE(COUNTROWS('Tenancy'), 'Tenancy'[Tenancy Status] = "Vacated Closed Account")
		formatString: #,0
		displayFolder: 02. Tenancy\By Status
		lineageTag: 4854c94c-6894-4959-9f57-7d3d42ec337f

	/// Intended as a point-in-time count of tenancies with Tenancy Status = "Cancelled", but this measure ALWAYS returns blank (never a number, not even 0). The Tenancy table is filtered at source (Power Query: [Tenancy Status] <> "Cancelled"), so no Cancelled rows exist in the model and the status filter can never match. Non-functional as written - a blank result does not mean zero cancellations occurred, only that cancelled tenancies are excluded from the model. Does not respond to the Date Table slicer. Hide or remove this measure unless the upstream source filter is changed to retain Cancelled tenancies.
	measure 'Tenancies - Cancelled (Current)' = CALCULATE(COUNTROWS('Tenancy'), 'Tenancy'[Tenancy Status] = "Cancelled")
		formatString: #,0
		isHidden
		displayFolder: 02. Tenancy\By Status
		lineageTag: bc98c3a6-bc4c-49c0-a837-ad6a11704eb6

	/// Point-in-time count of tenancies whose current Tenancy Status is "New" (a tenancy being set up). Reflects the latest status only and does NOT respond to the Date slicer (the Date Table is disconnected from Tenancy); it does respond to Program, Property and other non-date slicers. "New" is a valid current tenancy status, distinct from the separate "Active" status, and is not an error state.
	measure 'Tenancies - New (Current)' = CALCULATE(COUNTROWS('Tenancy'), 'Tenancy'[Tenancy Status] = "New")
		formatString: #,0
		displayFolder: 02. Tenancy\By Status
		lineageTag: 74fb4af6-064f-48f7-a24a-d3a4c1289b9c

	/// Share of currently-active tenancies that are flagged as being in arrears. Numerator = Tenancies - Active Arrears (Current) (Tenancy Status = "Active Arrears"); denominator = Active Tenancies (Current) (Tenancy Status in New / Active / Active Arrears). DIVIDE returns 0 when there are no active tenancies. Point-in-time snapshot on each tenancy's latest status; does not respond to the Date Table slicer (Date Table is disconnected) but responds to Property / Program / Tenancy Type filters. Bounded 0-100% because the Active Arrears numerator is a subset of the denominator.
	measure 'Active Tenancies In Arrears %' = DIVIDE([Tenancies - Active Arrears (Current)], [Active Tenancies (Current)], 0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02. Tenancy\By Status
		lineageTag: ce01419a-16ea-44ea-8a7a-668601af3a10

	/// Sum of 'Tenancy'[Rent] across every tenancy in the current filter context - an ALL-TIME aggregate spanning all lifecycle states (New, Active, Active Arrears, Vacated, Vacated Arrears, Vacated Closed Account; no Cancelled status exists - excluded at source). It is NOT a point-in-time figure: vacated/closed tenancies still contribute their stored [Rent] (13,139 of ~18,002 rows are Vacated Closed Account). Because [Rent] is a stored per-tenancy weekly-rent attribute and 'Date Table' is disconnected, it does NOT respond to the Date Table slicer; it responds to Property / Program / Tenancy Type / Tenancy Status filters. Caveat: 'Tenancy'[Rent] is not a clean weekly-rent basis - it carries negative values for arrears-status tenancies (min observed -$5,618), so summing it all-time is NOT the active rent roll and will be distorted without a Tenancy Status filter; for a live rent roll filter to active tenancies. The separate 'Rent Payable Weekly' column holds the gross weekly rent before Income Related Rent Subsidy is applied; confirm which basis your report needs.
	measure 'Total Rent (Tenancy)' = SUM('Tenancy'[Rent])
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Rent
		lineageTag: 7fd61c67-5128-4be2-930a-7e3ef8759786

	/// Average weekly rent per tenancy in the current filter context. 'Rent' holds the current weekly rent amount for each tenancy (net of any Income Related Rent Subsidy; the separate 'Rent Payable Weekly' column is the full weekly rent before subsidy). Scope is all tenancies in context across every lifecycle state (active, vacated and closed); Cancelled tenancies are already excluded from the model at source. Point-in-time snapshot — does not respond to the Date Table slicer; responds to Property / Program / Tenancy Type filters.
	measure 'Avg Rent Per Tenancy' = AVERAGE('Tenancy'[Rent])
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 02. Tenancy
		lineageTag: 10818a48-acd9-44f8-832b-69541b93d043

	/// Average number of tenancy signatories (people who signed the tenancy agreement as tenants) per tenancy in the current filter context. Scope is all tenancies in context across every lifecycle state (active, vacated and closed); Cancelled tenancies are already excluded from the model at source. Point-in-time snapshot — does not respond to the Date Table slicer; responds to Property / Program / Tenancy Type filters.
	measure 'Avg Tenancy Signatories' = AVERAGE('Tenancy'[Number Of Tenancy Signatories])
		formatString: #,0.0
		displayFolder: 02. Tenancy
		lineageTag: 8a4448bb-d4cd-4f52-82f7-1e0f7078cec4

	/// Count of tenancies (one row per tenancy) that have a Bond Lodged Date recorded - i.e. a bond lodged with Tenancy Services - in the current filter context. All-time scope across every lifecycle state; Cancelled tenancies are already excluded from the model at source. Counts every tenancy that has ever had a bond lodged, not an as-at-today snapshot. Does not respond to the Date Table slicer (the Date Table is disconnected from Tenancy); responds to Property / Program filters.
	measure 'Tenancies With Bond Lodged' = CALCULATE(COUNTROWS('Tenancy'), NOT(ISBLANK('Tenancy'[Bond Lodged Date])))
		formatString: #,0
		displayFolder: 02. Tenancy
		lineageTag: 08c3afca-dc87-4e54-9810-f4b9b0cd5c5e

	/// Count of distinct tenancies (by Property Tenancy ID) that have at least one arrears repayment arrangement recorded in 'Tenancy Transaction'[Arrears Arrangement]. All-time scope across all tenancy statuses in the current filter context (includes vacated/historical). Responds to Property / Program / Tenancy slicers; not date-aware (the Date Table is disconnected). NOTE: the original definition tested 'Tenancy'[Arrears Arrangement Activated] = "Yes", but that column contains only "No"/blank in the current data, so it always returned blank; this definition reads the populated transaction-level arrangement field instead.
	measure 'Tenancies With Arrears Arrangement' = CALCULATE(DISTINCTCOUNT('Tenancy Transaction'[Property Tenancy ID]), NOT(ISBLANK('Tenancy Transaction'[Arrears Arrangement])))
		formatString: #,0
		displayFolder: 04. Financial\Arrears
		lineageTag: 2faf3f60-d542-4ccd-ba6c-98e15a14fcf2

	/// Count of tenancies that have a Notice To Vacate Date recorded, in the current filter context. All-time scope: counts every tenancy with a notice date, including tenancies that have since vacated or closed as well as active tenancies with a pending notice; Cancelled tenancies are already excluded from the model at source. Point-in-time snapshot — does not respond to the Date Table slicer; responds to Property / Program filters. For the live pipeline of active tenancies still under notice, additionally filter Tenancy Status to New / Active / Active Arrears.
	measure 'Tenancies With Notice To Vacate' = CALCULATE(COUNTROWS('Tenancy'), NOT(ISBLANK('Tenancy'[Notice To Vacate Date])))
		formatString: #,0
		displayFolder: 02. Tenancy\Movement
		lineageTag: eaafd284-fc8f-469b-ae6b-23669fe9b10b

	/// Count of tenant occupant records in the current filter context - one row per person per tenancy, covering both primary lease signatories and other household members. All-time and all-status scope: no date, tenancy-status or occupant-status filter is applied (source-deleted rows are already excluded at load). A person who appears in more than one tenancy is counted once per tenancy, so this counts occupant records rather than distinct individuals - the row count exceeds the distinct tenant-ID count. Not date-aware - it ignores the Date Table slicer but responds to Property / Tenancy / Program filters, and equals Primary Tenants + Household Members.
	measure 'Total Tenants' = COUNTROWS('Tenant')
		formatString: #,0
		displayFolder: 03. Tenant
		lineageTag: ec557c9f-e3c9-4842-98b0-6db36a26db68

	/// Count of Tenant rows flagged as the primary tenant / main lease signatory (Is Primary Tenant = 1) in the current filter context - roughly one per tenancy. All-time / all-status scope (no date or status filter). Not date-aware - ignores the Date Table slicer; responds to Property / Tenancy / Program filters. Primary Tenants + Household Members = Total Tenants. Note: a small number of tenancies carry two primary-flagged rows and some carry none, which affects the household income/size measures that filter on this flag.
	measure 'Primary Tenants' = CALCULATE(COUNTROWS('Tenant'), 'Tenant'[Is Primary Tenant] = 1)
		formatString: #,0
		displayFolder: 03. Tenant
		lineageTag: d558de1d-bdd5-407b-b912-68f80d96db16

	/// Count of Tenant rows that are non-primary household occupants (Is Primary Tenant = 0) in the current filter context. All-time / all-status scope (no date or status filter). The Is Primary Tenant flag is strictly 1/0 with no blanks, so Household Members + Primary Tenants = Total Tenants. Not date-aware - ignores the Date Table slicer; responds to Property / Tenancy / Program filters.
	measure 'Household Members' = CALCULATE(COUNTROWS('Tenant'), 'Tenant'[Is Primary Tenant] = 0)
		formatString: #,0
		displayFolder: 03. Tenant
		lineageTag: 2592cd59-e8ab-4a59-b568-5a026b73700f

	/// Average number of occupants per household, computed as the AVERAGE of Tenant[Number Of Household Members] over primary-tenant rows only (Is Primary Tenant = 1) so each household is counted once rather than weighted by its size. Households with no primary-flagged occupant row are excluded, and the few with two primary rows are counted twice. Value is a person count (observed range 1-11; roughly two-thirds of households are single-occupant, giving ~1.7 overall). Not date-aware - ignores the Date Table slicer; responds to Property / Tenancy / Program filters.
	measure 'Avg Household Size' = CALCULATE(AVERAGE('Tenant'[Number Of Household Members]), 'Tenant'[Is Primary Tenant] = 1)
		formatString: #,0.0
		displayFolder: 03. Tenant
		lineageTag: c135d549-4174-4d07-a6c0-31663e5799f0

	/// Total household income counted once per household: sums Tenant[Total Income Of The Household] restricted to the primary-tenant row (Is Primary Tenant = 1) so the household-level income, which is repeated on every household member's row, is not multiplied by household size. Grain is one value per tenancy's primary tenant, added across all Tenant rows in the current filter context; units are NZD. Not date-aware (ignores the Date Table slicer); responds to Property / Tenancy / Program slicers. Data caveat: the source column Tenant[Total Income Of The Household] is currently unpopulated - every non-blank row is exactly zero - so this measure returns zero across the whole model and should be treated as not-yet-available data rather than a genuine zero; note also that households with two primary-flagged rows double-count and households with no primary-flagged row are excluded.
	measure 'Total Household Income' = CALCULATE(SUM('Tenant'[Total Income Of The Household]), 'Tenant'[Is Primary Tenant] = 1)
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 03. Tenant\Income
		lineageTag: 492986bb-6984-4714-9d29-afe3315aa085

	/// Average total household income per household: the AVERAGE of Tenant[Total Income Of The Household] over primary-tenant records only (Is Primary Tenant = 1), roughly one row per household; units are NZD. Not date-aware - it ignores the Date Table slicer but responds to Property / Tenancy / Program filters. Data caveat: the source column is currently unpopulated (every non-blank row is exactly zero), so this measure returns zero across the whole model and should be treated as not-yet-available data rather than a genuine zero. Households with no primary-flagged occupant row are excluded from the average, and the few households that carry two primary-flagged rows are weighted twice.
	measure 'Avg Household Income' = CALCULATE(AVERAGE('Tenant'[Total Income Of The Household]), 'Tenant'[Is Primary Tenant] = 1)
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 03. Tenant\Income
		lineageTag: 8f6e3455-8301-433e-aabe-772de0f90c9e

	/// Count of tenant records (all occupants — primary tenants and household members) whose Disability field records an actual disability. Excludes blanks and the negative values 'None', 'No' and 'No Disability'; counts values such as Physical, Intellectual, Psychiatric, Visual Impairment and 'Yes - Not Specified'. Snapshot of the current Tenant table — does not respond to the Date Table slicer. Note: in the current data Disability is populated almost entirely on non-primary household-member rows (primary tenants are blank), so this effectively counts household members with a recorded disability.
	measure 'Tenants With Disability' = CALCULATE(COUNTROWS('Tenant'), NOT(ISBLANK('Tenant'[Disability])), NOT('Tenant'[Disability] IN {"None", "No", "No Disability"}))
		formatString: #,0
		displayFolder: 10. Tenant Demographics
		lineageTag: f08417b6-54a7-459e-9231-c7e0273d1fdd

	/// Count of tenant records whose Employment Status indicates paid work — 'Full-time Employment', 'Part-time Employment' or 'Casual Employment'. Excludes Benefits, Unemployed, Student, Unknown, N/A and blanks. Snapshot of the current Tenant table — does not respond to the Date Table slicer. Note: Employment Status is populated only on non-primary household-member rows in the current data (primary tenants are blank), so this effectively counts employed household members.
	measure 'Tenants Employed' = CALCULATE(COUNTROWS('Tenant'), 'Tenant'[Employment Status] IN {"Full-time Employment", "Part-time Employment", "Casual Employment"})
		formatString: #,0
		displayFolder: 10. Tenant Demographics
		lineageTag: d58239e0-6a8c-4daa-b3ce-f4616bd35a6f

	/// Row count of all tenancy financial transaction lines in 'Tenancy Transaction' (each charge and each payment is a separate row, so this is a line count, not a distinct-transaction count). Responds to Property / Tenancy / Program slicers via model relationships. Does NOT respond to the 'Date Table' slicer (that table is disconnected from the transaction fact); to window by date, filter 'Tenancy Transaction'[Transaction Date].
	measure 'Total Transactions' = COUNTROWS('Tenancy Transaction')
		formatString: #,0
		displayFolder: 04. Financial
		lineageTag: 9f90e6c7-dbd0-4ee2-924d-6ddb7b610b59

	/// Net sum of 'Tenancy Transaction'[Amount] (charges negative, payments positive) - a signed balance movement, not gross charges. Responds to Property / Tenancy / Program slicers via model relationships; does NOT respond to the 'Date Table' slicer (that table is disconnected from the transaction fact). To window by date, filter 'Tenancy Transaction'[Transaction Date].
	measure 'Transaction Amount' = SUM('Tenancy Transaction'[Amount])
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial
		lineageTag: 173c68ab-9dd8-449c-ad9e-6029725523ff

	/// Total 'Rent Charge' transactions (SUM of 'Tenancy Transaction'[Amount] where Transaction Type = "Rent Charge"). Stored as negative amounts (a charge to the tenant; all values <= 0). All-time total in the current filter context - responds to Property / Tenancy / Program filters but does NOT respond to the disconnected Date Table slicer; to window by date, filter 'Tenancy Transaction'[Transaction Date]. Used as a component of [Net Rent Position].
	measure 'Rent Charged' = CALCULATE(SUM('Tenancy Transaction'[Amount]), 'Tenancy Transaction'[Transaction Type] = "Rent Charge")
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Rent
		lineageTag: 6decb50f-7218-402d-a650-7987f4c7224a

	/// Total 'Rent Payment' transactions received (SUM of 'Tenancy Transaction'[Amount] where Transaction Type = "Rent Payment"; positive amounts, all values >= 0). All-time total in the current filter context - responds to Property / Tenancy / Program filters but does NOT respond to the disconnected Date Table slicer; to window by date, filter 'Tenancy Transaction'[Transaction Date]. Used as a component of [Net Rent Position].
	measure 'Rent Payments' = CALCULATE(SUM('Tenancy Transaction'[Amount]), 'Tenancy Transaction'[Transaction Type] = "Rent Payment")
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Rent
		lineageTag: 335bc1cc-cf21-499a-80e8-8b8acb802f20

	/// Total 'Rent CR Adjustment' transactions (SUM of 'Tenancy Transaction'[Amount] where Transaction Type = "Rent CR Adjustment"; typically credits/positive, net +1.8M). All-time total in the current filter context - responds to Property / Tenancy / Program filters but does NOT respond to the disconnected Date Table slicer; to window by date, filter 'Tenancy Transaction'[Transaction Date]. Used as a component of [Net Rent Position].
	measure 'Rent Adjustments CR' = CALCULATE(SUM('Tenancy Transaction'[Amount]), 'Tenancy Transaction'[Transaction Type] = "Rent CR Adjustment")
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Rent
		lineageTag: 3a66601d-a7cf-4212-b9e3-a87ee87c55a6

	/// Total 'Rent DR Adjustment' transactions (SUM of 'Tenancy Transaction'[Amount] where Transaction Type = "Rent DR Adjustment"; typically debits/negative, net -1.8M). All-time total in the current filter context - responds to Property / Tenancy / Program filters but does NOT respond to the disconnected Date Table slicer; to window by date, filter 'Tenancy Transaction'[Transaction Date]. Used as a component of [Net Rent Position].
	measure 'Rent Adjustments DR' = CALCULATE(SUM('Tenancy Transaction'[Amount]), 'Tenancy Transaction'[Transaction Type] = "Rent DR Adjustment")
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Rent
		lineageTag: 6c4480cb-b4b8-4e09-8c0f-e5d52c01c579

	/// Total dollar value of rent-refund transactions (Transaction Types "Refund of Rent" and "Refund of Rent (Motels)"), summing Amount from the Tenancy Transaction ledger. Responds to Property / Tenancy / Program filters and to filters on the Tenancy Transaction table; does NOT respond to the disconnected Date Table slicer — window by date using 'Tenancy Transaction'[Transaction Date].
	measure 'Rent Refunds' = CALCULATE(SUM('Tenancy Transaction'[Amount]), 'Tenancy Transaction'[Transaction Type] IN {"Refund of Rent", "Refund of Rent (Motels)"})
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Rent
		lineageTag: 52b60e05-76b0-496e-8a9d-f12417e87b70

	/// Net rent-account position = Rent Charged + Rent Payments + Rent Adjustments CR + Rent Adjustments DR + Rent Refunds, all from 'Tenancy Transaction'. Positive = tenant in credit / overpaid; negative = arrears. All-time net in the current filter context; NOT responsive to the Date Table slicer (disconnected). Covers only these five rent transaction types - other rent-related transactions (e.g. write-offs) are excluded.
	measure 'Net Rent Position' = [Rent Charged] + [Rent Payments] + [Rent Adjustments CR] + [Rent Adjustments DR] + [Rent Refunds]
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Rent
		lineageTag: 4ce651bd-c92a-410d-8303-ed19a60eea5e

	/// All-time total of 'Electricity Charge' transactions, summing 'Tenancy Transaction'[Amount] at transaction grain (gross charges only — excludes Electricity CR/DR adjustments and payments). In this ledger charge types are stored as negatives, so this measure returns a negative total (-$4.83M all-time); pair with Electricity Payments to read the net position. Responds to Property / Tenancy / Program context; does NOT respond to the disconnected Date Table slicer — window by date using 'Tenancy Transaction'[Transaction Date].
	measure 'Electricity Charged' = CALCULATE(SUM('Tenancy Transaction'[Amount]), 'Tenancy Transaction'[Transaction Type] = "Electricity Charge")
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Utilities
		lineageTag: 0daca18a-a1b8-462f-9e77-9c99abaece02

	/// All-time total of 'Electricity Payment' transactions, summing 'Tenancy Transaction'[Amount] at transaction grain (payments only — excludes CR/DR adjustments). In this ledger payment types are stored as positives, so this measure returns a positive total (+$3.84M all-time). Responds to Property / Tenancy / Program context; does NOT respond to the disconnected Date Table slicer — window by date using 'Tenancy Transaction'[Transaction Date].
	measure 'Electricity Payments' = CALCULATE(SUM('Tenancy Transaction'[Amount]), 'Tenancy Transaction'[Transaction Type] = "Electricity Payment")
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Utilities
		lineageTag: f98b53cb-f586-49a2-80a7-c8550e49dfa9

	/// All-time total of 'Water Usage Charge' transactions, summing 'Tenancy Transaction'[Amount] at transaction grain (gross charges only — excludes Water Usage CR adjustments and payments). In this ledger charge types are stored as negatives, so this measure returns a negative total (-$0.15M all-time); pair with Water Payments to read the net position. Responds to Property / Tenancy / Program context; does NOT respond to the disconnected Date Table slicer — window by date using 'Tenancy Transaction'[Transaction Date].
	measure 'Water Charged' = CALCULATE(SUM('Tenancy Transaction'[Amount]), 'Tenancy Transaction'[Transaction Type] = "Water Usage Charge")
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Utilities
		lineageTag: 3a54a316-2974-4880-90f4-0a02b5bebefa

	/// All-time total of Water Usage Payment transactions, summing 'Tenancy Transaction'[Amount] at transaction grain. Filters to Transaction Type = 'Water Usage Payment' only, so it excludes Water Usage Charge, Water Usage CR Adjustment and Arrears Payment Water. In this ledger payment types are stored as positive amounts, so the measure returns a positive total. Responds to Property / Tenancy / Program context; does not respond to the disconnected Date Table slicer - window by date using 'Tenancy Transaction'[Transaction Date].
	measure 'Water Payments' = CALCULATE(SUM('Tenancy Transaction'[Amount]), 'Tenancy Transaction'[Transaction Type] = "Water Usage Payment")
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Utilities
		lineageTag: db8a5f2a-a814-4476-9c80-37b6e72daa23

	/// All-time total of 'Internet Access Charge' transactions, summing 'Tenancy Transaction'[Amount] at transaction grain (gross charges only — excludes Internet Access CR/DR adjustments and payments). In this ledger charge types are stored as negatives, so this measure returns a negative total (-$54.5K all-time); pair with Internet Payments to read the net position. Responds to Property / Tenancy / Program context; does NOT respond to the disconnected Date Table slicer — window by date using 'Tenancy Transaction'[Transaction Date].
	measure 'Internet Charged' = CALCULATE(SUM('Tenancy Transaction'[Amount]), 'Tenancy Transaction'[Transaction Type] = "Internet Access Charge")
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Utilities
		lineageTag: ab541c25-df59-4eed-afd7-f6520a41e51f

	/// All-time total of 'Internet Access Payment' transactions, summing 'Tenancy Transaction'[Amount] at transaction grain (payments only — excludes CR/DR adjustments). In this ledger payment types are stored as positives, so this measure returns a positive total (+$48.9K all-time). Responds to Property / Tenancy / Program context; does NOT respond to the disconnected Date Table slicer — window by date using 'Tenancy Transaction'[Transaction Date].
	measure 'Internet Payments' = CALCULATE(SUM('Tenancy Transaction'[Amount]), 'Tenancy Transaction'[Transaction Type] = "Internet Access Payment")
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Utilities
		lineageTag: 97d586af-158e-45f1-b549-9d504e24e24a

	/// All-time total of client damage charges — transaction types 'Client Damages Charge' and 'Client Damages (Meth) Charge' (includes meth contamination) — summing 'Tenancy Transaction'[Amount] at transaction grain (gross charges only; excludes Client Damages CR/DR adjustments and payments). In this ledger charge types are stored as negatives, so this measure returns a negative total (-$3.73M all-time); pair with Client Damages Payments to read the net position. Responds to Program / Property / Tenancy context; does NOT respond to the disconnected Date Table slicer — window by date using 'Tenancy Transaction'[Transaction Date].
	measure 'Client Damages Charged' = CALCULATE(SUM('Tenancy Transaction'[Amount]), 'Tenancy Transaction'[Transaction Type] IN {"Client Damages Charge", "Client Damages (Meth) Charge"})
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Damages
		lineageTag: ea1920a2-69de-4811-ac85-4f813788ba55

	/// All-time total of client damage payments received — transaction types 'Client Damages Payment' and 'Client Damages (Meth) Payment' — summing 'Tenancy Transaction'[Amount] at transaction grain (payments only; excludes CR/DR adjustments). In this ledger payment types are stored as positives, so this measure returns a positive total (+$0.46M all-time). Responds to Program / Property / Tenancy context; does NOT respond to the disconnected Date Table slicer — window by date using 'Tenancy Transaction'[Transaction Date].
	measure 'Client Damages Payments' = CALCULATE(SUM('Tenancy Transaction'[Amount]), 'Tenancy Transaction'[Transaction Type] IN {"Client Damages Payment", "Client Damages (Meth) Payment"})
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Damages
		lineageTag: 8cf72d7a-c253-483f-a384-2555811ef466

	/// Total rent arrears repayments received - sum of 'Tenancy Transaction'[Amount] where Transaction Type = "Arrears Payment Rent". Stored as positive amounts (payments received). All-time total in the current filter context; responds to Property / Tenancy / Program slicers but NOT to the Date Table slicer (disconnected) - to window by date, filter 'Tenancy Transaction'[Transaction Date].
	measure 'Arrears Payments - Rent' = CALCULATE(SUM('Tenancy Transaction'[Amount]), 'Tenancy Transaction'[Transaction Type] = "Arrears Payment Rent")
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Arrears
		lineageTag: a2272b9b-bd2a-48b7-8bef-356b271be7e7

	/// Total arrears payments received across utility-related transaction types: Arrears Payment Utilities, Arrears Payment Water, and Arrears Payment Cleaning. Sums Tenancy Transaction[Amount] for these types; responds to Program/Tenancy filters and is not date-aware (Date Table is disconnected).
	measure 'Arrears Payments - Utilities' = CALCULATE(SUM('Tenancy Transaction'[Amount]), 'Tenancy Transaction'[Transaction Type] IN {"Arrears Payment Utilities", "Arrears Payment Water", "Arrears Payment Cleaning"})
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Arrears
		lineageTag: 86badb48-33c9-45a7-9c4a-f2043cbde918

	/// Total tenant-liability arrears repayments received - sum of 'Tenancy Transaction'[Amount] where Transaction Type = "Arrears Payment Tenant Liability". Stored as positive amounts (payments received). All-time total in the current filter context; responds to Property / Tenancy / Program slicers but NOT to the Date Table slicer (disconnected) - to window by date, filter 'Tenancy Transaction'[Transaction Date].
	measure 'Arrears Payments - Tenant Liability' = CALCULATE(SUM('Tenancy Transaction'[Amount]), 'Tenancy Transaction'[Transaction Type] = "Arrears Payment Tenant Liability")
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Arrears
		lineageTag: 0da44658-7c6c-4b05-b873-aa16d2b9bfbd

	/// Sum of 'Tenancy Transaction'[Amount] where Transaction Type = 'Write Off Bad Debt- Rent'. All-time total at transaction grain. Bad-debt write-offs are recorded as positive credit-like entries (they clear owed balances), so this measure returns a positive total (+$115.2K all-time). In this fact charge types aggregate negative and payment/credit types aggregate positive — the opposite of the Amount column's stored hint — so confirm sign before netting against other measures. Responds to Property / Tenancy / Program context but NOT to the disconnected Date Table slicer (no transaction-date filter applied), so it returns the same value across date buckets — window by date using 'Tenancy Transaction'[Transaction Date].
	measure 'Bad Debt Write-Off - Rent' = CALCULATE(SUM('Tenancy Transaction'[Amount]), 'Tenancy Transaction'[Transaction Type] = "Write Off Bad Debt- Rent")
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Write-Offs
		lineageTag: de718a8f-d665-4496-a31d-5179ed5d2576

	/// Sum of 'Tenancy Transaction'[Amount] where Transaction Type = 'Write off Bad Debt- Utilities'. All-time total at transaction grain. Bad-debt write-offs are recorded as positive credit-like entries (they clear owed balances), so this measure returns a positive total (+$5.1K all-time). In this fact charge types aggregate negative and payment/credit types aggregate positive — the opposite of the Amount column's stored hint — so confirm sign before netting against other measures. Responds to Property / Tenancy / Program context but NOT to the disconnected Date Table slicer (no transaction-date filter applied), so it returns the same value across date buckets — window by date using 'Tenancy Transaction'[Transaction Date].
	measure 'Bad Debt Write-Off - Utilities' = CALCULATE(SUM('Tenancy Transaction'[Amount]), 'Tenancy Transaction'[Transaction Type] = "Write off Bad Debt- Utilities")
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Write-Offs
		lineageTag: 46a9d6c5-2132-4c41-b140-de1ad768e323

	/// Sum of 'Tenancy Transaction'[Amount] where Transaction Type = 'Write off Bad Debt- Tenant Liability'. All-time total at transaction grain. Bad-debt write-offs are recorded as positive credit-like entries (they clear owed balances), so this measure returns a positive total (+$11.3K all-time). In this fact charge types aggregate negative and payment/credit types aggregate positive — the opposite of the Amount column's stored hint — so confirm sign before netting against other measures. Responds to Property / Tenancy / Program context but NOT to the disconnected Date Table slicer (no transaction-date filter applied), so it returns the same value across date buckets — window by date using 'Tenancy Transaction'[Transaction Date].
	measure 'Bad Debt Write-Off - Tenant Liability' = CALCULATE(SUM('Tenancy Transaction'[Amount]), 'Tenancy Transaction'[Transaction Type] = "Write off Bad Debt- Tenant Liability")
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Write-Offs
		lineageTag: ff350eb7-412a-4a0b-b891-db4154766cde

	/// Total bad debt written off = Rent + Utilities + Tenant Liability write-off amounts (sum of the three 'Bad Debt Write-Off -' component measures). All-time total at transaction grain. Responds to Property / Tenancy / Program context but NOT to the Date Table slicer (Date Table is disconnected), so it returns the same value across date buckets. These three are the only bad-debt write-off transaction types in the model - no other bad-debt write-off categories exist.
	measure 'Total Bad Debt Written Off' = [Bad Debt Write-Off - Rent] + [Bad Debt Write-Off - Utilities] + [Bad Debt Write-Off - Tenant Liability]
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Write-Offs
		lineageTag: 5f661b15-647c-4d6e-bcd5-5a00b213a5de

	/// Sum of each tenancy's latest recorded rent balance (rows where Is Latest Balance = TRUE). Negative = rent arrears (amount owed); positive = credit. Current snapshot - does NOT respond to the Date Table slicer (disconnected); responds to Program / Property / Tenancy context.
	measure 'Current Rent Balance' = CALCULATE(SUM('Tenancy Transaction'[Balance Rent]), 'Tenancy Transaction'[Is Latest Balance] = TRUE)
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Balances
		lineageTag: 7e4459a5-e311-4c93-a26f-9d9b29bcf05c

	/// Sum of each tenancy's latest recorded non-rent balance (utilities, damages and other non-rent charges; rows where Is Latest Balance = TRUE). Negative = amount owed (non-rent arrears); positive = credit. Current snapshot - does NOT respond to the Date Table slicer (disconnected); responds to Program / Property / Tenancy context.
	measure 'Current Non-Rent Balance' = CALCULATE(SUM('Tenancy Transaction'[Balance Non Rent]), 'Tenancy Transaction'[Is Latest Balance] = TRUE)
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Balances
		lineageTag: e73f2d15-5460-4f33-ac6c-67dc48c929f6

	/// Sum of each tenancy's latest recorded total balance (rent + non-rent; rows where Is Latest Balance = TRUE). Negative = arrears (amount owed); positive = credit. Current snapshot - does NOT respond to the Date Table slicer; responds to Program / Property / Tenancy context.
	measure 'Current Total Balance' = CALCULATE(SUM('Tenancy Transaction'[Balance Total]), 'Tenancy Transaction'[Is Latest Balance] = TRUE)
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Balances
		lineageTag: 796ed8e0-6613-4a6a-a772-de75bbc5268b

	/// Distinct count of tenancies (by Property Tenancy ID) that have a latest balance record (Is Latest Balance = TRUE), including zero balances. Current snapshot - does NOT respond to the Date Table slicer. For tenancies with outstanding debt only, use an arrears/aged-debt measure instead.
	measure 'Tenancies With Current Balance' = CALCULATE(DISTINCTCOUNT('Tenancy Transaction'[Property Tenancy ID]), 'Tenancy Transaction'[Is Latest Balance] = TRUE)
		formatString: #,0
		displayFolder: 04. Financial\Balances
		lineageTag: 0b5e5e42-a797-4080-8552-b2c180d85aa4

	/// Total value of Lawns & Garden Maintenance charges (standard + Responsive charge transaction types) from 'Tenancy Transaction', at transaction grain. All-time total in the current filter context; NOT responsive to the Date Table slicer (Date Table is disconnected) - scope it with Property/Tenancy/Program filters. Charge amounts are stored as negative values in the ledger (payments are positive), so this measure returns a negative total; excludes lawns payment, adjustment and arrears-repayment transaction types.
	measure 'Lawns & Gardens Charged' = CALCULATE(SUM('Tenancy Transaction'[Amount]), 'Tenancy Transaction'[Transaction Type] IN {"Lawns & Garden Maintenance Charge", "Lawns & Garden Maintenance (Responsive) Charge"})
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Other Charges
		lineageTag: 328631ac-7d45-4463-ba23-cb77679f6d53

	/// Total Lawns & Garden Maintenance payments received (standard + Responsive) from 'Tenancy Transaction'. All-time total in the current filter context; NOT responsive to the Date Table slicer (disconnected) - scope with Property/Tenancy/Program filters.
	measure 'Lawns & Gardens Payments' = CALCULATE(SUM('Tenancy Transaction'[Amount]), 'Tenancy Transaction'[Transaction Type] IN {"Lawns & Garden Maintenance Payment", "Lawns & Garden Maintenance (Responsive) Payment"})
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Other Charges
		lineageTag: dee362cc-a082-420b-8fe4-e149af5d4df6

	/// All-time total of cleaning charges (transaction type 'Cleaning Charge' only) at transaction grain. Sums 'Tenancy Transaction'[Amount] in the current filter context; not date-filtered - does NOT respond to the Date Table slicer (disconnected). Charge amounts are stored as negative values in the ledger, so this measure returns a negative total; excludes Cleaning Payment, CR/DR adjustment, duty and arrears-repayment transaction types.
	measure 'Cleaning Charged' = CALCULATE(SUM('Tenancy Transaction'[Amount]), 'Tenancy Transaction'[Transaction Type] = "Cleaning Charge")
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Other Charges
		lineageTag: d31d9174-2056-4a8f-addf-84dbde2d5999

	/// All-time total of Special Needs Grant (SNG) amounts applied to tenant rent and non-rent accounts (four SNG grant/claim transaction types). Sums 'Tenancy Transaction'[Amount] in the current filter context; not date-filtered - does NOT respond to the Date Table slicer (disconnected).
	measure 'SNG Grants Applied' = CALCULATE(SUM('Tenancy Transaction'[Amount]), 'Tenancy Transaction'[Transaction Type] IN {"SNG Grant Paid - apply to Tenant Non-Rent", "SNG Grant Paid - apply to Tenant Rent", "SNG Claim Payment (Transferred to Non Rent)", "SNG Claim Payment (transferred to Rent)"})
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 04. Financial\Grants
		lineageTag: fca5c58e-b94f-45cc-8ec7-50d1881d94e2

	/// Count of all maintenance work orders (grain: one row per Property Maintenance work order). Static count of the current maintenance table — responds to Property and maintenance-attribute slicers but NOT the Date Table slicer (no date relationship exists on 'Property Maintenance'). Includes all task statuses, i.e. cancelled and on-hold work orders are counted.
	measure 'Total Maintenance Work Orders' = COUNTROWS('Property Maintenance')
		formatString: #,0
		displayFolder: 05. Maintenance
		lineageTag: 49d58538-2229-4b7a-b858-e5ed1fab8419

	/// Count of maintenance work orders whose Task State = 'Active' (grain: one row per Property Maintenance work order). Task State holds only 'Active' or 'Inactive', so this plus Inactive Maintenance Work Orders reconciles to Total Maintenance Work Orders. Current data-state count: responds to Property and maintenance-attribute slicers but NOT the Date Table slicer (no date relationship exists on 'Property Maintenance').
	measure 'Active Maintenance Work Orders' = CALCULATE(COUNTROWS('Property Maintenance'), 'Property Maintenance'[Task State] = "Active")
		formatString: #,0
		displayFolder: 05. Maintenance
		lineageTag: 36784eb2-c1b6-4d9c-adc2-9bead8e156bb

	/// Count of maintenance work orders whose Task State is 'Inactive'. 'Inactive' is the work order's current lifecycle state, not a confirmed completion or closure — for completion/closure use the finalised/completed flags (Is Work Task Finalised / Is Completed Satisfactorily), and note it may overlap with cancelled or on-hold orders. Current data-state count; does not respond to the Date slicer.
	measure 'Inactive Maintenance Work Orders' = CALCULATE(COUNTROWS('Property Maintenance'), 'Property Maintenance'[Task State] = "Inactive")
		formatString: #,0
		displayFolder: 05. Maintenance
		lineageTag: 543e348f-82b5-4780-871f-9334b465c4e0

	/// Count of individual maintenance task lines (grain: one row per Property Maintenance Task). Multiple tasks can belong to a single work order, so this typically exceeds Total Maintenance Work Orders. Current data-state count: responds to Property and maintenance-attribute slicers but NOT the Date Table slicer (no date relationship exists on 'Property Maintenance Task').
	measure 'Total Maintenance Tasks' = COUNTROWS('Property Maintenance Task')
		formatString: #,0
		displayFolder: 05. Maintenance
		lineageTag: 9af306ea-290c-4d13-be3f-a00b07709726

	/// Sum of task-level cost amounts (Property Maintenance Task[Amount], NZD) across all maintenance tasks; grain aggregates one Amount per task line. Tasks with no Amount recorded contribute nothing and there are no negative amounts in current data. Current data-state total: responds to Property and maintenance-attribute slicers but NOT the Date Table slicer (no date relationship exists on 'Property Maintenance Task').
	measure 'Total Maintenance Cost' = SUM('Property Maintenance Task'[Amount])
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 05. Maintenance
		lineageTag: 1bad3a80-09fe-410f-bca3-e1ce5bd03d47

	/// Average task-level maintenance cost - the AVERAGE of Property Maintenance Task[Amount] in NZD. Because DAX AVERAGE ignores tasks with a blank Amount, the denominator is the count of tasks that have a cost recorded, not Total Maintenance Tasks; zero-cost tasks do carry a recorded amount and are included, which pulls the average down. Responds to Property and maintenance-attribute slicers but not the Date Table slicer, as no date relationship exists on 'Property Maintenance Task'.
	measure 'Avg Maintenance Task Cost' = AVERAGE('Property Maintenance Task'[Amount])
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 05. Maintenance
		lineageTag: ac172d67-a3c9-450f-98c3-7ad1a634ab34

	/// Count of maintenance work orders where Task Urgency = "Emergency". Grain: one row per work order. Responds to Property and maintenance-attribute slicers but NOT the Date Table slicer.
	measure 'Maintenance - Emergency' = CALCULATE(COUNTROWS('Property Maintenance'), 'Property Maintenance'[Task Urgency] = "Emergency")
		formatString: #,0
		displayFolder: 05. Maintenance
		lineageTag: 8a0a4b50-02f6-41d5-8c84-19d904cbe179

	/// Count of maintenance work orders where Task Urgency = "Urgent". Grain: one row per work order. Responds to Property and maintenance-attribute slicers but NOT the Date Table slicer.
	measure 'Maintenance - Urgent' = CALCULATE(COUNTROWS('Property Maintenance'), 'Property Maintenance'[Task Urgency] = "Urgent")
		formatString: #,0
		displayFolder: 05. Maintenance
		lineageTag: 5b38964d-a463-4443-85f8-b311afd73995

	/// Count of maintenance work orders where Task Urgency = "Standard". Grain: one row per work order. Responds to Property and maintenance-attribute slicers but NOT the Date Table slicer.
	measure 'Maintenance - Standard' = CALCULATE(COUNTROWS('Property Maintenance'), 'Property Maintenance'[Task Urgency] = "Standard")
		formatString: #,0
		displayFolder: 05. Maintenance
		lineageTag: 65177633-e6d4-42af-9ce1-77a8af2169a1

	/// Count of maintenance work orders where Task Urgency = "Cyclical" (planned/cyclical maintenance). Grain: one row per work order. Responds to Property and maintenance-attribute slicers but NOT the Date Table slicer.
	measure 'Maintenance - Cyclical' = CALCULATE(COUNTROWS('Property Maintenance'), 'Property Maintenance'[Task Urgency] = "Cyclical")
		formatString: #,0
		displayFolder: 05. Maintenance
		lineageTag: afea2c1e-e53d-4c27-b0db-1755bbe1ec21

	/// Count of maintenance work orders flagged as completed by the contractor (Is Completed By Contractor = 1). Grain: one row per work order. Responds to Property and maintenance-attribute slicers but NOT the Date Table slicer. Note: currently hidden because it depends on a source flag column (property_maintenance_completed_by_contractor_flag) that is not yet loaded — unhide once the model source change below is applied.
	measure 'Maintenance Completed By Contractor' = CALCULATE(COUNTROWS('Property Maintenance'), 'Property Maintenance'[Is Completed By Contractor] = 1)
		formatString: #,0
		isHidden
		displayFolder: 05. Maintenance\Completion
		lineageTag: b5d77a7e-d4e4-4c63-969d-30a6b1b537fe

	/// Count of maintenance work orders where a post-completion inspection has been done (Is Post Inspection Done = 1, from the source Post Inspection Done Flag). Grain: one row per work order (Property Maintenance header). Responds to Property and maintenance-attribute slicers but NOT the Date Table slicer (the Date Table is disconnected).
	measure 'Maintenance Post Inspection Done' = CALCULATE(COUNTROWS('Property Maintenance'), 'Property Maintenance'[Is Post Inspection Done] = 1)
		formatString: #,0
		displayFolder: 05. Maintenance\Completion
		lineageTag: 2c5dcff0-b1a3-4cd7-8022-e9ad7546cfb2

	/// Count of maintenance work orders flagged completed to a satisfactory standard (Is Completed Satisfactorily = 1, from the source Completed Satisfactorily Flag). Grain: one row per work order (Property Maintenance header). Responds to Property and maintenance-attribute slicers but NOT the Date Table slicer. Caveat: the source Completed Satisfactorily Flag is currently 0 for every row, so this measure returns blank against the present data - confirm the ETL populates the flag before relying on it.
	measure 'Maintenance Completed Satisfactorily' = CALCULATE(COUNTROWS('Property Maintenance'), 'Property Maintenance'[Is Completed Satisfactorily] = 1)
		formatString: #,0
		displayFolder: 05. Maintenance\Completion
		lineageTag: bf31febc-bdc5-42c5-b8d4-5a90da8fd1ad

	/// Count of maintenance work orders confirmed/approved for payment to the contractor (Is Confirmed For Payment = 1, from the source Confirmed For Payment Flag). Grain: one row per work order (Property Maintenance header). Responds to Property and maintenance-attribute slicers but NOT the Date Table slicer. Caveat: the source Confirmed For Payment Flag is currently 0 for every row, so this measure returns blank against the present data - confirm the ETL populates the flag before relying on it.
	measure 'Maintenance Confirmed For Payment' = CALCULATE(COUNTROWS('Property Maintenance'), 'Property Maintenance'[Is Confirmed For Payment] = 1)
		formatString: #,0
		displayFolder: 05. Maintenance\Completion
		lineageTag: c51bc98a-16c6-4915-8c50-9a479073f7de

	/// Count of maintenance work orders that have been finalised and closed (Is Work Task Finalised = 1, from the source Finalised Work Task Flag). Grain: one row per work order (Property Maintenance header). Responds to Property and maintenance-attribute slicers but NOT the Date Table slicer (the Date Table is disconnected).
	measure 'Maintenance Finalised' = CALCULATE(COUNTROWS('Property Maintenance'), 'Property Maintenance'[Is Work Task Finalised] = 1)
		formatString: #,0
		displayFolder: 05. Maintenance\Completion
		lineageTag: 59203ebc-3775-4ed6-abb8-a101b2df3ff0

	/// Count of maintenance work orders flagged as tenant-caused damage (Property Maintenance rows where Is Tenant Damage = 1); grain is one row per Property Maintenance work order. Caveat: the model column Is Tenant Damage (source column Tenant Damage Flag) is uniformly zero in the currently loaded data, so this measure returns blank in every filter context and cannot be relied on until the flag is populated upstream. Some damage-related categories are instead partially captured in the Damage Type attribute (for example Damage Recoverable or Third Party Damage), but that field is populated on only a small minority of work orders and is not a like-for-like substitute for tenant-attributable damage. Structurally responds to Property and maintenance-attribute slicers but not the Date Table slicer.
	measure 'Maintenance - Tenant Damage' = CALCULATE(COUNTROWS('Property Maintenance'), 'Property Maintenance'[Is Tenant Damage] = 1)
		formatString: #,0
		displayFolder: 05. Maintenance
		lineageTag: 6a524217-9815-497f-80bb-d970e8511b49

	/// Count of maintenance work orders flagged as tenant-liable for repair costs (Is Tenant Liable = 1, from the source Tenant Liable Flag). Grain: one row per work order (Property Maintenance header). Responds to Property and maintenance-attribute slicers but NOT the Date Table slicer (the Date Table is disconnected).
	measure 'Maintenance - Tenant Liable' = CALCULATE(COUNTROWS('Property Maintenance'), 'Property Maintenance'[Is Tenant Liable] = 1)
		formatString: #,0
		displayFolder: 05. Maintenance
		lineageTag: d0611230-e345-425d-8b2a-2727bfccee98

	/// Count of maintenance work orders where repair costs have been charged back to tenants (Are Tenants Charged = 1, from the source Tenants Charged Flag). Grain: one row per work order (Property Maintenance header). Responds to Property and maintenance-attribute slicers but NOT the Date Table slicer. Caveat: the source Tenants Charged Flag is currently 0 for every row, so this measure returns blank against the present data - confirm the ETL populates the flag before relying on it.
	measure 'Maintenance - Tenants Charged' = CALCULATE(COUNTROWS('Property Maintenance'), 'Property Maintenance'[Are Tenants Charged] = 1)
		formatString: #,0
		displayFolder: 05. Maintenance
		lineageTag: c076268e-cffc-4718-abdd-fbd1b03ba0c2

	/// Count of maintenance work orders flagged as cancelled (Is Work Task Cancelled = 1, from the source Cancel Work Task Flag). Grain: one row per work order (Property Maintenance header). Responds to Property and maintenance-attribute slicers but NOT the Date Table slicer (the Date Table is disconnected).
	measure 'Cancelled Maintenance Work Orders' = CALCULATE(COUNTROWS('Property Maintenance'), 'Property Maintenance'[Is Work Task Cancelled] = 1)
		formatString: #,0
		displayFolder: 05. Maintenance
		lineageTag: 25db2915-a6a8-470f-8f4c-a4a7ea4f44ae

	/// Count of maintenance work orders currently flagged on hold (Is On Hold = 1, from the source On Hold Flag). Grain: one row per work order (Property Maintenance header). Snapshot of the present on-hold state; responds to Property and maintenance-attribute slicers but NOT the Date Table slicer (the Date Table is disconnected).
	measure 'On Hold Maintenance Work Orders' = CALCULATE(COUNTROWS('Property Maintenance'), 'Property Maintenance'[Is On Hold] = 1)
		formatString: #,0
		displayFolder: 05. Maintenance
		lineageTag: f60894d9-5018-493b-bb48-a1194a48de2b

	/// Count of all inspection records in Property Inspection, including cancelled ones. Grain = inspection records. Responds to Property/Tenancy context slicers; NOT date-aware (the Date Table is disconnected) - slice by an inspection date column to bound by period.
	measure 'Total Inspections' = COUNTROWS('Property Inspection')
		formatString: #,0
		displayFolder: 06. Inspections
		lineageTag: 4201f0ee-49da-45a0-b5b0-4fa80691079f

	/// Count of Property Inspection records with Status = "Completed" (one row per inspection, all-time). Does NOT respond to the Date Table slicer (the Date Table is disconnected); for a period view use the rolling companion Inspections Completed (12M). Also feeds Inspection Completion Rate %.
	measure 'Inspections Completed' = CALCULATE(COUNTROWS('Property Inspection'), 'Property Inspection'[Status] = "Completed")
		formatString: #,0
		displayFolder: 06. Inspections\By Status
		lineageTag: 9f794056-7473-467e-9789-731a5ee9d028

	/// Count of Property Inspection records that are still open, i.e. Status = "New" (one row per inspection, all-time). "New" is the system's pre-completion (open) status; the model contains no separate "Pending" or "Scheduled" status value, so the measure was renamed from "Inspections New/Pending" to "Inspections New" so the name matches exactly what the DAX counts. Does NOT respond to the Date Table slicer (the Date Table is disconnected).
	measure 'Inspections New' = CALCULATE(COUNTROWS('Property Inspection'), 'Property Inspection'[Status] = "New")
		formatString: #,0
		displayFolder: 06. Inspections\By Status
		lineageTag: d2b0de96-580c-4930-a798-be2327dd9d13

	/// Count of inspection records flagged with Cancel Inspection = 1, at inspection-record grain. This flag-based count differs from a count of Status = "Canceled": the two disagree in both directions - some records with Status = "Canceled" do not have the flag set, and some flagged records carry a different status (mostly Completed). Used as the exclusion term in Inspection Completion Rate %. Not date-aware - the Date Table is disconnected, so it responds to Property/Tenancy context but not the Date slicer, and limiting it to a reporting period relies on an inspection date column being in context.
	measure 'Inspections Cancelled' = CALCULATE(COUNTROWS('Property Inspection'), 'Property Inspection'[Cancel Inspection] = 1)
		formatString: #,0
		displayFolder: 06. Inspections\By Status
		lineageTag: decb59c4-8e21-4c2c-bf57-3badd98f4648

	/// Count of inspections whose Status shows a maintenance work task was raised ("Work Task Fully created" or "Work Task Partially created"); one row per inspection, not per work task (an inspection can spawn multiple tasks but is counted once). All-time total; does NOT respond to the Date Table slicer (the Date Table is disconnected).
	measure 'Inspections With Work Task Created' = CALCULATE(COUNTROWS('Property Inspection'), 'Property Inspection'[Status] IN {"Work Task Fully created", "Work Task Partially created"})
		formatString: #,0
		displayFolder: 06. Inspections\By Status
		lineageTag: 83fb49a5-2d2e-4bc6-978d-0c13236937f0

	/// Share of non-cancelled inspections that reached Status = "Completed", computed on a single consistent population: DIVIDE(count of non-cancelled Completed inspections [Status = "Completed" AND Cancel Inspection <> 1], Total Inspections - Inspections Cancelled), returning 0 when there are no non-cancelled inspections (all-time 86.5%). Numerator is a subset of the denominator's non-cancelled base, so the rate cannot exceed 100%. Grain = inspection records. Responds to Property/Tenancy context slicers (e.g. Program, Suburb) but is NOT date-aware - the Date Table is disconnected, so a Date slicer will not bound it; slice by an inspection date column to limit the period.
	measure 'Inspection Completion Rate %' = DIVIDE(CALCULATE(COUNTROWS('Property Inspection'), 'Property Inspection'[Status] = "Completed", 'Property Inspection'[Cancel Inspection] <> 1), [Total Inspections] - [Inspections Cancelled], 0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06. Inspections
		lineageTag: d0659727-3390-402d-bb74-d52f3e113cb7

	/// Count of Property Inspection records where Category = "Tenancy Routine Inspection" (the recurring routine tenancy-condition inspection cycle; Type is predominantly "Routine tenancy"). Grain = one row per inspection record and includes cancelled inspections (no Status or Cancel Inspection filter is applied), consistent with Total Inspections. Category is a three-value partition (Tenancy Routine Inspection, Tenancy Inspection Report, Property Condition Report), so the three '06. Inspections\By Category' measures are mutually exclusive and together sum to Total Inspections. Responds to Property and Tenancy slicers (Property filters flow through the Property Inspection -> Tenancy relationship); NOT date-aware — the Date Table is disconnected, so a Date slicer will not bound it. Slice by an inspection date column (e.g. Actual Inspection Date) to limit the period.
	measure 'Inspections - Routine' = CALCULATE(COUNTROWS('Property Inspection'), 'Property Inspection'[Category] = "Tenancy Routine Inspection")
		formatString: #,0
		displayFolder: 06. Inspections\By Category
		lineageTag: c664bdde-ef7a-4b60-b399-1ec4dbd79685

	/// Count of Property Inspection records where Category = "Tenancy Inspection Report" (move-in / move-out tenancy inspection reports; Type is predominantly "Ingoing tenancy" and "Outgoing tenancy"). Grain = one row per inspection record and includes cancelled inspections (no Status or Cancel Inspection filter is applied), consistent with Total Inspections. Category is a three-value partition (Tenancy Routine Inspection, Tenancy Inspection Report, Property Condition Report), so the three '06. Inspections\By Category' measures are mutually exclusive and together sum to Total Inspections. Responds to Property and Tenancy slicers (Property filters flow through the Property Inspection -> Tenancy relationship); NOT date-aware — the Date Table is disconnected, so a Date slicer will not bound it. Slice by an inspection date column (e.g. Actual Inspection Date) to limit the period.
	measure 'Inspections - Tenancy Report' = CALCULATE(COUNTROWS('Property Inspection'), 'Property Inspection'[Category] = "Tenancy Inspection Report")
		formatString: #,0
		displayFolder: 06. Inspections\By Category
		lineageTag: d015a63e-b78a-4f6d-af00-13c68e877ef0

	/// Count of Property Inspection records where Category = "Property Condition Report" (property condition reports; Type is predominantly residential, initial and final condition inspections). Grain = one row per inspection record and includes cancelled inspections (no Status or Cancel Inspection filter is applied), consistent with Total Inspections. Category is a three-value partition (Tenancy Routine Inspection, Tenancy Inspection Report, Property Condition Report), so the three '06. Inspections\By Category' measures are mutually exclusive and together sum to Total Inspections. Responds to Property and Tenancy slicers (Property filters flow through the Property Inspection -> Tenancy relationship); NOT date-aware — the Date Table is disconnected, so a Date slicer will not bound it. Slice by an inspection date column (e.g. Actual Inspection Date) to limit the period.
	measure 'Inspections - Property Condition' = CALCULATE(COUNTROWS('Property Inspection'), 'Property Inspection'[Category] = "Property Condition Report")
		formatString: #,0
		displayFolder: 06. Inspections\By Category
		lineageTag: 854c3264-2f7a-4858-b6ab-e91a542289e4

	/// Count of inspection records flagged Tenant Present = 1. Grain = inspection records. Responds to Property/Tenancy context slicers; NOT date-aware (the Date Table is disconnected) - use an inspection date column to bound by period.
	measure 'Inspections With Tenant Present' = CALCULATE(COUNTROWS('Property Inspection'), 'Property Inspection'[Tenant Present] = 1)
		formatString: #,0
		displayFolder: 06. Inspections
		lineageTag: 0b88c841-d538-446a-9836-fad40f2c5c43

	/// Total number of properties that have a Healthy Homes record (one row per property), regardless of compliance-field population. Current snapshot; does not respond to the Date slicer.
	measure 'HH - Total Records' = COUNTROWS('Healthy Homes')
		formatString: #,0
		displayFolder: 07. Healthy Homes
		lineageTag: 98bea43c-a3dd-4bbd-bac0-f7aa751a3976

	/// Count of Healthy Homes records where Has Ceiling Insulation = "Yes" (properties with ceiling insulation installed). One record per property. Responds to Property/Suburb/Program slicers; not date-aware. Reflects only properties with a Healthy Homes record. If a property can have more than one Healthy Homes record, use DISTINCTCOUNT('Healthy Homes'[Property ID]) instead.
	measure 'HH - Has Ceiling Insulation' = CALCULATE(COUNTROWS('Healthy Homes'), 'Healthy Homes'[Has Ceiling Insulation] = "Yes")
		formatString: #,0
		displayFolder: 07. Healthy Homes
		lineageTag: 79028c39-76fb-4ba6-9668-1d3c161f8bb2

	/// Count of Healthy Homes records where Has Ceiling Insulation = "Exempt" (properties exempt from the ceiling insulation requirement). One record per property. Responds to Property/Suburb/Program slicers; not date-aware. Reflects only properties with a Healthy Homes record — confirm disposed properties are excluded upstream. If a property can have more than one Healthy Homes record, use DISTINCTCOUNT('Healthy Homes'[Property ID]) instead.
	measure 'HH - Ceiling Insulation Exempt' = CALCULATE(COUNTROWS('Healthy Homes'), 'Healthy Homes'[Has Ceiling Insulation] = "Exempt")
		formatString: #,0
		displayFolder: 07. Healthy Homes
		lineageTag: c3732aec-880f-4430-ae5b-75cae8388b29

	/// Count of Healthy Homes records where Ceiling Insulation Meets Standard = 1 (properties whose ceiling insulation meets the Healthy Homes Standard). One record per property. Responds to Property/Suburb/Program slicers; not date-aware. Reflects only properties with a Healthy Homes record. If a property can have more than one Healthy Homes record, use DISTINCTCOUNT('Healthy Homes'[Property ID]) instead.
	measure 'HH - Ceiling Insulation Meets Standard' = CALCULATE(COUNTROWS('Healthy Homes'), 'Healthy Homes'[Ceiling Insulation Meets Standard] = 1)
		formatString: #,0
		displayFolder: 07. Healthy Homes
		lineageTag: 53dcedd1-1511-423d-b026-b0d05093850c

	/// Count of Healthy Homes records where Has Underfloor Insulation = "Yes" (properties with underfloor insulation installed). One record per property. Responds to Property/Suburb/Program slicers; not date-aware. Reflects only properties with a Healthy Homes record. If a property can have more than one Healthy Homes record, use DISTINCTCOUNT('Healthy Homes'[Property ID]) instead.
	measure 'HH - Has Underfloor Insulation' = CALCULATE(COUNTROWS('Healthy Homes'), 'Healthy Homes'[Has Underfloor Insulation] = "Yes")
		formatString: #,0
		displayFolder: 07. Healthy Homes
		lineageTag: 21c691be-025e-4deb-808a-c9141f2917eb

	/// Count of Healthy Homes records where wall insulation is present and in acceptable condition (Has Wall Insulation is Good or As new; the column has no 'Yes' value, so the earlier ='Yes' test returned blank). One record per property. Responds to Property/Suburb/Program slicers; not date-aware. Reflects only properties with a Healthy Homes record; if a property can have more than one, use DISTINCTCOUNT('Healthy Homes'[Property ID]).
	measure 'HH - Has Wall Insulation' = CALCULATE(COUNTROWS('Healthy Homes'), 'Healthy Homes'[Has Wall Insulation] IN {"Good", "As new"})
		formatString: #,0
		displayFolder: 07. Healthy Homes
		lineageTag: 30e2f10c-76d5-4f99-84d7-13e04da05fcd

	/// Current-state count of properties whose Has Bathroom Extractor Fan flag = "Yes" in the Healthy Homes register (one row per property). Excludes properties recorded "No" or blank. Snapshot - NOT responsive to the Date Table slicer; responds to Property-attribute slicers via the Property-Healthy Homes relationship. Caveat: no active-portfolio lifecycle filter, so it may include disposed stock if retained.
	measure 'HH - Properties with Bathroom Extractor Fan' = CALCULATE(COUNTROWS('Healthy Homes'), 'Healthy Homes'[Has Bathroom Extractor Fan] = "Yes")
		formatString: #,0
		displayFolder: 07. Healthy Homes
		lineageTag: 0fcf60de-6e73-404c-b067-7fbfcc310c9b

	/// Current-state count of properties whose Has Kitchen Extractor Fan flag = "Yes" in the Healthy Homes register (one row per property). Excludes properties recorded "No" or blank. Snapshot - NOT responsive to the Date Table slicer; responds to Property-attribute slicers via the Property-Healthy Homes relationship. Caveat: no active-portfolio lifecycle filter, so it may include disposed stock if retained.
	measure 'HH - Properties with Kitchen Extractor Fan' = CALCULATE(COUNTROWS('Healthy Homes'), 'Healthy Homes'[Has Kitchen Extractor Fan] = "Yes")
		formatString: #,0
		displayFolder: 07. Healthy Homes
		lineageTag: 553a62b2-3842-4706-8a24-8b80942eb84d

	/// Current-state count of properties whose Is Bathroom Ventilation Compliant flag = "Yes" in the Healthy Homes register (one row per property). Excludes properties recorded "No", blank, or exempt (see Bathroom Vent Exemption Reason). Snapshot - NOT responsive to the Date Table slicer; responds to Property-attribute slicers via the Property-Healthy Homes relationship. Caveat: no active-portfolio lifecycle filter, so it may include disposed stock if retained.
	measure 'HH - Properties with Compliant Bathroom Ventilation' = CALCULATE(COUNTROWS('Healthy Homes'), 'Healthy Homes'[Is Bathroom Ventilation Compliant] = "Yes")
		formatString: #,0
		displayFolder: 07. Healthy Homes
		lineageTag: 239f8368-fba2-4b53-b079-f61d6fea2b6c

	/// Current-state count of properties whose Is Kitchen Ventilation Compliant flag = "Yes" in the Healthy Homes register (one row per property). Excludes properties recorded "No", blank, or exempt (see Kitchen Vent Exemption Reason). Snapshot - NOT responsive to the Date Table slicer; responds to Property-attribute slicers via the Property-Healthy Homes relationship. Caveat: no active-portfolio lifecycle filter, so it may include disposed stock if retained.
	measure 'HH - Properties with Compliant Kitchen Ventilation' = CALCULATE(COUNTROWS('Healthy Homes'), 'Healthy Homes'[Is Kitchen Ventilation Compliant] = "Yes")
		formatString: #,0
		displayFolder: 07. Healthy Homes
		lineageTag: 18bdb6ea-19fd-4653-abc0-5dc36b216f61

	/// Current-state count of properties whose Is Property Draught-Free flag = "Yes" in the Healthy Homes register (one row per property) - i.e. free of unreasonable gaps under the Healthy Homes draught-stopping standard. Excludes properties recorded "No" or blank. Snapshot - NOT responsive to the Date Table slicer; responds to Property-attribute slicers (Program, Service, Suburb, etc.) via the Property-Healthy Homes relationship. Caveat: no active-portfolio lifecycle filter, so it may include disposed stock if retained.
	measure 'HH - Draught-Free Properties' = CALCULATE(COUNTROWS('Healthy Homes'), 'Healthy Homes'[Is Property Draught-Free] = "Yes")
		formatString: #,0
		displayFolder: 07. Healthy Homes\Draught Stopping
		lineageTag: b15dbcd2-4159-44d8-bea9-5c4c4d311368

	/// Current-state count of properties whose Has Subfloor Moisture Barrier flag = "Yes" in the Healthy Homes register (one row per property). Excludes properties recorded "No", blank, or exempt (see Is Exempt From Moisture Barrier). Snapshot - NOT responsive to the Date Table slicer; responds to Property-attribute slicers via the Property-Healthy Homes relationship. Caveat: no active-portfolio lifecycle filter, so it may include disposed stock if retained in the register.
	measure 'HH - Properties with Subfloor Moisture Barrier' = CALCULATE(COUNTROWS('Healthy Homes'), 'Healthy Homes'[Has Subfloor Moisture Barrier] = "Yes")
		formatString: #,0
		displayFolder: 07. Healthy Homes
		lineageTag: 2dd4a024-ebf6-46aa-821e-4425f5e71645

	/// Current-state count of properties whose Has Adequate Guttering flag = "Yes" in the Healthy Homes register (one row per property). Excludes properties recorded "No", blank, or exempt. Snapshot of the register - NOT responsive to the Date Table slicer; it does respond to Property-attribute slicers (Program, Service, Suburb, etc.) via the Property-Healthy Homes relationship. Caveat: no active-portfolio lifecycle filter, so it reflects whatever properties exist in the register (may include disposed stock if such rows are retained).
	measure 'HH - Properties with Adequate Guttering' = CALCULATE(COUNTROWS('Healthy Homes'), 'Healthy Homes'[Has Adequate Guttering] = "Yes")
		formatString: #,0
		displayFolder: 07. Healthy Homes
		lineageTag: 0b0ac86d-a3e6-4816-b32c-c1cefde3c3bb

	/// Average primary heat source capacity in kilowatts across Healthy Homes records (one record per property). AVERAGE ignores blanks, so this is the mean only for properties with a recorded main-heat-source capacity and can mislead where Healthy Homes data is incomplete (only a minority of registered properties have a value). Responds to Property/Suburb/Program slicers via the Property-Healthy Homes relationship; not date-aware (does not respond to the Date slicer).
	measure 'HH - Avg Main Heat Source (kW)' = AVERAGE('Healthy Homes'[Main Heat Source Capacity (kW)])
		formatString: #,0.0
		displayFolder: 07. Healthy Homes\Heating
		lineageTag: 676ecf70-683f-4bea-984b-f91facb14d94

	/// Average required living-area heating capacity in kilowatts - the calculated minimum needed to heat the main living area to 18C - across Healthy Homes records (one record per property). AVERAGE ignores blanks, so this is the mean only for properties with a recorded requirement and can mislead where Healthy Homes data is incomplete. Compare with HH - Avg Main Heat Source (kW) to gauge heating adequacy. Responds to Property/Suburb/Program slicers; not date-aware (does not respond to the Date slicer).
	measure 'HH - Avg Required Heating (kW)' = AVERAGE('Healthy Homes'[Required Living Area Heating (kW)])
		formatString: #,0.0
		displayFolder: 07. Healthy Homes\Heating
		lineageTag: 8e345494-4920-4be6-9fdc-55a3edb4a111

	/// Average ceiling insulation R-Value across Healthy Homes records (one record per property). AVERAGE ignores blanks, so this is the mean only for properties with a recorded ceiling R-value and can mislead where Healthy Homes data is incomplete. Responds to Property/Suburb/Program slicers; not date-aware (does not respond to the Date slicer).
	measure 'HH - Avg Ceiling R-Value' = AVERAGE('Healthy Homes'[Ceiling Insulation R-Value])
		formatString: #,0.00
		displayFolder: 07. Healthy Homes
		lineageTag: 8c2f4339-c5eb-49f4-b25a-f4febda6a598

	/// Average underfloor insulation R-Value across Healthy Homes records (one record per property). AVERAGE ignores blanks, so this is the mean only for properties with a recorded underfloor R-value and can mislead where Healthy Homes data is incomplete. Responds to Property/Suburb/Program slicers; not date-aware (does not respond to the Date slicer).
	measure 'HH - Avg Underfloor R-Value' = AVERAGE('Healthy Homes'[Underfloor Insulation R-Value])
		formatString: #,0.00
		displayFolder: 07. Healthy Homes
		lineageTag: 01c7789d-3c35-4f5e-8abc-aed8eb00625b

	/// Current-state count of properties flagged as generally exempt from the Healthy Homes Standards (Is Generally Exempt = 1) in the Healthy Homes register (one row per property). Snapshot - NOT responsive to the Date Table slicer; responds to Property-attribute slicers (Program, Service, Suburb, etc.) via the Property-Healthy Homes relationship. Caveat: no active-portfolio lifecycle filter, so it may include disposed stock if retained. Data note: in the current register the flag holds only 0 or blank (no row carries value 1), so the measure returns blank.
	measure 'HH - Generally Exempt' = CALCULATE(COUNTROWS('Healthy Homes'), 'Healthy Homes'[Is Generally Exempt] = 1)
		formatString: #,0
		displayFolder: 07. Healthy Homes
		lineageTag: 9bb5b076-bd85-4500-ba73-0ccf32a84735

	/// Current-state count of properties in the Healthy Homes register (one row per property) that have a recorded Healthy Homes Compliance Date; a non-blank compliance date is the proxy for HH certification. Excludes properties with a blank compliance date. Snapshot - NOT responsive to the Date Table slicer; responds to Property-attribute slicers via the Property-Healthy Homes relationship. Caveat: no active-portfolio lifecycle filter, so it may include disposed stock if retained. See HH - Newly Compliant (12M) for the date-aware, rolling-window companion.
	measure 'HH - With Compliance Date' = CALCULATE(COUNTROWS('Healthy Homes'), NOT(ISBLANK('Healthy Homes'[Healthy Homes Compliance Date])))
		formatString: #,0
		displayFolder: 07. Healthy Homes
		lineageTag: b615892c-f264-49af-80e1-749f882ee2c8

	/// Among non-exempt properties (Is Generally Exempt <> 1), the share that have a recorded Healthy Homes Compliance Date = [non-exempt with date] / [non-exempt total] via DIVIDE (returns 0 when there are no non-exempt properties). Compliance is proxied by the presence of that date. Current snapshot at the property/Healthy Homes grain (one row per property); NOT responsive to the Date Table slicer; responds to Property-attribute slicers via the Property-Healthy Homes relationship. Caveat: in the current register no property carries the general-exemption flag, so the denominator effectively equals all registered properties and the exemption exclusion is presently a no-op.
	measure 'HH - Compliance Rate %' =
			VAR _NonExemptWithDate =
			    CALCULATE(
			        COUNTROWS('Healthy Homes'),
			        NOT ( ISBLANK('Healthy Homes'[Healthy Homes Compliance Date]) ),
			        'Healthy Homes'[Is Generally Exempt] <> 1
			    )
			VAR _NonExemptTotal =
			    CALCULATE(
			        COUNTROWS('Healthy Homes'),
			        'Healthy Homes'[Is Generally Exempt] <> 1
			    )
			RETURN
			    DIVIDE(_NonExemptWithDate, _NonExemptTotal, 0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 07. Healthy Homes
		lineageTag: c35438cc-bb6f-4b51-80f1-73d34af97bb8

	/// Total count of all void-checklist records across every Void Category and status. Not date-aware — ignores the Date Table slicer; responds to Property-based slicers (Suburb, Program, Service) via Void Checklist -> Property. Categories span new-property onboarding (NEW*), routine turnovers (ROUT/ROTH plus asterisk variants ROU*/ROT*), return-to-landlord (RTLL), provisional voids (PROV — the 2nd-largest group), damage (MIND/MAJD), insurance (INSR), planned improvement (PIMP), management (MNGT) and natural disaster (NATD). One row per void checklist.
	measure 'Total Voids' = COUNTROWS('Void Checklist')
		formatString: #,0
		displayFolder: 08. Void Management
		lineageTag: 1bbbab16-7d95-4519-960f-8622ea0c9519

	/// Current count of OPEN voids — void-checklist records with no Void Completed Date (still in the void workflow, property not yet available for tenancy). Point-in-time/backlog measure: it reflects the CURRENT data state and does NOT respond to the Date slicer. Responds to Property-based slicers (Suburb, Program, Service) via Void Checklist -> Property. For period-scoped void activity a separate date-aware measure would be required.
	measure 'Active Voids' =
			CALCULATE(
			    COUNTROWS('Void Checklist'),
			    ISBLANK('Void Checklist'[Void Completed Date])
			)
		formatString: #,0
		displayFolder: 08. Void Management
		lineageTag: 7b9d0738-4f79-4ccf-8e3a-1c02ff1015ba

	/// Count of void-checklist records that have a Void Completed Date (workflow finished, property status updated). This is an ALL-TIME cumulative count — it does NOT respond to the Date slicer, so filtering to a period will NOT scope it to voids completed in that period. Responds to Property-based slicers via Void Checklist -> Property. For "voids completed in the selected period", build a separate date-aware measure keyed on Void Completed Date.
	measure 'Completed Voids' =
			CALCULATE(
			    COUNTROWS('Void Checklist'),
			    NOT(ISBLANK('Void Checklist'[Void Completed Date]))
			)
		formatString: #,0
		displayFolder: 08. Void Management
		lineageTag: b701efaa-b15b-40a4-b274-95db453ef020

	/// Share of all voids that are completed = [Completed Voids] / [Total Voids] (all-time, returns 0 when there are no voids). Not date-aware — ignores the Date slicer; responds to Property-based slicers. Read as overall workflow throughput, not period throughput.
	measure 'Void Completion Rate %' =
			DIVIDE(
			    [Completed Voids],
			    [Total Voids],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 08. Void Management
		lineageTag: 4301be6f-8c85-4229-9f8e-8f23b7b983b4

	/// Count of void-checklist records whose Void Category starts with "NEW" (new-property onboarding, e.g. NEWC/NEWR/NEWS/NEWT/NEWP). This is a NEW* prefix match, so any future NEW-prefixed category is included automatically. Note NEWT (new transitional) is ALSO counted in [Voids - Transitional Housing], so the category measures overlap and do not sum to [Total Voids]. Not date-aware — responds to Property-based slicers only.
	measure 'Voids - New Property' =
			CALCULATE(
			    COUNTROWS('Void Checklist'),
			    LEFT('Void Checklist'[Void Category], 3) = "NEW"
			)
		formatString: #,0
		displayFolder: 08. Void Management\By Category
		lineageTag: 171aaf3b-93ab-4bab-97a2-16cbd06270e9

	/// Count of routine turnover void checklist records - Void Category ROUT, ROTH, ROU* or ROT* (the standard and transitional-housing turnover codes, including their asterisked variants). Grain is one row per void checklist, not distinct properties, so a property with two turnover voids counts twice. Responds to Property/Program and Void Checklist filters; not date-aware, so it ignores the Date Table slicer.
	measure 'Turnover Void Count' =
			CALCULATE(
			    COUNTROWS('Void Checklist'),
			    'Void Checklist'[Void Category] IN {"ROUT", "ROTH", "ROU*", "ROT*"}
			)
		formatString: #,##0
		displayFolder: 08. Void Management\By Category
		lineageTag: 96331a16-badc-4d0f-a9d8-acf28ccbc89e

	/// Count of Return-To-Landlord voids (Void Category = "RTLL") — properties handed back to the owner and removed from the portfolio. Not date-aware — ignores the Date slicer; responds to Property-based slicers (Suburb, Program, Service) via Void Checklist -> Property.
	measure 'Voids - Return to Landlord' =
			CALCULATE(
			    COUNTROWS('Void Checklist'),
			    'Void Checklist'[Void Category] = "RTLL"
			)
		formatString: #,0
		displayFolder: 08. Void Management\By Category
		lineageTag: e58a5f16-84ab-4b05-b810-a9465eea6c7e

	/// Count of transitional-housing voids - Void Category NEWT (new transitional), ROTH (transitional turnover) or ROT* (an asterisked transitional-turnover variant), at one-row-per-void-checklist grain. These categories overlap other cuts (NEWT also appears in new-property voids and ROTH is a routine turnover), so the By-Category measures are non-exclusive and do not sum to Total Voids. Not date-aware - ignores the Date Table slicer; responds to Property-based slicers only.
	measure 'Voids - Transitional Housing' =
			CALCULATE(
			    COUNTROWS('Void Checklist'),
			    'Void Checklist'[Void Category] IN {"NEWT", "ROTH", "ROT*"}
			)
		formatString: #,0
		displayFolder: 08. Void Management\By Category
		lineageTag: 2075d823-bdbf-4853-abb0-1523a4984187

	/// Average void turnaround in days across completed voids only (Void Completed Date present), computed as DATEDIFF(Created On, Void Completed Date) at one-row-per-void-checklist grain. Excludes reversed rows where the Void Completed Date falls before Created On (a data-quality issue affecting a minority of completed voids), so those negative durations are not averaged in and the figure is higher than an unguarded average would be. Not date-aware - ignores the Date Table slicer; responds to Property-based slicers via Void Checklist to Property. Lower is better.
	measure 'Avg Void Duration Days' =
			AVERAGEX(
			    FILTER(
			        'Void Checklist',
			        NOT(ISBLANK('Void Checklist'[Void Completed Date]))
			            && 'Void Checklist'[Void Completed Date] >= 'Void Checklist'[Created On]
			    ),
			    DATEDIFF(
			        'Void Checklist'[Created On],
			        'Void Checklist'[Void Completed Date],
			        DAY
			    )
			)
		formatString: 0.0
		displayFolder: 08. Void Management\Duration KPIs
		lineageTag: 71fe0834-0844-4d42-b21a-c79653a68ced

	/// Average days from receiving keys from the vacating tenant (Date KEY Received From Tenant) to the property being made ready (Property Is Ready - Convert To Vacant: Tenantable), computed as DATEDIFF in days at one-row-per-void-checklist grain across records that have both dates populated (any Void Category, not only turnovers). Excludes rows where the ready date falls before the key date, so those negative durations are not averaged in. Not date-aware - ignores the Date Table slicer; responds to Property-based slicers. Lower is better.
	measure 'Avg Days Key to Tenantable' =
			AVERAGEX(
			    FILTER(
			        'Void Checklist',
			        NOT(ISBLANK('Void Checklist'[Date KEY Received From Tenant]))
			            && NOT(ISBLANK('Void Checklist'[Property Is Ready - Convert To Vacant: Tenantable]))
			            && 'Void Checklist'[Property Is Ready - Convert To Vacant: Tenantable] >= 'Void Checklist'[Date KEY Received From Tenant]
			    ),
			    DATEDIFF(
			        'Void Checklist'[Date KEY Received From Tenant],
			        'Void Checklist'[Property Is Ready - Convert To Vacant: Tenantable],
			        DAY
			    )
			)
		formatString: 0.0
		displayFolder: 08. Void Management\Duration KPIs
		lineageTag: 5806ed10-e72e-43c1-b667-acd1ea51fb5e

	/// Sum of void durations in days across completed voids only (Void Completed Date present), each computed as DATEDIFF(Created On, Void Completed Date) at one-row-per-void-checklist grain. Excludes reversed rows where the Void Completed Date falls before Created On, so those negative day-counts are not netted off and the total is higher than an unguarded sum would be. Not date-aware - ignores the Date Table slicer; responds to Property-based slicers via Void Checklist to Property.
	measure 'Total Void Days' =
			SUMX(
			    FILTER(
			        'Void Checklist',
			        NOT(ISBLANK('Void Checklist'[Void Completed Date]))
			            && 'Void Checklist'[Void Completed Date] >= 'Void Checklist'[Created On]
			    ),
			    DATEDIFF(
			        'Void Checklist'[Created On],
			        'Void Checklist'[Void Completed Date],
			        DAY
			    )
			)
		formatString: #,##0
		displayFolder: 08. Void Management\Duration KPIs
		lineageTag: 37c38315-d317-4365-8f9b-02f8bd50ea5a

	/// (Current) Average age in days of currently open voids: TODAY() minus 'Created On', averaged across Void Checklist rows whose 'Void Completed Date' is blank. Grain: one row per void checklist (a property voided more than once counts per void), not distinct properties. Snapshot as at today — uses TODAY() and ignores the Date Table slicer; responds to Property/Program/Region slicers. No void-category exclusions applied. Caveat: long-abandoned checklists never marked complete (some open since 2022) are counted and inflate the average; higher values indicate voids lingering in the workflow.
	measure 'Current Void Age Days' =
			AVERAGEX(
			    FILTER(
			        'Void Checklist',
			        ISBLANK('Void Checklist'[Void Completed Date])
			    ),
			    DATEDIFF(
			        'Void Checklist'[Created On],
			        TODAY(),
			        DAY
			    )
			)
		formatString: 0.0
		displayFolder: 08. Void Management\Duration KPIs
		lineageTag: bad5c0aa-c09f-4c05-84b0-cf6446333666

	/// Count of completed voids (both 'Void Completed Date' and 'Target Completion Date - Void' present) that finished on or before their void target date ('Void Completed Date' <= 'Target Completion Date - Void'). Grain: one row per void checklist. Not date-aware — the Void Checklist dates are not linked to the Date Table, so this ignores the Date Table slicer and counts all matching voids in the current filter context; responds to Property/Program/Region slicers. With [Voids Over Target] forms the denominator of [Void Target Met %].
	measure 'Voids On Target' =
			CALCULATE(
			    COUNTROWS('Void Checklist'),
			    NOT(ISBLANK('Void Checklist'[Void Completed Date])),
			    NOT(ISBLANK('Void Checklist'[Target Completion Date - Void])),
			    'Void Checklist'[Void Completed Date] <= 'Void Checklist'[Target Completion Date - Void]
			)
		formatString: #,0
		displayFolder: 08. Void Management\Target Performance
		lineageTag: cd3003f8-56ea-43ea-aa9a-6fe4d851628c

	/// Count of completed voids (both 'Void Completed Date' and 'Target Completion Date - Void' present) that finished after their void target date ('Void Completed Date' > 'Target Completion Date - Void'). Grain: one row per void checklist. Not date-aware — ignores the Date Table slicer (Void Checklist dates are not linked to the Date Table); responds to Property/Program/Region slicers. Together with [Voids On Target] forms the denominator of [Void Target Met %].
	measure 'Voids Over Target' =
			CALCULATE(
			    COUNTROWS('Void Checklist'),
			    NOT(ISBLANK('Void Checklist'[Void Completed Date])),
			    NOT(ISBLANK('Void Checklist'[Target Completion Date - Void])),
			    'Void Checklist'[Void Completed Date] > 'Void Checklist'[Target Completion Date - Void]
			)
		formatString: #,0
		displayFolder: 08. Void Management\Target Performance
		lineageTag: 0a9f73e6-a8fa-414b-b9aa-047989b19f63

	/// Percentage of completed voids (that have a void target date) which finished on or before target = [Voids On Target] / ([Voids On Target] + [Voids Over Target]). Excludes voids not yet completed or with no target. Not date-aware.
	measure 'Void Target Met %' =
			DIVIDE(
			    [Voids On Target],
			    [Voids On Target] + [Voids Over Target],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 08. Void Management\Target Performance
		lineageTag: 2189ea99-e1b2-4295-9656-feec561c8862

	/// Average number of days by which over-target voids overshot their void target date — DATEDIFF('Target Completion Date - Void', 'Void Completed Date') averaged over completed voids where 'Void Completed Date' > 'Target Completion Date - Void'. Grain: one row per void checklist; units: days. Excludes on-time voids and not-yet-completed voids. Not date-aware — ignores the Date Table slicer; responds to Property/Program/Region slicers. Pairs with [Voids Over Target] (same population).
	measure 'Avg Days Over Target' =
			AVERAGEX(
			    FILTER(
			        'Void Checklist',
			        NOT(ISBLANK('Void Checklist'[Void Completed Date]))
			            && NOT(ISBLANK('Void Checklist'[Target Completion Date - Void]))
			            && 'Void Checklist'[Void Completed Date] > 'Void Checklist'[Target Completion Date - Void]
			    ),
			    DATEDIFF(
			        'Void Checklist'[Target Completion Date - Void],
			        'Void Checklist'[Void Completed Date],
			        DAY
			    )
			)
		formatString: 0.0
		displayFolder: 08. Void Management\Target Performance
		lineageTag: b40ae60b-479e-47fe-b0c8-09330c792010

	/// Current count of open voids (Void Completed Date is blank) that have not yet reached the 'Assessment And Scoping' milestone (that date is blank) — the earliest workflow stage. Grain: one row per Void Checklist (a property voided more than once is counted per void). Current-state snapshot: does NOT respond to the Date Table slicer; responds to Property-level slicers (Program, Service, Region) via the Void Checklist → Property relationship.
	measure 'Voids Awaiting Assessment (Current)' =
			CALCULATE(
			    COUNTROWS('Void Checklist'),
			    ISBLANK('Void Checklist'[Void Completed Date]),
			    ISBLANK('Void Checklist'[Assessment And Scoping])
			)
		formatString: #,##0
		displayFolder: 08. Void Management\Workflow Stage
		lineageTag: 45835ac9-7081-47c2-b3ab-3fd06d44b22a

	/// Current count of open voids (Void Completed Date is blank) that have been assessed (Assessment And Scoping populated) but where Repairs Completed is still blank — the repair/refurbishment phase. Grain: one row per Void Checklist (per void, not per distinct property). Current-state snapshot: does NOT respond to the Date Table slicer; responds to Property-level slicers (Program, Service, Region) via the Void Checklist → Property relationship.
	measure 'Voids Awaiting Repairs (Current)' =
			CALCULATE(
			    COUNTROWS('Void Checklist'),
			    ISBLANK('Void Checklist'[Void Completed Date]),
			    NOT(ISBLANK('Void Checklist'[Assessment And Scoping])),
			    ISBLANK('Void Checklist'[Repairs Completed])
			)
		formatString: #,##0
		displayFolder: 08. Void Management\Workflow Stage
		lineageTag: ef3014d8-53b6-4d4f-8169-8a499c8046ca

	/// Count of active voids (Void Completed Date is blank) where the property has reached the 'Convert to Vacant: Tenantable' ready milestone but no tenant offer has yet been accepted - i.e. ready to allocate. Grain: one row per Void Checklist. Current-state snapshot: does NOT respond to the Date Table slicer (ignores any selected period); responds to Property-level slicers (Program, Service, Region).
	measure 'Voids Ready for Allocation (Current)' =
			CALCULATE(
			    COUNTROWS('Void Checklist'),
			    ISBLANK('Void Checklist'[Void Completed Date]),
			    NOT(ISBLANK('Void Checklist'[Property Is Ready - Convert To Vacant: Tenantable])),
			    ISBLANK('Void Checklist'[Date Offer Confirmed Accepted])
			)
		formatString: #,0
		displayFolder: 08. Void Management\Workflow Stage
		lineageTag: 3702ba41-c2c0-4e1e-94e9-1d1a5e65d935

	/// Current count of OPEN voids (no Void Completed Date) that have reached the move-in stage - a tenant offer has been confirmed accepted (Date Offer Confirmed Accepted) OR a lease/agreement has been received (Signed Lease Or Agreement Received). The two milestones are effectively mutually exclusive in the current data, so this is an OR (an AND matched zero voids). Point-in-time/backlog measure: reflects the current data state and does NOT respond to the Date slicer; responds to Property-based slicers via Void Checklist -> Property.
	measure 'Voids Awaiting Move-In (Current)' =
			CALCULATE(
			    COUNTROWS('Void Checklist'),
			    FILTER(
			        'Void Checklist',
			        ISBLANK('Void Checklist'[Void Completed Date])
			            && (NOT(ISBLANK('Void Checklist'[Date Offer Confirmed Accepted]))
			                || NOT(ISBLANK('Void Checklist'[Signed Lease Or Agreement Received])))
			    )
			)
		formatString: #,##0
		displayFolder: 08. Void Management\Workflow Stage
		lineageTag: 8d30ca60-eb97-4153-8f96-61b1e0f7f497

	/// Counts Void Checklist records where 'Date Of Pre-Vacate Inspection' is recorded (inspection conducted before the tenant moves out). Grain: void events, not distinct properties. Responds to Property-attribute slicers (Program, Service, Suburb) via the Property relationship. NOT date-aware: does not respond to the Date slicer; counts all voids in the current filter context.
	measure 'Pre-Vacate Inspections Done' =
			CALCULATE(
			    COUNTROWS('Void Checklist'),
			    NOT(ISBLANK('Void Checklist'[Date Of Pre-Vacate Inspection]))
			)
		formatString: #,##0
		displayFolder: 08. Void Management\Milestones
		lineageTag: 15000f21-680a-4767-ac31-76f9948e0ab8

	/// Counts Void Checklist records where 'Date Of Final Inspection' is recorded (final inspection completed after keys received; confirms post-vacancy condition). Grain: void events, not distinct properties. Responds to Property-attribute slicers (Program, Service, Suburb) via the Property relationship. NOT date-aware: does not respond to the Date slicer; counts all voids in the current filter context.
	measure 'Final Inspections Done' =
			CALCULATE(
			    COUNTROWS('Void Checklist'),
			    NOT(ISBLANK('Void Checklist'[Date Of Final Inspection]))
			)
		formatString: #,##0
		displayFolder: 08. Void Management\Milestones
		lineageTag: 2455423b-545e-440b-b685-9d32688d5660

	/// Count of Void Checklist records where the 'Safety Check Completed' milestone date is populated (safety compliance check done). Grain: void events, not distinct properties — a property voided more than once is counted per void. Cumulative within the current filter context (all voids, open and completed). Responds to Property-attribute slicers (Program, Service, Region) via the Property relationship but NOT the Date Table slicer (Void Checklist milestone dates are not linked to the Date Table).
	measure 'Safety Checks Completed' =
			CALCULATE(
			    COUNTROWS('Void Checklist'),
			    NOT(ISBLANK('Void Checklist'[Safety Check Completed]))
			)
		formatString: #,0
		displayFolder: 08. Void Management\Milestones
		lineageTag: f9d01c4c-066b-40fc-89e2-d0b20095fd32

	/// Counts Void Checklist records where 'Property Is Ready - Convert To Vacant: Tenantable' is recorded (property returned to Vacant:Tenantable, ready for a new tenant). Grain is void events (checklist rows), NOT distinct properties - a property voided more than once is counted per void. Responds to Property-attribute slicers (Program, Service, Suburb) via the Property relationship. NOT date-aware: does not respond to the Date slicer; counts all voids in the current filter context.
	measure 'Voids Made Tenantable' =
			CALCULATE(
			    COUNTROWS('Void Checklist'),
			    NOT(ISBLANK('Void Checklist'[Property Is Ready - Convert To Vacant: Tenantable]))
			)
		formatString: #,##0
		displayFolder: 08. Void Management\Milestones
		lineageTag: 0529830f-1949-417b-a355-b1b7b52cf33f

	/// Average days from assessment to repairs completion — DATEDIFF('Assessment And Scoping', 'Repairs Completed') averaged over Void Checklist rows where both dates are present. Grain: one row per void checklist; units: days. Not date-aware — ignores the Date Table slicer (Void Checklist dates are not linked to the Date Table); responds to Property/Program/Region slicers. DATA CAVEAT: currently returns BLANK in all contexts — 'Repairs Completed' is populated in only ~4 of ~11,581 checklist rows and never co-occurs with a populated 'Assessment And Scoping', so no rows qualify. This KPI is non-functional until the 'Repairs Completed' milestone is captured upstream (Waharoa), or the repair phase is redefined against a populated milestone (a business decision).
	measure 'Avg Days Assessment to Repairs' =
			AVERAGEX(
			    FILTER(
			        'Void Checklist',
			        NOT(ISBLANK('Void Checklist'[Assessment And Scoping]))
			            && NOT(ISBLANK('Void Checklist'[Repairs Completed]))
			    ),
			    DATEDIFF(
			        'Void Checklist'[Assessment And Scoping],
			        'Void Checklist'[Repairs Completed],
			        DAY
			    )
			)
		formatString: 0.0
		displayFolder: 08. Void Management\Duration KPIs
		lineageTag: 3349d0c9-1d57-4f38-9138-21a5a161e713

	/// Average days from a property being made ready (Property Is Ready - Convert To Vacant: Tenantable) to the tenant offer being accepted (Date Offer Confirmed Accepted), averaged over Void Checklist rows where both dates are present, at one-row-per-void-checklist grain; units are days. Each row's gap is floored at zero, so the small number of rows where the offer is recorded before the ready date contribute 0 rather than a negative value, which lifts the mean slightly above an unfloored average. Not date-aware - ignores the Date Table slicer; responds to Property/Program/Region slicers. Lower is better.
	measure 'Avg Days Ready to Offer Accepted' = AVERAGEX(FILTER('Void Checklist', NOT(ISBLANK('Void Checklist'[Property Is Ready - Convert To Vacant: Tenantable])) && NOT(ISBLANK('Void Checklist'[Date Offer Confirmed Accepted]))), MAX(0, DATEDIFF('Void Checklist'[Property Is Ready - Convert To Vacant: Tenantable], 'Void Checklist'[Date Offer Confirmed Accepted], DAY)))
		formatString: 0.0
		displayFolder: 08. Void Management\Duration KPIs
		lineageTag: 69f5edd2-1888-4156-a0a0-712c77f63bef

	/// Counts Void Checklist records (one row per void/turnaround) where 'BOS Updated (Vacancy Listed)' is recorded - the property vacancy has been listed in BOS for allocation. Grain: void events, not distinct properties. Responds to Property-attribute slicers (Program, Service, Suburb) via the Property relationship. NOT date-aware: milestone dates are not linked to the Date Table, so this does not respond to the Date slicer - it counts all voids in the current filter context.
	measure 'BOS Listings Completed' =
			CALCULATE(
			    COUNTROWS('Void Checklist'),
			    NOT(ISBLANK('Void Checklist'[BOS Updated (Vacancy Listed)]))
			)
		formatString: #,##0
		displayFolder: 08. Void Management\Milestones
		lineageTag: d1238c5a-8559-448c-8c3e-c0fa176bdf0a

	/// Count of Void Checklist records where a tenant offer has been confirmed and accepted ('Date Offer Confirmed Accepted' is populated). Grain: void events, not distinct properties — a property voided more than once is counted per void. Cumulative within the current filter context (all voids, open and completed). Responds to Property-attribute slicers (Program, Service, Region) via the Property relationship but NOT the Date Table slicer.
	measure 'Tenant Offers Accepted' =
			CALCULATE(
			    COUNTROWS('Void Checklist'),
			    NOT(ISBLANK('Void Checklist'[Date Offer Confirmed Accepted]))
			)
		formatString: #,0
		displayFolder: 08. Void Management\Milestones
		lineageTag: ea86ec42-c3f7-4e52-a8cd-e6a50dfea5f2

	/// Count of new voids created in the current month. Indicates incoming void volume. Fixed to the current calendar month via TODAY() — does NOT respond to the Date Table slicer. Responds to Property/Program filters.
	measure 'Voids Created This Month' =
			CALCULATE(
			    COUNTROWS('Void Checklist'),
			    MONTH('Void Checklist'[Created On]) = MONTH(TODAY()),
			    YEAR('Void Checklist'[Created On]) = YEAR(TODAY())
			)
		formatString: #,##0
		displayFolder: 08. Void Management\Trends
		lineageTag: 7582b88a-d9c0-44b3-9bf9-48d225f13282

	/// Count of voids completed in the current month. Indicates outgoing void volume and throughput. Fixed to the current calendar month via TODAY() — does NOT respond to the Date Table slicer (changing a date slicer will not change this value). Responds to Property/Program filters.
	measure 'Voids Completed This Month' =
			CALCULATE(
			    COUNTROWS('Void Checklist'),
			    MONTH('Void Checklist'[Void Completed Date]) = MONTH(TODAY()),
			    YEAR('Void Checklist'[Void Completed Date]) = YEAR(TODAY())
			)
		formatString: #,##0
		displayFolder: 08. Void Management\Trends
		lineageTag: 540ff07c-a687-481e-9aaf-02244b6945b9

	/// (Current) Count of open voids (blank 'Void Completed Date', with a 'Target Completion Date - Void') whose void target date has already passed as at today ('Target Completion Date - Void' < TODAY()). Grain: one row per void checklist. Point-in-time snapshot using TODAY() — ignores the Date Table slicer and changes daily; responds to Property/Program/Region slicers. Mutually exclusive with [Voids At Risk (Current)] (target still in the future). Flags voids needing immediate attention.
	measure 'Voids Overdue (Current)' =
			CALCULATE(
			    COUNTROWS('Void Checklist'),
			    ISBLANK('Void Checklist'[Void Completed Date]),
			    NOT(ISBLANK('Void Checklist'[Target Completion Date - Void])),
			    'Void Checklist'[Target Completion Date - Void] < TODAY()
			)
		formatString: #,##0
		displayFolder: 08. Void Management\Target Performance
		lineageTag: faa7594d-910d-407b-8a8d-3a1d6ef5d141

	/// (Current) Count of active voids (blank 'Void Completed Date', with a 'Target Completion Date - Void') whose void target date falls within the next 7 days (TODAY() <= 'Target Completion Date - Void' <= TODAY() + 7, inclusive). Grain: one row per void checklist. Live snapshot using TODAY() — ignores the Date Table slicer and changes daily; responds to Property/Program/Region slicers. Mutually exclusive with [Voids Overdue (Current)] (already-passed targets).
	measure 'Voids At Risk (Current)' =
			CALCULATE(
			    COUNTROWS('Void Checklist'),
			    ISBLANK('Void Checklist'[Void Completed Date]),
			    NOT(ISBLANK('Void Checklist'[Target Completion Date - Void])),
			    'Void Checklist'[Target Completion Date - Void] >= TODAY(),
			    'Void Checklist'[Target Completion Date - Void] <= TODAY() + 7
			)
		formatString: #,0
		displayFolder: 08. Void Management\Target Performance
		lineageTag: d07a9649-1a32-458a-8588-1a7acf89e03d

	/// Counts Void Checklist records where 'Bond Recovery Forms Completed' is recorded (bond claim/return processed). Grain: void events, not distinct properties. Responds to Property-attribute slicers (Program, Service, Suburb) via the Property relationship. NOT date-aware: does not respond to the Date slicer; counts all voids in the current filter context.
	measure 'Bond Recoveries Processed' =
			CALCULATE(
			    COUNTROWS('Void Checklist'),
			    NOT(ISBLANK('Void Checklist'[Bond Recovery Forms Completed]))
			)
		formatString: #,##0
		displayFolder: 08. Void Management\Milestones
		lineageTag: 28ac360b-eb29-424b-bcbb-bfb05b4543da

	/// Counts Void Checklist records where 'All Compliance Issues Completed' is recorded (building code, healthy homes, safety resolved). Grain: void events, not distinct properties. Responds to Property-attribute slicers (Program, Service, Suburb) via the Property relationship. NOT date-aware: does not respond to the Date slicer; counts all voids in the current filter context.
	measure 'Compliance Issues Resolved' =
			CALCULATE(
			    COUNTROWS('Void Checklist'),
			    NOT(ISBLANK('Void Checklist'[All Compliance Issues Completed]))
			)
		formatString: #,##0
