	/// (Period): Count of active Transitional Housing properties whose total unoccupied days within the selected date range exceed 20. Works at property level (1/0) and total level (count). Responds to the Date Table slicer, spanning MIN..MAX of the selected range; when no Date slicer is applied it defaults to the current month-to-date (1st of the current month through today), so early in a month the >20-day threshold cannot be met and the value returns 0. Restricted to the active portfolio (acquired on or before period end and not disposed before period start) and clamped to each property's in-portfolio window; occupancy excludes tenancies that are cancelled or not yet activated. Respects all Property filters including City, Provider Agreement Number, and Property Name. Occupancy basis: a tenancy counts towards occupancy only once the household has taken up the place - that is, the tenancy has been activated, or it is recorded as Active, Active Arrears, Vacated, Vacated Arrears or Vacated Closed Account. Agreements that have been created but not yet activated, and cancelled agreements, are not counted as occupying a place.
	measure 'TH Places Unoccupied >20 Days (Period)' =
			// Count of TH properties whose unoccupied days in the selected range exceed 20
			// Works at property level (returns 1/0) and total level (returns count)
			VAR _IsDateFiltered = ISFILTERED('Date Table')
			VAR _PeriodEnd = IF(_IsDateFiltered, MAX('Date Table'[Calendar Date]), TODAY())
			VAR _PeriodStart = IF(_IsDateFiltered, MIN('Date Table'[Calendar Date]), DATE(YEAR(_PeriodEnd), MONTH(_PeriodEnd), 1))
			VAR _ActiveTHProperties =
			    FILTER(
			        'Property',
			        'Property'[Program] = "Transitional Housing" &&
			        'Property'[Acquired Date] <= _PeriodEnd &&
			        (ISBLANK('Property'[Confirmed Disposal Date]) ||
			         'Property'[Confirmed Disposal Date] >= _PeriodStart)
			    )
			RETURN
			SUMX(
			    _ActiveTHProperties,
			    VAR _PropStart = MAX('Property'[Acquired Date], _PeriodStart)
			    VAR _PropEnd = MIN(
			        IF(ISBLANK('Property'[Confirmed Disposal Date]), DATE(9999,12,31), 'Property'[Confirmed Disposal Date]),
			        _PeriodEnd
			    )
			    VAR _TotalDaysInPeriod = DATEDIFF(_PropStart, _PropEnd, DAY) + 1
			    VAR _OccupiedDays =
			        SUMX(
			            FILTER(
			                RELATEDTABLE('Tenancy'),
			                'Tenancy'[Is Occupying Tenancy] = 1 &&
			                'Tenancy'[Tenancy Start Date] <= _PropEnd &&
			                (ISBLANK('Tenancy'[Vacated Date]) || 'Tenancy'[Vacated Date] >= _PropStart)
			            ),
			            VAR _TenStart = MAX('Tenancy'[Tenancy Start Date], _PropStart)
			            VAR _TenEnd = MIN(
			                COALESCE('Tenancy'[Vacated Date], DATE(9999,12,31)),
			                _PropEnd
			            )
			            RETURN IF(_TenEnd >= _TenStart, DATEDIFF(_TenStart, _TenEnd, DAY) + 1, 0)
			        )
			    VAR _UnoccupiedDays = MAX(0, _TotalDaysInPeriod - _OccupiedDays)
			    RETURN IF(_UnoccupiedDays > 20, 1, 0)
			)
		formatString: #,0
		displayFolder: 09. THVM Dashboard\Occupancy
		lineageTag: 2720bafa-bef7-47bf-917a-35429c2af72f

	/// Current snapshot: Transitional Housing occupancy rate = Places Occupied / Places Contracted, where a place is a row of Property with Status = OCCUPIED (numerator) within the active portfolio (Acquired on/before today and not yet disposed by Confirmed Disposal Date) as the denominator. Returns a ratio shown as a percentage; reflects current state as at today and IGNORES the Date slicer.
	measure 'TH Occupancy Rate % (Current)' =
			VAR _Active =
			    FILTER(
			        'Property',
			        'Property'[Program] = "Transitional Housing" &&
			        'Property'[Acquired Date] <= TODAY() &&
			        ( ISBLANK('Property'[Confirmed Disposal Date]) || 'Property'[Confirmed Disposal Date] > TODAY() )
			    )
			VAR Contracted = COUNTROWS(_Active)
			VAR Occupied = COUNTROWS( FILTER(_Active, 'Property'[Status] = "OCCUPIED") )
			RETURN
			    DIVIDE(Occupied, Contracted, 0)
		formatString: 0.0%
		displayFolder: 09. THVM Dashboard\Occupancy
		lineageTag: 8bc87152-f835-4866-8d2f-91d9b4164aa2

	/// Median length of stay in weeks for Transitional Housing chains that exited in the 12 calendar months ending with the month of the selected date. Calculated as weeks from Chain Start Date (earliest tenancy in the continuous stay) to the final Vacated Date. Continuous stays include transfers where the gap is 3 days or less. Excludes chains whose last tenancy's exit outcome is Internal Transfer. Uses the median, per HUD reporting standards. Caveat: chains are keyed on Chain ID, Tangata Whaiora ID and Chain Start Date; about 75% of historical TH tenancies have a blank Tangata Whaiora ID, so chain grouping, and this metric, is less reliable for the blank-client majority of historical records.
	measure 'TH Median Stay Weeks (Exited 12M)' = ```
			VAR _IsDateFiltered = ISFILTERED('Date Table')
			VAR _ReferenceDate = 
			    IF(
			        _IsDateFiltered,
			        MAX('Date Table'[Calendar Date]),
			        TODAY()
			    )
			VAR _StartDate = EOMONTH(_ReferenceDate, -12) + 1
			VAR _EndDate = EOMONTH(_ReferenceDate, 0)
			
			// All TH tenancies
			VAR AllTHTenancies = 
			    CALCULATETABLE(
			        'Tenancy',
			        'Property'[Program] = "Transitional Housing"
			    )
			
			// Get chain-level summary
			VAR ChainInfo =
			    GROUPBY(
			        AllTHTenancies,
			        'Tenancy'[Chain ID],
			        'Tenancy'[Tangata Whaiora ID],
			        'Tenancy'[Chain Start Date],
			        "MaxTenancyStart", MAXX(CURRENTGROUP(), 'Tenancy'[Tenancy Start Date])
			    )
			
			// FIX: exit = the LAST tenancy's Vacated Date (blank => still in service), not MAX(Vacated) across the chain
			VAR ChainWithLastReason =
			    ADDCOLUMNS(
			        ChainInfo,
			        "ChainExitDate",
			        VAR _ChainID = 'Tenancy'[Chain ID]
			        VAR _TangataID = 'Tenancy'[Tangata Whaiora ID]
			        VAR _ChainStart = 'Tenancy'[Chain Start Date]
			        VAR _MaxStart = [MaxTenancyStart]
			        RETURN
			            MAXX(
			                FILTER(
			                    AllTHTenancies,
			                    'Tenancy'[Chain ID] = _ChainID &&
			                    'Tenancy'[Tangata Whaiora ID] = _TangataID &&
			                    'Tenancy'[Chain Start Date] = _ChainStart &&
			                    'Tenancy'[Tenancy Start Date] = _MaxStart
			                ),
			                'Tenancy'[Vacated Date]
			            ),
			        // Tenancies sharing the last start date: the highest Leaving Reason, then Exit Point, sets the outcome
			        "LastExitOutcome",
			        VAR _ChainID = 'Tenancy'[Chain ID]
			        VAR _TangataID = 'Tenancy'[Tangata Whaiora ID]
			        VAR _ChainStart = 'Tenancy'[Chain Start Date]
			        VAR _MaxStart = [MaxTenancyStart]
			        RETURN
			            MAXX(
			                TOPN(
			                    1,
			                    FILTER(
			                        AllTHTenancies,
			                        'Tenancy'[Chain ID] = _ChainID &&
			                        'Tenancy'[Tangata Whaiora ID] = _TangataID &&
			                        'Tenancy'[Chain Start Date] = _ChainStart &&
			                        'Tenancy'[Tenancy Start Date] = _MaxStart
			                    ),
			                    'Tenancy'[Leaving Reason], DESC,
			                    'Tenancy'[Exit Point], DESC
			                ),
			                'Tenancy'[Exit Outcome]
			            )
			    )
			
			// Filter to chains that exited in 12-month window (excluding internal transfers)
			VAR ExitedChains = 
			    FILTER(
			        ChainWithLastReason,
			        NOT ISBLANK([ChainExitDate]) &&
			        [ChainExitDate] >= _StartDate &&
			        [ChainExitDate] <= _EndDate &&
			        NOT([LastExitOutcome] = "Internal Transfer")
			    )
			
			RETURN
			    MEDIANX(
			        ExitedChains,
			        DATEDIFF('Tenancy'[Chain Start Date], [ChainExitDate], WEEK)
			    )
			```
		formatString: #,0.0
		displayFolder: 09. THVM Dashboard\Length of Stay
		lineageTag: 0642553e-82da-4427-ac73-351f8e439924

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Median length of stay in weeks for Transitional Housing tenancies IN SERVICE as of the selected date. Only includes chains that were active at the reference date (not yet vacated or vacated after that date). Calculates weeks from Chain Start Date to reference date. Continuous stays include transfers where the gap between tenancies is 3 days or less. Uses MEDIAN per HUD reporting standards. Use Date Table slicer to view historical snapshots; defaults to current date if no date selected. Caveat: chains are keyed on Chain ID + Tangata Whaiora ID + Chain Start Date; ~75% of historical TH tenancies have a blank Tangata Whaiora ID, so chain grouping - and this metric - is less reliable for the blank-client majority of historical records.
	measure 'TH Median Stay Weeks (In Service)' = ```
			VAR _IsDateFiltered = ISFILTERED('Date Table')
			VAR _ReferenceDate = 
			    IF(
			        _IsDateFiltered,
			        MAX('Date Table'[Calendar Date]),
			        TODAY()
			    )
			
			// All TH tenancies
			VAR AllTHTenancies = 
			    CALCULATETABLE(
			        'Tenancy',
			        'Property'[Program] = "Transitional Housing"
			    )
			
			// Group by chain to get chain-level aggregates
			VAR ChainInfo = 
			    GROUPBY(
			        AllTHTenancies,
			        'Tenancy'[Chain ID],
			        'Tenancy'[Tangata Whaiora ID],
			        'Tenancy'[Chain Start Date],
			        "MaxTenancyStart", MAXX(CURRENTGROUP(), 'Tenancy'[Tenancy Start Date]),
			        "MaxVacatedDate", MAXX(CURRENTGROUP(), 'Tenancy'[Vacated Date]),
			        "HasActiveAtRef", SUMX(
			            CURRENTGROUP(),
			            IF(
			                'Tenancy'[Tenancy Start Date] <= _ReferenceDate &&
			                (ISBLANK('Tenancy'[Vacated Date]) || 'Tenancy'[Vacated Date] > _ReferenceDate),
			                1, 0
			            )
			        )
			    )
			
			// Filter to chains that were IN SERVICE at the reference date:
			// - Last tenancy started on or before reference date AND
			// - Chain was active (not yet vacated or vacated after reference date)
			VAR FilteredChains = 
			    FILTER(
			        ChainInfo,
			        [MaxTenancyStart] <= _ReferenceDate &&
			        (
			            [HasActiveAtRef] > 0 ||
			            ISBLANK([MaxVacatedDate]) ||
			            [MaxVacatedDate] > _ReferenceDate
			        )
			    )
			
			// Calculate stay weeks for each chain (from chain start to reference date)
			VAR ChainStays = 
			    ADDCOLUMNS(
			        FilteredChains,
			        "StayWeeks",
			        DATEDIFF('Tenancy'[Chain Start Date], _ReferenceDate, WEEK)
			    )
			
			RETURN
			    MEDIANX(ChainStays, [StayWeeks])
			```
		formatString: #,0.0
		displayFolder: 09. THVM Dashboard\Length of Stay
		lineageTag: 90ccf3ac-3e42-49a5-9d98-dd53435a73d2

	/// Maximum length of stay in weeks (the longest stay among exited households) for Transitional Housing chains that exited in the 12 calendar months ending with the month of the selected date. Calculated as weeks from Chain Start Date (earliest tenancy in the continuous stay) to the final Vacated Date. Continuous stays include transfers where the gap is 3 days or less. Excludes chains whose last tenancy's exit outcome is Internal Transfer. Caveat: about 75% of historical TH tenancies have a blank Tangata Whaiora ID; those chains are keyed on Chain ID and Chain Start Date only and may merge across distinct clients. Because this returns a maximum, a single mis-merged chain can overstate the result, so treat it as indicative for historical periods.
	measure 'TH Max Stay Weeks (Exited 12M)' = ```
			VAR _IsDateFiltered = ISFILTERED('Date Table')
			VAR _ReferenceDate = 
			    IF(
			        _IsDateFiltered,
			        MAX('Date Table'[Calendar Date]),
			        TODAY()
			    )
			VAR _StartDate = EOMONTH(_ReferenceDate, -12) + 1
			VAR _EndDate = EOMONTH(_ReferenceDate, 0)
			
			// All TH tenancies
			VAR AllTHTenancies = 
			    CALCULATETABLE(
			        'Tenancy',
			        'Property'[Program] = "Transitional Housing"
			    )
			
			// Get chain-level summary
			VAR ChainInfo =
			    GROUPBY(
			        AllTHTenancies,
			        'Tenancy'[Chain ID],
			        'Tenancy'[Tangata Whaiora ID],
			        'Tenancy'[Chain Start Date],
			        "MaxTenancyStart", MAXX(CURRENTGROUP(), 'Tenancy'[Tenancy Start Date])
			    )
			
			// FIX: exit = the LAST tenancy's Vacated Date (blank => still in service), not MAX(Vacated) across the chain
			VAR ChainWithLastReason =
			    ADDCOLUMNS(
			        ChainInfo,
			        "ChainExitDate",
			        VAR _ChainID = 'Tenancy'[Chain ID]
			        VAR _TangataID = 'Tenancy'[Tangata Whaiora ID]
			        VAR _ChainStart = 'Tenancy'[Chain Start Date]
			        VAR _MaxStart = [MaxTenancyStart]
			        RETURN
			            MAXX(
			                FILTER(
			                    AllTHTenancies,
			                    'Tenancy'[Chain ID] = _ChainID &&
			                    'Tenancy'[Tangata Whaiora ID] = _TangataID &&
			                    'Tenancy'[Chain Start Date] = _ChainStart &&
			                    'Tenancy'[Tenancy Start Date] = _MaxStart
			                ),
			                'Tenancy'[Vacated Date]
			            ),
			        // Tenancies sharing the last start date: the highest Leaving Reason, then Exit Point, sets the outcome
			        "LastExitOutcome",
			        VAR _ChainID = 'Tenancy'[Chain ID]
			        VAR _TangataID = 'Tenancy'[Tangata Whaiora ID]
			        VAR _ChainStart = 'Tenancy'[Chain Start Date]
			        VAR _MaxStart = [MaxTenancyStart]
			        RETURN
			            MAXX(
			                TOPN(
			                    1,
			                    FILTER(
			                        AllTHTenancies,
			                        'Tenancy'[Chain ID] = _ChainID &&
			                        'Tenancy'[Tangata Whaiora ID] = _TangataID &&
			                        'Tenancy'[Chain Start Date] = _ChainStart &&
			                        'Tenancy'[Tenancy Start Date] = _MaxStart
			                    ),
			                    'Tenancy'[Leaving Reason], DESC,
			                    'Tenancy'[Exit Point], DESC
			                ),
			                'Tenancy'[Exit Outcome]
			            )
			    )
			
			// Filter to chains that exited in 12-month window (excluding internal transfers)
			VAR ExitedChains = 
			    FILTER(
			        ChainWithLastReason,
			        NOT ISBLANK([ChainExitDate]) &&
			        [ChainExitDate] >= _StartDate &&
			        [ChainExitDate] <= _EndDate &&
			        NOT([LastExitOutcome] = "Internal Transfer")
			    )
			
			RETURN
			    MAXX(
			        ExitedChains,
			        DATEDIFF('Tenancy'[Chain Start Date], [ChainExitDate], WEEK)
			    )
			```
		formatString: #,0.0
		displayFolder: 09. THVM Dashboard\Length of Stay
		lineageTag: bfda173d-2fa7-42b5-879a-77d80dee85eb

	/// Maximum length of stay in weeks for Transitional Housing tenancies IN SERVICE as of the selected date. Identifies the longest-serving household at that point in time. Only includes chains that were active at the reference date (not yet vacated or vacated after that date). Calculates weeks from Chain Start Date to reference date. Continuous stays include transfers where the gap between tenancies is 3 days or less. Use Date Table slicer to view historical snapshots; defaults to current date if no date selected. Caveat: ~75% of historical TH tenancies have a blank Tangata Whaiora ID; those chains are keyed on Chain ID + Chain Start Date only and may merge across clients. As this returns a maximum, one mis-merged chain can overstate it — treat historical values as indicative.
	measure 'TH Max Stay Weeks (In Service)' = ```
			VAR _IsDateFiltered = ISFILTERED('Date Table')
			VAR _ReferenceDate = 
			    IF(
			        _IsDateFiltered,
			        MAX('Date Table'[Calendar Date]),
			        TODAY()
			    )
			
			// All TH tenancies
			VAR AllTHTenancies = 
			    CALCULATETABLE(
			        'Tenancy',
			        'Property'[Program] = "Transitional Housing"
			    )
			
			// Group by chain to get chain-level aggregates
			VAR ChainInfo = 
			    GROUPBY(
			        AllTHTenancies,
			        'Tenancy'[Chain ID],
			        'Tenancy'[Tangata Whaiora ID],
			        'Tenancy'[Chain Start Date],
			        "MaxTenancyStart", MAXX(CURRENTGROUP(), 'Tenancy'[Tenancy Start Date]),
			        "MaxVacatedDate", MAXX(CURRENTGROUP(), 'Tenancy'[Vacated Date]),
			        "HasActiveAtRef", SUMX(
			            CURRENTGROUP(),
			            IF(
			                'Tenancy'[Tenancy Start Date] <= _ReferenceDate &&
			                (ISBLANK('Tenancy'[Vacated Date]) || 'Tenancy'[Vacated Date] > _ReferenceDate),
			                1, 0
			            )
			        )
			    )
			
			// Filter to chains that were IN SERVICE at the reference date:
			// - Last tenancy started on or before reference date AND
			// - Chain was active (not yet vacated or vacated after reference date)
			VAR FilteredChains = 
			    FILTER(
			        ChainInfo,
			        [MaxTenancyStart] <= _ReferenceDate &&
			        (
			            [HasActiveAtRef] > 0 ||
			            ISBLANK([MaxVacatedDate]) ||
			            [MaxVacatedDate] > _ReferenceDate
			        )
			    )
			
			// Calculate stay weeks for each chain (from chain start to reference date)
			VAR ChainStays = 
			    ADDCOLUMNS(
			        FilteredChains,
			        "StayWeeks",
			        DATEDIFF('Tenancy'[Chain Start Date], _ReferenceDate, WEEK)
			    )
			
			RETURN
			    MAXX(ChainStays, [StayWeeks])
			```
		formatString: #,0.0
