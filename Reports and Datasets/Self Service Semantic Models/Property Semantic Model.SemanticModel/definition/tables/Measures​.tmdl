	/// Count of Transitional Housing chain EXITS in the 12 calendar months ending at the selected date (responds to the Date Table slicer; defaults to today if no date is selected) whose total continuous stay was 1-84 days (0-12 weeks, inclusive). A 'chain' links tenancies with gaps <=3 days into one continuous stay, keyed on Chain ID + Tangata Whaiora ID + Chain Start Date; stay length runs from Chain Start Date to the final tenancy's Vacated Date using inclusive day counting (DATEDIFF+1). Only chains that have actually exited are counted (a blank final Vacated Date = still in service, excluded); internal transfers between Emerge services are excluded. CAVEAT: chain grain, not tenancy grain, so this will NOT sum to the tenancy-grain 'TH Exits Last 12 Months'. CAVEAT: ~75% of historical TH tenancies have a blank Tangata Whaiora ID, so chain identity and stay length are unreliable for the blank-client majority; treat historical figures with caution. Per HUD THVM Dashboard specifications.
	measure 'TH Exited Short Stay (12M)' = ```
			VAR _IsDateFiltered = ISFILTERED('Date Table')
			VAR _ReferenceDate = 
			    IF(
			        _IsDateFiltered,
			        MAX('Date Table'[Calendar Date]),
			        TODAY()
			    )
			VAR _StartDate = EOMONTH(_ReferenceDate, -12) + 1
			VAR _EndDate = EOMONTH(_ReferenceDate, 0)
			VAR _ShortStayMaxDays = 83  -- 12 weeks (84 days) inclusive: DATEDIFF 0-83 = 1-84 days
			
			// All TH tenancies
			VAR AllTHTenancies = 
			    CALCULATETABLE(
			        'Tenancy',
			        'Property'[Program] = "Transitional Housing"
			    )
			
			// Get chain-level summary
			VAR ChainInfo =
			    GROUPBY(
			        AllTHTenancies,
			        'Tenancy'[Chain ID],
			        'Tenancy'[Tangata Whaiora ID],
			        'Tenancy'[Chain Start Date],
			        "MaxTenancyStart", MAXX(CURRENTGROUP(), 'Tenancy'[Tenancy Start Date])
			    )
			
			// FIX: exit = the LAST tenancy's Vacated Date (blank => still in service), not MAX(Vacated) across the chain
			VAR ChainWithLastReason =
			    ADDCOLUMNS(
			        ChainInfo,
			        "ChainExitDate",
			        VAR _ChainID = 'Tenancy'[Chain ID]
			        VAR _TangataID = 'Tenancy'[Tangata Whaiora ID]
			        VAR _ChainStart = 'Tenancy'[Chain Start Date]
			        VAR _MaxStart = [MaxTenancyStart]
			        RETURN
			            MAXX(
			                FILTER(
			                    AllTHTenancies,
			                    'Tenancy'[Chain ID] = _ChainID &&
			                    'Tenancy'[Tangata Whaiora ID] = _TangataID &&
			                    'Tenancy'[Chain Start Date] = _ChainStart &&
			                    'Tenancy'[Tenancy Start Date] = _MaxStart
			                ),
			                'Tenancy'[Vacated Date]
			            ),
			        // Tenancies sharing the last start date: the highest Leaving Reason, then Exit Point, sets the outcome
			        "LastExitOutcome",
			        VAR _ChainID = 'Tenancy'[Chain ID]
			        VAR _TangataID = 'Tenancy'[Tangata Whaiora ID]
			        VAR _ChainStart = 'Tenancy'[Chain Start Date]
			        VAR _MaxStart = [MaxTenancyStart]
			        RETURN
			            MAXX(
			                TOPN(
			                    1,
			                    FILTER(
			                        AllTHTenancies,
			                        'Tenancy'[Chain ID] = _ChainID &&
			                        'Tenancy'[Tangata Whaiora ID] = _TangataID &&
			                        'Tenancy'[Chain Start Date] = _ChainStart &&
			                        'Tenancy'[Tenancy Start Date] = _MaxStart
			                    ),
			                    'Tenancy'[Leaving Reason], DESC,
			                    'Tenancy'[Exit Point], DESC
			                ),
			                'Tenancy'[Exit Outcome]
			            )
			    )
			
			// Filter to chains that exited in 12-month window with short stay duration (excluding internal transfers)
			// Using inclusive day counting: DATEDIFF + 1 for actual days stayed
			VAR ShortStayExitedChains = 
			    FILTER(
			        ChainWithLastReason,
			        NOT ISBLANK([ChainExitDate]) &&
			        [ChainExitDate] >= _StartDate &&
			        [ChainExitDate] <= _EndDate &&
			        NOT([LastExitOutcome] = "Internal Transfer") &&
			        DATEDIFF('Tenancy'[Chain Start Date], [ChainExitDate], DAY) >= 0 &&
			        DATEDIFF('Tenancy'[Chain Start Date], [ChainExitDate], DAY) <= _ShortStayMaxDays
			    )
			
			RETURN
			    COUNTROWS(ShortStayExitedChains)
			```
		formatString: #,0
		displayFolder: 09. THVM Dashboard\Exits
		lineageTag: 2a4a5ac3-cca8-4250-bb22-1dff31fc72d4

	/// Count of Transitional Housing chain EXITS in the 12 calendar months ending at the selected date (responds to the Date Table slicer; defaults to today if no date is selected) whose total continuous stay was 85-364 days (>12 to 52 weeks, inclusive). A 'chain' links tenancies with gaps <=3 days into one continuous stay, keyed on Chain ID + Tangata Whaiora ID + Chain Start Date; stay length runs from Chain Start Date to the final tenancy's Vacated Date using inclusive day counting (DATEDIFF+1). Only chains that have actually exited are counted (a blank final Vacated Date = still in service, excluded); internal transfers between Emerge services are excluded. CAVEAT: chain grain, not tenancy grain, so this will NOT sum to the tenancy-grain 'TH Exits Last 12 Months'. CAVEAT: ~75% of historical TH tenancies have a blank Tangata Whaiora ID, so chain identity and stay length are unreliable for the blank-client majority; treat historical figures with caution. Per HUD THVM Dashboard specifications.
	measure 'TH Exited Medium Stay (12M)' = ```
			VAR _IsDateFiltered = ISFILTERED('Date Table')
			VAR _ReferenceDate = 
			    IF(
			        _IsDateFiltered,
			        MAX('Date Table'[Calendar Date]),
			        TODAY()
			    )
			VAR _StartDate = EOMONTH(_ReferenceDate, -12) + 1
			VAR _EndDate = EOMONTH(_ReferenceDate, 0)
			VAR _MediumStayMinDays = 84   -- >12 weeks inclusive: DATEDIFF 84 = 85 days
			VAR _MediumStayMaxDays = 363  -- 52 weeks (364 days) inclusive: DATEDIFF 363 = 364 days
			
			// All TH tenancies
			VAR AllTHTenancies = 
			    CALCULATETABLE(
			        'Tenancy',
			        'Property'[Program] = "Transitional Housing"
			    )
			
			// Get chain-level summary
			VAR ChainInfo =
			    GROUPBY(
			        AllTHTenancies,
			        'Tenancy'[Chain ID],
			        'Tenancy'[Tangata Whaiora ID],
			        'Tenancy'[Chain Start Date],
			        "MaxTenancyStart", MAXX(CURRENTGROUP(), 'Tenancy'[Tenancy Start Date])
			    )
			
			// FIX: exit = the LAST tenancy's Vacated Date (blank => still in service), not MAX(Vacated) across the chain
			VAR ChainWithLastReason =
			    ADDCOLUMNS(
			        ChainInfo,
			        "ChainExitDate",
			        VAR _ChainID = 'Tenancy'[Chain ID]
			        VAR _TangataID = 'Tenancy'[Tangata Whaiora ID]
			        VAR _ChainStart = 'Tenancy'[Chain Start Date]
			        VAR _MaxStart = [MaxTenancyStart]
			        RETURN
			            MAXX(
			                FILTER(
			                    AllTHTenancies,
			                    'Tenancy'[Chain ID] = _ChainID &&
			                    'Tenancy'[Tangata Whaiora ID] = _TangataID &&
			                    'Tenancy'[Chain Start Date] = _ChainStart &&
			                    'Tenancy'[Tenancy Start Date] = _MaxStart
			                ),
			                'Tenancy'[Vacated Date]
			            ),
			        // Tenancies sharing the last start date: the highest Leaving Reason, then Exit Point, sets the outcome
			        "LastExitOutcome",
			        VAR _ChainID = 'Tenancy'[Chain ID]
			        VAR _TangataID = 'Tenancy'[Tangata Whaiora ID]
			        VAR _ChainStart = 'Tenancy'[Chain Start Date]
			        VAR _MaxStart = [MaxTenancyStart]
			        RETURN
			            MAXX(
			                TOPN(
			                    1,
			                    FILTER(
			                        AllTHTenancies,
			                        'Tenancy'[Chain ID] = _ChainID &&
			                        'Tenancy'[Tangata Whaiora ID] = _TangataID &&
			                        'Tenancy'[Chain Start Date] = _ChainStart &&
			                        'Tenancy'[Tenancy Start Date] = _MaxStart
			                    ),
			                    'Tenancy'[Leaving Reason], DESC,
			                    'Tenancy'[Exit Point], DESC
			                ),
			                'Tenancy'[Exit Outcome]
			            )
			    )
			
			// Filter to chains that exited in 12-month window with medium stay duration (excluding internal transfers)
			// Using inclusive day counting: DATEDIFF + 1 for actual days stayed
			VAR MediumStayExitedChains = 
			    FILTER(
			        ChainWithLastReason,
			        NOT ISBLANK([ChainExitDate]) &&
			        [ChainExitDate] >= _StartDate &&
			        [ChainExitDate] <= _EndDate &&
			        NOT([LastExitOutcome] = "Internal Transfer") &&
			        DATEDIFF('Tenancy'[Chain Start Date], [ChainExitDate], DAY) >= _MediumStayMinDays &&
			        DATEDIFF('Tenancy'[Chain Start Date], [ChainExitDate], DAY) <= _MediumStayMaxDays
			    )
			
			RETURN
			    COUNTROWS(MediumStayExitedChains)
			```
