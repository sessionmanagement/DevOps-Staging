	/// Number of Transitional Housing properties unoccupied at the end of the selected period, or today when no date is selected: properties held at the end of the period (acquired by then and not disposed of before it) with no tenancy in place at the end of that day. A property whose tenancy ends on the last day of the period counts as unoccupied, while a property with a tenancy starting that day counts as occupied. Shows 1 on the row of an unoccupied property and the count on a total. Responds to all property filters, including city, provider agreement number and property name. Occupancy basis: a tenancy counts towards occupancy only once the household has taken up the place - that is, the tenancy has been activated, or it is recorded as Active, Active Arrears, Vacated, Vacated Arrears or Vacated Closed Account. Agreements that have been created but not yet activated, and cancelled agreements, are not counted as occupying a place.
	measure 'TH Places Unoccupied (Period End)' =
			// Count of TH properties unoccupied at END of selected date range
			// Works at property level (returns 1/0) and total level (returns count)
			VAR _IsDateFiltered = ISFILTERED('Date Table')
			VAR _AsAtDate = IF(_IsDateFiltered, MAX('Date Table'[Calendar Date]), TODAY())
			
			VAR _THProperties =
			    CALCULATETABLE(
			        SELECTCOLUMNS('Property', "PropID", 'Property'[Property ID]),
			        'Property'[Program] = "Transitional Housing",
			        'Property'[Acquired Date] <= _AsAtDate,
			        ISBLANK('Property'[Confirmed Disposal Date]) || 'Property'[Confirmed Disposal Date] >= _AsAtDate
			    )
			
			VAR _THtenancies =
			    CALCULATETABLE(
			        SELECTCOLUMNS(
			            'Tenancy',
			            "PropID", 'Tenancy'[Property ID],
			            "StartDate", 'Tenancy'[Tenancy Start Date],
			            "VacatedDate", 'Tenancy'[Vacated Date]
			        ),
			        FILTER ( ALL ( 'Tenancy' ), 'Tenancy'[Is Occupying Tenancy] = 1 )
			    )
			
			VAR _PropertiesWithStatus =
			    ADDCOLUMNS(
			        _THProperties,
			        "IsOccupied",
			        VAR _PropID = [PropID]
			        VAR _PropTenancies = FILTER(_THtenancies, [PropID] = _PropID)
			        VAR _ActiveTenancy =
			            COUNTROWS(
			                FILTER(
			                    _PropTenancies,
			                    [StartDate] <= _AsAtDate &&
			                    (ISBLANK([VacatedDate]) || [VacatedDate] > _AsAtDate)
			                )
			            )
			        RETURN _ActiveTenancy > 0
			    )
			
			RETURN COUNTROWS(FILTER(_PropertiesWithStatus, NOT([IsOccupied])))
		formatString: #,0
		displayFolder: 09. THVM Dashboard\Occupancy
		lineageTag: 795acf79-c7aa-43e4-8f23-fae2fb6a64cd

	/// Count of Transitional Housing tenancies with a Vacated Date in the selected calendar month. Excludes internal transfers between Emerge services as these are not exits from service. Per HUD THVM Dashboard specifications. Use Date Table slicer to view historical months; defaults to current month if no date selected.
	measure 'TH Exits (Current)' = ```
			VAR _IsDateFiltered = ISFILTERED('Date Table')
			VAR _ReferenceDate = 
			    IF(
			        _IsDateFiltered,
			        MAX('Date Table'[Calendar Date]),
			        TODAY()
			    )
			VAR _MonthStart = EOMONTH(_ReferenceDate, -1) + 1
			VAR _MonthEnd = EOMONTH(_ReferenceDate, 0)
			VAR _ExitTable = 
			    FILTER(
			        'Tenancy',
			        'Tenancy'[Vacated Date] >= _MonthStart &&
			        'Tenancy'[Vacated Date] <= _MonthEnd &&
			        NOT(ISBLANK('Tenancy'[Vacated Date])) &&
			        RELATED('Property'[Program]) = "Transitional Housing" &&
			        NOT('Tenancy'[Exit Outcome] = "Internal Transfer")
			    )
			RETURN
			    COUNTROWS(_ExitTable)
			```
		formatString: #,0
		displayFolder: 09. THVM Dashboard\Exits
		lineageTag: d39e7003-e8eb-4379-be02-1883250ff3e2

	/// Current snapshot: average weekly rent (Current Rent) across Transitional Housing properties whose Status is OCCUPIED right now, within the active portfolio (Acquired on/before today and not yet disposed by Confirmed Disposal Date). Reflects the current state as at today and IGNORES the Date slicer - do not use it for historical/period analysis.
	measure 'TH Avg Weekly Contribution (Occupied, Current)' =
			CALCULATE(
			    AVERAGE('Property'[Current Rent]),
			    'Property'[Program] = "Transitional Housing",
			    'Property'[Status] = "OCCUPIED",
			    FILTER(
			        'Property',
			        'Property'[Acquired Date] <= TODAY()
			            && ( ISBLANK('Property'[Confirmed Disposal Date]) || 'Property'[Confirmed Disposal Date] > TODAY() )
			    )
			)
		formatString: \$#,0.00
		displayFolder: 09. THVM Dashboard\Occupancy
		lineageTag: 369a78a6-fe97-409c-95bb-a02b98e01543

