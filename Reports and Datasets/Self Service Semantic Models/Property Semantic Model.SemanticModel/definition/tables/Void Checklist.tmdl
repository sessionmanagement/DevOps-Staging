	/// Additional notes or context about the void category selection, used when standard categories need clarification or when special circumstances apply to this void.
	column 'Void Category Comment'
		dataType: string
		lineageTag: 801d1588-87ce-40a0-8274-c88b5fbb81c2
		summarizeBy: none
		sourceColumn: Void Category Comment

		annotation SummarizationSetBy = Automatic

	/// Full descriptive name of the void category explaining the type of void process being undertaken (e.g., 'New Property (Transitional)', 'Routine Turnover', 'Return to Landlord').
	column 'Void Category Description'
		dataType: string
		lineageTag: 53faea1e-5c2b-4136-aaaf-51a7413c7bbe
		summarizeBy: none
		sourceColumn: Void Category Description

		annotation SummarizationSetBy = Automatic

	/// Classification code for the type of void (turnaround) process for each void checklist record, sourced from edw.dim_void_category and paired with the plain-language text in Void Category Description. The codes present in the data are the routine turnovers ROUT (Routine Void) and ROTH (Routine Void Transitional Housing) - each of which also appears as an asterisk-suffixed variant (ROU*, ROT*) carrying the same meaning; the new-property onboarding family NEWS (Social Housing), NEWT (Transitional), NEWP (General), NEWR (Residential) and NEWC (Commercial); RTLL (Returned to Landlord); the damage codes MIND (Minor Damage) and MAJD (Major Damage); plus PROV (Provisional), INSR (Insurance), PIMP (Planned Improvement), MNGT (Management Void) and NATD (Natural Disaster). RTLL is routinely excluded from void and turnaround KPIs, and some measures group only the NEW*, ROUT and ROTH codes (including the asterisk variants), so the damage, provisional, insurance and other minor categories fall outside that grouping. A small number of records carry a blank code, with a correspondingly blank description.
	column 'Void Category'
		dataType: string
		lineageTag: 87f62dd6-44d5-41af-93f1-e6a304513c31
		summarizeBy: none
		sourceColumn: Void Category

		annotation SummarizationSetBy = Automatic

	/// Current workflow state of the void checklist (void_checklist_status_name). Values observed in the data: 'New Tenant Occupied' (terminal - property re-tenanted; the large majority of records), 'Tenant Vacated', 'Current' (active in-progress void), 'Void Category Change', 'NTV Rescinded', 'Reverted to Untenantable', 'Completed', plus a small number of blank rows. Note: measures determine open vs finished voids from the Void Completed Date (blank = open), NOT from this status field. (Earlier documentation referenced a 'Void' status value that does not occur in the data.)
	column 'Void Status'
		dataType: string
		lineageTag: 56854b3a-3f1d-4cac-bc2d-fd4609af27f1
		summarizeBy: none
		sourceColumn: Void Status

		annotation SummarizationSetBy = Automatic

