	/// Relative date label used by reports to quickly filter to today's date.
	column 'Current Date'
		dataType: string
		lineageTag: 3be0fa01-5717-411f-bddc-6ebf643ffc4d
		summarizeBy: none
		sourceColumn: Current Date

		annotation SummarizationSetBy = Automatic

	partition 'Date Table' = m
		mode: import
		queryGroup: 'Dim Date'
		source = ```
				let
				    Source = Sql.Database(Server, Database),
				    edw_dim_date = Source{[Schema="edw",Item="vw_dim_date"]}[Data],
				    #"Transformed Column Names" = Table.TransformColumnNames(edw_dim_date, fnApplyNamingConventions),
				    
				    // Step to remove columns that start with "DWH" if needed
				    RemoveDWHColumns = Table.RemoveColumns(
				        #"Transformed Column Names",
				        List.Select(Table.ColumnNames(#"Transformed Column Names"), each Text.StartsWith(_, "DWH"))
				    ),
				    
				    // Filter to start from 2000-01-01
				    FilterFromYear2000 = Table.SelectRows(RemoveDWHColumns, each [Calendar Date] >= #date(2000, 1, 1)),
				    
				    // Keep only essential columns for self-service
				    SelectEssentialColumns = Table.SelectColumns(
				        FilterFromYear2000,
				        {
				            "Dim Date KEY",
				            "Calendar Date",
				            "Calendar Day Name Short",
				            "Calendar Month Num",
				            "Calendar Month Name Short",
				            "Calendar Year Month",
				            "Calendar Quarter Num",
				            "Calendar Year",
				            "Current Date Flag",
				            "Weekend Flag",
				            "Weekday Flag"
				        }
				    ),
				    AddCurrentDate = Table.AddColumn(SelectEssentialColumns, "Current Date", each if [Current Date Flag] = 1 then "Today" else "Other Dates", type text),
				    RemoveCurrentDateFlag = Table.RemoveColumns(AddCurrentDate, {"Current Date Flag"})
				in
				    RemoveCurrentDateFlag
				```

	changedProperty = IsHidden

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

