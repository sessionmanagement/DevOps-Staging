/// Central date dimension for time-based analysis and reporting. One row per calendar date from 2000-01-01 to 2036-12-31 (13,515 rows). Intentionally DISCONNECTED from the fact tables (no active relationships); period measures read MIN/MAX of Calendar Date from the slicer to define the reporting window (NZ financial year 1 Jul-30 Jun is encoded in the measures). Use for date slicers and time-intelligence measure logic. Marked as a date table (dataCategory: Time). Sourced from EDW view edw.vw_dim_date, filtered to dates >= 2000-01-01.
table 'Date Table'
	lineageTag: 5206faa4-cecc-413e-adc6-fb6043ce28b7
	dataCategory: Time

	/// Surrogate key for the date dimension in YYYYMMDD integer format.
	column 'Dim Date KEY'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: f1d84ad9-ab8f-4857-8fe4-5cfd9e5f929e
		summarizeBy: none
		sourceColumn: Dim Date KEY

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// The actual calendar date value and the table key (isKey). The Date Table is intentionally DISCONNECTED (no active relationship to any fact table); period measures read MIN/MAX of this column from the slicer to define the reporting window (the NZ financial year 1 Jul-30 Jun is encoded in the measures, not in this table).
	column 'Calendar Date'
		dataType: dateTime
		isKey
		formatString: d/mm/yyyy
		lineageTag: 7a601b17-4584-4ccd-9176-ca7d88f3158f
		summarizeBy: none
		sourceColumn: Calendar Date

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	/// Abbreviated day name (e.g., Mon, Tue, Wed).
	column 'Calendar Day Name Short'
		dataType: string
		lineageTag: e21ee934-5745-4fa4-b9cc-b83565a99866
		summarizeBy: none
		sourceColumn: Calendar Day Name Short

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Month number (1-12).
	column 'Calendar Month Num'
		dataType: int64
		formatString: 0
		lineageTag: 62a9dd9b-302e-435b-b083-e26acef9f6d4
		summarizeBy: none
		sourceColumn: Calendar Month Num

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Abbreviated month name (e.g., Jan, Feb, Mar).
	column 'Calendar Month Name Short'
		dataType: string
		lineageTag: 928fc7ab-6d4a-41ac-a84c-4088df931c14
		summarizeBy: none
		sourceColumn: Calendar Month Name Short
		sortByColumn: 'Calendar Month Num'

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Year and month in YYYY-MM format for sorting and grouping.
	column 'Calendar Year Month'
		dataType: string
		lineageTag: 39f4a2f4-caca-422f-a0f0-9becff1895fb
		summarizeBy: none
		sourceColumn: Calendar Year Month

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Calendar quarter of the year, stored as text: 1, 2, 3, or 4.
	column 'Calendar Quarter Num'
		dataType: string
		lineageTag: 4e90893e-c68f-4d9c-b3a2-8e75281bd62f
		summarizeBy: none
		sourceColumn: Calendar Quarter Num

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Four-digit calendar year.
	column 'Calendar Year'
		dataType: int64
		formatString: 0
