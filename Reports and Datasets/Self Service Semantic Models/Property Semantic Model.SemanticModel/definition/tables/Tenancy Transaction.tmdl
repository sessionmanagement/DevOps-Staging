	partition 'Tenancy Transaction' = m
		mode: import
		queryGroup: 'Fact Tables'
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="SELECT [fact_property_tenancy_transaction_id]#(lf)      ,[property_tenancy_transaction_id]#(lf)      ,[dim_property_key]#(lf)      ,[dim_property_detail_key]#(lf)      ,[dim_property_healthy_homes_key]#(lf)      ,[dim_property_tenancy_key]#(lf)      ,[dim_property_program_key]#(lf)      ,[property_id]#(lf)      ,[property_tenancy_id]#(lf)      ,[property_program_id]#(lf)      ,[property_subprogram_id]#(lf)      ,TRY_CONVERT(DATE, CAST([property_tenancy_transaction_date_key] AS CHAR(8)), 112) AS [Transaction Date]#(lf)      ,TRY_CONVERT(DATE, CAST([property_tenancy_transaction_rent_from_date_key] AS CHAR(8)), 112) AS [Rent From Date]#(lf)      ,TRY_CONVERT(DATE, CAST([property_tenancy_transaction_rent_to_date_key] AS CHAR(8)), 112) AS [Rent To Date]#(lf)      ,TRY_CONVERT(DATE, CAST([property_tenancy_transaction_rent_paid_to_date_key] AS CHAR(8)), 112) AS [Rent Paid To]#(lf)      ,TRY_CONVERT(DATE, CAST([property_tenancy_transaction_as_at_date_key] AS CHAR(8)), 112) AS [Tenancy As At Date]#(lf)      ,[property_tenancy_transaction_name] AS [Transaction Name]#(lf)      ,[property_tenancy_transaction_type_code] AS [G/L Code]#(lf)      ,[property_tenancy_transaction_type] AS [Transaction Type]#(lf)      ,[property_tenancy_transaction_account_type] AS [Account Type]#(lf)      ,[property_tenancy_transaction_subtransaction_name] AS [Sub Transaction Name]#(lf)      ,[property_tenancy_transaction_comments] AS [Comments]#(lf)      ,[property_tenancy_transaction_state] AS [Transaction State]#(lf)      ,[property_tenancy_transaction_status] AS [Transaction Status]#(lf)      ,[property_tenancy_transaction_payment_type_id] AS [Payment Type ID]#(lf)      --,[property_tenancy_transaction_payment_type] AS [Payment Type]#(lf)      ,[property_tenancy_transaction_rent_nonrent] AS [Rent or Non-Rent]#(lf)      ,[property_tenancy_transaction_credit_debit] AS [Credit or Debit]#(lf)      ,[property_tenancy_transaction_arrears_arrangement] AS [Arrears Arrangement]#(lf)      ,[property_tenancy_transaction_import_payment_name] AS [import payment]#(lf)      ,[property_tenancy_transaction_bc_entry_number] AS [BC Entry No]#(lf)      ,[property_tenancy_transaction_amount] AS [Amount]#(lf)      ,[property_tenancy_transaction_balance_non_rent] AS [Balance Non Rent]#(lf)      ,[property_tenancy_transaction_balance_rent] AS [Balance Rent]#(lf)      ,[property_tenancy_transaction_balance_total] AS [Balance Total]#(lf)      ,[property_tenancy_transaction_receipt_number] AS [Receipt Number (Number)]#(lf)      ,CASE#(lf)          WHEN [fact_property_tenancy_transaction_id] = MAX([fact_property_tenancy_transaction_id]) OVER (PARTITION BY [property_tenancy_id])#(lf)          THEN 1 ELSE 0#(lf)       END AS [Is Latest Balance]#(lf)  FROM [edw].[fact_property_tenancy_transaction]#(lf)  WHERE [DWHDMLOperation] <> 'D'#(lf)    AND [property_id] IS NOT NULL#(lf)    AND [property_tenancy_id] IS NOT NULL"]),
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, fnApplyNamingConventions),
				    #"Changed Type" = Table.TransformColumnTypes(#"Transformed Column Names",{{"Is Latest Balance", type logical}})
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Exception

