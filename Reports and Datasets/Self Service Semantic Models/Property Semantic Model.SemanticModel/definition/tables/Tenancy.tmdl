	/// Earliest referral accepted date for referrals matching this tenancy
	column 'First Referral Accepted Date' =
			CALCULATE(
			    MIN('Tenancy Referral Bridge'[Referral Accepted Date]),
			    TREATAS({[Property Tenancy ID]}, 'Tenancy Referral Bridge'[Property Tenancy ID])
			)
		dataType: dateTime
