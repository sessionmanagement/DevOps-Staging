	/// Link to open the tenancy opportunity record in Dynamics 365.
	column 'Dynamics 365 Link'
		dataType: string
		lineageTag: 40a32287-2ae6-40da-96f2-050a36abbacc
		dataCategory: WebUrl
		summarizeBy: none
		sourceColumn: Dynamics 365 Link

		annotation SummarizationSetBy = Automatic

	/// Indicates whether this tenancy places a household in the property and therefore occupies a contracted place. 1 = occupying: the tenancy has been activated, or it is recorded as Active, Active Arrears, Vacated, Vacated Arrears or Vacated Closed Account. 0 = not occupying: the agreement has been created but not yet activated (status New), the status has not been resolved, or the agreement was cancelled. Used by the occupancy, vacancy and bed-night measures so that a place is only counted as occupied once the household has taken it up.
	column 'Is Occupying Tenancy' =
			VAR _Status = 'Tenancy'[Tenancy Status]
			RETURN
			IF (
			    _Status = "Cancelled",
			    0,
			    IF (
			        NOT ISBLANK ( 'Tenancy'[Activate Tenancy Date] )
			            || _Status IN { "Active", "Active Arrears", "Vacated", "Vacated Arrears", "Vacated Closed Account" },
			        1,
			        0
			    )
			)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: f1000000-0000-4f10-b100-000000000001
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// How each tenancy ended, classified once so that every exit measure uses the same rule. The recorded leaving reason is looked up in the Exit Categories table, which gives each Waharoa reason a positive, negative or neutral exit category. Moves between Emerge services, including a move within Transitional Housing, are Internal Transfer: not an exit from the service, even though the exit categories list shows them as neutral. Only when no leaving reason was recorded is the outcome taken from where the household went: Positive for a destination of private rental, a community housing provider or Kāinga Ora; Negative for an unknown destination; Neutral for a destination such as a family or whānau home, another transitional housing place, a hospital, a boarding house, aged care, emergency accommodation, a correctional facility, overseas or other; Internal Transfer for a destination recorded as an internal transfer. Unclassified: a leaving reason that is not in the Exit Categories table yet, or is listed there with two different categories; it is kept visible so that a newly added Waharoa reason can be spotted, and it is not counted as a positive, negative or neutral exit until it is added. Blank: no leaving reason and no recognised destination. The outcome is set whatever the tenancy status or programme, so each exit measure still applies its own ended-tenancy, period and programme rules.
	column 'Exit Outcome' =
			VAR _Reason = 'Tenancy'[Leaving Reason]
			VAR _ExitPoint = 'Tenancy'[Exit Point]
			VAR _Categories =
			    DISTINCT (
			        SELECTCOLUMNS (
			            FILTER ( 'Exit Categories', LEFT ( 'Exit Categories'[Waharoa Exit Reason], 50 ) = LEFT ( _Reason, 50 ) ),
			            "@Category", 'Exit Categories'[Exit Category]
			        )
			    )
			VAR _Category = IF ( COUNTROWS ( _Categories ) = 1, MAXX ( _Categories, [@Category] ) )
			RETURN
			SWITCH (
			    TRUE (),
			    _Reason IN { "Internal transfer between Emerge services", "Transitional Housing Internal Transfer - Emerge" }, "Internal Transfer",
			    ISBLANK ( _Reason ) && _ExitPoint = "Internal Transfer", "Internal Transfer",
			    _Category = "Positive Exit", "Positive",
			    _Category = "Negative Exit", "Negative",
			    _Category = "Neutral Exit", "Neutral",
			    NOT ISBLANK ( _Reason ), "Unclassified",
			    _ExitPoint IN { "Private Market Rental", "Community Housing Provider", "Kainga Ora" }, "Positive",
			    _ExitPoint IN { "Unknown" }, "Negative",
			    _ExitPoint IN { "Family/Whanau Home", "Transitional Housing", "Other", "Mental Health Inpatient (Hospital)", "Boarding House", "Overseas", "Aged Care", "Emergency Accomodation (MSD)", "Correctional Facility" }, "Neutral",
			    BLANK ()
			)
		dataType: string
		lineageTag: 19a37ef7-7ed2-490b-922f-f6866043e6c1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Tenancy = m
		mode: import
		queryGroup: 'Dim Tables'
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="#(lf)WITH TenancyBase AS (#(lf)    SELECT #(lf)        [dim_property_tenancy_key],#(lf)        [dim_property_key],#(lf)        [property_tenancy_id],#(lf)        [property_id],#(lf)        [property_tenancy_manager_name] as [Tenancy Manager],#(lf)        [property_tenancy_manager_email] as [Tenancy Manager Email],#(lf)        [property_tenancy_tenancy_type] AS [Tenancy Type],#(lf)        [property_tenancy_owning_business_unit_name] AS [Owning Business Unit],#(lf)        [property_tenancy_tenancy_identifier] AS [Tenancy Identifier],#(lf)        [property_tenancy_tenancy_reference] AS [Tenancy Reference],#(lf)        [property_tenancy_tenancy_name] AS [Tenancy Name],#(lf)        [property_tenancy_household_name] AS [Household Name],#(lf)        [property_tenancy_customer_name] AS [Tenant Name],#(lf)        CAST([property_tenancy_lease_agreement_datetime] AS DATE) AS [Lease Agreement Date],#(lf)        CAST([property_tenancy_tenancy_start_date] AS DATE) AS [Tenancy Start Date],#(lf)        CAST([property_tenancy_activate_tenancy_datetime] AS DATE) AS [Activate Tenancy Date],#(lf)        CAST([property_tenancy_actual_start_date] AS DATE) AS [Actual Start Date],#(lf)        CAST([property_tenancy_fixed_term_tenancy_end_date] AS DATE) AS [Fixed Term Tenancy End Date],#(lf)        CAST([property_tenancy_short_term_tenancy_end_date] AS DATE) AS [Short Term Tenancy End Date],#(lf)        CAST([property_tenancy_expected_vacated_date] AS DATE) AS [Expected Vacated Date],#(lf)        CAST([property_tenancy_signed_msd_responsibilities_conditions_datetime] AS DATE) AS [Signed MSD Responsibilities Conditions Date],#(lf)        CAST([property_tenancy_signed_sng_forms_datetime] AS DATE) AS [Signed SNG Forms Date],#(lf)        CAST([property_tenancy_actual_close_date] AS DATE) AS [Actual Close Date],#(lf)        CAST([property_tenancy_bond_lodged_date] AS DATE) AS [Bond Lodged Date],#(lf)        CAST([property_tenancy_bond_refund_lodged_date] AS DATE) AS [Bond Refund Lodged Date],#(lf)        CAST([property_tenancy_check_bodycorp_or_residents_datetime] AS DATE) AS [Check Body Corp or Residents Date],#(lf)        CAST([property_tenancy_notice_to_vacate_date] AS DATE) AS [Notice to Vacate Date],#(lf)        CAST([property_tenancy_health_disability_information_datetime] AS DATE) AS [Health Disability Information Date],#(lf)        CAST([property_tenancy_tenancy_pack_datetime] AS DATE) AS [Tenancy Pack Date],#(lf)        CAST([property_tenancy_refund_lodged_date] AS DATE) AS [Refund Lodged Date],#(lf)        CAST([property_tenancy_pay_tenancy_services_by_date] AS DATE) AS [Pay Tenancy Services by Date],#(lf)        [property_tenancy_short_term_in_days] AS [Short Term (in Days)],#(lf)        [property_tenancy_bond_reference] AS [Bond Reference],#(lf)        [property_tenancy_tenancy_service_bond_number] AS [Tenancy Service Bond Number],#(lf)        [property_tenancy_tenancy_services_property_identifier] AS [Tenancy Services Property Identifier],#(lf)        [property_tenancy_arrears_arrangement_activated] AS [Arrears Arrangement Activated],#(lf)        [property_tenancy_arrears_arrangement_signed] AS [Arrears Arrangement Signed],#(lf)        [property_tenancy_bond_refund_sng_claim_completed] AS [Bond Refund SNG Claim Completed],#(lf)        [property_tenancy_bond_refund_sng_claim_lodged] AS [Bond Refund SNG Claim Lodged],#(lf)        [property_tenancy_exit_point] AS [Exit Point],#(lf)        [property_tenancy_expected_payment_day] AS [Expected Payment Day],#(lf)        [property_tenancy_expected_payment_frequency] AS [Expected Payment Frequency],#(lf)        [property_tenancy_leaving_reason] AS [Leaving Reason],#(lf)        [property_tenancy_rent_charged_day] AS [Rent Charged Day],#(lf)        [property_tenancy_rent_paid_in_advance] AS [Rent Paid in Advance],#(lf)        [property_tenancy_inspection_frequency] AS [Inspection Frequency],#(lf)        [property_tenancy_weeks_bond_requested] AS [Weeks Bond Requested],#(lf)        [property_tenancy_weekly_rent_payable] AS [Rent Payable Weekly],#(lf)        [property_tenancy_rent] AS [Rent],#(lf)        [property_tenancy_rent_base] AS [Rent (Base)],#(lf)        [property_tenancy_primary_tenant_recordbaseid] AS [Primary Tenant Record Base ID],#(lf)        [property_tenancy_number_signatories] AS [Number of Tenancy Signatories],#(lf)        [property_tenancy_second_client_name] AS [Tenant 2],#(lf)        CAST([property_tenancy_rent_amount_start_date] AS DATE) AS [Rent Amount Start Date],#(lf)        CAST([property_tenancy_vacated_date] AS DATE) AS [Vacated Date],#(lf)        [property_tenant_opportunity_status] AS [Tenancy Status],#(lf)        [DWHDMLOperation] AS [DWH DML Operation],#(lf)        [DWHIsCurrent] AS [DWH Is Current]#(lf)    FROM [edw].[dim_property_tenancy]#(lf)    WHERE [DWHIsCurrent] = 1 #(lf)      AND [DWHDMLOperation] <> 'D' #(lf)      AND [property_tenancy_id] IS NOT NULL#(lf)),#(lf)-- Step 1: Calculate Previous Vacate Date using LAG window function#(lf)TenancyWithPrev AS (#(lf)    SELECT *,#(lf)        LAG(CAST([Vacated Date] AS DATE)) OVER (#(lf)            PARTITION BY [Tenant Name] #(lf)            ORDER BY [Tenancy Start Date]#(lf)        ) AS [Prev Vacate Date]#(lf)    FROM TenancyBase#(lf)),#(lf)-- Step 2: Calculate Gap Days and determine if this starts a new chain#(lf)TenancyWithGap AS (#(lf)    SELECT *,#(lf)        DATEDIFF(DAY, [Prev Vacate Date], [Tenancy Start Date]) AS [Gap Days],#(lf)        CASE #(lf)            WHEN [Prev Vacate Date] IS NULL #(lf)              OR DATEDIFF(DAY, [Prev Vacate Date], [Tenancy Start Date]) > 3 #(lf)            THEN 1 #(lf)            ELSE 0 #(lf)        END AS [Is New Chain]#(lf)    FROM TenancyWithPrev#(lf)),#(lf)-- Step 3: Calculate Chain ID as running sum of Is New Chain#(lf)TenancyWithChainID AS (#(lf)    SELECT *,#(lf)        SUM([Is New Chain]) OVER (#(lf)            PARTITION BY [Tenant Name] #(lf)            ORDER BY [Tenancy Start Date] #(lf)            ROWS UNBOUNDED PRECEDING#(lf)        ) AS [Chain ID]#(lf)    FROM TenancyWithGap#(lf)),#(lf)-- Step 4: Calculate Chain Start Date as MIN start date within each chain#(lf)TenancyFinal AS (#(lf)    SELECT *,#(lf)        MIN([Tenancy Start Date]) OVER (#(lf)            PARTITION BY [Tenant Name], [Chain ID]#(lf)        ) AS [Chain Start Date]#(lf)    FROM TenancyWithChainID#(lf))#(lf)SELECT * FROM TenancyFinal#(lf)"]),
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, fnApplyNamingConventions),
				    #"Renamed Columns" = Table.RenameColumns(#"Transformed Column Names",{{"Tenancy Reference", "BOS/HUD Ref."}, {"Tenancy Identifier", "Tenancy ID"}}),
				    // Extract numeric Client ID from Primary Tenant Record Base ID for joining to Client dimension
				    #"Added Client ID" = Table.AddColumn(#"Renamed Columns", "Tangata Whaiora ID", each
				        let
				            sourceValue = [Primary Tenant Record Base ID],
				            numericOnly = Text.Select(sourceValue, {"0".."9"}),
				            clientId = try Int64.From(numericOnly) otherwise null
				        in
				            clientId, Int64.Type),
				    #"Added Dynamics 365 Link" = Table.AddColumn(
				        #"Added Client ID",
				        "Dynamics 365 Link",
				        each "https://emergeaotearoa.crm6.dynamics.com/main.aspx?appid=cf3d4408-7345-453c-8775-1e5538c40ddf"
				            & "&forceUCI=1&pagetype=entityrecord&etn=opportunity&id="
				            & Text.From([Property Tenancy ID]),
				        type text
				    ),
				    #"Filtered Rows" = Table.SelectRows(#"Added Dynamics 365 Link", each ([Tenancy Status] <> "Cancelled"))
				in
				    #"Filtered Rows"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

