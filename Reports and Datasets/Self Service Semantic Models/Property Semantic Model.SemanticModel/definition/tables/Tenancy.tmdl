	/// Number of referrals that fall within this tenancy period (accepted date >= tenancy start, discharge date <= vacated date)
	column 'Referral Count' =
			CALCULATE(
			    COUNTROWS('Tenancy Referral Bridge'),
			    TREATAS({[Property Tenancy ID]}, 'Tenancy Referral Bridge'[Property Tenancy ID])
			)
		dataType: int64
		formatString: 0
		lineageTag: da366f5b-c342-4a73-a842-9c6077e75267
		summarizeBy: sum

