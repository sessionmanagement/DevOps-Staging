	/// Referrer name from the most recent matching referral. Shows the source that referred the household to transitional housing.
	column 'Most Recent Referrer' =
			VAR CurrentTenancyID = 'Tenancy'[Property Tenancy ID]
			VAR MatchingReferrals =
			    FILTER(
			        'Tenancy Referral Bridge',
			        'Tenancy Referral Bridge'[Property Tenancy ID] = CurrentTenancyID
			    )
			VAR MostRecentDate = MAXX(MatchingReferrals, 'Tenancy Referral Bridge'[Referral Accepted Date])
			VAR MostRecentReferral =
			    FILTER(
			        MatchingReferrals,
			        'Tenancy Referral Bridge'[Referral Accepted Date] = MostRecentDate
			    )
			RETURN
			    MAXX(MostRecentReferral, 'Tenancy Referral Bridge'[Referrer Name])
		dataType: string
		lineageTag: 699d5811-8199-497d-9fc4-4d69413a07d3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Name of the staff member assigned as the tenancy manager. Note: contains personal information (name).
	column 'Tenancy Manager'
