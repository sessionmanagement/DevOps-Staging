	/// The full weekly rent amount payable for this tenancy. This represents the total rent due before any Income Related Rent Subsidy (IRRS) is applied. Summarization is disabled because summing weekly rent across multiple tenancies would not produce a meaningful value.
	column 'Rent Payable Weekly'
		dataType: double
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		lineageTag: 58168ca2-40ed-4e5d-93cc-795de45b4031
