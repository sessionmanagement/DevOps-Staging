	/// Tenant's age in whole years derived from Date Of Birth, incrementing only after the birthday has passed. It is a calculated column evaluated with TODAY() at each data refresh, so it is frozen between refreshes rather than updated live-daily, and is blank when Date Of Birth is missing. A small number of rows carry implausible ages - some negative and a few above any realistic human lifespan - reflecting dirty or erroneous source dates of birth; these outliers are data-quality noise rather than real ages.
	column Age = ```
			VAR BirthDate = 'Tenant'[Date Of Birth]
			VAR Today = TODAY()
			VAR BirthYear = YEAR(BirthDate)
			VAR BirthMonth = MONTH(BirthDate)
			VAR BirthDay = DAY(BirthDate)
			VAR CurrentYear = YEAR(Today)
			VAR CurrentMonth = MONTH(Today)
			VAR CurrentDay = DAY(Today)
			VAR HadBirthdayThisYear = 
			    (CurrentMonth > BirthMonth) || 
			    (CurrentMonth = BirthMonth && CurrentDay >= BirthDay)
			RETURN
			IF(
			    ISBLANK(BirthDate),
			    BLANK(),
			    CurrentYear - BirthYear - IF(HadBirthdayThisYear, 0, 1)
			)
			```
		dataType: int64
		formatString: #,0
		lineageTag: 361f58c3-746b-453a-85e8-2623ac0fe9d4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Categorizes tenant as 'Adult' (18 years and over) or 'Child' (under 18) based on Date Of Birth. Uses accurate age calculation that only increments after birthday has passed.
	column 'Age Group' = ```
			VAR BirthDate = 'Tenant'[Date Of Birth]
			VAR Today = TODAY()
			VAR BirthYear = YEAR(BirthDate)
			VAR BirthMonth = MONTH(BirthDate)
			VAR BirthDay = DAY(BirthDate)
			VAR CurrentYear = YEAR(Today)
			VAR CurrentMonth = MONTH(Today)
			VAR CurrentDay = DAY(Today)
			VAR HadBirthdayThisYear = 
			    (CurrentMonth > BirthMonth) || 
			    (CurrentMonth = BirthMonth && CurrentDay >= BirthDay)
			VAR AgeYears = CurrentYear - BirthYear - IF(HadBirthdayThisYear, 0, 1)
			RETURN
			IF(
			    ISBLANK(BirthDate),
			    BLANK(),
			    IF(AgeYears >= 18, "Adult", "Child")
			)
			```
		dataType: string
		lineageTag: e71a9166-71d8-4aad-8228-19796e849aa9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Tenant = m
		mode: import
		queryGroup: 'Fact Tables'
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="SELECT [fact_property_tenant_key]#(lf)      ,[dim_property_key]#(lf)      ,[dim_property_tenancy_key]#(lf)      ,[dim_property_program_key]#(lf)      ,[property_tenancy_id]#(lf)      ,[property_tenant_id]#(lf)      ,[property_id]#(lf)      ,[property_program_id]#(lf)      ,[property_subprogram_id]#(lf)      ,[property_tenancy_total_rent_amount] AS [Total Rent Amount]#(lf)      ,[property_tenant_tenancy_lease_agreement_date_id] AS [Tenancy Agreement Date]#(lf)      ,[property_tenant_tenancy_start_date_id] AS [Tenancy Start Date]#(lf)      ,[property_tenant_first_name] AS [First Name]#(lf)      ,[property_tenant_last_name] AS [Last Name]#(lf)      ,[property_tenant_full_name] AS [Full Name]#(lf)      ,CAST([property_tenancy_tenant_date_of_birth] AS DATE) AS [Date of Birth]#(lf)      ,CAST([property_tenant_registration_date] AS DATE) AS [Registration Date]#(lf)      ,[property_tenant_client_identifier] AS [Waharoa Client ID]#(lf)      ,[occupant_is_main_applicant_flag] AS [Is Primary Tenant]#(lf)      ,[property_tenant_head_of_household_flag] AS [Head of Household]#(lf)      ,[occupant_record_source] AS [Record Source]#(lf)      ,[occupant_statecode] AS [State Code]#(lf)      ,[occupant_statuscode] AS [Status Code]#(lf)      ,[property_tenant_tenancy_name] AS [Tenancy Name]#(lf)      ,[property_tenant_household_name] AS [Household Name]#(lf)      ,[property_tenancy_household_identifier] AS [Household ID]#(lf)      ,[property_tenant_number_of_household_members] AS [Number of Household Members]#(lf)      ,[property_tenant_named_household_members] AS [Named Household Members]#(lf)      ,[property_tenant_rent_share_total] AS [Rent share total]#(lf)      ,[property_tenant_total_household_income] AS [Total Income of the Household]#(lf)      ,[property_tenant_ethnicity_name] AS [Ethnicity]#(lf)      ,CAST([property_tenant_created_datetime] AS DATE) AS [Created Date]#(lf)      ,CAST([property_tenant_modified_datetime] AS DATE) AS [Modified Date]#(lf)      ,[occupant_gender_label] AS [Gender]#(lf)      ,[occupant_disability_label] AS [Disability]#(lf)      ,[occupant_targetgroup_label] AS [Target Group]#(lf)      ,[occupant_employment_label] AS [Employment Status]#(lf)      ,[occupant_contacttype_label] AS [Contact Type]#(lf)      ,[occupant_eatargetgroup_label] AS [EA Target Group]#(lf)      ,[occupant_state_label] AS [Occupant State]#(lf)      ,[occupant_status_label] AS [Occupant Status]#(lf)      ,[household_state_label] AS [Household State]#(lf)      ,[household_status_label] AS [Household Status]#(lf)      ,[property_tenant_opportunity_state] AS [Tenancy State]#(lf)      ,[property_tenant_opportunity_status] AS [Tenancy Status]#(lf)      ,[DWHDMLOperation] AS [DWH DML Operation]#(lf)  FROM [edw].[fact_property_tenant]#(lf)  WHERE [DWHDMLOperation] <> 'D'#(lf)  AND [property_tenant_is_delete_flag] IS NULL"]),
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, fnApplyNamingConventions),
				    #"Convert Date Columns" = Table.TransformColumns(#"Transformed Column Names", {
				        {"Tenancy Agreement Date", each if _ = null or _ = 0 then null else #date(Number.IntegerDivide(_, 10000), Number.Mod(Number.IntegerDivide(_, 100), 100), Number.Mod(_, 100)), type date},
				        {"Tenancy Start Date", each if _ = null or _ = 0 then null else #date(Number.IntegerDivide(_, 10000), Number.Mod(Number.IntegerDivide(_, 100), 100), Number.Mod(_, 100)), type date}
				    })
				in
				    #"Convert Date Columns"

	changedProperty = IsHidden

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Exception

