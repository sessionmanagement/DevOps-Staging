-[property_maintenance_invoice_details_processed_queue_flag] AS [Invoice Details Processed Queue Flag],#(lf)[property_maintenance_letter_flag] AS [Letter Flag],#(lf)[property_maintenance_onhold_flag] AS [On Hold Flag],#(lf)[property_maintenance_owner_recovery_flag] AS [Owner Recovery Flag],#(lf)[property_maintenance_phonecall_flag] AS [Phone Call Flag],#(lf)--[property_maintenance_request_received_sent_processed_queue_flag] AS [Request Received Sent Processed Queue Flag],#(lf)[property_maintenance_send_email_notification_when_pfm_cancelled_flag] AS [Send Email Notification When PFM Cancelled Flag],#(lf)[property_maintenance_support_email_flag] AS [Support Email Flag],#(lf)[property_maintenance_suppress_tenant_email_flag] AS [Suppress Tenant Email Flag],#(lf)[property_maintenance_tenant_damage_flag] AS [Tenant Damage Flag],#(lf)[property_maintenance_tenant_liable_flag] AS [Tenant Liable Flag],#(lf)[property_maintenance_tenants_charged_flag] AS [Tenants Charged Flag],#(lf)[property_maintenance_tenants_permission_flag] AS [Tenants Permission Flag],#(lf)[property_maintenance_text_message_flag] AS [Text Message Flag],#(lf)--[property_maintenance_variation_processed_queue_flag] AS [Variation Processed Queue Flag],#(lf)[property_maintenance_work_quote_processed_queue_flag] AS [Work Quote Processed Queue Flag],#(lf)[property_maintenance_work_task_completion_processed_queue_flag] AS [Work Task Completion Processed Queue Flag],#(lf)[property_maintenance_inspection_identifier] AS [Inspection ID],#(lf)[property_maintenance_cancellation_requested_by] AS [Cancellation Requested By],#(lf)[property_maintenance_client] AS [Client],#(lf)[property_maintenance_housing_officer] AS [Housing Officer],#(lf)[property_maintenance_zav_invoice_approved_by] AS [ZAV Invoice Approved By],#(lf)[property_maintenance_key_support_contact] AS [Key Support Contact],#(lf)[property_maintenance_legal_owner_primary_contact] AS [Legal Owner Primary Contact],#(lf)[property_maintenance_owning_business_unit_name] AS [Owning Business Unit Name],#(lf)[property_maintenance_owning_user] AS [Owning User Full Name],#(lf)CAST([property_maintenance_created_datetime] AS DATE) AS [Created Date],#(lf)CAST([property_maintenance_modified_datetime] AS DATE) AS [Modified Date]#(lf)FROM [edw].[dim_property_maintenance]#(lf)WHERE [DWHIsCurrent] = 1#(lf)AND [DWHDMLOperation] <> 'D'#(lf)AND [property_maintenance_id] IS NOT NULL"]),
