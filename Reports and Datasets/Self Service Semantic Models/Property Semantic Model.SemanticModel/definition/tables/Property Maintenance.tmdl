	/// Occupancy status of the property as recorded on the maintenance work order, one value per work order. In order from most to least common the values are 'OCCUPIED', 'VACANT: Un-tenantable' and 'VACANT: Tenantable', followed by a small number of blanks and a handful of 'RESERVED' records.
	column 'Property Status'
		dataType: string
		lineageTag: 079fa44b-3891-4da3-9a0e-5b8de6b1ae31
		summarizeBy: none
		sourceColumn: Property Status

