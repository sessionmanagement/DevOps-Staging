/// Maintenance work orders for properties at header level, with one row per work order (keyed uniquely and non-null on Property Maintenance ID). Each record carries the workflow state, contractor assignment and a set of boolean workflow flags, while the individual line-item tasks and their costs live in the related Property Maintenance Task table (many-to-one on Property Maintenance ID). It tracks the lifecycle of a request from logging through completion and payment. Note that Maintenance Type holds a single constant value ('Work Task') and the source flag behind Is Completed By Contractor is not loaded, so neither can be used to categorise or slice the records.
table 'Property Maintenance'
	lineageTag: a1811850-1b0c-4588-837d-115739ef4f6d

	column 'Dim Property Maintenance KEY'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e149e90a-c5d9-4496-9bd6-e6b43478e0ec
		summarizeBy: none
		sourceColumn: Dim Property Maintenance KEY

		annotation SummarizationSetBy = Automatic

	column 'Property Maintenance ID'
		dataType: string
		isHidden
		lineageTag: d68c24f0-64af-48af-a644-80022765fa9c
		summarizeBy: none
		sourceColumn: Property Maintenance ID

		annotation SummarizationSetBy = Automatic

	/// High-level lifecycle state of the maintenance work order, one value per work order. Almost every record is 'Active', with a much smaller group marked 'Inactive' and no blanks. The more detailed workflow status (Request Sent, Contractor Work Comp, Invoiced and so on) is held separately in Task Status, and a further qualifier in Task State Status, so a report should use one of the three to avoid double-labelling.
	column 'Task State'
		dataType: string
		lineageTag: e1c6425d-f625-4946-8bdb-b18eebf6ece3
		summarizeBy: none
		sourceColumn: Task State

		annotation SummarizationSetBy = Automatic

	/// Sub-status that qualifies the high-level Task State, one value per work order. In order from most to least common the values are 'Active', 'Cancelled', 'Inactive' and 'On Hold', with no blanks. This overlaps conceptually with Task State and Task Status, so a single column should be used for reporting to avoid double-labelling.
	column 'Task State Status'
		dataType: string
		lineageTag: 4c6db0d4-ca5d-44c3-838a-c36548964695
		summarizeBy: none
		sourceColumn: Task State Status

		annotation SummarizationSetBy = Automatic

	/// Record-type discriminator sourced from property_maintenance_type. In the current data every row holds the single constant value 'Work Task', so the column does not distinguish maintenance categories and cannot be used to slice the records. Because the values never include 'Reactive', the Reactive Maintenance Cost % measure, which filters this column to 'Reactive', matches no rows and therefore returns blank.
	column 'Maintenance Type'
		dataType: string
		lineageTag: fa767acb-ce3e-4caf-995e-5f5fccb5b66d
		summarizeBy: none
		sourceColumn: Type

		annotation SummarizationSetBy = Automatic

