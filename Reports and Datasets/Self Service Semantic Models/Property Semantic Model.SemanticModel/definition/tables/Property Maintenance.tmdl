	/// Indicates who the work order is dispatched to. Values in data: 'Tradesperson', 'EAHT', 'Legal Owner' (plus blank). (The example values 'Internal / External Contractor' do not occur.)
	column 'Send Workorder To'
		dataType: string
		lineageTag: 3a66e54c-0825-4426-b962-a5a6e1552266
		summarizeBy: none
		sourceColumn: Send Workorder To

