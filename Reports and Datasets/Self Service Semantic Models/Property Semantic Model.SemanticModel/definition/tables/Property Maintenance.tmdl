	/// Detailed workflow status of the maintenance work order, one value per work order. In order from most to least common the values are 'Request Sent', 'Contractor Work Comp', 'New', 'Cancelled', 'Invoiced' and a lone 'Approved' record, with no blanks. This is distinct from the high-level Task State (Active/Inactive) and from Task State Status; the three status columns overlap, so a report should pick the intended grain.
	column 'Task Status'
		dataType: string
		lineageTag: f91be1f5-66be-482f-b495-88b3580d4957
		summarizeBy: none
		sourceColumn: Task Status

		annotation SummarizationSetBy = Automatic

	/// Priority or category assigned to the maintenance work order, one value per work order. In order from most to least common the values are 'Standard', 'Urgent', 'Cyclical', 'Emergency', 'Planned', 'Void' and 'Minor upgrade', together with a small number of blanks. There is no 'Routine' value; 'Standard' serves that purpose.
	column 'Task Urgency'
