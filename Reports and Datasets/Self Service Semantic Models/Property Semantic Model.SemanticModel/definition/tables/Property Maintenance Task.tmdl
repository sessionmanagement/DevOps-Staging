	partition 'Property Maintenance Task' = m
		mode: import
		queryGroup: 'Fact Tables'
		source =
				let
				    Source = Sql.Database(Server, Database, [Query=" SELECT
				      [fact_property_maintenance_task_key],
				      [property_maintenance_task_id],
				      [property_maintenance_id],
				      [dim_property_maintenance_key],
				      [dim_property_key],
				      [dim_property_detail_key],
				      [dim_property_healthy_homes_key],
				      [dim_property_tenancy_key],
				      [dim_property_program_key],
				      [dim_property_maintenace_type_key],
				      [property_id],
				      [property_maintenance_type_id],
				      [property_program_id],
				      [property_subprogram_id],
				      [property_tenancy_id],
				      [property_maintenace_type_id],
				      [property_tenancy_type_id],
				
				      -- Date Key Conversions (INT YYYYMMDD → DATE)
				      TRY_CONVERT(DATE, CAST(NULLIF([property_maintenance_task_acknowledgment_date_key], -1) AS VARCHAR(8)), 112) AS
				   [Acknowledgment Start Date and Time],
				      TRY_CONVERT(DATE, CAST(NULLIF([property_maintenance_task_acknowledgment_end_date_key], -1) AS VARCHAR(8)),
				  112) AS [Acknowledgment End Date and Time],
				      TRY_CONVERT(DATE, CAST(NULLIF([property_maintenance_task_actual_completion_date_key], -1) AS VARCHAR(8)), 112)
				   AS [Invoice Processed Date],
				      TRY_CONVERT(DATE, CAST(NULLIF([property_maintenance_task_contractor_work_completion_date_key], -1) AS
				  VARCHAR(8)), 112) AS [Actual Contractor Completion Date],
				      TRY_CONVERT(DATE, CAST(NULLIF([property_maintenance_task_expected_completion_date_key], -1) AS VARCHAR(8)),
				  112) AS [Expected Completion Date],
				      TRY_CONVERT(DATE, CAST(NULLIF([property_maintenance_task_expected_onsite_date_key], -1) AS VARCHAR(8)), 112)
				  AS [Expected On-Site Date],
				      TRY_CONVERT(DATE, CAST(NULLIF([property_maintenance_task_total_capped_amount_date_key], -1) AS VARCHAR(8)),
				  112) AS [Total Amount Last Updated On],
				      TRY_CONVERT(DATE, CAST(NULLIF([property_maintenance_task_web_expenses_amount_date_key], -1) AS VARCHAR(8)),
				  112) AS [Web Expenses Amount Last Updated On],
				      TRY_CONVERT(DATE, CAST(NULLIF([property_maintenance_assets_installation_date_key], -1) AS VARCHAR(8)), 112) AS
				   [Installation Date],
				      TRY_CONVERT(DATE, CAST(NULLIF([property_maintenance_task_contractor_status_date_key], -1) AS VARCHAR(8)), 112)
				   AS [Contractor Completion Email Received],
				
				      -- Non-date columns
				      [property_maintenance_task_icode] AS [ICode],
				      [property_maintenance_task_information_code_name] AS [Information Code],
				      [property_maintenance_task_location_code] AS [Location Code],
				      [property_maintenance_task_location_name] AS [Location Name],
				      [property_maintenance_task_work_task_name] AS [Work Task],
				      [property_maintenance_task_area_seq] AS [Area Seq],
				      [property_maintenance_task_assets_name] AS [Assets],
				      [property_maintenance_contract_service_name] AS [Contract Service Name],
				      [property_maintenance_task_comments] AS [Comments],
				      [property_maintenance_task_information_code_detail_name] AS [Information Code Detail],
				      [property_maintenance_task_maintenance_code] AS [G/L Code],
				      [property_maintenance_task_maintenance_type_name] AS [Work Type],
				      [property_maintenance_task_amount] AS [Amount],
				      CAST([property_maintenance_task_created_datetime] AS DATE) AS [Created Date],
				      CAST([property_maintenance_task_modified_datetime] AS DATE) AS [Modified Date]
				
				  FROM [edw].[fact_property_maintenance_task]
				  WHERE [property_maintenance_task_is_delete_flag] IS NULL
				    AND [DWHDMLOperation] <> 'D'"]),
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, fnApplyNamingConventions)
				in
				    #"Transformed Column Names"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Exception

