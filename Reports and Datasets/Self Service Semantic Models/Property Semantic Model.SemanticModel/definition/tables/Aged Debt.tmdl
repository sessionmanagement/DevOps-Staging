	partition 'Aged Debt' = m
		mode: import
		queryGroup: 'Fact Tables'
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="SELECT [fact_aged_debt_key] AS [Fact Aged Debt KEY]#(lf)      ,[dim_property_tenancy_key] AS [Dim Property Tenancy KEY]#(lf)      ,[dim_property_key] AS [Dim Property KEY]#(lf)      ,[dim_property_program_key] AS [Dim Property Program KEY]#(lf)      ,[property_tenancy_id] AS [Property Tenancy ID]#(lf)      ,[Property_id] AS [Property ID]#(lf)      ,[TenantName] AS [Tenant Name]#(lf)      ,[ChargeType] AS [Charge Type]#(lf)      ,[AsAtDate] AS [As At Date]#(lf)      ,[Current_0_6] AS [Current 0-6 Days]#(lf)      ,[Days_7_14] AS [7-14 Days]#(lf)      ,[Days_15_21] AS [15-21 Days]#(lf)      ,[Days_22_28] AS [22-28 Days]#(lf)      ,[Days_29_60] AS [29-60 Days]#(lf)      ,[Days_61_90] AS [61-90 Days]#(lf)      ,[Days_91_Plus] AS [91 Plus Days]#(lf)      ,[ActualBalance] AS [Total Balance]#(lf)      ,[LastPaymentDate] AS [Last Payment Date]#(lf)      ,CAST([NoRecentPayment] AS bit) AS [No Recent Payment]#(lf)      ,[HasNoOverallDebt] AS [Has No Overall Debt]#(lf)FROM [edw].[fact_aged_debt]"]),
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, fnApplyNamingConventions),
				    #"Changed Type" = Table.TransformColumnTypes(#"Transformed Column Names",{{"As At Date", type date}, {"Last Payment Date", type date}, {"No Recent Payment", type logical}}),
				    MaxAsAtDate = List.Max(#"Changed Type"[As At Date]),
				    #"Added As At Year" = Table.AddColumn(#"Changed Type", "As At Year", each Date.Year([As At Date]), Int64.Type),
				    #"Added As At Month Number" = Table.AddColumn(#"Added As At Year", "As At Month Number", each Date.Month([As At Date]), Int64.Type),
				    #"Added As At Month Name Short" = Table.AddColumn(#"Added As At Month Number", "As At Month Name Short", each Date.ToText([As At Date], "MMM", "en-NZ"), type text),
				    #"Added As At Year Month" = Table.AddColumn(#"Added As At Month Name Short", "As At Year Month", each Date.ToText([As At Date], "yyyy-MM", "en-NZ"), type text),
				    #"Added As At Month" = Table.AddColumn(#"Added As At Year Month", "As At Month", each Date.ToText([As At Date], "MMM yyyy", "en-NZ"), type text),
				    #"Added As At Month Sort" = Table.AddColumn(#"Added As At Month", "As At Month Sort", each Date.Year([As At Date]) * 100 + Date.Month([As At Date]), Int64.Type),
				    #"Added Current Date" = Table.AddColumn(#"Added As At Month Sort", "Current Date", each if [As At Date] = MaxAsAtDate then "Today" else "Other Dates", type text)
				in
				    #"Added Current Date"

	annotation PBI_NavigationStepName = Navigation

