	partition 'Working Table for Referrals' = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="#(lf)SELECT distinct#(lf)    -- Client identification#(lf)    c.client_id,#(lf)#(lf)    -- Referrer information#(lf)    cr.client_referrer_name,#(lf)    --cr.client_referrer_code,#(lf)#(lf)    -- Accept reason#(lf)    cr.client_referral_accepted_reason,#(lf)    --cr.client_referral_accepted_comment,#(lf)    cr.client_referral_accepted_reason_code,#(lf)#(lf)    -- Discharge reason#(lf)    cr.client_referral_discharge_reason,#(lf)    cr.client_referral_discharge_reason_code,#(lf)#(lf)    -- Context columns#(lf)    cr.client_referral_status,#(lf)    s.service_name,#(lf)    s.service_type_name,#(lf)    s.finance_funder_name,#(lf)    ct.client_team_name,#(lf)#(lf)    -- Date keys (integer format YYYYMMDD)#(lf)    fcr.client_referral_received_date_key,#(lf)    fcr.client_referral_accepted_date_key,#(lf)    fcr.client_referral_discharge_date_key#(lf)#(lf)FROM edw.vw_fact_client_referral AS fcr#(lf)    INNER JOIN edw.vw_dim_client_referral AS cr#(lf)        ON fcr.dim_client_referral_key = cr.dim_client_referral_key#(lf)    INNER JOIN edw.vw_dim_client AS c#(lf)        ON fcr.dim_client_key = c.dim_client_key#(lf)    INNER JOIN edw.vw_dim_client_team AS ct#(lf)        ON fcr.dim_client_team_key = ct.dim_client_team_key#(lf)    INNER JOIN edw.vw_dim_service AS s#(lf)        ON ct.dim_service_key = s.dim_service_key#(lf)#(lf)WHERE#(lf)    -- Filter for Transitional Housing services#(lf)    fcr.DWHDMLOperation <> 'D'#(lf)    AND cr.client_referral_status <> 'Declined'#(lf)    and cr.client_referral_status <> 'Pending'#(lf)    and cr.client_referral_type = 'InboundReferral'#(lf)    and service_type_name = 'Emergency Housing Service'#(lf)    and client_team_name not like '%f/up%'"]),
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, fnApplyNamingConventions),
				    #"Convert Dates" = Table.TransformColumns(#"Transformed Column Names", {
				        {"Tangata Whaiora Referral Received Date KEY", each if _ = null or _ = 0 then null else Date.FromText(Text.Start(Text.From(_), 4) & "-" & Text.Middle(Text.From(_), 4, 2) & "-" & Text.End(Text.From(_), 2)), type date},
				        {"Tangata Whaiora Referral Accepted Date KEY", each if _ = null or _ = 0 then null else Date.FromText(Text.Start(Text.From(_), 4) & "-" & Text.Middle(Text.From(_), 4, 2) & "-" & Text.End(Text.From(_), 2)), type date},
				        {"Tangata Whaiora Referral Discharge Date KEY", each if _ = null or _ = 0 then null else Date.FromText(Text.Start(Text.From(_), 4) & "-" & Text.Middle(Text.From(_), 4, 2) & "-" & Text.End(Text.From(_), 2)), type date}
				    }),
				    #"Rename Date Columns" = Table.RenameColumns(#"Convert Dates", {
				        {"Tangata Whaiora Referral Received Date KEY", "Tangata Whaiora Referral Received Date"},
				        {"Tangata Whaiora Referral Accepted Date KEY", "Tangata Whaiora Referral Accepted Date"},
				        {"Tangata Whaiora Referral Discharge Date KEY", "Tangata Whaiora Referral Discharge Date"}
				    })
				in
				    #"Rename Date Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

