/// Model documentation table showing how tables are connected in this semantic model. Shows relationship direction, cardinality, and filter behavior. Use this to understand the data model structure. This is metadata only - not for reporting data.
table '_Model Info - Relationships'
	isHidden
	lineageTag: 635dbc46-4e6b-4fca-8cb0-b2a111454943

	column Relationship
		isHidden
		lineageTag: f9e876e4-0214-4aa1-91dc-ab197f895118
		isNameInferred
		sourceColumn: [Relationship]

	column 'From Table'
		isHidden
		lineageTag: 2c075333-4c19-486a-9ca0-88714579e987
		isNameInferred
		sourceColumn: [From Table]

	column 'From Column'
		isHidden
		lineageTag: 91aa283f-d235-4c83-b93c-b02d338ad3ab
		isNameInferred
		sourceColumn: [From Column]

	column 'From Cardinality'
		isHidden
		lineageTag: efd48ae9-0817-4885-8c80-a24878600948
