/// Central date dimension for time-based analysis and reporting. Contains calendar attributes from year 2000 onwards. Use this table for date slicers, time intelligence calculations (YTD, MTD, etc.), and consistent date filtering across all fact tables. Mark this as your model's date table in Power BI Desktop.
table 'Date Table'
	lineageTag: 5206faa4-cecc-413e-adc6-fb6043ce28b7
	dataCategory: Time

	/// Surrogate key for the date dimension in YYYYMMDD integer format.
	column 'Dim Date KEY'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: f1d84ad9-ab8f-4857-8fe4-5cfd9e5f929e
		summarizeBy: none
		sourceColumn: Dim Date KEY

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// The actual calendar date value. This is the primary date column for relationships and filtering.
	column 'Calendar Date'
		dataType: dateTime
		isKey
		formatString: Long Date
		lineageTag: 7a601b17-4584-4ccd-9176-ca7d88f3158f
		summarizeBy: none
		sourceColumn: Calendar Date

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Abbreviated day name (e.g., Mon, Tue, Wed).
	column 'Calendar Day Name Short'
		dataType: string
		lineageTag: e21ee934-5745-4fa4-b9cc-b83565a99866
		summarizeBy: none
		sourceColumn: Calendar Day Name Short

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Month number (1-12).
	column 'Calendar Month Num'
		dataType: int64
		formatString: 0
		lineageTag: 62a9dd9b-302e-435b-b083-e26acef9f6d4
		summarizeBy: none
		sourceColumn: Calendar Month Num

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Abbreviated month name (e.g., Jan, Feb, Mar).
	column 'Calendar Month Name Short'
		dataType: string
		lineageTag: 928fc7ab-6d4a-41ac-a84c-4088df931c14
		summarizeBy: none
		sourceColumn: Calendar Month Name Short

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Year and month in YYYY-MM format for sorting and grouping.
	column 'Calendar Year Month'
		dataType: string
		lineageTag: 39f4a2f4-caca-422f-a0f0-9becff1895fb
		summarizeBy: none
		sourceColumn: Calendar Year Month

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Calendar quarter number (Q1, Q2, Q3, Q4).
	column 'Calendar Quarter Num'
		dataType: string
		lineageTag: 4e90893e-c68f-4d9c-b3a2-8e75281bd62f
		summarizeBy: none
		sourceColumn: Calendar Quarter Num

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Four-digit calendar year.
	column 'Calendar Year'
		dataType: int64
		formatString: 0
		lineageTag: dfcb1ea2-ba81-4236-8da9-48f63c0adc8f
		summarizeBy: none
		sourceColumn: Calendar Year

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Flag indicating if the date falls on a weekend (1 = Saturday/Sunday, 0 = Weekday).
	column 'Weekend Flag'
		dataType: int64
		formatString: 0
		lineageTag: fec8c67a-cce1-46cf-b99d-694b3286c770
		summarizeBy: none
		sourceColumn: Weekend Flag

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Flag indicating if the date is a weekday (1 = Monday-Friday, 0 = Weekend).
	column 'Weekday Flag'
		dataType: int64
		formatString: 0
		lineageTag: 7af29ab0-eae2-465d-917d-0366cb89ad22
		summarizeBy: none
		sourceColumn: Weekday Flag

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition 'Date Table' = m
		mode: import
		queryGroup: 'Dim Date'
		source = ```
				let
				    Source = Sql.Database(Server, Database),
				    edw_dim_date = Source{[Schema="edw",Item="vw_dim_date"]}[Data],
				    #"Transformed Column Names" = Table.TransformColumnNames(edw_dim_date, fnApplyNamingConventions),
				    
				    // Step to remove columns that start with "DWH" if needed
				    RemoveDWHColumns = Table.RemoveColumns(
				        #"Transformed Column Names",
				        List.Select(Table.ColumnNames(#"Transformed Column Names"), each Text.StartsWith(_, "DWH"))
				    ),
				    
				    // Filter to start from 2000-01-01
				    FilterFromYear2000 = Table.SelectRows(RemoveDWHColumns, each [Calendar Date] >= #date(2000, 1, 1)),
				    
				    // Keep only essential columns for self-service
				    SelectEssentialColumns = Table.SelectColumns(
				        FilterFromYear2000,
				        {
				            "Dim Date KEY",
				            "Calendar Date",
				            "Calendar Day Name Short",
				            "Calendar Month Num",
				            "Calendar Month Name Short",
				            "Calendar Year Month",
				            "Calendar Quarter Num",
				            "Calendar Year",
				            "Weekend Flag",
				            "Weekday Flag"
				        }
				    )
				in
				    SelectEssentialColumns
				```

	changedProperty = IsHidden

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

