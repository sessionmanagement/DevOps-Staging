            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Welcome to the ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt"
                    }
                  },
                  {
                    "value": "Management Operational (MORe) Report",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#018db1"
                    }
                  },
                  {
                    "value": " ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This report shows information from Record base for both Emerge Aotearoa Ltd and Mind and Body."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "For more detailed information on the underlying data that the visuals are built upon, please click the question mark button in the top right-hand corner of any page."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How to use this report:",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "From this page, you can set filters that will be applied throughout the report.",
                    "textStyle": {
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "On each page, you can change the filters* rather than doing so by navigating back to this page. To access the filters on these pages, click the menu icon (3 horizontal lines or 'hamburger') on the top right-hand corner. Any changes you make will be reflected on all pages.",
                    "textStyle": {
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "If you wish to reset the filters and set them back to default, you can click the X button in the top right-hand corner from any page",
                    "textStyle": {
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "At the bottom of each page there is a text box detailing any filters that have explicitly been applied. If nothing is showing for Program, for example, it means that ",
                    "textStyle": {
                      "fontFamily": "Segoe UI"
                    }
                  },
                  {
                    "value": "all",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "textDecoration": "underline"
                    }
                  },
                  {
                    "value": " Programs are selected, and there is no active filter applied to that field.",
                    "textStyle": {
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "*Filters:  Note, if your team/service does not have any active clients (where a referral is both accepted and not discharged) they will NOT appear in the drop downs \t  "
                  }
                ]
              }
            ]
          }
