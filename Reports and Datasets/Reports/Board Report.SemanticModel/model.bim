        "lineageTag": "3dbe647d-a7a4-43db-aab9-9444e004dad7",
        "measures": [
          {
            "name": "Tāngata whaiora",
            "expression": [
              "CALCULATE(DISTINCTCOUNT(RBClients[personkey]),",
              " USERELATIONSHIP(RBClients[Explosion],DimDate[calendar_date]))",
              " "
            ],
            "formatString": "#,0",
            "lineageTag": "15d7bca3-48dc-4b0c-9973-3aa7e31dbd18"
          },
          {
            "name": "Number of Clients with Open Goals",
            "expression": [
              "CALCULATE(DISTINCTCOUNT(RBClients[personkey]), RBClients[opengoalcount] = 1,",
              " USERELATIONSHIP(RBClients[Explosion],DimDate[calendar_date]))"
            ],
            "formatString": "#,0",
            "lineageTag": "887742d8-0c2c-4cac-962c-b61048054b3f"
          },
          {
            "name": "Number of Clients with Goals",
            "expression": [
              "CALCULATE(DISTINCTCOUNT(RBClients[personkey]), RBClients[ClientHasGoals] = 1,",
              " USERELATIONSHIP(RBClients[Explosion],DimDate[calendar_date]))"
            ],
            "formatString": "#,0",
            "lineageTag": "e1f9ea8a-6a68-47cf-8ca2-24b318760bc7"
          },
          {
            "name": "%Clients with open goals",
            "expression": "[Number of Clients with Open Goals]/[Tāngata whaiora]",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "b41850dc-9244-4795-bafe-c38d15318606"
          },
          {
            "name": "Maori Declined",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": "calculate(sum('Declined Referrals'[declined]),'Ethnicity Group'[Ethnic Group]=\"Maori\")",
            "lineageTag": "54e42a8d-2d39-4a59-8f12-6c8ba82f10c7"
          },
          {
            "name": "%Clients with any goal",
            "expression": "[Number of Clients with Goals]/[Tāngata whaiora]",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "402248a6-5df4-4446-8c93-d2a1cdc8cc4a"
          },
          {
            "name": "Number of new teams",
            "expression": "if (isblank([TeamCountStarters1]),0,[TeamCountStarters1])",
            "formatString": "0",
            "lineageTag": "68e2d8ba-86de-4690-899a-64ada0b37365"
          },
          {
            "name": "TeamCount",
            "expression": "(sum(DimTeam[team_count]))",
            "formatString": "0",
            "lineageTag": "71bd8e88-4349-4347-8368-b290f2170592"
          },
          {
            "name": "_TeamTotals",
            "expression": [
              "",
              "CALCULATE (",
              "    [TeamCount],",
              "    FILTER (",
              "        VALUES ( 'DimTeam'[TeamStartDate] ),",
              "        'DimTeam'[TeamStartDate] <= MAX ( DimDate[calendar_date] )",
              "    ),",
              "   --On any particular day, how many teams had started prior to that day and have an end date greater than that particular day, OR they have a blank End Date",
              "    FILTER (",
              "        VALUES ( 'DimTeam'[teamenddateproxy] ),",
              "        OR (",
              "            'DimTeam'[teamenddateproxy] >= MIN ( DimDate[calendar_date]),",
              "            ISBLANK ( 'DimTeam'[teamenddateproxy] )",
              "        )",
              "    ),",
              "    FILTER('DimDate','DimDate'[Reporting Month]=\"Reporting Month\")",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "1aff766b-8786-4edd-af51-8eaf4c016e90"
          },
          {
            "name": "TeamcCountStarters",
            "expression": [
              "",
              "VAR",
              "TeamCountStarters0 = calculate(sum(DimTeam[team_count]),USERELATIONSHIP(DimDate[calendar_date],DimTeam[TeamStartDate]))",
              "return",
              "if(isblank(TeamCountStarters0),0,TeamCountStarters0)"
            ],
            "formatString": "0",
