    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "expressions": [
      {
        "name": "Reporting Months Ago",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Number"
          }
        ],
        "expression": "2 meta [IsParameterQuery=true, List={0, 1, 2, 3}, DefaultValue=2, Type=\"Number\", IsParameterQueryRequired=true]",
        "kind": "m",
        "lineageTag": "13d9c863-138b-4057-bff6-c6fc3ba5f8e0"
      },
      {
        "name": "HousingDischargesAllData",
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "expression": [
          "let\r",
          "    Source = SharePoint.Files(\"https://emergeaotearoaltd.sharepoint.com/sites/OPS_ITServices/\", [ApiVersion = 15]),\r",
          "    #\"Filtered Rows\" = Table.SelectRows(Source, each Text.Contains([Name], \"Housing Discharge Data All Raw\")),\r",
          "    #\"Housing Discharge Data All Raw xlsx_https://emergeaotearoaltd sharepoint com/sites/OPS_ITServices/Shared Documents/Data and Analytics/Reports/Board Report/Discharges Data/\" = #\"Filtered Rows\"{[Name=\"Housing Discharge Data All Raw.xlsx\",#\"Folder Path\"=\"https://emergeaotearoaltd.sharepoint.com/sites/OPS_ITServices/Shared Documents/Data and Analytics/Reports/Board Report/Discharges Data/\"]}[Content],\r",
          "    #\"Imported Excel Workbook\" = Excel.Workbook(#\"Housing Discharge Data All Raw xlsx_https://emergeaotearoaltd sharepoint com/sites/OPS_ITServices/Shared Documents/Data and Analytics/Reports/Board Report/Discharges Data/\"),\r",
          "    #\"All Raw_Sheet\" = #\"Imported Excel Workbook\"{[Item=\"All Raw\",Kind=\"Sheet\"]}[Data],\r",
          "    #\"Promoted Headers\" = Table.PromoteHeaders(#\"All Raw_Sheet\", [PromoteAllScalars=true]),\r",
          "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\",{{\"Area\", type text}, {\"Team Name\", type text}, {\"Exit Reason\", type text}, {\"Person Name\", type text}, {\"Discharge Date\", type datetime}, {\"Gender\", type text}, {\"Ethnicity\", type text}, {\"Date of birth\", type date}, {\"Days in service\", Int64.Type}, {\"Entry date\", type datetime}, {\"Days in referral\", Int64.Type}, {\"Entry Reason\", type text}, {\"Discharge Month\", type text}}),\r",
          "    #\"Added Custom\" = Table.AddColumn(#\"Changed Type\", \"DischargeMonthSorting\", each Date.Month([Discharge Date]))\r",
          "in\r",
          "    #\"Added Custom\""
        ],
        "kind": "m",
        "lineageTag": "29f7012d-892c-4941-93a2-c6b092ab4af7"
      },
      {
        "name": "DirectQuery to AS - Outcome Assessment Dataset",
        "annotations": [
          {
            "name": "PBI_IncludeFutureArtifacts",
            "value": "True"
          }
        ],
        "expression": [
          "let\r",
          "    Source = AnalysisServices.Database(\"powerbi://api.powerbi.com/v1.0/myorg/Production%20Reports\", \"Outcome Assessment Dataset\"),\r",
          "    Cubes = Table.Combine(Source[Data]),\r",
          "    Cube = Cubes{[Id=\"Model\", Kind=\"Cube\"]}[Data]\r",
          "in\r",
          "    Cube"
        ],
        "kind": "m",
        "lineageTag": "4be2ce86-b626-498d-99d4-ed2134dbbe1b"
      }
    ],
