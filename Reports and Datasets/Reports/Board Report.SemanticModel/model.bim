        "lineageTag": "69f42580-e7d2-44f3-8455-30d141e657e5",
        "partitions": [
          {
            "name": "DimTeam-b2d3bbaf-35af-4428-bfb4-973c63e0d82f",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Sql.Database(\"synapseausprod-ondemand.sql.azuresynapse.net\", \"ODS\", [Query=\"#(lf)declare @reportingstart date = #(lf)--case when month(getdate()) between 2 and 9 then cast(concat(year(getdate()),'-0',month(getdate())-1,'-01') as date)#(lf)--when month(getdate()) between 10 and 12 then cast(concat(year(getdate()),'-',month(getdate())-1,'-01') as date)#(lf)--else#(lf)--cast(concat(year(getdate()-1),'12',month(getdate())-1,'-01') as date)#(lf)--end;#(lf)DATEADD(MONTH, DATEDIFF(MONTH, 0, GETDATE()) - 1, 0);#(lf)#(lf)with __temp as#(lf)(#(tab)#(lf)select 'EAL' as type1#(lf), teamname#(lf), teamfunctionname#(lf), teamfunctioncode#(lf), cast(TeamStartDate as date) AS TeamStartDate#(lf), cast(teamenddate as date) as teamenddate#(lf),  case when teamenddate is null then cast(getdate() as date) else cast(teamenddate as date) end as teamenddateproxy, teamid#(lf)#(tab)#(lf)from rbeal.dldimteam#(lf)inner join rbeal.dldimteamfunction on dldimteam.TeamFunctionID = dlDimTeamFunction.TeamFunctionID#(lf)#(lf)#(tab)union all#(lf)select 'MNB' as type1#(lf), teamname#(lf), teamfunctionname#(lf), teamfunctioncode#(lf), cast(TeamStartDate as date) AS TeamStartDate#(lf), cast(teamenddate as date) as teamenddate #(lf),case when teamenddate is null #(lf)#(tab)then cast(getdate() as date) else cast(teamenddate as date) end as teamenddateproxy#(lf)#(tab), teamid#(lf)#(tab)from rbmnb.dldimteam#(lf)#(tab)#(lf)#(tab)inner join rbeal.dldimteamfunction on dldimteam.TeamFunctionID = dlDimTeamFunction.TeamFunctionID#(lf)#(tab))#(lf)#(tab),__finaldata as #(lf)#(tab)(#(lf)#(tab)select *,#(lf)#(tab)case #(lf)#(tab)when type1 in ('mnb') then 'Mind and Body'#(lf)#(tab)when teamname like '%Ease%Up%' then 'Ease Up'#(lf)when teamfunctionname like '%Residential%' then 'Residential'#(lf)when teamfunctionname like '%Community%' or teamfunctionname like '%day progra%' then 'Community'#(lf)when teamfunctionname like '%Respite%' then 'Respite'#(lf)when TeamFunctioncode like 'hs%' then ' Housing'#(lf)#(tab)end as ReportingTeamFunction,#(lf)#(tab)case when #(lf)#(tab)  (TeamName  in ('Whariki Day Prog','Auckland Adult Mobile- Clinical','Jansen House: Clinical','Mapusaga Clinical','Nga Taumahatanga Clinical','Phoenix Clinical',#(lf)   'WDHB Mainstream (Clinical)','WDHB Pacific (Clinical)')#(lf)   or teamfunctionname  in ('CPP Follow Up','TH Follow Up'))#(lf)   then 0#(lf)   else 1#(lf)   end as team_count#(lf)#(tab)from __temp #(lf)#(tab)  where teamenddateproxy >'2019-01-01'#(lf)   ),#(lf)   extradata as#(lf)   (  #(lf)   select#(lf)   concat(type1,',',teamname) as teamkey,#(lf)   concat(type1,',',teamid) as teamkey2,#(lf)   *, year(teamstartdate) as year_team_started,#(lf)   month(teamstartdate) as month_team_started,#(lf)   case when month(teamstartdate) = 1 then 'Jan'#(lf)   when month(teamstartdate) = 2 then 'Feb'#(lf)   when month(teamstartdate) = 3 then 'Mar'#(lf)   when month(teamstartdate) = 4 then 'Apr'#(lf)   when month(teamstartdate) = 5 then 'May'#(lf)   when month(teamstartdate) = 6 then 'Jun'#(lf)   when month(teamstartdate) = 7 then 'Jul'#(lf)   when month(teamstartdate) = 8 then 'Aug'#(lf)   when month(teamstartdate) = 9 then 'Sep'#(lf)   when month(teamstartdate) = 10 then 'Oct'#(lf)   when month(teamstartdate) = 11 then 'Nov'#(lf)   when month(teamstartdate) = 12 then 'Dec'#(lf)   else ''#(lf)   end as month_start_date_desc,#(lf)#(lf)   case when reportingteamfunction like '%housing%' then 'Housing'#(lf)   when ReportingTeamFunction like 'mind and%' then 'Mind and Body'#(lf)   else 'Health and Disability'#(lf)   end as TeamfunctionGroup,#(lf)   #(tab)case #(lf)#(tab)when type1 in ('mnb') then 'Mind and Body'#(lf)#(tab)#(lf)when teamfunctionname like '%Residential%' then 'Residential'#(lf)when teamfunctionname like '%Community%' or teamfunctionname like '%day progra%' then 'Community'#(lf)when teamfunctionname like '%Respite%' then 'Respite'#(lf)when TeamFunctioncode like 'hs%' then ' Housing'#(lf)#(tab)end as TeamFunctionGroup2,#(lf)   case when month(@reportingstart) = month(TeamStartDate) and year(@reportingstart) = year(TeamStartDate) then 1#(lf)#(tab)else 0 #(lf)#(tab)end as ReportingIndicatorStart,#(lf)#(tab)@reportingstart as ReportingMonth#(lf)#(lf)   from __finaldata#(lf)#(lf)   )#(lf)#(lf)   select#(lf)*,#(lf)   case when  teamfunctionname like '%sust%' then 'Sus Ten'#(lf)   when teamfunctionname like '%eh%' then 'Emergency'#(lf)   when teamfunctionname like '%th housing%' and teamname like '%motel%' then 'Trans Motel'#(lf)   when teamfunctionname = 'th motels' then 'Trans Motel'#(lf)   when teamfunctionname = 'th housing services' then 'Trans Housing'#(lf)   when teamfunctionname = 'th follow up' then 'Trans Follow Up'#(lf)   when teamfunctionname like 'cpp%' then 'CPP'#(lf)   else ''#(lf)   end as housing_type#(lf)   from extradata#(lf)  -- where teamfunctionname not like '%follow up%' and teamfunctionname not like 'cpp%'#(lf)  #(lf)   #(lf)   order by 6,4,3#(lf)\"]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"TeamStartDate\", type date}, {\"teamenddateproxy\", type datetime}}),",
