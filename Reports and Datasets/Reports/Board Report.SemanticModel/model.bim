        "lineageTag": "797882ba-67d5-4ac6-b55b-769cb6e103b7",
        "partitions": [
          {
            "name": "RBClients-f26178fb-1a80-4e18-a69d-4aeffd5a89ce",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Sql.Database(\"Synapseausprod-ondemand.sql.azuresynapse.net\", \"ODS\", [Query=\"#(lf)with __people as#(lf)(#(lf)#(lf)select#(lf)personid,#(lf)'EAL,'+cast(personstatusid as nvarchar) as personstatuskey,#(lf)personstatusstartdate, personstatusenddate,#(lf)PersonStatusTypeGroup,#(lf)PersonStatusTypeDescription,#(lf)dateadd(month, datediff(m,0,personstatusstartdate),0) as month_start ,#(lf)dateadd(month, datediff(m,0,personstatusenddate),0) as month_end,#(lf)concat('EAL,',personid) as personkey#(lf)#(lf)from rbeal.dlFactPersonStatus#(lf)inner join rbeal.dlDimPersonStatusType on dlFactPersonStatus.PersonStatusTypeID = dlDimPersonStatusType.PersonStatusTypeID#(lf)where PersonStatusTypeGroup = 'active' and#(lf)(personstatusenddate is null or personstatusenddate > '2019-12-31')#(lf)#(lf)union all#(lf)select#(lf)personid, #(lf)'MNB,'+cast(personstatusid as nvarchar) as personstatuskey,#(lf)personstatusstartdate, personstatusenddate,#(lf)PersonStatusTypeGroup,#(lf)PersonStatusTypeDescription,#(lf)dateadd(month, datediff(m,0,personstatusstartdate),0) as month_start ,#(lf)dateadd(month, datediff(m,0,personstatusenddate),0) as month_end,#(lf)concat('MNB,',personid) as personkey#(lf)#(lf)from rbmnb.dlFactPersonStatus#(lf)inner join rbmnb.dlDimPersonStatusType on dlFactPersonStatus.PersonStatusTypeID = dlDimPersonStatusType.PersonStatusTypeID#(lf)where (personstatusenddate is null or personstatusenddate > '2019-12-31')#(lf)and PersonStatusTypeGroup = 'active'#(lf)),#(lf)__goals as (#(lf)select personid,concat('EAL,',personid) as personkey  , GoalStartDate, #(lf)case when GoalCloseCompletedDate is not null then GoalCloseCompletedDate#(lf)when GoalCloseNotCompletedDate is not null then GoalCloseNotCompletedDate#(lf)end as goalenddate#(lf)from rbeal.dlfactgoal #(lf)union all#(lf)select personid,concat('MNB,',personid) as personkey ,GoalStartDate,#(lf)case when GoalCloseCompletedDate is not null then GoalCloseCompletedDate#(lf)when GoalCloseNotCompletedDate is not null then GoalCloseNotCompletedDate#(lf)end as goalenddate#(lf)from rbmnb.dlfactgoal #(lf)) ,#(lf)#(lf)FinalData as#(lf)(#(lf)  select#(lf)personid, personkey, personstatuskey, PersonStatusStartDate, isnull(personstatusenddate,getdate()) as personstatusenddate, #(lf) month_status_start, #(lf) month_status_end ,#(lf)case when numberofgoals = 0 then 0 else 1#(lf)end as ClientHasGoals#(lf)from#(lf)(#(lf)#(tab)select personid, personkey, personstatuskey, month_status_start, month_status_end,PersonStatusStartDate, PersonStatusEndDate, sum(goals_status) as numberofgoals#(lf)#(tab)from#(lf)#(tab)#(tab)(#(lf)#(tab)#(tab)select  #(lf)#(tab)#(tab)__people.personid, personstatuskey, PersonStatusStartDate,#(lf)#(tab)#(tab)__people.personkey,#(lf)#(tab)#(tab)cast (month_start as date) as month_status_start, personstatusenddate, #(lf)#(tab)#(tab)cast(month_end  as date) as month_status_end,#(lf)#(tab)#(tab)case when __goals.personid is null then 0 else 1 end as goals_status#(lf)#(tab)#(tab)from __people #(lf)#(tab)#(tab)#(lf)#(tab)#(tab)left join __goals on __people.personkey = __goals.personkey#(lf)#(tab)#(tab)and goalstartdate between personstatusstartdate and isnull(personstatusenddate,'2099-12-31')#(lf)#(tab)#(tab)) as data1 #(lf)#(tab)#(tab)group by PersonID, personkey,personstatuskey, month_status_start, month_status_end, PersonStatusStartDate, PersonStatusEndDate#(lf)#(tab)) as data2#(lf)#(tab))#(lf), opengoals as#(lf)(#(lf)select * from __goals#(lf)where goalenddate is null#(lf)),#(lf)#(lf)__PeopleDemo as#(lf)(#(lf)select#(lf)concat('EAL,',dldimperson.PersonID) as personkey,#(lf)gendertext,#(lf)dldimperson.persondateofbirth,#(lf)CONCAT(eth1.ethnicitytext,',', peth1.Ethnicitytext,',', eth2.EthnicityText,',', peth2.EthnicityText, ',',eth3.EthnicityText,',',peth3.EthnicityText)#(lf)as ethnicityall,#(lf)CONCAT(eth1.ethnicityvalue,',', peth1.Ethnicityvalue,',', eth2.Ethnicityvalue,',', peth2.Ethnicityvalue, ',',eth3.Ethnicityvalue,',',peth3.Ethnicityvalue)#(lf)as ethnicityvalue#(lf)#(lf)from #(lf)rbeal.dldimperson #(lf)left join rbeal.dldimgender on dlDimPerson.GenderID = dldimgender.genderid #(lf)left join rbeal.dldimethnicity as eth1 on dldimperson.ethnicity1id = eth1.ethnicityid#(lf)left join rbeal.dldimethnicity as peth1 on eth1.EthnicityParentId = peth1.ethnicityid#(lf)#(lf)left join rbeal.dldimethnicity as eth2 on dldimperson.ethnicity2id = eth2.ethnicityid#(lf)left join rbeal.dldimethnicity as peth2 on eth2.EthnicityParentId = peth2.ethnicityid#(lf)#(lf)left join rbeal.dldimethnicity as eth3 on dldimperson.ethnicity3id = eth3.ethnicityid#(lf)left join rbeal.dldimethnicity as peth3 on eth3.EthnicityParentId = peth3.ethnicityid#(lf)#(lf)Union all#(lf)#(lf)select#(lf)concat('MNB,',dldimperson.PersonID) as personkey,#(lf)gendertext,#(lf)dldimperson.persondateofbirth,#(lf)CONCAT(eth1.ethnicitytext,',', peth1.Ethnicitytext,',', eth2.EthnicityText,',', peth2.EthnicityText, ',',eth3.EthnicityText,',',peth3.EthnicityText)#(lf)as ethnicityall,#(lf)CONCAT(eth1.ethnicityvalue,',', peth1.Ethnicityvalue,',', eth2.Ethnicityvalue,',', peth2.Ethnicityvalue, ',',eth3.Ethnicityvalue,',',peth3.Ethnicityvalue)#(lf)as ethnicityvalue#(lf)#(lf)from#(tab)#(tab)rbmnb.dldimperson #(lf)left join rbmnb.dldimgender on dldimperson.genderid = dldimgender.genderid#(lf)left join#(tab)rbmnb.dldimethnicity as eth1 on dldimperson.ethnicity1id = eth1.ethnicityid#(lf)left join#(tab)rbmnb.dldimethnicity as peth1 on eth1.EthnicityParentId = peth1.ethnicityid#(lf)left join#(tab)rbmnb.dldimethnicity as eth2 on dldimperson.ethnicity2id = eth2.ethnicityid#(lf)left join#(tab)rbmnb.dldimethnicity as peth2 on eth2.EthnicityParentId = peth2.ethnicityid#(lf)left join#(tab)rbmnb.dldimethnicity as eth3 on dldimperson.ethnicity3id = eth3.ethnicityid#(lf)left join#(tab)rbmnb.dldimethnicity as peth3 on eth3.EthnicityParentId = peth3.ethnicityid#(lf)#(lf)),#(lf)__PeopleDemoFinal as#(lf)(#(lf)#(lf)select personkey, gendertext, persondateofbirth, ethnicityvalue, ethnicityall,#(lf)case when ethnicityvalue like '%,21,%' or ethnicityvalue like '21,%' or ethnicityvalue like '%,21'then 'Maori'#(lf)#(lf)when ethnicityvalue like '31,%' or ethnicityvalue like '%,31,%' then 'Pasifika'#(lf)when ethnicityvalue like '32,%' or ethnicityvalue like '33,%' or ethnicityvalue like '34,%' or ethnicityvalue like '35,%'#(lf)or ethnicityvalue like '36,%' or ethnicityvalue like '37,%'#(lf)then 'Pasifika'#(lf)when ethnicityvalue like '%,32,%' or ethnicityvalue like '%,33,%' or ethnicityvalue like '%,34,%' or ethnicityvalue like '%,35,%'#(lf)or ethnicityvalue like '%,36,%' or ethnicityvalue like '%,37,%'#(lf)then 'Pasifika'#(lf)when ethnicityvalue like '%,32%' or ethnicityvalue like '%,33%' or ethnicityvalue like '%,34%' or ethnicityvalue like '%,35%'#(lf)or ethnicityvalue like '%,36%' or ethnicityvalue like '%,37%' or ethnicityvalue like '%,30%'#(lf)or ethnicityvalue like '30,%'#(lf)then 'Pasifika'#(lf)#(lf)#(lf)when ethnicityvalue like '40,%' or ethnicityvalue like '%,40,%' then 'Asian'#(lf)when ethnicityvalue like '41,%' or ethnicityvalue like '%,41,%' then 'Asian'#(lf)when ethnicityvalue like '42,%' or ethnicityvalue like '43,%' or ethnicityvalue like '44,%' or ethnicityvalue like '45,%'#(lf)or ethnicityvalue like '46,%' or ethnicityvalue like '47,%'#(lf)then 'Asian'#(lf)when ethnicityvalue like '%,42,%' or ethnicityvalue like '%,43,%' or ethnicityvalue like '%,44,%' or ethnicityvalue like '%,45,%'#(lf)or ethnicityvalue like '%,46,%' or ethnicityvalue like '%,47,%'#(lf)then 'Asian'#(lf)when ethnicityvalue like '%,42%' or ethnicityvalue like '%,43%' or ethnicityvalue like '%,44%' or ethnicityvalue like '%,45%'#(lf)or ethnicityvalue like '%,46%' or ethnicityvalue like '%,47%'#(lf)then 'Asian'#(lf)when ethnicityall like '%Japanese%' or ethnicityall like '%Korean%' or ethnicityall like '%Cambodian%' #(lf)or ethnicityall like '%chinese%' or ethnicityall like '%Filipino%' #(lf)or ethnicityall like '%Sri Lankan%' or ethnicityall like '%Asian%'#(lf)or ethnicityall like '%vietnamese%'#(lf)then 'Asian'#(lf)#(lf)#(lf)when ethnicityvalue like '50,%' or ethnicityvalue like '%,50,%' then 'Middle Eastern, Latin American, African'#(lf)when ethnicityvalue like '51,%' or ethnicityvalue like '%,51,%' then 'Middle Eastern, Latin American, African'#(lf)when ethnicityvalue like '52,%' or ethnicityvalue like   '53,%' #(lf)then 'Middle Eastern, Latin American, African'#(lf)when ethnicityvalue like '%,52,%' or ethnicityvalue like '%,53,%' #(lf)then 'Middle Eastern, Latin American, African'#(lf)when ethnicityvalue like '%,52%' or ethnicityvalue like '%,53%'  #(lf)then 'Middle Eastern, Latin American, African'#(lf)#(lf) when #(lf) ethnicityvalue like '10,%' or ethnicityvalue like '%,10,%' or#(lf) ethnicityvalue like '11,%' or ethnicityvalue like '%,11,%' or ethnicityvalue like '12,%' or ethnicityvalue like '%,12,%'#(lf) then 'European' #(lf)#(lf) when ethnicityall like 'australian%' or ethnicityall like 'british%' or ethnicityall like 'dutch%'#(lf) or ethnicityall like 'german%' or ethnicityall like 'italian%' or ethnicityall like 'greek%' or ethnicityall like 'polish%'#(lf) or ethnicityall like '%european%' or ethnicityall  like '%slav%'#(lf) then 'European'#(lf)#(lf) when  ethnicityvalue like '%,54,%' or ethnicityvalue like '%,54%'#(lf) or ethnicityvalue like '54,%'#(lf) then 'Other'#(lf)#(lf)else 'Unknown'#(lf)end as ethnicitygroup #(lf)from __peopledemo#(lf)),#(lf)__finalfinaldata as#(lf)(select #(lf)#(tab)finaldata.*#(lf)#(tab),case #(lf)#(tab)when finaldata.personkey like 'eal%' then 'EAL'#(lf)#(tab)when finaldata.personkey like 'MNB%' then 'MnB'#(lf)#(tab)end as ClientCompany,#(lf)#(tab)case when opengoals.opengoal = 1 then 1#(lf)#(tab)else 0#(lf)#(tab)end as opengoalcount#(lf)#(lf)#(tab)from FinalData#(lf)#(tab)left join (select distinct personkey, 1 as opengoal from opengoals) as opengoals on finaldata.personkey = opengoals.personkey #(lf))#(lf), person_status_team as#(lf)(#(lf)--===== I'm trying to find a team for the status, so I have to join the person status to a referral....#(lf)--===== because there can be more than one, I'm taking the first one.  Ultimately it's the team function we want so they#(lf)-- should all be within the same.... can't do much about the data#(lf)select #(lf)row_number () over (partition by personstatusid order by personstatusid, PersonStatusStartDate, id) as row_count_status,#(lf)PersonStatusID,dlfactpersonstatus.personid,#(lf)'EAL,'+cast(personstatusid as nvarchar) as personstatusidkey,#(lf)dlfactpersonstatus.PersonStatusStartDate, personstatusenddate,#(lf)servicestartdate, serviceenddate, ReceivedDate, PendingDate, accepteddate,#(lf)id, 'EAL,'+cast(teamid as nvarchar) as teamid_key #(lf)#(lf)from rbeal.dlfactpersonstatus#(lf)left join rbeal.legacyFactReferral on dlFactPersonStatus.PersonID = legacyFactReferral.personid#(lf)and dlFactPersonStatus.PersonStatusStartDate = legacyFactReferral.ServiceStartDate#(lf)and dlFactPersonStatus.personstatusstartdate = legacyFactReferral.PendingDate#(lf)union all#(lf)select #(lf)row_number () over (partition by personstatusid order by personstatusid, PersonStatusStartDate, id) as row_count_status,#(lf)PersonStatusID,dlfactpersonstatus.personid,#(lf)'MNB,'+cast(personstatusid as nvarchar) as personstatusidkey,#(lf)dlfactpersonstatus.PersonStatusStartDate, personstatusenddate,#(lf)servicestartdate, serviceenddate, ReceivedDate, PendingDate, accepteddate,#(lf)id, 'MNB,'+cast(teamid as nvarchar) as teamid_key #(lf)#(lf)from rbmnb.dlfactpersonstatus#(lf)left join rbmnb.legacyFactReferral on dlFactPersonStatus.PersonID = legacyFactReferral.personid#(lf)and dlFactPersonStatus.PersonStatusStartDate = legacyFactReferral.ServiceStartDate#(lf)and dlFactPersonStatus.personstatusstartdate = legacyFactReferral.PendingDate#(lf)#(lf)),#(lf)person_status_team_first as#(lf)(select personid, personstatusid, teamid_key, row_count_status, personstatusidkey from person_status_team#(lf)where row_count_status = 1)#(lf)#(lf)select __finalfinaldata.*, gendertext, PersonDateOfBirth, ethnicitygroup, teamid_key from __finalfinaldata#(lf)left join __PeopleDemoFinal on __finalfinaldata.personkey = __PeopleDemoFinal.personkey#(lf)left join person_status_team_first on __finalfinaldata.personstatuskey = person_status_team_first.personstatusidkey#(lf)order by 1 ,3 #(lf)\"]),",
                "     #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"PersonStatusStartDate\", Int64.Type}, {\"personstatusenddate\", Int64.Type}}),",
                "     #\"Added Custom\" = Table.AddColumn(#\"Changed Type\", \"Explosion\", each {[PersonStatusStartDate]..[personstatusenddate]}),",
                "     #\"Expanded Explosion\" = Table.ExpandListColumn(#\"Added Custom\", \"Explosion\"),",
                "    #\"Changed Type1\" = Table.TransformColumnTypes(#\"Expanded Explosion\",{{\"PersonStatusStartDate\", type date}, {\"personstatusenddate\", type date}, {\"Explosion\", type date}}),",
                "      #\"Added Custom1\" = Table.AddColumn(#\"Changed Type1\", \"EndofMonth\", each Date.EndOfMonth([Explosion])),",
                "    #\"Added Conditional Column\" = Table.AddColumn(#\"Added Custom1\", \"EoMIndicator\", each if [Explosion] = [EndofMonth] then 1 else 0),",
                "    #\"Filtered Rows\" = Table.SelectRows(#\"Added Conditional Column\", each [EoMIndicator] = 1),",
                "    #\"Reordered Columns\" = Table.ReorderColumns(#\"Filtered Rows\",{\"personid\", \"personkey\", \"PersonStatusStartDate\", \"personstatusenddate\", \"month_status_start\", \"month_status_end\", \"ClientHasGoals\", \"opengoalcount\", \"ClientCompany\", \"Explosion\", \"EndofMonth\", \"EoMIndicator\"}),",
                "    #\"Changed Type2\" = Table.TransformColumnTypes(#\"Reordered Columns\",{{\"PersonDateOfBirth\", type date}, {\"Explosion\", type date}}),",
                "    #\"Added Custom2\" = Table.AddColumn(#\"Changed Type2\", \"Custom\", each ([Explosion]-[PersonDateOfBirth])/365.25),",
                "    #\"Changed Type3\" = Table.TransformColumnTypes(#\"Added Custom2\",{{\"Custom\", type number}}),",
                "    #\"Added Custom3\" = Table.AddColumn(#\"Changed Type3\", \"Custom.1\", each Number.RoundDown([Custom])),",
                "    #\"Added Conditional Column1\" = Table.AddColumn(#\"Added Custom3\", \"Custom.2\", each if [Custom.1] <=20 then \"0-20\" else if [Custom.1] <31",
                "then \"21-30\" else if [Custom.1] <41 then \"31-40\" else if [Custom.1] <51 then \"41-50\" else if [Custom.1] < 61 then \"51-60\"",
                "else if [Custom.1]>60 then \"61 and Over\"",
                "else \"Unknown\"),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Added Conditional Column1\",{{\"Custom.2\", \"AgeGroupClient\"}}),",
                "    #\"Filtered Rows1\" = Table.SelectRows(#\"Renamed Columns\", each true)",
                "in",
                "    #\"Filtered Rows1\""
              ],
              "type": "m"
            }
          }
        ]
      },
