        "dataCategory": "Time",
        "lineageTag": "5def13e7-64af-41b3-b1d6-aa7b1ff2e525",
        "partitions": [
          {
            "name": "DimDate-317f8911-c8ba-477c-90ac-95669f8050ac",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Sql.Database(",
                "        \"eal-sql01.database.windows.net\", \"Recordbase_EmergeAotearoa_Elite\", ",
                "    [Query=\"",
                "    #(lf)#(lf)--====they've decided they only want to report 2 months ago November 2023, changed to -1 in January 2024",
                "",
                "    #(lf)declare @reportingstart1 date = dateadd(month,-1,getdate())",
                "",
                "    #(lf)declare @reportingstart date = dateadd(day,1-day(@reportingstart1),@reportingstart1)",
                "    #(lf)#(lf)declare @reportingstartyearago date = dateadd(year,-1, @reportingstart) ",
                "    #(lf)declare @reportingstartyearmonth date = dateadd(month,+1,@reportingstartyearago)",
                "    #(lf)#(lf)declare @start15months date = dateadd(month,-1,@reportingstartyearago)",
                "    #(lf)declare @reportinglastmonth date = dateadd(month,-1,@reportingstart)",
                "    ",
                "    #(lf)#(lf)declare @startdate date = '1900-01-01'",
                "    #(lf)declare @enddate  date = dateadd(month,+1,@reportingstart)",
                "    #(lf)#(lf)",
                "    --select @reportingstartyearago#(lf)--select @reportingstartyearmonth#(lf)",
                "    --select @start15months#(lf)--Select @reportingstart#(lf)",
                "    --select @enddate#(lf)#(lf)#(lf)",
                "    --drop table #createddate #(lf)--drop table #createddate2#(lf)--drop table #createddate3#(lf)",
                "    --+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++",
                "    #(lf)#(lf)create table #createddate (created_date date)#(lf)while @startdate < @enddate begin ",
                "    #(lf)#(tab)insert into #createddate (created_date)",
                "    #(lf)select @startdate",
                "    #(lf)set @startdate = dateadd(day,1,@startdate)#(lf)end#(lf)#(tab)#(lf)select created_date",
                "    #(lf)         , created_date as calendardate#(lf)#(tab), year(created_date) as calendar_year_createddate",
                "    #(lf)#(tab), month(created_date) as month_createddate#(lf)#(tab), case when month(created_date) <=6 then month(created_date)+6",
                "    #(lf)#(tab)  else month(created_date)-6#(lf)#(tab)  end as financial_month#(lf)#(tab)   ,case when month(created_date) <=6 then year(created_date)#(lf)",
                "    #(tab)   ELSE YEAR(CREATED_DATE)+1#(lf)#(tab)   END AS Financial_Year_no#(lf)#(tab), row_number () over ( order by created_date desc) as date_number#(lf)#(tab), case ",
                "    #(lf)#(tab)when month(created_date) = 7 then 'Jul'#(lf)#(tab)when month(created_date) = 8 then 'Aug'#(lf)#(tab)when month(created_date) = 9 then 'Sep'",
                "    #(lf)#(tab)when month(created_date) = 10 then 'Oct'#(lf)#(tab)when month(created_date) = 11 then 'Nov'#(lf)#(tab)when month(created_date) = 12 then 'Dec'",
                "    #(lf)#(tab)when month(created_date) = 1 then 'Jan'#(lf)#(tab)when month(created_date) = 2 then 'Feb'#(lf)#(tab)when month(created_date) = 3 then 'Mar'",
                "    #(lf)#(tab)when month(created_date) = 4 then 'Apr'#(lf)#(tab)when month(created_date) = 5 then 'May'#(lf)#(tab)when month(created_date) = 6 then 'Jun'",
                "    #(lf)#(tab)end as FinMonthName,#(lf)#(tab)case when month(created_date) < 10  and day(created_date) < 10 then ",
                "    #(lf)#(tab)cast(concat(year(created_date) ,'-0',month(created_date),'-01') as date)",
                "    #(lf)#(tab)else#(lf)#(tab)cast(concat(year(created_date) ,'-',month(created_date),'-01') as date)",
                "    #(lf)#(tab)end as calendar_month_start #(lf)#(tab)into #createddate2#(lf)#(tab)from #createddate ",
                "    #(lf)#(lf)#(lf)#(tab)select *, @reportingstart as reporting_start,#(lf)#(tab)case when month(@reportingstart) = month(created_date) and year(@reportingstart) = year(created_date) then 1",
                "    #(lf)#(tab)else 0 #(lf)#(tab)end as reporting_indicator,",
                "    #(lf)#(tab)#(lf)#(tab)case when created_date >= @start15months and created_date < dateadd(month,+1,@reportingstart)#(lf)#(tab)then 1",
                "    #(lf)#(tab)else 0#(lf)#(tab)end as reporting_indicator_year,",
                "    #(lf)#(tab)#(lf)#(tab)case when year(created_date) = year(@reportinglastmonth) and month(created_date) = month(@reportinglastmonth)#(lf)#(tab)then 1",
                "    #(lf)#(tab)else 0#(lf)#(tab)end as reporting_last_month_indicator,#(lf)#(tab)#(lf)#(tab)case when year(created_date) = year(@reportingstartyearago) and month(created_date) = month(@reportingstartyearago)",
                "    #(lf)#(tab)then 1#(lf)#(tab)else 0#(lf)#(tab)end as reporting_last_year_indicator#(lf)#(tab)from #createddate2#(lf)#(tab)",
                "    #(lf)#(tab)",
                "    #(lf)#(tab)#(lf)#(tab)order by created_date #(lf)#(lf)#(tab)\"]),",
                "",
                "    #\"Renamed Columns\" = Table.RenameColumns(Source,{{\"calendardate\", \"calendar_date\"}}),",
                "    #\"Removed Columns\" = Table.RemoveColumns(#\"Renamed Columns\",{\"calendar_date\"}),",
                "    #\"Renamed Columns1\" = Table.RenameColumns(#\"Removed Columns\",{{\"created_date\", \"calendar_date\"}}),",
                "    #\"Renamed Columns2\" = Table.RenameColumns(#\"Renamed Columns1\",{{\"calendar_year_createddate\", \"CalendarYear\"}}),",
                "    ",
                "    // Change \"calendar_date\" type from DateTime to Date",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Renamed Columns2\",{{\"calendar_date\", type date}}),",
                "    ",
                "    // Reference the parameter \"Reporting Months Ago\"",
                "    ReportingPeriod = #\"Reporting Months Ago\",",
                "",
                "    // Get the current date and time, and then extract just the date",
                "    // DateTime.LocalNow() returns the current date and time, DateTime.Date() extracts just the date part",
                "    Today = DateTime.LocalNow(),",
                "    TodayDate = DateTime.Date(Today),",
                "    ",
                "    // Calculate the target month and year based on the current date and the ReportingPeriod parameter",
                "    TargetDate = Date.AddMonths(TodayDate, -ReportingPeriod),",
                "    ",
                "    // Create a list of 12 months starting from TargetDate and going 12 months back",
                "    // List.Transform() applies a function to each item in the original list ({0..12} in this case)",
                "    TwelveMonthsList = List.Transform({0..12}, each Date.ToText(Date.AddMonths(TargetDate, -_), \"yyyy-MM\")),",
                "    ",
                "    // Add a new dynamic calculated column for Reporting Month",
                "    // This column will label each month relative to the Reporting Month",
                "    #\"Added Reporting Month\" = Table.AddColumn(#\"Changed Type\", \"Reporting Month\", each ",
                "        let",
                "            // Extract the calendar_date from the current row",
                "            CurrentDate = [calendar_date],",
                "            ",
                "            // Convert the calendar_date to a string in \"yyyy-MM\" format for easier comparison",
                "            CurrentDateStr = Date.ToText(CurrentDate, \"yyyy-MM\"),",
                "            ",
                "            // Find the position of the current month in the TwelveMonthsList",
                "            // If the month is not found, List.PositionOf() returns -1",
                "            MonthOffset = List.PositionOf(TwelveMonthsList, CurrentDateStr)",
                "        in",
                "            // Label the month based on its position in the TwelveMonthsList",
                "            if MonthOffset = 0 then \"Reporting Month\"",
                "            else if MonthOffset = 1 then \"1 Month Prior to Reporting Month\"",
                "            else if MonthOffset > 1 then Text.From(MonthOffset) & \" Months Prior to Reporting Month\"",
                "            else \"\"",
                "    )",
                "in",
                "    #\"Added Reporting Month\""
              ],
              "type": "m"
            }
          }
        ]
      },
