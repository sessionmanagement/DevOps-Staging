        "partitions": [
          {
            "name": "AcceptedReferrals-44ce6b1d-5e9a-43b8-a7c5-c6a1a6093c5f",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Sql.Database(\"Synapseausprod-ondemand.sql.azuresynapse.net\", \"ODS\", [Query=\"with #(lf)__alldata as#(lf)(#(lf)#(lf)SELECT #(lf)'EAL' as company,#(lf)dlfactreferralstatus.ReferralID,#(lf)dlfactreferral.personid,#(lf)referralstatusstartdate,#(lf)referralstatustypecode, #(lf)referralstatustypegroup, #(lf)referralstatustypestatusorder,#(lf)dldimteam.teamid,#(lf)teamname , #(lf)teamfunctioncode,#(lf)teamfunctionname,#(lf)ReferralStatusTypeReasonDescription,#(lf)case #(lf)when teamname like '%Ease%Up%' then 'Ease Up'  --teamfunctionname = 'Youth - Community'#(lf)when teamfunctionname like '%Residential%' then 'Residential'#(lf)when teamfunctionname like '%Community%' or teamfunctionname like '%day progra%' then 'Community'#(lf)when teamfunctionname like '%Respite%' then 'Respite'#(lf)when TeamFunctioncode like 'hs%' then 'Housing'#(lf)#(tab)end as ReportingTeamFunction#(lf)#(lf) #(lf) FROM rbeal.dlFactReferralStatus#(lf)#(lf)  inner join rbeal.dlDimReferralStatusType#(tab)#(tab)#(tab)on dlFactReferralStatus.ReferralStatusTypeID#(tab)#(tab)= dlDimReferralStatusType.ReferralStatusTypeID#(lf)  inner join rbeal.dlfactreferral#(tab)#(tab)#(tab)#(tab)#(tab)on dlFactReferralStatus.referralid#(tab)#(tab)#(tab)#(tab)#(tab)= dlfactreferral.referralid#(lf)  inner join rbeal.dldimteam#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)on dlfactreferral.teamid#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)= dldimteam.teamid#(lf)  inner join rbeal.dlDimTeamFunction#(tab)#(tab)#(tab)#(tab)on dldimteam.TeamFunctionID#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)= dldimteamfunction.TeamFunctionID#(lf)  left join  rbeal.dlDimReferralStatusTypeReason#(tab)on dlFactReferralStatus.ReferralStatusTypeReasonID#(tab)= dlDimReferralStatusTypeReason.ReferralStatusTypeReasonID#(lf)#(lf)  where #(lf)   referralstatusstartdate > '2020-01-01'#(lf)   and TeamName not in ('Whariki Day Prog','Auckland Adult Mobile- Clinical','Jansen House: Clinical','Mapusaga Clinical','Nga Taumahatanga Clinical'