          {
            "name": "% of Exits",
            "changedProperties": [
              {
                "property": "Name"
              },
              {
                "property": "FormatString"
              }
            ],
            "expression": [
              "DIVIDE(",
              "   SUM(AllDischargeData[Count of Exit Reasons]),",
              "   CALCULATE(SUM(AllDischargeData[Count of Exit Reasons]), ALL('AllDischargeData'[Exit Reasons Grouped]))",
              ")"
            ],
            "formatString": "0%;-0%;0%",
            "lineageTag": "b6221336-5aec-4658-bc53-1a0a029a82c4"
          }
        ],
