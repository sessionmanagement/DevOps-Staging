            "source": {
              "expression": [
                "/*let",
                "    Source = HousingDishargesAllData,",
                "    #\"Removed Other Columns\" = Table.SelectColumns(Source,{\"Exit Reason\", \"Discharge Month\", \"Discharge Date\"}),",
                "    #\"Changed Type1\" = Table.TransformColumnTypes(#\"Removed Other Columns\",{{\"Discharge Date\", type date}}),",
                "    Grouped = Table.Group(#\"Changed Type1\", {\"Discharge Month\", \"Exit Reason\"}, {{\"Count of Exit Reasons\", each List.Count([Exit Reason]), type nullable text}}),",
                "    #\"Grouped by Month\" = Table.Group(Grouped, {\"Exit Reason\"}, {",
                "        {\"All Rows\", each Table.Sort(_,{{\"Count of Exit Reasons\", Order.Descending}}), type table},",
                "        {\"Total Count of Exit Reasons\", each List.Sum([Count of Exit Reasons]), type number}  // Adding a column to sum \"Count of Exit Reasons\"",
                "    }),",
                "    #\"Sorted Rows\" = Table.Sort(#\"Grouped by Month\",{{\"Total Count of Exit Reasons\", Order.Descending}}),",
                "    #\"Added Index\" = Table.AddIndexColumn(#\"Sorted Rows\", \"Index\", 1, 1, Int64.Type),",
                "    #\"Custom Index\" = Table.TransformColumns(#\"Added Index\", {\"Index\", each if _ >= 11 then 11 else _, Int64.Type}),",
                "    #\"Expanded All Rows\" = Table.ExpandTableColumn(#\"Custom Index\", \"All Rows\", {\"Discharge Month\", \"Count of Exit Reasons\"}, {\"Discharge Month\", \"Count of Exit Reasons\"}),",
                "    #\"Removed Columns\" = Table.RemoveColumns(#\"Expanded All Rows\",{\"Total Count of Exit Reasons\"}),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Removed Columns\",{{\"Count of Exit Reasons\", Int64.Type}, {\"Discharge Month\", type text}, {\"Index\", Int64.Type}})",
                "in",
                "    #\"Changed Type\"*/",
                "let",
                "    Source = HousingDischargesAllData,",
                "    #\"Renamed Columns\" = Table.RenameColumns(Source,{{\"Discharge Month\", \"Discharge Month OLD\"}}),",
                "    #\"Inserted Merged Column\" = Table.AddColumn(#\"Renamed Columns\", \"Discharge Month\", each Text.Combine({Text.From([DischargeMonthSorting], \"en-NZ\"), \"_\", [Discharge Month OLD]}), type text),",
                "    #\"Removed Other Columns\" = Table.SelectColumns(#\"Inserted Merged Column\",{\"Exit Reason\", \"Discharge Month\"}),",
                "    Grouped = Table.Group(#\"Removed Other Columns\", {\"Discharge Month\", \"Exit Reason\"}, {{\"Count of Exit Reasons\", each List.Count([Exit Reason]), type nullable text}}),",
                "    #\"Grouped by Month\" = Table.Group(Grouped, {\"Exit Reason\"}, {",
                "        {\"All Rows\", each Table.Sort(_,{{\"Count of Exit Reasons\", Order.Descending}}), type table},",
                "        {\"Total Count of Exit Reasons\", each List.Sum([Count of Exit Reasons]), type number}  // Adding a column to sum \"Count of Exit Reasons\"",
                "    }),",
                "    #\"Sorted Rows\" = Table.Sort(#\"Grouped by Month\",{{\"Total Count of Exit Reasons\", Order.Descending}}),",
                "    #\"Added Index\" = Table.AddIndexColumn(#\"Sorted Rows\", \"Index\", 1, 1, Int64.Type),",
                "    #\"Custom Index\" = Table.TransformColumns(#\"Added Index\", {\"Index\", each if _ >= 11 then 11 else _, Int64.Type}),",
                "    #\"Expanded All Rows\" = Table.ExpandTableColumn(#\"Custom Index\", \"All Rows\", {\"Discharge Month\", \"Count of Exit Reasons\"}, {\"Discharge Month\", \"Count of Exit Reasons\"}),",
                "    #\"Removed Columns\" = Table.RemoveColumns(#\"Expanded All Rows\",{\"Total Count of Exit Reasons\"}),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Removed Columns\",{{\"Count of Exit Reasons\", Int64.Type}, {\"Discharge Month\", type text}, {\"Index\", Int64.Type}}),",
                "    #\"Split Column by Delimiter\" = Table.SplitColumn(#\"Changed Type\", \"Discharge Month\", Splitter.SplitTextByDelimiter(\"_\", QuoteStyle.Csv), {\"Discharge Month.1\", \"Discharge Month.2\"}),",
                "    #\"Changed Type1\" = Table.TransformColumnTypes(#\"Split Column by Delimiter\",{{\"Discharge Month.1\", Int64.Type}, {\"Discharge Month.2\", type text}}),",
                "    #\"Renamed Columns1\" = Table.RenameColumns(#\"Changed Type1\",{{\"Discharge Month.2\", \"Discharge Month\"}, {\"Discharge Month.1\", \"Discharge Month Number\"}})",
                "in",
                "    #\"Renamed Columns1\""
              ],
              "type": "m"
            }
          }
        ]
