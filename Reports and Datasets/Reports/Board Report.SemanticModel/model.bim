        "lineageTag": "66e014e9-f461-4514-bab5-1448f511d5a3",
        "measures": [
          {
            "name": "Received NoBlank",
            "expression": [
              "",
              "VAR Received_ = calculate(sum('Received Referrals'[received]))",
              "Return",
              "if(isblank(Received_),0,Received_)"
            ],
            "formatString": "0",
            "lineageTag": "986e6c63-8a61-4074-9b80-1abffaa2da5b"
          },
          {
            "name": "Declined Referrals as % of Total",
            "expression": [
              "",
              "VAR Declined_ = ",
              "    CALCULATE(",
              "        IF(ISBLANK(SUM('Received Referrals'[received])), 0, SUM('Received Referrals'[received])),",
              "        'Received Referrals'[referraloutcome] = \"declined\"",
              "    )",
              "VAR TotalReceived_ =",
              "    CALCULATE(",
              "        IF(ISBLANK(SUM('Received Referrals'[received])), 0, SUM('Received Referrals'[received])),",
              "        ALLSELECTED('Ethnicity Group')",
              "    )",
              "RETURN",
              "    DIVIDE(",
              "        Declined_,",
              "        TotalReceived_,",
              "        0",
              "    )"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "60ae7252-753c-4eb4-98ee-a9efb3aef7d4"
          },
          {
            "name": "Declined Referrals as %",
            "expression": [
              "",
              "VAR Declined_ = ",
              "    CALCULATE(",
              "        IF(ISBLANK(SUM('Received Referrals'[received])), 0, SUM('Received Referrals'[received])),",
              "        'Received Referrals'[referraloutcome] = \"declined\"",
              "    )",
              "VAR TotalReceived_ =",
              "    CALCULATE(",
              "        IF(ISBLANK(SUM('Received Referrals'[received])), 0, SUM('Received Referrals'[received]))",
              "    )",
              "RETURN",
              "    DIVIDE(",
              "        Declined_,",
              "        TotalReceived_,",
              "        0",
              "    )"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "0600fc22-43cd-4594-8a45-48333ebd81ed"
          }
        ],
        "partitions": [
          {
            "name": "Received Referrals",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Sql.Database(\"Synapseausprod-ondemand.sql.azuresynapse.net\", \"ODS\", [Query=\"with #(lf)__alldata as#(lf)(#(lf)SELECT #(lf)#(tab)'EAL' as company,#(lf)#(tab)id as ReferralID,#(lf)#(tab)1 as received,#(lf)#(tab)personid,#(lf)#(tab)receiveddate,#(lf)#(tab)dldimteam.teamid,#(lf)#(tab)teamname , #(lf)#(tab)teamfunctioncode,#(lf)#(tab)teamfunctionname,#(lf)#(tab)case #(lf)#(tab)#(tab)when teamname like '%Ease%Up%' then 'Ease Up'  --teamfunctionname = 'Youth - Community'#(lf)#(tab)#(tab)when teamfunctionname like '%Residential%' then 'Residential'#(lf)#(tab)#(tab)when teamfunctionname like '%Community%' or teamfunctionname like '%day progra%' then 'Community'#(lf)#(tab)#(tab)when teamfunctionname like '%Respite%' then 'Respite'#(lf)#(tab)#(tab)when TeamFunctioncode like 'hs%' then 'Housing'#(lf)#(tab)end as ReportingTeamFunction,#(lf)#(tab)ReferrerDescription,#(lf)#(tab)case when accepteddate is not null then 'accepted'#(lf)when declinedate is not null then 'declined'#(lf)when WaitlistDate is not null #(lf)or pendingdate is not null then 'pending/wait listed'#(lf)#(lf)else ''#(lf)end as referraloutcome,#(lf)case when DischargeDate is not null then 'Discharged'#(lf)else ''#(lf)end as discharged#(lf)#(lf)#(lf)FROM rbeal.legacyfactreferral#(lf)inner join rbeal.dldimteam#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)on legacyfactreferral.teamid#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)= dldimteam.teamid#(lf)inner join rbeal.dlDimTeamFunction#(tab)#(tab)#(tab)#(tab)on dldimteam.TeamFunctionID#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)= dldimteamfunction.TeamFunctionID#(lf)left join rbeal.dlDimReferrer#(tab)#(tab)#(tab)#(tab)#(tab)on legacyFactReferral.SourceReferrerID#(tab)#(tab)#(tab)#(tab)= dlDimReferrer.ReferrerID#(lf)where receiveddate >= '2020-01-01'#(lf)#(tab)and TeamName not in #(lf)#(tab)('Whariki Day Prog','Auckland Adult Mobile- Clinical','Jansen House: Clinical','Mapusaga Clinical','Nga Taumahatanga Clinical','Phoenix Clinical',#(lf)   'WDHB Mainstream (Clinical)','WDHB Pacific (Clinical)')#(lf)#(tab)and teamfunctionname not in ('CPP Follow Up','TH Follow Up')  -- excluding followup teams - Simon/Wendy 25-05-2023#(lf)union all#(lf)select #(lf)#(tab)'MNB' as company,#(lf)#(tab)id as ReferralID,#(lf)#(tab)1 as received,#(lf)#(tab)personid,#(lf)#(tab)receiveddate,#(lf)#(tab)dldimteam.teamid,#(lf)#(tab)teamname , #(lf)#(tab)teamfunctioncode,#(lf)#(tab)teamfunctionname,#(lf)#(tab)'Mind and Body' as ReportingTeamFunction,#(lf)#(tab)ReferrerDescription,#(lf)#(tab)case when accepteddate is not null then 'accepted'#(lf)when declinedate is not null then 'declined'#(lf)when WaitlistDate is not null #(lf)or pendingdate is not null then 'pending/wait listed'#(lf)#(lf)else ''#(lf)end as referraloutcome,#(lf)case when DischargeDate is not null then 'Discharged'#(lf)else ''#(lf)end as discharged#(lf) FROM rbmnb.legacyfactreferral#(lf)  inner join rbeal.dldimteam#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)on legacyfactreferral.teamid#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)= dldimteam.teamid#(lf)  inner join rbeal.dlDimTeamFunction#(tab)#(tab)#(tab)#(tab)on dldimteam.TeamFunctionID#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)= dldimteamfunction.TeamFunctionID#(lf)  left join rbeal.dlDimReferrer#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)on legacyFactReferral.SourceReferrerID#(tab)#(tab)#(tab)#(tab)= dlDimReferrer.ReferrerID#(lf)  where receiveddate >= '2020-01-01'#(lf)),#(lf)#(tab)__PeopleDemo as#(lf)(#(lf)select#(lf)concat('EAL,',dldimperson.PersonID) as personkey,#(lf)gendertext,#(lf)dldimperson.persondateofbirth,#(lf)CONCAT(eth1.ethnicitytext,',', peth1.Ethnicitytext,',', eth2.EthnicityText,',', peth2.EthnicityText, ',',eth3.EthnicityText,',',peth3.EthnicityText)#(lf)as ethnicityall,#(lf)CONCAT(eth1.ethnicityvalue,',', peth1.Ethnicityvalue,',', eth2.Ethnicityvalue,',', peth2.Ethnicityvalue, ',',eth3.Ethnicityvalue,',',peth3.Ethnicityvalue)#(lf)as ethnicityvalue#(lf)#(lf)from #(lf)rbeal.dldimperson #(lf)left join rbeal.dldimgender on dlDimPerson.GenderID = dldimgender.genderid #(lf)left join rbeal.dldimethnicity as eth1 on dldimperson.ethnicity1id = eth1.ethnicityid#(lf)left join rbeal.dldimethnicity as peth1 on eth1.EthnicityParentId = peth1.ethnicityid#(lf)#(lf)left join rbeal.dldimethnicity as eth2 on dldimperson.ethnicity2id = eth2.ethnicityid#(lf)left join rbeal.dldimethnicity as peth2 on eth2.EthnicityParentId = peth2.ethnicityid#(lf)#(lf)left join rbeal.dldimethnicity as eth3 on dldimperson.ethnicity3id = eth3.ethnicityid#(lf)left join rbeal.dldimethnicity as peth3 on eth3.EthnicityParentId = peth3.ethnicityid#(lf)#(lf)Union all#(lf)#(lf)select#(lf)concat('MNB,',dldimperson.PersonID) as personkey,#(lf)gendertext,#(lf)dldimperson.persondateofbirth,#(lf)CONCAT(eth1.ethnicitytext,',', peth1.Ethnicitytext,',', eth2.EthnicityText,',', peth2.EthnicityText, ',',eth3.EthnicityText,',',peth3.EthnicityText)#(lf)as ethnicityall,#(lf)CONCAT(eth1.ethnicityvalue,',', peth1.Ethnicityvalue,',', eth2.Ethnicityvalue,',', peth2.Ethnicityvalue, ',',eth3.Ethnicityvalue,',',peth3.Ethnicityvalue)#(lf)as ethnicityvalue#(lf)#(lf)from#(tab)#(tab)rbmnb.dldimperson #(lf)left join rbmnb.dldimgender on dldimperson.genderid = dldimgender.genderid#(lf)left join#(tab)rbmnb.dldimethnicity as eth1 on dldimperson.ethnicity1id = eth1.ethnicityid#(lf)left join#(tab)rbmnb.dldimethnicity as peth1 on eth1.EthnicityParentId = peth1.ethnicityid#(lf)left join#(tab)rbmnb.dldimethnicity as eth2 on dldimperson.ethnicity2id = eth2.ethnicityid#(lf)left join#(tab)rbmnb.dldimethnicity as peth2 on eth2.EthnicityParentId = peth2.ethnicityid#(lf)left join#(tab)rbmnb.dldimethnicity as eth3 on dldimperson.ethnicity3id = eth3.ethnicityid#(lf)left join#(tab)rbmnb.dldimethnicity as peth3 on eth3.EthnicityParentId = peth3.ethnicityid#(lf)#(lf)),#(lf)__PeopleDemoFinal as#(lf)(#(lf)#(lf)select personkey, gendertext, persondateofbirth, ethnicityvalue, ethnicityall,#(lf)case when ethnicityvalue like '%,21,%' or ethnicityvalue like '21,%' or ethnicityvalue like '%,21'then 'Maori'#(lf)#(lf)when ethnicityvalue like '31,%' or ethnicityvalue like '%,31,%' then 'Pasifika'#(lf)when ethnicityvalue like '32,%' or ethnicityvalue like '33,%' or ethnicityvalue like '34,%' or ethnicityvalue like '35,%'#(lf)or ethnicityvalue like '36,%' or ethnicityvalue like '37,%'#(lf)then 'Pasifika'#(lf)when ethnicityvalue like '%,32,%' or ethnicityvalue like '%,33,%' or ethnicityvalue like '%,34,%' or ethnicityvalue like '%,35,%'#(lf)or ethnicityvalue like '%,36,%' or ethnicityvalue like '%,37,%'#(lf)then 'Pasifika'#(lf)when ethnicityvalue like '%,32%' or ethnicityvalue like '%,33%' or ethnicityvalue like '%,34%' or ethnicityvalue like '%,35%'#(lf)or ethnicityvalue like '%,36%' or ethnicityvalue like '%,37%' or ethnicityvalue like '%,30%'#(lf)or ethnicityvalue like '30,%'#(lf)then 'Pasifika'#(lf)#(lf)#(lf)when ethnicityvalue like '40,%' or ethnicityvalue like '%,40,%' then 'Asian'#(lf)when ethnicityvalue like '41,%' or ethnicityvalue like '%,41,%' then 'Asian'#(lf)when ethnicityvalue like '42,%' or ethnicityvalue like '43,%' or ethnicityvalue like '44,%' or ethnicityvalue like '45,%'#(lf)or ethnicityvalue like '46,%' or ethnicityvalue like '47,%'#(lf)then 'Asian'#(lf)when ethnicityvalue like '%,42,%' or ethnicityvalue like '%,43,%' or ethnicityvalue like '%,44,%' or ethnicityvalue like '%,45,%'#(lf)or ethnicityvalue like '%,46,%' or ethnicityvalue like '%,47,%'#(lf)then 'Asian'#(lf)when ethnicityvalue like '%,42%' or ethnicityvalue like '%,43%' or ethnicityvalue like '%,44%' or ethnicityvalue like '%,45%'#(lf)or ethnicityvalue like '%,46%' or ethnicityvalue like '%,47%'#(lf)then 'Asian'#(lf)when ethnicityall like '%Japanese%' or ethnicityall like '%Korean%' or ethnicityall like '%Cambodian%' #(lf)or ethnicityall like '%chinese%' or ethnicityall like '%Filipino%' #(lf)or ethnicityall like '%Sri Lankan%' or ethnicityall like '%Asian%'#(lf)or ethnicityall like '%vietnamese%'#(lf)then 'Asian'#(lf)#(lf)#(lf)when ethnicityvalue like '50,%' or ethnicityvalue like '%,50,%' then 'Middle Eastern, Latin American, African'#(lf)when ethnicityvalue like '51,%' or ethnicityvalue like '%,51,%' then 'Middle Eastern, Latin American, African'#(lf)when ethnicityvalue like '52,%' or ethnicityvalue like   '53,%' #(lf)then 'Middle Eastern, Latin American, African'#(lf)when ethnicityvalue like '%,52,%' or ethnicityvalue like '%,53,%' #(lf)then 'Middle Eastern, Latin American, African'#(lf)when ethnicityvalue like '%,52%' or ethnicityvalue like '%,53%'  #(lf)then 'Middle Eastern, Latin American, African'#(lf)#(lf) when #(lf) ethnicityvalue like '10,%' or ethnicityvalue like '%,10,%' or#(lf) ethnicityvalue like '11,%' or ethnicityvalue like '%,11,%' or ethnicityvalue like '12,%' or ethnicityvalue like '%,12,%'#(lf) then 'European' #(lf)#(lf) when ethnicityall like 'australian%' or ethnicityall like 'british%' or ethnicityall like 'dutch%'#(lf) or ethnicityall like 'german%' or ethnicityall like 'italian%' or ethnicityall like 'greek%' or ethnicityall like 'polish%'#(lf) or ethnicityall like '%european%' or ethnicityall  like '%slav%'#(lf) then 'European'#(lf)#(lf) when  ethnicityvalue like '%,54,%' or ethnicityvalue like '%,54%'#(lf) or ethnicityvalue like '54,%'#(lf) then 'Other'#(lf)#(lf)else 'Unknown'#(lf)end as ethnicitygroup #(lf)from __peopledemo#(lf)),#(lf)finalfinalfinal as#(lf)(#(lf)select  #(lf) concat(company,',',teamname) as teamkey, #(lf) concat(company,',',teamid) as teamkey2, #(lf) concat(company,',',personid) as personkey,#(lf) *   #(lf)   from __alldata#(lf)   )#(lf)#(lf)   select #(lf)   'Received' as ReferralType,#(lf)   finalfinalfinal.teamkey,#(lf)   finalfinalfinal.teamkey2,#(lf)   finalfinalfinal.personkey,#(lf)   finalfinalfinal.company as ReferralAcceptCompany,#(lf)   referralid as receivedreferral,#(lf)   ReceivedDate,#(lf)   received,#(lf)   teamname,#(lf)   teamfunctionname,#(lf)   reportingteamfunction,#(lf)   gendertext, #(lf)   persondateofbirth, #(lf)   ethnicitygroup  ,#(lf)   referraloutcome,#(lf)   discharged#(lf)   from finalfinalfinal#(lf)   left join __PeopleDemoFinal on finalfinalfinal.personkey = __PeopleDemoFinal.personkey#(lf)#(lf)   order by finalfinalfinal.personkey, ReferralID#(lf) #(lf)#(lf)\"]),",
                "    #\"Filtered Rows\" = Table.SelectRows(Source, each true),",
                "    ",
                "    #\"Changed Type1\" = Table.TransformColumnTypes(#\"Filtered Rows\",{{\"ReceivedDate\", type date}}),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Changed Type1\",{{\"persondateofbirth\", type date}}),",
                "",
                "  ",
                "    #\"Changed Type2\" = Table.TransformColumnTypes(#\"Changed Type\",{{\"persondateofbirth\", type date}, {\"ReceivedDate\", type date}}),",
                "    #\"Added Custom2\" = Table.AddColumn(#\"Changed Type2\", \"Custom\", each ([ReceivedDate]-[persondateofbirth])/365.25),",
                "    #\"Changed Type3\" = Table.TransformColumnTypes(#\"Added Custom2\",{{\"Custom\", type number}}),",
                "    #\"Added Custom3\" = Table.AddColumn(#\"Changed Type3\", \"Custom.1\", each Number.RoundDown([Custom])),",
                "    #\"Added Conditional Column1\" = Table.AddColumn(#\"Added Custom3\", \"Age Group Received\", ",
                "each if [Custom.1] < 21 then \"0-20\" else if [Custom.1] < 31 then \"21-30\" else if [Custom.1] < 41 ",
                "    then \"31-40\" else if [Custom.1] < 51 then \"41-50\" else if [Custom.1] < 61 then \"51-60\" else if [Custom.1] > 60 then \"61 and Over\" else \"Unknown\"),",
                "    #\"Filtered Rows1\" = Table.SelectRows(#\"Added Conditional Column1\", each true)",
                " in",
                "    #\"Filtered Rows1\""
              ],
              "type": "m"
            }
          }
        ]
