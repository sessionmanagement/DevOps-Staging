        "partitions": [
          {
            "name": "Declined Referrals",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Sql.Database(\"Synapseausprod-ondemand.sql.azuresynapse.net\", \"ODS\", [Query=\"with #(lf)__alldata as#(lf)(#(lf)#(lf)SELECT #(lf)'EAL' as company,#(lf)dlfactreferralstatus.ReferralID,#(lf)dlfactreferral.personid,#(lf)referralstatusstartdate,#(lf)referralstatustypecode, #(lf)referralstatustypegroup, #(lf)referralstatustypestatusorder,#(lf)teamname , #(lf)dldimteam.TeamID,#(lf)teamfunctionname,#(lf)teamfunctioncode,#(lf)ReferralStatusTypeReasonDescription,#(lf)--====#(lf)--case #(lf)--when teamname like '%Ease%Up%' then 'Ease Up'#(lf)--when teamfunctionname like '%Residential%' then 'Residential'#(lf)--when teamfunctionname like '%Community%' or teamfunctionname like '%day progra%' then 'Community'#(lf)--when teamfunctionname like '%Respite%' then 'Respite'#(lf)--when TeamFunctionName in (#(lf)--#(tab)'Housing Service',#(lf)--#(tab)'SNG (EH) Motels',#(lf)--#(tab)'TH Follow Up',#(lf)--#(tab)'TH Housing Services',#(lf)--#(tab)'TH Motels',#(lf)--#(tab)'Sust Tenancies',#(lf)--#(tab)'CPP',#(lf)--#(tab)'CPP F/up'#(lf)--#(tab),'Pilot EH Rotorua Motels'#(lf)--#(tab)) then 'Housing'#(lf)--#(tab)end as ReportingTeamFunction#(lf)#(tab)--====#(lf)#(tab)case #(lf)when teamname like '%Ease%Up%' then 'Ease Up'  --teamfunctionname = 'Youth - Community'#(lf)when teamfunctionname like '%Residential%' then 'Residential'#(lf)when teamfunctionname like '%Community%' or teamfunctionname like '%day progra%' then 'Community'#(lf)when teamfunctionname like '%Respite%' then 'Respite'#(lf)when TeamFunctioncode like 'hs%' then 'Housing'#(lf)#(tab)end as ReportingTeamFunction#(lf)#(lf) #(lf) FROM rbeal.dlFactReferralStatus#(lf)#(lf)  inner join rbeal.dlDimReferralStatusType#(tab)#(tab)#(tab)on dlFactReferralStatus.ReferralStatusTypeID#(tab)#(tab)= dlDimReferralStatusType.ReferralStatusTypeID#(lf)  inner join rbeal.dlfactreferral#(tab)#(tab)#(tab)#(tab)#(tab)on dlFactReferralStatus.referralid#(tab)#(tab)#(tab)#(tab)#(tab)= dlfactreferral.referralid#(lf)  inner join rbeal.dldimteam#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)on dlfactreferral.teamid#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)= dldimteam.teamid#(lf)  inner join rbeal.dlDimTeamFunction#(tab)#(tab)#(tab)#(tab)on dldimteam.TeamFunctionID#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)= dldimteamfunction.TeamFunctionID#(lf)  left join  rbeal.dlDimReferralStatusTypeReason#(tab)on dlFactReferralStatus.ReferralStatusTypeReasonID#(tab)= dlDimReferralStatusTypeReason.ReferralStatusTypeReasonID#(lf)  #(lf)  --where #(lf)  -- referralstatusstartdate > '2020-01-01'#(lf)  -- and TeamName not in ('Whariki Day Prog','Auckland Adult Mobile- Clinical','Jansen House: Clinical','Mapusaga Clinical','Nga Taumahatanga Clinical','Phoenix Clinical',#(lf)  -- 'WDHB Mainstream (Clinical)','WDHB Pacific (Clinical)')#(lf)#(lf)    where #(lf)   referralstatusstartdate > '2020-01-01'#(lf)   and TeamName not in ('Whariki Day Prog','Auckland Adult Mobile- Clinical','Jansen House: Clinical','Mapusaga Clinical','Nga Taumahatanga Clinical','Phoenix Clinical',#(lf)   'WDHB Mainstream (Clinical)','WDHB Pacific (Clinical)')#(lf)   and teamfunctionname not in ('CPP Follow Up','TH Follow Up')  -- excluding followup teams - Simon/Wendy 25-05-2023#(lf)#(lf)#(lf)#(lf)   union all#(lf) SELECT #(lf) 'MNB' as Company,#(lf)dlfactreferralstatus.ReferralID,#(lf)dlfactreferral.personid,#(lf)referralstatusstartdate,#(lf)referralstatustypecode, #(lf)referralstatustypegroup, #(lf)referralstatustypestatusorder,#(lf)teamname , #(lf)dldimteam.TeamID,#(lf)teamfunctionname,#(lf)teamfunctioncode,#(lf)ReferralStatusTypeReasonDescription,#(lf)'Mind and Body'#(lf)#(tab) as ReportingTeamFunction#(lf)#(lf) #(lf) FROM rbmnb.dlFactReferralStatus#(lf)#(lf)  inner join rbmnb.dlDimReferralStatusType#(tab)#(tab)#(tab)on dlFactReferralStatus.ReferralStatusTypeID#(tab)#(tab)= dlDimReferralStatusType.ReferralStatusTypeID#(lf)  inner join rbmnb.dlfactreferral#(tab)#(tab)#(tab)#(tab)#(tab)on dlFactReferralStatus.referralid#(tab)#(tab)#(tab)#(tab)#(tab)= dlfactreferral.referralid#(lf)  inner join rbmnb.dldimteam#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)on dlfactreferral.teamid#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)= dldimteam.teamid#(lf)  inner join rbmnb.dlDimTeamFunction#(tab)#(tab)#(tab)#(tab)on dldimteam.TeamFunctionID#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)= dldimteamfunction.TeamFunctionID#(lf)  left join  rbmnb.dlDimReferralStatusTypeReason#(tab)on dlFactReferralStatus.ReferralStatusTypeReasonID#(tab)= dlDimReferralStatusTypeReason.ReferralStatusTypeReasonID#(lf)#(lf)  where #(lf)   referralstatusstartdate > '2020-01-01'#(lf)   #(lf)   )#(lf)   ,#(lf)   __Changes as#(lf)   (#(lf)   #(tab)select * #(lf)#(tab),datediff(day,lag(referralstatusstartdate,1) over (partition by personid order by personid, referralid, referralstatusstartdate)#(lf)#(tab),referralstatusstartdate) as days_diff#(lf)#(tab)from __Alldata#(lf)#(tab)where referralstatustypecode  in ('declined')#(lf)   )#(lf)   ,#(lf)   __Final_data as#(lf)   (select #(lf)#(tab)'Declined' as Count_type,#(lf)#(tab)*,#(lf)#(tab)--case when TeamFunctionName in (#(lf)#(tab)--'Housing Service',#(lf)#(tab)--'SNG (EH) Motels',#(lf)#(tab)--'TH Follow Up',#(lf)#(tab)--'TH Housing Services',#(lf)#(tab)--'TH Motels',#(lf)#(tab)--'Sust Tenancies',#(lf)#(tab)--'CPP',#(lf)#(tab)--'CPP F/up'#(lf)#(tab)--,'Pilot EH Rotorua Motels') then 'Housing'#(lf)#(tab)--when company = 'MnB' then 'Mind and Body'#(lf)#(tab)--else 'Health and Disability'#(lf)#(tab)--end as TeamFunctionType,#(lf)#(tab)case #(lf)when teamname like '%Ease%Up%' then 'Ease Up'  --teamfunctionname = 'Youth - Community'#(lf)when teamfunctionname like '%Residential%' then 'Residential'#(lf)when teamfunctionname like '%Community%' or teamfunctionname like '%day progra%' then 'Community'#(lf)when teamfunctionname like '%Respite%' then 'Respite'#(lf)when TeamFunctioncode like 'hs%' then 'Housing'#(lf)#(tab)end as teamfunctiontype,#(lf)#(tab)#(lf)#(tab)case when referralstatustypecode in ('Declined') then 1#(lf)#(tab)else 0#(lf)#(tab)end as Declined#(lf)#(tab)#(lf)#(tab)from __changes #(lf)#(tab)where referralstatustypecode in ('Declined')#(lf)#(tab)   #(tab) ),#(lf)#(tab)__PeopleDemo as#(lf)(#(lf)select#(lf)concat('EAL,',dldimperson.PersonID) as personkey,#(lf)gendertext,#(lf)dldimperson.persondateofbirth,#(lf)CONCAT(eth1.ethnicitytext,',', peth1.Ethnicitytext,',', eth2.EthnicityText,',', peth2.EthnicityText, ',',eth3.EthnicityText,',',peth3.EthnicityText)#(lf)as ethnicityall,#(lf)CONCAT(eth1.ethnicityvalue,',', peth1.Ethnicityvalue,',', eth2.Ethnicityvalue,',', peth2.Ethnicityvalue, ',',eth3.Ethnicityvalue,',',peth3.Ethnicityvalue)#(lf)as ethnicityvalue#(lf)#(lf)from #(lf)rbeal.dldimperson #(lf)left join rbeal.dldimgender on dlDimPerson.GenderID = dldimgender.genderid #(lf)left join rbeal.dldimethnicity as eth1 on dldimperson.ethnicity1id = eth1.ethnicityid#(lf)left join rbeal.dldimethnicity as peth1 on eth1.EthnicityParentId = peth1.ethnicityid#(lf)#(lf)left join rbeal.dldimethnicity as eth2 on dldimperson.ethnicity2id = eth2.ethnicityid#(lf)left join rbeal.dldimethnicity as peth2 on eth2.EthnicityParentId = peth2.ethnicityid#(lf)#(lf)left join rbeal.dldimethnicity as eth3 on dldimperson.ethnicity3id = eth3.ethnicityid#(lf)left join rbeal.dldimethnicity as peth3 on eth3.EthnicityParentId = peth3.ethnicityid#(lf)#(lf)Union all#(lf)#(lf)select#(lf)concat('MNB,',dldimperson.PersonID) as personkey,#(lf)gendertext,#(lf)dldimperson.persondateofbirth,#(lf)CONCAT(eth1.ethnicitytext,',', peth1.Ethnicitytext,',', eth2.EthnicityText,',', peth2.EthnicityText, ',',eth3.EthnicityText,',',peth3.EthnicityText)#(lf)as ethnicityall,#(lf)CONCAT(eth1.ethnicityvalue,',', peth1.Ethnicityvalue,',', eth2.Ethnicityvalue,',', peth2.Ethnicityvalue, ',',eth3.Ethnicityvalue,',',peth3.Ethnicityvalue)#(lf)as ethnicityvalue#(lf)#(lf)from#(tab)#(tab)rbmnb.dldimperson #(lf)left join rbmnb.dldimgender on dldimperson.genderid = dldimgender.genderid#(lf)left join#(tab)rbmnb.dldimethnicity as eth1 on dldimperson.ethnicity1id = eth1.ethnicityid#(lf)left join#(tab)rbmnb.dldimethnicity as peth1 on eth1.EthnicityParentId = peth1.ethnicityid#(lf)left join#(tab)rbmnb.dldimethnicity as eth2 on dldimperson.ethnicity2id = eth2.ethnicityid#(lf)left join#(tab)rbmnb.dldimethnicity as peth2 on eth2.EthnicityParentId = peth2.ethnicityid#(lf)left join#(tab)rbmnb.dldimethnicity as eth3 on dldimperson.ethnicity3id = eth3.ethnicityid#(lf)left join#(tab)rbmnb.dldimethnicity as peth3 on eth3.EthnicityParentId = peth3.ethnicityid#(lf)#(lf)),#(lf)__PeopleDemoFinal as#(lf)(#(lf)#(lf)select personkey, gendertext, persondateofbirth, ethnicityvalue, ethnicityall,#(lf)case when ethnicityvalue like '%,21,%' or ethnicityvalue like '21,%' or ethnicityvalue like '%,21'then 'Maori'#(lf)#(lf)when ethnicityvalue like '31,%' or ethnicityvalue like '%,31,%' then 'Pasifika'#(lf)when ethnicityvalue like '32,%' or ethnicityvalue like '33,%' or ethnicityvalue like '34,%' or ethnicityvalue like '35,%'#(lf)or ethnicityvalue like '36,%' or ethnicityvalue like '37,%'#(lf)then 'Pasifika'#(lf)when ethnicityvalue like '%,32,%' or ethnicityvalue like '%,33,%' or ethnicityvalue like '%,34,%' or ethnicityvalue like '%,35,%'#(lf)or ethnicityvalue like '%,36,%' or ethnicityvalue like '%,37,%'#(lf)then 'Pasifika'#(lf)when ethnicityvalue like '%,32%' or ethnicityvalue like '%,33%' or ethnicityvalue like '%,34%' or ethnicityvalue like '%,35%'#(lf)or ethnicityvalue like '%,36%' or ethnicityvalue like '%,37%' or ethnicityvalue like '%,30%'#(lf)or ethnicityvalue like '30,%'#(lf)then 'Pasifika'#(lf)#(lf)#(lf)when ethnicityvalue like '40,%' or ethnicityvalue like '%,40,%' then 'Asian'#(lf)when ethnicityvalue like '41,%' or ethnicityvalue like '%,41,%' then 'Asian'#(lf)when ethnicityvalue like '42,%' or ethnicityvalue like '43,%' or ethnicityvalue like '44,%' or ethnicityvalue like '45,%'#(lf)or ethnicityvalue like '46,%' or ethnicityvalue like '47,%'#(lf)then 'Asian'#(lf)when ethnicityvalue like '%,42,%' or ethnicityvalue like '%,43,%' or ethnicityvalue like '%,44,%' or ethnicityvalue like '%,45,%'#(lf)or ethnicityvalue like '%,46,%' or ethnicityvalue like '%,47,%'#(lf)then 'Asian'#(lf)when ethnicityvalue like '%,42%' or ethnicityvalue like '%,43%' or ethnicityvalue like '%,44%' or ethnicityvalue like '%,45%'#(lf)or ethnicityvalue like '%,46%' or ethnicityvalue like '%,47%'#(lf)then 'Asian'#(lf)when ethnicityall like '%Japanese%' or ethnicityall like '%Korean%' or ethnicityall like '%Cambodian%' #(lf)or ethnicityall like '%chinese%' or ethnicityall like '%Filipino%' #(lf)or ethnicityall like '%Sri Lankan%' or ethnicityall like '%Asian%'#(lf)or ethnicityall like '%vietnamese%'#(lf)then 'Asian'#(lf)#(lf)#(lf)when ethnicityvalue like '50,%' or ethnicityvalue like '%,50,%' then 'Middle Eastern, Latin American, African'#(lf)when ethnicityvalue like '51,%' or ethnicityvalue like '%,51,%' then 'Middle Eastern, Latin American, African'#(lf)when ethnicityvalue like '52,%' or ethnicityvalue like   '53,%' #(lf)then 'Middle Eastern, Latin American, African'#(lf)when ethnicityvalue like '%,52,%' or ethnicityvalue like '%,53,%' #(lf)then 'Middle Eastern, Latin American, African'#(lf)when ethnicityvalue like '%,52%' or ethnicityvalue like '%,53%'  #(lf)then 'Middle Eastern, Latin American, African'#(lf)#(lf) when #(lf) ethnicityvalue like '10,%' or ethnicityvalue like '%,10,%' or#(lf) ethnicityvalue like '11,%' or ethnicityvalue like '%,11,%' or ethnicityvalue like '12,%' or ethnicityvalue like '%,12,%'#(lf) then 'European' #(lf)#(lf) when ethnicityall like 'australian%' or ethnicityall like 'british%' or ethnicityall like 'dutch%'#(lf) or ethnicityall like 'german%' or ethnicityall like 'italian%' or ethnicityall like 'greek%' or ethnicityall like 'polish%'#(lf) or ethnicityall like '%european%' or ethnicityall  like '%slav%'#(lf) then 'European'#(lf)#(lf) when  ethnicityvalue like '%,54,%' or ethnicityvalue like '%,54%'#(lf) or ethnicityvalue like '54,%'#(lf) then 'Other'#(lf)#(lf)else 'Unknown'#(lf)end as ethnicitygroup #(lf)from __peopledemo#(lf)),#(lf)#(lf)finalfinalfinal as#(lf)(#(lf)   select  #(lf) concat(company,',',teamname) as teamkey, #(lf) concat(company,',',teamid) as teamkey2,#(lf) concat(company,',',personid) as personkey,#(lf) *   #(lf)   from __final_data#(lf)   )#(lf)#(lf)   select #(lf)   'Declined' as ReferralType,#(lf)   finalfinalfinal.teamkey,#(lf)   finalfinalfinal.teamkey2,#(lf)   finalfinalfinal.personkey,#(lf)   finalfinalfinal.company as ReferralDeclinedCompany,#(lf)   finalfinalfinal.ReferralStatusStartDate as DeclinedDate,#(lf)   finalfinalfinal.ReferralStatusTypeReasonDescription,#(lf)   referralid as DeclinedReferral,#(lf)   teamname,#(lf)   teamfunctionname,#(lf)   reportingteamfunction,#(lf)   declined,#(lf)   gendertext, #(lf)   persondateofbirth, #(lf)   ethnicitygroup  #(lf)   from finalfinalfinal#(lf)   left join __PeopleDemoFinal on finalfinalfinal.personkey = __PeopleDemoFinal.personkey#(lf)   where count_type = 'Declined'#(lf)  -- and finalfinalfinal.personkey = 'eal,100006'#(lf)#(lf)  order by personkey\"]),",
                "    #\"Filtered Rows\" = Table.SelectRows(Source, each true),",
                "    ",
                "    #\"Changed Type1\" = Table.TransformColumnTypes(#\"Filtered Rows\",{{\"DeclinedDate\", type date}}),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Changed Type1\",{{\"persondateofbirth\", type date}}),",
                "",
                "  ",
                "    #\"Changed Type2\" = Table.TransformColumnTypes(#\"Changed Type\",{{\"persondateofbirth\", type date}, {\"DeclinedDate\", type date}}),",
                "    #\"Added Custom2\" = Table.AddColumn(#\"Changed Type2\", \"Custom\", each ([DeclinedDate]-[persondateofbirth])/365.25),",
                "    #\"Changed Type3\" = Table.TransformColumnTypes(#\"Added Custom2\",{{\"Custom\", type number}}),",
                "    #\"Added Custom3\" = Table.AddColumn(#\"Changed Type3\", \"Custom.1\", each Number.RoundDown([Custom])),",
                "    #\"Added Conditional Column1\" = Table.AddColumn(#\"Added Custom3\", \"Age Group Declined\", ",
                "each if [Custom.1] < 21 then \"0-20\" else if [Custom.1] < 31 then \"21-30\" else if [Custom.1] < 41 ",
                "    then \"31-40\" else if [Custom.1] < 51 then \"41-50\" else if [Custom.1] < 61 then \"51-60\" else if [Custom.1] > 60 then \"61 and Over\" else \"Unknown\"),",
                "    #\"Filtered Rows1\" = Table.SelectRows(#\"Added Conditional Column1\", each true)",
                " in",
                "    #\"Filtered Rows1\""
              ],
              "type": "m"
            }
          }
        ]
      },
