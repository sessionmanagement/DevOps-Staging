        "measures": [
          {
            "name": "Declined_NoBlank",
            "expression": [
              "",
              "VAR Declined_ = calculate(sum('Declined Referrals'[declined]))",
              "Return",
              "if(isblank(Declined_),0,Declined_)"
            ],
