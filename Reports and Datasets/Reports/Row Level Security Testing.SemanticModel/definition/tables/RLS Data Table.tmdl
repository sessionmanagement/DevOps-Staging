table 'RLS Data Table'
	lineageTag: fa378118-923b-4e6b-9a41-6eec2c271315

	measure 'Count of Employees' =
			
			CALCULATE(
			DISTINCTCOUNTNOBLANK('RLS Data Table'[mapped_employee_name]),
			    USERELATIONSHIP(
			        'RLS Data Table'[email],
			        'Employee Email'[employee_primary_email_address]
			    )
			)
		formatString: 0
		lineageTag: 67f8003a-92a1-4b2e-a3e7-43fc9239e5dc

	measure 'Count of Services' =
			
			CALCULATE(
			    DISTINCTCOUNTNOBLANK('RLS Data Table'[service_name]),
			    USERELATIONSHIP(
			        'RLS Data Table'[email],
			        'Employee Email'[employee_primary_email_address]
			    )
			)
		formatString: 0
		lineageTag: f62e870b-fa41-4a30-9ca9-a70337aa24ab

	measure 'Count of Teams' = ```
			
			COALESCE(
			CALCULATE(
			    DISTINCTCOUNTNOBLANK('RLS Data Table'[client_team_name]),
			    USERELATIONSHIP(
			        'RLS Data Table'[email],
			        'Employee Email'[employee_primary_email_address]
			    )
			),0)
			
			```
		formatString: 0
		lineageTag: f06a67ce-6fd6-4e23-b508-53411657f5b6

	measure 'Count of Waharoa' = ```
			
