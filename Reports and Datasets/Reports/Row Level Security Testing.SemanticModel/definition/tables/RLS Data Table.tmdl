			    )
			),0)
			
			```
		formatString: 0
		lineageTag: 210114ce-754f-4198-ba7f-bb10e0ca4db3

	measure 'Count of Tenancy' = ```
			
			COALESCE(
			CALCULATE(
			    DISTINCTCOUNTNOBLANK('RLS Data Table'[property_tenancy_tenancy_name]),
			    USERELATIONSHIP(
			        'RLS Data Table'[email],
			        'Employee Email'[employee_primary_email_address]
			    )
			),0)
			
			```
		formatString: 0
