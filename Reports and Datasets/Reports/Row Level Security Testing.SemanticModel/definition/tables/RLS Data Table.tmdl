	partition 'RLS Data Table' = m
		mode: import
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="SELECT #(lf)       rls.row_level_security_id#(lf)      ,rls.[RLS_type]#(lf)      ,rls.[dim_employee_key]#(lf)      ,rls.[employee_id]#(lf)      ,rls.[email]#(lf)      ,rls.[dim_company_key]#(lf)      ,rls.[dim_service_key]#(lf)      ,rls.[service_id]#(lf)      ,rls.[dim_property_key]#(lf)      ,rls.[property_id]#(lf)      ,rls.[dim_property_tenancy_key]#(lf)      ,rls.[property_tenancy_id]#(lf)      ,rls.[dim_client_team_key]#(lf)      ,rls.[client_team_id]#(lf)      ,rls.[employee_level_for_exclusion]#(lf)      ,rls.mapped_employee_name#(lf)      ,dim_employee.employee_name#(lf)      ,dim_client_team.client_team_name#(lf)      ,dim_service.service_name#(lf)      ,dim_property.property_name #(lf)      ,dim_property_tenancy.property_tenancy_tenancy_name#(lf)#(lf)   #(lf)  FROM [edw].[row_level_security_general] as rls#(lf)#(lf)  left join edw.dim_employee on rls.dim_employee_key = dim_employee.dim_employee_key#(lf)  left join edw.dim_client_team on rls.dim_client_team_key = dim_client_team.dim_client_team_key#(lf)  left join edw.dim_service on rls.dim_service_key = dim_service.dim_service_key#(lf)  left join edw.dim_property on rls.dim_property_key = dim_property.dim_property_key#(lf)  left join edw.dim_property_tenancy on rls.dim_property_tenancy_key = dim_property_tenancy.dim_property_tenancy_key#(lf)"]),
				    #"Lowercased Text" = Table.TransformColumns(Source,{{"email", Text.Lower, type text}})
				in
				    #"Lowercased Text"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

