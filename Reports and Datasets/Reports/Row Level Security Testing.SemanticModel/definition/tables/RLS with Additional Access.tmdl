	column email
		dataType: string
		lineageTag: fa24b122-5e35-4555-8f83-0cdcd34f54e6
		summarizeBy: none
		sourceColumn: email

		annotation SummarizationSetBy = Automatic

	partition 'RLS with Additional Access' = m
		mode: import
		source =
				let
				    // Source tables
				    RowLevelSecurity = #"RLS Data Table",
				    AdditionalAccess = #"Additional Access",
				
				    // Normalise the owner email (lowercase + trim) so all matching is case-insensitive
				    BaseNorm = Table.TransformColumns(
				        RowLevelSecurity, {{"email", each Text.Lower(Text.Trim(_)), type text}}
				    ),
				
				    // 1) Every owner can see their own rows: email2 = own email
				    OwnRows = Table.AddColumn(BaseNorm, "email2", each [email], type text),
				
				    // 2) Delegated access. Additional Access already filters to non-expired, approved grants
				    //    and lowercases the emails. Normalise again defensively, then keep distinct grant pairs.
				    Grants = Table.SelectColumns(AdditionalAccess, {"Requester Email", "Person to Impersonate Email"}),
				    GrantsNorm = Table.TransformColumns(
				        Grants,
				        {
				            {"Requester Email", each Text.Lower(Text.Trim(_)), type text},
				            {"Person to Impersonate Email", each Text.Lower(Text.Trim(_)), type text}
				        }
				    ),
				    GrantsClean = Table.Distinct(
				        Table.SelectRows(
				            GrantsNorm,
				            each [Requester Email] <> null and [Requester Email] <> ""
				                and [Person to Impersonate Email] <> null and [Person to Impersonate Email] <> ""
				        )
				    ),
				
				    // 3) Requester inherits every row owned by the person they may impersonate.
				    //    Inner join on the (now lowercased) impersonated person = owner email.
				    Delegated = Table.Join(
				        GrantsClean, "Person to Impersonate Email", BaseNorm, "email", JoinKind.Inner
				    ),
				    DelegatedTagged = Table.AddColumn(Delegated, "email2", each [Requester Email], type text),
				    DelegatedClean = Table.SelectColumns(DelegatedTagged, Table.ColumnNames(OwnRows)),
				
				    // 4) Union own + delegated rows and remove exact duplicates
				    Combined = Table.Combine({OwnRows, DelegatedClean}),
				    Result = Table.Distinct(Combined)
				in
				    Result

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

