table 'RLS with Additional Access'
	lineageTag: da2ffe19-4c4e-4c35-9b79-4d67a05ddf06

	measure 'Count of Services AA' =
			COALESCE(
				CALCULATE(
					DISTINCTCOUNTNOBLANK('RLS with Additional Access'[service_name]),
					KEEPFILTERS('RLS with Additional Access'[RLS_type] = "Service")
				),
				0
			)
		formatString: 0
		lineageTag: 3b7cb851-a778-4900-b9e5-ee8fbd7e7e62

	measure 'Count of Teams AA' =
			COALESCE(
				CALCULATE(
					DISTINCTCOUNTNOBLANK('RLS with Additional Access'[client_team_name]),
					KEEPFILTERS('RLS with Additional Access'[RLS_type] = "Recordbase")
				),
				0
			)
		formatString: 0
		lineageTag: 41818cae-8a3b-4acb-82a7-97617513a135

