model Model
	culture: en-NZ
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-NZ
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Common Components'

	annotation PBI_QueryGroupOrder = 2

queryGroup 'Primary Datasets'

	annotation PBI_QueryGroupOrder = 2

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Dim Date","_Measures","_Report Components","Server","Database","LastRefreshed","Changelog","RLS Data Table","Employee Email","Additional Access","RLS with Additional Access"]

annotation PBI_ProTooling = ["TMDLView_Desktop","DevMode","MCP-PBIModeling"]

ref table 'Dim Date'
ref table _Measures
ref table '_Report Components'
ref table LastRefreshed
ref table Changelog
ref table 'RLS Data Table'
ref table 'Employee Email'
ref table 'Additional Access'
ref table 'RLS with Additional Access'

ref role 'Model User'

ref cultureInfo en-NZ

