                "value": "{\"isCustom\":true}"
              }
            ],
            "displayFolder": "4. Rental/Transactions",
            "expression": [
              "",
              "    SUM(fact_tenancy_transaction_details[zav_amount])"
            ],
            "formatString": "$#,##0.00;($#,##0.00)",
            "isHidden": true,
            "lineageTag": "4b70a811-985a-4395-ae6a-0e3db465dad3"
          },
          {
            "name": "Amount (Same Period Last Year)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ],
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "CALCULATE(",
              "    SUM(",
              "        fact_tenancy_transaction_details[zav_amount]",
              "    )",
              "    ,SAMEPERIODLASTYEAR(dim_date[calendar_date])",
              ")"
            ],
            "formatString": "$#,##0.00;($#,##0.00)",
            "isHidden": true,
            "lineageTag": "7ff86285-6183-467f-b2ba-a932c78b4d82"
          },
          {
            "name": "Difference in Amount (Selected Period v Same Time Last Year)",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "IFERROR(",
              "    CALCULATE(",
              "        ([Amount (Same Period Last Year)] - SUM(fact_tenancy_transaction_details[zav_amount])) / [Amount (Same Period Last Year)]",
              "        *-1",
              "    ),",
              "    0",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "isHidden": true,
            "lineageTag": "dcc1baf5-a32b-4b75-8303-4a29e388f94c"
          },
