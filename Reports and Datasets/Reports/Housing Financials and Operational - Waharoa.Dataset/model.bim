                "name": "SummarizationSetBy",
                "value": "Automatic"
              },
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ],
            "dataType": "dateTime",
            "expression": [
              "",
              "RELATED(dim_date[financial_last_day_of_year_date])"
            ],
            "formatString": "Short Date",
            "isHidden": true,
            "lineageTag": "7f43c95e-2632-4e84-8d59-3d5dc2374916",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "TenancyActiveDaysInFY",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "expression": [
              "",
              "IF(",
              "    TenancyDaysByFY[tenancy_end_date_or_today] < TenancyDaysByFY[last_day_of_fy],",
              "    DATEDIFF(TenancyDaysByFY[TenancyBeginDateForFY], TenancyDaysByFY[tenancy_end_date_or_today], DAY)+1,",
              "    DATEDIFF(TenancyDaysByFY[TenancyBeginDateForFY], TenancyDaysByFY[last_day_of_fy], DAY)+1",
              ")"
            ],
            "formatString": "#,0",
            "isDataTypeInferred": true,
            "isHidden": true,
            "lineageTag": "5e77e83b-1988-44c6-849d-2d00dce85830",
            "summarizeBy": "sum",
            "type": "calculated"
          },
          {
            "name": "tenancy_end_date_for_fy",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              },
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ],
            "dataType": "dateTime",
            "expression": [
              "",
              "IF(",
              "    TenancyDaysByFY[tenancy_end_date_or_today] > TenancyDaysByFY[last_day_of_fy],",
              "    TenancyDaysByFY[last_day_of_fy], TenancyDaysByFY[tenancy_end_date_or_today]",
              ")"
            ],
            "formatString": "Short Date",
            "isDataTypeInferred": true,
            "isHidden": true,
            "lineageTag": "fe910103-ff7c-49c4-83c0-120095ed1e6a",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "tenancy_active_days_from_actual_start_to_end_in_fy",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "expression": [
              "",
              "DATEDIFF(TenancyDaysByFY[zav_tenancystartdate],TenancyDaysByFY[tenancy_end_date_for_fy],DAY)+1"
            ],
            "formatString": "0",
            "isDataTypeInferred": true,
            "isHidden": true,
            "lineageTag": "9733ad4a-27d1-4378-913c-7d2cd8146640",
            "summarizeBy": "sum",
            "type": "calculated"
          },
          {
            "name": "required_numer_of_inspections_for_fy",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "expression": [
              "",
              "FLOOR(",
              "    TenancyDaysByFY[TenancyActiveDaysInFY] / 91,1)"
            ],
            "formatString": "0",
            "isDataTypeInferred": true,
            "isHidden": true,
            "lineageTag": "600534a7-5064-404d-afb6-99667aa5bf2c",
            "summarizeBy": "sum",
            "type": "calculated"
          }
        ],
