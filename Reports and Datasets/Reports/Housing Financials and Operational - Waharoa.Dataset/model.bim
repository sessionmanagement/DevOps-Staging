            "source": {
              "expression": [
                "let",
                "    Source = Sql.Database(\"sql-dev-aue-svc-datawarehouse-01.database.windows.net\", \"sqldb-dev-datawarehouse-01\", [Query=\"SELECT * FROM edw.dim_date WHERE dim_date_key <> 0#(lf)AND calendar_date > DATEADD(year, -90, GETDATE()) AND calendar_date < DATEADD(year, 9, GETDATE())\"]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"financial_year_num\", Int64.Type}})",
                "in",
                "    #\"Changed Type\""
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "_Measures",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          }
        ],
        "lineageTag": "ed0c1696-2b27-484e-aa11-546df4b7b894",
        "measures": [
          {
            "name": "IsActiveDuringSelectedFY",
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "VAR SelectedFinancialYearStart = CALCULATE(MIN('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))",
              "VAR SelectedFinancialYearEnd = CALCULATE(MAX('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))",
              "",
              "RETURN",
              "IF (",
              "    NOT ISBLANK(SELECTEDVALUE(fact_tenancy[zav_tenancystartdate])) &&",
              "    CALCULATE (",
              "        COUNTROWS (",
              "            FILTER (",
              "                fact_tenancy,",
              "                SELECTEDVALUE(fact_tenancy[zav_tenancystartdate]) <= SelectedFinancialYearEnd &&",
              "                (ISBLANK(SELECTEDVALUE(fact_tenancy[zav_vacateddate])) || SELECTEDVALUE(fact_tenancy[zav_vacateddate]) > SelectedFinancialYearStart)",
              "            )",
              "        )",
              "    ) > 0,",
              "    1,",
              "    0",
              ")"
            ],
            "formatString": "0",
            "isHidden": true,
            "lineageTag": "50a5ed40-8ef8-4fbe-817a-b4a7667d018c"
          },
          {
            "name": "Average Tenancy Length (Days)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "VAR SelectedFinancialYearStart = CALCULATE(MIN('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))",
              "VAR SelectedFinancialYearEnd = CALCULATE(MAX('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))",
              "",
              "RETURN",
              "CALCULATE (",
              "    AVERAGE (fact_tenancy[Tenancy Length (Days)]),",
              "    FILTER (",
              "        ALL (dim_date),",
              "        'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num])",
              "    ),",
              "    FILTER (",
              "        fact_tenancy,",
              "        NOT ISBLANK(fact_tenancy[zav_tenancystartdate]) &&",
              "        fact_tenancy[zav_tenancystartdate] <= SelectedFinancialYearEnd &&",
              "        (ISBLANK(fact_tenancy[zav_vacateddate]) || fact_tenancy[zav_vacateddate] > SelectedFinancialYearStart)",
              "    )",
              ")",
              ""
            ],
            "isHidden": true,
            "lineageTag": "7f4817e6-88aa-460d-8306-ec4bbc84a8d1"
          },
          {
            "name": "Average Tenancy Length (All)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ],
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "//CALCULATE(AVERAGE(fact_tenancy[Tenancy Length (Days)]),ALL(dim_date), SELECTEDVALUE(dim_date[financial_year_num]) >= dim_date[financial_year_num]) --old measure that didn't account for the selected FY i.e. not include tenancy lengths after the end of the FY.",
              "CALCULATE(AVERAGE(TenancyDaysByFY[tenancy_active_days_from_actual_start_to_end_in_fy]),ALL(dim_date),SELECTEDVALUE(dim_date[financial_year_num]) >= dim_date[financial_year_num])"
            ],
            "formatString": "0",
            "isHidden": true,
            "lineageTag": "4d0da421-24d6-4090-acf1-b79403dae271"
          },
          {
            "name": "Average Tenancy Length for Tenancies Ended in Selected FY (Days)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "VAR SelectedFinancialYearStart = CALCULATE(MIN('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))",
              "VAR SelectedFinancialYearEnd = CALCULATE(MAX('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))",
              "",
              "RETURN",
              "CALCULATE (",
              "    AVERAGE (fact_tenancy[Tenancy Length (Days)]),",
              "    ALL(dim_date),",
              "    fact_tenancy[zav_vacateddate] >= SelectedFinancialYearStart,",
              "    fact_tenancy[zav_vacateddate] <= SelectedFinancialYearEnd",
              ")"
            ],
            "isHidden": true,
            "lineageTag": "6da0043e-b5cb-41c2-816d-72755db7791d"
          },
          {
            "name": "Average Tenancy Length for Tenancies Started in Selected FY (Days)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "VAR SelectedFinancialYearStart = CALCULATE(MIN('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))",
              "VAR SelectedFinancialYearEnd = CALCULATE(MAX('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))",
              "",
              "RETURN",
              "CALCULATE (",
              "    AVERAGE (fact_tenancy[Tenancy Length (Days)]),",
              "    ALLSELECTED(dim_date),",
              "    fact_tenancy[zav_tenancystartdate] >= SelectedFinancialYearStart,",
              "    fact_tenancy[zav_tenancystartdate] <= SelectedFinancialYearEnd",
              "    )",
              ""
            ],
            "isHidden": true,
            "lineageTag": "c735a198-8eec-4af6-94a3-e4b72f4476f5"
          },
          {
            "name": "Average Property Ownership Length (All)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "//CALCULATE(AVERAGE(fact_property[length_of_ownership_days]),ALL(dim_date))",
              "AVERAGE(PropertyOwnershipDaysByFY[DaysPropertyOwnedAtFYEndOrToday])"
            ],
            "isHidden": true,
            "lineageTag": "a3215e3f-4382-4080-bc38-f2e98c70013b"
          },
          {
            "name": "Average Age of Housing (Days)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "/*CALCULATE(",
              "    AVERAGE(fact_property[house_age_days])///365,",
              "    ALL(dim_date)",
              ")*/",
              "CALCULATE(AVERAGE(PropertyOwnershipDaysByFY[PropertyAgeDaysAtFYEndOrToday]),dim_property[zav_propertyownership] = \"Owned\")"
            ],
            "isHidden": true,
            "lineageTag": "4f9346b2-d0e3-432f-940d-af8b23fce1ae"
          },
          {
            "name": "YoY Growth in Housing Portfolio %",
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "",
              "--date variables",
              "VAR SelectedFinancialYearStart = CALCULATE(MIN('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))",
              "VAR SelectedFinancialYearEnd = CALCULATE(MAX('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))",
              "VAR PrevFinancialYearStart = CALCULATE(MIN('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num])-1)",
              "VAR PrevFinancialYearEnd = CALCULATE(MAX('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num])-1)",
              "",
              "--housing count variables",
              "VAR PrevFinancialYearCount = ",
              "CALCULATE(",
              "    COUNTROWS(fact_property),",
              "    ALL(dim_date),",
              "    dim_property[zav_acquireddate] <= PrevFinancialYearEnd,",
              "    OR(ISBLANK(dim_property[zav_confirmeddisposaldate]),dim_property[zav_confirmeddisposaldate] > PrevFinancialYearEnd)",
              ")",
              "",
              "VAR SelectedFinancialYearCount = ",
              "CALCULATE(",
              "    COUNTROWS(fact_property),",
              "    ALL(dim_date),",
              "    dim_property[zav_acquireddate] <= SelectedFinancialYearEnd,",
              "    OR(ISBLANK(dim_property[zav_confirmeddisposaldate]),dim_property[zav_confirmeddisposaldate] > SelectedFinancialYearEnd)",
              ")",
              "",
              "RETURN",
              "(SelectedFinancialYearCount - PrevFinancialYearCount) / SelectedFinancialYearCount"
            ],
            "formatString": "0%;-0%;0%",
            "isHidden": true,
            "lineageTag": "990643cd-409c-454c-bec2-b2381ea90294"
          },
          {
            "name": "YoY Growth in Housing Portfolio #",
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "VAR _Acquired = IF(",
              "    ISBLANK(DISTINCTCOUNT(fact_property[zav_propertyid])),0,DISTINCTCOUNT(fact_property[zav_propertyid]))",
              "VAR _Disposed = IF(",
              "    ISBLANK(DISTINCTCOUNT(fact_property_for_disposed[zav_propertyid])),0,DISTINCTCOUNT(fact_property_for_disposed[zav_propertyid]))",
              "",
              "RETURN",
              "_Acquired - _Disposed",
              "",
              "/*",
              "",
              "--Simplified measure above. Original below.",
              "",
              "--date variables",
              "VAR SelectedFinancialYearStart = CALCULATE(MIN('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))",
              "VAR SelectedFinancialYearEnd = CALCULATE(MAX('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))",
              "VAR PrevFinancialYearStart = CALCULATE(MIN('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num])-1)",
              "VAR PrevFinancialYearEnd = CALCULATE(MAX('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num])-1)",
              "",
              "--housing count variables",
              "VAR PrevFinancialYearCount = ",
              "CALCULATE(",
              "    COUNTROWS(fact_property),",
              "    ALL(dim_date),",
              "    dim_property[zav_acquireddate] <= PrevFinancialYearEnd,",
              "    OR(ISBLANK(dim_property[zav_confirmeddisposaldate]),dim_property[zav_confirmeddisposaldate] > PrevFinancialYearEnd)",
              ")",
              "",
              "VAR SelectedFinancialYearCount = ",
              "CALCULATE(",
              "    COUNTROWS(fact_property),",
              "    ALL(dim_date),",
              "    dim_property[zav_acquireddate] <= SelectedFinancialYearEnd,",
              "    OR(ISBLANK(dim_property[zav_confirmeddisposaldate]),dim_property[zav_confirmeddisposaldate] > SelectedFinancialYearEnd)",
              ")",
              "",
              "RETURN",
              "SelectedFinancialYearCount - PrevFinancialYearCount",
              "*/"
            ],
            "formatString": "0",
            "isHidden": true,
            "lineageTag": "85674381-7c5e-485f-8d34-6da328c470d3"
          },
          {
            "name": "Housing Portfolio Count (by Year) 2",
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "VAR _FYStart = SELECTEDVALUE(dim_date[financial_first_day_of_year_date])",
              "VAR _FYEnd = SELECTEDVALUE(dim_date[financial_last_day_of_year_date])",
              "RETURN",
              "CALCULATE(",
              "    COUNTROWS(dim_property),",
              "    ALL(dim_date),",
              "    PropertyOwnershipDaysByFY[BeginPropertyOwnershipDateForFY] >= _FYStart,",
              "    PropertyOwnershipDaysByFY[BeginPropertyOwnershipDateForFY] <= _FYEnd",
              ")"
            ],
            "formatString": "0",
            "isHidden": true,
            "lineageTag": "16e2b431-16c5-4d01-a7bf-d55560396eca"
          },
          {
            "name": "YoY Growth in Housing Portfolio % (limited to before today)",
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "IF(",
              "    MAX(dim_date[financial_year_num]) > YEAR(TODAY()),",
              "        BLANK(),",
              "        CALCULATE([YoY Growth in Housing Portfolio %])",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "isHidden": true,
            "lineageTag": "b3f38610-0c20-4be8-9658-bbc7ed54abd8"
          },
          {
            "name": "YoY Growth in Housing Portfolio # (limited to before today)",
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "IF(",
              "    MAX(dim_date[financial_year_num]) > YEAR(TODAY()),",
              "        BLANK(),",
              "        CALCULATE([YoY Growth in Housing Portfolio #])",
              ")"
            ],
            "formatString": "0",
            "isHidden": true,
            "lineageTag": "d0b316d5-92f0-435f-8d79-79d0a8f6be2a"
          },
          {
            "name": "Housing Portfolio Count (Basic)",
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "COUNTROWS(fact_property)"
            ],
            "formatString": "0",
