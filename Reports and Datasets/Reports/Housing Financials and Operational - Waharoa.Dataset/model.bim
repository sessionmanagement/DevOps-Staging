          {
            "name": "fact_tenancy-86a0de21-ed98-43c9-bb49-729f3ff2eee1",
            "mode": "import",
            "queryGroup": "facts",
            "source": {
              "expression": [
                "let",
                "    Source = Sql.Database(\"synapseausprod-ondemand.sql.azuresynapse.net\", \"ODS\", [Query=\"WITH RecentOpportunities AS (#(lf)    SELECT#(lf)        opportunityid,#(lf)        name,#(lf)        parentcontactid,#(lf)        zav_leavingreason,#(lf)        zav_property,#(lf)        zav_subprogram,#(lf)        zav_tenancystartdate,#(lf)        zav_vacateddate,#(lf)        zav_propertyname,#(lf)        zav_tenancymanagerid,#(lf)        SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (PARTITION BY opportunityid ORDER BY SinkModifiedOn DESC) AS rn#(lf)    FROM#(lf)        [Zavanti].[vw_opportunity]#(lf)    WHERE#(lf)        statuscode <> 4#(lf))#(lf)SELECT#(lf)    opportunityid,#(lf)    name,#(lf)    parentcontactid,#(lf)    zav_leavingreason,#(lf)    zav_property,#(lf)    zav_subprogram,#(lf)    zav_tenancystartdate,#(lf)    zav_vacateddate,#(lf)    zav_propertyname,#(lf)    zav_tenancymanagerid#(lf)FROM#(lf)    RecentOpportunities#(lf)WHERE#(lf)    rn = 1\"]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"zav_tenancystartdate\", type date}, {\"zav_vacateddate\", type date}}),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Changed Type\",{{\"zav_tenancymanagerid\", \"tenancymanagerid\"}}),",
                "    #\"Merged Queries\" = Table.NestedJoin(#\"Renamed Columns\", {\"zav_property\"}, dim_property, {\"zav_propertyid\"}, \"dim_property\", JoinKind.LeftOuter),",
                "    #\"Expanded dim_property\" = Table.ExpandTableColumn(#\"Merged Queries\", \"dim_property\", {\"new_postalregionname\"}, {\"dim_property.new_postalregionname\"}),",
                "    #\"Renamed Columns1\" = Table.RenameColumns(#\"Expanded dim_property\",{{\"dim_property.new_postalregionname\", \"region_name\"}}),",
                "    #\"Merged Queries1\" = Table.NestedJoin(#\"Renamed Columns1\", {\"parentcontactid\"}, merged_primary_contact, {\"contactid\"}, \"merged_primary_contact\", JoinKind.LeftOuter),",
                "    #\"Expanded merged_primary_contact\" = Table.ExpandTableColumn(#\"Merged Queries1\", \"merged_primary_contact\", {\"fullname\", \"zav_age\", \"zav_ethnicityname\", \"zav_gendername\"}, {\"fullname\", \"zav_age\", \"zav_ethnicityname\", \"zav_gendername\"}),",
                "    #\"Merged Queries2\" = Table.NestedJoin(#\"Expanded merged_primary_contact\", {\"opportunityid\"}, work_open_tenancybreach, {\"zav_tenancy\"}, \"work_open_tenancybreach\", JoinKind.LeftOuter),",
                "    #\"Expanded work_open_tenancybreach\" = Table.ExpandTableColumn(#\"Merged Queries2\", \"work_open_tenancybreach\", {\"tenancy_has_unresolved_breach\"}, {\"tenancy_has_unresolved_breach\"}),",
                "    #\"Replaced Value\" = Table.ReplaceValue(#\"Expanded work_open_tenancybreach\",null,\"No\",Replacer.ReplaceValue,{\"tenancy_has_unresolved_breach\"}),",
                "    #\"Merged Queries3\" = Table.NestedJoin(#\"Replaced Value\", {\"opportunityid\"}, work_open_tenancytribunal, {\"zav_tenancy\"}, \"work_open_tenancytribunal\", JoinKind.LeftOuter),",
                "    #\"Expanded work_open_tenancytribunal\" = Table.ExpandTableColumn(#\"Merged Queries3\", \"work_open_tenancytribunal\", {\"tenancy_has_open_tenancytribunal_dispute\"}, {\"tenancy_has_open_tenancytribunal_dispute\"}),",
                "    #\"Replaced Value1\" = Table.ReplaceValue(#\"Expanded work_open_tenancytribunal\",null,\"No\",Replacer.ReplaceValue,{\"tenancy_has_open_tenancytribunal_dispute\"})",
                "in",
                "    #\"Replaced Value1\""
              ],
              "type": "m"
            }
          }
        ]
