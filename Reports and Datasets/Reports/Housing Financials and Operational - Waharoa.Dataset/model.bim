                "    #\"Expanded dim_program\" = Table.ExpandTableColumn(#\"Merged Queries\", \"dim_program\", {\"zav_name\"}, {\"zav_name.1\"}),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Expanded dim_program\",{{\"zav_name.1\", \"program_name\"}, {\"zav_name\", \"subprogram_name\"}}),",
                "    #\"Reordered Columns\" = Table.ReorderColumns(#\"Renamed Columns\",{\"program_name\", \"subprogram_name\", \"zav_subprogramid\", \"zav_program\"}),",
                "    #\"Removed Columns\" = Table.RemoveColumns(#\"Reordered Columns\",{\"zav_program\"}),",
                "    #\"Added Conditional Column\" = Table.AddColumn(#\"Removed Columns\", \"commercial_yn\", each if Text.Contains([program_name], \"Commercial\") then 1 else 0),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Added Conditional Column\",{{\"commercial_yn\", Int64.Type}})",
                "in",
                "    #\"Changed Type\""
              ],
