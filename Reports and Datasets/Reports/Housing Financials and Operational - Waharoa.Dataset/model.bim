            "source": {
              "expression": [
                "let",
                "    Source = Sql.Database(\"synapseausprod-ondemand.sql.azuresynapse.net\", \"ODS\", [Query=\"WITH RecentSubprograms AS (#(lf)    SELECT#(lf)        zav_subprogramid,#(lf)        zav_name,#(lf)        zav_program,#(lf)        SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (PARTITION BY zav_subprogramid ORDER BY SinkModifiedOn DESC) AS rn#(lf)    FROM#(lf)        [Zavanti].[vw_zav_subprogram]#(lf))#(lf)SELECT#(lf)    zav_subprogramid,#(lf)    zav_name,#(lf)    zav_program#(lf)FROM#(lf)    RecentSubprograms#(lf)WHERE#(lf)    rn = 1\"]),",
