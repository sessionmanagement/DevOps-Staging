            "source": {
              "expression": [
                "",
                "SUMMARIZECOLUMNS(",
                "    work_number_household_members_fy[zav_tenancy],",
                "    work_number_household_members_fy[zav_hhid],",
                "    work_number_household_members_fy[fact_tenancy.zav_tenancystartdate],",
                "    work_number_household_members_fy[fact_tenancy.zav_vacateddate],",
                "    //work_number_household_members_fy[zav_revision], //Uncomment to see non-sumarrised. HH-011222 is a good example.",
                "    work_number_household_members_fy[zav_property],",
                "    work_number_household_members_fy[LastDayOfFY],",
                "    \"MaxHouseholdMembersForTenancyInFY\", MAX(work_number_household_members_fy[zav_numberofhouseholdmembers])",
                ")"
              ],
              "type": "calculated"
            }
          }
        ]
