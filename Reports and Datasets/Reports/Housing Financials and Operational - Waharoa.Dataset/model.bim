            "displayFolder": "2. Measures",
            "expression": [
              "",
              "/*IFERROR(",
              "        IF(",
              "        ISBLANK(",
              "           SUM(TenancyDaysByFY[TenancyActiveDaysInFY])),",
              "           0,",
              "           SUM(TenancyDaysByFY[TenancyActiveDaysInFY]) / SUM(PropertyOwnershipDaysByFY[PropertyOwnershipDaysInFY])",
