            ],
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "CALCULATE(",
              "    SUM(",
              "        fact_tenancy_transaction_details[zav_amount]",
              "    )",
              "    ,PREVIOUSMONTH(dim_date[calendar_date])",
              ")"
            ],
            "formatString": "$#,##0.00;($#,##0.00)",
            "isHidden": true,
