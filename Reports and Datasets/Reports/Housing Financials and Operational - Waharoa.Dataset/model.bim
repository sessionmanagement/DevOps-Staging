          {
            "name": "Format: basic dim_property count (0 is bad, greater than 0 is ok)",
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "displayFolder": "5. Formatting",
            "expression": [
              "",
              "IF(",
              "    [Basic dim_property count] = 0, \"#F47C20\", \"black\"",
              ")"
