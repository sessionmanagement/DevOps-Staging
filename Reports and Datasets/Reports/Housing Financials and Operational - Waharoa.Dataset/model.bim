          {
            "name": "Tenancy Balance as at Date",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isCustom\":true}"
              }
            ],
            "changedProperties": [
              {
                "property": "IsHidden"
              }
            ],
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "VAR MaxDate = MAX(dim_date[calendar_date])",
              "RETURN",
              "CALCULATE(",
              "    SUM(fact_tenancy_transaction_details[zav_amount]),",
              "    ALL(dim_date),",
              "    fact_tenancy_transaction_details[zav_date] <= MaxDate",
              ")"
            ],
            "formatString": "$#,##0.00;($#,##0.00)",
            "lineageTag": "a6986581-7433-4a4c-84f3-3c79f633c365"
          },
          {
            "name": "% undamaged assets",
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "VAR _totalAssets = ",
              "    COUNTROWS(",
              "        fact_inspection_detail)",
              "VAR _undamagedAssets = ",
              "    CALCULATE(",
              "        COUNTROWS(",
              "            fact_inspection_detail),",
              "            fact_inspection_detail[zav_undamagedname] = \"Yes\"",
              "    )",
              "RETURN",
              "_undamagedAssets / _totalAssets"
            ],
            "formatString": "0%;-0%;0%",
            "isHidden": true,
            "lineageTag": "ecfa2c1a-76d2-4033-a785-4e2e90f48b94"
          },
          {
            "name": "% clean assets",
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "VAR _totalAssets = ",
              "    COUNTROWS(",
              "        fact_inspection_detail)",
              "VAR _cleanAssets = ",
              "    CALCULATE(",
              "        COUNTROWS(",
              "            fact_inspection_detail),",
              "            fact_inspection_detail[zav_cleanname] = \"Yes\"",
              "    )",
              "RETURN",
              "_cleanAssets / _totalAssets"
            ],
            "formatString": "0%;-0%;0%",
            "isHidden": true,
            "lineageTag": "769f0718-9be4-4b67-ab92-38e13ca4e905"
          },
          {
            "name": "% working assets",
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "VAR _totalAssets = ",
              "    COUNTROWS(",
              "        fact_inspection_detail)",
              "VAR _workingAssets = ",
              "    CALCULATE(",
              "        COUNTROWS(",
              "            fact_inspection_detail),",
              "            fact_inspection_detail[zav_workingname] = \"Yes\"",
              "    )",
              "RETURN",
              "_workingAssets / _totalAssets"
            ],
            "formatString": "0%;-0%;0%",
            "isHidden": true,
            "lineageTag": "cb2f4c42-ef49-4ffa-b7d3-ea827db90f1a"
