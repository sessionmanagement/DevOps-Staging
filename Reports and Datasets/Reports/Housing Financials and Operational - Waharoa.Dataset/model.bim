                "    Source = Sql.Database(\"synapseausprod-ondemand.sql.azuresynapse.net\", \"ODS\", [Query=\"WITH RankedProperties AS (#(lf)    SELECT DISTINCT#(lf)        zav_propertyid,#(lf)        statuscode,#(lf)#(tab)#(tab)new_yearbuilt,#(lf)        zav_acquireddate,#(lf)#(tab)#(tab)zav_disposaldate,#(lf)        zav_confirmeddisposaldate,#(lf)        SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (PARTITION BY zav_propertyid ORDER BY SinkModifiedOn DESC) AS rn#(lf)    FROM#(lf)        [Zavanti].[vw_zav_property]#(lf))#(lf)SELECT#(lf)        zav_propertyid,#(lf)        statuscode,#(lf)#(tab)#(tab)new_yearbuilt,#(lf)        zav_acquireddate,#(lf)#(tab)#(tab)zav_disposaldate,#(lf)        zav_confirmeddisposaldate#(lf)FROM#(lf)    RankedProperties#(lf)WHERE#(lf)    rn = 1\"]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"zav_acquireddate\", type date}, {\"zav_confirmeddisposaldate\", type date}})",
                "in",
                "    #\"Changed Type\""
              ],
              "type": "m"
            }
          }
        ]
