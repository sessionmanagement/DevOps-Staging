        "partitions": [
          {
            "name": "fact_tenancy_transaction_details-c5f85cd9-c0c6-42c5-b750-11812e159736",
            "mode": "import",
            "queryGroup": "facts",
            "source": {
              "expression": [
                "let",
                "    Source = Sql.Database(\"synapseausprod-ondemand.sql.azuresynapse.net\", \"ODS\", [Query=\"WITH optionHashTable AS #(lf)(#(lf)    SELECT#(lf)        [OptionSetName],#(lf)        [Option],#(lf)        [EntityName],#(lf)        HASHBYTES('MD5', [OptionSetName] + CAST([Option] AS nvarchar(100)) + [EntityName]) AS optionHash,#(lf)        [LocalizedLabel]#(lf)    FROM #(lf)        [Zavanti].[vw_GlobalOptionsetMetadata]#(lf)#(lf)    UNION#(lf)#(lf)    SELECT#(lf)        [OptionSetName],#(lf)        [Option],#(lf)        [EntityName],#(lf)        HASHBYTES('MD5', [OptionSetName] + CAST([Option] AS nvarchar(100)) + [EntityName]) AS optionHash,#(lf)        [LocalizedLabel]#(lf)    FROM #(lf)        [Zavanti].[vw_OptionsetMetadata]#(lf)#(lf)    UNION#(lf)#(lf)    SELECT#(lf)        'statuscodename' AS [OptionSetName],#(lf)        [status] AS [Option],#(lf)        [EntityName],#(lf)        HASHBYTES('MD5', 'statuscodename' + CAST([status] AS nvarchar(100)) + [EntityName]) AS optionHash,#(lf)        [LocalizedLabel]#(lf)    FROM #(lf)        [Zavanti].[vw_StatusMetadata]#(lf)#(lf)    UNION#(lf)#(lf)    SELECT#(lf)        'statecodename' AS [OptionSetName],#(lf)        [state] AS [Option],#(lf)        [EntityName],#(lf)        HASHBYTES('MD5', 'statecodename' + CAST([state] AS nvarchar(100)) + [EntityName]) AS optionHash,#(lf)        [LocalizedLabel]#(lf)    FROM #(lf)        [Zavanti].[vw_StateMetadata]#(lf)),#(lf)RecentTenancyTransactionDetails AS (#(lf)    SELECT#(lf)        zav_tenancytransactiondetailsid,#(lf)        zav_name,#(lf)        new_suspenseaccount,#(lf)        new_transactiontypecode,#(lf)        zav_accounttype,#(lf)        zav_amount,#(lf)        zav_comments,#(lf)        zav_date,#(lf)        zav_propertyreferencenumber,#(lf)        zav_rent,#(lf)        zav_rentpaidto,#(lf)        zav_tenancy,#(lf)        zav_transaction,#(lf)        zav_tenancyname,#(lf)        zav_transactiontypename,#(lf)        zav_subtransactionname,#(lf)        createdon,#(lf)        SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (PARTITION BY zav_tenancytransactiondetailsid ORDER BY SinkModifiedOn DESC) AS rn#(lf)    FROM #(lf)        [Zavanti].[vw_zav_tenancytransactiondetails]#(lf)#(tab)WHERE#(lf)#(tab)#(tab)new_suspenseaccount = 'False'#(lf))#(lf)SELECT DISTINCT#(lf)    rtt.zav_tenancytransactiondetailsid,#(lf)    rtt.zav_name,#(lf)    rtt.new_suspenseaccount,#(lf)    rtt.new_transactiontypecode,#(lf)    t1.LocalizedLabel AS zav_accounttypename,#(lf)    rtt.zav_amount,#(lf)    rtt.zav_comments,#(lf)    rtt.zav_date,#(lf)    rtt.zav_propertyreferencenumber,#(lf)    t2.LocalizedLabel AS zav_rentname,#(lf)    rtt.zav_rentpaidto,#(lf)    rtt.zav_tenancy,#(lf)    t3.LocalizedLabel AS zav_transactionname,#(lf)    rtt.zav_tenancyname,#(lf)    rtt.zav_transactiontypename,#(lf)    rtt.zav_subtransactionname,#(lf)    rtt.createdon#(lf)FROM #(lf)    RecentTenancyTransactionDetails rtt#(lf)LEFT OUTER JOIN #(lf)    optionHashTable t1 ON t1.optionHash = HASHBYTES('MD5', 'zav_accounttype' + CAST(rtt.zav_accounttype AS nvarchar(100)) + 'zav_tenancytransactiondetails')#(lf)LEFT OUTER JOIN #(lf)    optionHashTable t2 ON t2.optionHash = HASHBYTES('MD5', 'zav_rent' + CAST(rtt.zav_rent AS nvarchar(100)) + 'zav_tenancytransactiondetails')#(lf)LEFT OUTER JOIN #(lf)    optionHashTable t3 ON t3.optionHash = HASHBYTES('MD5', 'zav_transaction' + CAST(rtt.zav_transaction AS nvarchar(100)) + 'zav_tenancytransactiondetails')#(lf)WHERE#(lf)    rtt.rn = 1\"]),",
                "    #\"Merged Queries\" = Table.NestedJoin(Source, {\"zav_tenancy\"}, fact_tenancy, {\"opportunityid\"}, \"fact_tenancy\", JoinKind.LeftOuter),",
                "    #\"Expanded fact_tenancy\" = Table.ExpandTableColumn(#\"Merged Queries\", \"fact_tenancy\", {\"zav_property\", \"zav_subprogram\", \"zav_tenancystartdate\", \"zav_vacateddate\", \"tenancymanagerid\", \"region_name\", \"tenancy_has_unresolved_breach\", \"tenancy_has_open_tenancytribunal_dispute\"}, {\"zav_property\", \"zav_subprogram\", \"zav_tenancystartdate\", \"zav_vacateddate\", \"tenancymanagerid\", \"region_name\", \"tenancy_has_unresolved_breach\", \"tenancy_has_open_tenancytribunal_dispute\"})",
                "in",
                "    #\"Expanded fact_tenancy\""
              ],
              "type": "m"
            }
          }
        ]
