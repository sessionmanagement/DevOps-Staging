          {
            "name": "calendar_month_year_combined",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "changedProperties": [
              {
                "property": "SortByColumn"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "dim_date[calendar_month_name_short] & \"-\" & RIGHT(YEAR(dim_date[calendar_date]),2)"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "b9a69ded-25e6-4fd6-b521-98ce7ab35536",
            "sortByColumn": "calendar_last_day_of_month_date",
