tab)zav_inspectiondetailid IS NOT NULL#(lf))#(lf)SELECT#(lf)    rid.zav_inspectiondetailid,#(lf)    rid.zav_assetcondition,#(lf)    t1.LocalizedLabel AS zav_assetconditionname,#(lf)    t2.LocalizedLabel AS zav_cleanname,#(lf)    rid.zav_comments,#(lf)    rid.zav_inspectionid,#(lf)    t3.LocalizedLabel AS zav_undamagedname,#(lf)    t4.LocalizedLabel AS zav_workingname,#(lf)    rid.zav_assetsname,#(lf)    rid.zav_areaname,#(lf)    rid.zav_propertyassetsname#(lf)FROM #(lf)    RecentInspectionDetails rid#(lf)LEFT OUTER JOIN #(lf)    optionHashTable t1 ON t1.optionHash = HASHBYTES('MD5', 'zav_assetcondition' + CAST(rid.zav_assetcondition AS nvarchar(100)) + 'zav_inspectiondetail')#(lf)LEFT OUTER JOIN #(lf)    optionHashTable t2 ON t2.optionHash = HASHBYTES('MD5', 'zav_clean' + CAST(rid.zav_clean AS nvarchar(100)) + 'zav_inspectiondetail')#(lf)LEFT OUTER JOIN #(lf)    optionHashTable t3 ON t3.optionHash = HASHBYTES('MD5', 'zav_undamaged' + CAST(rid.zav_undamaged AS nvarchar(100)) + 'zav_inspectiondetail')#(lf)LEFT OUTER JOIN #(lf)    optionHashTable t4 ON t4.optionHash = HASHBYTES('MD5', 'zav_working' + CAST(rid.zav_working AS nvarchar(100)) + 'zav_inspectiondetail')#(lf)WHERE#(lf)    rid.rn = 1\"])",
