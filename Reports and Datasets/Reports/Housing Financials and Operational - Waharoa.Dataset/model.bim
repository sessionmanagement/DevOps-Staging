            "queryGroup": "facts",
            "source": {
              "expression": [
                "let",
                "    Source = Sql.Database(\"synapseausprod-ondemand.sql.azuresynapse.net\", \"ODS\", [Query=\"WITH optionHashTable AS #(lf)(#(lf)    SELECT#(lf)        [OptionSetName],#(lf)        [Option],#(lf)        [EntityName],#(lf)        HASHBYTES('MD5', [OptionSetName] + CAST([Option] AS nvarchar(100)) + [EntityName]) AS optionHash,#(lf)        [LocalizedLabel]#(lf)    FROM #(lf)        [Zavanti].[vw_GlobalOptionsetMetadata]#(lf)#(lf)    UNION#(lf)#(lf)    SELECT#(lf)        [OptionSetName],#(lf)        [Option],#(lf)        [EntityName],#(lf)        HASHBYTES('MD5', [OptionSetName] + CAST([Option] AS nvarchar(100)) + [EntityName]) AS optionHash,#(lf)        [LocalizedLabel]#(lf)    FROM #(lf)        [Zavanti].[vw_OptionsetMetadata]#(lf)#(lf)    UNION#(lf)#(lf)    SELECT#(lf)        'statuscodename' AS [OptionSetName],#(lf)        [status] AS [Option],#(lf)        [EntityName],#(lf)        HASHBYTES('MD5', 'statuscodename' + CAST([status] AS nvarchar(100)) + [EntityName]) AS optionHash,#(lf)        [LocalizedLabel]#(lf)    FROM #(lf)        [Zavanti].[vw_StatusMetadata]#(lf)#(lf)    UNION#(lf)#(lf)    SELECT#(lf)        'statecodename' AS [OptionSetName],#(lf)        [state] AS [Option],#(lf)        [EntityName],#(lf)        HASHBYTES('MD5', 'statecodename' + CAST([state] AS nvarchar(100)) + [EntityName]) AS optionHash,#(lf)        [LocalizedLabel]#(lf)    FROM #(lf)        [Zavanti].[vw_StateMetadata]#(lf)),#(lf)RecentZavTenancyBreach AS (#(lf)    SELECT#(lf)        zav_tenancybreachid,#(lf)        zav_name,#(lf)        zav_breachdate,#(lf)        zav_breachid,#(lf)        zav_tenancy,#(lf)#(tab)#(tab)zav_breachstatus,#(lf)        SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (PARTITION BY zav_tenancybreachid ORDER BY SinkModifiedOn DESC) AS rn#(lf)    FROM#(lf)        [Zavanti].[vw_zav_tenancybreach]#(lf)    WHERE #(lf)        zav_tenancybreachid IS NOT NULL#(lf)),#(lf)RecentZavTribunalOrder AS (#(lf)    SELECT#(lf)        zav_tribunalorderid,#(lf)        zav_name,#(lf)        zav_enddate,#(lf)        zav_startdate,#(lf)        zav_tribunaloutcome,#(lf)        zav_casename,#(lf)        zav_tenancybreachname,#(lf)        zav_tribunaloutcomename,#(lf)        zav_tribunaloutcomereasonname,#(lf)        zav_tenancybreach,#(lf)        SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (PARTITION BY zav_tribunalorderid ORDER BY SinkModifiedOn DESC) AS rn#(lf)    FROM#(lf)        [Zavanti].[vw_zav_tribunalorder]#(lf)    WHERE#(lf)        zav_tribunalorderid IS NOT NULL#(lf))#(lf)SELECT#(lf)    rtb.zav_tenancybreachid,#(lf)    rtb.zav_name,#(lf)    rtb.zav_breachdate,#(lf)    rtb.zav_breachid,#(lf)    t1.LocalizedLabel AS zav_breachstatusname,#(lf)    rtb.zav_tenancy,#(lf)    rto.zav_tribunalorderid,#(lf)    rto.zav_name AS tribunalorder_zav_name,#(lf)    rto.zav_enddate,#(lf)    rto.zav_startdate,#(lf)    rto.zav_tribunaloutcome,#(lf)    rto.zav_casename,#(lf)    rto.zav_tenancybreachname,#(lf)    rto.zav_tribunaloutcomename,#(lf)    rto.zav_tribunaloutcomereasonname#(lf)FROM #(lf)    RecentZavTenancyBreach rtb#(lf)LEFT OUTER JOIN #(lf)    optionHashTable t1 #(lf)ON #(lf)    t1.optionHash = HASHBYTES('MD5', 'zav_breachstatus' + CAST(rtb.zav_breachstatus AS nvarchar(100)) + 'zav_tenancybreach')#(lf)LEFT OUTER JOIN #(lf)    RecentZavTribunalOrder rto #(lf)ON #(lf)    rto.zav_tenancybreach = rtb.zav_tenancybreachid AND rto.rn = 1#(lf)WHERE#(lf)    rtb.rn = 1\"]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"zav_breachdate\", type date}}),",
                "    #\"Filtered Rows\" = Table.SelectRows(#\"Changed Type\", each [zav_tenancy] <> null and [zav_tenancy] <> \"\"),",
                "    #\"Changed Type1\" = Table.TransformColumnTypes(#\"Filtered Rows\",{{\"zav_enddate\", type date}, {\"zav_startdate\", type date}}),",
                "    #\"Added Conditional Column\" = Table.AddColumn(#\"Changed Type1\", \"breach_went_to_tenancy_tribunal\", each if [zav_tribunalorderid] = null then \"No\" else \"Yes\"),",
                "    #\"Added Conditional Column1\" = Table.AddColumn(#\"Added Conditional Column\", \"breach_closed\", each if [zav_breachstatusname] = \"Closed\" then \"Yes\" else \"No\"),",
                "    #\"Merged Queries\" = Table.NestedJoin(#\"Added Conditional Column1\", {\"zav_tenancy\"}, work_opportunity, {\"opportunityid\"}, \"work_opportunity\", JoinKind.LeftOuter),",
                "    #\"Expanded work_opportunity\" = Table.ExpandTableColumn(#\"Merged Queries\", \"work_opportunity\", {\"zav_property\", \"zav_tenancymanagerid\"}, {\"zav_property\", \"zav_tenancymanagerid\"})",
                "in",
                "    #\"Expanded work_opportunity\""
              ],
              "type": "m"
            }
          }
        ]
