            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Report Description",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This report shows information from the Mind and Body and Emerge Aotearoa Ltd RecordBase systems.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Where relevant, each referral has been split into the financial years that it spans. This is also true for absences.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "For example, consider the following scenario:",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "A referral for Residential is accepted on 18/02/2020 and continues until the person is discharged on 25/07/2022.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The total number of days that the referral was active is 888 days.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This means that the referral was active for:",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "134 days in FY 2020;",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "365 days in FY 2021;",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "365 days in FY 2022;",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "25 days in FY 2023",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This report will calculate referrals in alignment with this concept. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Note: for referrals, the start and end date are included as full days, so if a referral is accepted and discharged on the same day, it will count as 1 day.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "For nights absent, only overnight absences (i.e. from one day to the next) are counted as an absent night. If the absence starts and finishes on the same day, it is not counted as a night absent.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The demographic information also takes into consideration the selected financial year. The person's age is calculated as at the end of the selected financial year (if prior to the current financial year). The person also needs to have had at least one active referral in the selected financial year in order for their information to be included.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Important notes:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The following Team Functions have been excluded from the report to prevent double counting of referrals:",
                    "textStyle": {
