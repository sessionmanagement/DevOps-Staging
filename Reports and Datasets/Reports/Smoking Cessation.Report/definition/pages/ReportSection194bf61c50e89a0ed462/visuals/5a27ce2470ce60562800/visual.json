          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Welcome to the ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt"
                    }
                  },
                  {
                    "value": "Smoking Cessation Report",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#018db1"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This report shows information from the Mind and Body and Emerge Aotearoa Ltd RecordBase systems.  ",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "For more detailed information on the underlying data that the visuals are built upon, please click the question mark button in the top right-hand corner of any page.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How to use this report:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "From this page, you can set filters that will be applied throughout the report.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "On each page, you can change the filters rather than doing so by navigating back to this page. To access the filters on each page, click the menu icon in the top left-hand corner. Any changes you make will be reflected on all pages.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "If you wish to reset the filters and set them back to default, you can click the X button in the top right-hand corner from any page",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "At the bottom of each page there is a text box detailing any filters that have explicitly been applied. If nothing is showing for Company, for example, it means that ",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": "all",
                    "textStyle": {
                      "fontSize": "11pt",
                      "textDecoration": "underline"
                    }
                  },
                  {
                    "value": " companies are selected, and there is no active filter applied to that field.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              }
            ]
          }
        }
      ]
