        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Welcome to the ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt"
                    }
                  },
                  {
                    "value": "Kaimahi Core Training ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#018db1"
                    }
                  },
                  {
                    "value": "report",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This report shows information from Akoranga for both Emerge Aotearoa Ltd and Mind and Body. You can see all core training completion numbers and percentages, for courses, programs and certifications. These are grouped together to give you an \"Overall completion\" so you can easily see what areas to focus on.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "For more detailed information on the underlying data that the visuals are built upon, please click the question mark button in the top right-hand corner of any page.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How to use this report:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "From this page, you can set filters that will be applied throughout the report.",
                    "textStyle": {
                      "fontSize": "9pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "On each page, you can change the filters* rather than doing so by navigating back to this page. To access the filters on these pages, click the menu icon (3 horizontal lines or 'hamburger') on the top right-hand corner. Any changes you make will be reflected on all pages.",
                    "textStyle": {
                      "fontSize": "9pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "If you wish to reset the filters and set them back to default, you can click the X button in the top right-hand corner from any page",
                    "textStyle": {
                      "fontSize": "9pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "At the bottom of each page there is a text box detailing any filters that have explicitly been applied. If nothing is showing for Service Name, for example, it means that ",
                    "textStyle": {
                      "fontSize": "9pt"
                    }
                  },
                  {
                    "value": "all",
                    "textStyle": {
                      "fontSize": "9pt",
                      "textDecoration": "underline"
                    }
                  },
                  {
                    "value": " Service Names are selected, and there is no active filter applied to that field.",
                    "textStyle": {
                      "fontSize": "9pt"
                    }
                  }
                ],
                "listType": "bullet"
              }
            ]
          }
        }
      ]
    },
