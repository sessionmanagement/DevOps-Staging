        "partitions": [
          {
            "name": "dim_ethnicity",
            "mode": "import",
            "queryGroup": "dimensions",
            "source": {
              "expression": [
                "let",
                "    Source = Sql.Database(\"synapseausprod-ondemand.sql.azuresynapse.net\", \"ODS\", [Query=\"WITH RecentEthnicity AS (#(lf)    SELECT#(lf)        zav_ethnicityid,#(lf)        zav_name,#(lf)        SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (PARTITION BY zav_ethnicityid ORDER BY SinkModifiedOn DESC) AS rn#(lf)    FROM #(lf)        [Zavanti].[vw_zav_ethnicity]#(lf))#(lf)SELECT DISTINCT#(lf)    re.zav_ethnicityid,#(lf)    re.zav_name#(lf)FROM #(lf)    RecentEthnicity re#(lf)WHERE#(lf)    re.rn = 1\"]),",
                "    #\"Sorted Rows\" = Table.Sort(Source,{{\"zav_name\", Order.Ascending}}),",
                "    #\"Added Conditional Column\" = Table.AddColumn(#\"Sorted Rows\", \"ethnicity_new\", each ",
                "\tif Text.Contains(Text.Lower([zav_name]), \"maori\") then \"Māori\" ",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"aboriginal australian\") then \"Oceania Other\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"admiralty islander\") then \"Oceania Other\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"afghan\") then \"Middle Eastern, Latin American, African\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"africa\") then \"Middle Eastern, Latin American, African\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"afrikaner\") then \"Middle Eastern, Latin American, African\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"aitutaki islander\") then \"Oceania Other\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"albanian\") then \"European\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"algerian\") then \"Middle Eastern, Latin American, African\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"american\") then \"Other\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"antiguan and barbudan\") then \"Caribbean\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"arab\") then \"Middle Eastern, Latin American, African\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"argentine\") then \"Middle Eastern, Latin American, African\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"argentinian\") then \"Middle Eastern, Latin American, African\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"armenian\") then \"European\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"asian\") then \"Asian\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"atiu islander\") then \"Oceania Other\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"austral islander\") then \"Oceania Other\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"australia\") then \"European\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"austrian\") then \"European\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"bahamian\") then \"Caribbean\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"bangladeshi\") then \"Asian\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"barbadian\") then \"Caribbean\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"belarusian\") then \"European\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"belau/palauislander\") then \"Oceania Other\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"belgian\") then \"European\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"bengali\") then \"Asian\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"bismark archipelagoan\") then \"Oceania Other\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"bolivian\") then \"Middle Eastern, Latin American, African\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"bosnian\") then \"European\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"bougainvillean\") then \"Oceania Other\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"brazilian\") then \"Middle Eastern, Latin American, African\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"british\") then \"European\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"bulgarian\") then \"European\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"burgher\") then \"Other\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"burmese\") then \"Asian\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"cambodia\") then \"Asian\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"canadian\") then \"Other\"",
                "\telse if Text.Contains(Text.Lower([zav_name]), \"caroline islander\") then \"Oceania Other\"",
