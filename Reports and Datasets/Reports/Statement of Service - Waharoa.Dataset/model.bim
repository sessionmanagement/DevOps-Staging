                "let",
                "    Source = Sql.Database(\"synapseausprod-ondemand.sql.azuresynapse.net\", \"ODS\", [Query=\"WITH GlobalOptionsetMetadataHashTable AS #(lf)(#(lf)    SELECT#(lf)        HASHBYTES('MD5', [OptionSetName] + CAST([Option] AS nvarchar(100)) + [EntityName]) AS [GlobalOptionsetHash],#(lf)        [LocalizedLabel]#(lf)    FROM #(lf)        [Zavanti].[vw_GlobalOptionsetMetadata]#(lf)),#(lf)RankedProperties AS (#(lf)    SELECT#(lf)        zav_propertyid,#(lf)        statuscode,#(lf)        zav_name,#(lf)        HASHBYTES('MD5', 'new_propertystatus' + CAST(new_propertystatus AS nvarchar(100)) + 'zav_property') AS statusHash,#(lf)        new_yearbuilt,#(lf)        zav_acquireddate,#(lf)        zav_propertyownership,#(lf)        zav_propertytypeid,#(lf)        zav_subprogram,#(lf)        new_postalregionname,#(lf)        zav_fulladdress,#(lf)#(tab)#(tab)zav_suburb,#(lf)        zav_legalowneridname,#(lf)#(tab)#(tab)zav_giftedname,#(lf)        zav_confirmeddisposaldate,#(lf)        SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (PARTITION BY zav_propertyid ORDER BY SinkModifiedOn DESC) AS rn#(lf)    FROM#(lf)        [Zavanti].[vw_zav_property]#(lf))#(lf)#(lf)SELECT#(lf)    rp.zav_propertyid,#(lf)    rp.statuscode,#(lf)    rp.zav_name,#(lf)    gom.LocalizedLabel AS new_propertystatusname,#(lf)    rp.new_yearbuilt,#(lf)    rp.zav_acquireddate,#(lf)    rp.zav_propertyownership,#(lf)    rp.zav_propertytypeid,#(lf)    rp.zav_subprogram,#(lf)    rp.new_postalregionname,#(lf)    rp.zav_fulladdress,#(lf)#(tab)rp.zav_suburb,#(lf)    rp.zav_legalowneridname,#(lf)#(tab)rp.zav_giftedname,#(lf)    rp.zav_confirmeddisposaldate#(lf)FROM#(lf)    RankedProperties rp#(lf)LEFT OUTER JOIN #(lf)    GlobalOptionsetMetadataHashTable gom ON gom.GlobalOptionsetHash = rp.statusHash#(lf)WHERE#(lf)    rp.rn = 1\"]),",
                "    #\"Sorted Rows1\" = Table.Sort(Source,{{\"zav_name\", Order.Ascending}}),",
                "    #\"Removed Duplicates\" = Table.Distinct(#\"Sorted Rows1\", {\"zav_propertyid\"}),",
