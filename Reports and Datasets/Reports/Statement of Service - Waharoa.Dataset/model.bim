                "    #\"Added Conditional Column\" = Table.AddColumn(#\"Renamed Columns\", \"rowdateeffective\", each if [work_rowdateeffective] = null then [fact_tenancy.zav_tenancystartdate] else [work_rowdateeffective]),",
                "    #\"Filtered Rows\" = Table.SelectRows(#\"Added Conditional Column\", each [rowdateeffective] <> null and [rowdateeffective] <> \"\"),",
                "    #\"Reordered Columns\" = Table.ReorderColumns(#\"Filtered Rows\",{\"statuscodename\", \"zav_householdstatusname\", \"zav_tenancy\", \"zav_hhid\", \"zav_numberofhouseholdmembers\", \"fact_tenancy.zav_tenancystartdate\", \"zav_dateofamendment\", \"fact_tenancy.zav_vacateddate\", \"zav_revision\", \"composite_hh_revision_minus_one\", \"work_rowdateeffective\", \"rowdateeffective\", \"rowexpirydate\"}),",
                "    #\"Merged Queries\" = Table.NestedJoin(#\"Reordered Columns\", {\"zav_tenancy\"}, fact_tenancy, {\"opportunityid\"}, \"fact_tenancy\", JoinKind.LeftOuter),",
                "    #\"Expanded fact_tenancy\" = Table.ExpandTableColumn(#\"Merged Queries\", \"fact_tenancy\", {\"zav_property\", \"zav_ethnicity\", \"zav_gender\"}, {\"zav_property\", \"zav_ethnicity\", \"zav_gender\"}),",
                "    #\"Replaced Value\" = Table.ReplaceValue(#\"Expanded fact_tenancy\",null,\"0\",Replacer.ReplaceValue,{\"zav_ethnicity\"}),",
                "    #\"Replaced Value1\" = Table.ReplaceValue(#\"Replaced Value\",null,100000001,Replacer.ReplaceValue,{\"zav_gender\"}),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Replaced Value1\",{{\"rowdateeffective\", Int64.Type}}),",
                "    #\"Added Custom\" = Table.AddColumn(#\"Changed Type\", \"explosion\", each {[rowdateeffective]..[rowexpirydate]}),",
