    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "expressions": [
      {
        "name": "merged_dim_program",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          }
        ],
        "expression": [
          "let",
          "    Source = Sql.Database(\"synapseausprod-ondemand.sql.azuresynapse.net\", \"ODS\", [Query=\"WITH RecentPrograms AS (#(lf)    SELECT#(lf)        zav_programid,#(lf)        zav_name,#(lf)        SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (PARTITION BY zav_programid ORDER BY SinkModifiedOn DESC) AS rn#(lf)    FROM#(lf)        [Zavanti].[vw_zav_program]#(lf))#(lf)SELECT#(lf)    zav_programid,#(lf)    zav_name#(lf)FROM#(lf)    RecentPrograms#(lf)WHERE#(lf)    rn = 1\"])",
          "in",
          "    Source"
        ],
        "kind": "m",
        "lineageTag": "a2438e0d-2936-4ab2-9c48-1c688bcda74b",
        "queryGroup": "unloaded"
      },
      {
        "name": "merged_household",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          }
        ],
        "expression": [
          "let",
          "    Source = Sql.Database(\"synapseausprod-ondemand.sql.azuresynapse.net\", \"ODS\", [Query=\"WITH optionHashTable AS #(lf)(#(lf)    SELECT#(lf)        [OptionSetName],#(lf)        [Option],#(lf)        [EntityName],#(lf)        HASHBYTES('MD5', [OptionSetName] + CAST([Option] AS nvarchar(100)) + [EntityName]) AS optionHash,#(lf)        [LocalizedLabel]#(lf)    FROM #(lf)        [Zavanti].[vw_GlobalOptionsetMetadata]#(lf)#(lf)    UNION#(lf)#(lf)    SELECT#(lf)        [OptionSetName],#(lf)        [Option],#(lf)        [EntityName],#(lf)        HASHBYTES('MD5', [OptionSetName] + CAST([Option] AS nvarchar(100)) + [EntityName]) AS optionHash,#(lf)        [LocalizedLabel]#(lf)    FROM #(lf)        [Zavanti].[vw_OptionsetMetadata]#(lf)#(lf)    UNION#(lf)#(lf)    SELECT#(lf)        'statuscodename' AS [OptionSetName],#(lf)        [status] AS [Option],#(lf)        [EntityName],#(lf)        HASHBYTES('MD5', 'statuscodename' + CAST([status] AS nvarchar(100)) + [EntityName]) AS optionHash,#(lf)        [LocalizedLabel]#(lf)    FROM #(lf)        [Zavanti].[vw_StatusMetadata]#(lf)#(lf)    UNION#(lf)#(lf)    SELECT#(lf)        'statecodename' AS [OptionSetName],#(lf)        [state] AS [Option],#(lf)        [EntityName],#(lf)        HASHBYTES('MD5', 'statecodename' + CAST([state] AS nvarchar(100)) + [EntityName]) AS optionHash,#(lf)        [LocalizedLabel]#(lf)    FROM #(lf)        [Zavanti].[vw_StateMetadata]#(lf)),#(lf)RecentHouseholds AS (#(lf)    SELECT#(lf)        zav_dateofamendment,#(lf)        zav_hhid,#(lf)        zav_householdstatus,#(lf)        zav_numberofhouseholdmembers,#(lf)        zav_revision,#(lf)        zav_tenancy,#(lf)        statuscode,#(lf)        SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (PARTITION BY zav_hhid ORDER BY SinkModifiedOn DESC) AS rn#(lf)    FROM#(lf)        [Zavanti].[vw_zav_household]#(lf))#(lf)SELECT#(lf)    t1.LocalizedLabel AS statuscodename,#(lf)    rh.zav_dateofamendment,#(lf)    rh.zav_hhid,#(lf)    t2.LocalizedLabel AS zav_householdstatusname,#(lf)    rh.zav_numberofhouseholdmembers,#(lf)    rh.zav_revision,#(lf)    rh.zav_tenancy#(lf)FROM #(lf)    RecentHouseholds rh#(lf)LEFT OUTER JOIN #(lf)    optionHashTable t1 ON t1.optionHash = HASHBYTES('MD5', 'statuscodename' + CAST(rh.statuscode AS nvarchar(100)) + 'zav_household')#(lf)LEFT OUTER JOIN #(lf)    optionHashTable t2 ON t2.optionHash = HASHBYTES('MD5', 'zav_householdstatus' + CAST(rh.zav_householdstatus AS nvarchar(100)) + 'zav_household')#(lf)WHERE#(lf)    rh.rn = 1\"]),",
          "    #\"Filtered Rows\" = Table.SelectRows(Source, each ([zav_householdstatusname] <> \"Draft\"))",
          "in",
          "    #\"Filtered Rows\""
        ],
        "kind": "m",
        "lineageTag": "1eec40e1-45df-4e77-95cb-4af709a80639",
        "queryGroup": "unloaded"
      },
      {
        "name": "pre_work_number_household_members_dates",
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "expression": [
          "let",
          "    Source = Table.NestedJoin(merged_household, {\"zav_tenancy\"}, fact_tenancy, {\"opportunityid\"}, \"fact_tenancy\", JoinKind.LeftOuter),",
          "    #\"Expanded fact_tenancy\" = Table.ExpandTableColumn(Source, \"fact_tenancy\", {\"zav_tenancystartdate\", \"zav_vacateddate\"}, {\"fact_tenancy.zav_tenancystartdate\", \"fact_tenancy.zav_vacateddate\"}),",
          "    #\"Reordered Columns\" = Table.ReorderColumns(#\"Expanded fact_tenancy\",{\"statuscodename\", \"zav_householdstatusname\", \"zav_revision\", \"zav_tenancy\", \"zav_hhid\", \"zav_numberofhouseholdmembers\", \"fact_tenancy.zav_tenancystartdate\", \"zav_dateofamendment\", \"fact_tenancy.zav_vacateddate\"}),",
          "    #\"Added Custom\" = Table.AddColumn(#\"Reordered Columns\", \"rowexpirydate\", each if [zav_dateofamendment] <> null then ([zav_dateofamendment]) else if [fact_tenancy.zav_vacateddate] <> null then ([fact_tenancy.zav_vacateddate]) else (DateTime.LocalNow())),",
          "    #\"Added Custom1\" = Table.AddColumn(#\"Added Custom\", \"hhid_revision_concat\", each [zav_hhid] & \"-\" & Text.From([zav_revision]))",
          "in",
          "    #\"Added Custom1\""
        ],
        "kind": "m",
        "lineageTag": "30bdf960-6782-41ce-8036-7d6651f8b494",
        "queryGroup": "unloaded"
      },
      {
        "name": "pre_work_number_household_members_dates_for_prev_revision",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "expression": [
          "let",
