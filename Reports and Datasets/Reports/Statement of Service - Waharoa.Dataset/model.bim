          "    #\"Removed Columns\" = Table.RemoveColumns(#\"Changed Type1\",{\"Custom\", \"today\"}),",
          "    #\"Filtered Rows\" = Table.SelectRows(#\"Removed Columns\", each ([zav_datekeyreceivedfromtenant] = null) and ([zav_datekeystotenancyteamtoallocate] <> null) and ([zav_property] <> null)),",
          "    #\"Filtered Rows1\" = Table.SelectRows(#\"Filtered Rows\", each [zav_datekeystotenancyteamtoallocate] <> null and [zav_datekeystotenancyteamtoallocate] <> \"\"),",
          "    #\"Merged Queries\" = Table.NestedJoin(#\"Filtered Rows1\", {\"zav_property\"}, dim_property, {\"zav_propertyid\"}, \"dim_property\", JoinKind.LeftOuter),",
          "    #\"Expanded dim_property\" = Table.ExpandTableColumn(#\"Merged Queries\", \"dim_property\", {\"zav_fulladdress\", \"zav_acquireddate\"}, {\"zav_fulladdress\", \"zav_acquireddate\"}),",
          "    #\"Reordered Columns\" = Table.ReorderColumns(#\"Expanded dim_property\",{\"createdon\", \"zav_fulladdress\", \"statecodename\", \"zav_datekeyreceivedfromtenant\", \"zav_acquireddate\", \"zav_datekeystotenancyteamtoallocate\", \"zav_property\", \"zav_voidcheckliststatusname\"}),",
