                "    #\"Merged Queries1\" = Table.NestedJoin(#\"Renamed Columns\", {\"zav_propertyid\"}, work_first_tenancy_by_property, {\"zav_property\"}, \"work_first_tenancy_by_property\", JoinKind.LeftOuter),",
