        "partitions": [
          {
            "name": "fact_tenancy-86a0de21-ed98-43c9-bb49-729f3ff2eee1",
            "mode": "import",
            "queryGroup": "facts",
            "source": {
              "expression": [
                "let",
                "    Source = Sql.Database(\"synapseausprod-ondemand.sql.azuresynapse.net\", \"ODS\", [Query=\"WITH RecentOpportunities AS (#(lf)    SELECT#(lf)        opportunityid,#(lf)        name,#(lf)        parentcontactid,#(lf)        zav_leavingreason,#(lf)        zav_property,#(lf)        zav_subprogram,#(lf)        zav_tenancystartdate,#(lf)        zav_vacateddate,#(lf)        zav_propertyname,#(lf)        zav_tenancymanagerid,#(lf)        SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (PARTITION BY opportunityid ORDER BY SinkModifiedOn DESC) AS rn#(lf)    FROM#(lf)        [Zavanti].[vw_opportunity]#(lf)    WHERE#(lf)        statuscode <> 4#(lf))#(lf)SELECT#(lf)    opportunityid,#(lf)    name,#(lf)    parentcontactid,#(lf)    zav_leavingreason,#(lf)    zav_property,#(lf)    zav_subprogram,#(lf)    zav_tenancystartdate,#(lf)    zav_vacateddate,#(lf)    zav_propertyname,#(lf)    zav_tenancymanagerid#(lf)FROM#(lf)    RecentOpportunities#(lf)WHERE#(lf)    rn = 1\"]),",
                "#\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"zav_tenancystartdate\", type date}, {\"zav_vacateddate\", type date}}),",
                "    #\"Merged Queries\" = Table.NestedJoin(#\"Changed Type\", {\"zav_property\"}, dim_property, {\"zav_propertyid\"}, \"dim_property\", JoinKind.LeftOuter),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Merged Queries\",{{\"zav_tenancymanagerid\", \"tenancymanagerid\"}}),",
                "    #\"Expanded dim_property\" = Table.ExpandTableColumn(#\"Renamed Columns\", \"dim_property\", {\"new_postalregionname\"}, {\"dim_property.new_postalregionname\"}),",
                "    #\"Renamed Columns1\" = Table.RenameColumns(#\"Expanded dim_property\",{{\"dim_property.new_postalregionname\", \"region_name\"}}),",
                "    #\"Merged Queries1\" = Table.NestedJoin(#\"Renamed Columns1\", {\"parentcontactid\"}, merged_primary_contact, {\"contactid\"}, \"merged_primary_contact\", JoinKind.LeftOuter),",
                "    #\"Expanded merged_primary_contact\" = Table.ExpandTableColumn(#\"Merged Queries1\", \"merged_primary_contact\", {\"fullname\", \"new_dateofbirth\", \"zav_ethnicity\", \"zav_gender\"}, {\"fullname\", \"new_dateofbirth\", \"zav_ethnicity\", \"zav_gender\"}),",
                "    #\"Replaced Value\" = Table.ReplaceValue(#\"Expanded merged_primary_contact\",null,\"0\",Replacer.ReplaceValue,{\"zav_ethnicity\"}),",
                "    #\"Replaced Value1\" = Table.ReplaceValue(#\"Replaced Value\",null,100000001,Replacer.ReplaceValue,{\"zav_gender\"})",
                "in",
                "    #\"Replaced Value1\""
              ],
              "type": "m"
            }
          }
        ]
      },
