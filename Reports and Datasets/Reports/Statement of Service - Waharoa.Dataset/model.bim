            "name": "TenantableDaysInFY",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "expression": "PropertyOwnershipDaysByFY[PropertyOwnershipDaysInFY] - PropertyOwnershipDaysByFY[NumberOfVoidDays]",
            "formatString": "0",
            "isDataTypeInferred": true,
            "isHidden": true,
            "lineageTag": "da0d7f68-397e-4032-9892-cc4b0b280329",
