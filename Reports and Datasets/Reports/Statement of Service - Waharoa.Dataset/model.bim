            "name": "dim_subprogram-7a345b4d-81ba-44ca-b9df-ce8a500788bf",
            "mode": "import",
            "queryGroup": "dimensions",
            "source": {
              "expression": [
                "let",
                "    Source = Sql.Database(\"synapseausprod-ondemand.sql.azuresynapse.net\", \"ODS\", [Query=\"WITH RecentSubprograms AS (#(lf)    SELECT#(lf)        zav_subprogramid,#(lf)        zav_name,#(lf)        zav_program,#(lf)        SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (PARTITION BY zav_subprogramid ORDER BY SinkModifiedOn DESC) AS rn#(lf)    FROM#(lf)        [Zavanti].[vw_zav_subprogram]#(lf))#(lf)SELECT#(lf)    zav_subprogramid,#(lf)    zav_name,#(lf)    zav_program#(lf)FROM#(lf)    RecentSubprograms#(lf)WHERE#(lf)    rn = 1\"]),",
                "    #\"Merged Queries\" = Table.NestedJoin(Source, {\"zav_program\"}, merged_dim_program, {\"zav_programid\"}, \"dim_program\", JoinKind.LeftOuter),",
                "    #\"Expanded dim_program\" = Table.ExpandTableColumn(#\"Merged Queries\", \"dim_program\", {\"zav_name\"}, {\"zav_name.1\"}),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Expanded dim_program\",{{\"zav_name.1\", \"program_name\"}, {\"zav_name\", \"subprogram_name\"}}),",
                "    #\"Reordered Columns\" = Table.ReorderColumns(#\"Renamed Columns\",{\"program_name\", \"subprogram_name\", \"zav_subprogramid\", \"zav_program\"}),",
                "    #\"Removed Columns\" = Table.RemoveColumns(#\"Reordered Columns\",{\"zav_program\"}),",
                "    #\"Added Conditional Column\" = Table.AddColumn(#\"Removed Columns\", \"commercial_yn\", each if Text.Contains([program_name], \"Commercial\") then 1 else 0),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Added Conditional Column\",{{\"commercial_yn\", Int64.Type}}),",
                "    #\"Replaced Errors\" = Table.ReplaceErrorValues(#\"Changed Type\", {{\"commercial_yn\", 0}})",
                "in",
                "    #\"Replaced Errors\""
              ],
              "type": "m"
            }
          }
        ]
