        ],
        "lineageTag": "93785878-4e2b-4067-9dd1-b4c51db1a0d0",
        "partitions": [
          {
            "name": "dim_date-8887994e-b180-4cd7-9560-a277226df5e5",
            "mode": "import",
            "queryGroup": "dimensions",
            "source": {
              "expression": [
                "let",
                "    Source = Sql.Database(\"sql-dev-aue-svc-datawarehouse-01.database.windows.net\", \"sqldb-dev-datawarehouse-01\", [Query=\"SELECT * FROM edw.dim_date WHERE dim_date_key <> 0#(lf)AND calendar_date > DATEADD(year, -90, GETDATE()) AND calendar_date < DATEADD(year, 9, GETDATE())\"]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(",
                "    Source,",
                "        {",
                "            {\"financial_year_num\", Int64.Type},",
                "            {\"calendar_date\", type date}",
                "        }",
                "    ),",
                "",
                "    // Reference the parameter \"Reporting Months Ago\"",
                "    ReportingPeriod = #\"Reporting Months Ago\",",
                "",
                "    // Get the current date and time, and then extract just the date",
                "    // DateTime.LocalNow() returns the current date and time, DateTime.Date() extracts just the date part",
                "    Today = DateTime.LocalNow(),",
                "    TodayDate = DateTime.Date(Today),",
                "    ",
                "    // Calculate the target month and year based on the current date and the ReportingPeriod parameter",
                "    TargetDate = Date.AddMonths(TodayDate, -ReportingPeriod),",
                "    ",
                "    // Create a list of 12 months starting from TargetDate and going 12 months back",
                "    // List.Transform() applies a function to each item in the original list ({0..12} in this case)",
                "    TwelveMonthsList = List.Transform({0..12}, each Date.ToText(Date.AddMonths(TargetDate, -_), \"yyyy-MM\")),",
                "    ",
                "    // Add a new dynamic calculated column for Reporting Month",
                "    // This column will label each month relative to the Reporting Month",
                "    #\"Added Reporting Month\" = Table.AddColumn(#\"Changed Type\", \"Reporting Month\", each ",
                "        let",
                "            // Extract the calendar_date from the current row",
                "            CurrentDate = [calendar_date],",
                "            ",
                "            // Convert the calendar_date to a string in \"yyyy-MM\" format for easier comparison",
                "            CurrentDateStr = Date.ToText(CurrentDate, \"yyyy-MM\"),",
                "            ",
                "            // Find the position of the current month in the TwelveMonthsList",
                "            // If the month is not found, List.PositionOf() returns -1",
                "            MonthOffset = List.PositionOf(TwelveMonthsList, CurrentDateStr)",
                "        in",
                "            // Label the month based on its position in the TwelveMonthsList",
                "            if MonthOffset = 0 then \"Reporting Month\"",
                "            else if MonthOffset = 1 then \"1 Month Prior to Reporting Month\"",
                "            else if MonthOffset > 1 then Text.From(MonthOffset) & \" Months Prior to Reporting Month\"",
                "            else \"\"",
                "    )",
                "in",
                "    #\"Added Reporting Month\""
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "_Measures",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          }
        ],
        "lineageTag": "ed0c1696-2b27-484e-aa11-546df4b7b894",
        "measures": [
          {
            "name": "IsActiveDuringSelectedFY",
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "VAR SelectedFinancialYearStart = CALCULATE(MIN('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))",
              "VAR SelectedFinancialYearEnd = CALCULATE(MAX('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))",
              "",
              "RETURN",
              "IF (",
              "    NOT ISBLANK(SELECTEDVALUE(fact_tenancy[zav_tenancystartdate])) &&",
              "    CALCULATE (",
              "        COUNTROWS (",
              "            FILTER (",
              "                fact_tenancy,",
              "                SELECTEDVALUE(fact_tenancy[zav_tenancystartdate]) <= SelectedFinancialYearEnd &&",
              "                (ISBLANK(SELECTEDVALUE(fact_tenancy[zav_vacateddate])) || SELECTEDVALUE(fact_tenancy[zav_vacateddate]) > SelectedFinancialYearStart)",
              "            )",
              "        )",
              "    ) > 0,",
              "    1,",
              "    0",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "50a5ed40-8ef8-4fbe-817a-b4a7667d018c"
          },
          {
            "name": "Average Tenancy Length (Days)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "VAR SelectedFinancialYearStart = CALCULATE(MIN('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))",
              "VAR SelectedFinancialYearEnd = CALCULATE(MAX('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))",
              "",
              "RETURN",
              "CALCULATE (",
              "    AVERAGE (fact_tenancy[Tenancy Length (Days)]),",
              "    FILTER (",
              "        ALL (dim_date),",
              "        'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num])",
              "    ),",
              "    FILTER (",
              "        fact_tenancy,",
              "        NOT ISBLANK(fact_tenancy[zav_tenancystartdate]) &&",
              "        fact_tenancy[zav_tenancystartdate] <= SelectedFinancialYearEnd &&",
              "        (ISBLANK(fact_tenancy[zav_vacateddate]) || fact_tenancy[zav_vacateddate] > SelectedFinancialYearStart)",
              "    )",
              ")",
              ""
            ],
            "lineageTag": "7f4817e6-88aa-460d-8306-ec4bbc84a8d1"
          },
          {
            "name": "Average Tenancy Length (All)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ],
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "//CALCULATE(AVERAGE(fact_tenancy[Tenancy Length (Days)]),ALL(dim_date), SELECTEDVALUE(dim_date[financial_year_num]) >= dim_date[financial_year_num]) --old measure that didn't account for the selected FY i.e. not include tenancy lengths after the end of the FY.",
              "CALCULATE(AVERAGE(TenancyDaysByFY[tenancy_active_days_from_actual_start_to_end_in_fy]),ALL(dim_date),SELECTEDVALUE(dim_date[financial_year_num]) >= dim_date[financial_year_num])"
            ],
            "formatString": "0",
            "lineageTag": "4d0da421-24d6-4090-acf1-b79403dae271"
          },
          {
            "name": "Average Tenancy Length for Tenancies Ended in Selected FY (Days)",
            "annotations": [
