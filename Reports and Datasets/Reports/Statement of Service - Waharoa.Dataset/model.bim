            "name": "work_voids_dates",
            "mode": "import",
            "queryGroup": "work",
            "source": {
              "expression": [
                "let",
                "    Source = work_voids_vacated_properties_inactive,",
                "    #\"Removed Other Columns\" = Table.SelectColumns(Source,{\"origin\", \"zav_property\", \"void_start_date\", \"void_end_date\"}),",
                "    #\"Appended Query\" = Table.Combine({#\"Removed Other Columns\", work_voids_currently_active, work_voids_newly_acquired_properties}),",
                "    #\"Removed Other Columns1\" = Table.SelectColumns(#\"Appended Query\",{\"origin\", \"zav_property\", \"void_start_date\", \"void_end_date\"}),",
                "    #\"Merged Queries\" = Table.NestedJoin(#\"Removed Other Columns1\", {\"zav_property\"}, dim_property, {\"zav_propertyid\"}, \"dim_property\", JoinKind.LeftOuter),",
                "    #\"Expanded dim_property\" = Table.ExpandTableColumn(#\"Merged Queries\", \"dim_property\", {\"zav_fulladdress\", \"zav_confirmeddisposaldate\", \"earliest_tenancy_start_date\"}, {\"zav_fulladdress\", \"zav_confirmeddisposaldate\", \"earliest_tenancy_start_date\"}),",
                "    #\"Added Conditional Column\" = Table.AddColumn(#\"Expanded dim_property\", \"void_end_date_true\", each if [zav_confirmeddisposaldate] = null then [void_end_date] else if [zav_confirmeddisposaldate] < [void_end_date] then [zav_confirmeddisposaldate] else [void_end_date]),",
                "    #\"Added Conditional Column1\" = Table.AddColumn(#\"Added Conditional Column\", \"void_started_before_first_tenancy\", each if [earliest_tenancy_start_date] = null then 0 else if [void_start_date] < [earliest_tenancy_start_date] then 1 else 0),",
                "    #\"Added Conditional Column2\" = Table.AddColumn(#\"Added Conditional Column1\", \"void_ended_after_first_tenancy\", each if [earliest_tenancy_start_date] = null then 0 else if [void_end_date] > [earliest_tenancy_start_date] then 1 else 0),",
                "    #\"Filtered Rows\" = Table.SelectRows(#\"Added Conditional Column2\", each ([zav_fulladdress] = \"1/8A Hillside Road, Papatoetoe, Auckland 2025\")),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Filtered Rows\",{{\"void_start_date\", Int64.Type}, {\"void_end_date_true\", Int64.Type}}),",
                "    #\"Added Custom\" = Table.AddColumn(#\"Changed Type\", \"explosion\", each {[void_start_date]..[void_end_date_true]}),",
                "    #\"Expanded explosion\" = Table.ExpandListColumn(#\"Added Custom\", \"explosion\"),",
                "    #\"Changed Type1\" = Table.TransformColumnTypes(#\"Expanded explosion\",{{\"explosion\", type date}, {\"void_start_date\", type date}, {\"void_end_date_true\", type date}})",
                "in",
                "    #\"Changed Type1\""
              ],
              "type": "m"
            }
          }
        ]
