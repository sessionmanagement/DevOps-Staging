            ],
            "isHidden": true,
            "lineageTag": "f7e8f634-6f6f-4666-a7cb-6c008bf6397e"
          },
          {
            "name": "Prev FY-2 Tenancy Active %",
            "changedProperties": [
              {
                "property": "FormatString"
              }
            ],
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "VAR _year = SELECTEDVALUE(dim_date[financial_year_num])-3",
              "RETURN",
              "CALCULATE(",
              "    [Tenancy Active in FY % (Multiple Properties)],",
              "    ALL(dim_date),",
              "    dim_date[financial_year_num] = _year",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "c1acfa3b-a6d8-4593-bba0-074f5a521abd"
          },
          {
            "name": "Housing Portfolio Count (by Year)",
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "/*",
              "--date variables",
              "VAR SelectedFinancialYearStart = CALCULATE(MIN('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))",
              "VAR SelectedFinancialYearEnd = CALCULATE(MAX('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))",
              "",
              "RETURN",
              "IF(MAX(dim_date[financial_year_num]) > YEAR(TODAY()),BLANK(),",
              "CALCULATE(",
              "    COUNTROWS(fact_property),",
              "    ALL(dim_date),",
              "    dim_property[zav_acquireddate] <= SelectedFinancialYearEnd,",
              "    OR(ISBLANK(dim_property[zav_confirmeddisposaldate]),dim_property[zav_confirmeddisposaldate] > SelectedFinancialYearEnd)",
              "))",
              "*/",
              "DISTINCTCOUNT(PropertyOwnershipDaysByFY[zav_propertyid])"
            ],
            "formatString": "0",
            "lineageTag": "bbf0f0f8-7eab-4a6a-9fdb-273ca0f8816a"
          },
          {
            "name": "Title: Owner (for Register)",
            "displayFolder": "1. Titles",
            "expression": "CONCATENATE(SELECTEDVALUE(dim_property[zav_legalowneridname]) & \" | FY \",SELECTEDVALUE(dim_date[financial_year_num]))",
            "isHidden": true,
            "lineageTag": "ed26c495-e88b-4346-a737-a59ce67e6725"
          },
          {
            "name": "FiltersApplied",
            "displayFolder": "3. Applied Filters",
            "expression": [
              "",
              "VAR __1FinYear = IF(ISFILTERED(dim_date[financial_year_num]), CONCATENATEX(FILTERS(dim_date[financial_year_num]), dim_date[financial_year_num], \", \"), BLANK())",
              "",
              "VAR __2LegalOwnerIDNames = ADDCOLUMNS(",
              "    TOPN(10, FILTER(VALUES(dim_property[zav_legalowneridname]), NOT(ISBLANK(dim_property[zav_legalowneridname]))), dim_property[zav_legalowneridname], ASC),",
              "    \"LegalOwnerIDName_display\", dim_property[zav_legalowneridname]",
              ")",
              "VAR __3LegalOwnerIDNamesCount = IF(ISFILTERED(dim_property[zav_legalowneridname]), COUNTROWS(VALUES(dim_property[zav_legalowneridname])), 0)",
              "VAR __4MoreLegalOwnerIDNames = IF(__3LegalOwnerIDNamesCount > 10, \" and \" & (__3LegalOwnerIDNamesCount - 10) & \" more\", \"\")",
              "",
              "VAR __5ProgramNames = ADDCOLUMNS(",
              "    TOPN(10, FILTER(VALUES(dim_subprogram[program_name]), NOT(ISBLANK(dim_subprogram[program_name]))), dim_subprogram[program_name], ASC),",
              "    \"ProgramName_display\", dim_subprogram[program_name]",
              ")",
              "VAR __6ProgramNamesCount = IF(ISFILTERED(dim_subprogram[program_name]), COUNTROWS(VALUES(dim_subprogram[program_name])), 0)",
              "VAR __7MoreProgramNames = IF(__6ProgramNamesCount > 10, \" and \" & (__6ProgramNamesCount - 10) & \" more\", \"\")",
              "",
              "VAR __8SubprogramNames = ADDCOLUMNS(",
              "    TOPN(10, FILTER(VALUES(dim_subprogram[subprogram_name]), NOT(ISBLANK(dim_subprogram[subprogram_name]))), dim_subprogram[subprogram_name], ASC),",
              "    \"SubprogramName_display\", dim_subprogram[subprogram_name]",
              ")",
              "VAR __9SubprogramNamesCount = IF(ISFILTERED(dim_subprogram[subprogram_name]), COUNTROWS(VALUES(dim_subprogram[subprogram_name])), 0)",
              "VAR __10MoreSubprogramNames = IF(__9SubprogramNamesCount > 10, \" and \" & (__9SubprogramNamesCount - 10) & \" more\", \"\")",
              "",
              "VAR __11FullAddresses = ADDCOLUMNS(",
              "    TOPN(5, FILTER(VALUES(dim_property[zav_fulladdress]), NOT(ISBLANK(dim_property[zav_fulladdress]))), dim_property[zav_fulladdress], ASC),",
              "    \"FullAddress_display\", dim_property[zav_fulladdress]",
              ")",
              "VAR __12FullAddressesCount = IF(ISFILTERED(dim_property[zav_fulladdress]), COUNTROWS(VALUES(dim_property[zav_fulladdress])), 0)",
              "VAR __13MoreFullAddresses = IF(__12FullAddressesCount > 5, \" and \" & (__12FullAddressesCount - 5) & \" more\", \"\")",
              "",
              "VAR __14Gender = ADDCOLUMNS(",
              "    TOPN(10, FILTER(VALUES(dim_gender[zav_gendername]), NOT(ISBLANK(dim_gender[zav_gendername]))), dim_gender[zav_gendername], ASC),",
              "    \"Gender_display\", dim_gender[zav_gendername]",
              ")",
              "VAR __15GenderCount = IF(ISFILTERED(dim_gender[zav_gendername]), COUNTROWS(VALUES(dim_gender[zav_gendername])), 0)",
              "VAR __16MoreGender = IF(__15GenderCount > 4, \" and \" & (__15GenderCount - 4) & \" more\", \"\")",
              "",
              "VAR __17Ethnicity = ADDCOLUMNS(",
              "    TOPN(10, FILTER(VALUES(dim_ethnicity[ethnicity_new]), NOT(ISBLANK(dim_ethnicity[ethnicity_new]))), dim_ethnicity[ethnicity_new], ASC),",
              "    \"Ethnicity_display\", dim_ethnicity[ethnicity_new]",
              ")",
              "VAR __18EthnicityCount = IF(ISFILTERED(dim_ethnicity[ethnicity_new]), COUNTROWS(VALUES(dim_ethnicity[ethnicity_new])), 0)",
              "VAR __19MoreEthnicity = IF(__18EthnicityCount > 10, \" and \" & (__18EthnicityCount - 10) & \" more\", \"\")",
              "",
              "",
              "VAR _FC_1FinYear = IF(ISBLANK(__1FinYear), BLANK(), \"FINANCIAL YEAR CHOSEN: \" & __1FinYear)",
              "VAR _FC_2LegalOwnerIDNames = IF(__3LegalOwnerIDNamesCount > 0, \"-- OWNERS CHOSEN: \" & CONCATENATEX(__2LegalOwnerIDNames, [LegalOwnerIDName_display], \", \"), BLANK())",
              "VAR _FC_3MoreLegalOwnerIDNames = IF(__3LegalOwnerIDNamesCount > 10, \" and \" & (__3LegalOwnerIDNamesCount - 10) & \" more\", \"\")",
              "VAR _FC_4ProgramNames = IF(__6ProgramNamesCount > 0, \"-- PROGRAMS CHOSEN: \" & CONCATENATEX(__5ProgramNames, [ProgramName_display], \", \"), BLANK())",
              "VAR _FC_5MoreProgramNames = IF(__6ProgramNamesCount > 10, \" and \" & (__6ProgramNamesCount - 10) & \" more\", \"\")",
              "",
              "VAR _FC_6SubprogramNames = IF(__9SubprogramNamesCount > 0, \"-- SUBPROGRAMS CHOSEN: \" & CONCATENATEX(__8SubprogramNames, [SubprogramName_display], \", \"), BLANK())",
              "VAR _FC_7MoreSubprogramNames = IF(__9SubprogramNamesCount > 10, \" and \" & (__9SubprogramNamesCount - 10) & \" more\", \"\")",
              "",
              "VAR _FC_8FullAddresses = IF(__12FullAddressesCount > 0, \"-- PROPERTY ADDRESSES CHOSEN: \" & CONCATENATEX(__11FullAddresses, [FullAddress_display], \", \"), BLANK())",
              "VAR _FC_9MoreFullAddresses = IF(__12FullAddressesCount > 5, \" and \" & (__12FullAddressesCount - 5) & \" more\", \"\")",
              "",
              "VAR _FC_14Gender = IF(__15GenderCount > 0, \"-- GENDER CHOSEN: \" & CONCATENATEX(__14Gender, [Gender_display], \", \"), BLANK())",
              "VAR _FC_15MoreGender = IF(__15GenderCount > 4, \" and \" & (__15GenderCount - 4) & \" more\", \"\")",
              "",
              "VAR _FC_17Ethnicity = IF(__18EthnicityCount > 0, \"-- ETHNICITIES CHOSEN: \" & CONCATENATEX(__17Ethnicity, [Ethnicity_display], \", \"), BLANK())",
              "VAR _FC_19MoreEthnicity = IF(__18EthnicityCount > 10, \" and \" & (__18EthnicityCount - 10) & \" more\", \"\")",
              "",
              "",
              "VAR _FirstDate = MIN(dim_date[calendar_date])",
              "VAR _LastDate = MAX(dim_date[calendar_date])",
              "RETURN",
              "\"(\" & FORMAT(_FirstDate, \"dd/MM/YYYY\") & \" - \" & FORMAT(_LastDate, \"dd/MM/YYYY\") & \") \" &",
              "IF(",
              "    ISBLANK(_FC_2LegalOwnerIDNames) && ISBLANK(_FC_4ProgramNames) && ISBLANK(_FC_6SubprogramNames) && ISBLANK(_FC_8FullAddresses) && ISBLANK(_FC_14Gender) && ISBLANK(_FC_17Ethnicity),",
              "    \"\",",
              "    \"and other selected fields: \" & \" \" & _FC_2LegalOwnerIDNames & _FC_3MoreLegalOwnerIDNames & \" \" & _FC_4ProgramNames & _FC_5MoreProgramNames & \" \" & _FC_6SubprogramNames & _FC_7MoreSubprogramNames & \" \" & _FC_8FullAddresses & _FC_9MoreFullAddresses & \" \" & _FC_14Gender & _FC_15MoreGender & \" \" & _FC_17Ethnicity & _FC_19MoreEthnicity",
              ")",
              ""
            ],
            "isHidden": true,
            "lineageTag": "ec2bd5a0-bb55-4fde-bb1d-eb6301709819"
          },
          {
            "name": "Title: Summary Page",
            "displayFolder": "1. Titles",
            "expression": [
              "",
              "CONCATENATE(\"Waharoa Summary | FY \",SELECTEDVALUE(dim_date[financial_year_num]))"
            ],
            "isHidden": true,
            "lineageTag": "28003bcb-368a-437b-a6a3-d5b6540a1d23"
          },
          {
            "name": "Filters Applied (Has No Selected FY)",
            "displayFolder": "3. Applied Filters",
            "expression": "\"Please be aware that data is displayed for the previous 7 financial years \" & [FiltersApplied]",
            "isHidden": true,
            "lineageTag": "e59c3209-16e6-4835-b950-a9ef0c4b2503"
          },
          {
            "name": "Title: Housing Stock Detail",
            "displayFolder": "1. Titles",
            "expression": [
              "",
              "CONCATENATE(\"Housing Stock Detail | FY \",SELECTEDVALUE(dim_date[financial_year_num]))"
            ],
            "isHidden": true,
            "lineageTag": "1c439961-4d33-4a81-99d4-c3516cf5c5a8"
          },
          {
            "name": "Title: Accommodation Utilisation Detail",
            "displayFolder": "1. Titles",
            "expression": [
              "",
              "CONCATENATE(\"Accommodation Utilisation Detail | FY \",SELECTEDVALUE(dim_date[financial_year_num]))"
            ],
            "isHidden": true,
            "lineageTag": "19a19ad1-f21b-475e-a5a3-020b7feca82b"
          },
          {
            "name": "Title: Accommodation Utilisation Analysis",
            "displayFolder": "1. Titles",
            "expression": [
              "",
              "CONCATENATE(\"Accommodation Utilisation Analysis | FY \",SELECTEDVALUE(dim_date[financial_year_num]))"
            ],
            "isHidden": true,
            "lineageTag": "d48f80dc-cecc-4cb5-905a-c5cfc4bd9d5e"
          },
          {
            "name": "Number Tenanted Days in FY (Not Blank)",
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "IF(",
              "    ISBLANK(SELECTEDVALUE(TenancyDaysByFY[TenancyActiveDaysInFY])),",
              "    0,",
              "    SELECTEDVALUE(TenancyDaysByFY[TenancyActiveDaysInFY])",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "4395174a-9dc9-4062-84a9-fa5efd8d9114"
          },
          {
            "name": "Tenancy Active in FY % (Multiple Properties)",
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "/*",
              "IF(",
              "    SELECTEDVALUE(SubtractVoidDays[SubtractVoidDays]) = \"No\",",
              "    IFERROR(",
              "            SUM(TenancyDaysByFY[TenancyActiveDaysInFY]) / SUM(PropertyOwnershipDaysByFY[PropertyOwnershipDaysInFY]),0",
              "            ),",
              "    IFERROR(",
              "            SUM(TenancyDaysByFY[TenancyActiveDaysInFY]) / SUM(PropertyOwnershipDaysByFY[TenantableDaysInFY]),0",
              "            )",
              ")*/",
              "",
              "IFERROR(",
              "        SUM(TenancyDaysByFY[TenancyActiveDaysInFY]) / [Dynamic Property Available Days in FY],0",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "f1dbd75e-c828-447f-a6d9-cf4eee3902f9"
          },
          {
            "name": "Filters Applied (Has Selected FY)",
            "displayFolder": "3. Applied Filters",
            "expression": "\"Please be aware all numbers are based on the currently selected financial year \" & [FiltersApplied]",
            "isHidden": true,
            "lineageTag": "b8364ac7-2feb-4c0c-832c-543a78894fc6"
          },
          {
            "name": "Number of properties owned in FY",
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "CALCULATE(",
              "    [Housing Portfolio Count (by Year)],",
              "    dim_property[zav_propertyownership] = \"Owned\"",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "ee41d9b9-d346-4a59-b034-3bb8c7aeb525"
          },
          {
            "name": "Number of properties leased in FY",
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "CALCULATE(",
              "    [Housing Portfolio Count (by Year)],",
              "    dim_property[zav_propertyownership] = \"Leased\"",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "cb010af0-b220-4d78-bc6c-0d62c9843df7"
          },
          {
            "name": "Basic dim_property count",
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "IF(",
              "    ISBLANK(DISTINCTCOUNT(dim_property[zav_propertyid])),",
              "    0,",
              "    DISTINCTCOUNT(dim_property[zav_propertyid])",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "24afcac6-abae-4a42-9444-b19073b017a7"
          },
          {
            "name": "Format: basic dim_property count (0 is bad, greater than 0 is ok)",
            "displayFolder": "5. Formatting",
            "expression": [
              "",
              "IF(",
              "    [Basic dim_property count] = 0, \"red\", \"black\"",
              ")"
            ],
            "isHidden": true,
            "lineageTag": "843f98b5-132c-4c66-8941-f15497999fb7"
          },
          {
            "name": "Format: basic dim_property count (0 is ok, greater than 0 is bad)",
            "displayFolder": "5. Formatting",
            "expression": [
              "",
              "IF(",
              "    [Basic dim_property count] = 0, \"black\", \"red\"",
              ")"
            ],
            "isHidden": true,
            "lineageTag": "b02cd0d0-681d-45ce-ad84-ee96a8233e74"
          },
          {
            "name": "Tenancy Balance",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-NZ\"}"
              }
            ],
            "displayFolder": "4. Rental/Transactions",
            "expression": [
              "",
              "    SUM(fact_tenancy_transaction_details[zav_amount])"
            ],
            "formatString": "\\$#,0.###############;-\\$#,0.###############;\\$#,0.###############",
            "lineageTag": "4b70a811-985a-4395-ae6a-0e3db465dad3"
          },
          {
            "name": "Amount (Same Period Last Year)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-NZ\"}"
              }
            ],
            "displayFolder": "4. Rental/Transactions",
            "expression": [
              "",
              "CALCULATE(",
              "    SUM(",
              "        fact_tenancy_transaction_details[zav_amount]",
              "    )",
              "    ,SAMEPERIODLASTYEAR(dim_date[calendar_date])",
              ")"
            ],
            "formatString": "\\$#,0.###############;-\\$#,0.###############;\\$#,0.###############",
            "lineageTag": "7ff86285-6183-467f-b2ba-a932c78b4d82"
          },
          {
            "name": "Difference in Amount (Selected Period v Same Time Last Year)",
            "displayFolder": "4. Rental/Transactions",
            "expression": [
              "",
              "IFERROR(",
              "    CALCULATE(",
              "        ([Amount (Same Period Last Year)] - SUM(fact_tenancy_transaction_details[zav_amount])) / [Amount (Same Period Last Year)]",
              "        *-1",
              "    ),",
              "    0",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "dcc1baf5-a32b-4b75-8303-4a29e388f94c"
          },
          {
            "name": "Title: Tenancy Name",
            "displayFolder": "6. Titles/misc",
            "expression": [
              "",
              "SELECTEDVALUE(fact_tenancy_transaction_details[zav_tenancyname])"
            ],
            "isHidden": true,
            "lineageTag": "3d5adc9a-bf58-49e6-9cbe-ba2825729840"
          },
          {
            "name": "Amount (Last Month)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-NZ\"}"
              }
            ],
            "displayFolder": "4. Rental/Transactions",
            "expression": [
              "",
              "CALCULATE(",
              "    SUM(",
              "        fact_tenancy_transaction_details[zav_amount]",
              "    )",
              "    ,PREVIOUSMONTH(dim_date[calendar_date])",
              ")"
            ],
            "formatString": "\\$#,0.###############;-\\$#,0.###############;\\$#,0.###############",
            "lineageTag": "89750630-5fa6-4a85-92f7-ef9f4cc7e1d1"
          },
          {
            "name": "Difference in Amount (Selected Month v Prev Month)",
            "displayFolder": "4. Rental/Transactions",
            "expression": [
              "",
              "IFERROR(",
              "    CALCULATE(",
              "        ([Amount (Last Month)] - SUM(fact_tenancy_transaction_details[zav_amount])) / [Amount (Last Month)]",
              "        *-1",
              "    ),",
              "    0",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "e0c6ba27-c8d3-46ed-a13b-47fe7f9ff050"
          },
          {
            "name": "Dynamic Property Available Days in FY",
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "IF(",
              "    SELECTEDVALUE(SubtractVoidDays[SubtractVoidDays]) = \"No\",",
              "    SUM(",
              "        PropertyOwnershipDaysByFY[PropertyOwnershipDaysInFY])+1,",
              "    SUM(PropertyOwnershipDaysByFY[TenantableDaysInFY])+1",
              ")"
            ],
            "formatString": "#,0",
            "lineageTag": "f85f3320-f0b3-4fdf-bc0f-e1827ed08f1d"
          },
          {
            "name": "RefreshedAt_forDisplay",
            "displayFolder": "6. Titles/misc",
            "expression": "\"Data last refreshed: \" & FORMAT(LASTDATE(LastRefreshed[Date Last Refreshed]), \"dd/MM/YYYY - hh:mm AM/PM\")",
            "lineageTag": "d1317d56-f165-46fe-93ef-318b8a1b91b1"
          },
          {
            "name": "Tenancy Length",
            "displayFolder": "2. Measures",
            "lineageTag": "1ed4f938-4bb0-40e5-9e82-b41dfd91b58c"
          },
          {
            "name": "Title: Tenancy Demographics",
            "displayFolder": "1. Titles",
            "expression": [
              "",
              "CONCATENATE(\"Tenancy Demographics | FY \",SELECTEDVALUE(dim_date[financial_year_num]))"
            ],
            "isHidden": true,
            "lineageTag": "3860a7f4-d72c-4a8a-9bd7-925a11a73534"
          },
          {
            "name": "Active tenancies at start of Period",
            "displayFolder": "4. Rental/Transactions",
            "expression": [
              "",
              "VAR _PeriodStartDate = MIN(dim_date[calendar_date])",
              "RETURN",
              "CALCULATE(",
              "    DISTINCTCOUNT(TenancyDaysByFY[opportunityid]),",
              "    TenancyDaysByFY[zav_tenancystartdate] <= _PeriodStartDate,",
              "    TenancyDaysByFY[zav_vacateddate] >= _PeriodStartDate || ISBLANK(TenancyDaysByFY[zav_vacateddate])",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "65da5ec0-0faf-47e4-8f10-4315253ccf07"
          },
          {
            "name": "Active tenancies at end of Period",
            "displayFolder": "4. Rental/Transactions",
            "expression": [
              "",
              "VAR _PeriodEndDate = MAX(dim_date[calendar_date])",
              "RETURN",
              "CALCULATE(",
              "    DISTINCTCOUNT(TenancyDaysByFY[opportunityid]),",
              "    TenancyDaysByFY[zav_tenancystartdate] <= _PeriodEndDate,",
              "    TenancyDaysByFY[zav_vacateddate] >= _PeriodEndDate || ISBLANK(TenancyDaysByFY[zav_vacateddate])",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "f3150db3-3695-4e3c-805d-2b2d4b06c9b0"
          },
          {
            "name": "Average number of tenancies in Period",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "([Active tenancies at start of Period] + [Active tenancies at end of Period]) / 2"
            ],
            "lineageTag": "247fb9ce-ffda-4d49-adff-715d3f8a41ec"
          },
          {
            "name": "Tenancy turnover rate (FY)",
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "IF(",
              "    ISBLANK(",
              "        IFERROR(",
              "    ([Number of tenancies ended in FY] / [Average number of tenancies in Period]),",
              "    BLANK())),",
              "    0,",
              "        IFERROR(",
              "    ([Number of tenancies ended in FY] / [Average number of tenancies in Period]),",
              "    0",
              "        )",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "2bb09ffb-661c-47e3-b70e-42facedfcf63"
          },
          {
            "name": "Title: Discharged Tenancies",
            "displayFolder": "6. Titles/misc",
            "expression": [
              "",
              "CONCATENATE(\"Discharged Tenancies | FY \",SELECTEDVALUE(dim_date[financial_year_num]))"
            ],
            "isHidden": true,
            "lineageTag": "b560fcc3-09fd-4552-abd9-e3f2d6789217"
          },
          {
            "name": "Average Tenancy Length for Tenancies Ended in Selected Month (Days)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "VAR SelectedMonthStart = CALCULATE(MIN('dim_date'[calendar_date]), ALLSELECTED('dim_date'),SELECTEDVALUE(dim_date[calendar_last_day_of_month_date]) = dim_date[calendar_last_day_of_month_date])",
              "VAR SelectedMonthEnd = CALCULATE(MAX('dim_date'[calendar_date]), ALLSELECTED('dim_date'),SELECTEDVALUE(dim_date[calendar_last_day_of_month_date]) = dim_date[calendar_last_day_of_month_date])",
              "",
              "RETURN",
              "CALCULATE (",
              "    AVERAGE (fact_tenancy[Tenancy Length (Days)]),",
              "    USERELATIONSHIP(dim_date[calendar_date],fact_tenancy[zav_vacateddate]),",
              "    ALL(dim_date),",
              "    fact_tenancy[zav_vacateddate] >= SelectedMonthStart,",
              "    fact_tenancy[zav_vacateddate] <= SelectedMonthEnd",
              ")"
            ],
            "lineageTag": "aa650264-f76f-4334-a394-fce943508a77"
          },
          {
            "name": "Tenancy Balance (Total)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-NZ\"}"
              }
            ],
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "    CALCULATE(",
              "        SUM(fact_tenancy_transaction_details[zav_amount]),",
              "        ALL(dim_date)",
              "        //,SELECTEDVALUE(fact_tenancy_transaction_details[zav_tenancy]) = fact_tenancy_transaction_details[zav_tenancy]",
              "        //,SELECTEDVALUE(fact_tenancy[tenancymanagerid]) = fact_tenancy_transaction_details[tenancymanagerid]",
              "    )"
            ],
            "formatString": "\\$#,0.###############;-\\$#,0.###############;\\$#,0.###############",
            "lineageTag": "5cb4f5fb-d5fa-484f-9630-6037fef7be3c"
          },
          {
            "name": "Number of tenancies started in FY",
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "DISTINCTCOUNT(fact_tenancy[opportunityid])"
            ],
            "formatString": "0",
            "lineageTag": "4fe05c24-09b6-459d-b07e-32f4edd8c9a9"
          },
          {
            "name": "Number of tenancies ended in FY",
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT(fact_tenancy[opportunityid]),",
              "    USERELATIONSHIP(dim_date[calendar_date],fact_tenancy[zav_vacateddate])",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "239af2ec-860b-4280-aa85-f01723a56ac0"
          },
          {
            "name": "Current Housing Portfolio Size",
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "VAR _year = MAX(dim_date[financial_year_num])",
              "RETURN",
              "CALCULATE([Housing Portfolio Count (by Year)],dim_date[financial_year_num] = _year)"
            ],
            "formatString": "0",
            "lineageTag": "8c0ab1a9-332f-4a63-a63d-6110bb3038cd"
          },
          {
            "name": "BlankValue",
            "displayFolder": "2. Measures",
            "expression": [
              "",
              "BLANK()"
            ],
            "formatString": "0",
            "lineageTag": "d3ede75d-dd5e-4954-a42e-3e2081b20c9d"
          },
          {
            "name": "Balance formatting (red and green)",
            "displayFolder": "5. Formatting",
            "expression": [
              "",
              "IF([Tenancy Balance (Total)] < 0, \"red\", \"green\")"
            ],
            "lineageTag": "f520d55f-9544-47a2-8c81-c4d60d0b66a4"
          },
          {
            "name": "Balance formatting (red and black)",
            "displayFolder": "5. Formatting",
            "expression": [
              "",
              "IF([Tenancy Balance (Total)] < 0, \"red\", \"black\")"
            ],
            "lineageTag": "c83bb9ed-b7f9-4dcb-b791-133d30114123"
          },
          {
            "name": "Balance formatting (chosen period; red and black)",
            "displayFolder": "5. Formatting",
            "expression": [
              "",
              "IF([Tenancy Balance] < 0, \"red\", \"black\")"
            ],
            "lineageTag": "044790ea-8c2d-46a5-999f-042c4db8b926"
          }
        ],
