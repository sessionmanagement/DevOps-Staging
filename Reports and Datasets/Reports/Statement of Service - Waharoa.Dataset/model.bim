                "let",
                "    Source = Table.NestedJoin(pre_work_number_household_members_dates_for_prev_revision, {\"composite_hh_revision_minus_one\"}, pre_work_number_household_members_dates, {\"hhid_revision_concat\"}, \"work_number_household_members_dates\", JoinKind.LeftOuter),",
                "    #\"Expanded work_number_household_members_dates\" = Table.ExpandTableColumn(Source, \"work_number_household_members_dates\", {\"zav_dateofamendment\"}, {\"work_number_household_members_dates.zav_dateofamendment\"}),",
