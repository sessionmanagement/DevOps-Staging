            "type": "calculated"
          }
        ],
        "lineageTag": "18edf57d-8082-43c0-89a6-8b38847440d2",
        "partitions": [
          {
            "name": "PropertyOwnershipDaysByFY-d9665092-15da-45ea-bd6a-2dc77e2421e8",
            "mode": "import",
            "source": {
              "expression": [
                "",
                "ADDCOLUMNS (",
                "    SUMMARIZECOLUMNS (",
                "        work_property_dates[zav_propertyid],",
                "        work_property_dates[statuscode],",
                "        work_property_dates[zav_acquireddate],",
                "        work_property_dates[zav_confirmeddisposaldate],",
                "        work_property_dates[disposaldateortoday],",
                "        work_property_dates[FinancialYear],",
                "        work_property_dates[LastDayOfFY],",
                "        \"BeginPropertyOwnerShipDateForFY\", MIN(work_property_dates[explosion])",
                "    ),",
                "    \"NumberOfVoidDays\",",
                "        CALCULATE(",
                "            SUM(PropertyVoidDaysByFY[NumberOfVoidDays]),",
                "            FILTER(",
                "                ALL(PropertyVoidDaysByFY),",
                "                PropertyVoidDaysByFY[zav_property] = EARLIER(work_property_dates[zav_propertyid])",
                "                    && PropertyVoidDaysByFY[financial_year_num] = EARLIER(work_property_dates[FinancialYear])",
                "            )",
                "        )",
                ")",
                ""
              ],
              "type": "calculated"
            }
          }
        ]
      },
