DEFINE
	VAR __DS0FilterTable = 
		TREATAS({"1"}, 'dim_people'[isPrimaryJob])

	VAR __DS0FilterTable2 = 
		TREATAS({"1"}, 'dim_people'[is_active])

	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			ROLLUPADDISSUBTOTAL(
				ROLLUPGROUP(
					'fact_pay_slips'[pay_period_start_date],
					'fact_pay_slips'[employee_id],
					'fact_pay_slips'[Kaimahi],
					'dim_people'[isPrimaryJob],
					'dim_people'[is_active]
				), "IsGrandTotalRowTotal"
			),
			__DS0FilterTable,
			__DS0FilterTable2,
			"SumHoursWorked", CALCULATE(SUM('fact_pay_slips'[HoursWorked]))
		)

	VAR __DS0PrimaryWindowed = 
		TOPN(
			502,
			__DS0Core,
			[IsGrandTotalRowTotal],
			0,
			'dim_people'[is_active],
			1,
			'fact_pay_slips'[pay_period_start_date],
			1,
			'fact_pay_slips'[employee_id],
			1,
			'fact_pay_slips'[Kaimahi],
			1,
			'dim_people'[isPrimaryJob],
			1
		)

EVALUATE
	__DS0PrimaryWindowed

ORDER BY
	[IsGrandTotalRowTotal] DESC,
	'dim_people'[is_active],
	'fact_pay_slips'[pay_period_start_date],
	'fact_pay_slips'[employee_id],
	'fact_pay_slips'[Kaimahi],
	'dim_people'[isPrimaryJob]