  "background": "#FFFFFF",
  "foreground": "#000000",
  "tableAccent": "#48b5e5",
  "visualStyles": {
    "*": {
      "*": {
        "*": [
          {
            "responsive": true,
            "wordWrap": true,
            "fontFamily": "Calibri"
          }
        ],
        "labels": [
          {
            "show": false,
            "labelOrientation": "vertical"
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": true
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": true
          }
        ]
      }
    },
    "scatterChart": {
      "*": {
        "fillPoint": [
          {
            "show": true
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "legend": [
          {
            "legendMarkerRendering": "lineAndMarker"
          }
        ],
        "lineStyles": [
          {
            "showMarker": false,
            "showSeries": true
          }
        ],
        "labels": [
          {
            "show": false
          }
        ],
        "dataLabels": [
          {
            "show": false
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "labels": [
          {
            "show": true
          }
        ],
        "dataLabels": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "axisType": "Categorical"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "responsive": false,
        "selection": [
          {
            "singleSelect": false,
            "selectAllCheckboxEnabled": false
          }
        ],
        "header": [
          {
            "show": true
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "*": [
          {
            "fontSize": 11,
            "fontColor": "#203461"
          }
        ],
        "grid": [
          {
            "outlineColor": {
              "solid": {
                "color": "#0D8ACB"
              }
            }
          }
        ],
        "subTotals": [
          {
            "columnSubtotals": false
          }
        ],
        "columnHeaders": [
          {
            "wordWrap": true,
            "backColor": "#ffffff",
            "gridVerticalWeight": 3,
            "stepped": true,
            "steppedLayoutIndentation": 25,
            "urlIcon": true
          }
        ],
        "values": [
          {
            "fontColorPrimary": "#203461",
            "backColorPrimary": "#ffffff",
            "fontColorSecondary": "#203461",
            "backColorSecondary": "#f3fafe",
            "wordWrap": true,
            "urlIcon": true
          }
        ],
        "rowHeaders": [
          {
            "wordWrap": true,
            "backColor": "#ffffff",
            "gridVerticalWeight": 3,
            "stepped": true,
            "steppedLayoutIndentation": 25,
            "urlIcon": true
          }
        ]
      }
    },
    "kpi": {
      "*": {
        "status": [
          {
            "direction": "Negative",
            "goodColor": {
              "solid": {
                "color": "#73BCB2"
              }
            },
            "badColor": {
              "solid": {
                "color": "#EB5D68"
              }
            },
            "neutralColor": {
              "solid": {
                "color": "#FFE264"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 11
          }
        ],
        "categoryLabels": [
          {
            "fontSize": 11
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "labels": [
          {
            "fontSize": 11
          }
        ],
        "categoryLabels": [
          {
            "show": true
          }
        ],
        "categoryAxis": [
          {
            "axisType": "Categorical"
          }
        ]
      }
    },
    "areaChart": {
      "*": {
        "labels": [
          {
            "show": false
          }
        ],
        "dataLabels": [
          {
            "show": false
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "legend": [
          {
            "show": true
          }
        ],
        "labels": [
          {
            "labelStyle": "Percent of total"
          }
        ]
      }
    },
    "pieChart": {
      "*": {
        "legend": [
          {
            "show": true
          }
        ],
        "labels": [
          {
            "labelStyle": "Category, percent of total"
          }
        ]
      }
    }
  }
}