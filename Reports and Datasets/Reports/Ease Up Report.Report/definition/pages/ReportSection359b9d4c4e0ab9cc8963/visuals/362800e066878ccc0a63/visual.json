      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "As of Aug 2022 the MoH definition of a person being ‘seen’ is if they have attended a ‘session’."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "A ‘session’ is a therapeutic or support intervention, of at least 10 minutes duration, provided to one or more people according to the service model. It can refer to a contact, an appointment or an encounter in different service settings. The mode of delivery is not important and can be face-to-face, by telephone, by videoconference etc. etc. It does not"
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "include administrative activities, discussions with colleagues, referrals to other services, writing clinical/case notes etc."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "RB Activities",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Email and SMS conversations can be counted as sessions and should be bundled up into the one activity."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The following RB activities are excluded from the count:"
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "·",
                    "textStyle": {
                      "fontFamily": "Symbol"
                    }
                  },
                  {
                    "value": "        ",
                    "textStyle": {
                      "fontFamily": "Times New Roman",
                      "fontSize": "7pt"
                    }
                  },
                  {
                    "value": "Anything under 10 mins"
                  }
                ],
                "indent": 1
              },
              {
                "textRuns": [
                  {
                    "value": "·",
                    "textStyle": {
                      "fontFamily": "Symbol"
                    }
                  },
                  {
                    "value": "        ",
                    "textStyle": {
                      "fontFamily": "Times New Roman",
                      "fontSize": "7pt"
                    }
                  },
                  {
                    "value": "DNA"
                  }
                ],
                "indent": 1
              },
              {
                "textRuns": [
                  {
                    "value": "·",
                    "textStyle": {
                      "fontFamily": "Symbol"
                    }
                  },
                  {
                    "value": "        ",
                    "textStyle": {
                      "fontFamily": "Times New Roman",
                      "fontSize": "7pt"
                    }
                  },
                  {
                    "value": "Scheduling"
                  }
                ],
                "indent": 1
              },
              {
                "textRuns": [
                  {
                    "value": "·",
                    "textStyle": {
                      "fontFamily": "Symbol"
                    }
                  },
                  {
                    "value": "        ",
                    "textStyle": {
                      "fontFamily": "Times New Roman",
                      "fontSize": "7pt"
                    }
                  },
                  {
                    "value": "Attempted contact"
                  }
                ],
                "indent": 1
              },
              {
                "textRuns": [
                  {
                    "value": "·",
                    "textStyle": {
                      "fontFamily": "Symbol"
                    }
                  },
                  {
                    "value": "        ",
                    "textStyle": {
                      "fontFamily": "Times New Roman",
                      "fontSize": "7pt"
                    }
                  },
                  {
                    "value": "Liaison with a professional"
                  }
                ],
                "indent": 1
              },
              {
                "textRuns": [
                  {
                    "value": "·",
                    "textStyle": {
                      "fontFamily": "Symbol"
                    }
                  },
