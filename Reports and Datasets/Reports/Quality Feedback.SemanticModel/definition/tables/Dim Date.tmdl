	partition 'Dim Date' = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database),
				    edw_dim_date = Source{[Schema="edw",Item="vw_dim_date"]}[Data],
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            capitaliseWords = Text.Proper(replaceUnderscore),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY")
				        in
				            capitaliseKEY,
				    #"Transformed Column Names" = Table.TransformColumnNames(edw_dim_date, each ApplyNamingConventions(_)),
				    #"Removed Columns" = Table.RemoveColumns(#"Transformed Column Names",{"Dwhsourcesystem", "Dwhcreatedat", "Dwhbatchid"}),
				    #"Add Offset column" = Table.AddColumn(#"Removed Columns", "Offset Date", each if[Calendar Date] <= Date.From(DateTime.LocalNow()) then 1 else 0)
				in
				    #"Add Offset column"

	annotation PBI_ResultType = Exception

