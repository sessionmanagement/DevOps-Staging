	/// Retrieves the applied filters for the P&L Summary based on various dimensions.
	/// 
	measure 'P&L Summary OTHER filters applied' = ```
			
			VAR __1FinYear =
			    IF (
			        ISFILTERED ( 'Dim Date'[Financial Year Desc] ),
			        CONCATENATEX (
			            FILTERS ( 'Dim Date'[Financial Year Desc] ),
			            'Dim Date'[Financial Year Desc],
			            ", "
			        ),
			        BLANK ()
			    )
			VAR __2YearMonth =
			    IF (
			        ISFILTERED ( 'Dim Date'[Calendar Year Month] ),
			        CONCATENATEX (
			            FILTERS ( 'Dim Date'[Calendar Year Month] ),
			            'Dim Date'[Calendar Year Month],
			            ", "
			        ),
			        BLANK ()
			    )
			VAR __3Company =
			    IF (
			        ISFILTERED ( 'Dim Company'[Company Name] ),
			        CONCATENATEX (
			            FILTERS ( 'Dim Company'[Company Name] ),
			            'Dim Company'[Company Name],
			            ", "
			        ),
			        BLANK ()
			    )
			VAR __4BusUnit =
			    IF (
			        ISFILTERED ( 'Dim Department'[Department Code] ),
			        CONCATENATEX (
			            FILTERS ( 'Dim Department'[Department Code] ),
			            'Dim Department'[Department Code],
			            ", "
			        ),
			        BLANK ()
			    )
			VAR __5Region =
			    IF (
			        ISFILTERED ( 'Dim Region'[Region Name] ),
			        CONCATENATEX (
			            FILTERS ( 'Dim Region'[Region Name] ),
			            'Dim Region'[Region Name],
			            ", "
			        ),
			        BLANK ()
			    )
			VAR __6District =
			    IF (
			        ISFILTERED ( 'Dim District'[District Name] ),
			        CONCATENATEX (
			            FILTERS ( 'Dim District'[District Name] ),
			            'Dim District'[District Name],
			            ", "
			        ),
			        BLANK ()
			    )
			VAR __7Department =
			    IF (
			        ISFILTERED ( 'Dim Department'[Department Name] ),
			        CONCATENATEX (
			            FILTERS ( 'Dim Department'[Department Name] ),
			            'Dim Department'[Department Name],
			            ", "
			        ),
			        BLANK ()
			    )
			VAR __8ServiceType =
			    IF (
			        ISFILTERED ( 'Dim Service'[Service Type Name] ),
			        CONCATENATEX (
			            FILTERS ( 'Dim Service'[Service Type Name] ),
			            'Dim Service'[Service Type Name],
			            ", "
			        ),
			        BLANK ()
			    )
			VAR __9SeviceName =
			    IF (
			        ISFILTERED ( 'Dim Service'[Service Name] ),
			        CONCATENATEX (
			            FILTERS ( 'Dim Service'[Service Name] ),
			            'Dim Service'[Service Name],
			            ", "
			        ),
			        BLANK ()
			    )
			VAR _FC_1FinYear =
			    IF ( ISBLANK ( __1FinYear ), BLANK (), "FINANCIAL YEARS: " & __1FinYear )
			VAR _FC_2YearMonth =
			    IF (
			        ISBLANK ( __2YearMonth ),
			        BLANK (),
			        "-- FINANCIAL MONTHS: " & __2YearMonth
			    )
			VAR _FC_3Company =
			    IF ( ISBLANK ( __3Company ), BLANK (), "-- COMPANY: " & __3Company )
			VAR _FC_4BusUnit =
			    IF ( ISBLANK ( __4BusUnit ), BLANK (), "-- BUSINESS UNIT: " & __4BusUnit )
			VAR _FC_5Region =
			    IF ( ISBLANK ( __5Region ), BLANK (), "-- REGION: " & __5Region )
			VAR _FC_6District =
			    IF ( ISBLANK ( __6District ), BLANK (), "-- DISTRICT: " & __6District )
			VAR _FC_7Department =
			    IF ( ISBLANK ( __7Department ), BLANK (), "-- DEPARTMENT: " & __7Department )
			VAR _FC_8ServiceType =
			    IF (
			        ISBLANK ( __8ServiceType ),
			        BLANK (),
			        "-- SERVICE TYPE: " & __8ServiceType
			    )
			VAR _FC_9SeviceName =
			    IF ( ISBLANK ( __9SeviceName ), BLANK (), "-- SERVICE NAME: " & __9SeviceName )
			RETURN
			    // " ( " & FORMAT(FIRSTDATE('Dim Date'[Calendar Date]), "dd/MM/YYYY") & " - " & FORMAT(LASTDATE('Dim Date'[Calendar Date]), "dd/MM/YYYY") & " ) "
			    // & 
			    IF (
			        AND (
			            AND (
			                AND (
			                    AND (
			                        AND (
			                            AND ( ISBLANK ( _FC_3Company ), ISBLANK ( _FC_4BusUnit ) ),
			                            ISBLANK ( _FC_5Region )
			                        ),
			                        ISBLANK ( _FC_6District )
			                    ),
			                    ISBLANK ( _FC_7Department )
			                ),
			                ISBLANK ( _FC_8ServiceType )
			            ),
			            ISBLANK ( _FC_9SeviceName )
			        ),
			        "",
			        "Additional filters selected: " & " " & _FC_3Company & " " & _FC_4BusUnit & " " & _FC_5Region & " " & _FC_7Department & " " & _FC_8ServiceType & " " & _FC_9SeviceName
			    )
			```
		displayFolder: Other
		lineageTag: 676c41ff-09e4-4968-8015-0260e19189ef

