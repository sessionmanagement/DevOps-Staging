			        SUM ( 'Fact Finance Budget'[Finance Budget Amount] ),
			        ALL ( 'Dim Date'[Calendar Year Month] ),
			        'Dim Finance General Ledger Account'[Finance General Ledger Account Hierarchy Third Level Code] = "2001"
			    )
			RETURN
			    IF ( ISBLANK ( SalWagB ), 0, SalwagB )
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Salary and Wages
		lineageTag: 315f1534-4e3f-4ab2-8192-ef218c47b884

