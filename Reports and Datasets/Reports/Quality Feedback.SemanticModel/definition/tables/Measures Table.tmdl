	measure 'Total Expenses Previous Year' =
			
			VAR _Expense =
			    CALCULATE (
			        SUM ( 'Fact Finance General Ledger'[Inverse Amount] ),
			        DATEADD (
			            'Dim General Ledger Posting Date'[General Ledger Posting Calendar Date],
			            -1,
			            YEAR
			        ),
			        FILTER (
			            ALL ( 'Dim General Ledger Posting Date'[General Ledger Posting Calendar Date] ),
			            'Dim General Ledger Posting Date'[General Ledger Posting Calendar Date]
			                <= TODAY () - 365
			        ),
			        'Dim Finance General Ledger Account'[Finance General Ledger Account Hierarchy Second Level Code] = "2000"
			    )
			RETURN
			    IF ( ISBLANK ( _Expense ), 0, _Expense )
