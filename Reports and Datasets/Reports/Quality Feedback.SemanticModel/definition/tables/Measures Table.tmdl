	/// Calculates the year-to-date inverse amount from the Fact Finance general ledger up to the current date.
	measure 'Actual Amount Less Than Today YTD' =
			
			CALCULATE (
			    SUM ( 'Fact Finance General Ledger'[Inverse Amount] ),
			    FILTER (
			        'Dim General Ledger Posting Date',
			        'Dim General Ledger Posting Date'[General Ledger Posting Calendar Date]
			            <= TODAY ()
			    ),
			    DATESYTD ( 'Dim Date'[Calendar Date], "6/30" )
			)
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Revenue
