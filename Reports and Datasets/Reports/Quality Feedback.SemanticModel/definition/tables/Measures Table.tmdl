		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the variance amount between actual and budget amounts based on the selected account hierarchy level.
	/// 
	measure 'Variance $' = ```
			
			VAR __Val =
			    SELECTEDVALUE ( 'Dim Finance General Ledger Account'[Finance General Ledger Account Hierarchy Second Level Name] )
			VAR __Rev = [Actual Amount Less Than Today] - [Budget Amount Less Than Today] -- Jay - 2023-06-15 : A positive outcome of the above equation is a favourable (positive) result and should be represented in an upward arrow and the % positive A negative outcome is unfavourable (negative) and  should be represented by a downward arrow and the % should be negative */
			VAR __Exp = [Budget Amount Less Than Today] - [Actual Amount Less Than Today] -- Jay - 2023-06-15 : If the outcome is negative then it’s unfavourable (negative) and should be represented in a downward arrow and % should be a negative value.  If the outcome is positive then is favourable (positive) and should be represented in an upward arrow and the % be a positive value. 
			RETURN
			    IF ( __Val = "Total Expenses", __Exp, __Rev )
			```
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Variance
		lineageTag: 1f7238ce-0ad1-45af-b38e-da87fec203be

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the inverse amount from the Fact Finance general ledger up to the current date.
	/// 
	measure 'Actual Amount Less Than Today' =
			
			VAR _Amount =
			    CALCULATE (
			        SUM ( 'Fact Finance General Ledger'[Inverse Amount] ),
			        FILTER (
			            'Dim General Ledger Posting Date',
			            'Dim General Ledger Posting Date'[General Ledger Posting Calendar Date]
			                <= TODAY ()
			        )
			    )
			RETURN
			    IF ( ISBLANK ( _Amount ), 0, _Amount )
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Revenue
		lineageTag: 75d8ea30-88eb-49fc-9a4d-8bcfb6e55fc1

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the variance percentage between actual and budget amounts based on the selected account hierarchy level.
	/// 
	measure 'Variance %' =
			
			VAR __Val =
			    SELECTEDVALUE ( 'Dim Finance General Ledger Account'[Finance General Ledger Account Hierarchy Second Level Name] )
			VAR __Rev =
			    IF (
			        [Actual Amount Less Than Today] = 0
			            || [Budget Amount Less Than Today] = 0,
			        "",
			        DIVIDE (
			            ( [Actual Amount Less Than Today] - [Budget Amount Less Than Today] ),
			            [Budget Amount Less Than Today]
			        )
			    )
			VAR __Exp =
			    IF (
			        [Actual Amount Less Than Today] = 0
			            || [Budget Amount Less Than Today] = 0,
			        "",
			        DIVIDE (
			            ( [Budget Amount Less Than Today] - [Actual Amount Less Than Today] ),
			            [Budget Amount Less Than Today]
			        )
			    )
			VAR _Perc =
			    IF ( __Val = "Total Expenses", __Exp, __Rev )
			RETURN
			    IF ( ISBLANK ( _Perc ), 0, _Perc )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Variance
		lineageTag: 9d2bad5b-8752-46b8-94e3-c705d21720fd

	/// Calculates the sum of the inverse amount of the fact general ledger table for the previous year.
	measure 'Previous Year' =
			
			VAR _amount =
			    CALCULATE (
			        SUM ( 'Fact Finance General Ledger'[Inverse Amount] ),
			        DATEADD (
			            'Dim General Ledger Posting Date'[General Ledger Posting Calendar Date],
			            -1,
			            YEAR
			        ),
			        FILTER (
			            ALL ( 'Dim General Ledger Posting Date'[General Ledger Posting Calendar Date] ),
			            'Dim General Ledger Posting Date'[General Ledger Posting Calendar Date]
			                <= TODAY () - 365
			        )
			    )
			RETURN
			    IF ( ISBLANK ( _amount ), 0, _amount )
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Revenue
		lineageTag: 66ba993b-1624-4dd2-aede-e722c1f7c3af

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the gross surplus variance by subtracting Gross Surplus Budget from Gross Surplus.
