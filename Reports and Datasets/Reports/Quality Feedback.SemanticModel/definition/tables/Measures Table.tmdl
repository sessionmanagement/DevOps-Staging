	/// Calculates the budget amount up to the current date.
	/// 
	measure 'Budget Amount Less Than Today' =
			
			VAR _amount =
			    CALCULATE (
			        [Budget Amount],
			        FILTER (
			            'Dim Budget Date',
			            'Dim Budget Date'[Budget Calendar Date] <= TODAY ()
