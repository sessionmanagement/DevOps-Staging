	/// Calculates the net margin by dividing Net Surplus by Total Revenue.
	/// 
	measure 'Net Margin' =
			
			VAR __Surplus = [Net Surplus]
			VAR __Revenue = [Total Revenue]
			RETURN
			    IF (
			        OR (
			            OR ( ISBLANK ( __Surplus ), __Surplus = 0 ),
			            OR ( ISBLANK ( __Revenue ), __Revenue = 0 )
			        ),
			        BLANK (),
			        DIVIDE ( __Surplus, __Revenue, BLANK () )
			    )
		formatString: 0%;-0%;0%
		displayFolder: Other
		lineageTag: 85e553af-64f0-4c2b-a9bd-7c33ddd4b946

	/// Retrieves the applied filters based on various dimensions such as Date, Company, Department, Region, District, and Service.
	/// 
	measure 'Filters Applied' =
			
			VAR __1FinYear =
			    IF (
			        ISFILTERED ( 'Dim Date'[Financial Year Desc] ),
			        CONCATENATEX (
			            FILTERS ( 'Dim Date'[Financial Year Desc] ),
			            'Dim Date'[Financial Year Desc],
			            ", "
			        ),
			        BLANK ()
			    )
			VAR __2YearMonth =
			    IF (
			        ISFILTERED ( 'Dim Date'[Calendar Year Month] ),
			        CONCATENATEX (
			            FILTERS ( 'Dim Date'[Calendar Year Month] ),
			            'Dim Date'[Calendar Year Month],
			            ", "
			        ),
			        BLANK ()
			    )
			VAR __3Company =
			    IF (
			        ISFILTERED ( 'Dim Company'[Company Name] ),
			        CONCATENATEX (
			            FILTERS ( 'Dim Company'[Company Name] ),
			            'Dim Company'[Company Name],
			            ", "
			        ),
			        BLANK ()
			    )
			VAR __4BusUnit =
			    IF (
			        ISFILTERED ( 'Dim Department'[Department Code] ),
			        CONCATENATEX (
			            FILTERS ( 'Dim Department'[Department Code] ),
			            'Dim Department'[Department Code],
			            ", "
			        ),
			        BLANK ()
			    )
			VAR __5Region =
			    IF (
			        ISFILTERED ( 'Dim Region'[Region Name] ),
			        CONCATENATEX (
			            FILTERS ( 'Dim Region'[Region Name] ),
			            'Dim Region'[Region Name],
			            ", "
			        ),
			        BLANK ()
			    )
			VAR __6District =
			    IF (
			        ISFILTERED ( 'Dim District'[District Name] ),
			        CONCATENATEX (
			            FILTERS ( 'Dim District'[District Name] ),
			            'Dim District'[District Name],
			            ", "
			        ),
			        BLANK ()
			    )
			VAR __7Department =
			    IF (
			        ISFILTERED ( 'Dim Department'[Department Name] ),
			        CONCATENATEX (
			            FILTERS ( 'Dim Department'[Department Name] ),
			            'Dim Department'[Department Name],
			            ", "
			        ),
			        BLANK ()
			    )
			VAR __8ServiceType =
			    IF (
			        ISFILTERED ( 'Dim Service'[Service Type Name] ),
			        CONCATENATEX (
			            FILTERS ( 'Dim Service'[Service Type Name] ),
			            'Dim Service'[Service Type Name],
			            ", "
			        ),
			        BLANK ()
			    )
			VAR __9SeviceName =
			    IF (
			        ISFILTERED ( 'Dim Service'[Service Name] ),
			        CONCATENATEX (
			            FILTERS ( 'Dim Service'[Service Name] ),
			            'Dim Service'[Service Name],
			            ", "
			        ),
			        BLANK ()
			    )
			VAR __10BudgetName =
			    IF (
			        ISFILTERED ( 'Fact Finance Budget'[Finance Budget Budget Name] ),
			        CONCATENATEX (
			            FILTERS ( 'Fact Finance Budget'[Finance Budget Budget Name] ),
			            'Fact Finance Budget'[Finance Budget Budget Name],
			            ", "
			        ),
			        BLANK ()
			    )
			VAR _FC_1FinYear =
			    IF ( ISBLANK ( __1FinYear ), BLANK (), "FINANCIAL YEARS CHOSEN: " & __1FinYear )
			VAR _FC_2YearMonth =
			    IF (
			        ISBLANK ( __2YearMonth ),
			        BLANK (),
			        "-- FINANCIAL MONTHS CHOSEN: " & __2YearMonth
			    )
			VAR _FC_3Company =
			    IF ( ISBLANK ( __3Company ), BLANK (), "-- COMPANY CHOSEN: " & __3Company )
			VAR _FC_4BusUnit =
			    IF (
			        ISBLANK ( __4BusUnit ),
			        BLANK (),
			        "-- BUSINESS UNIT CHOSEN: " & __4BusUnit
			    )
			VAR _FC_5Region =
			    IF ( ISBLANK ( __5Region ), BLANK (), "-- REGION CHOSEN: " & __5Region )
			VAR _FC_6District =
			    IF ( ISBLANK ( __6District ), BLANK (), "-- DISTRICT CHOSEN: " & __6District )
			VAR _FC_7Department =
			    IF (
			        ISBLANK ( __7Department ),
			        BLANK (),
			        "-- DEPARTMENT CHOSEN: " & __7Department
			    )
			VAR _FC_8ServiceType =
			    IF (
			        ISBLANK ( __8ServiceType ),
			        BLANK (),
			        "-- SERVICE TYPE CHOSEN: " & __8ServiceType
			    )
			VAR _FC_9SeviceName =
			    IF (
			        ISBLANK ( __9SeviceName ),
			        BLANK (),
			        "-- SERVICE NAME CHOSEN: " & __9SeviceName
			    )
			VAR _FC_10BudgetName =
			    IF (
			        ISBLANK ( __10BudgetName ),
			        BLANK (),
			        "-- BUDGET NAME CHOSEN: " & __10BudgetName
			    )
			RETURN
			    " ( " & FORMAT ( FIRSTDATE ( 'Dim Date'[Calendar Date] ), "dd/MM/YYYY" ) & " - "
			        & FORMAT ( LASTDATE ( 'Dim Date'[Calendar Date] ), "dd/MM/YYYY" ) & " ) "
			        & IF (
			            AND (
			                AND (
			                    AND (
			                        AND (
			                            AND (
			                                AND (
			                                    AND ( ISBLANK ( _FC_3Company ), ISBLANK ( _FC_4BusUnit ) ),
			                                    ISBLANK ( _FC_5Region )
			                                ),
			                                ISBLANK ( _FC_6District )
			                            ),
			                            ISBLANK ( _FC_7Department )
			                        ),
			                        ISBLANK ( _FC_8ServiceType )
			                    ),
			                    ISBLANK ( _FC_9SeviceName )
			                ),
			                ISBLANK ( _FC_10BudgetName )
			            ),
			            "",
			            "and other selected fields: " & " " & _FC_3Company & " " & _FC_4BusUnit & " " & _FC_5Region & " " & _FC_6District & " " & _FC_7Department & " " & _FC_8ServiceType & " " & _FC_9SeviceName & " " & _FC_10BudgetName
			        )
		displayFolder: Other
		lineageTag: ad187b75-6d45-4469-bc6f-97ba24374e04

	/// Retrieves the actual line value based on the selected measure and corresponding actual line column.
	/// 
	measure VariableActualLine =
			
			VAR M =
			    SELECTEDVALUE ( 'InExFrame'[Measure] )
			VAR A =
			    SELECTEDVALUE ( InExFrame[Actual] )
			VAR F =
			    SELECTEDVALUE ( InExFrame[Forecast] )
			VAR V =
			    SELECTEDVALUE ( InExFrame[Variance] )
			VAR PV =
			    SELECTEDVALUE ( InExFrame[%Variance] )
			VAR I =
			    SELECTEDVALUE ( InExFrame[Icon] )
			VAR PY =
			    SELECTEDVALUE ( InExFrame[Previous Year] )
			VAR AF =
			    SELECTEDVALUE ( InExFrame[Annual Forecast] )
			VAR AL =
			    SELECTEDVALUE ( InExFrame[Actual Line] )
			RETURN
			    SWITCH (
			        TRUE (),
			        M = "Total Income"
			            && AL = "TR_Actual line",
			            CALCULATE (
			                SUM ( 'Fact Finance General Ledger'[Finance General Ledger Amount] ),
			                DATESYTD ( 'Dim Date'[Calendar Date], "6/30" ),
			                USERELATIONSHIP ( 'Fact Finance General Ledger'[Finance Posting Date KEY], 'Dim General Ledger Posting Date'[General Ledger Posting Dim Date KEY] ),
			                USERELATIONSHIP ( 'Dim General Ledger Posting Date'[General Ledger Posting Dim Date KEY], 'Dim Date'[Dim Date KEY] ),
			                'Dim Finance General Ledger Account'[Finance General Ledger Account Hierarchy Second Level Name] = "Total Income"
			            ) * -1,
			        M = "Total Wages"
			            && AL = "SW_Actual line", [SalaryWages],
			        M = "Gross Surplus"
			            && AL = "GS_Actual line", [Gross Surplus],
			        M = "Total Operating Expenses"
			            && AL = "TOE_Actual line", [Total Operating Expenses],
			        M = "Total Operating Surplus"
			            && AL = "TOS_Actual line", [EBIT],
			        M = "Interest Expense"
			            && AL = "IE_Actual line", [InterestExpense],
			        M = "Recharges"
			            && A = "R_Actual", [Total Recharges],
			        M = "Depreciation"
			            && AL = "D_Actual line", [Total Depreciation],
			        M = "Net Surplus"
			            && AL = "NS_Actual line", [Net Surplus]
			    )
		displayFolder: Variable Measures
		lineageTag: 0b21b663-0d50-4dea-b040-c23e176e23dd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Calculates the difference between the forecast and actual values based on the selected measure.
	/// 
	measure 'VariableForecast minus Actual' =
			
			VAR M =
			    SELECTEDVALUE ( 'InExFrame'[Measure] )
			VAR A =
			    SELECTEDVALUE ( InExFrame[Actual] )
			VAR F =
			    SELECTEDVALUE ( InExFrame[Forecast] )
			VAR V =
			    SELECTEDVALUE ( InExFrame[Variance] )
			VAR PV =
			    SELECTEDVALUE ( InExFrame[%Variance] )
			VAR I =
			    SELECTEDVALUE ( InExFrame[Icon] )
			VAR PY =
			    SELECTEDVALUE ( InExFrame[Previous Year] )
			VAR AF =
			    SELECTEDVALUE ( InExFrame[Annual Forecast] )
			VAR AL =
			    SELECTEDVALUE ( InExFrame[Actual Line] )
			RETURN
			    SWITCH (
			        TRUE (),
			        M = "Total Income"
			            && F = "TR_Forecast", [Total Revenue (Budget)] - [Total Revenue],
			        M = "Total Wages"
			            && F = "SW_Forecast", [SalaryWages Budget] - [SalaryWages],
			        M = "Gross Surplus"
			            && F = "GS_Forecast", [Gross Surplus Budget] - [Gross Surplus],
			        M = "Total Operating Expenses"
			            && F = "TOE_Forecast", [Total Operating Expenses Budget] - [Total Operating Expenses],
			        M = "Total Operating Surplus"
			            && F = "TOS_Forecast", [EBIT Budget] - [EBIT],
			        M = "Interest Expense"
			            && F = "IE_Forecast", [InterestExpense Budget] - [InterestExpense],
			        M = "Depreciation"
			            && F = "D_Forecast", [Total Depreciation Budget] - [Total Depreciation],
			        M = "Recharges"
			            && F = "R_Forecast", FORMAT ( [Total Recharges Budget] - [Total Recharges], "#,##0, ;(#,##0,);-" ),
			        M = "Net Surplus"
			            && F = "NS_Forecast", [Net Surplus Budget] - [Net Surplus]
			    )
		displayFolder: Variable Measures
		lineageTag: 7b815b08-863b-4e80-8e5d-17a1032f492f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

