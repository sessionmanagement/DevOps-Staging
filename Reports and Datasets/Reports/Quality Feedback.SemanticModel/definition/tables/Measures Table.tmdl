	measure 'Line chart title' =
			
			VAR _AccountCode =
			    ADDCOLUMNS (
			        TOPN (
			            2,
			            FILTER (
			                VALUES ( 'Dim Finance General Ledger Account'[Account Code & Description] ),
			                NOT (
			                    ISBLANK ( 'Dim Finance General Ledger Account'[Account Code & Description] )
			                )
			            ),
			            'Dim Finance General Ledger Account'[Account Code & Description], ASC
			        ),
			        "Accounts_Display", 'Dim Finance General Ledger Account'[Account Code & Description]
			    )
			VAR __AccountCodeCount =
			    IF (
			        ISFILTERED ( 'Dim Finance General Ledger Account'[Account Code & Description] ),
			        COUNTROWS (
			            VALUES ( 'Dim Finance General Ledger Account'[Account Code & Description] )
			        ),
			        0
			    )
			VAR _FC_AccountCode =
			    IF (
			        __AccountCodeCount > 0,
			        CONCATENATEX ( _AccountCode, [Accounts_Display], "and " ),
			        BLANK ()
			    )
			VAR _FC_MoreAccountCodes =
			    IF (
			        __AccountCodeCount > 2,
			        " and " & ( __AccountCodeCount - 2 ) & " more",
			        ""
			    )
			RETURN
			    IF (
			        ISBLANK ( _FC_AccountCode ),
			        "Actual vs Budget for All Account Codes",
			        "Actual vs Budget for: " & " " & _FC_AccountCode & " " & _FC_MoreAccountCodes
			    )
		displayFolder: Other
		lineageTag: 0d57925a-4f09-4888-b0ad-d2a74fde80c0

