	/// Calculates the total annual depreciation budget.
	/// 
	measure 'Annual Depreciation Budget' =
			
			VAR _Depreciation =
			    CALCULATE (
			        SUM ( 'Fact Finance Budget'[Finance Budget Amount] ),
			        ALL ( 'Dim Date'[Calendar Year Month] ),
			        'Dim Finance General Ledger Account'[Finance General Ledger Account Code] > 2600
			            && 'Dim Finance General Ledger Account'[Finance General Ledger Account Code] < 2620
			    )
