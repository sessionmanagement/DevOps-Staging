	/// Calculates the total recharges budget.
	/// 
	measure 'Total Recharges Budget' =
			
			VAR _Recharges =
			    CALCULATE (
			        SUM ( 'Fact Finance Budget'[Finance Budget Amount] ),
			        FILTER (
			            'Fact Finance Budget',
			            'Fact Finance Budget'[Finance Budget Date] <= TODAY ()
			        ),
			        'Dim Finance General Ledger Account'[Finance General Ledger Account Hierarchy Fourth Level Code] = "2900"
			    )
			RETURN
			    IF ( ISBLANK ( _Recharges ), 0, _Recharges )
		formatString: "#,##0,. ;(#,##0,.);- "
