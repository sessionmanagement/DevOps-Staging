	/// Calculates the total revenue for the previous year.
	/// 
	measure 'Revenue Previous Year' =
			
			VAR _Revenue =
			    CALCULATE (
			        SUM ( 'Fact Finance General Ledger'[Inverse Amount] ),
			        //SAMEPERIODLASTYEAR(DimDate[Date]),
			        DATEADD (
			            'Dim General Ledger Posting Date'[General Ledger Posting Calendar Date],
			            -1,
			            YEAR
			        ),
			        FILTER (
			            ALL ( 'Dim General Ledger Posting Date'[General Ledger Posting Calendar Date] ),
			            'Dim General Ledger Posting Date'[General Ledger Posting Calendar Date]
			                <= TODAY () - 365
			        ),
			        'Fact Finance General Ledger'[Finance General Ledger Account No] < 2000
			    )
			RETURN
			    IF ( ISBLANK ( _Revenue ), 0, _Revenue )
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Revenue
		lineageTag: 137cef09-1273-4a51-91bd-8a9f14726825

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the total salaries and wages for the previous year.
	/// 
	measure 'SalariesWages Previous Year' =
			
			VAR _SW =
			    CALCULATE (
			        SUM ( 'Fact Finance General Ledger'[Inverse Amount] ),
			        DATEADD (
			            'Dim General Ledger Posting Date'[General Ledger Posting Calendar Date],
			            -1,
			            YEAR
			        ),
			        FILTER (
			            ALL ( 'Dim General Ledger Posting Date'[General Ledger Posting Calendar Date] ),
			            'Dim General Ledger Posting Date'[General Ledger Posting Calendar Date]
			                <= TODAY () - 365
			        ),
			        'Fact Finance General Ledger'[Finance General Ledger Account No] > 2000,
			        'Fact Finance General Ledger'[Finance General Ledger Account No] < 2050
			    )
			RETURN
			    IF ( ISBLANK ( _SW ), 0, _SW )
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Salary and Wages
		lineageTag: bad88c77-e0cf-4b03-a7a0-dca94de2f4e3

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the gross surplus for the previous year by subtracting SalariesWages Previous Year from Revenue Previous Year.
