	/// Calculates the annual net surplus by subtracting Annual Interest Expense and Annual Depreciation Budget from Annual Operating Surplus Budget.
	/// 
	measure 'Annual Net Surplus' =
			
			[Annual Operating Surplus Budget] - [Annual Interest Expense] - [Annual Depreciation Budget]
