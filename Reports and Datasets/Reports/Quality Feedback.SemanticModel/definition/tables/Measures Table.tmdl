	/// Retrieves the annual forecast value based on the selected measure and corresponding annual forecast column.
	/// 
	measure VariableAnnualForecast =
			
			VAR M =
			    SELECTEDVALUE ( 'InExFrame'[Measure] )
			VAR A =
			    SELECTEDVALUE ( InExFrame[Actual] )
			VAR F =
			    SELECTEDVALUE ( InExFrame[Forecast] )
			VAR V =
			    SELECTEDVALUE ( InExFrame[Variance] )
			VAR PV =
			    SELECTEDVALUE ( InExFrame[%Variance] )
			VAR I =
			    SELECTEDVALUE ( InExFrame[Icon] )
			VAR PY =
			    SELECTEDVALUE ( InExFrame[Previous Year] )
			VAR AF =
			    SELECTEDVALUE ( InExFrame[Annual Forecast] )
			VAR AL =
			    SELECTEDVALUE ( InExFrame[Actual Line] )
			RETURN
			    SWITCH (
			        TRUE (),
			        M = "Total Income"
			            && AF = "TR_Annual Forecast", FORMAT ( [Annual Budget Revenue], "#,##0, ;(#,##0,);-" ),
			        M = "Total Wages"
			            && AF = "SW_Annual Forecast", FORMAT ( [Annual SalaryWages Budget], "#,##0, ;(#,##0,);-" ),
			        M = "Gross Surplus"
			            && AF = "GS_Annual Forecast", FORMAT ( [Annual Gross Surplus Budget], "#,##0, ;(#,##0,);-" ),
			        M = "Total Operating Expenses"
			            && AF = "TOE_Annual Forecast", FORMAT ( [Annual Total Operating Expenses Budget], "#,##0, ;(#,##0,);-" ),
			        M = "Total Operating Surplus"
			            && AF = "TOS_Annual Forecast", FORMAT ( [Annual Operating Surplus Budget], "#,##0, ;(#,##0,);-" ),
			        M = "Interest Expense"
			            && AF = "IE_Annual Forecast", FORMAT ( [Annual Interest Expense], "#,##0, ;(#,##0,);-" ),
			        M = "Depreciation"
			            && AF = "D_Annual Forecast", FORMAT ( [Annual Depreciation Budget], "#,##0, ;(#,##0,);-" ),
			        M = "Recharges"
			            && AF = "R_Annual Forecast", FORMAT ( [Annual Recharges Budget], "#,##0, ;(#,##0,);-" ),
			        M = "Net Surplus"
			            && AF = "NS_Annual Forecast", FORMAT ( [Annual Net Surplus], "#,##0, ;(#,##0,);-" ),
			        M = "Net Margin"
			            && AF = "NM_Annual Forecast", FORMAT ( [Annual Net Margin], "0.0%" )
			    )
		displayFolder: Variable Measures
		lineageTag: 014a9d19-2b02-4fd8-bd99-761b08f90357

