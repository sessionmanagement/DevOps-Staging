	/// Retrieves the revenue forecast value.
	/// 
	measure 'Revenue Forecast' =
			
			VAR _Value =
			    FORMAT ( [Total Revenue (Budget)], "$#,##0," )
			RETURN
			    "Forecast: " & _Value
		displayFolder: Revenue
		lineageTag: e679bb82-d3c4-4837-9e04-3c34f8f36f5a

	/// Calculates the revenue forecast percentage.
	/// 
	measure RevenueForecastPerc =
			
			VAR _Value =
			    DIVIDE (
			        ( [Total Revenue] - [Total Revenue (Budget)] ),
			        [Total Revenue (Budget)]
			    )
			RETURN
			    IF (
			        _Value = -1,
			        "0.0% -",
			        FORMAT ( _Value, "0.0%" )
			            & IF ( _Value = 0, " -", IF ( _Value > 0, " ⬆", " ⬇" ) )
			    )
		displayFolder: Revenue
		lineageTag: f197b6f0-fc1f-4b91-894a-e6b0324055b3

