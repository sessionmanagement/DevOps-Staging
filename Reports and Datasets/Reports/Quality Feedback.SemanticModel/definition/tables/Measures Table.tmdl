	/// Calculates the year-to-date budget amount up to the current date.
	/// 
	measure 'Budget Amount Less Than Today YTD' =
			
			CALCULATE (
			    [Budget Amount],
			    FILTER (
			        'Dim Budget Date',
			        'Dim Budget Date'[Budget Calendar Date] <= TODAY ()
			    ),
			    DATESYTD ( 'Dim Date'[Calendar Date], "6/30" )
			)
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Budget
		lineageTag: ad42d764-1391-4e67-ac95-a15553ffc799

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the year-to-date variance percentage between actual and budget amounts based on the selected account hierarchy level.
	/// 
	measure 'Variance % YTD' =
			
			VAR __Val =
			    SELECTEDVALUE ( 'Dim Finance General Ledger Account'[Finance General Ledger Account Hierarchy Second Level Name] )
			VAR __Rev =
			    IF (
			        [Actual Amount Less Than Today YTD] = 0
			            || [Budget Amount Less Than Today YTD] = 0,
			        "",
			        DIVIDE (
			            ( [Actual Amount Less Than Today YTD] - [Budget Amount Less Than Today YTD] ),
			            [Budget Amount Less Than Today YTD]
			        )
			    )
			VAR __Exp =
			    IF (
			        [Actual Amount Less Than Today YTD] = 0
			            || [Budget Amount Less Than Today YTD] = 0,
			        "",
			        DIVIDE (
			            ( [Budget Amount Less Than Today YTD] - [Actual Amount Less Than Today YTD] ),
			            [Budget Amount Less Than Today YTD]
			        )
			    )
			RETURN
			    IF ( __Val = "Total Expenses", __Exp, __Rev )
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Variance
		lineageTag: 786c34a4-b6bc-4d1d-8b29-0ce12c7ac507

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the running total of the total revenue variance.
	/// 
	measure 'Total Revenue Variance running total' =
			
			CALCULATE (
			    [Total Revenue Variance],
			    FILTER (
			        ALLSELECTED ( 'Dim Date'[Calendar Year Month] ),
			        ISONORAFTER (
			            'Dim Date'[Calendar Year Month], MAX ( 'Dim Date'[Calendar Year Month] ), DESC
			        )
			    )
			)
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Variance
		lineageTag: 968f2b2a-c655-44de-af41-63d4c4df7a70

