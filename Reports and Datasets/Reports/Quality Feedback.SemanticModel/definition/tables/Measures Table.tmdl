	/// Identifies the top or bottom 5 entries based on the Variance $ measure.
	/// 
	measure TopBottom5 =
			
			IF (
			    ISBLANK ( [Variance $] ),
			    BLANK (),
			    IF (
			        RANKX (
			            ALLSELECTED ( 'Dim Finance General Ledger Account'[Finance General Ledger Account Description] ),
			            [Variance $],
			            [Variance $],
			            ASC
			        ) <= 5
			            || RANKX (
			                ALL ( 'Dim Finance General Ledger Account'[Finance General Ledger Account Description] ),
			                [Variance $],
			                [Variance $],
			                DESC
			            ) <= 5,
			        1,
			        0
			    )
			)
		formatString: 0
		displayFolder: Other
		lineageTag: d542ceff-1864-4ee4-b1b8-47ccf493df4b

