	/// Retrieves the previous year value based on the selected measure and corresponding previous year column.
	/// 
	measure VariablePreviousYear =
			
			VAR M =
			    SELECTEDVALUE ( 'InExFrame'[Measure] )
			VAR A =
			    SELECTEDVALUE ( InExFrame[Actual] )
			VAR F =
			    SELECTEDVALUE ( InExFrame[Forecast] )
			VAR V =
			    SELECTEDVALUE ( InExFrame[Variance] )
			VAR PV =
			    SELECTEDVALUE ( InExFrame[%Variance] )
			VAR I =
			    SELECTEDVALUE ( InExFrame[Icon] )
			VAR PY =
			    SELECTEDVALUE ( InExFrame[Previous Year] )
			VAR AF =
			    SELECTEDVALUE ( InExFrame[Annual Forecast] )
			VAR AL =
			    SELECTEDVALUE ( InExFrame[Actual Line] )
			RETURN
			    SWITCH (
			        TRUE (),
			        M = "Total Income"
			            && PY = "TR_Previous Year", [Revenue Previous Year],
			        M = "Total Wages"
			            && PY = "SW_Previous Year", [SalariesWages Previous Year],
			        M = "Gross Surplus"
			            && PY = "GS_Previous Year", [Gross Surplus Previous Year],
			        M = "Total Operating Expenses"
			            && PY = "TOE_Previous Year", [Operating Expenses Previous Year],
			        M = "Total Operating Surplus"
			            && PY = "TOS_Previous Year", [Operating Surplus Previous Year],
			        M = "Interest Expense"
			            && PY = "IE_Previous Year", [Interest Expenses Previous Year],
			        M = "Depreciation"
			            && PY = "D_Previous Year", [Depreciation Previous Year],
			        M = "Recharges"
			            && PY = "R_Previous Year", FORMAT ( [Recharges Previous Year], "#,##0, ;(#,##0,);-" ),
			        M = "Net Surplus"
			            && PY = "NS_Previous Year", [Net Surplus Previous Year]
			    )
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Variable Measures
		lineageTag: 3dbd3069-b77d-4258-82c9-92463a6b39b3

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the total annual budget revenue by summing the inverse amount from the fact budget table where Second Level Account Name = "Total Income"
	/// 
	measure 'Annual Budget Revenue' =
			
			VAR RevenueBudget =
			    CALCULATE (
			        - SUM ( 'Fact Finance Budget'[Finance Budget Amount] ),
			        ALL ( 'Dim Date'[Calendar Year Month] ),
			        'Dim Finance General Ledger Account'[Finance General Ledger Account Hierarchy Second Level Name] = "Total Income"
			    )
			RETURN
			    IF ( ISBLANK ( RevenueBudget ), 0, RevenueBudget )
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Revenue
		lineageTag: bd72aeee-bef8-4793-a358-65c314c53e4f

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the total annual salary and wages budget.
