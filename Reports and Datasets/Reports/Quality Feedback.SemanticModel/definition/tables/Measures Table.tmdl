	/// Calculates the actual amount for the current month.
	/// 
	measure 'Actual - Month' =
			
			CALCULATE (
			    [Actual Amount Less Than Today],
			    'Dim Date'[Current Month Flag] = 1
			)
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: P&L Summary
		lineageTag: d0dc76e7-fff7-45cc-8eca-d8ab6dbccb72

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the forecast amount for the current month.
	/// 
	measure 'Forecast - Month' =
			
			CALCULATE (
			    [Budget Amount Less Than Today],
			    'Dim Date'[Current Month Flag] = 1
			)
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: P&L Summary
		lineageTag: 8721c621-1cfa-44e5-995c-34a1c7977a45

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the variance amount for the current month.
	/// 
	measure 'Variance $ - Month' =
			
			CALCULATE ( [Variance $], 'Dim Date'[Current Month Flag] = 1 )
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: P&L Summary
		lineageTag: 6c7953e5-0009-4377-8381-0e24c700139e

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the variance percentage for the current month.
	/// 
	measure 'Variance % - Month' =
			
			CALCULATE (
			    DIVIDE ( [Variance $ - Month], [Forecast - Month] ),
			    'Dim Date'[Current Month Flag] = 1
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: P&L Summary
		lineageTag: 8af90008-38ca-4646-aa26-d0913ba76d85

	/// Calculates the forecast amount for the full year.
	/// 
	measure 'Forecast - Full Year' =
			
			CALCULATE ( [Budget Amount], ALL ( 'Dim Date'[Calendar Year Month] ) )
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: P&L Summary
		lineageTag: 20a082ec-b30b-4501-91d2-042c770eb2b1

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the gross profit variance for the current month.
	/// 
	measure 'Gross Profit Variance$ Month' =
			
			VAR _Income =
			    CALCULATE (
			        [Variance $ - Month],
			        'Dim Finance General Ledger Account'[Finance General Ledger Account Code]
			            IN { 1010, 1011, 1060, 1061, 1100 }
			    )
			VAR _Wages =
			    CALCULATE (
			        [Variance $ - Month],
			        'Dim Finance General Ledger Account'[Finance General Ledger Account Code]
			            IN { 2010, 2011, 2030, 2040, 2020 }
			    )
			RETURN
			    _Income + _Wages
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Gross Surplus
		lineageTag: bf17a7be-c42c-4c8e-b776-ea0e812e6617

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the variance percentage year-to-date.
	/// 
	measure 'Variance % - YTD' =
			
			CALCULATE ( DIVIDE ( [Variance $ YTD], [Budget Amount Less Than Today YTD] ) )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: P&L Summary
		lineageTag: 5adbdfa8-a27b-4287-8e0e-6ca5373c0d72

	/// Calculates the gross profit forecast for the full year.
	/// 
	measure 'Gross profit Forecast - FY' =
			
			VAR _Income =
			    CALCULATE (
			        [Budget Amount],
			        'Dim Finance General Ledger Account'[Finance General Ledger Account Code]
			            IN { 1010, 1011, 1060, 1061, 1100 },
			        ALL ( 'Dim Date'[Calendar Year Month] )
			    )
			VAR _Wages =
			    CALCULATE (
			        [Budget Amount],
			        'Dim Finance General Ledger Account'[Finance General Ledger Account Code]
			            IN { 2010, 2011, 2030, 2040, 2020 },
			        ALL ( 'Dim Date'[Calendar Year Month] )
			    )
			RETURN
			    _Income - _Wages
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Gross Surplus
		lineageTag: 58c864a0-f428-4cf8-aa14-34a1b092653e

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the net surplus before recharges for the previous month.
	/// 
	measure 'Month Net Surplus (bef rechar)' =
			
			VAR _PreviousMonth = [Max filtered Month]
			VAR _surplus =
			    CALCULATE (
			        [Net Surplus (bef rechar)],
			        'Dim Date'[Calendar Year Month] = _PreviousMonth
			    )
			RETURN
			    IF ( ISBLANK ( _surplus ), 0, _surplus )
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Net Surplus
		lineageTag: 6f786538-42bf-4af7-8c81-c1c7b1076fee

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the net surplus before recharges budget for the previous month.
	/// 
	measure 'Month Net Surplus (bef rechar) Budget' =
			
			VAR _PreviousMonth = [Max filtered Month]
			VAR _surplus =
			    CALCULATE (
			        [Net Surplus (bef rechar) Budget],
			        'Dim Date'[Calendar Year Month] = _PreviousMonth
			    )
			RETURN
			    IF ( ISBLANK ( _surplus ), 0, _surplus )
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Net Surplus
		lineageTag: 2a99e799-21ba-4c63-8717-fb64274dae5e

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the net surplus before recharges variance for the previous month.
	/// 
	measure 'Month Net Surplus (bef Rechar) variance$' =
			
			[Month Net Surplus (bef rechar)] - [Month Net Surplus (bef rechar) Budget]
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Net Surplus
		lineageTag: 175cb0c3-70fd-4028-a5c1-9956c61dcba2

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the net surplus before recharges variance percentage for the previous month.
	/// 
	measure 'Month Net Surplus (bef rechar) variance%' =
			
			DIVIDE (
			    [Month Net Surplus (bef Rechar) variance$],
			    [Month Net Surplus (bef rechar) Budget]
			)
		formatString: 0.00%;-0.00%;0.00%
