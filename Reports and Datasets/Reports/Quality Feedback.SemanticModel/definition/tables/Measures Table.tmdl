	measure 'Fact General Ledger Row Count' =
			
			COUNTROWS ( 'Fact Finance General Ledger' )
		formatString: 0
		displayFolder: Activity Measures
		lineageTag: 7c79360a-3037-4d14-b0de-df24b542f091

	measure 'Sum of GL' =
			
			SUM ( 'Fact Finance General Ledger'[Finance General Ledger Amount] )
		formatString: \$#,0;-\$#,0;\$#,0
		displayFolder: Activity Measures
		lineageTag: 12cfd773-4fc4-44c9-a04f-b89ab482407b

		annotation PBI_FormatHint = {"currencyCulture":"en-NZ"}

	/// Calculates the total revenue by summing the 'Finance General Ledger Amount' for accounts with the 'Finance General Ledger Account Hierarchy Second Level Code' equal to "1001".
	/// 
	measure 'Total Revenue' =
			
			VAR _revenue =
			    CALCULATE (
			        - SUM ( 'Fact Finance General Ledger'[Finance General Ledger Amount] ),
			        'Dim Finance General Ledger Account'[Finance General Ledger Account Hierarchy Second Level Code] = "1001"
			    )
			RETURN
			    IF ( ISBLANK ( _revenue ), 0, _revenue )
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Revenue
		lineageTag: 8f82f4d0-8b18-4dc0-9012-2df186c91700

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the total salary and wages by summing the 'Finance General Ledger Amount' for accounts with the 'Finance General Ledger Account Hierarchy Third Level Code' equal to "2001".
	/// 
	measure SalaryWages =
			
			VAR SalWage =
			    CALCULATE (
			        SUM ( 'Fact Finance General Ledger'[Finance General Ledger Amount] ),
			        'Dim Finance General Ledger Account'[Finance General Ledger Account Hierarchy Third Level Code] = "2001"
			    )
			RETURN
			    IF ( ISBLANK ( SalWage ), 0, SalWage )
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Salary and Wages
		lineageTag: a4c726e9-3520-44b4-9266-0e03dc5a30a2

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the gross surplus by subtracting SalaryWages from Total Revenue.
	/// 
	measure 'Gross Surplus' =
			
			[Total Revenue] - [SalaryWages]
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Gross Surplus
		lineageTag: 95194325-ca8f-42d6-b7a6-f8eba43aadb7

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the total expenses by summing the 'Finance General Ledger Amount' for accounts with the 'Finance General Ledger Account Hierarchy Second Level Code' equal to "2000".
	/// 
	measure 'Total Expenses' =
			
			VAR _Expense =
			    CALCULATE (
			        SUM ( 'Fact Finance General Ledger'[Finance General Ledger Amount] ),
			        'Dim Finance General Ledger Account'[Finance General Ledger Account Hierarchy Second Level Code] = "2000"
			    )
			RETURN
			    IF ( ISBLANK ( _Expense ), 0, _Expense )
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Expenses
		lineageTag: 7332f3da-fee4-4f56-9565-386ffd027e02

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the total operating expenses by subtracting SalaryWages from Total Expenses.
	/// 
	measure 'Total Operating Expenses' =
			
			[Total Expenses] - [SalaryWages] - [Total Recharges]
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Expenses
		lineageTag: 2edb5853-1ce5-43bf-bbaa-e5d53a226d84

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the net surplus by subtracting Total Operating Expenses from Gross Surplus.
	/// 
	measure 'Net Surplus' =
			
			[Total Revenue] - [Total Expenses]
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Net Surplus
		lineageTag: b388c9e2-8198-442e-a4ad-c1518d105950

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the year-to-date total revenue up to the current date.
	/// 
	measure 'Total Revenue YTD' =
			
			VAR _value =
			    CALCULATE (
			        SUM ( 'Fact Finance General Ledger'[Finance General Ledger Amount] ),
			        DATESYTD ( 'Dim Date'[Calendar Date], "6/30" ),
			        'Dim Finance General Ledger Account'[Finance General Ledger Account Hierarchy Second Level Name] = "Total Income"
			    ) * -1
			RETURN
			    IF ( MAX ( 'Dim Date'[Calendar Date] ) <= TODAY (), _value, BLANK () )
			//_value
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Revenue
		lineageTag: de9bfe1d-d636-4239-97cd-e0657a5a67d6

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the year-to-date total revenue budget up to the current date.
	/// 
	measure 'Total Revenue Budget YTD' =
			
			VAR RevBudYTD =
			    CALCULATE (
			        SUM ( 'Fact Finance Budget'[Finance Budget Amount] ),
			        DATESYTD ( 'Dim Date'[Calendar Date], "30/06" ),
			        'Dim Finance General Ledger Account'[Finance General Ledger Account Hierarchy Second Level Name] = "Total Income"
			    ) * -1
			RETURN
			    //IF(MAX('Dim Date'[Calendar Date]) <= TODAY(), RevBudYTD, BLANK())
			    RevBudYTD
			//RETURN
			//IF(ISBLANK(RevBudYTD),0,RevBudYTD)
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Revenue
		lineageTag: d10ffd4d-1ac9-4d3b-a7c5-2ce4f9c8e050

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the year-to-date salary and wages up to the current date.
	/// 
	measure 'Salary and Wages YTD' =
			
			VAR _value =
			    CALCULATE (
			        [SalaryWages],
			        DATESYTD ( 'Dim Date'[Calendar Date], "6/30" ),
			        USERELATIONSHIP ( 'Fact Finance General Ledger'[Finance Posting Date KEY], 'Dim General Ledger Posting Date'[General Ledger Posting Dim Date KEY] ),
			        USERELATIONSHIP ( 'Dim General Ledger Posting Date'[General Ledger Posting Dim Date KEY], 'Dim Date'[Dim Date KEY] )
			    )
			RETURN
			    IF ( MAX ( 'Dim Date'[Calendar Date] ) <= TODAY (), _value, BLANK () )
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Salary and Wages
		lineageTag: a792519e-bd9b-4db7-8946-1acf4f2d541c

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the year-to-date salary and wages budget up to the current date.
	/// 
	measure 'SalaryWages Budget YTD' =
			
			VAR _value =
			    IFERROR (
			        CALCULATE (
			            [SalaryWages Budget],
			            DATESYTD ( 'Dim Date'[Calendar Date], "6/30" ),
			            USERELATIONSHIP ( 'Fact Finance Budget'[Finance Budget Date KEY], 'Dim Budget Date'[Budget Dim Date KEY] ),
			            USERELATIONSHIP ( 'Dim Budget Date'[Budget Dim Date KEY], 'Dim Date'[Dim Date KEY] )
			        ),
			        0
			    )
			RETURN
			    //IF(MAX('Dim Date'[Calendar Date]) <= TODAY(), _value, BLANK())
			    _value
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Salary and Wages
		lineageTag: cba6e83b-51c9-48d7-805b-06815cf045fa

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the total salary and wages budget.
	/// 
	measure 'SalaryWages Budget' =
			
			VAR SalWagB =
			    CALCULATE (
			        SUM ( 'Fact Finance Budget'[Finance Budget Amount] ),
			        //FILTER('Fact Finance Budget', 'Fact Finance Budget'[Finance Budget Date] <= TODAY()),
			        'Dim Finance General Ledger Account'[Finance General Ledger Account Hierarchy Third Level Code] = "2001"
			    )
			RETURN
			    IF ( ISBLANK ( SalWagB ), 0, SalwagB )
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Salary and Wages
		lineageTag: 7e4fbaaa-1b6c-4d91-905c-5814174ac464

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the year-to-date total operating expenses up to the current date.
	/// 
	measure 'Total Operating Expenses YTD' =
			
			VAR _value =
			    CALCULATE (
			        [Total Operating Expenses],
			        DATESYTD ( 'Dim Date'[Calendar Date], "6/30" ),
			        USERELATIONSHIP ( 'Fact Finance General Ledger'[Finance Posting Date KEY], 'Dim General Ledger Posting Date'[General Ledger Posting Dim Date KEY] ),
			        USERELATIONSHIP ( 'Dim General Ledger Posting Date'[General Ledger Posting Dim Date KEY], 'Dim Date'[Dim Date KEY] )
			    )
			RETURN
			    IF ( MAX ( 'Dim Date'[Calendar Date] ) <= TODAY (), _value, BLANK () )
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Expenses
		lineageTag: 77aa27b0-44b1-421c-a95d-48db60a6a761

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the year-to-date total operating expenses budget up to the current date.
	/// 
	measure 'Total Operating Expenses Budget YTD' =
			
			VAR _value =
			    CALCULATE (
			        [Total Operating Expenses Budget],
			        DATESYTD ( 'Dim Date'[Calendar Date], "6/30" ),
			        USERELATIONSHIP ( 'Fact Finance Budget'[Finance Budget Date KEY], 'Dim Budget Date'[Budget Dim Date KEY] ),
			        USERELATIONSHIP ( 'Dim Budget Date'[Budget Dim Date KEY], 'Dim Date'[Dim Date KEY] )
			    )
			RETURN
			    //IF(MAX('Dim Date'[Calendar Date]) <= TODAY(), _value, BLANK())
			    _value
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Expenses
		lineageTag: 794823a0-fd85-4795-a2ae-4737832c8969

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the total operating expenses budget by subtracting SalaryWages Budget from Total Expenses Budget.
	/// 
	measure 'Total Operating Expenses Budget' =
			
			[Total Expenses Budget] - [SalaryWages Budget] - [Total Recharges Budget]
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Expenses
		lineageTag: 7fcc05ff-db04-4927-b102-af5204e8a599

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the total expenses budget.
	/// 
	measure 'Total Expenses Budget' =
			
			VAR _Expense =
			    CALCULATE (
			        SUM ( 'Fact Finance Budget'[Finance Budget Amount] ),
			        //FILTER('Fact Finance Budget', 'Fact Finance Budget'[Finance Budget Date]<= TODAY()),
			        'Dim Finance General Ledger Account'[Finance General Ledger Account Hierarchy Second Level Code] = "2000"
			    )
			RETURN
			    IF ( ISBLANK ( _Expense ), 0, _Expense )
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Expenses
		lineageTag: 73b38b4a-2665-43ec-a4d5-0fe5d3cbf36f

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the Earnings Before Interest and Taxes (EBIT) by subtracting Total Operating Expenses, Total Depreciation, and InterestExpense from Gross Surplus.
	/// 
	measure EBIT =
			
			[Gross Surplus] - [Total Operating Expenses] - [Total Depreciation] - [InterestExpense]
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Expenses
		lineageTag: cf89858a-887e-4ac6-a70d-fe471b76e0be

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the total depreciation amount.
	/// 
	measure 'Total Depreciation' =
			
			VAR _Depreciation =
			    CALCULATE (
			        SUM ( 'Fact Finance General Ledger'[Finance General Ledger Amount] ),
			        'Dim Finance General Ledger Account'[Finance General Ledger Account Hierarchy Fourth Level Code] = "2600"
			    )
			RETURN
			    IF ( ISBLANK ( _Depreciation ), 0, _Depreciation )
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Depreciation
		lineageTag: d1f01a67-15e5-4946-8adb-f542530ca267

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the total interest expense.
	/// 
	measure InterestExpense =
			
			VAR _Interest =
			    CALCULATE (
			        SUM ( 'Fact Finance General Ledger'[Finance General Ledger Amount] ),
			        'Dim Finance General Ledger Account'[Finance General Ledger Account Hierarchy Fourth Level Code] = "2200"
			    )
			RETURN
			    IF ( ISBLANK ( _Interest ), 0, _Interest )
		formatString: "$#,##0,. "
		displayFolder: Expenses
		lineageTag: b2555976-06ba-415d-9937-c2f81414f1f0

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the total revenue budget.
	/// 
	measure 'Total Revenue (Budget)' =
			
			VAR RevenueBudget =
			    CALCULATE (
			        - SUM ( 'Fact Finance Budget'[Finance Budget Amount] ),
			        'Fact Finance Budget'[Finance Budget Date] <= TODAY (),
			        'Dim Finance General Ledger Account'[Finance General Ledger Account Hierarchy Second Level Name] = "Total Income"
			    )
			RETURN
			    IF ( ISBLANK ( RevenueBudget ), 0, RevenueBudget )
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Revenue
		lineageTag: 047a7d9d-36ca-48e3-b6d6-b85c589e8b83

		annotation PBI_FormatHint = {"isCustom":true}

	/// Retrieves the actual value based on the selected measure and corresponding actual column.
	/// 
	measure VariableActual =
			
			VAR M =
			    SELECTEDVALUE ( 'InExFrame'[Measure] )
			VAR A =
			    SELECTEDVALUE ( InExFrame[Actual] )
			VAR F =
			    SELECTEDVALUE ( InExFrame[Forecast] )
			VAR V =
			    SELECTEDVALUE ( InExFrame[Variance] )
			VAR PV =
			    SELECTEDVALUE ( InExFrame[%Variance] )
			VAR I =
			    SELECTEDVALUE ( InExFrame[Icon] )
			VAR PY =
			    SELECTEDVALUE ( InExFrame[Previous Year] )
			VAR AF =
			    SELECTEDVALUE ( InExFrame[Annual Forecast] )
			VAR AL =
			    SELECTEDVALUE ( InExFrame[Actual Line] )
			RETURN
			    SWITCH (
			        TRUE (),
			        M = "Total Income"
			            && A = "TR_Actual", FORMAT ( [Total Revenue], "#,##0, ;(#,##0,);-" ),
			        M = "Total Wages"
			            && A = "SW_Actual", FORMAT ( [SalaryWages], "#,##0, ;(#,##0,);-" ),
			        M = "Gross Surplus"
			            && A = "GS_Actual", FORMAT ( [Gross Surplus], "#,##0, ;(#,##0,);-" ),
			        M = "Total Operating Expenses"
			            && A = "TOE_Actual", FORMAT ( [Total Operating Expenses], "#,##0, ;(#,##0,);-" ),
			        M = "Total Operating Surplus"
			            && A = "TOS_Actual", FORMAT ( [EBIT], "#,##0, ;(#,##0,);-" ),
			        M = "Interest Expense"
			            && A = "IE_Actual", FORMAT ( [InterestExpense], "#,##0, ;(#,##0,);-" ),
			        M = "Recharges"
			            && A = "R_Actual", FORMAT ( [Total Recharges], "#,##0, ;(#,##0,);-" ),
			        M = "Depreciation"
			            && A = "D_Actual", FORMAT ( [Total Depreciation], "#,##0, ;(#,##0,);-" ),
			        M = "Net Surplus"
			            && A = "NS_Actual", FORMAT ( [Net Surplus], "#,##0, ;(#,##0,);-" ),
			        M = "Net Margin"
			            && A = "NM_Actual", FORMAT ( [Net Surplus Margin], "0.0%" )
			    )
		displayFolder: Variable Measures
		lineageTag: 9bab054b-d6fa-486a-8617-c957f76fcac3

	/// Retrieves the forecast value based on the selected measure and corresponding forecast column.
	/// 
	measure VariableForecast =
			
			VAR M =
			    SELECTEDVALUE ( 'InExFrame'[Measure] )
			VAR A =
			    SELECTEDVALUE ( InExFrame[Actual] )
			VAR F =
			    SELECTEDVALUE ( InExFrame[Forecast] )
			VAR V =
			    SELECTEDVALUE ( InExFrame[Variance] )
			VAR PV =
			    SELECTEDVALUE ( InExFrame[%Variance] )
			VAR I =
			    SELECTEDVALUE ( InExFrame[Icon] )
			VAR PY =
			    SELECTEDVALUE ( InExFrame[Previous Year] )
			VAR AF =
			    SELECTEDVALUE ( InExFrame[Annual Forecast] )
			VAR AL =
			    SELECTEDVALUE ( InExFrame[Actual Line] )
			RETURN
			    SWITCH (
			        TRUE (),
			        M = "Total Income"
			            && F = "TR_Forecast", FORMAT ( [Total Revenue (Budget)], "#,##0, ;(#,##0,);-" ),
			        M = "Total Wages"
			            && F = "SW_Forecast", FORMAT ( [SalaryWages Budget], "#,##0, ;(#,##0,);-" ),
			        M = "Gross Surplus"
			            && F = "GS_Forecast", FORMAT ( [Gross Surplus Budget], "#,##0, ;(#,##0,);-" ),
			        M = "Total Operating Expenses"
			            && F = "TOE_Forecast", FORMAT ( [Total Operating Expenses Budget], "#,##0, ;(#,##0,);-" ),
			        M = "Total Operating Surplus"
			            && F = "TOS_Forecast", FORMAT ( [EBIT Budget], "#,##0, ;(#,##0,);-" ),
			        M = "Interest Expense"
			            && F = "IE_Forecast", FORMAT ( [InterestExpense Budget], "#,##0, ;(#,##0,);-" ),
			        M = "Depreciation"
			            && F = "D_Forecast", FORMAT ( [Total Depreciation Budget], "#,##0, ;(#,##0,);-" ),
			        M = "Recharges"
			            && F = "R_Forecast", FORMAT ( [Total Recharges Budget], "#,##0, ;(#,##0,);-" ),
			        M = "Net Surplus"
			            && F = "NS_Forecast", FORMAT ( [Net Surplus Budget], "#,##0, ;(#,##0,);-" ),
			        M = "Net Margin"
			            && F = "NM_Forecast", FORMAT ( [Net Margin Budget], "0.0%" )
			    )
		displayFolder: Variable Measures
		lineageTag: 40c68ac1-eec0-4970-a7e7-f651b43e9e39

	/// Calculates the gross surplus budget by subtracting SalaryWages Budget from Total Revenue (Budget).
	/// 
	measure 'Gross Surplus Budget' =
			
			[Total Revenue (Budget)] - [SalaryWages Budget]
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Gross Surplus
		lineageTag: c2bbe2f8-06ca-4700-bdaf-c7a52dc19a25

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the EBIT budget by subtracting Total Operating Expenses Budget, InterestExpense Budget, and Total Depreciation Budget from Gross Surplus Budget.
	/// 
	measure 'EBIT Budget' =
			
			[Gross Surplus Budget] - [Total Operating Expenses Budget] - [InterestExpense Budget] - [Total Depreciation Budget]
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Expenses
		lineageTag: 3a16026e-983e-4b26-8ccf-02c92d0b09f7

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the interest expense budget.
	/// 
	measure 'InterestExpense Budget' =
			
			VAR _Interest =
			    CALCULATE (
			        SUM ( 'Fact Finance Budget'[Finance Budget Amount] ),
			        FILTER (
			            'Fact Finance Budget',
			            'Fact Finance Budget'[Finance Budget Date] <= TODAY ()
			        ),
			        'Dim Finance General Ledger Account'[Finance General Ledger Account Hierarchy Fourth Level Code] = "2200"
			    )
			RETURN
			    IF ( ISBLANK ( _Interest ), 0, _Interest )
		formatString: "$#,##0,. "
		displayFolder: Expenses
		lineageTag: f750cb35-bf1d-4eb6-9496-f9f164244ce2

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the total depreciation budget.
	/// 
	measure 'Total Depreciation Budget' =
			
			VAR _Depreciation =
			    CALCULATE (
			        SUM ( 'Fact Finance Budget'[Finance Budget Amount] ),
			        FILTER (
			            'Fact Finance Budget',
			            'Fact Finance Budget'[Finance Budget Date] <= TODAY ()
			        ),
			        'Dim Finance General Ledger Account'[Finance General Ledger Account Hierarchy Fourth Level Code] = "2600"
			    )
			RETURN
			    IF ( ISBLANK ( _Depreciation ), 0, _Depreciation )
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Depreciation
		lineageTag: d7f0a891-bca3-4c95-9610-34609539c052

		annotation PBI_FormatHint = {"isCustom":true}

	/// Retrieves the variance value based on the selected measure and corresponding variance column.
	/// 
	measure VariableVariance =
			
			VAR M =
			    SELECTEDVALUE ( 'InExFrame'[Measure] )
			VAR A =
			    SELECTEDVALUE ( InExFrame[Actual] )
			VAR F =
			    SELECTEDVALUE ( InExFrame[Forecast] )
			VAR V =
			    SELECTEDVALUE ( InExFrame[Variance] )
			VAR PV =
			    SELECTEDVALUE ( InExFrame[%Variance] )
			VAR I =
			    SELECTEDVALUE ( InExFrame[Icon] )
			VAR PY =
			    SELECTEDVALUE ( InExFrame[Previous Year] )
			VAR AF =
			    SELECTEDVALUE ( InExFrame[Annual Forecast] )
			VAR AL =
			    SELECTEDVALUE ( InExFrame[Actual Line] )
			RETURN
			    SWITCH (
			        TRUE (),
			        M = "Total Income"
			            && V = "TR_Variance", [Total Revenue Variance],
			        M = "Total Wages"
			            && V = "SW_Variance", [Total Salary and Wage Variance],
			        M = "Gross Surplus"
			            && V = "GS_Variance", [Gross Surplus Variance],
			        M = "Total Operating Expenses"
			            && V = "TOE_Variance", [Total Ope Exp Variance],
			        M = "Total Operating Surplus"
			            && V = "TOS_Variance", [EBIT Variance],
			        M = "Interest Expense"
			            && V = "IE_Variance", [Interest Variance],
			        M = "Depreciation"
			            && V = "D_Variance", [Depreciation Variance],
			        M = "Recharges"
			            && V = "R_Variance", [Total Recharges variance$],
			        M = "Net Surplus"
			            && V = "NS_Variance", [Net Surplus Variance$]
			    )
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Variable Measures
		lineageTag: c2879c02-87d2-4e81-8fec-b1483877af74

		annotation PBI_FormatHint = {"isCustom":true}

	/// Calculates the variance percentage based on the selected measure and corresponding actual and forecast values.
	/// 
	measure VariableVariancePercentage =
			
			VAR M =
			    SELECTEDVALUE ( 'InExFrame'[Measure] )
			VAR A =
			    SELECTEDVALUE ( InExFrame[Actual] )
			VAR F =
			    SELECTEDVALUE ( InExFrame[Forecast] )
			VAR V =
			    SELECTEDVALUE ( InExFrame[Variance] )
			VAR PV =
			    SELECTEDVALUE ( InExFrame[%Variance] )
			VAR I =
			    SELECTEDVALUE ( InExFrame[Icon] )
			VAR PY =
			    SELECTEDVALUE ( InExFrame[Previous Year] )
			VAR AF =
			    SELECTEDVALUE ( InExFrame[Annual Forecast] )
			VAR AL =
			    SELECTEDVALUE ( InExFrame[Actual Line] )
			RETURN
			    SWITCH (
			        TRUE (),
			        M = "Total Income"
			            && PV = "TR_%Variance",
			            [Total Revenue] / [Total Revenue (Budget)] - 1,
			        M = "Total Wages"
			            && PV = "SW_%Variance",
			            [SalaryWages Budget] / [SalaryWages] - 1,
			        M = "Gross Surplus"
			            && PV = "GS_%Variance",
			            [Gross Surplus] / [Gross Surplus Budget] - 1,
			        M = "Total Operating Expenses"
			            && PV = "TOE_%Variance",
			            [Total Operating Expenses Budget] / [Total Operating Expenses] - 1,
			        M = "Total Operating Surplus"
			            && PV = "TOS_%Variance",
			            [EBIT] / [EBIT Budget] - 1,
			        M = "Interest Expense"
			            && PV = "IE_%Variance",
			            [InterestExpense Budget] / [InterestExpense] - 1,
			        M = "Depreciation"
			            && PV = "D_%Variance",
			            [Total Depreciation Budget] / [Total Depreciation] - 1,
			        M = "Recharges"
			            && PV = "R_%Variance", [Total Recharge variance%],
			        M = "Net Surplus"
			            && PV = "NS_%Variance",
			            [Net Surplus] / [Net Surplus Budget] - 1
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Variable Measures
		lineageTag: d18a71f5-8c3d-4c13-9cfa-4829f6dac21a

	/// Calculates the net surplus budget by adding InterestExpense Budget and Total Depreciation Budget to EBIT Budget.
	/// 
	measure 'Net Surplus Budget' =
			
			[Total Revenue (Budget)] - [Total Expenses Budget]
			//[EBIT Budget]+[InterestExpense Budget]+[Total Depreciation Budget]
		formatString: "#,##0,. ;(#,##0,.);- "
