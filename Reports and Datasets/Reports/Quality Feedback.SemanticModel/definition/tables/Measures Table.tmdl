	/// Calculates the total controllable expenses budget.
	/// 
	measure 'Controllable Expenses Budget' =
			
			VAR _Controllable =
			    CALCULATE (
			        SUM ( 'Fact Finance Budget'[Finance Budget Amount] ),
			        'Dim Finance General Ledger Account'[Finance General Ledger Account Code]
			            IN {
			                2060,
			                2095,
			                2110,
			                2115,
			                2140,
			                2150,
			                2160,
			                2170,
			                2230,
			                2240,
			                2260,
			                2270,
			                2300,
			                2310,
			                2350,
			                2370,
			                2390,
			                2411,
			                2412,
			                2420,
			                2430,
			                2440
			            }
			    )
			RETURN
			    IF ( ISBLANK ( _Controllable ), 0, _Controllable )
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Budget
		lineageTag: 71bdf03a-37b4-481b-bca4-6d470f552f32

		annotation PBI_FormatHint = {"isCustom":true}

