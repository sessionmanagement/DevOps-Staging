	/// Calculates the year-to-date variance amount between actual and budget amounts based on the selected account hierarchy level.
	/// 
	measure 'Variance $ YTD' = ```
			
			VAR __Val =
			    SELECTEDVALUE ( 'Dim Finance General Ledger Account'[Finance General Ledger Account Hierarchy Second Level Name] )
			VAR __Rev = [Actual Amount Less Than Today YTD] - [Budget Amount Less Than Today YTD] -- Jay - 2023-06-15 : A positive outcome of the above equation is a favourable (positive) result and should be represented in an upward arrow and the % positive A negative outcome is unfavourable (negative) and  should be represented by a downward arrow and the % should be negative */
			VAR __Exp = [Budget Amount Less Than Today YTD] - [Actual Amount Less Than Today YTD] -- Jay - 2023-06-15 : If the outcome is negative then it’s unfavourable (negative) and should be represented in a downward arrow and % should be a negative value.  If the outcome is positive then is favourable (positive) and should be represented in an upward arrow and the % be a positive value. 
			RETURN
			    IF ( __Val = "Total Expenses", __Exp, __Rev )
			```
		formatString: "#,##0,. ;(#,##0,.);- "
		displayFolder: Variance
		lineageTag: 8e2d72cd-b917-4b56-b01a-7fbe5809b381

