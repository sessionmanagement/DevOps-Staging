	column EthnicityGroups =
			SWITCH(
				TRUE,
				ISBLANK('Feedback Register'[Client Ethnicity (Primary)]),
				"(Blank)",
				'Feedback Register'[Client Ethnicity (Primary)] IN {"European nfd",
					"N Z European Pakeha",
					"NZ Euro",
					"NZ European Pakeha"},
				"European",
				'Feedback Register'[Client Ethnicity (Primary)] IN {"Maori"},
				"Maori",
				'Feedback Register'[Client Ethnicity (Primary)] IN {"Samoan",
					"Tongan"},
				"Pasifika",
				"Other"
			)
		lineageTag: f24845be-c7d5-4ec6-be61-e3112d4fa1c6
		summarizeBy: none

		extendedProperty GroupingMetadata =
				{
				  "version": 0,
				  "groupedColumns": [
				    {
				      "Column": {
				        "Expression": {
				          "SourceRef": {
				            "Entity": "Feedback Register"
				          }
				        },
				        "Property": "Client Ethnicity (Primary)"
				      }
				    }
				  ]
				}

		annotation GroupingDesignState = {"Version":0,"Sources":[{"Name":"f","Entity":"Feedback Register"}],"GroupedColumns":[{"Column":{"Expression":{"SourceRef":{"Source":"f"}},"Property":"Client Ethnicity (Primary)"}}],"GroupItems":[{"DisplayName":"(Blank)","BlankDefaultPlaceholder":true},{"DisplayName":"European","Expression":{"In":{"Expressions":[{"Column":{"Expression":{"SourceRef":{"Source":"f"}},"Property":"Client Ethnicity (Primary)"}}],"Values":[[{"Literal":{"Value":"'European nfd'"}}],[{"Literal":{"Value":"'N Z European Pakeha'"}}],[{"Literal":{"Value":"'NZ Euro'"}}],[{"Literal":{"Value":"'NZ European Pakeha'"}}]]}}},{"DisplayName":"Maori","Expression":{"In":{"Expressions":[{"Column":{"Expression":{"SourceRef":{"Source":"f"}},"Property":"Client Ethnicity (Primary)"}}],"Values":[[{"Literal":{"Value":"'Maori'"}}]]}}},{"DisplayName":"Pasifika","Expression":{"In":{"Expressions":[{"Column":{"Expression":{"SourceRef":{"Source":"f"}},"Property":"Client Ethnicity (Primary)"}}],"Values":[[{"Literal":{"Value":"'Samoan'"}}],[{"Literal":{"Value":"'Tongan'"}}]]}}},{"DisplayName":"Other"}]}

		annotation SummarizationSetBy = Automatic

