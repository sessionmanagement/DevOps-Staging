	column Month_No = ```
			
			VAR Month1 = MONTH('fact_pay_run'[pay_period_start_date])
			
			VAR Month2 = MONTH('fact_pay_run'[pay_period_end_date])
			
			VAR EndMonth1 = EOMONTH('fact_pay_run'[pay_period_start_date], 0)
			VAR Month1Days = IF(Month1 <> Month2, DATEDIFF('fact_pay_run'[pay_period_start_date], EndMonth1, DAY), 
			                        DATEDIFF('fact_pay_run'[pay_period_start_date], 'fact_pay_run'[pay_period_end_date], DAY))
			
			VAR Month2Days = DAY('fact_pay_run'[pay_period_end_date])
			
			RETURN
			
			IF(Month1 = Month2, Month1,
			    IF(Month1Days >= Month2Days, 
			            Month1,Month2 ) )
			```
		formatString: 0
