table fact_pay_run
	lineageTag: c180c851-55f0-496b-b560-efafacd6e838

	/// Total hours across all pay components
	measure 'Total Hours' = CALCULATE(SUM(fact_pay_run[Total_Hours]) ) //, fact_pay_run[pay_component_name] IN {"Ordinary Pay","Addtional Hours"} ))
		formatString: #,##0.00
		displayFolder: Core Metrics
		lineageTag: e5513e34-442d-46f6-adbe-97e351bacec8

	/// Total FTE
	measure 'Total FTE' = DIVIDE(DIVIDE([Total Hours],80),[Unique Pay Periods])
		formatString: #,##0.00
		displayFolder: Core Metrics
		lineageTag: 8e11a845-29c2-4e18-9e37-c5cf63d0be4e

	/// The most recent pay period end date in the data
	measure 'Latest Pay Period End' = MAX(fact_pay_run[pay_period_end_date])
		formatString: dd/mm/yyyy
		displayFolder: Core Metrics
		lineageTag: e86f39f9-9939-418a-a3d5-fe7d609ffa4e

	/// The start date of the most recent pay period
	measure 'Latest Pay Period Start' = ```
			CALCULATE( MIN(fact_pay_run[pay_period_start_date])
			//, fact_pay_run[pay_period_end_date] = [Latest Pay Period End] 
			)
			```
		formatString: dd/mm/yyyy
		displayFolder: Core Metrics
		lineageTag: a11c5a3d-1df2-46e5-bc8b-5ade3a0b1c94

	/// Number of distinct casual employees active in the selected pay periods and selected service hierarchy
	measure 'Casual Employee Count' =
			VAR SelectedPayPeriodEndDates =
			    CALCULATETABLE ( VALUES ( fact_pay_run[pay_period_end_date] ), REMOVEFILTERS ( Dim_Employee ) )
			RETURN
			    COUNTROWS (
			        FILTER (
			            CALCULATETABLE (
			                VALUES ( Dim_Employee[employee_id] ),
			                KEEPFILTERS ( Dim_Employee[employee_work_type] = "Temporary/Casual" )
			            ),
			            VAR EmployeeStartDate =
			                CALCULATE ( MIN ( Dim_Employee[employee_company_start_date] ) )
			            VAR EmployeeEndDate =
			                CALCULATE ( MAX ( Dim_Employee[employee_company_end_date] ) )
			            RETURN
			                [Employee Matches Selected Service Filter] = 1
			                    && COUNTROWS (
			                        FILTER (
			                            SelectedPayPeriodEndDates,
			                            fact_pay_run[pay_period_end_date] >= EmployeeStartDate
			                                && (
			                                    ISBLANK ( EmployeeEndDate )
			                                        || fact_pay_run[pay_period_end_date] <= EmployeeEndDate
			                                )
			                        )
			                    ) > 0
			        )
			    )
		formatString: 0
		displayFolder: Casual Analysis
		lineageTag: 44ab072a-a87a-4c03-8c12-b50afa9fdcc0

	/// Number of active casual employees with no hours in the selected pay periods and selected service hierarchy
	measure 'Casuals Not Worked' =
			VAR SelectedPayPeriodEndDates =
			    CALCULATETABLE ( VALUES ( fact_pay_run[pay_period_end_date] ) )
			VAR ActiveCasualEmployees =
			    FILTER (
			        CALCULATETABLE (
			            VALUES ( Dim_Employee[employee_id] ),
			            KEEPFILTERS ( Dim_Employee[employee_work_type] = "Temporary/Casual" )
			        ),
			        VAR EmployeeStartDate =
			            CALCULATE ( MIN ( Dim_Employee[employee_company_start_date] ) )
			        VAR EmployeeEndDate =
			            CALCULATE ( MAX ( Dim_Employee[employee_company_end_date] ) )
			        RETURN
			            [Employee Matches Selected Service Filter] = 1
			                && COUNTROWS (
			                    FILTER (
			                        SelectedPayPeriodEndDates,
			                        fact_pay_run[pay_period_end_date] >= EmployeeStartDate
			                            && (
			                                ISBLANK ( EmployeeEndDate )
			                                    || fact_pay_run[pay_period_end_date] <= EmployeeEndDate
			                            )
			                    )
			                ) > 0
			    )
			VAR WorkedCasualEmployees =
			    FILTER (
			        ActiveCasualEmployees,
			        CALCULATE ( [Employee Hours] ) > 0
			    )
			RETURN
			    COALESCE ( COUNTROWS ( EXCEPT ( ActiveCasualEmployees, WorkedCasualEmployees ) ), 0 )
		formatString: 0
		displayFolder: Casual Analysis
		lineageTag: 9911d079-541f-4b4c-bc1f-8b8aa2e549cc

	/// Number of active casual employees who worked in the selected pay periods and selected service hierarchy
	measure 'Casuals Worked' =
			VAR SelectedPayPeriodEndDates =
			    CALCULATETABLE ( VALUES ( fact_pay_run[pay_period_end_date] ) )
			VAR ActiveCasualEmployees =
			    FILTER (
			        CALCULATETABLE (
			            VALUES ( Dim_Employee[employee_id] ),
			            KEEPFILTERS ( Dim_Employee[employee_work_type] = "Temporary/Casual" )
			        ),
			        VAR EmployeeStartDate =
			            CALCULATE ( MIN ( Dim_Employee[employee_company_start_date] ) )
			        VAR EmployeeEndDate =
			            CALCULATE ( MAX ( Dim_Employee[employee_company_end_date] ) )
			        RETURN
			            [Employee Matches Selected Service Filter] = 1
			                && COUNTROWS (
			                    FILTER (
			                        SelectedPayPeriodEndDates,
			                        fact_pay_run[pay_period_end_date] >= EmployeeStartDate
			                            && (
			                                ISBLANK ( EmployeeEndDate )
			                                    || fact_pay_run[pay_period_end_date] <= EmployeeEndDate
			                            )
			                    )
			                ) > 0
			    )
			RETURN
			    COUNTROWS (
			        FILTER (
			            ActiveCasualEmployees,
			            CALCULATE ( [Employee Hours] ) > 0
			        )
			    )
		formatString: #,##0
		displayFolder: Casual Analysis
		lineageTag: bb76ed40-75f2-4c93-859a-d971a9e0c0b2

	/// Count of distinct employees whose longest fortnight worked in the selected period is 96 hours or more
	measure 'Employees Over 96 Hours' =
			COUNTROWS (
			    FILTER (
			        VALUES ( Dim_Employee[employee_id] ),
			        [Longest Fortnight Worked] >= 96
			    )
			)
		formatString: #,##0
		displayFolder: Hours Compliance
		lineageTag: af9239fb-b507-4921-9c4a-981621d2baea

	/// Average total hours per employee in the current filter context
	measure 'Avg Hours Per Employee' = DIVIDE( [Total Hours], [Employees Worked], 0 )
		formatString: #,##0.0
		displayFolder: Core Metrics
		lineageTag: b38f83d3-0082-4dee-8206-6b2330a2e28b

	/// Maximum hours worked by any single employee in the current filter context
	measure 'Max Hours by Employee' =
			
			MAXX (
			    SUMMARIZE (
			        fact_pay_run,
			        fact_pay_run[pay_period_start_date],
			        fact_pay_run[employee_id],
			        "TotalHoursWorked",
			        SUM(fact_pay_run[Total_Hours])
			    ),
			    [TotalHoursWorked]
			)
			//MAXX(
			//     VALUES(fact_pay_run[employee_id]),
			//     CALCULATE( SUM(fact_pay_run[Hours]) )
			// ))
		formatString: #,##0.00
		displayFolder: Hours Compliance
		lineageTag: 24ab023b-2ed3-4e9f-8b88-aed8c756b1f9

	/// Count of distinct employees whose longest fortnight worked in the selected period is more than 88 hours and less than 96 hours
	measure 'Employees Over 88 Hours' =
			COUNTROWS (
			    FILTER (
			        VALUES ( Dim_Employee[employee_id] ),
			        [Longest Fortnight Worked] >= 88
			            && [Longest Fortnight Worked] < 96
			    )
			)
		formatString: #,##0
		displayFolder: Hours Compliance
		lineageTag: 63b2eaec-642c-4748-9367-0b58f4082404

	/// Count of distinct pay periods in the current filter context
	measure 'Unique Pay Periods' = DISTINCTCOUNT(fact_pay_run[pay_period_end_date])
		formatString: #,##0
		displayFolder: Core Metrics
		lineageTag: 06340daf-1cac-467e-ac59-ee6bd99d5292

	/// Percentage of workforce that are casual employees in the selected pay periods
	measure 'Casual % of Workforce' =
			VAR SelectedPayPeriodEndDates =
			    CALCULATETABLE ( VALUES ( fact_pay_run[pay_period_end_date] ), REMOVEFILTERS ( Dim_Employee ) )
			VAR ActiveEmployees =
			    COUNTROWS (
			        FILTER (
			            VALUES ( Dim_Employee[employee_id] ),
			            VAR EmployeeStartDate =
			                CALCULATE ( MIN ( Dim_Employee[employee_company_start_date] ) )
			            VAR EmployeeEndDate =
			                CALCULATE ( MAX ( Dim_Employee[employee_company_end_date] ) )
			            RETURN
			                [Employee Matches Selected Service Filter] = 1
			                    && COUNTROWS (
			                    FILTER (
			                        SelectedPayPeriodEndDates,
			                        fact_pay_run[pay_period_end_date] >= EmployeeStartDate
			                            && (
			                                ISBLANK ( EmployeeEndDate )
			                                    || fact_pay_run[pay_period_end_date] <= EmployeeEndDate
			                            )
			                    )
			                ) > 0
			        )
			    )
			RETURN
			    DIVIDE ( [Casual Employee Count], ActiveEmployees, 0 )
		formatString: 0.0%
		displayFolder: Casual Analysis
		lineageTag: 9c231f11-b9e4-43f2-be14-b2efc9c94b48

	/// Count of distinct employees who worked in the latest pay period
	measure 'Employees Worked' =
			CALCULATE(
			    DISTINCTCOUNT(fact_pay_run[employee_id]))
		formatString: #,##0
		displayFolder: Core Metrics
		lineageTag: a5104be4-7067-4e2f-8a7f-8607e9ffcb7f

	/// Total hours for each employee in the latest pay period. Use in table visuals.
	measure 'Employee Hours' = ```
			
			   
			CALCULATE(
			        SUM(fact_pay_run[Total_Hours]))
			   
			```
		formatString: #,##0.00
		displayFolder: Hours Compliance
		lineageTag: 9ab44f34-f623-4db4-9cb0-1f361600a44b

	/// Flag for employees who exceeded 96 hours in the latest fortnight
	measure 'Is Over 96 Hours Flag' = IF( [Longest Fortnight Worked] >= 96, 1, 0 )
		formatString: #,##0
		displayFolder: Hours Compliance
		lineageTag: c73d6aeb-ae57-47ef-8d99-87abe6b1328e

	/// Total rostered/budgeted FTE from position roster
	measure 'Rostered FTE' = ```
			[Rostered FTE_Manager] + [Rostered FTE_NON-Manager] 
			
			```
		formatString: #,##0.00
		displayFolder: Rostered vs Actual
		lineageTag: 9d77ab6e-7dcc-4e0f-a071-5589e31e5af3

	/// Total rostered hours per week from position roster
	measure 'Rostered Hours PW' = SUMX( fact_position_roster, VALUE( fact_position_roster[hours] ) ) / 4
		formatString: #,##0.00
		displayFolder: Rostered vs Actual
		lineageTag: bd2e2933-1124-4b76-866c-9acab243e476

	/// Total allocated FTE from position roster
	measure 'Rostered Allocated FTE' = SUMX( fact_position_roster, VALUE( fact_position_roster[allocated_fte] ) )
		formatString: #,##0.00
		displayFolder: Rostered vs Actual
		lineageTag: b50edf2d-5c6d-43ad-a78c-c609c7a9a4b5

	/// Count of rostered positions
	measure 'Rostered Positions' = COUNTROWS( fact_position_roster )
		formatString: #,##0
		displayFolder: Rostered vs Actual
		lineageTag: e8f1aa8e-f92a-4ced-a585-2dc41e6cfcd3

	/// Total actual FTE from the most recent pay period
	measure 'Actual FTE' =
			CALCULATE( [Total FTE]
			//, fact_pay_run[pay_period_end_date] = [Latest Pay Period End]
			 )
		formatString: #,##0.00
		displayFolder: Rostered vs Actual
		lineageTag: f61e109a-95a7-4181-a2e0-bffb76a5a388

	/// Total actual hours from the most recent pay period
	measure 'Actual Hours (Latest Period)' =
			CALCULATE( [Total Hours]
			//, fact_pay_run[pay_period_end_date] = CALCULATE( MAX( fact_pay_run[pay_period_end_date] ), REMOVEFILTERS() )
			 )
		formatString: #,##0.00
		displayFolder: Rostered vs Actual
		lineageTag: ca595c17-9291-46fd-80d3-c0d43ebd908f

	/// Difference between actual FTE (latest period) and rostered FTE. Positive = overstaffed, Negative = understaffed
	measure 'FTE Variance' = [Actual FTE] - [Rostered FTE]
		formatString: +#,##0.00;-#,##0.00;0.00
		displayFolder: Rostered vs Actual
		lineageTag: 3bf8f73e-90bd-4654-ba13-9bfcc8fde081

	/// Percentage of rostered FTE positions filled (Actual / Rostered)
	measure 'FTE Fill Rate %' = DIVIDE( [Actual FTE], [Rostered FTE], 0 )
		formatString: 0.0%
		displayFolder: Rostered vs Actual
		lineageTag: ec0734e1-b994-4f00-b3f6-4fe478c59075

	/// Actual hours per week from latest fortnightly pay period (Total / 2)
	measure 'Actual Hours PW (Latest Period)' = ```
			[Total Hours] 
			
			//DIVIDE( [Actual Hours (Latest Period)], 2, 0 )
			```
		formatString: #,##0.00
		displayFolder: Rostered vs Actual
		lineageTag: 34eb7dfd-7fde-4828-aa49-41cf4832dc1a

	/// Difference between actual weekly hours and rostered weekly hours. Positive = over-utilised, Negative = under-utilised
	measure 'Hours Variance PW' = [Actual Hours PW (Latest Period)] - [Rostered Hours PW]
		formatString: +#,##0.00;-#,##0.00;0.00
		displayFolder: Rostered vs Actual
		lineageTag: 1c327f66-c365-4c71-9346-eeca21caa78a

	/// Percentage of rostered hours utilised (Actual weekly / Rostered weekly)
	measure 'Hours Utilisation %' = DIVIDE( [Actual Hours PW (Latest Period)], [Rostered Hours PW], 0 )
		formatString: 0.0%
		displayFolder: Rostered vs Actual
		lineageTag: 2cbc3420-bda9-4d28-8cea-6b2fc3a107b3

	measure 'Rostered FTE_Manager' =
			
			CALCULATE(
			    DIVIDE(SUMX(
			        fact_position_roster,
			        VALUE(fact_position_roster[hours_pw])
			    ),40),
			    FILTER(
			        fact_position_roster,
			        CONTAINSSTRING(fact_position_roster[position_description], "Manager")
			    )
			)
		displayFolder: Rostered vs Actual
		lineageTag: 2384fc3d-a18a-4322-be93-a32462de418c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Rostered FTE_NON-Manager' =
			
			CALCULATE(
			    SUMX(
			        fact_position_roster,
			        VALUE(fact_position_roster[fte_pa])
			    ),
			    FILTER(
			        fact_roster,
			        CONTAINSSTRING(fact_roster[roster_shifts], "Total")
			    )
			)
		displayFolder: Rostered vs Actual
		lineageTag: 5545a5d7-74ff-4aea-b1cd-f2805604a809

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Count of employee fortnights in the selected period where worked hours were 96 or more
	measure 'Number of 96+ hour fortnights' =
			VAR SummaryTable =
			    SUMMARIZE (
			        fact_pay_run,
			        fact_pay_run[pay_period_start_date],
			        fact_pay_run[employee_id],
			        "TotalHoursWorked",
			            CALCULATE (
			                SUM ( fact_pay_run[Total_Hours] ),
			                fact_pay_run[pay_component_name] IN {
			                    "Ordinary Pay",
			                    "Addtional Hours",
			                    "Overtime"
			                }
			            )
			    )
			RETURN
			    COUNTROWS ( FILTER ( SummaryTable, [TotalHoursWorked] >= 96 ) )
		formatString: 0
		displayFolder: Hours Compliance
		lineageTag: fec42ae8-704f-42f6-b8aa-08df61994da8

	measure 'Longest Fortnight Worked' = ```
			
			MAXX (
			    SUMMARIZE (
			        fact_pay_run,
			        fact_pay_run[pay_period_start_date],
			        fact_pay_run[employee_id],
			        "TotalHoursWorked",
			        CALCULATE (
			                    SUM ( fact_pay_run[Total_Hours] ),
			                    fact_pay_run[pay_component_name] IN {
			                        "Ordinary Pay",
			                        "Addtional Hours",
			                        "Overtime"
			                    }
			                )
			    ),
			    [TotalHoursWorked]
			)
			
			
			```
		formatString: 0.0
		displayFolder: Hours Compliance
		lineageTag: 608d0c4a-8c6f-4a58-9cc2-a4029e73cc95

	measure 'Casual worked Flag' = IF( [Employee Hours] > 0, 1, 0 )
		formatString: 0
		displayFolder: Casual Analysis
		lineageTag: 9705f37f-a48f-4962-b778-c8c6c53ecc9e

	/// Count of active casual employees associated with the current service who worked in the selected pay periods
	measure 'Casuals Worked by Service' =
			VAR SelectedPayPeriodEndDates =
			    CALCULATETABLE ( VALUES ( fact_pay_run[pay_period_end_date] ), REMOVEFILTERS ( Dim_Employee ) )
			VAR ActiveCasualEmployeesInDept =
			    FILTER (
			        CALCULATETABLE (
			            VALUES ( Dim_Employee[employee_id] ),
			            KEEPFILTERS ( Dim_Employee[employee_work_type] = "Temporary/Casual" )
			        ),
			        VAR EmployeeStartDate =
			            CALCULATE ( MIN ( Dim_Employee[employee_company_start_date] ) )
			        VAR EmployeeEndDate =
			            CALCULATE ( MAX ( Dim_Employee[employee_company_end_date] ) )
			        RETURN
			            CALCULATE ( [Employee Matches Selected Service Filter] ) = 1
			                && COUNTROWS (
			                    FILTER (
			                        SelectedPayPeriodEndDates,
			                        fact_pay_run[pay_period_end_date] >= EmployeeStartDate
			                            && (
			                                ISBLANK ( EmployeeEndDate )
			                                    || fact_pay_run[pay_period_end_date] <= EmployeeEndDate
			                            )
			                    )
			                ) > 0
			    )
			VAR WorkedCasualEmployeesInDept =
			    FILTER (
			        ActiveCasualEmployeesInDept,
			        CALCULATE ( [Employee Hours] ) > 0
			    )
			RETURN
			    COALESCE ( COUNTROWS ( WorkedCasualEmployeesInDept ), 0 )
		formatString: #,##0
		displayFolder: Casual Analysis
		lineageTag: 0d471141-4d06-47bd-8691-fbc621af901b

	/// Count of active casual employees associated with the current service who did not work in the selected pay periods
	measure 'Casuals Not Worked by Service' =
			VAR SelectedPayPeriodEndDates =
			    CALCULATETABLE ( VALUES ( fact_pay_run[pay_period_end_date] ), REMOVEFILTERS ( Dim_Employee ) )
			VAR ActiveCasualEmployeesInDept =
			    FILTER (
			        CALCULATETABLE (
			            VALUES ( Dim_Employee[employee_id] ),
			            KEEPFILTERS ( Dim_Employee[employee_work_type] = "Temporary/Casual" )
			        ),
			        VAR EmployeeStartDate =
			            CALCULATE ( MIN ( Dim_Employee[employee_company_start_date] ) )
			        VAR EmployeeEndDate =
			            CALCULATE ( MAX ( Dim_Employee[employee_company_end_date] ) )
			        RETURN
			            CALCULATE ( [Employee Matches Selected Service Filter] ) = 1
			                && COUNTROWS (
			                    FILTER (
			                        SelectedPayPeriodEndDates,
			                        fact_pay_run[pay_period_end_date] >= EmployeeStartDate
			                            && (
			                                ISBLANK ( EmployeeEndDate )
			                                    || fact_pay_run[pay_period_end_date] <= EmployeeEndDate
			                            )
			                    )
			                ) > 0
			    )
			VAR WorkedCasualEmployeesInDept =
			    FILTER (
			        ActiveCasualEmployeesInDept,
			        CALCULATE ( [Employee Hours] ) > 0
			    )
			RETURN
			    COALESCE ( COUNTROWS ( EXCEPT ( ActiveCasualEmployeesInDept, WorkedCasualEmployeesInDept ) ), 0 )
		formatString: #,##0
		displayFolder: Casual Analysis
		lineageTag: 25cd5088-edf0-4c66-bf5d-362bd9c07d7a

	measure 'Casual hours worked' =
			VAR SelectedBusinessUnits =
			    CALCULATETABLE (
			        VALUES ( Dim_Employee[employee_Business_unit_name] ),
			        ALLSELECTED ( Dim_Employee[employee_Business_unit_name] ),
			        REMOVEFILTERS ( Dim_Employee[employee_id] ),
			        REMOVEFILTERS ( Dim_Employee[employee_name] ),
			        REMOVEFILTERS ( Dim_Employee[employee_job_name] )
			    )
			VAR AllBusinessUnitsInContext =
			    CALCULATETABLE (
			        VALUES ( Dim_Employee[employee_Business_unit_name] ),
			        REMOVEFILTERS ( Dim_Employee[employee_Business_unit_name] ),
			        REMOVEFILTERS ( Dim_Employee[employee_id] ),
			        REMOVEFILTERS ( Dim_Employee[employee_name] ),
			        REMOVEFILTERS ( Dim_Employee[employee_job_name] )
			    )
			VAR HasBusinessUnitSelection =
			    COUNTROWS ( EXCEPT ( SelectedBusinessUnits, AllBusinessUnitsInContext ) ) > 0
			        || COUNTROWS ( EXCEPT ( AllBusinessUnitsInContext, SelectedBusinessUnits ) ) > 0
			RETURN
			    IF (
			        HasBusinessUnitSelection,
			        COALESCE (
			            CALCULATE (
			                SUM ( fact_pay_run[Total_Hours] ),
			                REMOVEFILTERS ( Dim_Service ),
			                REMOVEFILTERS ( Dim_Employee[employee_Business_unit_name] ),
			                REMOVEFILTERS ( fact_pay_run[sub_department] ),
			                REMOVEFILTERS ( fact_pay_run[sub_department_code] ),
			                TREATAS ( SelectedBusinessUnits, fact_pay_run[sub_department] )
			            ),
			            0
			        ),
			        COALESCE (
			            CALCULATE (
			                SUM ( fact_pay_run[Total_Hours] ),
			                REMOVEFILTERS ( Dim_Service ),
			                REMOVEFILTERS ( Dim_Employee[employee_Business_unit_name] ),
			                REMOVEFILTERS ( fact_pay_run[sub_department] ),
			                REMOVEFILTERS ( fact_pay_run[sub_department_code] )
			            ),
			            0
			        )
			    )
		displayFolder: Casual Analysis
		lineageTag: 779a4bd4-3b58-4efd-ae6b-b1514b598f9c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Last Shift Worked' =
			CALCULATE(
			    MAX(fact_pay_run[pay_period_end_date]),
			    REMOVEFILTERS(Dim_Date),
			    REMOVEFILTERS(fact_pay_run[pay_period_end_date]),
			    REMOVEFILTERS(fact_pay_run[pay_period_start_date]),
			    fact_pay_run[Total_Hours] > 0
			)
		formatString: Short Date
		displayFolder: Casual Analysis
		lineageTag: cac231c0-859a-4651-a97e-7046ad73cf37

	/// Visual filter helper for employee rows to match the selected Dim_Service hierarchy
	measure 'Employee Matches Selected Service Filter' =
			VAR CurrentEmployeeServiceName =
			    SELECTEDVALUE ( Dim_Employee[employee_Business_unit_name] )
			VAR HasServiceSelection =
			    ISCROSSFILTERED ( Dim_Service[Department Name] )
			        || ISCROSSFILTERED ( Dim_Service[Region Name] )
			        || ISCROSSFILTERED ( Dim_Service[District Name] )
			        || ISCROSSFILTERED ( Dim_Service[Service Name] )
			RETURN
			    IF (
			        NOT HasServiceSelection,
			        1,
			        INT (
			            NOT ISBLANK ( CurrentEmployeeServiceName )
			                && CONTAINS (
			                    VALUES ( Dim_Service[Service Name] ),
			                    Dim_Service[Service Name], CurrentEmployeeServiceName
			                )
			        )
			    )
		formatString: 0
		displayFolder: Casual Analysis
		lineageTag: ade9eefc-169e-495e-bd6d-543d87c39735

	measure 'Number of 88+ hour fortnights' =
			VAR SummaryTable =
			    SUMMARIZE (
			        fact_pay_run,
			        fact_pay_run[pay_period_start_date],
			        fact_pay_run[employee_id],
			        "TotalHoursWorked",
			            CALCULATE (
			                SUM ( fact_pay_run[Total_Hours] ),
			                fact_pay_run[pay_component_name] IN {
			                    "Ordinary Pay",
			                    "Addtional Hours",
			                    "Overtime"
			                }
			            )
			    )
			RETURN
			    COUNTROWS ( FILTER ( SummaryTable, [TotalHoursWorked] >= 88 && [TotalHoursWorked] < 96 ) )
		formatString: 0
		displayFolder: Hours Compliance
		lineageTag: c14e5adc-c5f2-4775-b053-e77536ef4a7f

	/// Total hours worked for the active casual employee set in the current service/sub-department context
	measure 'Casual Hours Worked by Sub Department' =
			VAR SelectedPayPeriodEndDates =
			    CALCULATETABLE ( VALUES ( fact_pay_run[pay_period_end_date] ), REMOVEFILTERS ( Dim_Employee ) )
			VAR ActiveCasualEmployees =
			    FILTER (
			        CALCULATETABLE (
			            VALUES ( Dim_Employee[employee_id] ),
			            KEEPFILTERS ( Dim_Employee[employee_work_type] = "Temporary/Casual" )
			        ),
			        VAR EmployeeStartDate =
			            CALCULATE ( MIN ( Dim_Employee[employee_company_start_date] ) )
			        VAR EmployeeEndDate =
			            CALCULATE ( MAX ( Dim_Employee[employee_company_end_date] ) )
			        RETURN
			            [Employee Matches Selected Service Filter] = 1
			                && COUNTROWS (
			                    FILTER (
			                        SelectedPayPeriodEndDates,
			                        fact_pay_run[pay_period_end_date] >= EmployeeStartDate
			                            && (
			                                ISBLANK ( EmployeeEndDate )
			                                    || fact_pay_run[pay_period_end_date] <= EmployeeEndDate
			                            )
			                    )
			                ) > 0
			    )
			VAR ActiveCasualEmployeeIds =
			    SELECTCOLUMNS ( ActiveCasualEmployees, "employee_id", Dim_Employee[employee_id] )
			RETURN
			    COALESCE (
			        CALCULATE (
			            SUM ( fact_pay_run[Total_Hours] ),
			            TREATAS ( ActiveCasualEmployeeIds, fact_pay_run[employee_id] )
			        ),
			        0
			    )
		formatString: #,##0.0
		displayFolder: Casual Analysis
		lineageTag: 14eec01d-3bd4-49ef-aa25-01fed91f4ec0

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'All business unit hours worked' =
			COALESCE (
			    CALCULATE (
			        SUM ( fact_pay_run[Total_Hours] ),
			        REMOVEFILTERS ( Dim_Service ),
			        REMOVEFILTERS ( fact_pay_run[sub_department] ),
			        REMOVEFILTERS ( fact_pay_run[sub_department_code] ),
			        REMOVEFILTERS ( Dim_Employee[employee_Business_unit_name] )
			    ),
			    0
			)
		formatString: #,##0.00
		displayFolder: Casual Analysis
		lineageTag: 8780daf0-6866-41e4-abd0-7e37ef7d8cf2

	measure 'Avg weekly hours' =
			
			VAR _num_days = NETWORKDAYS(MIN('fact_pay_run'[pay_period_start_date]), MAX( 'fact_pay_run'[pay_period_end_date]), 1)
			
			RETURN
			DIVIDE(SUM('fact_pay_run'[Total_Hours]), _num_days) * 5
		displayFolder: Hours Compliance
		lineageTag: 1d1951be-0e1b-406d-8775-2a58adc09a3f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg weekly FTE' =
			
			VAR _num_days = NETWORKDAYS(MIN('fact_pay_run'[pay_period_start_date]), MAX('fact_pay_run'[pay_period_end_date]), 1)
			VAR _hours = DIVIDE(SUM('fact_pay_run'[Total_Hours]), _num_days) * 5
			RETURN
			
			DIVIDE(_hours, 40)
		displayFolder: Core Metrics
		lineageTag: ad0925c0-c3da-4b0b-a0a0-87a7726a255f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure FiltersApplied = ```
			
			VAR __Year = IF(ISFILTERED(dim_date[calendar_year]), CONCATENATEX(FILTERS(dim_date[calendar_year]), dim_date[calendar_year], ", "), BLANK())
			VAR __Month = IF(ISFILTERED(dim_date[calendar_month_name_short]), CONCATENATEX(FILTERS(dim_date[calendar_month_name_short]), dim_date[calendar_month_name_short], ", "), BLANK())
			
			VAR __ContractType = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(Dim_Employee[employee_work_type]), NOT(ISBLANK(Dim_Employee[employee_work_type]))), Dim_Employee[employee_work_type], ASC),
			    "ContractType_Display", Dim_Employee[employee_work_type]
			)
			
			VAR __ContractTypeCount = IF(ISFILTERED(Dim_Employee[employee_work_type]), COUNTROWS(VALUES(Dim_Employee[employee_work_type])), 0)
			
			VAR __PayPeriods = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(fact_pay_run[pay_period_start_date]), NOT(ISBLANK(fact_pay_run[pay_period_start_date]))), fact_pay_run[pay_period_start_date], ASC),
			    "PayPeriods_Display", fact_pay_run[pay_period_start_date]
			)
			VAR __PayPeriodCount = IF(ISFILTERED(fact_pay_run[pay_period_start_date]), COUNTROWS(VALUES(fact_pay_run[pay_period_start_date])), 0)
			
			
			VAR __Region = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(Dim_Service[Region Name]), NOT(ISBLANK(Dim_Service[Region Name]))), Dim_Service[Region Name], ASC),
			    "Region_display", Dim_Service[Region Name]
			)
			
			VAR __RegionCount = IF(ISFILTERED(Dim_Service[Region Name]), COUNTROWS(VALUES(Dim_Service[Region Name])), 0)
			
			VAR __District = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(Dim_Service[District Name]), NOT(ISBLANK(Dim_Service[District Name]))), Dim_Service[District Name], ASC),
			    "District_display", Dim_Service[District Name]
			)
			
			VAR __DistrictCount = IF(ISFILTERED(Dim_Service[District Name]), COUNTROWS(VALUES(Dim_Service[District Name])), 0)
			
			VAR __Services = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(Dim_Service[Service Name]), NOT(ISBLANK(Dim_Service[Service Name]))), Dim_Service[Service Name], ASC),
			    "Service_display", Dim_Service[Service Name]
			)
			
			VAR __ServiceCount = IF(ISFILTERED(Dim_Service[Service Name]), COUNTROWS(VALUES(Dim_Service[Service Name])), 0)
			
			
			VAR _FC_Year = IF(ISBLANK(__Year), BLANK(), "| YEAR(S) CHOSEN: " & __Year)
			VAR _FC_Month = IF(ISBLANK(__Month), BLANK(), "| MONTH(S) CHOSEN: " & __Month)
			
			VAR _FC_Regions = IF(__RegionCount > 0, "| REGIONS CHOSEN: " & CONCATENATEX(__Region, [Region_display], ", "), BLANK())
			VAR _FC_MoreRegions = IF(__RegionCount > 10, " and " & (__RegionCount - 10) & " more", "")
			
			VAR _FC_Districts = IF(__DistrictCount > 0, "| DISTRICTS CHOSEN: " & CONCATENATEX(__District, [District_display], ", "), BLANK())
			VAR _FC_MoreDistricts = IF(__DistrictCount > 10, " and " & (__DistrictCount - 10) & " more", "")
			
			VAR _FC_Services = IF(__ServiceCount > 0, "| SERVICES CHOSEN: " & CONCATENATEX(__Services, [Service_display], ", "), BLANK())
			VAR _FC_MoreServices = IF(__ServiceCount > 10, " and " & (__ServiceCount - 10) & " more", "")
			
			VAR _FC_ContractType = IF(__ContractTypeCount > 0, "| CONTRACT TYPES CHOSEN: " & CONCATENATEX(__ContractType, [ContractType_Display], ", "), BLANK())
			
			VAR _FC_PayPeriods = IF(__PayPeriodCount > 0, "| PAY PERIODS CHOSEN: " & CONCATENATEX(__PayPeriods, [PayPeriods_Display], ", "), BLANK())
			VAR _FC_MorePayPeriods = IF(__PayPeriodCount > 7, " and " & (__PayPeriodCount - 7) & " more", "")
			
			
			VAR _FirstDate = MIN(dim_date[calendar_date])
			VAR _LastDate = MAX(dim_date[calendar_date])
			
			RETURN
			 "Please note that all data shown is based on the following date range: " & FORMAT(_FirstDate, "dd/MM/YYYY") & " - " & FORMAT(_LastDate, "dd/MM/YYYY") 
			& " " &
			IF(
			    ISBLANK(_FC_Year) && ISBLANK(_FC_Month) && ISBLANK(_FC_Regions) && ISBLANK(_FC_Districts) && ISBLANK(_FC_Services),
			    "",
			    "-- Summary of filters applied to page: " & " " & _FC_Year & " " & _FC_Month & " " & _FC_Regions & _FC_MoreRegions & " " & _FC_Districts & _FC_MoreDistricts & " " & _FC_Services & _FC_MoreServices
			) & _FC_PayPeriods & _FC_MorePayPeriods & _FC_ContractType
			
			```
		lineageTag: a47c932a-873f-4e4b-88ce-531369ac579a

