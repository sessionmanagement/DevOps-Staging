	partition Dim_Employee = m
		mode: import
		queryGroup: 'Final Tables'
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="SELECT de.[dim_employee_key]#(lf)      ,de.[employee_id]#(lf)      ,[employee_name]#(lf)    ,[employee_employment_status]#(lf)      ,[employee_work_type]#(lf)      ,deh.employee_Business_unit_name#(lf)      ,[employee_job_name]#(lf)     ,employee_company_start_date#(lf)     ,employee_company_end_date#(lf)  FROM [edw].[vw_dim_employee] de#(lf)  LEFT JOIN edw.vw_dim_employee_hierarchy deh ON de.employee_id = deh.employee_id#(lf)  WHERE de.DWHIsCurrent = 1#(lf)  AND de.DWHDMLOperation <> 'd' #(lf)  AND de.dim_employee_key > 1#(lf)  AND deh.DWHIsCurrent = 1#(lf)  AND deh.DWHDMLOperation <> 'd'#(lf)  AND (#(lf)    de.employee_company_end_date IS NULL#(lf)    OR de.employee_company_end_date > '2025-08-31'#(lf))#(lf)"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

