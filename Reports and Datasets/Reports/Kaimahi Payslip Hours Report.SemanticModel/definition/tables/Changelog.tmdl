table Changelog
	lineageTag: 0afca447-70d8-4ed5-9567-7ca285ebadae

	measure 'Latest Version' =
			
			VAR LatestChangeID =
			    MAX ( 'Changelog'[Change ID] )
			VAR LatestVersion =
			    MAXX (
			        FILTER ( 'Changelog', 'Changelog'[Change ID] = LatestChangeID ),
			        'Changelog'[Version]
			    )
			RETURN
			    "Payrun Dataset - v" & LatestVersion
		lineageTag: e8a5314e-2eb5-42d4-968a-162519d54629

	column 'Change ID'
		dataType: int64
		formatString: 0
		lineageTag: a8508913-a270-4596-acdb-51eb84722727
		summarizeBy: count
		sourceColumn: Change ID

		annotation SummarizationSetBy = Automatic

	column Version
		dataType: string
		lineageTag: 4a2ff0b5-62ac-41cf-b56f-8cf4aca032aa
		summarizeBy: none
		sourceColumn: Version

		annotation SummarizationSetBy = Automatic

	column 'Change Date'
		dataType: string
		lineageTag: fba2d6b6-ab84-46e1-8052-727f01d8a27a
		summarizeBy: none
		sourceColumn: Change Date

		annotation SummarizationSetBy = Automatic

	column 'Changed By'
		dataType: string
		lineageTag: 4cbc0a6a-b8d5-42b3-bc60-0cfde220f49d
		summarizeBy: none
		sourceColumn: Changed By

		annotation SummarizationSetBy = Automatic

	column 'User Story ID'
		dataType: string
		lineageTag: b8d1bc01-afb6-45cb-a8b0-9e52fb3eb238
		summarizeBy: none
		sourceColumn: User Story ID

		annotation SummarizationSetBy = Automatic

	column Description
		dataType: string
		lineageTag: ec7bb4fd-702b-432b-a8b2-ca76c8e1cd7e
		summarizeBy: none
		sourceColumn: Description

		annotation SummarizationSetBy = Automatic

	partition Changelog = m
		mode: import
		source =
				let
				    // Define the table schema without the ChangeID column
				    InitialTable = #table(
				        {"Version", "Change Date", "Changed By", "User Story ID", "Description"},
				        {
				             {
				                "1.0.0",
				                #date(2026, 06, 23),
				                "Thijs",
				                "13599",
				                "Initial release of Kaimahi Payslip Report"
				            }
				        }
				    ),
				
				    // Add an Index column to generate incremental numbers
				    TableWithIndex = Table.AddIndexColumn(InitialTable, "Change ID", 1, 1, Int64.Type),
				
				    // Reorder the columns to place Change ID first
				    ReorderedColumns = Table.ReorderColumns(
				        TableWithIndex,
				        {"Change ID", "Version", "Change Date", "Changed By", "User Story ID", "Description"}
				    )
				in
				    ReorderedColumns

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

