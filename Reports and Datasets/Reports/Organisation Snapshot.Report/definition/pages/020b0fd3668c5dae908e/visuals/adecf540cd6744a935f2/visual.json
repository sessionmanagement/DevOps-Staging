    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Number of Social Homes",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This measure counts the total number of social housing properties owned for the "
                  },
                  {
                    "value": "entire",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " selected financial year."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "A property is included if:"
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "It was acquired on or before the financial year ended"
                  }
                ],
                "listType": "ordered"
              },
              {
                "textRuns": [
                  {
                    "value": "Its disposal date is different from its acquisition date (to exclude same-day acquisition/disposal errors)"
                  }
                ],
                "listType": "ordered"
              },
              {
                "textRuns": [
                  {
                    "value": "It either hasn't been disposed yet, OR was disposed "
                  },
                  {
                    "value": "after the financial year ended",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  }
                ],
                "listType": "ordered"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Properties disposed of during the financial year are not counted in that year, because they weren't owned for the whole year."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "For example, a property acquired in FY22 and disposed in FY24 would be counted in FY22 and FY23, but not FY24. A property acquired in FY22 that's still owned today would be counted in all subsequent years."
                  }
                ]
              }
            ]
          }
        }
      ]
