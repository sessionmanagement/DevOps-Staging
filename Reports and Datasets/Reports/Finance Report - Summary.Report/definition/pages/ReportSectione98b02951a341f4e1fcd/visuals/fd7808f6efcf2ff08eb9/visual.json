              {
                "textRuns": [
                  {
                    "value": "Welcome to the",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt"
                    }
                  },
                  {
                    "value": " Finance Summary ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#018db1"
                    }
                  },
                  {
                    "value": "Report",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The Finance Summary Report has been developed so that you can easily track how your service(s) financials are tracking. It gives actual vs budget information for your income and salaries and wages costs, operating costs as well as the gross and net surplus of the service(s) managed. "
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The financials shown here are updated overnight and are current as far as payments are concerned but revenue and other accruals are only done at month-end. You can access it at any time from the Te Pātaka Managers Dashboard app link on Te Kete."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Tips and tricks",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "From this "
                  },
                  {
                    "value": "Home ",
                    "textStyle": {
                      "fontStyle": "italic",
                      "color": "#7355a3"
                    }
                  },
                  {
                    "value": "page, you can set filters on the left-hand side - click on the hamburger symbol present on each page for the list of filters to appear."
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "You can click the encircled "
                  },
                  {
                    "value": "X",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " icon at the top of the page to clear any filters on the current page. A list of selected filters is displayed at the bottom of each page for easy printing convenience."
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "You can click the encircled "
                  },
                  {
                    "value": "?",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " icon on the top right of the page to see the training documentation for this report as well as a more in-depth video presentation."
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Orange ",
                    "textStyle": {
                      "color": "#f47c20"
                    }
                  },
                  {
                    "value": "is generally used to indicate that something is negative and needs your attention. "
                  },
                  {
                    "value": "Blue ",
                    "textStyle": {
                      "color": "#018db1"
                    }
                  },
                  {
                    "value": "is generally a positive result."
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Sometimes an arrow might be down but it's in blue - that's because of the context. i.e. expenses being down will be a positive result, however profit being down will be orange."
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Click here",
                    "textStyle": {},
                    "url": "https://servicedesk.emergeaotearoa.org.nz/a/solutions/articles/75000123060"
                  },
                  {
