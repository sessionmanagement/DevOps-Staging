              {
                "textRuns": [
                  {
                    "value": "This report shows information from the Tāngata Whaiora Referrals Report.  This report is designed for self service and gives some examples of tables that may be needed to create bespoke referrals reports.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "In order to simplify the reporting journey, the above report is split up into Active, Received, Declined, Accepted, Discharged, Pending and Waitlisted data.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "For more detailed information on the underlying data that the visuals are built upon, please click the question mark button in the top right-hand corner of any page.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How to use this report:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Download this report onto your desk top.  ",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Right mouse click on to a page you would like to alter.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Choose - duplicate - and like excel, the page will duplicate.",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "When you click on a box (or visual), it will show the values that have been used in the 'Data'.  ",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "All referral data will be included in Fact Tāngata Whaiora Referrals ",
                    "textStyle": {
                      "fontSize": "11pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "All demographics will be included in Dim tables ie Dim Tāngata Whaiora will give you demographics relating to the whaiora.",
