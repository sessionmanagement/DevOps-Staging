                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How to use this report:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "On each page, you can change the filters* rather than doing so by navigating back to this page. To access the filters on these pages, click the menu icon (3 horizontal lines or 'hamburger') on the top right-hand corner. Any changes you make will be reflected on all pages.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "If you wish to reset the filters and set them back to default, you can click the X button in the top right-hand corner from any page",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "At the bottom of each page there is a text box detailing any filters that have explicitly been applied. If nothing is showing for Team Name, for example, it means that ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt"
                    }
                  },
                  {
                    "value": "all",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "textDecoration": "underline"
                    }
                  },
                  {
                    "value": " Team Names are selected, and there is no active filter applied to that field.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt"
                    }
                  }
