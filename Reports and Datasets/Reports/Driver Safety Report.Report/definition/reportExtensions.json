{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/reportExtension/1.0.0/schema.json",
  "name": "extension",
  "entities": [
    {
      "name": "_Report Components",
      "measures": [
        {
          "name": "BI and Reporting Team URL",
          "dataType": "Double",
          "expression": "\n\"https://emergeaotearoaltd.sharepoint.com/sites/ITS2/SitePages/Reporting.aspx\""
        },
        {
          "name": "Help Button URL",
          "dataType": "Double",
          "expression": "\n\"https://ealservicedesk.freshservice.com/a/solutions/articles/75000104496\""
        },
        {
          "name": "Data Last Refreshed",
          "dataType": "Double",
          "expression": "\n\"Data Last Refreshed: \"\n    & FORMAT (\n        LASTDATE ( LastRefreshed[Date Last Refreshed] ),\n        \"dd/MM/YYYY - hh:mm AM/PM\"\n    )"
        }
      ]
    }
  ]
}