expression 'DirectQuery to AS - Tangata Whaiora Dataset' =
		let
		    Source = AnalysisServices.Database("powerbi://api.powerbi.com/v1.0/myorg/GIT%20Testing%20Datasets", "Tangata Whaiora Referral Self Service Dataset"),
		    Cubes = Table.Combine(Source[Data]),
		    Cube = Cubes{[Id="Model", Kind="Cube"]}[Data]
		in
		    Cube
	lineageTag: 5b296804-3076-48be-b6cd-6ff1eda95cd7

	annotation PBI_IncludeFutureArtifacts = True

