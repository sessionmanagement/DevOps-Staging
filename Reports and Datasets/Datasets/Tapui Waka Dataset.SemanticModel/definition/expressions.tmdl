expression rls_employee_emails =
		let
		    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="WITH EmployeeLeaderEmails AS (#(lf)    SELECT #(lf)        [employee_primary_email_address] AS employee_email,#(lf)        [employee_people_leader_email_level_1] AS leader_email#(lf)    FROM #(lf)        [edw].[vw_dim_employee_hierarchy]#(lf)    WHERE #(lf)        DWHIsCurrent = 1#(lf)        AND dim_employee_hierarchy_key > 0#(lf)#(lf)    UNION#(lf)#(lf)    SELECT #(lf)        [employee_primary_email_address] AS employee_email,#(lf)        [employee_people_leader_email_level_2] AS leader_email#(lf)    FROM #(lf)        [edw].[vw_dim_employee_hierarchy]#(lf)    WHERE #(lf)        DWHIsCurrent = 1#(lf)        AND dim_employee_hierarchy_key > 0#(lf)#(lf)    UNION#(lf)#(lf)    SELECT #(lf)        [employee_primary_email_address] AS employee_email,#(lf)        [employee_people_leader_email_level_3] AS leader_email#(lf)    FROM #(lf)        [edw].[vw_dim_employee_hierarchy]#(lf)    WHERE #(lf)        DWHIsCurrent = 1#(lf)        AND dim_employee_hierarchy_key > 0#(lf)#(lf)    UNION#(lf)#(lf)    SELECT #(lf)        [employee_primary_email_address] AS employee_email,#(lf)        [employee_people_leader_email_level_4] AS leader_email#(lf)    FROM #(lf)        [edw].[vw_dim_employee_hierarchy]#(lf)    WHERE #(lf)        DWHIsCurrent = 1#(lf)        AND dim_employee_hierarchy_key > 0#(lf)#(lf)    UNION#(lf)#(lf)    SELECT #(lf)        [employee_primary_email_address] AS employee_email,#(lf)        [employee_people_leader_email_level_5] AS leader_email#(lf)    FROM #(lf)        [edw].[vw_dim_employee_hierarchy]#(lf)    WHERE #(lf)        DWHIsCurrent = 1#(lf)        AND dim_employee_hierarchy_key > 0#(lf)#(lf)    UNION#(lf)#(lf)    SELECT #(lf)        [employee_primary_email_address] AS employee_email,#(lf)        [employee_people_leader_email_level_6] AS leader_email#(lf)    FROM #(lf)        [edw].[vw_dim_employee_hierarchy]#(lf)    WHERE #(lf)        DWHIsCurrent = 1#(lf)        AND dim_employee_hierarchy_key > 0#(lf)#(lf)    UNION#(lf)#(lf)    SELECT #(lf)        [employee_primary_email_address] AS employee_email,#(lf)        [employee_people_leader_email_level_7] AS leader_email#(lf)    FROM #(lf)        [edw].[vw_dim_employee_hierarchy]#(lf)    WHERE #(lf)        DWHIsCurrent = 1#(lf)        AND dim_employee_hierarchy_key > 0#(lf)#(lf)    UNION#(lf)#(lf)    SELECT #(lf)        [employee_primary_email_address] AS employee_email,#(lf)        [employee_people_leader_email_level_8] AS leader_email#(lf)    FROM #(lf)        [edw].[vw_dim_employee_hierarchy]#(lf)    WHERE #(lf)        DWHIsCurrent = 1#(lf)        AND dim_employee_hierarchy_key > 0#(lf)#(lf)    UNION#(lf)#(lf)    SELECT #(lf)        [employee_primary_email_address] AS employee_email,#(lf)        [employee_people_leader_email_level_9] AS leader_email#(lf)    FROM #(lf)        [edw].[vw_dim_employee_hierarchy]#(lf)    WHERE #(lf)        DWHIsCurrent = 1#(lf)        AND dim_employee_hierarchy_key > 0#(lf))#(lf)SELECT DISTINCT #(lf)    LOWER(employee_email) AS employee_email,#(lf)    LOWER(leader_email) AS leader_email#(lf)FROM #(lf)    EmployeeLeaderEmails#(lf)WHERE #(lf)    leader_email IS NOT NULL;"])
		in
		    Source
	lineageTag: 64b60d43-19ea-4119-bce3-00a1d1eae58f
	queryGroup: RLS

