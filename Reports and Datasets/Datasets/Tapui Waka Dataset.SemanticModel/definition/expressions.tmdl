expression 'Additional Access' =
		let
		    // Load data from SharePoint
		    Source = SharePoint.Tables(
		        "https://emergeaotearoaltd.sharepoint.com/sites/OPS_ITServices/", [Implementation = "2.0", ViewMode = "All"]
		    ),
		    // Access specific table by ID
		    SelectedTable = Source{[Id = "27e19ae7-4448-4dfe-b172-3ee660e6e1df"]}[Items],
		    // Expand "Requester" List Column
		    ExpandedRequesterList = Table.ExpandListColumn(SelectedTable, "Requester"),
		    // Expand "Requester" Record Column to "email"
		    ExpandedRequesterEmail = Table.ExpandRecordColumn(
		        ExpandedRequesterList, "Requester", {"email"}, {"Requester Email"}
		    ),
		    // Expand "Person to Impersonate" List Column
		    ExpandedImpersonateList = Table.ExpandListColumn(ExpandedRequesterEmail, "Person to Impersonate"),
		    // Expand "Person to Impersonate" Record Column to "email"
		    ExpandedImpersonateEmail = Table.ExpandRecordColumn(
		        ExpandedImpersonateList, "Person to Impersonate", {"email"}, {"Person to Impersonate Email"}
		    ),
		    // Expand "Approved By" List Column
		    ExpandedApprovedList = Table.ExpandListColumn(ExpandedImpersonateEmail, "Approved By"),
		    // Expand "Approved By" Record Column to "email"
		    ExpandedApprovedEmail = Table.ExpandRecordColumn(
		        ExpandedApprovedList, "Approved By", {"email"}, {"Approved By Email"}
		    ),
		    // Remove unnecessary columns
		    RemovedUnnecessaryColumns = Table.RemoveColumns(
		        ExpandedApprovedEmail,
		        {
		            "Color Tag",
		            "Compliance Asset Id",
		            "ID",
		            "Content Type",
		            "Attachments",
		            "Edit",
		            "Type",
		            "Item Child Count",
		            "Folder Child Count",
		            "Label setting",
		            "Retention label",
		            "Retention label Applied",
		            "Label applied by",
		            "Item is a Record",
		            "App Created By",
		            "App Modified By"
		        }
		    ),
		    // Expand "Created By" List Column
		    ExpandedCreatedByList = Table.ExpandListColumn(RemovedUnnecessaryColumns, "Created By"),
		    // Expand "Created By" Record Column to "email"
		    ExpandedCreatedByEmail = Table.ExpandRecordColumn(
		        ExpandedCreatedByList, "Created By", {"email"}, {"Created By Email"}
		    ),
		    // Expand "Modified By" List Column
		    ExpandedModifiedByList = Table.ExpandListColumn(ExpandedCreatedByEmail, "Modified By"),
		    // Expand "Modified By" Record Column to "email"
		    ExpandedModifiedByEmail = Table.ExpandRecordColumn(
		        ExpandedModifiedByList, "Modified By", {"email"}, {"Modified By Email"}
		    ),
		    // Change data types of specified columns
		    ChangedColumnTypes = Table.TransformColumnTypes(
		        ExpandedModifiedByEmail,
		        {
		            {"Person to Impersonate Email", type text},
		            {"Requester Email", type text},
		            {"Expiry Date", type date},
		            {"Access Reason", type text},
		            {"Approved By Email", type text},
		            {"Approved Date", type date},
		            {"Modified", type date},
		            {"Created", type date},
		            {"Created By Email", type text},
		            {"Modified By Email", type text}
		        }
		    ),
		    // Filtering rows where "Expiry Date" is greater than or equal to today
		    ExpiryDateFilter = Table.SelectRows(ChangedColumnTypes, each [Expiry Date] >= Date.From(DateTime.LocalNow())),
		    #"Lowercased Text" = Table.TransformColumns(ExpiryDateFilter,{{"Requester Email", Text.Lower, type text}, {"Person to Impersonate Email", Text.Lower, type text}}),
		    // Filter rows where "Report" is the current report
		    ReportFilter = Table.SelectRows(#"Lowercased Text", each ([Report] = "Tapui Waka Dataset"))
		in
		    ReportFilter
	lineageTag: c6883bbb-5982-471e-ac60-d09ce3681139
	queryGroup: RLS

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression 'RLS - New Intelli Structure' =
		let
		    Source = Sql.Database(Server, Database, [Query="SELECT#(lf)    m.manager_id,#(lf)    m.manager_email,#(lf)    m.manager_business_unit,#(lf)    e.employee_id,#(lf)    e.employee_primary_email_address AS employee_email,#(lf)    e.employee_company_name AS employee_company#(lf)FROM#(lf)    edw.dim_employee_hierarchy e#(lf)    CROSS APPLY (VALUES#(lf)        -- Level 1 Manager#(lf)        (e.employee_people_leader_employee_number_level_1, e.employee_people_leader_email_level_1, e.employee_people_leader_business_unit_name_level_1),#(lf)        -- Level 2 Manager#(lf)        (e.employee_people_leader_employee_number_level_2, e.employee_people_leader_email_level_2, e.employee_people_leader_business_unit_name_level_2),#(lf)        -- Level 3 Manager#(lf)        (e.employee_people_leader_employee_number_level_3, e.employee_people_leader_email_level_3, e.employee_people_leader_business_unit_name_level_3),#(lf)        -- Level 4 Manager#(lf)        (e.employee_people_leader_employee_number_level_4, e.employee_people_leader_email_level_4, e.employee_people_leader_business_unit_name_level_4),#(lf)        -- Level 5 Manager#(lf)        (e.employee_people_leader_employee_number_level_5, e.employee_people_leader_email_level_5, e.employee_people_leader_business_unit_name_level_5),#(lf)        -- Level 6 Manager#(lf)        (e.employee_people_leader_employee_number_level_6, e.employee_people_leader_email_level_6, e.employee_people_leader_business_unit_name_level_6),#(lf)        -- Level 7 Manager#(lf)        (e.employee_people_leader_employee_number_level_7, e.employee_people_leader_email_level_7, e.employee_people_leader_business_unit_name_level_7),#(lf)        -- Level 8 Manager#(lf)        (e.employee_people_leader_employee_number_level_8, e.employee_people_leader_email_level_8, e.employee_people_leader_business_unit_name_level_8),#(lf)        -- Level 9 Manager#(lf)        (e.employee_people_leader_employee_number_level_9, e.employee_people_leader_email_level_9, e.employee_people_leader_business_unit_name_level_9)#(lf)    ) m(manager_id, manager_email, manager_business_unit)#(lf)WHERE#(lf)    e.[DWHIsCurrent] = 1#(lf)    AND e.[DWHDMLOperation] <> 'D'#(lf)    AND m.manager_id IS NOT NULL;"]),
		    ApplyNamingConventions = (columnName as text) as text =>
		        let
		            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
		            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
		            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
		            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
		            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
		            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
		            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
		            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
		            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
		            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
		            capitaliseWords = Text.Proper(renameDWHSourceSystem),
		            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
		            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
		            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
		        in
		            capitaliseDWH,
		    #"Transformed Column Names" = Table.TransformColumnNames(Source, each ApplyNamingConventions(_)),
		    #"Renamed Columns" = Table.RenameColumns(#"Transformed Column Names",{{"Manager Email", "User Principal Name"}}),
		    #"Lowercased Text" = Table.TransformColumns(#"Renamed Columns",{{"User Principal Name", Text.Lower, type text}, {"Employee Email", Text.Lower, type text}}),
		    #"Removed Duplicates" = Table.Distinct(#"Lowercased Text")
		in
		    #"Removed Duplicates"
	lineageTag: ea98a7af-0673-4a88-95d6-e81c42b6f2df
	queryGroup: RLS

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

