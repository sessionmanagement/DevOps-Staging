	partition dim_team_asset = m
		mode: import
		queryGroup: Dimensions
		source =
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="SELECT DISTINCT#(lf)#(tab)[name] AS [asset_name]#(lf)#(tab),[identifier] AS [number_plate]#(lf)#(tab),RTRIM(LTRIM([asset_id])) AS [asset_entity_id]#(lf)#(tab),[asset_nzta_subject_to_ruc]#(lf)#(tab),[asset_nzta_subject_to_ruc_hubo]#(lf)#(tab),[asset_nzta_wof_expiry_date]#(lf)#(tab),[asset_nzta_wof_type]#(lf)#(tab),[asset_nzta_license_expiry_date]#(lf)#(tab),[asset_nzta_fuel_type]#(lf)#(tab),[asset_nzta_ruc_expiry]#(lf)#(tab),[asset_nzta_ruc_expiry_date]#(lf)FROM TapuiWaka.[asset]#(lf)WHERE ODSIsCurrent=1"]),
				    #"Added Team Name" = Table.AddColumn(#"Source","team_name", each Text.BeforeDelimiter([asset_name], " ", {0, RelativePosition.FromEnd})),
				    #"Added Index" = Table.AddIndexColumn(#"Added Team Name", "dim_asset_key", 1, 1, Int64.Type),
				    #"Added Unknown Row" = Table.Combine({
				        #table({"dim_asset_key", "asset_name", "team_name", "number_plate", "asset_entity_id"}, {{0, "Unknown", "Unknown", "Unknown", "Unknown"}}),
				        #"Added Index"
				    }),
				    #"Sorted Rows" = Table.Sort(#"Added Unknown Row",{{"dim_asset_key", Order.Ascending}}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Sorted Rows",{{"asset_entity_id", type text}, {"asset_nzta_ruc_expiry_date", type date}, {"asset_nzta_license_expiry_date", type date}, {"asset_nzta_wof_expiry_date", type date}, {"dim_asset_key", Int64.Type}})
				in
				    #"Changed Type"

