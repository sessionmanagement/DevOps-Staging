	column 'Trip Duration Seconds'
		dataType: int64
		formatString: 0
		lineageTag: a7754dfa-b618-4e63-a1de-869de8f2f880
		summarizeBy: sum
		sourceColumn: Trip Duration Seconds

		annotation SummarizationSetBy = Automatic

	column 'Severity Score' = ```
			
			VAR SpeedExcess = 
			    ([Max Speed (km/h)] - [Limit (km/h)]) / [Limit (km/h)] * 100
			
			VAR DurationFactor = 
			    SWITCH(
			        TRUE(),
			        [Trip Duration Seconds] <= TIME(0, 0, 30), 1.0,
			        [Trip Duration Seconds] <= TIME(0, 1, 0), 1.2,
			        [Trip Duration Seconds] <= TIME(0, 2, 0), 1.5,
			        2.0
			    )
			
			VAR SpeedLimitFactor = 
			    SWITCH(
			        TRUE(),
			        [Limit (km/h)] >= 100, 1.0,
			        [Limit (km/h)] >= 80, 1.2,
			        [Limit (km/h)] >= 50, 1.5,
			        2.0
			    )
			
			VAR AverageSpeedFactor = 
			    IF(
			        [Average Speed (km/h)] > [Limit (km/h)],
			        ([Average Speed (km/h)] - [Limit (km/h)]) / ([Max Speed (km/h)] - [Limit (km/h)]),
			        0.5
			    )
			
			VAR RawScore = SpeedExcess * DurationFactor * SpeedLimitFactor * AverageSpeedFactor
			
			RETURN
			    SWITCH(
			        TRUE(),
			        RawScore <= 50, "Low",
			        RawScore <= 100, "Moderate",
			        RawScore <= 200, "High",
			        "Extreme"
			    )
			```
		lineageTag: 0a025f8d-7d5e-4b57-b0c2-cffb8ad744e1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Severity Raw Score' = ```
			
			VAR SpeedExcess = 
			    ([Max Speed (km/h)] - [Limit (km/h)]) / [Limit (km/h)] * 100
			
			VAR DurationFactor = 
			    SWITCH(
			        TRUE(),
			        [Trip Duration Seconds] <= TIME(0, 0, 30), 1.0,
			        [Trip Duration Seconds] <= TIME(0, 1, 0), 1.2,
			        [Trip Duration Seconds] <= TIME(0, 2, 0), 1.5,
			        2.0
			    )
			
			VAR SpeedLimitFactor = 
			    SWITCH(
			        TRUE(),
			        [Limit (km/h)] >= 100, 1.0,
			        [Limit (km/h)] >= 80, 1.2,
			        [Limit (km/h)] >= 50, 1.5,
			        2.0
			    )
			
			VAR AverageSpeedFactor = 
			    IF(
			        [Average Speed (km/h)] > [Limit (km/h)],
			        ([Average Speed (km/h)] - [Limit (km/h)]) / ([Max Speed (km/h)] - [Limit (km/h)]),
			        0.5
			    )
			
			RETURN
			    SpeedExcess * DurationFactor * SpeedLimitFactor * AverageSpeedFactor
			```
