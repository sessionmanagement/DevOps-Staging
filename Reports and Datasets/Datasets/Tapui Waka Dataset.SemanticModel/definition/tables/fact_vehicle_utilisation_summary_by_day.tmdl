		isNameInferred
		sourceColumn: [Average Trip Distance (Meters)]

		annotation SummarizationSetBy = Automatic

	partition fact_vehicle_utilisation_summary_by_day = calculated
		mode: import
		source =
				
				SUMMARIZE(
				    fact_trip_summary,
				    fact_trip_summary[start_date],
				    fact_trip_summary[dim_asset_key],
				    "Asset Name", LASTNONBLANK(dim_team_asset[asset_name],0),
				    "Total Number of Trips", COUNTROWS(fact_trip_summary),
				    "Average Trip Length (Seconds)", AVERAGE(fact_trip_summary[trip_length_seconds]),
				    "Average Trip Distance (Meters)", AVERAGE(fact_trip_summary[distance_meters]),
				    "Total Distance Traveled (Meters)", SUM(fact_trip_summary[distance_meters]),
				    "Total Usage Time (Seconds)", SUM(fact_trip_summary[trip_length_seconds]),
				    "Is Weekday", IF(NOT(WEEKDAY(fact_trip_summary[start_date], 2) IN {6, 7}), 1, 0)
				)

	annotation PBI_Id = bbf7b625f7ca4358bd3c869f66fa7841

