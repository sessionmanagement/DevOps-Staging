	partition dim_date = m
		mode: import
		queryGroup: Dimensions
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="SELECT [dim_date_key] as DateKey#(lf)      ,[calendar_date] as [Date]#(lf)      ,[calendar_day_num] as DayNumber#(lf)      ,[calendar_day_name_full] as [DayName]#(lf)      ,[calendar_day_name_short] as DayAbbrv#(lf)      ,[calendar_day_name_TeReo] as calendar_day_name_TeReo#(lf)      ,[calendar_day_number_in_year]#(lf)      ,[calendar_day_in_week_num]#(lf)      ,[calendar_days_in_month_num]#(lf)      ,[calendar_first_day_of_week_date]#(lf)      ,[calendar_last_day_of_week_date]#(lf)      ,[calendar_week_num]#(lf)      ,[calendar_month_num]#(lf)      ,[calendar_month_name_long]#(lf)      ,[calendar_month_name_short]#(lf)      ,[calendar_month_name_TeReo]#(lf)      ,[calendar_year_month]#(lf)      ,[calendar_first_day_of_month_date]#(lf)      ,[calendar_last_day_of_month_date]#(lf)      ,[calendar_quarter_num]#(lf)      ,[calendar_quarter_full]#(lf)      ,[calendar_first_day_of_quarter_date]#(lf)      ,[calendar_last_day_of_quarter_date]#(lf)      ,[calendar_year]#(lf)      ,[calendar_first_day_of_year_date]#(lf)      ,[calendar_last_day_of_year_date]#(lf)      ,[financial_first_day_of_year_date]#(lf)      ,[financial_last_day_of_year_date]#(lf)      ,[financial_week_num]#(lf)      ,[financial_first_day_of_week_date]#(lf)      ,[financial_last_day_of_week_date]#(lf)      ,[financial_day_of_week_num]#(lf)      ,[financial_month_num]#(lf)      ,[financial_first_Day_of_month_date]#(lf)      ,[financial_last_day_of_month_date]#(lf)      ,[financial_quarter_num]#(lf)      ,[financial_quarter_full]#(lf)      ,[financial_first_day_of_quarter_date]#(lf)      ,[financial_last_day_of_quarter_date]#(lf)      ,[financial_year_num]#(lf)      ,[financial_year_desc]#(lf)      ,[financial_year_month]#(lf)      ,[national_holiday_description]#(lf)     -- ,[national_holiday_ind]#(lf)      ,[regional_holiday_description]#(lf)     -- ,[regional_holiday_ind]#(lf)      --,[is_holiday_ind]#(lf)      --,[calendar_first_day_of_month_ind]#(lf)      --,[calendar_last_day_of_month_ind]#(lf)      --,[weekend_ind]#(lf)      --,[weekday_ind]#(lf)      ,[calendar_trading_day_flag]#(lf)      ,[current_date_flag]#(lf)      ,[current_month_flag]#(lf)      ,[current_calendar_year_flag]#(lf)      ,[current_month_to_date_flag]#(lf)      ,[current_calendar_year_to_date_flag]#(lf)      ,[current_financial_year_flag]#(lf)      ,[current_financial_year_to_date_flag]#(lf)      ,[previous_year_date_flag]#(lf)      ,[previous_year_month_flag]#(lf)      ,[previous_calendar_year_flag]#(lf)      ,[previous_year_month_to_date_flag]#(lf)      ,[previous_calendar_year_to_date_flag]#(lf)      ,[previous_financial_year_flag]#(lf)      ,[previous_financial_year_to_date_flag]#(lf)      ,[current_calendar_trading_days_in_month]#(lf)      ,[current_calendar_trading_days_in_month_ytd]#(lf)      ,[current_calendar_trading_days_left_in_month]#(lf)      --,[is_current_date]#(lf)      ,DATEDIFF(MONTH, GETDATE(), calendar_date) as [month_offset]#(lf)      ,[DWHSourceSystem]#(lf)      ,[DWHCreatedAt]#(lf)      ,[DWHBatchId]#(lf)  FROM [edw].[dim_date]#(lf)  WHERE [dim_date_key] <> -1#(lf)#(tab)AND [calendar_year] >= 2019#(lf)#(tab)AND [calendar_year] <= YEAR(DATEADD(DAY, 1, GETDATE()))"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Date", type date}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

