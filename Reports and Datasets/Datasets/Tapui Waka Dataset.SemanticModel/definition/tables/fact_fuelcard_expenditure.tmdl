	partition fact_fuelcard_expenditure = m
		mode: import
		queryGroup: Facts
		source =
				let
				    Source = #"Fuel Invoice Data",
				    #"Removed Errors" = Table.RemoveRowsWithErrors(Source, {"Date"}),
				    FilterNullAndWhitespace = each List.Select(_, each _ <> null and (not (_ is text) or Text.Trim(_) <> "")),
				    #"Removed Bottom Rows" = Table.RemoveLastN(#"Removed Errors", each try List.IsEmpty(List.Skip(FilterNullAndWhitespace(Record.FieldValues(_)), 1)) otherwise false),
				    #"Merged Queries" = Table.NestedJoin(#"Removed Bottom Rows", {"Vehicle Registration"}, dim_team_asset, {"number_plate"}, "dim_team_asset", JoinKind.LeftOuter),
				    #"Expanded dim_team_asset" = Table.ExpandTableColumn(#"Merged Queries", "dim_team_asset", {"dim_asset_key"}, {"dim_asset_key"}),
				    #"Replaced Value2" = Table.ReplaceValue(#"Expanded dim_team_asset",null,0,Replacer.ReplaceValue,{"dim_asset_key"}),
				    #"Filtered Rows" = Table.SelectRows(#"Replaced Value2", each ([Product] <> "Car Wash")),
				    #"Sorted Rows" = Table.Sort(#"Filtered Rows",{{"Vehicle Registration", Order.Ascending}, {"Date", Order.Ascending}, {"Time", Order.Ascending}, {"Voucher", Order.Ascending}}),
				    #"Grouped Rows" = Table.Group(
				        #"Sorted Rows",
				        {"Vehicle Registration"},
				        {
				            {
				                "VehicleRows",
				                each
				                    let
				                        IndexedRows = Table.AddIndexColumn(_, "VehicleFillIndex", 0, 1, Int64.Type),
				                        BufferedRows = Table.Buffer(IndexedRows),
				                        AddedPreviousOdometer = Table.AddColumn(
				                            BufferedRows,
				                            "Previous Odometer",
				                            each if [VehicleFillIndex] = 0 then null else BufferedRows[Odometer]{[VehicleFillIndex] - 1},
				                            Int64.Type
				                        ),
				                        AddedDistanceDelta = Table.AddColumn(
				                            AddedPreviousOdometer,
				                            "Distance Since Previous Fill Km",
				                            each
				                                let
				                                    currentOdometer = [Odometer],
				                                    previousOdometer = [Previous Odometer]
				                                in
				                                    if currentOdometer = null or previousOdometer = null or currentOdometer <= previousOdometer then
				                                        0
				                                    else
				                                        Number.From(currentOdometer - previousOdometer),
				                            type number
				                        ),
				                        AddedIntervalQuantity = Table.AddColumn(
				                            AddedDistanceDelta,
				                            "Fuel Quantity for Interval",
				                            each if [Distance Since Previous Fill Km] > 0 then Number.From([Quantity]) else 0,
				                            type number
				                        ),
				                        AddedIntervalSpend = Table.AddColumn(
				                            AddedIntervalQuantity,
				                            "Fuel Spend for Interval",
				                            each if [Distance Since Previous Fill Km] > 0 then Number.From([Voucher Value]) else 0,
				                            type number
				                        ),
				                        AddedIntervalFlag = Table.AddColumn(
				                            AddedIntervalSpend,
				                            "Has Valid Odometer Interval",
				                            each if [Distance Since Previous Fill Km] > 0 then 1 else 0,
				                            Int64.Type
				                        ),
				                        RemovedHelperColumns = Table.RemoveColumns(AddedIntervalFlag, {"VehicleFillIndex", "Previous Odometer"})
				                    in
				                        RemovedHelperColumns
				            }
				        }
				    ),
				    #"Expanded VehicleRows" = Table.ExpandTableColumn(
				        #"Grouped Rows",
				        "VehicleRows",
				        List.RemoveItems(Table.ColumnNames(#"Sorted Rows"), {"Vehicle Registration"}) & {"Distance Since Previous Fill Km", "Fuel Quantity for Interval", "Fuel Spend for Interval", "Has Valid Odometer Interval"},
				        List.RemoveItems(Table.ColumnNames(#"Sorted Rows"), {"Vehicle Registration"}) & {"Distance Since Previous Fill Km", "Fuel Quantity for Interval", "Fuel Spend for Interval", "Has Valid Odometer Interval"}
				    ),
				    #"Changed Type" = Table.TransformColumnTypes(
				        #"Expanded VehicleRows",
				        {
				            {"Date", type date},
				            {"Time", type time},
				            {"Card Number", Int64.Type},
				            {"Vehicle Registration", type text},
				            {"Card Holder", type text},
				            {"Cost Centre", type text},
				            {"Location ", type text},
				            {"Voucher", Int64.Type},
				            {"Odometer", Int64.Type},
				            {"Product", type text},
				            {"Quantity", type number},
				            {"Voucher Value", type number},
				            {"Invoice Rate", type number},
				            {"Net Excl GST", type number},
				            {"dim_asset_key", type number},
				            {"Distance Since Previous Fill Km", type number},
				            {"Fuel Quantity for Interval", type number},
				            {"Fuel Spend for Interval", type number},
				            {"Has Valid Odometer Interval", Int64.Type}
				        }
				    )
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

