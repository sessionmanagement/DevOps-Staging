table '_Report Components'
	lineageTag: 3862e574-1486-4c1c-91eb-c9ca5176c35b

	measure 'BI and Reporting Team URL' = "https://emergeaotearoaltd.sharepoint.com/sites/ITS2/SitePages/Reporting.aspx"
		lineageTag: 0834f780-eee9-458e-8964-64065f2e4500

	measure 'Data Last Refreshed' = "Data Last Refreshed: " & FORMAT(LASTDATE(LastRefreshed[Date Last Refreshed]), "dd/MM/YYYY - hh:mm am/pm")
		lineageTag: 5fbe2699-8630-4667-b4f1-c888e6b34860

	measure 'Help Button URL' = "https://ealservicedesk.freshservice.com/support/solutions/articles/75000104496"
		lineageTag: 6b1a54cc-38c3-4888-a7f6-c80ec57ef97c

	partition '_Report Components' = m
		mode: import
		queryGroup: 'Common Components'
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i45WMlSKjQUA", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", Int64.Type}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

