	partition fact_trip_summary = m
		mode: import
		queryGroup: Facts
		source =
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="SELECT asset_trip_id AS [id]#(lf)      ,RTRIM(LTRIM([asset_id])) AS [asset_entity_id]#(lf)      ,[is_processed]#(lf)      ,[version]#(lf)      ,CONVERT(#(lf)#(tab)#(tab)#(tab)#(tab)datetime, SWITCHOFFSET(CONVERT(datetimeoffset, [start_timestamp]),#(lf)#(tab)#(tab)#(tab)#(tab)DATEPART(TZOFFSET,[start_timestamp] AT TIME ZONE 'New Zealand Standard Time')))#(tab)#(lf)#(tab)   AS [start_timestamp]#(lf)      ,null as [start_point_type]#(lf)      ,[start_point_latitude]#(lf)      ,[start_point_longitude]#(lf)      ,[end_point_latitude]#(lf)      ,[end_point_longitude]#(lf)      ,[start_address]#(lf)      ,CONVERT(#(lf)#(tab)#(tab)#(tab)#(tab)datetime, SWITCHOFFSET(CONVERT(datetimeoffset, [end_timestamp]),#(lf)#(tab)#(tab)#(tab)#(tab)DATEPART(TZOFFSET,[end_timestamp] AT TIME ZONE 'New Zealand Standard Time')))#(tab)#(lf)#(tab)   AS [end_timestamp]#(lf)      ,[end_address]#(lf)      ,[is_towed]#(lf)      ,RTRIM(LTRIM([operator_id])) AS [operator_id]#(lf)      ,[operator]#(lf)      ,[distance_meters]#(lf)      ,[distance_meters] / 1000  AS distance_km#(lf)      ,[distance_meters_offroad]#(lf)      ,[average_speed]#(lf)      ,[max_speed]#(lf)      ,[num_polls]#(lf)      ,[on_road_within_speed_limit]#(lf)      ,[on_road_over_speed_limit_band1] / 1000 AS [on_road_over_speed_limit_band1]#(lf)      ,[on_road_over_speed_limit_band2] / 1000 AS [on_road_over_speed_limit_band2]#(lf)      ,[on_road_over_speed_limit_band3] / 1000 AS [on_road_over_speed_limit_band3]#(lf)      ,[on_road_over_speed_limit_band4] / 1000 AS [on_road_over_speed_limit_band4]#(lf)      ,[on_road_over_speed_limit_band5] / 1000 AS [on_road_over_speed_limit_band5]#(lf)      ,[offroad_within_speed_limit]#(lf)      ,[offroad_over_speed_limit_band1] / 1000 AS [offroad_over_speed_limit_band1]#(lf)      ,[offroad_over_speed_limit_band2] / 1000 AS [offroad_over_speed_limit_band2]#(lf)      ,[offroad_over_speed_limit_band3] / 1000 AS [offroad_over_speed_limit_band3]#(lf)      ,[offroad_over_speed_limit_band4] / 1000 AS [offroad_over_speed_limit_band4]#(lf)      ,[offroad_over_speed_limit_band5] / 1000 AS [offroad_over_speed_limit_band5]#(lf)  FROM TapuiWaka.[asset_trip]#(lf)"]),
