	column onroad_speeding_occurred_during_trip = ```
			
			IF(
			    fact_trip_summary[on_road_over_speed_limit_band1] > 0 || 
			    fact_trip_summary[on_road_over_speed_limit_band2] > 0 ||
			    fact_trip_summary[on_road_over_speed_limit_band3] > 0 ||
			    fact_trip_summary[on_road_over_speed_limit_band4] > 0 ||
			    fact_trip_summary[on_road_over_speed_limit_band5] > 0,
			    1,0
			)
			```
		formatString: 0
		lineageTag: 61a1176d-4965-488a-8bc5-a92cf2e92bd6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column offroad_speeding_occurred_during_trip = ```
			
			IF(
			    fact_trip_summary[offroad_over_speed_limit_band1] > 0 || 
			    fact_trip_summary[offroad_over_speed_limit_band2] > 0 ||
			    fact_trip_summary[offroad_over_speed_limit_band3] > 0 ||
			    fact_trip_summary[offroad_over_speed_limit_band4] > 0 ||
			    fact_trip_summary[offroad_over_speed_limit_band5] > 0,
			    1,0
			)
			```
		formatString: 0
		lineageTag: d460918c-b01d-48ae-b039-4bf9ee5489ad
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column any_speeding_occurred_during_trip =
			
			IF(fact_trip_summary[onroad_speeding_occurred_during_trip] = 1 || fact_trip_summary[offroad_speeding_occurred_during_trip] = 1,"Yes", "No")
		lineageTag: ad22a660-06e1-47c7-a001-f31029714952
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column trip_length_seconds = DATEDIFF(fact_trip_summary[start_timestamp],fact_trip_summary[end_timestamp],SECOND)
		formatString: 0
		lineageTag: bf815dc7-e5ac-44ed-9f42-7b6de5503940
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column trip_length_hours = DATEDIFF(fact_trip_summary[start_timestamp],fact_trip_summary[end_timestamp],HOUR)
		formatString: 0
		lineageTag: 2067da87-856e-4ef3-8107-0f7209ee59c6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column trip_length_minutes = DATEDIFF(fact_trip_summary[start_timestamp],fact_trip_summary[end_timestamp],MINUTE)
		formatString: 0
		lineageTag: 944be153-5643-408d-ad95-d7dcc2bfa80b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column last_trip_of_day_flag = ```
			
			VAR CurrentVehicle = fact_trip_summary[asset_entity_id]
			VAR CurrentDate = fact_trip_summary[end_date]
			VAR CurrentEndTime = fact_trip_summary[end_timestamp]
			VAR LastTripTime = 
			    CALCULATE(
			        MAX(fact_trip_summary[end_timestamp]),
			        FILTER(
			            ALL(fact_trip_summary),
			            fact_trip_summary[asset_entity_id] = CurrentVehicle &&
			            fact_trip_summary[end_date] = CurrentDate
			        )
			    )
			RETURN
			IF(CurrentEndTime = LastTripTime, 1, 0)
			```
		formatString: 0
		lineageTag: f08214c3-722b-498c-a927-8b2dea273760
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column first_trip_of_day_flag = ```
			
			VAR CurrentVehicle = fact_trip_summary[asset_entity_id]
			VAR CurrentDate = fact_trip_summary[start_date]
			VAR CurrentStartTime = fact_trip_summary[start_timestamp]
			VAR EarliestTripTime = 
			    CALCULATE(
			        MIN(fact_trip_summary[start_timestamp]),
			        FILTER(
			            ALL(fact_trip_summary),
			            fact_trip_summary[asset_entity_id] = CurrentVehicle &&
			            fact_trip_summary[start_date] = CurrentDate
			        )
			    )
			RETURN
			IF(CurrentStartTime = EarliestTripTime, 1, 0)
			```
		formatString: 0
		lineageTag: 709666cc-905c-4153-b48e-6b3ffd63970f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column booking_status =
			
			IF(
			    fact_trip_summary[dim_driver_key] = 0, "Unbooked", "Booked"
			)
		lineageTag: 927f7b24-ea86-49a9-bfa1-60834d6c6a13
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column total_trip_distance_meters = fact_trip_summary[distance_meters] + fact_trip_summary[distance_meters_offroad]
		lineageTag: 3a95ac53-c1ba-4fae-a17d-87338e982afb
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column total_trip_distance_km = fact_trip_summary[total_trip_distance_meters] / 1000
		lineageTag: 6b39612a-c8e8-4e46-b523-f13b2084f6b7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column highest_speed_band_during_trip =
			
			IF(
			    fact_trip_summary[offroad_over_speed_limit_band5] > 0 || fact_trip_summary[on_road_over_speed_limit_band5] > 0, 5,
			IF(
			    fact_trip_summary[offroad_over_speed_limit_band4] > 0 || fact_trip_summary[on_road_over_speed_limit_band4] > 0, 4,
			IF(
			    fact_trip_summary[offroad_over_speed_limit_band3] > 0 || fact_trip_summary[on_road_over_speed_limit_band3] > 0, 3,
			IF(
			    fact_trip_summary[offroad_over_speed_limit_band2] > 0 || fact_trip_summary[on_road_over_speed_limit_band2] > 0, 2,
			IF(
			    fact_trip_summary[offroad_over_speed_limit_band1] > 0 || fact_trip_summary[on_road_over_speed_limit_band1] > 0, 1,
			0
			)))))
		formatString: 0
		lineageTag: 6bf6c0ba-ee2d-4057-8ba3-5af0994d6ee7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column last_trip_of_day_display =
			
