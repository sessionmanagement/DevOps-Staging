model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-NZ
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Dimensions

	annotation PBI_QueryGroupOrder = 0

queryGroup Facts

	annotation PBI_QueryGroupOrder = 1

queryGroup Work

	annotation PBI_QueryGroupOrder = 2

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 3

queryGroup RLS

	annotation PBI_QueryGroupOrder = 5

queryGroup 'Excel Spreadsheets'

	annotation PBI_QueryGroupOrder = 4

queryGroup 'Common Components'

	annotation PBI_QueryGroupOrder = 6

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["fact_asset_utilisation","fact_distance_by_driver","fact_trip_summary","fact_speed_details","fact_fuelcard_expenditure","work_fact_trip_summary_dim_team_asset","fact_speed_details_dim_team_asset","dim_team_asset","dim_service","dim_driver","dim_date","dim_time","Additional Access","RLS - New Intelli Structure","RLS with Additional Access","rls_employee_emails","Asset Utilisation Sample","Fuel Invoice Data","Speed and Trip Sample","Speed and Trip Sample (Trip Summaries)","Server","Database","PBI Service RLS Impersonation","LastRefreshed","_Measures","Fuel Invoice Data (old)","_Report Components"]

annotation PBI_ProTooling = ["DevMode"]

ref table _Measures
ref table LastRefreshed
ref table fact_asset_utilisation
ref table fact_trip_summary
ref table fact_speed_details
ref table dim_team_asset
ref table dim_driver
ref table dim_date
ref table dim_time
ref table fact_distance_by_driver
ref table fact_fuelcard_expenditure
ref table fact_vehicle_utilisation_summary
ref table fact_vehicle_utilisation_summary_by_day
ref table 'Asset Utilisation Sample'
ref table 'Fuel Invoice Data'
ref table 'Speed and Trip Sample'
ref table 'Speed and Trip Sample (Trip Summaries)'
ref table 'RLS with Additional Access'
ref table dim_service
ref table '_Report Components'

ref role 'All Access'
ref role Public

ref cultureInfo en-US

