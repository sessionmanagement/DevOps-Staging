		sourceColumn: User Principal Name

		annotation SummarizationSetBy = Automatic

	partition 'RLS with Additional Access' = m
		mode: import
		source =
				let
				    // Load both tables
				    RowLevelSecurity = @#"RLS-Employee",
				    AdditionalAccess = #"Additional Access",
				    // Join tables
				    JoinedTable = Table.Join(
				        AdditionalAccess, "Person to Impersonate Email", RowLevelSecurity, "User Principal Name", JoinKind.RightOuter
				    ),
				
				    #"Added Conditional Column" = Table.AddColumn(
				        JoinedTable, "Custom", each if [Requester Email] = null then [User Principal Name] else [Requester Email]
				    ),
				
				    #"Removed Columns" = Table.RemoveColumns(
				        #"Added Conditional Column",
				        {
				            "Report",
				            "Requester Email",
				            "Person to Impersonate Email",
				            "Expiry Date",
				            "Access Reason",
				            "Approved By Email",
				            "Approved Date",
				            "Modified",
				            "Created",
				            "Created By Email",
				            "Modified By Email",
				            "Version",
				            "User Principal Name"
				        }
				    ),
				
				    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns", {{"Custom", "User Principal Name"}}),
				
				    #"Reordered Columns" = Table.ReorderColumns(
				        #"Renamed Columns", {"User Principal Name"}
				    ),
				
				    #"Changed Type" = Table.TransformColumnTypes(#"Reordered Columns", {{"User Principal Name", type text}}),
				    #"Appended Query" = Table.Combine({#"Changed Type", #"RLS-Employee"}),
				    #"Removed Duplicates" = Table.Distinct(#"Appended Query")
				in
				    #"Removed Duplicates"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

