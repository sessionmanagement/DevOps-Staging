table _Measures
	lineageTag: a8f1d273-ddf5-40f5-a505-7ef19e61c619

	measure 'Filters Applied' =
			
			VAR _FC_dim_date_calendar_date = IF(ISFILTERED('Dim Date'[calendar_date]), "EXPENSE DATE RANGE: " & FORMAT(MIN('Dim Date'[calendar_date]), "dd/MM/yyyy") & " - " & FORMAT(MAX('Dim Date'[calendar_date]), "dd/MM/yyyy"), BLANK())
			
			VAR _dim_date_calendar_year = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES('Dim Date'[calendar_year]), NOT(ISBLANK('Dim Date'[calendar_year]))), 'Dim Date'[calendar_year], ASC),
			    "calendar_year_display", 'Dim Date'[calendar_year]
			)
			VAR _dim_date_calendar_yearCount = IF(ISFILTERED('Dim Date'[calendar_year]), COUNTROWS(VALUES('Dim Date'[calendar_year])), 0)
			VAR _More_dim_date_calendar_year = IF(_dim_date_calendar_yearCount > 5, " and " & (_dim_date_calendar_yearCount - 5) & " more", "")
			VAR _FC_dim_date_calendar_year = IF(_dim_date_calendar_yearCount > 0, "CALENDAR YEARS CHOSEN: " & CONCATENATEX(_dim_date_calendar_year, [calendar_year_display], ", "), BLANK()) & _More_dim_date_calendar_year
			
			VAR _dim_date_calendar_quarter_full = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES('Dim Date'[calendar_quarter_full]), NOT(ISBLANK('Dim Date'[calendar_quarter_full]))), 'Dim Date'[calendar_quarter_full], ASC),
			    "calendar_quarter_full_display", 'Dim Date'[calendar_quarter_full]
			)
			VAR _dim_date_calendar_quarter_fullCount = IF(ISFILTERED('Dim Date'[calendar_quarter_full]), COUNTROWS(VALUES('Dim Date'[calendar_quarter_full])), 0)
			VAR _More_dim_date_calendar_quarter_full = IF(_dim_date_calendar_quarter_fullCount > 5, " and " & (_dim_date_calendar_quarter_fullCount - 5) & " more", "")
			VAR _FC_dim_date_calendar_quarter_full = IF(_dim_date_calendar_quarter_fullCount > 0, "QUARTER CHOSEN: " & CONCATENATEX(_dim_date_calendar_quarter_full, [calendar_quarter_full_display], ", "), BLANK()) & _More_dim_date_calendar_quarter_full
			
			VAR _dim_date_calendar_month_name_short = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES('Dim Date'[calendar_month_name_short]), NOT(ISBLANK('Dim Date'[calendar_month_name_short]))), 'Dim Date'[calendar_month_name_short], ASC),
			    "calendar_month_name_short_display", 'Dim Date'[calendar_month_name_short]
			)
			VAR _dim_date_calendar_month_name_shortCount = IF(ISFILTERED('Dim Date'[calendar_month_name_short]), COUNTROWS(VALUES('Dim Date'[calendar_month_name_short])), 0)
			VAR _More_dim_date_calendar_month_name_short = IF(_dim_date_calendar_month_name_shortCount > 5, " and " & (_dim_date_calendar_month_name_shortCount - 5) & " more", "")
			VAR _FC_dim_date_calendar_month_name_short = IF(_dim_date_calendar_month_name_shortCount > 0, "MONTHS CHOSEN: " & CONCATENATEX(_dim_date_calendar_month_name_short, [calendar_month_name_short_display], ", "), BLANK()) & _More_dim_date_calendar_month_name_short
			
			VAR _ExpenseStatus = ADDCOLUMNS(
			   TOPN(5, FILTER(VALUES('Web Expenses Data'[Expense Status]), NOT(ISBLANK('Web Expenses Data'[Expense Status]))), 'Web Expenses Data'[Expense Status], ASC),
			   "ExpenseStatus_display", 'Web Expenses Data'[Expense Status]
			)
			VAR _ExpenseStatusCount = IF(ISFILTERED('Web Expenses Data'[Expense Status]), COUNTROWS(VALUES('Web Expenses Data'[Expense Status])), 0)
			VAR _More_ExpenseStatus = IF(_ExpenseStatusCount > 5, " and " & (_ExpenseStatusCount - 5) & " more", "")
			VAR _FC_ExpenseStatus = IF(_ExpenseStatusCount > 0, "EXPENSE STATUSES CHOSEN: " & CONCATENATEX(_ExpenseStatus, 'Web Expenses Data'[Expense Status], ", "), BLANK()) & _More_ExpenseStatus
			
			VAR _Category = ADDCOLUMNS(
			   TOPN(5, FILTER(VALUES('Web Expenses Data'[Category]), NOT(ISBLANK('Web Expenses Data'[Category]))), 'Web Expenses Data'[Category], ASC),
			   "Category_display", 'Web Expenses Data'[Category]
			)
			VAR _CategoryCount = IF(ISFILTERED('Web Expenses Data'[Category]), COUNTROWS(VALUES('Web Expenses Data'[Category])), 0)
			VAR _More_Category = IF(_CategoryCount > 5, " and " & (_CategoryCount - 5) & " more", "")
			VAR _FC_Category = IF(_CategoryCount > 0, "CATEGORY CHOSEN: " & CONCATENATEX(_Category, [Category_display], ", "), BLANK()) & _More_Category
			
			VAR _ReceiptAvailable = ADDCOLUMNS(
			   TOPN(5, FILTER(VALUES('Web Expenses Data'[Receipt Available Flag]), NOT(ISBLANK('Web Expenses Data'[Receipt Available Flag]))), 'Web Expenses Data'[Receipt Available Flag], ASC),
			   "ReceiptAvailable_display", 'Web Expenses Data'[Receipt Available Flag]
			)
			VAR _ReceiptAvailableCount = IF(ISFILTERED('Web Expenses Data'[Receipt Available Flag]), COUNTROWS(VALUES('Web Expenses Data'[Receipt Available Flag])), 0)
			VAR _More_ReceiptAvailable = IF(_ReceiptAvailableCount > 5, " and " & (_ReceiptAvailableCount - 5) & " more", "")
			VAR _FC_ReceiptAvailable = IF(_ReceiptAvailableCount > 0, "RECEIPT AVAILABLE CHOSEN: " & CONCATENATEX(_ReceiptAvailable, [ReceiptAvailable_display], ", "), BLANK()) & _More_ReceiptAvailable
			
			VAR _ClaimantRegion = ADDCOLUMNS(
			   TOPN(5, FILTER(VALUES('Days to Post'[Claimant Region Name]), NOT(ISBLANK('Days to Post'[Claimant Region Name]))), 'Days to Post'[Claimant Region Name], ASC),
			   "ClaimantRegion_display", 'Days to Post'[Claimant Region Name]
