			)
			VAR _ClaimantNameCount = IF(ISFILTERED('Days to Post'[Claimant Name]), COUNTROWS(VALUES('Days to Post'[Claimant Name])), 0)
			VAR _More_ClaimantName = IF(_ClaimantNameCount > 5, " and " & (_ClaimantNameCount - 5) & " more", "")
			VAR _FC_ClaimantName = IF(_ClaimantNameCount > 0, "CLAIMANT NAME CHOSEN: " & CONCATENATEX(_ClaimantName, [ClaimantName_display], ", "), BLANK()) & _More_ClaimantName
			
			//VAR _dim_team_area_Company = ADDCOLUMNS(
