			VAR _ClaimantRegionCount = IF(ISFILTERED('Days to Post'[Claimant Region Name]), COUNTROWS(VALUES('Days to Post'[Claimant Region Name])), 0)
			VAR _More_ClaimantRegion = IF(_ClaimantRegionCount > 5, " and " & (_ClaimantRegionCount - 5) & " more", "")
			VAR _FC_ClaimantRegion = IF(_ClaimantRegionCount > 0, "CLAIMANT REGION CHOSEN: " & CONCATENATEX(_ClaimantRegion, [ClaimantRegion_display], ", "), BLANK()) & _More_ClaimantRegion
			
			VAR _ClaimantName = ADDCOLUMNS(
			   TOPN(5, FILTER(VALUES('Days to Post'[Claimant Name]), NOT(ISBLANK('Days to Post'[Claimant Name]))), 'Days to Post'[Claimant Name], ASC),
