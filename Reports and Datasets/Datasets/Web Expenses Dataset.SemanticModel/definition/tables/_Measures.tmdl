			 },
			     [Value] <> BLANK()), [Value], " | ")
			)
		lineageTag: 325921a9-1fb6-43a4-94b3-2a0afd83b8d0

	measure 'Filter Depth' =
			ISFILTERED('Employee Hierarchy'[Name & BU Level 1]) +
			    ISFILTERED('Employee Hierarchy'[Name & BU Level 2]) +
			    ISFILTERED('Employee Hierarchy'[Name & BU Level 3]) +
			    ISFILTERED('Employee Hierarchy'[Name & BU Level 4]) +
			    ISFILTERED('Employee Hierarchy'[Name & BU Level 5]) +
			    ISFILTERED('Employee Hierarchy'[Name & BU Level 6]) +
			    ISFILTERED('Employee Hierarchy'[Name & BU Level 7]) +
			    ISFILTERED('Employee Hierarchy'[Name & BU Level 8])
		formatString: 0
		lineageTag: 8aed6e16-dbe4-4bfb-9755-ac1d1e8940af

	measure 'Max Depth' = ```
			MAX('Employee Hierarchy'[Hierarchy Depth]) + IF(MAX('Employee Hierarchy'[Employee Name]) = "Unknown", 0, 1) 
			```
		formatString: 0
		lineageTag: 6f2cd964-367b-4f21-9b10-1f47c3c0de64

	measure 'Sum of Transactions (Hierarchy)' =
			IF(
			    [Filter Depth] > [Max Depth],
			    BLANK(),
			    SUM('Web Expenses Data'[Expense Amount]))
		lineageTag: 83cef2cd-22a3-4cf8-808e-d9a86a43e925

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'No. of Transactions (Hierarchy) (Not Used)' =
			IF(
			    [Filter Depth] > [Max Depth],
			    BLANK(),
			    DISTINCTCOUNT('Web Expenses Data'[Claim Number]))
		formatString: 0
		lineageTag: 2b6914ed-bb08-4b58-ac35-3cb2c84e8f6c

	measure 'No. of Transaction Lines (Hierarchy)' =
			IF(
			    [Filter Depth] > [Max Depth],
			    BLANK(),
			    CALCULATE(
			        COUNT('Web Expenses Data'[Claim Number]),
			        FILTER('Web Expenses Data', 'Web Expenses Data'[Data Status] = "Current")
			    )
			)
		formatString: 0
		lineageTag: b36cdec2-582e-4b48-825b-bdf53db705b4

	measure 'No. of Transactions (Not Used)' =
			CALCULATE(
			    DISTINCTCOUNT('Web Expenses Data'[Claim Number]),
			    FILTER('Web Expenses Data', 'Web Expenses Data'[Data Status] = "Current")
			)
		formatString: 0
		lineageTag: 4a314d8d-1e36-4d78-86a9-dbf62dd1c123

	measure 'No. of Transaction Lines' =
			CALCULATE(
			    COUNT('Web Expenses Data'[Claim Number]),
			    FILTER('Web Expenses Data', 'Web Expenses Data'[Data Status] = "Current")
			)
		formatString: 0
