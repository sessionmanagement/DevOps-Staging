	measure 'No. of Transaction Lines Last Week (Hierarchy)' =
			IF(
			    [Filter Depth] > [Max Depth],
			    BLANK(),
			    CALCULATE(
			        COUNT('Web Expenses Data'[Last Week Claim Line Number]),
			        FILTER('Web Expenses Data', 'Web Expenses Data'[Data Status] = "Last Week")
			    )
			)
		formatString: 0
