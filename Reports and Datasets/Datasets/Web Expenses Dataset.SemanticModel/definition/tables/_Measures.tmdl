	measure 'Sum of Transactions' =
			CALCULATE(
			    SUM('Web Expenses Data'[Expense Amount]),
			    FILTER('Web Expenses Data', 'Web Expenses Data'[Data Status] = "Current")
			)
		lineageTag: 9f7259f3-aced-42eb-84e0-e76e57096720

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'No. of Transactions Last Month (Not Used)' =
			CALCULATE(
			    DISTINCTCOUNT('Web Expenses Data'[Last Month Claim Number]),
