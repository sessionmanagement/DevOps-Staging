model Model
	culture: en-NZ
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-NZ
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Common Components'

	annotation PBI_QueryGroupOrder = 2

queryGroup 'Primary Datasets'

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Dim Date","_Measures","_Report Components","Server","Database","LastRefreshed","Changelog","Web Expenses Data","Employee Hierarchy","Days to Post","RLS-Employee","Additional Access","RLS with Additional Access"]

annotation PBI_ProTooling = ["TMDLView_Desktop","DevMode"]

ref table 'Dim Date'
ref table _Measures
ref table '_Report Components'
ref table LastRefreshed
ref table Changelog
ref table 'Web Expenses Data'
ref table 'Employee Hierarchy'
ref table 'Breakdown Selection'
ref table 'Days to Post'
ref table 'RLS with Additional Access'

ref role Public
ref role 'All Access'

ref cultureInfo en-NZ

