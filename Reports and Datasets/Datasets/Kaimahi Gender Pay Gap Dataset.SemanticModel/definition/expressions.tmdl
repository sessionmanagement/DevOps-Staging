expression FactPeople =
		let
		    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="SELECT [people_id]#(lf)      ,[displayName] AS 'Kaimahi Name'#(lf)      ,[dateOfBirth]#(lf)      ,[gender]#(lf)      ,[primaryEmailAddress_email]#(lf)      ,[employeeNumber]#(lf)      ,[employmentStatus]#(lf)  FROM [IntelliHR].[people]#(lf)  WHERE ODSIsCurrent = 1"]),
		    #"Inserted Age" = Table.AddColumn(Source, "Age", each DateTime.LocalNow() - [dateOfBirth], type duration),
		    #"Inserted Total Years" = Table.AddColumn(#"Inserted Age", "Total Years", each Duration.TotalDays([Age]) / 365, type number),
		    #"Changed Type" = Table.TransformColumnTypes(#"Inserted Total Years",{{"Total Years", Int64.Type}}),
		    #"Filtered Rows1" = Table.SelectRows(#"Changed Type", each [employeeNumber] <> null and [employeeNumber] <> ""),
		    #"Merged Queries" = Table.NestedJoin(#"Filtered Rows1", {"employeeNumber"}, PayRates, {"code"}, "PayRates", JoinKind.LeftOuter),
		    #"Expanded PayRates" = Table.ExpandTableColumn(#"Merged Queries", "PayRates", {"company_id", "pay_rate_value", "standard_hours_per_week_value", "standard_days_per_week_value", "HourlyPay"}, {"company_id", "pay_rate_value", "standard_hours_per_week_value", "standard_days_per_week_value", "HourlyPay"}),
		    #"Filtered Rows" = Table.SelectRows(#"Expanded PayRates", each ([employmentStatus] = "Current Staff" or [employmentStatus] = "Exiting Staff"))
		in
		    #"Filtered Rows"
	lineageTag: a8dba5a7-8d5b-4d41-8472-4b9ed98d1375
	queryGroup: 'Raw Intelli Data'

