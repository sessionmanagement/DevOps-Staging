expression WorkingPayGrades-nonStandard =
		let
		    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="SELECT#(lf)    [pay_grades_id],#(lf)    code,#(lf)    name#(lf)FROM [IntelliHR].[pay_grades]#(lf)WHERE (([ODSIsCurrent] = 1) AND ([isEnabled] = 1));#(lf)"]),
		    #"Filtered Rows" = Table.SelectRows(Source, each ([name] = "Grade 20" or [name] = "Grade 20c" or [name] = "Grade 21" or [name] = "Grade 22" or [name] = "Grade 23" or [name] = "Grade 24" or [name] = "Grade 25" or [name] = "Grade 26" or [name] = "Grade 27" or [name] = "Grade 28" or [name] = "No Pay Grade" or [name] = "PE - Level 0" or [name] = "PE - Level 2" or [name] = "PE - Level 3" or [name] = "PE - Level 4" or [name] = "PE - Level 4b")),
		    #"Inserted Removed Characters" = Table.AddColumn(#"Filtered Rows", "Removed Characters", each Text.Remove([name], {"b", "c"}), type text),
		    #"Renamed Columns" = Table.RenameColumns(#"Inserted Removed Characters",{{"Removed Characters", "Grade"}}),
		    #"Removed Columns1" = Table.RemoveColumns(#"Renamed Columns",{"name"})
		in
		    #"Removed Columns1"
	lineageTag: 46871527-2b45-4e0d-a93f-546a4d2d16dc
	queryGroup: 'Raw Intelli Data'

