	partition 'Dim Business Units' = m
		mode: import
		queryGroup: 'Final Tables'
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="SELECT [dim_business_unit_hierarchy_key]#(lf)      ,[business_unit_id]#(lf)      ,[business_unit_name] AS 'Business Unit'#(lf)      ,[business_unit_hierarchy_level1_name]#(lf)      ,[business_unit_hierarchy_level2_name]#(lf)      ,[business_unit_hierarchy_level3_name]#(lf)      ,[business_unit_hierarchy_level4_name]#(lf)      ,[business_unit_hierarchy_level5_name]#(lf)      ,[business_unit_hierarchy_level6_name]#(lf)      ,[business_unit_hierarchy_level7_name]#(lf)      ,[is_active_flag]#(lf)  FROM [edw].[dim_business_unit_hierarchy]#(lf)  WHERE DWHDMLOperation <> 'D'#(lf)  AND is_active_flag = 1#(lf)AND [dim_business_unit_hierarchy_key] > 0"])
				in
				    Source

