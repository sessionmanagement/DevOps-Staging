	column HourlyPay
		dataType: double
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 8484eef7-a393-455c-9222-8a8b4e145fe9
		summarizeBy: sum
		sourceColumn: HourlyPay

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column PayBucket =
			SWITCH(TRUE(),
			    FactKaimahi[HourlyPay] < 25, "1",
			    AND(FactKaimahi[HourlyPay] >= 25, FactKaimahi[HourlyPay] < 30), "2",
			    AND(FactKaimahi[HourlyPay] >= 30, FactKaimahi[HourlyPay] < 35), "3",
			    AND(FactKaimahi[HourlyPay] >= 35, FactKaimahi[HourlyPay] < 40), "4",
			    AND(FactKaimahi[HourlyPay] >= 40, FactKaimahi[HourlyPay] < 45), "5",
			    AND(FactKaimahi[HourlyPay] >= 45, FactKaimahi[HourlyPay] < 50), "6",
			    FactKaimahi[HourlyPay] >= 50, "7",
			    "0"
			)
		lineageTag: 7e258092-77d8-4ce3-8647-d66fbe960694
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

