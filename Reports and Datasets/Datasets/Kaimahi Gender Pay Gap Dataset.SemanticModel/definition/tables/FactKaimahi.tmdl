	column LatestJobRank = COUNTROWS(FILTER(ALL('FactKaimahi'),'FactKaimahi'[Index]<=EARLIER('FactKaimahi'[Index]) && 'FactKaimahi'[person_id]=EARLIER('FactKaimahi'[person_id])))
		formatString: 0
		lineageTag: 6ff0ac7d-6e78-47ea-a451-4612d8835222
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column NewRank =
			
			VAR R1 =
			    COUNTROWS(
			        FILTER(
			            ALL( 'FactKaimahi' ),
			            'FactKaimahi'[Index]
			                <= EARLIER( 'FactKaimahi'[Index] )
			                && 'FactKaimahi'[person_id]
			                    = EARLIER( 'FactKaimahi'[person_id] )
			                && 'FactKaimahi'[ActiveStatus] = "Not Active"
			        )
			    )
			RETURN
			    IF(
			        'FactKaimahi'[jobStatus] = "Active" && 'FactKaimahi'[ActiveStatus] = "Active",
			        0,
			        R1
			    )
		formatString: 0
		lineageTag: c2e95925-3e63-4f58-9f1a-687ed8da72bf
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

