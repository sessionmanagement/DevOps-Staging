	partition mdl_prog_ForCertifNames-d292e203-032b-4b24-909a-68186ace2832 = m
		mode: import
		queryGroup: Akoranga
		source = ```
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="SELECT [id] AS [id]#(lf)      ,[category] AS [category]#(lf)      ,[sort_order] AS [sortorder]#(lf)      ,[full_name] AS [fullname]#(lf)      ,[short_name] AS [shortname]#(lf)      ,[id_number] AS [idnumber]#(lf)      ,[summary] AS [summary]#(lf)      ,[end_note] AS [endnote]#(lf)      ,[visible] AS [visible]#(lf)      ,[available_from] AS [availablefrom]#(lf)      ,[available_until] AS [availableuntil]#(lf)      ,[available] AS [available]#(lf)      ,[time_created] AS [timecreated]#(lf)      ,[time_modified] AS [timemodified]#(lf)      ,[user_modified] AS [usermodified]#(lf)      ,[icon] AS [icon]#(lf)      ,[exceptions_sent] AS [exceptionssent]#(lf)      ,[audience_visible] AS [audiencevisible]#(lf)      ,[certif_id] AS [certifid]#(lf)      ,[assignments_deferred] AS [assignmentsdeferred]#(lf)      ,[allow_extension_requests] AS [allowextensionrequests]#(lf)      ,[ODSIsCurrent] AS [ODSIsCurrent]#(lf)      ,[ODSEffectiveFrom] AS [ODSEffectiveFrom]#(lf)      ,[ODSEffectiveTo] AS [ODSEffectiveTo]#(lf)      ,[ODSDMLOperation] AS [ODSDMLOperation]#(lf)      ,[ODSBatchId] AS [ODSBatchId]#(lf)      ,[ODSSourceSystem] AS [ODSSourceSystem]#(lf)  FROM [Akoranga].[mdl_prog]#(lf)  WHERE [ODSIsCurrent] = 1#(lf)  AND [ODSDMLOperation] <> 'D'#(lf)"]),
				    // Selecting specific columns
				    #"Removed Other Columns" = Table.SelectColumns(Source,{"certifid", "timemodified", "timecreated", "idnumber", "shortname", "fullname", "category", "id"}),
				
				    // Removing unwanted columns
				    #"Removed Columns" = Table.RemoveColumns(#"Removed Other Columns",{"timemodified", "timecreated"}),
				
				    // Adding a refresh date column
				    #"Added Refresh Date" = Table.AddColumn(#"Removed Columns", "Refresh Date", each DateTimeZone.FixedLocalNow(), type datetimezone),
				
				    // Changing the type of the refresh date column
				    #"Changed Type" = Table.TransformColumnTypes(#"Added Refresh Date",{{"Refresh Date", type datetime}}),
				
				    // Filtering rows where certifid is not null
				    #"Filtered Rows" = Table.SelectRows(#"Changed Type", each ([certifid] <> null)),
				
				    // Adding a conditional column for short name
				    #"Added Conditional Column" = Table.AddColumn(#"Filtered Rows", "Short Name", 
				        each if [fullname] = "De-escalation" then "De-Escalation" 
				        else if [fullname] = "Helping People to Stop Smoking" then "Smoking" 
				        else if [fullname] = "Managing Actual and Potential Aggression 1" then "Mng Actual & Pot. Aggr 1" 
				        else if [fullname] = "Managing Actual and Potential Aggression 2" then "Mng Actual & Pot. Aggr 2" 
				        else if [fullname] = "Client Rights and Preventing Abuse and Neglect" then "Client Rights" 
				        else if [fullname] = "Infection, Prevention and Control" then "Infection, Prevention & Control" 
				        else if [fullname] = "Medication Management" then "Medication Mgmt" 
				        else if [fullname] = "Safety Interventions 1" then "Safety Int. 1" 
				        else if [fullname] = "Safety Interventions 2" then "Safety Int. 2" 
				        else [fullname], type text)
				in
				    #"Added Conditional Column"
				```

