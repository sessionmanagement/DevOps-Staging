	column 'Completed Date' = IF(mdl_certif_completion_LastCompletions[CompletedDate_Last] = DATE(1970, 01, 01), "Never Certified", FORMAT( mdl_certif_completion_LastCompletions[CompletedDate_Last], "dd/MM/yyyy") )
