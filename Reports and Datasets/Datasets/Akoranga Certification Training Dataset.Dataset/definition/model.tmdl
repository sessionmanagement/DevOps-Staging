model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-NZ
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

/// Akoranga - Learning & Development (previously called Totara)
queryGroup Akoranga

	annotation PBI_QueryGroupOrder = 2

queryGroup 'Akoranga Data Load'

	annotation PBI_QueryGroupOrder = 3

queryGroup RLS

	annotation PBI_QueryGroupOrder = 4

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBIDesktopVersion = 2.137.1102.0 (24.10)

annotation PBI_QueryOrder = ["mdl_course_completions","mdl_course","mdl_user","mdl_facetoface","mdl_facetoface_sessions","mdl_facetoface_sessions_dates","mdl_facetoface_signups","mdl_prog_ForCertifNames","mdl_certif_completion","Additional Access","dim_people_hierarchy","Measures Group","Business_Units","mdl_prog","mdl_user - Remove duplicate Emails","mdl_prog_user_assignment","mdl_prog_user_assignment_removeDuplicateEALDates"]

annotation PBI_ProTooling = ["DevMode"]

ref table mdl_course_completions
ref table mdl_course
ref table mdl_user
ref table mdl_facetoface
ref table mdl_facetoface_sessions
ref table mdl_facetoface_sessions_dates
ref table mdl_facetoface_signups
ref table mdl_prog_ForCertifNames
ref table mdl_certif_completion_LastCompletions
ref table mdl_certif_completion
ref table 'Measures Group'
ref table Business_Units
ref table 'Additional Access'
ref table dim_people_hierarchy

ref role Public
ref role 'Babu Test'
ref role 'Lolita Test'
ref role 'All Access'

ref cultureInfo en-US

