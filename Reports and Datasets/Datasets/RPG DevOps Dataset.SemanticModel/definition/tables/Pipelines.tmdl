/// CI/CD pipeline definitions including name, folder path, and configuration. Source: OData Pipelines entity.
table Pipelines
	lineageTag: 6929ac76-086e-4b2c-8759-a5703e11db52

	/// Surrogate key linking to the Projects dimension table
	column ProjectSK
		dataType: string
		isHidden
		lineageTag: bdf926be-dc93-4d27-92eb-cb20ab81747b
		summarizeBy: none
		sourceColumn: ProjectSK

		annotation SummarizationSetBy = Automatic

	/// Surrogate key uniquely identifying the pipeline definition
	column PipelineSK
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 5ea38763-f2db-4e4a-a38f-e528391c1fd6
		summarizeBy: none
		sourceColumn: PipelineSK

		annotation SummarizationSetBy = Automatic

