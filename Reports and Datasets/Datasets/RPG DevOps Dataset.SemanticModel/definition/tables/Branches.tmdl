		lineageTag: 0e2edc72-a457-4768-8373-890fbe0d9f13
		summarizeBy: none
		sourceColumn: ProjectSK

		annotation SummarizationSetBy = Automatic

	/// Surrogate key uniquely identifying this branch
	column BranchSK
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 05efb845-b280-41ab-ae03-af3d10a97a71
		summarizeBy: none
		sourceColumn: BranchSK

