	column Custom_IsDataAvailable
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 6ab29e67-a835-44d3-b150-47d0ccd7002f
		summarizeBy: none
		sourceColumn: Custom_IsDataAvailable

		annotation SummarizationSetBy = Automatic

	/// Board column name from the Epics board (e.g., New, Prioritized, Active). Calculated column looked up from WorkItemBoardSnapshot via bi-directional relationship.
	column 'Board Column' =
			VAR _col = LOOKUPVALUE(
			    WorkItemBoardSnapshot[ColumnName],
			    WorkItemBoardSnapshot[WorkItemId], WorkItems[WorkItemId]
			)
			RETURN IF(NOT ISBLANK(_col), _col)
		dataType: string
		lineageTag: a2954a54-5e09-44bc-b5e2-158add27bad8
		summarizeBy: none
		sortByColumn: 'Board Column Order'

	/// Sort order for Board Column. Use as Sort By Column for Board Column.
	column 'Board Column Order' =
			VAR _col = LOOKUPVALUE(
			    WorkItemBoardSnapshot[ColumnName],
			    WorkItemBoardSnapshot[WorkItemId], WorkItems[WorkItemId]
			)
			RETURN
			    SWITCH(
			        _col,
			        "New", 1,
			        "To Be Prioritized", 2,
			        "To Be Scoped", 2,
			        "Prioritized", 3,
			        "Active", 4,
			        "With Business", 5,
			        "Under Development", 6,
			        "Completed", 7,
			        "Deprioritised", 8,
			        99
			    )
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 3e24d5ad-0f76-4aea-8b5c-e7da779b4472
		summarizeBy: none

	/// Benefit to business text from WorkItemRPGDetails. Calculated column looked up via WorkItemId to avoid BothDirections cross-filter issues in visuals.
	column 'Benefit To Business' =
			VAR _val = LOOKUPVALUE(
			    WorkItemRPGDetails[BenefitToBusinessText],
			    WorkItemRPGDetails[WorkItemId], FORMAT(WorkItems[WorkItemId], "0")
			)
			RETURN IF(NOT ISBLANK(_val), _val)
		dataType: string
		lineageTag: 08959b65-e73e-4058-8a71-53028b9809a9
		summarizeBy: none

	/// Date when the work item most recently changed board column. Looked up from BoardColumnChangeHistory.
	column 'Board Column Change Date' =
			VAR _id = WorkItems[WorkItemId]
			RETURN CALCULATE(
			    MAX(BoardColumnChangeHistory[ChangeDate]),
			    REMOVEFILTERS(),
			    BoardColumnChangeHistory[WorkItemId] = _id
			)
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: 7cac349f-a045-45af-8956-7ede117842b1
		summarizeBy: none

	/// Previous board column before the current board status, based on the latest board column change row for the work item.
	column 'Previous Status' =
			VAR _CurrentStatus = WorkItems[Board Column]
			VAR _WorkItemId = WorkItems[WorkItemId]
			VAR _LatestChange =
			    TOPN(
			        1,
			        FILTER(
			            ALL(BoardColumnChangeHistory),
			            BoardColumnChangeHistory[WorkItemId] = _WorkItemId
			        ),
			        BoardColumnChangeHistory[ChangeDate], DESC
			    )
			VAR _PreviousStatus = MAXX(_LatestChange, BoardColumnChangeHistory[PreviousBoardColumn])
			RETURN
			    IF(
			        ISBLANK(_CurrentStatus),
			        BLANK(),
			        COALESCE(_PreviousStatus, "Initial")
			    )
		dataType: string
		displayFolder: RPG Board
		lineageTag: 6f4c2ef7-875e-460a-9d4b-10b6a65d34db
		summarizeBy: none

	partition WorkItems = m
		mode: import
		queryGroup: 'DevOps Tables'
		source =
				let
				    Source = OData.Feed("https://analytics.dev.azure.com/EmergeAotearoa/Data%20and%20Analytics/_odata/v3.0-preview/", null, [Implementation="2.0",OmitValues = ODataOmitValues.Nulls,ODataVersion = 4, Headers=[Authorization=fnGetToken()]]),
				    WorkItems_table = Source{[Name="WorkItems",Signature="table"]}[Data]
				in
				    WorkItems_table

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

