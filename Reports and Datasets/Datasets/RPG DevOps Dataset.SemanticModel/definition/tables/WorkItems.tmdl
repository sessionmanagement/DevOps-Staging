	/// Who will use the output of this initiative (e.g., Housing team, Finance Partners).
	column Custom_RPGIntendedAudience
		dataType: string
		lineageTag: 4a8ce525-a682-4121-8356-fe6aafc56fcc
		summarizeBy: none
		sourceColumn: Custom_RPGIntendedAudience

		annotation SummarizationSetBy = Automatic

	/// Sum of estimated max days for all child and grandchild work items, based on T-shirt sizing (XS=1, S=2, M=5, L=10, XL=15). Computed as a calculated column to avoid SUMMARIZECOLUMNS auto-exist issues.
	column 'Epic Estimated Days' =
			VAR _EpicId = WorkItems[WorkItemId]
			VAR _Children = FILTER(ALL(WorkItems), WorkItems[ParentWorkItemId] = _EpicId)
			VAR _ChildIds = SELECTCOLUMNS(_Children, "Id", WorkItems[WorkItemId])
			VAR _Grandchildren = FILTER(ALL(WorkItems), CONTAINSROW(_ChildIds, WorkItems[ParentWorkItemId]))
			VAR _AllDescendants = UNION(
			    SELECTCOLUMNS(_Children, "Sizing", WorkItems[Custom_Sizing]),
			    SELECTCOLUMNS(_Grandchildren, "Sizing", WorkItems[Custom_Sizing])
			)
			VAR _SizedDescendants = FILTER(_AllDescendants, NOT ISBLANK([Sizing]))
			VAR _Total = SUMX(
			    _SizedDescendants,
			    SWITCH(
			        [Sizing],
			        "XS (<1 day)", 1,
			        "S (1-2 days)", 2,
			        "M (3-5 days)", 5,
			        "L (6-10 days)", 10,
			        "XL (10+ days)", 15,
			        0
			    )
			)
			RETURN IF(_Total > 0, _Total)
		dataType: int64
		formatString: 0
		lineageTag: 72cd6fc7-c096-4f20-96ad-7d7198e22237
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// Number of days since this work item was created. Computed at refresh time.
	column 'Days in Backlog' = INT(TODAY() - WorkItems[CreatedDate])
		dataType: int64
		formatString: 0
		lineageTag: 0b6fd488-9185-4e28-90f1-541f36871d47
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// Count of filled RPG detail fields (0-4): Problem Statement, Proposed Solution, Expected Output, Benefit To Business.
	column 'RPG Readiness' =
			VAR _id = FORMAT(WorkItems[WorkItemId], "0")
			VAR _hasProblem = IF(LEN(LOOKUPVALUE(WorkItemRPGDetails[ProblemStatementText], WorkItemRPGDetails[WorkItemId], _id)) > 0, 1, 0)
			VAR _hasSolution = IF(LEN(LOOKUPVALUE(WorkItemRPGDetails[ProposedSolutionText], WorkItemRPGDetails[WorkItemId], _id)) > 0, 1, 0)
			VAR _hasOutput = IF(LEN(LOOKUPVALUE(WorkItemRPGDetails[ExpectedOutputText], WorkItemRPGDetails[WorkItemId], _id)) > 0, 1, 0)
			VAR _hasBenefit = IF(LEN(LOOKUPVALUE(WorkItemRPGDetails[BenefitToBusinessText], WorkItemRPGDetails[WorkItemId], _id)) > 0, 1, 0)
			RETURN _hasProblem + _hasSolution + _hasOutput + _hasBenefit
		dataType: int64
		formatString: 0
		lineageTag: cfb38b89-bba3-49d5-8a46-73a441116120
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// High-level readiness label based on RPG Readiness score (0-4).
	column 'Readiness Status' =
			SWITCH(
			    WorkItems[RPG Readiness],
			    0, "No details provided",
			    1, "Mostly incomplete",
			    2, "Partially complete",
			    3, "Almost ready",
			    4, "Ready for prioritisation",
			    "Unknown"
			)
		dataType: string
		lineageTag: d724b11c-4865-43a0-b419-cd0a5ce694bc
		summarizeBy: none
		sortByColumn: 'RPG Readiness'

