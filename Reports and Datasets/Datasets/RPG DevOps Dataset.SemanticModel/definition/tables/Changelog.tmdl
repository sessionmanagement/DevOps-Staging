/// Version history tracking changes to this semantic model, referencing Azure DevOps work item IDs.
table Changelog
	isHidden
	lineageTag: dd7d704e-afce-4c37-a8ff-f57b26cad25a

	/// Auto-incrementing identifier for each changelog entry.
	column 'Change ID'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: a3b28ccb-3958-44c8-85ce-1542858d93fe
		summarizeBy: count
		sourceColumn: Change ID

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Semantic version number of the dataset release (e.g., 0.0.10).
	column Version
		dataType: string
		isHidden
		lineageTag: 33189ea3-66fe-4474-adc1-eb6b6cc1771d
		summarizeBy: none
		sourceColumn: Version

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Date the change was made.
	column 'Change Date'
		dataType: string
		isHidden
		lineageTag: 97b74fa7-8867-4e57-9510-0ba301981df6
		summarizeBy: none
		sourceColumn: Change Date

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Person who made the change.
	column 'Changed By'
		dataType: string
		isHidden
		lineageTag: d589c588-84df-4bf9-9545-6f04da6000f1
		summarizeBy: none
		sourceColumn: Changed By

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Azure DevOps work item ID linked to this change.
	column 'Feature ID'
		dataType: string
		isHidden
		lineageTag: 65d1b56c-45d7-4aea-a1b2-f9fa1fb26b1c
		summarizeBy: none
		sourceColumn: Feature ID

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Summary of what was changed in this version.
	column Description
		dataType: string
		isHidden
		lineageTag: 87bcb7a2-6f4e-4ac6-a8ea-b9812cc00d34
		summarizeBy: none
		sourceColumn: Description

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Name of the dataset this changelog entry applies to.
	column 'Dataset Name'
		dataType: string
		isHidden
		lineageTag: 85997e8b-916c-4a13-856f-e6898143dbf2
		summarizeBy: none
		sourceColumn: Dataset Name

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition Changelog = m
		mode: import
		queryGroup: Changelog
		source =
				let
				    // Define the table schema without the ChangeID column
				    InitialTable = #table(
				        {"Version", "Change Date", "Changed By", "Feature ID", "Description"},
				        {
				            // Add new entries at the top here
				            {
				                "1.1.0", /* Version */
				                #date(2026, 07, 08),  /* Date */
				                "Mike G.",  /* Changed By */
				                "#14106",  /* Feature ID */
				                "Rebuilt connections to use User Principal instead of account."  /* Description */
				            },
				            {
				                "1.0.0", /* Version */
				                #date(2026, 06, 12),  /* Date */
				                "Thijs B.",  /* Changed By */
				                "#13711",  /* Feature ID */
				                "Initial release to Production"  /* Description */
				            },
				            {
				                "0.0.10", /* Version */
				                #date(2026, 2, 12),  /* Date */
				                "Mike G.",  /* Changed By */
				                "#12773",  /* Feature ID */
				                "Remove WorkItemBenefits table and Formatted Benefit measure; remove raw HTML columns from WorkItemRPGDetails keeping only plain text"  /* Description */
				            },
				            {
				                "0.0.9", /* Version */
				                #date(2026, 2, 12),  /* Date */
				                "Mike G.",  /* Changed By */
				                "#12773",  /* Feature ID */
				                "Add WorkItemRPGDetails table (REST API) fetching Problem Statement, Proposed Solution, and Expected Output fields with HTML-stripped plain text columns"  /* Description */
				            },
				            {
				                "0.0.8", /* Version */
				                #date(2026, 2, 12),  /* Date */
				                "Mike G.",  /* Changed By */
				                "#12773",  /* Feature ID */
				                "Add StatusChangeHistory calculated table extracting meaningful state, RPG status, MoSCoW, and date changes from WorkItemRevisions"  /* Description */
				            },
				            {
				                "0.0.7", /* Version */
				                #date(2026, 2, 12),  /* Date */
				                "Mike G.",  /* Changed By */
				                "#12773",  /* Feature ID */
				                "Add WorkItemBenefits table (REST API) with Formatted Benefit SVG measure and plain text BenefitToBusinessText column"  /* Description */
				            },
				            {
				                "0.0.6", /* Version */
				                #date(2026, 2, 11),  /* Date */
				                "Mike G.",  /* Changed By */
				                "#12773",  /* Feature ID */
				                "Add WorkItemDescriptions table (REST API) with Formatted Description SVG measure and tooltip page for HTML rendering"  /* Description */
				            },
				            {
				                "0.0.5", /* Version */
				                #date(2026, 2, 11),  /* Date */
				                "Mike G.",  /* Changed By */
				                "#12773",  /* Feature ID */
				                "Create TEST-Page with RPG AreaPath filter, 4 slicers (RPG Status, MoSCoW, Work Item Type, Date Range), and 2 tables (Current RPG Work Items, Status Change History)"  /* Description */
				            },
				            {
				                "0.0.4", /* Version */
				                #date(2026, 2, 11),  /* Date */
				                "Mike G.",  /* Changed By */
				                "#12773",  /* Feature ID */
				                "Activate key WorkItems and WorkItemRevisions dimension relationships, deactivate snowflake relationships to resolve ambiguity"  /* Description */
				            },
				            {
				                "0.0.3", /* Version */
				                #date(2026, 2, 11),  /* Date */
				                "Mike G.",  /* Changed By */
				                "#12773",  /* Feature ID */
				                "Fix 52 relationship cardinalities (One:One to Many:One) and remove BothDirections cross-filtering"  /* Description */
				            },
				            {
				                "0.0.2", /* Version */
				                #date(2026, 2, 11),  /* Date */
				                "Mike G.",  /* Changed By */
				                "#12773",  /* Feature ID */
				                "Hide ~124 surrogate key columns and fix DateSK summarizeBy to None"  /* Description */
				            },
				            {
				                "0.0.1", /* Version */
				                #date(2026, 2, 11),  /* Date */
				                "Mike G.",  /* Changed By */
				                "#12773",  /* Feature ID */
				                "Add table and column descriptions for all 26 OData tables (~530 columns)"  /* Description */
				            },
				            {
				                "0.0.0", /* Version */
				                #date(2026, 1, 12),  /* Date */
				                "Mike G.",  /* Changed By */
				                "#12773",  /* Feature ID */
				                "Initial DevOps OData semantic model and report creation"  /* Description */
				            }
				        }
				    ),
				
				    // Reverse the order of the rows so new entries are at the top
				    ReversedTable = Table.ReverseRows(InitialTable),
				
				    // Add an Index column to generate incremental numbers
				    TableWithIndex = Table.AddIndexColumn(ReversedTable, "Change ID", 1, 1, Int64.Type),
				
				    // Add a new column for the parameter "Dataset Name"
				    TableWithParameter = Table.AddColumn(TableWithIndex, "Dataset Name", each #"Semantic Model"),
				
				    // Reorder the columns to place ChangeID first
				    ReorderedColumns = Table.ReorderColumns(TableWithParameter, {"Change ID", "Version", "Change Date", "Changed By", "Feature ID", "Description", "Dataset Name"})
				in
				    ReorderedColumns

	changedProperty = IsHidden

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

