/// Azure DevOps service principal client secret. TEMPORARY value -- rotate after validating the refresh. Stored as a parameter; the token endpoint (login.microsoftonline.com) and DevOps hosts use Anonymous credentials in the Service.
expression paramClientSecret = "KVH8Q~DgFbvuqECCvjOA.j3SNWV3YP7ijKN-LaxT" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
