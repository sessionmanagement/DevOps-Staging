/// Requests an Azure AD client-credentials bearer token for Azure DevOps (scope 499b84ac.../.default). Returns "Bearer <token>" for use as an Authorization header on OData.Feed / Web.Contents calls, enabling Anonymous data-source auth that refreshes in the Power BI Service.
expression fnGetToken =
		() as text =>
		let
		    TenantId     = paramTenantID,
		    ClientId     = paramClientId,
		    ClientSecret = paramClientSecret,
		
		    Body =
		        Uri.BuildQueryString(
		            [
		                client_id     = ClientId,
		                client_secret = ClientSecret,
		                grant_type    = "client_credentials",
		
		                // Azure DevOps
		                scope         = "499b84ac-1321-427f-aa17-267ca6975798/.default"
		            ]
		        ),
		
		    Response =
		        Json.Document(
		            Web.Contents(
		                "https://login.microsoftonline.com",
		                [
		                    RelativePath = TenantId & "/oauth2/v2.0/token",
		                    Headers =
		                    [
		                        #"Content-Type" = "application/x-www-form-urlencoded"
		                    ],
		                    Content = Text.ToBinary(Body)
		                ]
		            )
		        ),
		
		    AccessToken =
		        "Bearer " & Response[access_token]
		
		in
		    AccessToken
	lineageTag: 03df6a86-7189-4cb9-a3ac-06119d843f1e
	queryGroup: Functions

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

