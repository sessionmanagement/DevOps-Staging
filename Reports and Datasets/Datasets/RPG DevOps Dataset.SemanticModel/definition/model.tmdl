/// Self-service semantic model template. Contains reusable components: Date Table, Changelog, Measures table, Model Info documentation tables, connection parameters, and naming convention function. Add your fact and dimension tables, then create measures in the Measures table.
model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-NZ
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Changelog

	annotation PBI_QueryGroupOrder = 0

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 1

queryGroup 'Dim Date'

	annotation PBI_QueryGroupOrder = 2

queryGroup 'Dim Tables'

	annotation PBI_QueryGroupOrder = 3

/// Reusable M functions for data transformation
queryGroup Functions

	annotation PBI_QueryGroupOrder = 4

queryGroup 'Fact Tables'

	annotation PBI_QueryGroupOrder = 5

queryGroup 'DevOps Tables'

	annotation PBI_QueryGroupOrder = 6

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling","TMDLView_Desktop"]

annotation PBI_QueryOrder = ["Changelog","Semantic Model","Server","Database","paramTenantID","paramClientId","paramClientSecret","Date Table","fnApplyNamingConventions","fnGetToken","Areas","BoardLocations","Branches","Dates","Iterations","PipelineRunActivityResults","PipelineJobs","PipelineRuns","Pipelines","PipelineTasks","Processes","Projects","Tags","Teams","TestConfigurations","TestPoints","TestResults","TestResultsDaily","TestRuns","Tests","TestSuites","Users","WorkItemLinks","WorkItemRevisions","WorkItems","WorkItemTypeFields","WorkItemDescriptions","WorkItemRPGDetails","WorkItemBoardSnapshot","BoardColumnSnapshots"]

annotation __LastRPTime = 134279231397329768

