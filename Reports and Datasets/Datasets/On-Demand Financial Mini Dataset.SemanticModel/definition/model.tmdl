model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-NZ
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 'Fact Tables'

	annotation PBI_QueryGroupOrder = 2

queryGroup 'Dim Tables'

	annotation PBI_QueryGroupOrder = 3

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 4

queryGroup 'Role Playing Date Tables'

	annotation PBI_QueryGroupOrder = 5

queryGroup 'Change Log'

	annotation PBI_QueryGroupOrder = 1

queryGroup 'Near Real Time'

	annotation PBI_QueryGroupOrder = 9

queryGroup 'Near Real Time\Refresh Parameters'

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Near Real Time\Theta API'

	annotation PBI_QueryGroupOrder = 1

queryGroup 'Near Real Time\Dimension Values'

	annotation PBI_QueryGroupOrder = 2

queryGroup 'Near Real Time\Transformations'

	annotation PBI_QueryGroupOrder = 4

queryGroup 'Near Real Time\EDW Dim Tables'

	annotation PBI_QueryGroupOrder = 3

annotation PBI_QueryOrder = ["Server","Database","Top N Rows","Real Time Reporting Month History","Parameter Months Ago","Company","Service","Budget Holder","Date Table","Budget Date","Contract","Customer","Department","District","Funder","Funding Agency","Location","Region","Vendor","GL Account","Budget Table","General Ledger Table","LastRefreshDate","Changelog","Latest Company entryNo","Emerge_Aotearoa_Housing_Trust_EntryNo","Emerge_Aotearoa_Limited_EntryNo","Emerge_Aotearoa_Trust_EntryNo","Ignite_Aotearoa_Limited_EntryNo","Mind_and_Body_Consultants_Ltd_EntryNo","glEntries (EAL)","glEntries (EAT)","glEntries (IAL)","glEntries (EAHT)","glEntries (MABC)","API glEntries (All Companies)","BusinessCentral All Dimensions","API_ETL_fact_finance_general_ledger","API_EDW_vw_fact_finance_general_ledger","API GL Import","edw dim_finance_budget_holder","edw dim_finance_contract","edw dim_finance_customer","edw dim_finance_funder","edw dim_finance_funding_agency","edw dim_finance_general_ledger_account","edw dim_finance_vendor","edw dim_department","edw dim_district","edw dim_location","edw dim_region","edw dim_service","edw dim_company","Posting Date","Measures Table"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","CalcGroup","DaxQueryView_Desktop","MCP-PBIModeling"]

annotation __TEdtr = 1

ref table Company
ref table Service
