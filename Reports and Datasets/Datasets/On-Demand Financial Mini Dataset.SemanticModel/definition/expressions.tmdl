expression 'BusinessCentral All Dimensions' =
		let
		    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="WITH cte_dimension_values#(lf)AS (#(lf)#(tab)SELECT MAX(dimensionValueID) AS dimensionValueID,#(lf)#(tab)#(tab)Company_Name,#(lf)#(tab)#(tab)[name] AS DimensionValueName,#(lf)#(tab)#(tab)dimensionCode#(lf)#(tab)FROM [BusinessCentral].[dimensionValues]#(lf)#(tab)WHERE ODSIsCurrent = 1#(lf)#(tab)#(tab)AND blocked = 0#(lf)#(tab)GROUP BY Company_Name,#(lf)#(tab)#(tab)[name],#(lf)#(tab)#(tab)dimensionCode#(lf)#(tab)),#(lf)cte_all_dimensions#(lf)AS (#(lf)#(tab)SELECT dse.dimensionSetID,#(lf)#(tab)#(tab)dse.Company_Name,#(lf)#(tab)#(tab)dse.dimensionCode,#(lf)#(tab)#(tab)dse.dimensionValueName,#(lf)#(tab)#(tab)dv.dimensionValueID#(lf)#(tab)FROM BusinessCentral.dimensionSetEntries dse#(lf)#(tab)LEFT JOIN cte_dimension_values dv ON dse.Company_Name = dv.Company_Name#(lf)#(tab)#(tab)AND dse.dimensionCode = dv.dimensionCode#(lf)#(tab)#(tab)AND dse.dimensionValueName = dv.DimensionValueName#(lf)#(tab)WHERE dse.ODSIsCurrent = 1#(lf)#(tab)#(tab)AND dse.dimensionCode IN (#(lf)#(tab)#(tab)#(tab)'BUDGET HOLDER',#(lf)#(tab)#(tab)#(tab)'CUSTOMER',#(lf)#(tab)#(tab)#(tab)'CONTRACT',#(lf)#(tab)#(tab)#(tab)'DEPARTMENT',#(lf)#(tab)#(tab)#(tab)'DISTRICT',#(lf)#(tab)#(tab)#(tab)'FUNDER',#(lf)#(tab)#(tab)#(tab)'FUNDING AGENCY',#(lf)#(tab)#(tab)#(tab)'LOCATE',#(lf)#(tab)#(tab)#(tab)'REGION',#(lf)#(tab)#(tab)#(tab)'SERVICE NAME',#(lf)#(tab)#(tab)#(tab)'SERVICE TYPE',#(lf)#(tab)#(tab)#(tab)'VENDOR'#(lf)#(tab)#(tab)#(tab))#(lf)#(tab))#(lf)SELECT dimensionSetID,#(lf)#(tab)Company_Name,#(lf)#(tab)dimensionCode,#(lf)#(tab)dimensionValueName,#(lf)#(tab)dimensionValueID#(lf)FROM cte_all_dimensions;"]),
		    BufferedTable = Table.Buffer(Source)
		in
		    BufferedTable
	lineageTag: 9d4b9580-9d29-41f8-8237-39cf621b940c
	queryGroup: 'Near Real Time\Dimension Values'

	annotation PBI_ResultType = Table

expression API_ETL_fact_finance_general_ledger = ```
		let
		    // Original Source table for GL Entries
		    Source = #"API glEntries (All Companies)",
		    // Buffer the Source table
		    BufferedSource = Table.Buffer(Source),
		
		    // Original All Dimensions table
		    AllDimensions = #"BusinessCentral All Dimensions",
		    // Buffer the All Dimensions table
		    BufferedAllDimensions = Table.Buffer(AllDimensions),
		
		    // Join GL Entries with All Dimensions using the buffered tables
		    JoinedTable = Table.NestedJoin(
		        BufferedSource,
		        {"dimensionSetID", "Company_Name"},
		        BufferedAllDimensions,
		        {"dimensionSetID", "Company_Name"},
		        "Dimensions",
		        JoinKind.LeftOuter
		    ),
		    // Expand the joined Dimensions table
		    ExpandedDimensions = Table.ExpandTableColumn(
		        JoinedTable,
		        "Dimensions",
		        {"dimensionCode", "dimensionValueID"},
		        {"Dimension.dimensionCode", "Dimension.dimensionValueID"}
		    ),
		    // Replace null values in dimensionCode with a placeholder
		    ReplacedNulls = Table.ReplaceValue(
		        ExpandedDimensions, 
		        null, 
		        "Unknown", 
		        Replacer.ReplaceValue, 
		        {"Dimension.dimensionCode"}
		    ),
		    // Pivot the dimensions
		    PivotedDimensions = Table.Pivot(
		        ReplacedNulls,
		        List.Distinct(ReplacedNulls[Dimension.dimensionCode]),
		        "Dimension.dimensionCode",
		        "Dimension.dimensionValueID",
		        List.Max
		    ),
		    // Rename columns to match SQL output and adjust case
		    RenamedColumns = Table.RenameColumns(
		        PivotedDimensions,
		        {
		            {"Company_Name", "PartitionKey"},
		            {"entryNo", "RowKey"},
		            {"userID", "User_ID"},
		            {"transactionNo", "Transaction_No_"},
		            {"documentNo", "Document_No_"},
		            {"gLAccountNo", "G_L_Account_No_"},
		            {"sourceNo", "Source_No_"},
		            {"noSeries", "No__Series"},
		            {"sourceCode", "Source_Code"},
		            {"sourceType", "Source_Type"},
		            {"documentType", "Document_Type"},
		            {"genPostingType", "Gen__Posting_Type"},
		            {"gLAccountName", "G_L_Account_Name"},
		            {"genBusPostingGroup", "Gen__Bus__Posting_Group"},
		            {"genProdPostingGroup", "Gen__Prod__Posting_Group"},
		            {"globalDimension1Code", "Global_Dimension_1_Code"},
		            {"postingDate", "Posting_Date"},
		            {"documentDate", "Document_Date"},
		            {"lastModifiedDateTime", "Last_Modified_DateTime"},
		            {"creditAmount", "Credit_Amount"},
		            {"debitAmount", "Debit_Amount"},
		            {"description", "Description"},
		            {"amount", "Amount"}
		        }
		    ),
		    // Add calculated columns
		    AddedColumns = Table.AddColumn(
		        RenamedColumns,
		        "System_Created_Entry",
		        each if [systemCreatedEntry] = null then null else Number.From([systemCreatedEntry])
		    ),
		    AddedCompanyName = Table.AddColumn(
		        AddedColumns,
		        "__CompanyName",
		        each Text.Replace([PartitionKey], "_", " ")
		    ),
		    // Add ODS columns
		    AddedODSColumns1 = Table.AddColumn(
		        AddedCompanyName, 
		        "ODSIsCurrent", 
		        each 1, 
		        type number
		    ),
		    AddedODSColumns2 = Table.AddColumn(
		        AddedODSColumns1, 
		        "ODSEffectiveFrom", 
		        each DateTime.LocalNow(), 
		        type datetime
		    ),
		    AddedODSColumns3 = Table.AddColumn(
		        AddedODSColumns2, 
		        "ODSEffectiveTo", 
		        each DateTime.LocalNow(), 
		        type datetime
		    ),
		    AddedODSColumns4 = Table.AddColumn(
		        AddedODSColumns3, 
		        "ODSDMLOperation", 
		        each "I", 
		        type text
		    ),
		    // Reorder columns to match SQL script
		    ReorderedColumns = Table.SelectColumns(
		        AddedODSColumns4,
		        {
		            "PartitionKey",
		            "RowKey",
		            "BUDGET HOLDER",
		            "CUSTOMER",
		            "CONTRACT",
		            "DEPARTMENT",
		            "DISTRICT",
		            "FUNDER",
		            "FUNDING AGENCY",
		            "LOCATE",
		            "REGION",
		            "SERVICE NAME",
		            "SERVICE TYPE",
		            "VENDOR",
		            "User_ID",
		            "Transaction_No_",
		            "Description",
		            "Document_No_",
		            "G_L_Account_No_",
		            "Source_No_",
		            "No__Series",
		            "Source_Code",
		            "Source_Type",
		            "Document_Type",
		            "Gen__Posting_Type",
		            "G_L_Account_Name",
		            "Gen__Bus__Posting_Group",
		            "Gen__Prod__Posting_Group",
		            "Global_Dimension_1_Code",
		            "System_Created_Entry",
		            "__CompanyName",
		            "Posting_Date",
		            "Document_Date",
		            "Last_Modified_DateTime",
		            "Amount",
		            "Credit_Amount",
		            "Debit_Amount",
		            "ODSIsCurrent",
		            "ODSEffectiveFrom",
		            "ODSEffectiveTo",
		            "ODSDMLOperation"
		        },
		        MissingField.UseNull
		    ),
		    // Change column types where needed
		    #"Changed Type" = Table.TransformColumnTypes(
		        ReorderedColumns,
		        {
		            {"BUDGET HOLDER", Int64.Type}, 
		            {"CUSTOMER", Int64.Type}, 
		            {"CONTRACT", Int64.Type}, 
		            {"DEPARTMENT", Int64.Type}, 
		            {"DISTRICT", Int64.Type}, 
		            {"FUNDER", Int64.Type}, 
		            {"FUNDING AGENCY", Int64.Type}, 
		            {"LOCATE", Int64.Type}, 
		            {"REGION", Int64.Type}, 
		            {"SERVICE NAME", Int64.Type}, 
		            {"SERVICE TYPE", Int64.Type}, 
		            {"VENDOR", Int64.Type}, 
		            {"Posting_Date", type datetime}, 
		            {"Document_Date", type datetime}, 
		            {"__CompanyName", type text}
		        }
		    )
		in
		    #"Changed Type"
		```
	lineageTag: a9695ab1-1c6d-4d45-830c-4c4bbd14c7b1
	queryGroup: 'Near Real Time\Transformations'

