expression API_EDW_vw_fact_finance_general_ledger =
		let
		    // 1) Main Source
		    Source = API_ETL_fact_finance_general_ledger,
		    // Buffer Main Source
		    BufferedSource = Table.Buffer(Source),
		
		    // 2) Dimension Queries
		    //    Make sure each dimension query is itself defined in your PBIX or dataflow, e.g. "edw dim_company"
		    DimCompany = #"edw dim_company",
		    BufferedDimCompany = Table.Buffer(DimCompany),
		
		    DimService = #"edw dim_service",
		    BufferedDimService = Table.Buffer(DimService),
		
		    DimRegion = #"edw dim_region",
		    BufferedDimRegion = Table.Buffer(DimRegion),
		
		    DimLocation = #"edw dim_location",
		    BufferedDimLocation = Table.Buffer(DimLocation),
		
		    DimDistrict = #"edw dim_district",
		    BufferedDimDistrict = Table.Buffer(DimDistrict),
		
		    DimDepartment = #"edw dim_department",
		    BufferedDimDepartment = Table.Buffer(DimDepartment),
		
		    DimFinanceVendor = #"edw dim_finance_vendor",
		    BufferedDimFinanceVendor = Table.Buffer(DimFinanceVendor),
		
		    DimFinanceGLAccount = #"edw dim_finance_general_ledger_account",
		    BufferedDimFinanceGLAccount = Table.Buffer(DimFinanceGLAccount),
		
		    DimFinanceFundingAgency = #"edw dim_finance_funding_agency",
		    BufferedDimFinanceFundingAgency = Table.Buffer(DimFinanceFundingAgency),
		
		    DimFinanceFunder = #"edw dim_finance_funder",
		    BufferedDimFinanceFunder = Table.Buffer(DimFinanceFunder),
		
		    DimFinanceCustomer = #"edw dim_finance_customer",
		    BufferedDimFinanceCustomer = Table.Buffer(DimFinanceCustomer),
		
		    DimFinanceContract = #"edw dim_finance_contract",
		    BufferedDimFinanceContract = Table.Buffer(DimFinanceContract),
		
		    DimFinanceBudgetHolder = #"edw dim_finance_budget_holder",
		    BufferedDimFinanceBudgetHolder = Table.Buffer(DimFinanceBudgetHolder),
		
		    // 3) Perform Joins Using the Buffered Tables
		    //    (Use the buffered versions in Table.NestedJoin)
		
		    // Merge with Company
		    #"Merged queries" = Table.NestedJoin(
		        BufferedSource,
		        {"__CompanyName"},
		        BufferedDimCompany,
		        {"company_name"},
		        "edw dim_company",
		        JoinKind.LeftOuter
		    ),
		    #"Expanded edw dim_company" = Table.ExpandTableColumn(
		        #"Merged queries",
		        "edw dim_company",
		        {"dim_company_key"},
		        {"dim_company_key"}
		    ),
		
		    // Merge with Service
		    #"Merged queries 1" = Table.NestedJoin(
		        #"Expanded edw dim_company",
		        {"__CompanyName", "SERVICE NAME"},
		        BufferedDimService,
		        {"company_name", "service_id"},
		        "edw dim_service",
		        JoinKind.LeftOuter
		    ),
		    #"Expanded edw dim_service" = Table.ExpandTableColumn(
		        #"Merged queries 1",
		        "edw dim_service",
		        {"dim_service_key"},
		        {"dim_service_key"}
		    ),
		
		    // Merge with Region
		    #"Merged queries 2" = Table.NestedJoin(
		        #"Expanded edw dim_service",
		        {"__CompanyName", "REGION"},
		        BufferedDimRegion,
		        {"region_company_name", "region_dimension_value_id"},
		        "edw dim_region",
		        JoinKind.LeftOuter
		    ),
		    #"Expanded edw dim_region" = Table.ExpandTableColumn(
		        #"Merged queries 2",
		        "edw dim_region",
		        {"dim_region_key"},
		        {"dim_region_key"}
		    ),
		
		    // Merge with Location
		    #"Merged queries 3" = Table.NestedJoin(
		        #"Expanded edw dim_region",
		        {"__CompanyName", "LOCATE"},
		        BufferedDimLocation,
		        {"location_company_name", "location_dimension_value_id"},
		        "edw dim_location",
		        JoinKind.LeftOuter
		    ),
		    #"Expanded edw dim_location" = Table.ExpandTableColumn(
		        #"Merged queries 3",
		        "edw dim_location",
		        {"dim_location_key"},
		        {"dim_location_key"}
		    ),
		
		    // Merge with District
		    #"Merged queries 4" = Table.NestedJoin(
		        #"Expanded edw dim_location",
		        {"__CompanyName", "DISTRICT"},
		        BufferedDimDistrict,
		        {"district_company_name", "district_dimension_value_id"},
		        "edw dim_district",
