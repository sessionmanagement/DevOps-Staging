expression 'Real Time Reporting Month History' = 36 meta [IsParameterQuery = true, IsParameterQueryRequired = true, Type = "Number"]
	lineageTag: 66be4fa6-73b0-4d36-b60b-85c8cdf8aedb
	queryGroup: Parameters

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Number

expression 'Parameter Months Ago' =
		let
		    // Access the parameter
		    MonthsToSubtract = #"Real Time Reporting Month History",
		
		    // Get the current date and time
		    CurrentDateTime = DateTime.LocalNow(),
		
		    // Subtract the number of months from the current date and get the first day of that month
		    SubtractedDate = Date.AddMonths(CurrentDateTime, -MonthsToSubtract),
		    FirstOfMonth = #date(Date.Year(SubtractedDate), Date.Month(SubtractedDate), 1),
		
		    // Convert the date to yyyymmdd integer format
		    Year = Date.Year(FirstOfMonth),
		    Month = Date.Month(FirstOfMonth),
		    Day = Date.Day(FirstOfMonth),
		    DateAsInt = Year * 10000 + Month * 100 + Day
		in
		    DateAsInt
	lineageTag: f1f7d745-bf61-4271-973e-261cf5fcd856
	queryGroup: Parameters

