				        }
				    ),
				    #"Added Index" = Table.AddIndexColumn(#"Removed Other Columns", "Index", -100, -1, Int64.Type),
				    #"Renamed Columns" = Table.RenameColumns(#"Added Index", {{"Index", "Fact Finance General Ledger KEY"}}),
				    #"Reordered Columns" = Table.ReorderColumns(
