				            "Finance General Ledger Account Name",
				            "Finance General Ledger Gen Bus Posting Group",
				            "Finance General Ledger Gen Prod Posting Group",
				            "Finance General Ledger Global Dimension 1 Code",
				            "Finance General Ledger System Created Entry",
