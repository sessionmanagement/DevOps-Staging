	partition 'General Ledger Table' = m
		mode: import
		queryGroup: 'Fact Tables'
		source =
				let
				    // 1) Connect to SQL database (unbuffered so query folding is allowed)
				    Source = Sql.Database(Server, Database),
				
				    // 2) Retrieve data from the view
				    edw_vw_fact_finance_general_ledger = Source{[Schema = "edw", Item = "vw_fact_finance_general_ledger"]}[Data],
				
				    // 3) Filter rows on the server side (query folding)
				    FilteredData = Table.SelectRows(
				        edw_vw_fact_finance_general_ledger,
				        each [finance_posting_date_key] >= #"Parameter Months Ago"
				    ),
				
				    // 4) Buffer the "API Fact Finance General Ledger" so it doesn't get re-read
				    APIFactFinanceGeneralLedger = #"API GL Import",
				    BufferedAPIFactFinanceGeneralLedger = Table.Buffer(APIFactFinanceGeneralLedger),
				
				    // 5) Apply naming conventions
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				
				    // 6) Transform column names in FilteredData
				    #"Transformed Column Names" = Table.TransformColumnNames(FilteredData, each ApplyNamingConventions(_)),
				
				    // 7) Remove unneeded columns
				    #"Removed Columns" = Table.RemoveColumns(#"Transformed Column Names", {"DWH Source System", "DWH Dml Operation"}),
				
				    // 8) Add and convert date columns where the column name ends with " Date KEY"
				    #"Added and Converted Date Columns" =
				        List.Accumulate(
				            List.Select(Table.ColumnNames(#"Removed Columns"), each Text.EndsWith(_, " Date KEY")),
				            #"Removed Columns",
				            (state, columnName) =>
				                Table.AddColumn(
				                    state,
				                    Text.BeforeDelimiter(columnName, " KEY"),
				                    each
				                        if Record.Field(_, columnName) <> null then
				                            let
				                                dateValue = Text.From(Record.Field(_, columnName)),
				                                yearPart = Text.Start(dateValue, 4),
				                                monthPart = Text.Middle(dateValue, 4, 2),
				                                dayPart = Text.End(dateValue, 2),
				                                formattedDate = yearPart & "-" & monthPart & "-" & dayPart
				                            in
				                                if Text.Length(dateValue) = 8 then
				                                    Date.FromText(formattedDate)
				                                else
				                                    null
				                        else
				                            null,
				                    type date
				                )
				        ),
				
				    // 9) Change column type for Finance General Ledger Account No
				    #"Changed Type" = Table.TransformColumnTypes(
				        #"Added and Converted Date Columns",
				        {{"Finance General Ledger Account No", Int64.Type}}
				    ),
				
				    // 10) Filter out "Close Income Statement"
				    #"Filtered Rows" = Table.SelectRows(
				        #"Changed Type",
				        each ([Finance General Ledger Description] <> "Close Income Statement")
				    ),
				
				    // 11) Append the buffered table to the filtered table
				    #"Appended Query" = Table.Combine({#"Filtered Rows", BufferedAPIFactFinanceGeneralLedger}),
				
				    // 12) Optional transformations: removing "Finance " prefix in column names
				    #"Removed Finance Prefix" = Table.TransformColumnNames(
				        #"Appended Query",
				        each if Text.StartsWith(_, "Finance ") then Text.AfterDelimiter(_, "Finance ") else _
				    ),
				
				    // 13) Remove columns
				    #"Removed Columns1" = Table.RemoveColumns(
				        #"Removed Finance Prefix",
				        {"DWH Batch ID", "DWH Created At", "DWH Modified On"}
				    ),
				
				    // 14) Replace "General Ledger" with "GL" in column names
				    #"Replaced General Ledger" = Table.TransformColumnNames(
				        #"Removed Columns1",
				        each Text.Replace(_, "General Ledger", "GL")
				    ),
				    #"Inserted Merged Column" = Table.AddColumn(#"Replaced General Ledger", "Merged", each Text.Combine({Text.From([GL Account No], "en-NZ"), "_", [GL Company Name]}), type text),
				    #"Renamed Columns" = Table.RenameColumns(#"Inserted Merged Column",{{"Merged", "Merged_Business_Key"}})
				in
				    #"Renamed Columns"

	annotation PBI_ResultType = Exception

	annotation PBI_NavigationStepName = Navigation

