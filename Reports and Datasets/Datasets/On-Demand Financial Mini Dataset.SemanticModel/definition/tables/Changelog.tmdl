		sourceColumn: Changed By

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'User Story ID'
		dataType: string
		isHidden
		lineageTag: 76be2fb2-0a78-429f-9e17-07128c5fbf1c
		summarizeBy: none
		sourceColumn: User Story ID

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column Description
		dataType: string
		isHidden
		lineageTag: c20d23ee-daad-4a7b-a70c-a5401c239eab
		summarizeBy: none
		sourceColumn: Description

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition Changelog = m
		mode: import
		queryGroup: 'Change Log'
		source =
				let
				    // Define the table schema with the entries reversed
				    InitialTable = #table(
				        {"Version", "Change Date", "Changed By", "User Story ID", "Description"},
				        {
				            // Add new entries at the top here
				            {
				                "0.1.5", /* Version */
				                #date(2026, 09, 18),  /* Date */
				                "Mike G / Gavin",  /* Changed By */
				                "#14603",  /* User Story */
				                "Exposing Service ID."  /* Description */
				            },
				            {
				                "0.1.4", /* Version */
				                #date(2026, 03, 23),  /* Date */
				                "Mike G / Gavin",  /* Changed By */
				                "#13330",  /* User Story */
				                "Pointed GL Account table to current record only, no SCD2."  /* Description */
				            },
				            {
				                "0.1.3", /* Version */
				                #date(2025, 12, 02),  /* Date */
				                "Mike G / John Deyell",  /* Changed By */
				                "#11849",  /* User Story */
				                "Updated summarization settings on 59 ID/KEY columns to prevent accidental aggregation. Added subcategories."  /* Description */
				            },
				            {
				                "0.1.2", /* Version */
				                #date(2025, 09, 25),  /* Date */
				                "Mike G / Gavin R",  /* Changed By */
				                "#11312",  /* User Story */
				                "New DAX measures for the previous month."  /* Description */
				            },
				            {
				                "0.1.1", /* Version */
				                #date(2025, 06, 03),  /* Date */
				                "Mike G / Gavin R",  /* Changed By */
				                "#10348",  /* User Story */
				                "Added Total GL Amount SPLY."  /* Description */
				            },
				            {
				                "0.1.0", /* Version */
				                #date(2025, 06, 03),  /* Date */
				                "Mike G / Gavin R",  /* Changed By */
				                "#10348",  /* User Story */
				                "Corrected Dim Service fiter condition."  /* Description */
				            },
				            {
				                "0.0.10", /* Version */
				                #date(2025, 04, 23),  /* Date */
				                "Mike G / Gavin R",  /* Changed By */
				                "#8167",  /* User Story */
				                "Corrected GL account in dimensionalizing."  /* Description */
				            },
				            {
				                "0.0.9", /* Version */
				                #date(2025, 04, 23),  /* Date */
				                "Mike G / Gavin R",  /* Changed By */
				                "#8167",  /* User Story */
				                "Returned join for GL Account."  /* Description */
				            },
				            {
				                "0.0.8", /* Version */
				                #date(2025, 04, 02),  /* Date */
				                "Mike G / Gavin R",  /* Changed By */
				                "#8167",  /* User Story */
				                "Removed 2 new measures for GL to budget variance integrated code in original ones."  /* Description */
				            },
				            {
				                "0.0.7", /* Version */
				                #date(2025, 03, 27),  /* Date */
				                "Mike G",  /* Changed By */
				                "#8167",  /* User Story */
				                "Added 2 new measures for GL to budget variance that is adjusted for expense category."  /* Description */
				            },
				            {
				                "0.0.6", /* Version */
				                #date(2025, 01, 08),  /* Date */
				                "Mike G",  /* Changed By */
				                "#8167",  /* User Story */
				                "Corrected full year budget."  /* Description */
				            },
				            {
				                "0.0.5", /* Version */
				                #date(2025, 01, 07),  /* Date */
				                "Mike G",  /* Changed By */
				                "#8167",  /* User Story */
				                "Added full year budget and set date table as a date table."  /* Description */
				            },
				            {
				                "0.0.4", /* Version */
				                #date(2025, 01, 06),  /* Date */
				                "Mike G",  /* Changed By */
				                "#8167",  /* User Story */
				                "Set measures to currency or percentage."  /* Description */
				            },
				            {
				                "0.0.3", /* Version */
				                #date(2024, 12, 18),  /* Date */
				                "Mike G",  /* Changed By */
				                "#8167",  /* User Story */
				                "Added JET measures"  /* Description */
				            },
				            {
				                "0.0.2", /* Version */
				                #date(2024, 12, 17),  /* Date */
				                "Mike G",  /* Changed By */
				                "#8167",  /* User Story */
				                "Hiding DWH columns and ID columns except for User ID"  /* Description */
				            },
				            {
				                "0.0.1", /* Version */
				                #date(2024, 12, 06),  /* Date */
				                "Mike G",  /* Changed By */
				                "#8167",  /* User Story */
				                "Cleansing columns"  /* Description */
				            },
				            {
				                "0.0.0", /* Version */
				                #date(2024, 12, 05),  /* Date */
				                "Mike G",  /* Changed By */
				                "#8167",  /* User Story */
				                "Initial release"  /* Description */
				            }
				        }
				    ),
				
				    // Reverse the order of the rows so new entries are at the top
				    ReversedTable = Table.ReverseRows(InitialTable),
				
				    // Add an Index column to generate incremental numbers
				    TableWithIndex = Table.AddIndexColumn(ReversedTable, "Change ID", 1, 1, Int64.Type),
				
				    // Reorder the columns to place ChangeID first
				    ReorderedColumns = Table.ReorderColumns(TableWithIndex, {"Change ID", "Version", "Change Date", "Changed By", "User Story ID", "Description"})
				in
				    ReorderedColumns

	changedProperty = IsHidden

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

