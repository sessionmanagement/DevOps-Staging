	partition DimSupervisor = m
		mode: import
		source =
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="  SELECT [people_id]#(lf)      ,[displayName] AS 'Supervisor Name'#(lf)      ,[isSupervisor]#(lf)      ,[employeeNumber]#(lf)      ,[employmentStatus]#(lf)  FROM [IntelliHR].[people]#(lf)  WHERE ODSIsCurrent = 1#(lf)  AND employeeNumber IS NOT NULL#(lf)"])
				in
