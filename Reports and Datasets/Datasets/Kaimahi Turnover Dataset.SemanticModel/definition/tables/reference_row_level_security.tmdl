	partition reference_row_level_security = m
		mode: import
		queryGroup: Workings
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="-- RLS_type 'Employee' (edw.update_row_level_security_kaimahi): each viewer's mapped kaimahi, mapped to that kaimahi's current IntelliHR business unit#(lf)SELECT DISTINCT#(lf)    e.employee_profile_system_id AS supervisor_person_id,#(lf)    g.employee_id AS supervisor_employee_number,#(lf)    e.employee_name AS supervisor_display_name,#(lf)    e.employee_job_name AS supervisor_job_title,#(lf)    LOWER(LTRIM(RTRIM(g.email))) AS supervisor_email,#(lf)    CAST(NULL AS NVARCHAR(36)) AS supervisor_businessEntity_id,#(lf)    h.employee_company_name AS supervisor_businessEntity_name,#(lf)    e.employee_employment_status AS supervisor_employment_status,#(lf)    bu.business_unit_id AS intellihr_business_unit_id,#(lf)    bu.business_unit_name AS business_unit_name,#(lf)    CAST(NULL AS NVARCHAR(50)) AS intellihr_bc_code#(lf)FROM edw.row_level_security_general AS g#(lf)INNER JOIN edw.dim_employee_hierarchy AS h#(lf)    ON h.employee_id = g.mapped_employee_id#(lf)    AND h.DWHIsCurrent = 1#(lf)    AND h.DWHDMLOperation <> 'D'#(lf)INNER JOIN edw.dim_business_unit_hierarchy AS bu#(lf)    ON bu.business_unit_name = h.employee_Business_unit_name#(lf)    AND bu.DWHDMLOperation <> 'D'#(lf)    AND bu.is_active_flag = 1#(lf)    AND bu.dim_business_unit_hierarchy_key > 0#(lf)LEFT JOIN edw.dim_employee AS e#(lf)    ON e.dim_employee_key = g.dim_employee_key#(lf)WHERE g.RLS_type = 'Employee'#(lf)    AND g.email IS NOT NULL#(lf)    AND LTRIM(RTRIM(g.email)) <> ''#(lf)    AND bu.business_unit_id IS NOT NULL#(lf)    -- own business unit only for people leaders (viewers mapped to at least one other kaimahi), as the legacy isSupervisor rule did#(lf)    AND EXISTS (#(lf)        SELECT 1#(lf)        FROM edw.row_level_security_general AS x#(lf)        WHERE x.RLS_type = 'Employee'#(lf)            AND x.employee_id = g.employee_id#(lf)            AND x.mapped_employee_id <> x.employee_id#(lf)    );"]),
				    #"Lowercased Text" = Table.TransformColumns(Source,{{"supervisor_email", each Text.Lower(Text.Trim(_)), type text}}),
				    #"Removed Duplicates" = Table.Distinct(#"Lowercased Text")
				in
				    #"Removed Duplicates"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

