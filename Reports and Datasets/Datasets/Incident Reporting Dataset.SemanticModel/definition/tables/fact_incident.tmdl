	column DaysOverdue =
			
			IF(
			    AND(
			        RELATED(dim_incident_status[IncidentStatusTypeText]) <> "Completed",
			        fact_incident[IncidentCreatedPlusCompletionAllowance] < TODAY()),
			        DATEDIFF(fact_incident[IncidentCreatedPlusCompletionAllowance],TODAY(),DAY),
			        0
			)
		formatString: 0
		lineageTag: 15fd7a8e-66aa-4ea4-852b-deda2b77443f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column OverdueOrNot =
			
			VAR Today_UTC = DATEVALUE(UTCNOW() + 13 / 24)
			RETURN
			IF(
			    AND(
			        RELATED(dim_incident_status[IncidentStatusTypeText]) <> "Completed",
			        fact_incident[IncidentCreatedPlusCompletionAllowance] < Today_UTC),
			        "Overdue",
			        "Not overdue"
			)
		lineageTag: 005414df-de57-453f-a697-a9a5b044a30d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Severity = RELATED(dim_severity[IncidentSeverityText])
		lineageTag: ccf4b83e-3a91-4a1b-8f27-2cf338f2ddcb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column IncidentCreatedPlusCompletionAllowance =
			
			fact_incident[IncidentCreatedDate] + RELATED(dim_severity[CompletionAllowanceDays])
		formatString: General Date
		lineageTag: 4b7e8122-2aff-4640-bc62-53255bc3fda2
