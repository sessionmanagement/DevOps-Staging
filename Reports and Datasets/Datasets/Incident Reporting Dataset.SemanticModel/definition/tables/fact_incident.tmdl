				    Source = Sql.Database(Server, Database, [Query="Select#(tab)#(tab)fci.dim_client_incident_company_key_incident_id_key As IncidentKey,#(lf)#(tab)#(tab)#(tab)fci.incident_id As IncidentID,#(lf)#(tab)#(tab)#(tab)Cast(fci.incident_date As Date) As IncidentDate,#(lf)#(tab)#(tab)#(tab)Cast(fci.incident_created_date As Date) As IncidentCreatedDate,#(tab)#(tab)#(tab)#(lf)#(tab)#(tab)#(tab)fci.dim_client_incident_company_key_status_type_id_key As CurrentIncidentStatusTypeKey,#(lf)#(tab)#(tab)#(tab)fci.dim_client_team_key As Dim_Client_Team_Unique_Key,#(lf)#(tab)#(tab)#(tab)fci.dim_current_owner_employee_key As CurrentOwnerUserKey,#(lf)#(tab)#(tab)#(tab)fci.dim_current_investigator_employee_key As CurrentInvestigatorUserKey,#(lf)#(tab)#(tab)#(tab)fci.dim_current_reporter_employee_key As CurrentReporterUserKey,#(lf)#(tab)#(tab)#(tab)fci.dim_originator_employee_key As OriginatorKey,#(lf)#(tab)#(tab)#(tab)fci.dim_client_incident_company_key_severity_id_key As IncidentSeverityKey,#(lf)#(tab)#(tab)#(tab)DateDiff(Day, fci.incident_date, fci.incident_created_date) As Latency#(lf)From#(tab)#(tab)edw.vw_fact_client_incident fci#(lf)Where#(tab)#(tab)fci.DWHIsCurrent = 1#(lf)#(tab)And#(tab)#(tab)fci.DWHDMLOperation <> 'D'#(lf)"]),
