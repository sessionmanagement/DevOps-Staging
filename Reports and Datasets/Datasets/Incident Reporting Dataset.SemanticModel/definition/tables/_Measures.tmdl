			)
		formatString: #,0
		lineageTag: 12451e55-a53e-47db-97e1-c44e4d6a0f39

	measure '% Change Incidents' = ```
			
			            DIVIDE(
			                    [Incident Count] - [Incident Count LY],
			                    [Incident Count LY]
			            )
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8d7a7db7-3ea5-4a5c-be35-21332b7aa141

	measure '% Change Incidents by Type' =
			
			DIVIDE(
			    [Incident Category Count] - [Incident Category Count LY],
			    [Incident Category Count LY]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 43a2b0cd-48f3-44b4-9b78-ec1f6f4d015d

	measure 'Severe Incidents Card Formatting' =
			
			VAR _SevereIncidentNumber = CALCULATE([Incident Count],dim_severity[IncidentSeverityText] = "Severe")
			RETURN
			IF(
			    _SevereIncidentNumber > 0,
			    "#F1665A",
			    "#478F8D"
			)
		lineageTag: 5edc80be-363e-458c-ad51-8d7c1578a46b

	measure 'Formatting for Avg Days Open Card' =
			
			VAR _AvgDaysOpen = AVERAGE('fact_incident_open_time'[DaysOpen])
			RETURN
			IF(
			    _AvgDaysOpen > 30,
			    "#F1665A",
			    "#478F8D"
			)
		lineageTag: 1ca362ed-3697-4128-a26f-82d38d386c1d

	measure 'Formatting for Max Days Open Card' =
			
			VAR _MaxDaysOpen = MAX('fact_incident_open_time'[DaysOpen])
			RETURN
			IF(
			    _MaxDaysOpen > 30,
			    "#F1665A",
			    "#478F8D"
			)
		lineageTag: e68960da-bc53-40af-b3f0-de73bfd4be27

	measure 'Number Open Incidents' =
			
