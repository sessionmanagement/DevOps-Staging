			    [Incident Count],
			    dim_incident_status[IncidentStatusTypeText] <> "Completed"
			)
		formatString: #,0
		lineageTag: fc91f59d-4df9-4f3e-897a-27dd0031d785

	measure RefreshedAt_forDisplay = "Data Last Refreshed: " & FORMAT(LASTDATE(LastRefreshed[Date Last Refreshed]), "dd/MM/YYYY - hh:mm am/pm")
