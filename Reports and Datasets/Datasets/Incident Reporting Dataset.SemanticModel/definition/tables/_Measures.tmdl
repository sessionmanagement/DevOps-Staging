			VAR _dim_team_area_bc_client_team_name = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES(dim_team_area[bc.client_team_name]), NOT(ISBLANK(dim_team_area[bc.client_team_name]))), dim_team_area[bc.client_team_name], ASC),
