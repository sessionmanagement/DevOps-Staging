			VAR _dim_severity_IncidentSeverityText = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES(dim_severity[IncidentSeverityText]), NOT(ISBLANK(dim_severity[IncidentSeverityText]))), dim_severity[IncidentSeverityText], ASC),
