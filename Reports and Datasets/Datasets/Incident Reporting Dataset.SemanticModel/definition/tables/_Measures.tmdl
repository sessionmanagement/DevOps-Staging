	measure Incidents_closed_in_time = ```
			
			// This measure calculates the incidents closed in the selected period INCLUDING the open incidents. 
			
			VAR Allsevereincidents = CALCULATE(
			        DISTINCTCOUNT(fact_incident[IncidentKey])
			        ,fact_incident[Severity] IN {"SAC 2 - Harm causing major loss of function and/or requiring significant intervention", "SAC 1 - Death or harm causing severe loss of function and/or requiring lifesaving intervention", "Severe"}
			        )
			
			
			VAR SevereincidentsinTimeframe = CALCULATE(
			        DISTINCTCOUNT(fact_incident[IncidentKey])
			        ,fact_incident[Severity] IN {"SAC 2 - Harm causing major loss of function and/or requiring significant intervention", "SAC 1 - Death or harm causing severe loss of function and/or requiring lifesaving intervention", "Severe"}
			        , fact_incident_open_time[DaysOpen] <= 40 
			        )
			
			
			RETURN
			DIVIDE(SevereincidentsinTimeframe,Allsevereincidents)
			```
		formatString: 0%;-0%;0%
		lineageTag: f2daa4da-c9bb-439d-933b-100f9dbbc70a

	measure 'Incident Count - Label' =
			
			VAR Offset = SELECTEDVALUE('dim_date'[current_date_rolling_month_offset], BLANK())
			RETURN
			    IF (
			        NOT ISBLANK(Offset) && Offset IN { -1, -2, -13 },
			        [Incident Count],
			        BLANK()
			    )
		formatString: #,0
		lineageTag: a61abfb5-3d3e-4519-9105-a9a575a7b056

