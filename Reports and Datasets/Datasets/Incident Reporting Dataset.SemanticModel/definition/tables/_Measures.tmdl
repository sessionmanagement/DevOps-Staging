			RETURN
			IF(
			    (ISBLANK(_FC_dim_date_calendar_date) || _FC_dim_date_calendar_date = "") && (ISBLANK(_FC_dim_date_calendar_year) || _FC_dim_date_calendar_year = "") && (ISBLANK(_FC_dim_date_calendar_quarter_full) || _FC_dim_date_calendar_quarter_full = "") && (ISBLANK(_FC_dim_date_calendar_month_name_short) || _FC_dim_date_calendar_month_name_short = "") && (ISBLANK(_FC_dim_team_area_Company) || _FC_dim_team_area_Company = "") && (ISBLANK(_FC_dim_team_area_AreaParentName) || _FC_dim_team_area_AreaParentName = "") && (ISBLANK(_FC_dim_team_area_AreaName) || _FC_dim_team_area_AreaName = "") && (ISBLANK(_FC_dim_team_area_TeamName) || _FC_dim_team_area_TeamName = "") && (ISBLANK(_FC_dim_team_area_bc_region_name) || _FC_dim_team_area_bc_region_name = "") && (ISBLANK(_FC_dim_team_area_bc_district_name) || _FC_dim_team_area_bc_district_name = "") && (ISBLANK(_FC_dim_team_area_bc_department_name) || _FC_dim_team_area_bc_department_name = "") && (ISBLANK(_FC_dim_team_area_bc_service_name) || _FC_dim_team_area_bc_service_name = "") && (ISBLANK(_FC_dim_team_area_bc_service_type_name) || _FC_dim_team_area_bc_service_type_name = "") && (ISBLANK(_FC_dim_team_area_bc_client_team_name) || _FC_dim_team_area_bc_client_team_name = "") && (ISBLANK(_FC_dim_incident_category_IncidentCategoryFull) || _FC_dim_incident_category_IncidentCategoryFull = "") && (ISBLANK(_FC_dim_severity_IncidentSeverityText) || _FC_dim_severity_IncidentSeverityText = ""),
