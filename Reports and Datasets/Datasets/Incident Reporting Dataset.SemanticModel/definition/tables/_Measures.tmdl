	measure 'Text Field for Yesterday''s Incidents Page' =
			
			CONCATENATE(
			    "Please note that this page only shows corresponding incidents that were created yesterday in RecordBase (" &
			    FORMAT(
			        MAX(dim_date_created_date[calendar_date]),
			        "DD/MM/YYYY"
			    ),
			    ") - also note that the incident may have occurred before the day it was created in RecordBase."
			)
		lineageTag: c8142fc4-7d6d-48b2-bfed-1a7dc75e0a1a

	measure 'Filters Applied' =
			
			VAR _FC_dim_date_calendar_date = IF(ISFILTERED(dim_date[calendar_date]), "INCIDENT DATE RANGE: " & FORMAT(MIN(dim_date[calendar_date]), "dd/MM/yyyy") & " - " & FORMAT(MAX(dim_date[calendar_date]), "dd/MM/yyyy"), BLANK())
			
			VAR _dim_date_calendar_year = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES(dim_date[calendar_year]), NOT(ISBLANK(dim_date[calendar_year]))), dim_date[calendar_year], ASC),
			    "calendar_year_display", dim_date[calendar_year]
			)
			VAR _dim_date_calendar_yearCount = IF(ISFILTERED(dim_date[calendar_year]), COUNTROWS(VALUES(dim_date[calendar_year])), 0)
			VAR _More_dim_date_calendar_year = IF(_dim_date_calendar_yearCount > 5, " and " & (_dim_date_calendar_yearCount - 5) & " more", "")
			VAR _FC_dim_date_calendar_year = IF(_dim_date_calendar_yearCount > 0, "CALENDAR YEARS CHOSEN: " & CONCATENATEX(_dim_date_calendar_year, [calendar_year_display], ", "), BLANK()) & _More_dim_date_calendar_year
			
			VAR _dim_date_calendar_quarter_full = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES(dim_date[calendar_quarter_full]), NOT(ISBLANK(dim_date[calendar_quarter_full]))), dim_date[calendar_quarter_full], ASC),
			    "calendar_quarter_full_display", dim_date[calendar_quarter_full]
			)
			VAR _dim_date_calendar_quarter_fullCount = IF(ISFILTERED(dim_date[calendar_quarter_full]), COUNTROWS(VALUES(dim_date[calendar_quarter_full])), 0)
			VAR _More_dim_date_calendar_quarter_full = IF(_dim_date_calendar_quarter_fullCount > 5, " and " & (_dim_date_calendar_quarter_fullCount - 5) & " more", "")
			VAR _FC_dim_date_calendar_quarter_full = IF(_dim_date_calendar_quarter_fullCount > 0, "QUARTER CHOSEN: " & CONCATENATEX(_dim_date_calendar_quarter_full, [calendar_quarter_full_display], ", "), BLANK()) & _More_dim_date_calendar_quarter_full
			
			VAR _dim_date_calendar_month_name_short = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES(dim_date[calendar_month_name_short]), NOT(ISBLANK(dim_date[calendar_month_name_short]))), dim_date[calendar_month_name_short], ASC),
			    "calendar_month_name_short_display", dim_date[calendar_month_name_short]
			)
			VAR _dim_date_calendar_month_name_shortCount = IF(ISFILTERED(dim_date[calendar_month_name_short]), COUNTROWS(VALUES(dim_date[calendar_month_name_short])), 0)
			VAR _More_dim_date_calendar_month_name_short = IF(_dim_date_calendar_month_name_shortCount > 5, " and " & (_dim_date_calendar_month_name_shortCount - 5) & " more", "")
			VAR _FC_dim_date_calendar_month_name_short = IF(_dim_date_calendar_month_name_shortCount > 0, "MONTHS CHOSEN: " & CONCATENATEX(_dim_date_calendar_month_name_short, [calendar_month_name_short_display], ", "), BLANK()) & _More_dim_date_calendar_month_name_short
			
			VAR _dim_team_area_Company = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES(dim_team_area[Company]), NOT(ISBLANK(dim_team_area[Company]))), dim_team_area[Company], ASC),
			    "Company_display", dim_team_area[Company]
			)
			VAR _dim_team_area_CompanyCount = IF(ISFILTERED(dim_team_area[Company]), COUNTROWS(VALUES(dim_team_area[Company])), 0)
			VAR _More_dim_team_area_Company = IF(_dim_team_area_CompanyCount > 5, " and " & (_dim_team_area_CompanyCount - 5) & " more", "")
			VAR _FC_dim_team_area_Company = IF(_dim_team_area_CompanyCount > 0, "COMPANY CHOSEN: " & CONCATENATEX(_dim_team_area_Company, [Company_display], ", "), BLANK()) & _More_dim_team_area_Company
			
			VAR _dim_team_area_AreaParentName = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES(dim_team_area[AreaParentName]), NOT(ISBLANK(dim_team_area[AreaParentName]))), dim_team_area[AreaParentName], ASC),
			    "AreaParentName_display", dim_team_area[AreaParentName]
			)
			VAR _dim_team_area_AreaParentNameCount = IF(ISFILTERED(dim_team_area[AreaParentName]), COUNTROWS(VALUES(dim_team_area[AreaParentName])), 0)
			VAR _More_dim_team_area_AreaParentName = IF(_dim_team_area_AreaParentNameCount > 5, " and " & (_dim_team_area_AreaParentNameCount - 5) & " more", "")
			VAR _FC_dim_team_area_AreaParentName = IF(_dim_team_area_AreaParentNameCount > 0, "RB PARENT AREAS CHOSEN: " & CONCATENATEX(_dim_team_area_AreaParentName, [AreaParentName_display], ", "), BLANK()) & _More_dim_team_area_AreaParentName
			
			VAR _dim_team_area_AreaName = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES(dim_team_area[AreaName]), NOT(ISBLANK(dim_team_area[AreaName]))), dim_team_area[AreaName], ASC),
			    "AreaName_display", dim_team_area[AreaName]
			)
			VAR _dim_team_area_AreaNameCount = IF(ISFILTERED(dim_team_area[AreaName]), COUNTROWS(VALUES(dim_team_area[AreaName])), 0)
			VAR _More_dim_team_area_AreaName = IF(_dim_team_area_AreaNameCount > 5, " and " & (_dim_team_area_AreaNameCount - 5) & " more", "")
			VAR _FC_dim_team_area_AreaName = IF(_dim_team_area_AreaNameCount > 0, "RB AREAS CHOSEN: " & CONCATENATEX(_dim_team_area_AreaName, [AreaName_display], ", "), BLANK()) & _More_dim_team_area_AreaName
			
			VAR _dim_team_area_TeamName = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES(dim_team_area[TeamName]), NOT(ISBLANK(dim_team_area[TeamName]))), dim_team_area[TeamName], ASC),
			    "TeamName_display", dim_team_area[TeamName]
			)
			VAR _dim_team_area_TeamNameCount = IF(ISFILTERED(dim_team_area[TeamName]), COUNTROWS(VALUES(dim_team_area[TeamName])), 0)
			VAR _More_dim_team_area_TeamName = IF(_dim_team_area_TeamNameCount > 5, " and " & (_dim_team_area_TeamNameCount - 5) & " more", "")
			VAR _FC_dim_team_area_TeamName = IF(_dim_team_area_TeamNameCount > 0, "RB SERVICES CHOSEN: " & CONCATENATEX(_dim_team_area_TeamName, [TeamName_display], ", "), BLANK()) & _More_dim_team_area_TeamName
			
			VAR _dim_team_area_bc_region_name = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES(dim_team_area[bc.region_name]), NOT(ISBLANK(dim_team_area[bc.region_name]))), dim_team_area[bc.region_name], ASC),
			    "bc.region_name_display", dim_team_area[bc.region_name]
			)
			VAR _dim_team_area_bc_region_nameCount = IF(ISFILTERED(dim_team_area[bc.region_name]), COUNTROWS(VALUES(dim_team_area[bc.region_name])), 0)
			VAR _More_dim_team_area_bc_region_name = IF(_dim_team_area_bc_region_nameCount > 5, " and " & (_dim_team_area_bc_region_nameCount - 5) & " more", "")
			VAR _FC_dim_team_area_bc_region_name = IF(_dim_team_area_bc_region_nameCount > 0, "BC REGIONS CHOSEN: " & CONCATENATEX(_dim_team_area_bc_region_name, [bc.region_name_display], ", "), BLANK()) & _More_dim_team_area_bc_region_name
			
			VAR _dim_team_area_bc_district_name = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES(dim_team_area[bc.district_name]), NOT(ISBLANK(dim_team_area[bc.district_name]))), dim_team_area[bc.district_name], ASC),
			    "bc.district_name_display", dim_team_area[bc.district_name]
			)
			VAR _dim_team_area_bc_district_nameCount = IF(ISFILTERED(dim_team_area[bc.district_name]), COUNTROWS(VALUES(dim_team_area[bc.district_name])), 0)
			VAR _More_dim_team_area_bc_district_name = IF(_dim_team_area_bc_district_nameCount > 5, " and " & (_dim_team_area_bc_district_nameCount - 5) & " more", "")
			VAR _FC_dim_team_area_bc_district_name = IF(_dim_team_area_bc_district_nameCount > 0, "BC DISTRICTS CHOSEN: " & CONCATENATEX(_dim_team_area_bc_district_name, [bc.district_name_display], ", "), BLANK()) & _More_dim_team_area_bc_district_name
			
			VAR _dim_team_area_bc_department_name = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES(dim_team_area[bc.department_name]), NOT(ISBLANK(dim_team_area[bc.department_name]))), dim_team_area[bc.department_name], ASC),
			    "bc.department_name_display", dim_team_area[bc.department_name]
			)
			VAR _dim_team_area_bc_department_nameCount = IF(ISFILTERED(dim_team_area[bc.department_name]), COUNTROWS(VALUES(dim_team_area[bc.department_name])), 0)
			VAR _More_dim_team_area_bc_department_name = IF(_dim_team_area_bc_department_nameCount > 5, " and " & (_dim_team_area_bc_department_nameCount - 5) & " more", "")
			VAR _FC_dim_team_area_bc_department_name = IF(_dim_team_area_bc_department_nameCount > 0, "BC DEPARTMENTS CHOSEN: " & CONCATENATEX(_dim_team_area_bc_department_name, [bc.department_name_display], ", "), BLANK()) & _More_dim_team_area_bc_department_name
			
			VAR _dim_team_area_bc_service_name = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES(dim_team_area[bc.service_name]), NOT(ISBLANK(dim_team_area[bc.service_name]))), dim_team_area[bc.service_name], ASC),
			    "bc.service_name_display", dim_team_area[bc.service_name]
			)
			VAR _dim_team_area_bc_service_nameCount = IF(ISFILTERED(dim_team_area[bc.service_name]), COUNTROWS(VALUES(dim_team_area[bc.service_name])), 0)
			VAR _More_dim_team_area_bc_service_name = IF(_dim_team_area_bc_service_nameCount > 5, " and " & (_dim_team_area_bc_service_nameCount - 5) & " more", "")
			VAR _FC_dim_team_area_bc_service_name = IF(_dim_team_area_bc_service_nameCount > 0, "BC SERVICES CHOSEN: " & CONCATENATEX(_dim_team_area_bc_service_name, [bc.service_name_display], ", "), BLANK()) & _More_dim_team_area_bc_service_name
			
			VAR _dim_team_area_bc_service_type_name = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES(dim_team_area[bc.service_type_name]), NOT(ISBLANK(dim_team_area[bc.service_type_name]))), dim_team_area[bc.service_type_name], ASC),
			    "bc.service_type_name_display", dim_team_area[bc.service_type_name]
			)
			VAR _dim_team_area_bc_service_type_nameCount = IF(ISFILTERED(dim_team_area[bc.service_type_name]), COUNTROWS(VALUES(dim_team_area[bc.service_type_name])), 0)
