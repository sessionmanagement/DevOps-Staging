table _Measures
	lineageTag: ed0c1696-2b27-484e-aa11-546df4b7b894

	measure 'Incident Count' =
			
			IF(
			    ISBLANK(
			        DISTINCTCOUNT(fact_incident[IncidentKey])),
			        0,
			        DISTINCTCOUNT(fact_incident[IncidentKey])
			)
		formatString: #,0
		lineageTag: d48f80dc-cecc-4cb5-905a-c5cfc4bd9d5e

	measure 'Incident Category Count' =
			
			CALCULATE(DISTINCTCOUNT(fact_incident_category[IncidentKey]),
			        USERELATIONSHIP(dim_date[calendar_date],fact_incident_category[IncidentDate]))
		formatString: #,0
		lineageTag: 4f6fdb2a-ebe5-463b-a71a-2fae6303a389

	measure 'Title - Incident Summary' = ```
			
			VAR SelectedMonths =
			    VALUES ( dim_date[calendar_month_name_short] )
			VAR NumMonths =
			    CALCULATE ( COUNTROWS ( SelectedMonths ) )
			VAR SelectedQuarters =
			    VALUES ( dim_date[calendar_quarter_full] )
			VAR NumQuarters =
			    CALCULATE ( COUNTROWS ( SelectedQuarters ) )
			RETURN
			IFERROR(
			    IF (
			        NumMonths > 1,
			        "Incident Summary | " & CONCATENATEX ( SelectedQuarters, VALUES ( dim_date[calendar_quarter_full] ) & " | " & CONCATENATEX ( SelectedMonths, dim_date[calendar_month_name_short], ", " ), "" ),
			        IF (
			            NumQuarters = 1,
			            "Incident Summary | " & VALUES ( dim_date[calendar_quarter_full] ) & " | " & CONCATENATEX ( SelectedMonths, dim_date[calendar_month_name_short], ", " ),
			            CONCATENATEX ( SelectedMonths, dim_date[calendar_month_name_short], ", " )
			        )
			    ),"Title"
			)
			
			```
		lineageTag: f6bb27f4-cefd-4ffd-ae0b-e1eab95d1963

	measure NewFiltersApplied =
			
			VAR __Year = IF(ISFILTERED(dim_date[calendar_year]), CONCATENATEX(FILTERS(dim_date[calendar_year]), dim_date[calendar_year], ", "), BLANK())
			VAR __Quarter = IF(ISFILTERED(dim_date[calendar_quarter_full]), CONCATENATEX(FILTERS(dim_date[calendar_quarter_full]), dim_date[calendar_quarter_full], ", "), BLANK())
			VAR __Month = IF(ISFILTERED(dim_date[calendar_month_name_short]), CONCATENATEX(FILTERS(dim_date[calendar_month_name_short]), dim_date[calendar_month_name_short], ", "), BLANK())
			
			VAR __ParentAreas = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(dim_team_area[AreaParentName]), NOT(ISBLANK(dim_team_area[AreaParentName]))), dim_team_area[AreaParentName], ASC),
			    "AreaParentName_display", dim_team_area[AreaParentName]
			)
			VAR __ParentAreasCount = IF(ISFILTERED(dim_team_area[AreaParentName]), COUNTROWS(VALUES(dim_team_area[AreaParentName])), 0)
			VAR __MoreParentAreas = IF(__ParentAreasCount > 10, " and " & (__ParentAreasCount - 10) & " more", "")
			
			VAR __Areas = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(dim_team_area[AreaName]), NOT(ISBLANK(dim_team_area[AreaName]))), dim_team_area[AreaName], ASC),
			    "AreaName_display", dim_team_area[AreaName]
			)
			VAR __AreasCount = IF(ISFILTERED(dim_team_area[AreaName]), COUNTROWS(VALUES(dim_team_area[AreaName])), 0)
			VAR __MoreAreas = IF(__AreasCount > 10, " and " & (__AreasCount - 10) & " more", "")
			
			VAR __Services = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(dim_team_area[TeamName]), NOT(ISBLANK(dim_team_area[TeamName]))), dim_team_area[TeamName], ASC),
			    "TeamName_display", dim_team_area[TeamName]
			)
			VAR __ServicesCount = IF(ISFILTERED(dim_team_area[TeamName]), COUNTROWS(VALUES(dim_team_area[TeamName])), 0)
			VAR __MoreServices = IF(__ServicesCount > 10, " and " & (__ServicesCount - 10) & " more", "")
			
			// Incident Categories Filter Summary
			VAR __IncidentCategories = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(dim_incident_category[IncidentCategoryFull]), NOT(ISBLANK(dim_incident_category[IncidentCategoryFull]))), dim_incident_category[IncidentCategoryFull], ASC),
			    "IncidentCategory_display", dim_incident_category[IncidentCategoryFull]
			)
			VAR __IncidentCategoriesCount = IF(ISFILTERED(dim_incident_category[IncidentCategoryFull]), COUNTROWS(VALUES(dim_incident_category[IncidentCategoryFull])), 0)
			VAR __MoreIncidentCategories = IF(__IncidentCategoriesCount > 10, " and " & (__IncidentCategoriesCount - 10) & " more", "")
			
			// Incident Severities Filter Summary
			VAR __IncidentSeverities = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(dim_severity[IncidentSeverityText]), NOT(ISBLANK(dim_severity[IncidentSeverityText]))), dim_severity[IncidentSeverityText], ASC),
			    "IncidentSeverity_display", dim_severity[IncidentSeverityText]
			)
			VAR __IncidentSeveritiesCount = IF(ISFILTERED(dim_severity[IncidentSeverityText]), COUNTROWS(VALUES(dim_severity[IncidentSeverityText])), 0)
			VAR __MoreIncidentSeverities = IF(__IncidentSeveritiesCount > 10, " and " & (__IncidentSeveritiesCount - 10) & " more", "")
			
			
			VAR _FC_Year = IF(ISBLANK(__Year), BLANK(), "| YEAR(S) CHOSEN: " & __Year)
			VAR _FC_Quarter = IF(ISBLANK(__Quarter), BLANK(), "| QUARTER CHOSEN: " & __Quarter)
			VAR _FC_Month = IF(ISBLANK(__Month), BLANK(), "| MONTH(S) CHOSEN: " & __Month)
			VAR _FC_ParentAreas = IF(__ParentAreasCount > 0, "| PARENT AREAS CHOSEN: " & CONCATENATEX(__ParentAreas, [AreaParentName_display], ", "), BLANK())
			VAR _FC_MoreParentAreas = IF(__ParentAreasCount > 10, " and " & (__ParentAreasCount - 10) & " more", "")
			VAR _FC_Areas = IF(__AreasCount > 0, "| AREAS CHOSEN: " & CONCATENATEX(__Areas, [AreaName_display], ", "), BLANK())
			VAR _FC_MoreAreas = IF(__AreasCount > 10, " and " & (__AreasCount - 10) & " more", "")
			VAR _FC_Services = IF(__ServicesCount > 0, "| SERVICES CHOSEN: " & CONCATENATEX(__Services, [TeamName_display], ", "), BLANK())
			VAR _FC_MoreServices = IF(__ServicesCount > 10, " and " & (__ServicesCount - 10) & " more", "")
			VAR _FC_IncidentCategories = IF(__IncidentCategoriesCount > 0, "| INCIDENT CATEGORIES CHOSEN: " & CONCATENATEX(__IncidentCategories, [IncidentCategory_display], ", "), BLANK())
			VAR _FC_MoreIncidentCategories = IF(__IncidentCategoriesCount > 10, " and " & (__IncidentCategoriesCount - 10) & " more", "")
			VAR _FC_IncidentSeverities = IF(__IncidentSeveritiesCount > 0, "| INCIDENT SEVERITIES CHOSEN: " & CONCATENATEX(__IncidentSeverities, [IncidentSeverity_display], ", "), BLANK())
			VAR _FC_MoreIncidentSeverities = IF(__IncidentSeveritiesCount > 10, " and " & (__IncidentSeveritiesCount - 10) & " more", "")
			
			
			VAR _FirstDate = MIN(dim_date[calendar_date])
			VAR _LastDate = MAX(dim_date[calendar_date])
			RETURN
			"Please note that all data shown is based on the following date range: " & FORMAT(_FirstDate, "dd/MM/YYYY") & " - " & FORMAT(_LastDate, "dd/MM/YYYY") & " " &
			IF(
			    ISBLANK(_FC_Year) && ISBLANK(_FC_Quarter) && ISBLANK(_FC_Month) && ISBLANK(_FC_ParentAreas) && ISBLANK(_FC_Areas) && ISBLANK(_FC_Services) && ISBLANK(_FC_IncidentCategories) && ISBLANK(_FC_IncidentSeverities),
			    "",
			    "-- Summary of filters applied to page: " & _FC_Year & " " & _FC_Quarter & " " & _FC_Month & " " & _FC_ParentAreas & _FC_MoreParentAreas & " " & _FC_Areas & _FC_MoreAreas & " " & _FC_Services & _FC_MoreServices & " " & _FC_IncidentCategories & _FC_MoreIncidentCategories & " " & _FC_IncidentSeverities & _FC_MoreIncidentSeverities
			)
		lineageTag: 81b969f3-c993-4b37-b0ec-b95d48d5eb74

	measure TeamWithMaxIncidents = ```
			
			VAR SelectedPeriodIncidents =
			    CALCULATETABLE (
			        fact_incident,
			        DATESBETWEEN (
			            dim_date[calendar_date],
			            MIN ( dim_date[calendar_date] ),
			            MAX ( dim_date[calendar_date] )
			        )
			    )
			VAR TeamIncidents =
			    SUMMARIZE (
			        SelectedPeriodIncidents,
			        fact_incident[Dim_Client_Team_Unique_Key],
			        "IncidentCount", COUNTROWS ( GROUPBY ( SelectedPeriodIncidents, fact_incident[IncidentKey] ) )
			    )
			VAR MaxIncidents =
			    MAXX ( TeamIncidents, [IncidentCount] )
			VAR TopTeamKey =
			    CALCULATE ( SELECTEDVALUE ( fact_incident[Dim_Client_Team_Unique_Key] ), FILTER ( TeamIncidents, [IncidentCount] = MaxIncidents ) )
			RETURN
			    CALCULATE (
			        SELECTEDVALUE ( dim_team_area[TeamName] ),
			        dim_team_area[dim_client_team_unique_key] = TopTeamKey
			    )
			
			```
		lineageTag: a4d0b923-935c-4d51-bc12-11fa696a5a69

	measure IncidentCountByTeam = ```
			
			VAR SelectedPeriodIncidents =
			    CALCULATETABLE (
			        fact_incident,
			        DATESBETWEEN (
			            dim_date[calendar_date],
			            MIN ( dim_date[calendar_date] ),
			            MAX ( dim_date[calendar_date] )
			        )
			    )
			RETURN
			    COUNTROWS (
			        GROUPBY (
			            FILTER ( SelectedPeriodIncidents, fact_incident[Dim_Client_Team_Unique_Key] = SELECTEDVALUE ( dim_team_area[dim_client_team_unique_key] ) ),
			            fact_incident[IncidentKey]
			        )
			    )
			
			```
		formatString: #,0
		lineageTag: 7ada4c60-3e60-4a86-878a-d1ea691491b2

	measure 'Incident Count LY' =
			
			CALCULATE(
			    [Incident Count],
