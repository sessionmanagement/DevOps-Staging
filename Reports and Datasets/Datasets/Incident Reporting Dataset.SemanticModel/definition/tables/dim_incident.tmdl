	partition dim_incident-c06b6422-02f8-4be1-beac-0f3d0334e25d = m
		mode: import
		queryGroup: Dimensions
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="--======#(lf)--Changed 7/10/2026 - Timi - the URL no longer works - it probably never did for MnB,#(lf)#(lf)#(lf)Select#(tab)#(tab)dci.dim_client_incident_company_key_incident_id_key As IncidentKey,#(lf)#(tab)#(tab)#(tab)dci.incident_id As IncidentID,#(lf)#(tab)#(tab)#(tab)dci.incident_date As IncidentDate,#(lf)#(tab)#(tab)#(tab)dci.incident_title As IncidentTitle,#(lf)#(tab)#(tab)#(tab)dci.incident_description As IncidentDescriptionRaw,#(lf)--=====I've changed this from emergeaotearoa.wildbamboo.co.nz/incidents/incident/default.aspx?incid=', Cast(dci.incident_id As VarChar(10))) As IncidentURL#(lf)--=====I've left off the first bit because it won't blank itself out#(lf)#(tab)#(tab)#(tab)Case when dci.dim_company_key = 1 then Concat('https://app.recordbase.co.nz/incidents/incident/default.aspx?incid=',dci.incident_id ,'&redirect=emergeaotearoa')#(lf)#(tab)#(tab)#(tab)when dci.dim_company_key = 5 then  Concat('https://app.recordbase.co.nz/incidents/incident/default.aspx?incid='    ,dci.incident_id ,'&redirect=mindandbody')#(lf)#(tab)#(tab)#(tab)end as IncidentURL#(lf)From#(tab)#(tab)edw.vw_dim_client_incident dci#(lf)#(tab)Inner Join#(tab)edw.dim_company dc#(lf)#(tab)#(tab)On#(tab)#(tab)dci.dim_company_key = dc.dim_company_key#(lf)#(tab)#(tab)And#(tab)#(tab)dc.DWHIsCurrent = 1#(lf)#(tab)#(tab)And#(tab)#(tab)dc.DWHDMLOperation <> 'D'#(lf)Where#(tab)#(tab)dci.DWHIsCurrent = 1#(lf)#(tab)And#(tab)#(tab)dci.DWHDMLOperation <> 'D'"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

