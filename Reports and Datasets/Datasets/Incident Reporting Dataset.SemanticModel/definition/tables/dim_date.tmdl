	column financial_year_num
		dataType: int64
		formatString: 0
		lineageTag: 4a9f2436-0071-404a-bac6-9bf8e14a9f43
		summarizeBy: none
		sourceColumn: financial_year_num

		annotation SummarizationSetBy = Automatic

	column financial_year_offset =
			
			VAR _currentYear = YEAR(TODAY())
			VAR _selectedYear = dim_date[financial_year_num]
			RETURN
			(_currentYear - _selectedYear)*-1
		formatString: 0
		lineageTag: 4c11b262-f98c-4713-b3f2-f34482a29002
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Calendar Month and Year Short' =
			
			dim_date[calendar_month_name_short] & "-" & RIGHT(YEAR(dim_date[calendar_date]),2)
		lineageTag: 49f8070e-0246-4ffa-98eb-4a04d45a7f82
		summarizeBy: none
		sortByColumn: calendar_last_day_of_month_date

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column calendar_month_offset =
			
			VAR _currentDate = TODAY()
			VAR _selectedDate = dim_date[calendar_date]
			VAR _currentYear = YEAR(_currentDate)
			VAR _currentMonth = MONTH(_currentDate)
			VAR _selectedYear = YEAR(_selectedDate)
			VAR _selectedMonth = MONTH(_selectedDate)
			
			VAR _totalCurrentMonths = (_currentYear * 12) + _currentMonth
			VAR _totalSelectedMonths = (_selectedYear * 12) + _selectedMonth
			
			RETURN
			(_totalCurrentMonths - _totalSelectedMonths) * -1
		formatString: 0
		lineageTag: 788ed550-1cd6-4c9e-a392-80c121f2854f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

