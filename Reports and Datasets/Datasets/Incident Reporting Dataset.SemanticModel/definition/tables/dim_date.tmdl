		source = ```
				let
				    Source = Sql.Database(Server, Database, [Query="-- ============================================================#(lf)-- Model:  Incident Reporting Dataset#(lf)-- Table:  dim_date#(lf)-- Source: native query (complex CTE/window) - emitted in full#(lf)-- Used columns: 14 (mapped 14, unmapped 0)  [full query, not trimmed]#(lf)-- Auto-generated from pbi_complete_dump.csv + model M + EDW/ODS schema.#(lf)-- Review before use; verify joins/filters against the model.#(lf)-- ============================================================#(lf)-- USED model columns: Calendar Month and Year Short; Reporting Month; calendar_date; calendar_last_day_of_month_date; calendar_month_name_short; calendar_month_num; calendar_month_offset; calendar_quarter_full; calendar_year; calendar_year_month; current_date_rolling_month_offset; current_date_rolling_year_offset; financial_year_num; financial_year_offset#(lf)#(lf)Select#(tab)#(tab)*,#(lf)#(tab)#(tab)#(tab)DateDiff(Day, Convert(DateTime, SwitchOffset(Convert(DateTimeOffset, GetDate()),#(lf)#(tab)#(tab)#(tab)#(tab)DatePart(TZOffset, GetDate() At Time Zone 'New Zealand Standard Time'))),#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)dd.calendar_date) As date_offset#(lf)From#(tab)#(tab)edw.dim_date dd#(lf)Where#(tab)#(tab)dd.dim_date_key <> 0#(lf)#(tab)And#(tab)#(tab)dd.calendar_year >= 2015#(lf)#(tab)And#(tab)#(tab)dd.current_date_rolling_year_offset <= 0;#(lf)"]),
				    #"Changed Type" = Table.TransformColumnTypes(
				    Source,
				        {
				            {"financial_year_num", Int64.Type},
				            {"calendar_date", type date}
				        }
				    ),
				
				    // Reference the parameter "Reporting Months Ago"
				    ReportingPeriod = #"Reporting Months Ago",
				
				    // Get the current date and time, and then extract just the date
				    // DateTime.LocalNow() returns the current date and time, DateTime.Date() extracts just the date part
				    Today = DateTime.LocalNow(),
				    TodayDate = DateTime.Date(Today),
				    
				    // Calculate the target month and year based on the current date and the ReportingPeriod parameter
				    TargetDate = Date.AddMonths(TodayDate, -ReportingPeriod),
				    
				    // Create a list of 12 months starting from TargetDate and going 12 months back
				    // List.Transform() applies a function to each item in the original list ({0..12} in this case)
				    TwelveMonthsList = List.Transform({0..12}, each Date.ToText(Date.AddMonths(TargetDate, -_), "yyyy-MM")),
				    
				    // Add a new dynamic calculated column for Reporting Month
				    // This column will label each month relative to the Reporting Month
				    #"Added Reporting Month" = Table.AddColumn(#"Changed Type", "Reporting Month", each 
				        let
				            // Extract the calendar_date from the current row
				            CurrentDate = [calendar_date],
				            
				            // Convert the calendar_date to a string in "yyyy-MM" format for easier comparison
				            CurrentDateStr = Date.ToText(CurrentDate, "yyyy-MM"),
				            
				            // Find the position of the current month in the TwelveMonthsList
				            // If the month is not found, List.PositionOf() returns -1
				            MonthOffset = List.PositionOf(TwelveMonthsList, CurrentDateStr)
				        in
				            // Label the month based on its position in the TwelveMonthsList
				            if MonthOffset = 0 then "Reporting Month"
				            else if MonthOffset = 1 then "1 Month Prior to Reporting Month"
				            else if MonthOffset > 1 then Text.From(MonthOffset) & " Months Prior to Reporting Month"
				            else ""
				    )
				in
				    #"Added Reporting Month"
