	partition incidents_for_escalation = calculated
		mode: import
		source =
				
				CALCULATETABLE(
				    SUMMARIZE(
				        fact_incident,
				        fact_incident[IncidentID],
				        dim_date[calendar_date],
				        "company", LASTNONBLANK(dim_team_area[Company], 1),
				        "incident_area_parent_name", LASTNONBLANK(dim_team_area[AreaParentName], 1),
				        "incident_team_name", LASTNONBLANK(dim_team_area[TeamName], 1),
				        "incident_investigator_name", LASTNONBLANK(dim_user_investigator[PersonFullName], 1),
				        "incident_reporter_name", LASTNONBLANK(dim_user_reporter[PersonFullName], 1),
				        "incident_owner_name", LASTNONBLANK(dim_user_owner[PersonFullName], 1),
				        "incident_status", LASTNONBLANK(dim_incident_status[IncidentStatusTypeText], 1),
				        "incident_category", LASTNONBLANK(dim_incident_category[IncidentCategory], 1),
				        "incident_severity", LASTNONBLANK(dim_severity[IncidentSeverityText], 1),
				        "incident_url", LASTNONBLANK(dim_incident[IncidentURL], 1)
				    ),
				    FILTER(
				        ALL(dim_date),
				        dim_date[calendar_date] = TODAY() - 1
				    ),
				    FILTER(
				        ALL(fact_incident),
				        LASTNONBLANK(dim_incident_category[IncidentCategory], 1) IN {"Death", "Death/Suicide", "Restraint"} ||
				        RELATED(dim_severity[IncidentSeverityText]) IN {"Major", "Severe"}
				    )
				)

	annotation PBI_Id = a279c35cdbd0493c8e7bb1ee36c9cbd8

