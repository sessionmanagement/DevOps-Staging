		source =
				let
				    Source = Sql.Database(Server, Database, [Query="Select#(tab)#(tab)dc.dim_client_key As PersonAndTypeKey,#(lf)#(tab)#(tab)#(tab)dc.client_first_name As PersonFirstName,#(lf)#(tab)#(tab)#(tab)dc.client_last_name As PersonLastName,#(lf)#(tab)#(tab)#(tab)Concat(IsNull(trim(dc.client_first_name), ''), ' ' + IsNull(trim(dc.client_last_name) ,'')) As PersonFullName,#(lf)#(tab)#(tab)#(tab)dc.client_date_of_birth As PersonDateOfBirth,#(lf)#(tab)#(tab)#(tab)dc.client_gender As GenderText,#(lf)#(tab)#(tab)#(tab)Case When dc.primary_ethnicity_group In ('Asian nfd', 'Chinese', 'Indian', 'Other Asian', 'Southeast Asian')#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)Then 'Asian'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)When dc.primary_ethnicity_group In ('European nfd', 'New Zealand European', 'Other European')#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)Then 'European'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)When dc.primary_ethnicity_group In ('Maori')#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)Then N'Māori'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)When dc.primary_ethnicity_group In ('African', 'Latin American', 'Middle Eastern')#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)Then 'Middle Eastern, Latin American, African'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)When dc.primary_ethnicity_group In ('Other Ethnicity')#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)Then 'Other'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)When dc.primary_ethnicity_group In ('Cook Islands Maori', 'Fijian', 'Niuean', 'Other Pacific Peoples', 'Pacific Peoples nfd', 'Samoan', 'Tokelauan', 'Tongan')#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)Then 'Pasifika'#(lf)#(tab)#(tab)#(tab)#(tab)Else 'Unknown/Undisclosed'#(lf)#(tab)#(tab)#(tab)#(tab)End As EthnicityBucket#(lf)From#(tab)#(tab)edw.vw_dim_client dc#(lf)"])
