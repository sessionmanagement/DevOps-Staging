	partition fact_incident_open_time-f1e91176-13ae-419b-80cc-70b215a4765a = m
		mode: import
		queryGroup: Facts
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="Select#(tab)#(tab)fci.dim_client_incident_company_key_incident_id_key As IncidentKey,#(lf)#(tab)#(tab)#(tab)DateDiff(Minute, fci.incident_created_date ,IIf(fci.current_incident_status_type_id = 4, fci.current_incident_status_created_date, GetDate())) As MinutesOpen#(lf)From#(tab)#(tab)edw.vw_fact_client_incident fci#(lf)Where#(tab)#(tab)fci.DWHIsCurrent = 1#(lf)#(tab)And#(tab)#(tab)fci.DWHDMLOperation <> 'D'#(lf)"])
				in
				    Source

