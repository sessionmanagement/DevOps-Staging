				    Source = Sql.Database(Server, Database, [Query="Select#(tab)#(tab)dcict.dim_client_incident_company_key_category_type_id_key As IncidentCategoryTypeKey,#(lf)#(tab)#(tab)#(tab)dcict.incident_category_type_id As IncidentCategoryID,#(lf)#(tab)#(tab)#(tab)dcict.incident_category_type_text As IncidentCategory,#(lf)#(tab)#(tab)#(tab)dcict.incident_category_type_parent_Id As IncidentCategoryParentID,#(lf)#(tab)#(tab)#(tab)dcict.incident_category_type_parent_text As IncidentCategoryParent,#(lf)#(tab)#(tab)#(tab)IIf(dcict.incident_category_type_parent_text = 'Death'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)Or dcict.incident_category_type_parent_text = 'Abuse or Neglect'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)Or dcict.incident_category_type_text = 'Restraint',#(lf)#(tab)#(tab)#(tab)#(tab)'Yes',#(lf)#(tab)#(tab)#(tab)#(tab)'No') As CriticalIncidentYN,#(lf)#(tab)#(tab)#(tab)IIf(IsNull(dcict.incident_category_type_parent_text, 'N/A') In ('N/A', 'Unknown'),#(lf)#(tab)#(tab)#(tab)#(tab)dcict.incident_category_type_text,#(lf)#(tab)#(tab)#(tab)#(tab)dcict.incident_category_type_parent_text + ' - ' + dcict.incident_category_type_text) As IncidentCategoryFull,#(lf)#(tab)#(tab)#(tab)IIf(IsNull(dcict.incident_category_type_parent_text, 'N/A') In ('N/A', 'Unknown'),#(lf)#(tab)#(tab)#(tab)#(tab)dcict.incident_category_type_text,#(lf)#(tab)#(tab)#(tab)#(tab)dcict.incident_category_type_parent_text) As IncidentCategoryPrimaryCalc,#(lf)#(tab)#(tab)#(tab)Case When dcict.incident_category_type_parent_text In ('Abuse or Neglect', 'Verbal Abuse / Aggression')#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)Or dcict.incident_category_type_text In ('Abuse or Neglect', 'Verbal Abuse / Aggression')#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)Then 'Abuse'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)When dcict.incident_category_type_text = 'Death'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)Or (dcict.incident_category_type_text = 'Expected'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)And dcict.incident_category_type_parent_text = 'Death')#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)Then 'Death - Expected'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)When dcict.incident_category_type_text = 'Death/Suicide'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)Or (dcict.incident_category_type_text = 'Unexpected'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)And dcict.incident_category_type_parent_text = 'Death')#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)Then 'Death - Unexpected'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)When dcict.incident_category_type_text = 'Restraint'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)Then 'Restraint'#(tab)-- Ignores the Restraint that is already grouped in Abuse#(lf)#(tab)#(tab)#(tab)#(tab)Else 'Other'#(lf)#(tab)#(tab)#(tab)#(tab)End As IncidentCategoryGroup#(lf)From#(tab)#(tab)edw.vw_dim_client_incident_category_type dcict#(lf)"])
