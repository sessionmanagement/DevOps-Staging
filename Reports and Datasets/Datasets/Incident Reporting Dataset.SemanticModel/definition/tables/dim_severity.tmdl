	column IncidentSeverity =
			
			SWITCH(dim_severity[IncidentSeverityValue]
			,0,"Do Not Use - must choose a SAC Rating"
			,1,"SAC 4 - Requires little or no intervention"
			,2,"SAC 3 - Harm causing short term loss of function and/or requiring minimal additional intervention"
			,3,"SAC 2 - Harm causing major loss of function and/or requiring significant intervention"
			,4,"SAC 1 - Death or harm causing severe loss of function and/or requiring lifesaving intervention"
			,"Other"
			)
		lineageTag: 5557fc8b-0830-4aca-a3d2-6425065b9777
		summarizeBy: none

