		source =
				let
				    Source = Sql.Database(Server, Database, [Query="Select#(tab)#(tab)dcis.dim_client_incident_company_key_severity_id_key As IncidentSeverityKey,#(lf)#(tab)#(tab)#(tab)IIf(IsNumeric(dcis.incident_severity_value) = 1, dcis.incident_severity_value, Null) As IncidentSeverityValue,#(lf)#(tab)#(tab)#(tab)dcis.incident_severity_text As IncidentSeverityText,#(lf)#(tab)#(tab)#(tab)Case When dcis.incident_severity_text Like 'SAC 3%'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)Then 20#(lf)#(tab)#(tab)#(tab)#(tab)When  dcis.incident_severity_text Like 'SAC 4%'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)Then 7#(lf)#(tab)#(tab)#(tab)Else 40#(lf)#(tab)#(tab)#(tab)End As CompletionAllowanceDays#(lf)From#(tab)#(tab)edw.vw_dim_client_incident_severity dcis#(lf)"]),
