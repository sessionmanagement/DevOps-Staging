	partition 'RLS with Additional Access' = m
		mode: import
		queryGroup: Timi
		source =
				let
				    // Load both tables
				    RowLevelSecurity = @#"Row Level Security Timi",
				    AdditionalAccess = #"Additional Access (2)",
				
				    // Join tables
				    JoinedTable = Table.Join(
				        AdditionalAccess, "Person to Impersonate Email", RowLevelSecurity, "User Principal Name", JoinKind.RightOuter
				    ),
				
				    #"Added Conditional Column" = Table.AddColumn(
				        JoinedTable, "Custom", each if [Requester Email] = null then [User Principal Name] else [Requester Email]
				    ),
				
				    #"Removed Columns" = Table.RemoveColumns(
				        #"Added Conditional Column",
				        {
				            "Report",
				            "Requester Email",
				            "Person to Impersonate Email",
				            "Expiry Date",
				            "Access Reason",
				            "Approved By Email",
				            "Approved Date",
				            "Modified",
				            "Created",
				            "Created By Email",
				            "Modified By Email",
				            "Version",
				            "User Principal Name"
				        }
				    ),
				
				    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns", {{"Custom", "User Principal Name"}}),
				
				    #"Reordered Columns" = Table.ReorderColumns(
				        #"Renamed Columns", {"User Principal Name"}
				    ),
				
				    #"Changed Type" = Table.TransformColumnTypes(#"Reordered Columns", {{"User Principal Name", type text}}),
				    #"Appended Query" = Table.Combine({#"Changed Type", #"Row Level Security Timi"}),
				    #"Removed Duplicates" = Table.Distinct(#"Appended Query"),
				    #"Filtered Rows" = Table.SelectRows(#"Removed Duplicates", each ([Tangata Whaiora Team ID] <> null)),
				    #"Inserted Merged Column" = Table.AddColumn(#"Filtered Rows", "RLS Join", each Text.Combine({[Company], "", Text.From([Tangata Whaiora Team ID], "en-NZ")}), type text),
				    #"Replaced Value" = Table.ReplaceValue(#"Inserted Merged Column","Emerge","E",Replacer.ReplaceText,{"RLS Join"}),
				    #"Replaced Value1" = Table.ReplaceValue(#"Replaced Value","Mind and Body","M",Replacer.ReplaceText,{"RLS Join"})
				in
				    #"Replaced Value1"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

