	partition FactJobs-6f04a32f-6d2f-40e0-ae7a-e5b696a5b39d = m
		mode: import
		queryGroup: 'Final Tables'
		source =
				let
				    Source = Table.NestedJoin(#"FactJobs (1) Input Jobs table", {"person_id", "Expanded Date"}, #"FactJobs (2) Group for Job Count", {"person_id", "Expanded Date"}, "FactJobs (2)", JoinKind.LeftOuter),
