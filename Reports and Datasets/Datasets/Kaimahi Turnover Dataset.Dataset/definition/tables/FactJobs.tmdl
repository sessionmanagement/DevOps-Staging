	column LeftOnThisDay = IF(FactJobs[Company End Date] = FactJobs[Expanded Date],1,0)
		formatString: 0
		lineageTag: f2ff6447-f80c-4b08-858d-6eefe379722c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column DaysSinceBirth = DATEDIFF(FactJobs[Date of Birth], [Expanded Date], DAY)
		formatString: 0
		lineageTag: 40b98b12-8727-4c58-a8ea-b4c2bf2eb8d7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ExcludeAsLeaver = IF(FactJobs[Job Count] > FactJobs[LeftOnThisDay],1,0)
		formatString: 0
		lineageTag: db553eec-94d9-4f51-9d6f-73fd02839506
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column TenureDays = DATEDIFF([Company Start Date], [Expanded Date], DAY)
		formatString: 0
		lineageTag: 76014320-5b6d-403b-98c3-acd369cf1500
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Age = FLOOR(DATEDIFF(FactJobs[Date of Birth], [Expanded Date], DAY) / 365.25, 1)
		formatString: 0
		lineageTag: 75b5d525-3d9a-4d47-b700-3fdf8cef25e5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column FTE_Type = IF(FactJobs[FTE] > 0.99, "Full Time", "Part Time")
		lineageTag: 011bc671-6efa-40ed-83cf-83726c7732d8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column HiredToday = IF(FactJobs[Company Start Date] = FactJobs[Expanded Date] && FactJobs[Company End Date] <> FactJobs[Expanded Date],1,0)
		formatString: 0
		lineageTag: a156c971-b6ca-4e1a-aa89-d1d541ebb470
