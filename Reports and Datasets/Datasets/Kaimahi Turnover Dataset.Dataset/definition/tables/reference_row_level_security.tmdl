				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="WITH CTE#(lf)AS (#(lf)#(tab)-- get a dataset of staff who are supervisor and join it back onto itself so we got supervisor as employees#(lf)#(tab)SELECT P.employeeNumber AS employee_number,#(lf)#(tab)#(tab)P.displayName AS employee_display_name,#(lf)#(tab)#(tab)P.primaryEmailAddress_email AS employee_email,#(lf)#(tab)#(tab)J.name AS job_title,#(lf)#(tab)#(tab)P.people_id,#(lf)#(tab)#(tab)P.employmentStatus AS employee_employment_status,#(lf)#(tab)#(tab)P.people_id AS supervisor_person_id,#(lf)#(tab)#(tab)P.employeeNumber AS supervisor_employee_number,#(lf)#(tab)#(tab)P.displayName AS supervisor_display_name,#(lf)#(tab)#(tab)J.name AS supervisor_job_title,#(lf)#(tab)#(tab)P.primaryEmailAddress_email AS supervisor_email,#(lf)#(tab)#(tab)J.[businessEntity_id] AS supervisor_businessEntity_id, --Added Change#(lf)#(tab)#(tab)J.[businessEntity_name] AS supervisor_businessEntity_name, --Added Change#(lf)#(tab)#(tab)P.employmentStatus AS supervisor_employment_status,#(lf)#(tab)#(tab)bu.business_unit_id AS intellihr_business_unit_id,#(lf)#(tab)#(tab)bu.name AS business_unit_name,#(lf)#(tab)#(tab)bu.code AS intellihr_bc_code,#(lf)#(tab)#(tab)0 AS hierarchy_level -- this supervisor to supervisor #(lf)#(tab)FROM IntelliHR.jobs AS J#(lf)#(tab)INNER JOIN IntelliHR.people AS P ON J.person_id = P.people_id#(lf)#(tab)#(tab)AND J.ODSIsCurrent = 1#(lf)#(tab)#(tab)AND P.ODSIsCurrent = 1#(lf)#(tab)#(tab)AND J.isPrimaryJob = 1#(lf)#(tab)#(tab)AND P.isSupervisor = 1#(lf)#(tab)INNER JOIN IntelliHR.business_unit AS bu ON J.businessUnit_id = bu.business_unit_id#(lf)#(tab)#(tab)AND bu.ODSIsCurrent = 1#(lf)#(tab)#(lf)#(tab)UNION#(lf)#(tab)#(lf)#(tab)-- get a dataset of employees and their direct manager#(lf)#(tab)SELECT P.employeeNumber AS employee_number,#(lf)#(tab)#(tab)P.displayName AS employee_display_name,#(lf)#(tab)#(tab)P.primaryEmailAddress_email AS employee_email,#(lf)#(tab)#(tab)J.name AS job_title,#(lf)#(tab)#(tab)P.people_id,#(lf)#(tab)#(tab)P.employmentStatus AS employee_employment_status,#(lf)#(tab)#(tab)J.supervisorPerson_id AS supervisor_person_id,#(lf)#(tab)#(tab)J.supervisorPerson_employeeNumber AS supervisor_employee_number,#(lf)#(tab)#(tab)J.supervisorPerson_displayName AS supervisor_display_name,#(lf)#(tab)#(tab)J.supervisorJob_name AS supervisor_job_title,#(lf)#(tab)#(tab)P1.primaryEmailAddress_email AS supervisor_email,#(lf)#(tab)#(tab)J.[businessEntity_id] AS supervisor_businessEntity_id, --Added Change#(lf)#(tab)#(tab)J.[businessEntity_name] AS supervisor_businessEntity_name, --Added Change#(lf)#(tab)#(tab)P1.employmentStatus AS supervisor_employment_status,#(lf)#(tab)#(tab)bu.business_unit_id AS intellihr_business_unit_id,#(lf)#(tab)#(tab)bu.name AS business_unit_name,#(lf)#(tab)#(tab)bu.code AS intellihr_bc_code,#(lf)#(tab)#(tab)1 AS hierarchy_level#(lf)#(tab)FROM IntelliHR.jobs AS J#(lf)#(tab)INNER JOIN IntelliHR.people AS P ON J.person_id = P.people_id#(lf)#(tab)#(tab)AND J.ODSIsCurrent = 1#(lf)#(tab)#(tab)AND P.ODSIsCurrent = 1#(lf)#(tab)#(tab)AND J.isPrimaryJob = 1#(lf)#(tab)LEFT JOIN IntelliHR.people AS P1 ON J.supervisorPerson_id = P1.people_id#(lf)#(tab)#(tab)AND J.ODSIsCurrent = 1#(lf)#(tab)#(tab)AND P1.ODSIsCurrent = 1#(lf)#(tab)INNER JOIN IntelliHR.business_unit AS bu ON J.businessUnit_id = bu.business_unit_id#(lf)#(tab)#(tab)AND bu.ODSIsCurrent = 1#(lf)#(tab)#(lf)#(tab)UNION#(lf)#(tab)#(lf)#(tab)-- get a dataset of first level supervisors and their direct manager#(lf)#(tab)SELECT P.employeeNumber AS employee_number,#(lf)#(tab)#(tab)P.displayName AS employee_display_name,#(lf)#(tab)#(tab)P.primaryEmailAddress_email AS employee_email,#(lf)#(tab)#(tab)J.name AS job_title,#(lf)#(tab)#(tab)P.people_id,#(lf)#(tab)#(tab)P.employmentStatus AS employee_employment_status,#(lf)#(tab)#(tab)J1.supervisorPerson_id AS supervisor_person_id,#(lf)#(tab)#(tab)J1.supervisorPerson_employeeNumber AS supervisor_employee_number,#(lf)#(tab)#(tab)J1.supervisorPerson_displayName AS supervisor_display_name,#(lf)#(tab)#(tab)J1.supervisorJob_name AS supervisor_job_title,#(lf)#(tab)#(tab)P1.primaryEmailAddress_email AS supervisor_email,#(lf)#(tab)#(tab)J.[businessEntity_id] AS supervisor_businessEntity_id, --Added Change#(lf)#(tab)#(tab)J.[businessEntity_name] AS supervisor_businessEntity_name, --Added Change#(lf)#(tab)#(tab)P1.employmentStatus AS supervisor_employment_status,#(lf)#(tab)#(tab)bu.business_unit_id AS intellihr_business_unit_id,#(lf)#(tab)#(tab)bu.name AS business_unit_name,#(lf)#(tab)#(tab)bu.code AS intellihr_bc_code,#(lf)#(tab)#(tab)2 AS hierarchy_level#(lf)#(tab)FROM IntelliHR.jobs AS J#(lf)#(tab)INNER JOIN IntelliHR.jobs AS J1 ON J.supervisorPerson_id = J1.person_id#(lf)#(tab)#(tab)AND J.ODSIsCurrent = 1#(lf)#(tab)#(tab)AND J1.ODSIsCurrent = 1#(lf)#(tab)INNER JOIN IntelliHR.people AS P ON J.person_id = P.people_id#(lf)#(tab)#(tab)AND J.ODSIsCurrent = 1#(lf)#(tab)#(tab)AND P.ODSIsCurrent = 1#(lf)#(tab)#(tab)AND J.isPrimaryJob = 1#(lf)#(tab)INNER JOIN IntelliHR.people AS P1 ON J1.supervisorPerson_id = P1.people_id#(lf)#(tab)#(tab)AND J1.ODSIsCurrent = 1#(lf)#(tab)#(tab)AND P1.ODSIsCurrent = 1#(lf)#(tab)INNER JOIN IntelliHR.business_unit AS bu ON J.businessUnit_id = bu.business_unit_id#(lf)#(tab)#(tab)AND bu.ODSIsCurrent = 1#(lf)#(tab)WHERE J1.supervisorPerson_id IS NOT NULL#(lf)#(tab)#(lf)#(tab)UNION#(lf)#(tab)#(lf)#(tab)-- get a dataset of second level supervisors and their direct manager#(lf)#(tab)SELECT P.employeeNumber AS employee_number,#(lf)#(tab)#(tab)P.displayName AS employee_display_name,#(lf)#(tab)#(tab)P.primaryEmailAddress_email AS employee_email,#(lf)#(tab)#(tab)J.name AS job_title,#(lf)#(tab)#(tab)P.people_id,#(lf)#(tab)#(tab)P.employmentStatus AS employee_employment_status,#(lf)#(tab)#(tab)J2.supervisorPerson_id AS supervisor_person_id,#(lf)#(tab)#(tab)J2.supervisorPerson_employeeNumber AS supervisor_employee_number,#(lf)#(tab)#(tab)J2.supervisorPerson_displayName AS supervisor_display_