		    #"Changed Type2" = Table.TransformColumnTypes(#"Expanded intellihr people",{{"intellihr people.dateOfBirth", type date}, {"CompanyEndDateOrToday", type date}, {"companyStartDate", type date}, {"CompanyEndDate", type date}}),
