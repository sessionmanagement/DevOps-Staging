		    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="SELECT people_id,#(lf)#(tab)displayName,#(lf)#(tab)gender,#(lf)#(tab)isSupervisor,#(lf)#(tab)employeeNumber,#(lf)        dateOfBirth,#(lf)#(tab)DATEDIFF(YEAR, dateOfBirth, GETDATE()) - CASE WHEN (MONTH(dateOfBirth) > MONTH(GETDATE())) OR (MONTH(dateOfBirth) = MONTH(GETDATE()) AND DAY(dateOfBirth) > DAY(GETDATE())) THEN 1 ELSE 0 END AS [Total Years]#(lf)FROM IntelliHR.people#(lf)WHERE [autoIncrementIntellihrId] <> 100412#(lf)AND [employeeNumber] is not null and [employeeNumber] <> ''#(lf)AND ODSisCurrent=1"]),
