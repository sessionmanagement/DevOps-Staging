model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 'Final Tables'

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Row Level Security'

	annotation PBI_QueryGroupOrder = 1

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 2

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["_Measures","Dim_Date","LastRefreshed","Dim_Employee","fact_pay_run","Dim_Service","Row Level Security Employee","Additional Access","RLS with Additional Access","fact_position_roster","fact_roster","Changelog","Server","Database"]

annotation PBI_ProTooling = ["DevMode","DaxQueryView_Desktop","MCP-PBIModeling"]

ref table Dim_Date
ref table LastRefreshed
ref table Dim_Employee
ref table fact_pay_run
ref table Dim_Service
ref table 'RLS with Additional Access'
ref table fact_position_roster
ref table fact_roster
ref table Changelog

ref role Public
ref role 'Babu Test'
ref role 'Chris Test (2)'
ref role 'Elite - All Access'

ref cultureInfo en-US

