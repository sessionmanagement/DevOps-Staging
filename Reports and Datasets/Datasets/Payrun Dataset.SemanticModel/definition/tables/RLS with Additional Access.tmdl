				    #"Removed Columns" = Table.RemoveColumns(#"Added Conditional Column",{"Report", "Requester Email", "Person to Impersonate Email", "Expiry Date", "Access Reason", "Approved By Email", "Approved Date", "Modified", "Created", "Created By Email", "Modified By Email", "Version", "User Principal Name"}),
				    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns",{{"Custom", "User Principal Name"}}),
				    #"Reordered Columns" = Table.ReorderColumns(#"Renamed Columns",{"User Principal Name", "Dim Service KEY"}),
