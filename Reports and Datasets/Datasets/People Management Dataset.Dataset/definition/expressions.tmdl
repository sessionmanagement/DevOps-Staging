expression IntelliJobs =
		let
		    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="SELECT [jobs_id]#(lf)      ,[person_id]#(lf)      ,[location_id]#(lf)      ,[payGrade_id]#(lf)      ,[businessUnit_id]#(lf)      ,[businessEntity_id]#(lf)      ,[supervisorPerson_displayName]#(lf)      ,[workType]#(lf)      ,[remunerationSchedule_employmentCondition_name] AS 'Employment Condition'#(lf)      ,[remunerationSchedule_baseHourlyRate]#(lf)      ,[remunerationSchedule_baseAnnualSalary]#(lf)      ,[workClass]#(lf)      ,[isPrimaryJob]#(lf)      ,[jobStatus]#(lf)      ,j.[name] AS 'Job Title'#(lf)      ,bu.name AS 'Business Unit'#(lf)      ,[fte]#(lf)      ,[companyStartDate]#(lf)      ,[companyEndDate]#(lf)  FROM [IntelliHR].[jobs] j#(lf)  LEFT JOIN intelliHR.business_unit bu#(lf)  ON j.businessUnit_id = bu.business_unit_id#(lf)  WHERE j.ODSiscurrent = 1#(lf)  AND bu.ODSIsCurrent=1#(lf)  "])
		in
		    Source
