expression working_longest_approved_shifts = ```
		let
		    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="WITH t1 AS (#(lf)    SELECT DISTINCT#(lf)    tse.id AS timesheet_id,#(lf)    wt.is_leave,#(lf)    role_id,#(lf)    approval_status,#(lf)    employee_id,#(lf)    work_type_id,#(lf)    CAST(start_date as date) AS start_date,#(lf)    CAST(end_date as date) AS end_date,#(lf)    DATEADD(HOUR, DATEPART(HOUR, actual_start_time),#(lf)        DATEADD(MINUTE, DATEPART(MINUTE, actual_start_time),#(lf)            DATEADD(SECOND, DATEPART(SECOND, actual_start_time),#(lf)                DATEADD(MILLISECOND, DATEPART(MILLISECOND, actual_start_time),#(lf)                    CAST(CAST(actual_start_date AS DATE) AS DATETIME2)#(lf)                )#(lf)            )#(lf)        )#(lf)    ) AS start_datetime,#(lf)    DATEADD(HOUR, DATEPART(HOUR, actual_end_time),#(lf)        DATEADD(MINUTE, DATEPART(MINUTE, actual_end_time),#(lf)            DATEADD(SECOND, DATEPART(SECOND, actual_end_time),#(lf)                DATEADD(MILLISECOND, DATEPART(MILLISECOND, actual_end_time),#(lf)                    CAST(CAST(actual_end_date AS DATE) AS DATETIME2)#(lf)                )#(lf)            )#(lf)        )#(lf)    ) AS end_datetime#(lf)    FROM [EmpLive].[time_sheets_entries] tse#(lf)    LEFT OUTER JOIN [EmpLive].work_types wt ON tse.work_type_id = wt.id#(lf)    LEFT OUTER JOIN [EmpLive].roles r ON tse.role_id = r.id#(lf)    WHERE (tse.work_type_id = '' OR wt.is_leave = 0)#(lf)    AND approval_status = 'APPROVED'#(lf)    AND (r.name NOT LIKE 'On Call%' OR tse.role_id IS NULL)#(lf)    AND (r.name NOT LIKE 'Test' OR tse.role_id IS NULL)#(lf)), t2 AS (#(lf)    SELECT#(lf)    t1.*,#(lf)    DATEDIFF(MINUTE,t1.start_datetime,t1.end_datetime) AS shift_length_mins,#(lf)    DATEDIFF(MINUTE, LAG(t1.end_datetime) OVER (PARTITION BY employee_id, work_type_id ORDER BY start_datetime), t1.start_datetime) AS time_since_last_shift_mins,#(lf)    LAG(t1.end_datetime) OVER (PARTITION BY employee_id, work_type_id ORDER BY start_datetime) AS prev_end_datetime,#(lf)    CEILING(CAST(DATEDIFF(MINUTE,t1.start_datetime,t1.end_datetime) AS FLOAT) / 60) AS shift_length_hours,#(lf)    DATEDIFF(HOUR, LAG(t1.end_datetime) OVER (PARTITION BY employee_id, work_type_id ORDER BY start_date, start_datetime), t1.start_datetime) AS time_since_last_shift_hours,#(lf)    DATEPART(WEEKDAY,t1.start_date) as day,#(lf)    1 AS count#(lf)    FROM t1#(lf)), t3 AS (#(lf)    SELECT#(lf)    t2.*,#(lf)    CASE WHEN t2.time_since_last_shift_hours >= 2 THEN 1 ELSE 0 END AS new_group_flag#(lf)    FROM t2#(lf)), t4 AS (#(lf)    SELECT#(lf)    t3.*,#(lf)    SUM(t3.new_group_flag) OVER (PARTITION BY t3.employee_id, t3.work_type_id ORDER BY t3.start_datetime) AS group_id,#(lf)    CAST(t3.employee_id AS VARCHAR(20)) + '-' + CAST(t3.work_type_id AS VARCHAR(20)) + '-' + CAST(SUM(t3.new_group_flag) OVER (PARTITION BY t3.employee_id, t3.work_type_id ORDER BY t3.start_datetime) AS VARCHAR(20)) AS group_unique_id#(lf)    FROM t3#(lf))#(lf)SELECT#(lf)t4.*,#(lf)#(lf) #(lf)#(lf)    SUM(#(lf)    CASE WHEN t4.time_since_last_shift_hours < 2 #(lf)    ---added this new_group_flag = 1 to add the first shift into the accummulation#(lf)    or new_group_flag = 1#(lf)    --=======#(lf)    THEN t4.shift_length_hours ELSE 0 END) #(lf)    OVER (PARTITION BY t4.employee_id, t4.work_type_id, t4.group_id ORDER BY t4.start_datetime)#(lf)#(lf) #(lf)#(lf) #(lf)#(lf)AS shift_length_cumulative,#(lf)--====this piece had the number starting at 0, so we've added 1 to make it start at 1.#(lf)(SUM(CASE WHEN t4.time_since_last_shift_hours < 2 #(lf)THEN t4.count ELSE 0 END) OVER (PARTITION BY t4.employee_id, t4.work_type_id, t4.group_id ORDER BY t4.start_datetime)#(lf)) + 1 #(lf)AS number_of_shifts_in_cumulative_sum#(lf)FROM t4#(lf)#(lf)ORDER BY group_id,5,9"])
		,
		    #"Added Custom" = Table.AddColumn(
		    Source, 
		    "Start Date & Time", 
		    each DateTime.ToText([start_datetime], "ddd dd MMM, yyyy (h:mm tt)", "en-US")
		),
		    #"Added Custom1" = Table.AddColumn(
		    #"Added Custom", 
		    "End Date Time", 
		    each DateTime.ToText([end_datetime], "ddd dd MMM, yyyy (h:mm tt)", "en-US")
		),
		    #"Removed Other Columns" = Table.SelectColumns(#"Added Custom1",{"shift_length_cumulative", "group_unique_id"}),
		    #"Grouped Rows" = Table.Group(#"Removed Other Columns", {"group_unique_id"}, {{"LongestShift", each List.Max([shift_length_cumulative]), type nullable number}})
		in
		    #"Grouped Rows"
		```
	lineageTag: af300811-57d8-48da-9541-ec95f9d59eb8
	queryGroup: 'Working Tables'

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

