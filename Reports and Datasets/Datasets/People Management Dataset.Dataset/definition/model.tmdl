model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-NZ
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 'Final Tables'

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Working Tables'

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DimBusinessUnits","dim_people","EmpLiveEmployees","IntelliJobs","IntelliPeople","working_longest_approved_shifts","_Measures","dim_date","WorkTypes","fact_days_worked_by_month","dim_day","fact_approved_shifts","dim_roles","fact_approved_shifts_non_leave","dim_payment_type","fact_pay_slips","LastRefreshed","dim_employee_hierarchy","data_measure_definitions","dim_shift_lengths","Additional Access"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_people
ref table _Measures
ref table dim_date
ref table WorkTypes
ref table fact_days_worked_by_month
ref table dim_day
ref table fact_approved_shifts
ref table dim_roles
ref table fact_approved_shifts_non_leave
ref table dim_payment_type
ref table DimBusinessUnits
ref table fact_pay_slips
ref table LastRefreshed
ref table dim_employee_hierarchy
ref table data_measure_definitions
ref table dim_shift_lengths
ref table 'Additional Access'

ref role 'People Experience'
ref role Public
ref role 'Babu Test'
ref role 'Lolita Test'

ref cultureInfo en-US

