	partition fact_days_worked_by_month = m
		mode: import
		source =
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="-- Days of week worked in month by employee#(lf)SELECT#(lf)t1.employee_id,#(lf)t1.month_start_date,#(lf)t1.[day],#(lf)work_type_id,#(lf)sum(t1.count) as days_worked_on_day_of_week#(lf)FROM#(lf)(#(lf)SELECT DISTINCT#(lf)employee_id,#(lf)start_date,#(lf)DATEPART(WEEKDAY,start_date) as day,#(lf)CAST(CAST(YEAR(start_date) AS VARCHAR(4)) #(lf)+ '/' + CAST(MONTH(start_date) AS VARCHAR(2)) + '/01' AS DATETIME) AS month_start_date,#(lf)--end_date,#(lf)work_type_id,#(lf)1 as [count]#(lf)FROM [EmpLive].[time_sheets_entries]#(lf)WHERE approval_status = 'APPROVED'#(lf)) t1#(lf)GROUP BY #(lf)t1.employee_id,#(lf)t1.month_start_date,#(lf)t1.[day],#(lf)work_type_id"])
				in
				    Source

	annotation PBI_ResultType = Table

