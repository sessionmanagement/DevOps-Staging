	measure 'Number of 24+ hour shifts' = ```
			
			VAR SummaryTable =
			    SUMMARIZE (
			        fact_approved_shifts_non_leave,
			        fact_approved_shifts_non_leave[group_id],
			        fact_approved_shifts_non_leave[employee_id],
			        "LongestShift",
			        MAX(fact_approved_shifts_non_leave[shift_length_cumulative])
			    )
			RETURN
			    CALCULATE (
			        COUNTROWS(FILTER(SummaryTable, [LongestShift] >= 24))
			    )
			
			```
		formatString: 0
		displayFolder: 24 Hour Shifts
		lineageTag: 87948e8f-7845-467d-ac4c-5ca28298cffd

	measure 'Percentage Kaimahi worked 24+ hour shifts' = ```
			
			IF (
			    //If the result of the measures is blank, return 0, otherwise return the result
			    ISBLANK ( DIVIDE ( [Number of Kaimahi with 24+ hour shifts], [Total Kaimahi] ) ),
			    0,
			    //Didivd the number of staff who have worked a 24+ hour shift by the total number of Kaimahi (taking into account filters)
			    DIVIDE ( [Number of Kaimahi with 24+ hour shifts], [Total Kaimahi] )
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 24 Hour Shifts
		lineageTag: 66f60e4a-18a8-4730-aa58-cea61eda72e9

	measure 'Number of Kaimahi with 24+ hour shifts' = ```
			
			CALCULATE (
			    DISTINCTCOUNT ( dim_people[EmpID] ), 
			        FILTER(dim_people,
			            [Number of 24+ hour shifts]
			        )
			)
			```
		formatString: 0
		displayFolder: 24 Hour Shifts
		lineageTag: dc354cf1-cda2-439f-8827-4c6306aa7430

	measure 'Longest Fortnight Worked' = ```
			
			MAXX (
			    SUMMARIZE (
			        fact_pay_slips,
			        fact_pay_slips[pay_period_start_date],
			        fact_pay_slips[employee_id],
			        "TotalHoursWorked",
			        SUM(fact_pay_slips[HoursWorked])
			    ),
			    [TotalHoursWorked]
			)
			
			```
		displayFolder: 96 Hour Fortnights
		lineageTag: 9e0bfb68-8e86-4cf4-b58a-3189790774d1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Mismatches' = CALCULATE(SUM(dim_people[DataPay_total_mismatch_count]))
