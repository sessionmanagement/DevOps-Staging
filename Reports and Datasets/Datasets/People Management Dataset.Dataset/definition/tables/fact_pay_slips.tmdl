	partition fact_pay_slips = m
		mode: import
		source =
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="with __original_data as#(lf)(#(lf)SELECT#(lf)      psg.[pay_packet_row_id]#(lf)      ,psg.[pay_packet_id]#(lf)      ,psg.[employee_id]#(lf)      ,case when psg.[gross_name] like '%addtional%' then 'Additional Hours'#(lf)      else psg.gross_name#(lf)      end as gross_name#(lf)      ,psg.[gross_summary]#(lf)      ,ps.pay_period_start_date#(lf)      ,ps.pay_period_end_date#(lf)      ,ps.pay_packet_type#(lf)      --,psn.net_pay_name#(lf)#(tab)  ,psd.deductions_name#(lf)     ,#(lf)      charindex(' ',gross_summary) as first_blank#(lf)        FROM [DataPay].[employees] as e#(lf)#(tab)#(tab)left join Datapay.pay_slips as ps on ps.employee_id = e.id#(lf)#(tab)#(tab)left join Datapay.pay_slips_gross as psg on ps.pay_packet_id = psg.pay_packet_id #(lf)#(tab)#(tab)--left join Datapay.pay_slips_net as psn on psn.pay_packet_id = ps.pay_packet_id#(lf)#(tab)#(tab)left join Datapay.pay_slips_deductions as psd on psd.pay_packet_id = ps.pay_packet_id#(lf)#(lf)  WHERE e.ODSIsCurrent=1#(lf)  AND ps.ODSIsCurrent=1#(lf)  --AND psn.ODSIsCurrent=1#(lf)  AND psg.ODSIsCurrent=1#(lf)  AND psd.ODSIsCurrent=1#(lf)  --AND net_pay_name = 'Direct Credit Balance' #(lf)  AND deductions_name = 'PAYE'#(lf)  AND pay_packet_type in ('main','manual')#(lf)  AND gross_name IN('Addtional Hours',#(lf)  'Alternative Holiday Payment',#(lf)  'Annual Leave Payment',#(lf)  'Annual Leave Payment - Parental Rate',#(lf)  'Bereavement Leave Payment',#(lf)  'Birthday Leave Payment',#(lf)  'COVID-19 Leave Payment',#(lf)  'Cultural Contribution Payment',#(lf)  'Discretionary Leave Payment',#(lf)  'Discretionary Payment',#(lf)  'Disturbed Hours',#(lf)  'Domestic Violence Leave Payment',#(lf)  'In Lieu Of Notice - Extra Pay',#(lf)  'Long Service Leave Payment',#(lf)  'Meeting Hours',#(lf)  'Ordinary Pay',#(lf)  'Overtime x0.5',#(lf)  'Public Holiday Payment',#(lf)  'Sick Leave Payment',#(lf)  'Study Leave Payment',#(lf)  'Union Leave Payment',#(lf)  'Well Being Leave Payment')#(lf)  )#(lf)#(lf)  select #(lf)  pay_packet_row_id,#(lf)  pay_packet_id,#(lf)  employee_id,#(lf)  gross_name,#(lf)  gross_summary,#(lf)  case #(lf)  when LEFT(gross_summary,4) = 'hour' then CAST (0 AS NVARCHAR)#(lf)  when LEFT(gross_summary,4) = 'days' then CAST (0 AS NVARCHAR)#(lf)  when LEFT(gross_summary,4) = 'week' then CAST (0 AS NVARCHAR)#(lf)  when gross_summary like '%hours%' then #(lf)#(tab)CAST(TRIM(substring(gross_summary,1,first_blank)) AS NVARCHAR)#(lf)    end as Number_Hours,#(lf)  case #(lf)  when LEFT(gross_summary,4) = 'days' then CAST (0 AS NVARCHAR)#(lf)  when gross_summary like '%day%' then #(lf)    CAST(TRIM(substring(gross_summary,1,first_blank)) AS NVARCHAR)#(lf)     end #(lf)     as Number_Days,#(lf)   case#(lf)    when LEFT(gross_summary,4) = 'week' then CAST (0 AS NVARCHAR)#(lf)#(tab)when gross_summary like '%weeks%' and gross_summary not like '%hours%' then #(lf)    CAST(TRIM(substring(gross_summary,1,first_blank)) AS NVARCHAR)#(lf)    end as Number_Weeks ,#(lf)     pay_period_start_date,#(lf)    pay_period_end_date,#(lf)    pay_packet_type,#(lf)#(tab)--net_pay_name,#(lf)#(tab)deductions_name#(lf)#(lf)  from __original_data"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Number_Hours", type number}, {"Number_Days", type number}, {"Number_Weeks", type number}}),
				    #"Added Conditional Column" = Table.AddColumn(#"Changed Type", "HoursWorked", each if [Number_Hours] is null then [Number_Days] * 8 else [Number_Hours], type any),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Added Conditional Column",{{"HoursWorked", type number}})
				in
				    #"Changed Type1"

	annotation PBI_ResultType = Table

