	partition fact_approved_shifts = m
		mode: import
		source = ```
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="SELECT#(lf)t2.*,#(lf)CASE WHEN t2.time_since_last_shift_hours < 2 THEN t2.shift_length_hours + LAG(t2.shift_length_hours) OVER (PARTITION BY t2.employee_id, t2.work_type_id ORDER BY t2.start_datetime)#(lf)ELSE t2.shift_length_hours END AS shift_length_cumulative#(lf)FROM (#(lf)SELECT#(lf)t1.*,#(lf)DATEDIFF(MINUTE,t1.start_datetime,t1.end_datetime) AS shift_length_mins,#(lf)DATEDIFF(MINUTE, LAG(t1.end_datetime) OVER (PARTITION BY employee_id, work_type_id ORDER BY start_datetime), t1.start_datetime) AS time_since_last_shift_mins,#(lf)LAG(t1.end_datetime) OVER (PARTITION BY employee_id, work_type_id ORDER BY start_datetime) AS prev_end_datetime,#(lf)CEILING(CAST(DATEDIFF(MINUTE,t1.start_datetime,t1.end_datetime) AS FLOAT) / 60) AS shift_length_hours,#(lf)DATEDIFF(HOUR, LAG(t1.end_datetime) OVER (PARTITION BY employee_id, work_type_id ORDER BY start_date, start_datetime), t1.start_datetime) AS time_since_last_shift_hours,#(lf)DATEPART(WEEKDAY,t1.start_date) as day,#(lf)1 AS count#(lf)FROM (#(lf)    SELECT DISTINCT#(lf)    id AS timesheet_id,#(lf)#(tab)role_id,#(lf)#(tab)approval_status,#(lf)    employee_id,#(lf)    work_type_id,#(lf)    CAST(start_date as date) AS start_date,#(lf)    CAST(end_date as date) AS end_date,#(lf)      DATEADD(HOUR, DATEPART(HOUR, actual_start_time),#(lf)        DATEADD(MINUTE, DATEPART(MINUTE, actual_start_time),#(lf)          DATEADD(SECOND, DATEPART(SECOND, actual_start_time),#(lf)            DATEADD(MILLISECOND, DATEPART(MILLISECOND, actual_start_time),#(lf)              CAST(CAST(actual_start_date AS DATE) AS DATETIME2)#(lf)            )#(lf)          )#(lf)        )#(lf)      ) AS start_datetime,#(lf)      DATEADD(HOUR, DATEPART(HOUR, actual_end_time),#(lf)        DATEADD(MINUTE, DATEPART(MINUTE, actual_end_time),#(lf)          DATEADD(SECOND, DATEPART(SECOND, actual_end_time),#(lf)            DATEADD(MILLISECOND, DATEPART(MILLISECOND, actual_end_time),#(lf)              CAST(CAST(actual_end_date AS DATE) AS DATETIME2)#(lf)            )#(lf)          )#(lf)        )#(lf)      ) AS end_datetime#(lf)    FROM [EmpLive].[time_sheets_entries]#(lf)    --WHERE approval_status = 'APPROVED'#(lf)) AS t1#(lf)) AS t2"]),
				    #"Added Custom" = Table.AddColumn(
				    Source, 
				    "Start Date & Time", 
				    each DateTime.ToText([start_datetime], "dddd MMM yyyy (h:mm tt)", "en-US")
				),
				    #"Added Custom1" = Table.AddColumn(
				    #"Added Custom", 
				    "End Date Time", 
				    each DateTime.ToText([end_datetime], "dddd MMM yyyy (h:mm tt)", "en-US")
				)
				in
				    #"Added Custom1"
				```

	annotation PBI_ResultType = Table

