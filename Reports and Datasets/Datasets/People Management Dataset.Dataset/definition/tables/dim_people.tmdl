	partition dim_people = m
		mode: import
		queryGroup: 'Final Tables'
		source =
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="SELECT [id]#(lf)    ,de.[company_id]#(lf)    ,de.[code]#(lf)    ,preferred_name AS DataPay_preferred_name#(lf)    ,first_name AS DataPay_first_name#(lf)    ,last_name AS DataPay_last_name#(lf)    ,tenure_value AS DataPay_work_class#(lf)    ,[employment_conditions_free_text_1_value] AS DataPay_employment_conditions#(lf)    ,cs.level3_name AS DataPay_business_unit#(lf)    ,occupation_value AS DataPay_job_title#(lf)    ,pay_rate_value AS DataPay_pay_rate_value#(lf)    ,pay_rate_option_value AS DataPay_pay_rate_option_value#(lf)    ,pay_setup_value AS DataPay_pay_setup_value#(lf)    ,standard_hours_per_week_value AS DataPay_standard_hours_per_week_value#(lf)    ,hours_per_cycle_free_text_8_value AS DataPay_hours_per_cycle_value#(lf)FROM [Datapay].[employees] de#(lf)    LEFT JOIN Datapay.cost_structures cs ON de.home_cost_box_value = cs.level3_cost_box_id#(lf)WHERE #(lf)    de.ODSIsCurrent = 1#(lf)    AND de.termination_date IS NULL#(lf)    AND cs.ODSIsCurrent=1#(lf)#(lf)"]),
				    #"Merged Queries" = Table.NestedJoin(Source, {"code"}, IntelliPeople, {"employeeNumber"}, "IntelliPeople", JoinKind.LeftOuter),
				    #"Expanded IntelliPeople" = Table.ExpandTableColumn(#"Merged Queries", "IntelliPeople", {"people_id", "displayName", "dateOfBirth", "gender", "primaryEmailAddress_email", "employmentStatus"}, {"people_id", "displayName", "dateOfBirth", "gender", "primaryEmailAddress_email", "employmentStatus"}),
				    #"Merged Queries1" = Table.NestedJoin(#"Expanded IntelliPeople", {"people_id"}, IntelliJobs, {"person_id"}, "IntelliJobs", JoinKind.LeftOuter),
				    #"Expanded IntelliJobs" = Table.ExpandTableColumn(#"Merged Queries1", "IntelliJobs", {"businessUnit_id", "supervisorPerson_displayName", "workType", "Employment Condition", "remunerationSchedule_baseHourlyRate", "remunerationSchedule_baseAnnualSalary", "workClass", "isPrimaryJob", "jobStatus", "Job Title", "Business Unit", "fte", "companyStartDate", "companyEndDate"}, {"businessUnit_id", "supervisorPerson_displayName", "workType", "Employment Condition", "remunerationSchedule_baseHourlyRate", "remunerationSchedule_baseAnnualSalary", "workClass", "isPrimaryJob", "jobStatus", "Job Title", "Business Unit", "fte", "companyStartDate", "companyEndDate"}),
				    #"Filtered Rows" = Table.SelectRows(#"Expanded IntelliJobs", each [isPrimaryJob] = 1),
				    #"Merged Queries2" = Table.NestedJoin(#"Filtered Rows", {"code"}, EmpLiveEmployees, {"reference_number"}, "EmpLiveEmployees", JoinKind.LeftOuter),
				    #"Expanded EmpLiveEmployees" = Table.ExpandTableColumn(#"Merged Queries2", "EmpLiveEmployees", {"id"}, {"id.1"}),
				    #"Removed Duplicates" = Table.Distinct(#"Expanded EmpLiveEmployees", {"id.1"}),
				    #"Filtered Rows1" = Table.SelectRows(#"Removed Duplicates", each [id.1] <> null and [id.1] <> ""),
				    #"Renamed Columns" = Table.RenameColumns(#"Filtered Rows1", {{"displayName", "Kaimahi"}, {"workClass", "Work Class"}, {"code", "EmpID"}, {"supervisorPerson_displayName", "Supervisor"}, {"id.1", "EmpLive_EmpID"}, {"workType", "Work Type"}, {"jobStatus", "Job Status"}}),
				    #"Added DataPay Work Class Mismatch Flag" = Table.AddColumn(
				        #"Renamed Columns",
				        "DataPay_work_class_mismatch_flag",
				        each
				            let
				                dataPayWorkClass =
				                    if [DataPay_work_class] = null
				                    then ""
				                    else Text.Upper(Text.Trim(Text.Clean(Text.From([DataPay_work_class])))),
				                workClass =
				                    if [#"Work Class"] = null
				                    then ""
				                    else Text.Upper(Text.Trim(Text.Clean(Text.From([#"Work Class"]))))
				            in
				                if dataPayWorkClass = workClass then 0 else 1,
				        Int64.Type
				    ),
				    #"Added DataPay Job Title Mismatch Flag" = Table.AddColumn(
				        #"Added DataPay Work Class Mismatch Flag",
				        "DataPay_job_title_mismatch_flag",
				        each
				            let
				                dataPayJobTitle =
				                    if [DataPay_job_title] = null
				                    then ""
				                    else Text.Upper(Text.Trim(Text.Clean(Text.From([DataPay_job_title])))),
				                jobTitle =
				                    if [#"Job Title"] = null
				                    then ""
				                    else Text.Upper(Text.Trim(Text.Clean(Text.From([#"Job Title"]))))
				            in
				                if dataPayJobTitle = jobTitle then 0 else 1,
				        Int64.Type
				    ),
				    #"Added DataPay Business Unit Mismatch Flag" = Table.AddColumn(
				        #"Added DataPay Job Title Mismatch Flag",
				        "DataPay_business_unit_mismatch_flag",
				        each
				            let
				                dataPayBusinessUnit =
				                    if [DataPay_business_unit] = null
				                    then ""
				                    else Text.Upper(Text.Trim(Text.Clean(Text.From([DataPay_business_unit])))),
				                businessUnit =
				                    if [#"Business Unit"] = null
				                    then ""
				                    else Text.Upper(Text.Trim(Text.Clean(Text.From([#"Business Unit"]))))
				            in
				                if dataPayBusinessUnit = businessUnit then 0 else 1,
				        Int64.Type
				    ),
				    #"Added DataPay Employment Conditions Mismatch Flag" = Table.AddColumn(
				        #"Added DataPay Business Unit Mismatch Flag",
				        "DataPay_employment_conditions_mismatch_flag",
				        each
				            let
				                dataPayEmploymentConditions =
				                    if [DataPay_employment_conditions] = null
				                    then ""
				                    else Text.Upper(Text.Trim(Text.Clean(Text.From([DataPay_employment_conditions])))),
				                employmentConditions =
				                    if [#"Employment Condition"] = null
				                    then ""
				                    else Text.Upper(Text.Trim(Text.Clean(Text.From([#"Employment Condition"]))))
				            in
				                if dataPayEmploymentConditions = employmentConditions then 0 else 1,
				        Int64.Type
				    ),
				    #"Added DataPay Pay Rate Mismatch Flag" = Table.AddColumn(
				        #"Added DataPay Employment Conditions Mismatch Flag",
				        "DataPay_pay_rate_mismatch_flag",
				        each
				            let
				                dataPayRate =
				                    if [DataPay_pay_rate_value] = null
				                    then null
				                    else Number.Round(Number.From([DataPay_pay_rate_value]), 2),
				                annualRate =
				                    if [remunerationSchedule_baseAnnualSalary] = null
				                    then null
				                    else Number.Round(Number.From([remunerationSchedule_baseAnnualSalary]), 2),
				                hourlyRate =
				                    if [remunerationSchedule_baseHourlyRate] = null
				                    then null
				                    else Number.Round(Number.From([remunerationSchedule_baseHourlyRate]), 2)
				            in
				                if dataPayRate = null then null
				                else if dataPayRate = annualRate or dataPayRate = hourlyRate then 0
				                else 1,
				        Int64.Type
				    ),
				    #"Added DataPay Pay Rate Difference Pct" = Table.AddColumn(
				        #"Added DataPay Pay Rate Mismatch Flag",
				        "DataPay_pay_rate_difference_pct",
				        each
				            let
				                mismatchFlag = [DataPay_pay_rate_mismatch_flag],
				                dataPayRate =
				                    if [DataPay_pay_rate_value] = null
				                    then null
				                    else Number.Round(Number.From([DataPay_pay_rate_value]), 2),
				                annualRate =
				                    if [remunerationSchedule_baseAnnualSalary] = null
				                    then null
				                    else Number.Round(Number.From([remunerationSchedule_baseAnnualSalary]), 2),
				                hourlyRate =
				                    if [remunerationSchedule_baseHourlyRate] = null
				                    then null
				                    else Number.Round(Number.From([remunerationSchedule_baseHourlyRate]), 2),
				                paySetup =
				                    if [DataPay_pay_setup_value] = null
				                    then ""
				                    else Text.Lower(Text.Trim(Text.Clean(Text.From([DataPay_pay_setup_value])))),
				                expectedRate =
				                    if Text.Contains(paySetup, "hour")
				                    then hourlyRate
				                    else if Text.Contains(paySetup, "annual")
				                    then annualRate
				                    else if annualRate <> null
				                    then annualRate
				                    else hourlyRate
				            in
				                if mismatchFlag <> 1
				                then 0
				                else if dataPayRate = null or expectedRate = null or expectedRate = 0
				                then null
				                else Number.Abs((dataPayRate - expectedRate) / expectedRate),
				        type number
				    ),
				    #"Added Total Mismatch Count" = Table.AddColumn(
				        #"Added DataPay Pay Rate Difference Pct",
				        "DataPay_total_mismatch_count",
				        each List.Sum({
				            [DataPay_work_class_mismatch_flag],
				            [DataPay_job_title_mismatch_flag],
				            [DataPay_business_unit_mismatch_flag],
				            [DataPay_employment_conditions_mismatch_flag],
				            [DataPay_pay_rate_mismatch_flag]
				        }),
				        Int64.Type
				    ),
				    #"Added Missing Info Flag" = Table.AddColumn(
				        #"Added Total Mismatch Count",
				        "DataPay_missing_info_flag",
				        each if [DataPay_total_mismatch_count] = 0 then 0 else 1,
				        Int64.Type
				    ),
				    #"Removed Other Columns" = Table.SelectColumns(#"Added Missing Info Flag",{"id", "company_id", "EmpID", "DataPay_preferred_name", "DataPay_first_name", "DataPay_last_name", "DataPay_work_class", "DataPay_employment_conditions", "DataPay_business_unit", "DataPay_job_title", "DataPay_standard_hours_per_week_value", "DataPay_hours_per_cycle_value", "people_id", "Kaimahi", "dateOfBirth", "gender", "primaryEmailAddress_email", "employmentStatus", "businessUnit_id", "Supervisor", "Work Type", "Employment Condition", "Work Class", "isPrimaryJob", "Job Status", "Job Title", "Business Unit", "fte", "companyStartDate", "companyEndDate", "EmpLive_EmpID", "DataPay_work_class_mismatch_flag", "DataPay_job_title_mismatch_flag", "DataPay_business_unit_mismatch_flag", "DataPay_employment_conditions_mismatch_flag", "DataPay_pay_rate_mismatch_flag", "DataPay_pay_rate_difference_pct", "DataPay_total_mismatch_count", "DataPay_missing_info_flag"})
				in
				    #"Removed Other Columns"

	annotation PBI_ResultType = Exception

	annotation PBI_NavigationStepName = Navigation

