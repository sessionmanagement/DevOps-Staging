    "height": 602.34146341463418,
    "width": 1263.5121951219512,
    "tabOrder": 6000
  },
  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Explanation of speeding severity score:"
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "---- Speed Excess (SE)",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ": This is the foundation of the score, measuring how much the driver exceeded the speed limit. "
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Formula: SE = (Max Speed - Speed Limit) / Speed Limit * 100"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "This gives us a percentage of how much the speed limit was exceeded."
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Example: If the speed limit is 100 km/h and max speed was 121 km/h, SE = (121 - 100) / 100 * 100 = 21%"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "---- Duration Factor (DF)",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ": This factor increases the severity for longer durations of speeding. "
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "0-30 seconds: 1.0 (no increase)"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "31-60 seconds: 1.2 (20% increase)"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "61-120 seconds: 1.5 (50% increase)"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "120+ seconds: 2.0 (100% increase)"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Rationale: Prolonged speeding is more dangerous and shows a more deliberate violation."
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "---- Speed Limit Factor (SLF)",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ": This factor recognises that speeding in areas with lower speed limits is often more dangerous. "
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "100+ km/h: 1.0 (no increase, typically highways)"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "80-99 km/h: 1.2 (20% increase, major roads)"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "50-79 km/h: 1.5 (50% increase, urban areas)"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "0-49 km/h: 2.0 (100% increase, residential areas)"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Rationale: Speeding in residential or urban areas poses a higher risk to pedestrians and other vehicles."
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "---- Average Speed Factor (ASF)",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ": This factor accounts for consistent speeding versus brief spikes. "
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Formula: If Average Speed > Speed Limit: (Average Speed - Speed Limit) / (Max Speed - Speed Limit)"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "If Average Speed <= Speed Limit: 0.5"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Rationale: This factor is higher when the average speed is closer to the max speed, indicating more consistent speeding."
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Example: If Speed Limit = 100, Max Speed = 121, Average Speed = 117, ASF = (117 - 100) / (121 - 100) = 0.81"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "----Final Severity Score Calculation",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ":"
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Severity Score = SE * DF * SLF * ASF"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This multiplication allows each factor to influence the final score. A higher value in any factor will increase the overall severity."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "---- Severity Categories:",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "0-50: Low"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "51-100: Moderate"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "101-200: High"
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "201+: Extreme"
                  }
                ],
                "listType": "bullet"
              }
            ]
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}