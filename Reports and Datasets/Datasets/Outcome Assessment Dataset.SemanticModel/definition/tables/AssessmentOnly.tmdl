		mode: import
		source =
				let
				    Source = Sql.Database("Synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="-- ============================================================#(lf)-- Model:  Outcome Assessment Dataset#(lf)-- Table:  AssessmentOnly#(lf)-- Source: native query (complex CTE/window) - emitted in full#(lf)-- Used columns: 47 (mapped 47, unmapped 0)  [full query, not trimmed]#(lf)-- Auto-generated from pbi_complete_dump.csv + model M + EDW/ODS schema.#(lf)-- Review before use; verify joins/filters against the model.#(lf)-- ============================================================#(lf)-- USED model columns: AgeatResponse; AssessmentID; Avg_Score; Avg_Score_HOP; HOPQ1; HOPQ2; HOPQ3; HOPQ4; Outcome Tool Title; PersonID; Q1; Q10; Q11; Q12; Q1A; Q1B; Q1C; Q1D; Q2; Q2A; Q2B; Q2C; Q2D; Q3; Q3A; Q3B; Q3C; Q3D; Q4; Q4A; Q4B; Q4C; Q4D; Q5; Q6; Q7; Q8; Q9; Response Created Date; Total_Score; assessmentidkey; company; dim_client_team_unique_key; ethnicitygroup; gendertext; row_count_person_assess; row_count_person_assess_desc#(lf)#(lf)declare @today date = #(lf) CONVERT(datetime, SWITCHOFFSET(getdate(), DATEPART(TZOFFSET, #(lf)Getdate() AT TIME ZONE 'New Zealand Standard Time'))) ;#(lf)#(lf)WITH People AS (#(lf)    SELECT#(lf)       'EAL' as company,#(lf)        dlDimPerson.Personid,#(lf)        dlDimPerson.PersonFirstName,#(lf)        dlDimPerson.PersonLastName,#(lf)        dlDimPerson.PersonDateOfBirth,#(lf)        dlDimPerson.PersonDeceasedDate , --ISNULL(dlDimGenderIdentity.GenderIdentityText, 'Unspecified or Unknown') as GenderIdentityText#(lf)        ISNULL(dlDimGender.GenderText, 'Unspecified or Unknown') AS GenderText,#(lf)        concat(#(lf)            eth1.ethnicitytext,#(lf)            ',',#(lf)            ethp1.ethnicitytext,#(lf)            ',',#(lf)            eth2.ethnicitytext,#(lf)            ',',#(lf)            ethp2.ethnicitytext,#(lf)            ',',#(lf)            eth3.ethnicitytext,#(lf)            ',',#(lf)            ethp3.ethnicitytext#(lf)        ) AS ethnicitytextall,#(lf)        concat(#(lf)            eth1.ethnicityvalue,#(lf)            ',',#(lf)            ethp1.ethnicityvalue,#(lf)            ',',#(lf)            eth2.ethnicityvalue,#(lf)            ',',#(lf)            ethp2.ethnicityvalue,#(lf)            ',',#(lf)            eth3.ethnicityvalue,#(lf)            ',',#(lf)            ethp3.ethnicityvalue#(lf)        ) AS ethnicityvalueall#(lf)    FROM#(lf)        RBEAL.dldimperson#(lf)        LEFT JOIN rbeal.dlDimGender ON dlDimPerson.GenderID = dlDimGender.GenderID#(lf)        LEFT JOIN rbeal.dlDimEthnicity AS eth1 ON dlDimPerson.Ethnicity1ID = eth1.EthnicityID#(lf)        LEFT JOIN rbeal.dlDimEthnicity AS ethp1 ON eth1.ethnicityparentid = ethp1.ethnicityid#(lf)        LEFT JOIN rbeal.dlDimEthnicity AS eth2 ON dlDimPerson.Ethnicity2ID = eth2.EthnicityID#(lf)        LEFT JOIN rbeal.dlDimEthnicity AS ethp2 ON eth2.ethnicityparentid = ethp2.ethnicityid#(lf)        LEFT JOIN rbeal.dlDimEthnicity AS eth3 ON dlDimPerson.Ethnicity3ID = eth3.EthnicityID#(lf)        LEFT JOIN rbeal.dlDimEthnicity AS ethp3 ON eth3.ethnicityparentid = ethp3.ethnicityid#(lf)       Union All#(lf)    SELECT#(lf)#(tab)#(tab) 'MNB' as company,#(lf)        dlDimPerson.Personid,#(lf)        dlDimPerson.PersonFirstName,#(lf)        dlDimPerson.PersonLastName,#(lf)        dlDimPerson.PersonDateOfBirth,#(lf)        dlDimPerson.PersonDeceasedDate , --ISNULL(dlDimGenderIdentity.GenderIdentityText, 'Unspecified or Unknown') as GenderIdentityText#(lf)        ISNULL(dlDimGender.GenderText, 'Unspecified or Unknown') AS GenderText,#(lf)        concat(#(lf)            eth1.ethnicitytext,#(lf)            ',',#(lf)            ethp1.ethnicitytext,#(lf)            ',',#(lf)            eth2.ethnicitytext,#(lf)            ',',#(lf)            ethp2.ethnicitytext,#(lf)            ',',#(lf)            eth3.ethnicitytext,#(lf)            ',',#(lf)            ethp3.ethnicitytext#(lf)        ) AS ethnicitytextall,#(lf)        concat(#(lf)            eth1.ethnicityvalue,#(lf)            ',',#(lf)            ethp1.ethnicityvalue,#(lf)            ',',#(lf)            eth2.ethnicityvalue,#(lf)            ',',#(lf)            ethp2.ethnicityvalue,#(lf)            ',',#(lf)            eth3.ethnicityvalue,#(lf)            ',',#(lf)            ethp3.ethnicityvalue#(lf)        ) AS ethnicityvalueall#(lf)    FROM#(lf)        RBMNB.dlDimPerson#(lf)        LEFT JOIN rbmnb.dlDimEthnicity ON dlDimPerson.Ethnicity1ID = dlDimEthnicity.EthnicityID --LEFT JOIN rbeal.dlDimGenderIdentity#(tab)ON DimPerson.GenderIdentityId#(tab)= dlDimGenderIdentity.GenderIdentityID#(lf)        LEFT JOIN rbmnb.dlDimGender ON dlDimPerson.GenderID = dlDimGender.GenderID#(lf)        LEFT JOIN rbmnb.dlDimEthnicity AS eth1 ON dlDimPerson.Ethnicity1ID = eth1.EthnicityID#(lf)        LEFT JOIN rbmnb.dlDimEthnicity AS ethp1 ON eth1.ethnicityparentid = ethp1.ethnicityid#(lf)        LEFT JOIN rbmnb.dlDimEthnicity AS eth2 ON dlDimPerson.Ethnicity2ID = eth2.EthnicityID#(lf)        LEFT JOIN rbmnb.dlDimEthnicity AS ethp2 ON eth2.ethnicityparentid = ethp2.ethnicityid#(lf)        LEFT JOIN rbmnb.dlDimEthnicity AS eth3 ON dlDimPerson.Ethnicity3ID = eth3.EthnicityID#(lf)        LEFT JOIN rbmnb.dlDimEthnicity AS ethp3 ON eth3.ethnicityparentid = ethp3.ethnicityid#(lf)      #(lf))#(lf),#(lf)PeoplewithEthnicityGroup as#(lf)(#(lf)select #(lf)Company+','+cast(Personid as nvarchar) as personidkey,#(lf)* ,#(lf)CASE#(lf)            WHEN ethnicityvalueall LIKE '%,21,%'#(lf)            OR ethnicityvalueall LIKE '21,%'#(lf)            OR ethnicityvalueall LIKE '%,21' THEN 'Maori'#(lf)            WHEN ethnicityvalueall LIKE '31,%'#(lf)            OR ethnicityvalueall LIKE '%,31,%' THEN 'Pasifika'#(lf)            WHEN ethnicityvalueall LIKE '32,%'#(lf)            OR ethnicityvalueall LIKE '33,%'#(lf)            OR ethnicityvalueall LIKE '34,%'#(lf)            OR ethnicityvalueall LIKE '35,%'#(lf)            OR ethnicityvalueall LIKE '36,%'#(lf)            OR ethnicityvalueall LIKE '37,%' THE