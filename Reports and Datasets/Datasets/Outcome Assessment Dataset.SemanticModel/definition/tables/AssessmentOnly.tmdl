TE) BETWEEN dateadd(DAY, - 7, finalreferraldata.ServiceStartDate)#(lf)        --AND dateadd(DAY, + 7, finalreferraldata.ServiceEndDate) --====making sure we join the assessment from a company to the referral from the same company#(lf)        --AND LEFT(datablockpivot.assessmentidkey, 3) = LEFT(finalreferraldata.referralidkey, 3)#(lf)#(tab)#(tab) left JOIN referraldata0 ON DataBlockPivot.personidkey = referraldata0.PersonidKey #(lf)        AND CAST(DataBlockPivot.ResponseCreatedDate AS DATE) BETWEEN dateadd(DAY, - 7, referraldata0.accepteddate)#(lf)        AND dateadd(DAY, + 7, referraldata0.proxyenddate) --====making sure we join the assessment from a company to the referral from the same company#(lf)        AND LEFT(datablockpivot.assessmentidkey, 3) = LEFT(referraldata0.referralidkey, 3)  --ie same company#(lf))#(lf),#(lf)datablockpivot2_1 AS (#(lf)    SELECT#(lf)        ROW_NUMBER () OVER (#(lf)            PARTITION BY personidkey,#(lf)            outcometooltitle,#(lf)            assessmentidkey#(lf)            ORDER BY#(lf)                personidkey,#(lf)                outcometooltitle,#(lf)                assessmentidkey,#(lf)                referralidkey#(lf)        ) AS row_count_proxy,#(lf)        *#(lf)    FROM#(lf)        datablockpivot2_0#(lf)),#(lf)finalfinal as#(lf)(#(lf)   SELECT#(lf)        --Adding row count for each assessment.#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY assessmentidkey#(lf)            #(lf)            ORDER BY#(lf)                assessmentidkey,#(lf)                referralidkey,#(lf)#(tab)#(tab)#(tab)#(tab)responsecreateddate#(lf)        ) AS row_count_assessment,#(lf)        -- row count for each assessment desc#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY assessmentidkey#(lf)         #(lf)            ORDER BY#(lf)                assessmentidkey,#(lf)                referralidkey ,#(lf)#(tab)#(tab)#(tab)#(tab)responsecreateddate desc#(lf)        ) AS row_count_assessment_desc,#(lf)          #(lf)#(tab)#(tab)  ROW_NUMBER() OVER (#(lf)            PARTITION BY personidkey#(lf)            #(lf)            ORDER BY#(lf)#(tab)#(tab)#(tab)#(tab)personidkey,#(lf)                responsecreateddate#(lf)        ) AS row_count_person_assess,#(lf)        -- row count for each person desc#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY personidkey#(lf)         #(lf)            ORDER BY#(lf)#(tab)#(tab)#(tab)    personidkey,#(lf)                responsecreateddate desc#(lf)        ) AS row_count_person_assess_desc,#(lf)         PersonID,#(lf)        AssessmentID,#(lf)        ReferralID,#(lf)        personidkey,#(lf)        assessmentidkey,#(lf)        ReferralIDKey,#(lf)        referralassessmentidkey,#(lf)#(tab)#(tab)company,#(lf)        referralstatus,#(lf)        ResponseCreatedDate,#(lf)#(tab)#(tab)datediff(day,responsecreateddate,@today) as days_from_assessment,#(lf)#(lf)#(tab)#(tab)case when persondateofbirth is null or PersonDateOfBirth < '1899-12-31' #(lf)#(tab)#(tab)or persondateofbirth > @today#(lf)#(tab)#(tab)then -1#(lf)#(tab)#(tab)else #(lf)#(tab)#(tab)floor(datediff(day,persondateofbirth,responsecreateddate)/365.0) #(lf)#(tab)#(tab)end #(lf)#(tab)#(tab)as AgeatResponse,#(lf)#(tab)#(tab)ethnicitygroup,#(lf)#(tab)#(tab)maori_indicator,#(lf)#(tab)#(tab)pasifika_indicator,#(lf)#(tab)#(tab)gendertext,#(lf)     --   AssessmentCompletedBy,#(lf)#(tab)    TeamIDKey,#(lf)#(tab)#(tab)dim_client_team_unique_key,#(lf)        TeamID,#(lf)        TeamName,#(lf)        OutcomeToolTitle,#(lf)        Q1,#(lf)        Q2,#(lf)        Q3,#(lf)        Q4,#(lf)        Q5,#(lf)        Q6,#(lf)        Q7,#(lf)        Q8,#(lf)        Q9,#(lf)        Q10,#(lf)        Q11,#(lf)        Q12,#(lf)        Q1A,#(lf)        Q1B,#(lf)        Q1C,#(lf)        Q1D,#(lf)        Q2A,#(lf)        Q2B,#(lf)        Q2C,#(lf)        Q2D,#(lf)        Q3A,#(lf)        Q3B,#(lf)        Q3C,#(lf)        Q3D,#(lf)        Q4A,#(lf)        Q4B,#(lf)        Q4C,#(lf)        Q4D,#(lf)        CAST(ISNULL (Q1, 0) AS SMALLINT) + CAST(ISNULL (Q2, 0) AS SMALLINT) + CAST(ISNULL (Q3, 0) AS SMALLINT) + CAST(ISNULL (Q4, 0) AS SMALLINT) + CAST(ISNULL (Q5, 0) AS SMALLINT) + CAST(ISNULL (Q6, 0) AS SMALLINT) + CAST(ISNULL (Q7, 0) AS SMALLINT) + CAST(ISNULL (Q8, 0) AS SMALLINT) + CAST(ISNULL (Q9, 0) AS SMALLINT) + CAST(ISNULL (Q10, 0) AS SMALLINT) + CAST(isnull(Q11, 0) AS SMALLINT) + CAST(isnull(Q12, 0) AS SMALLINT) + CAST(ISNULL (Q1A, 0) AS SMALLINT) + CAST(ISNULL (Q1B, 0) AS SMALLINT) + CAST(ISNULL (Q1C, 0) AS SMALLINT) + CAST(ISNULL (Q1D, 0) AS SMALLINT) + CAST(ISNULL (Q2A, 0) AS SMALLINT) + CAST(ISNULL (Q2B, 0) AS SMALLINT) + CAST(ISNULL (Q2C, 0) AS SMALLINT) + CAST(ISNULL (Q2D, 0) AS SMALLINT) + CAST(ISNULL (Q3A, 0) AS SMALLINT) + CAST(ISNULL (Q3B, 0) AS SMALLINT) + CAST(ISNULL (Q3C, 0) AS SMALLINT) + CAST(ISNULL (Q3D, 0) AS SMALLINT) + CAST(ISNULL (Q4A, 0) AS SMALLINT) + CAST(ISNULL (Q4B, 0) AS SMALLINT) + CAST(ISNULL (Q4C, 0) AS SMALLINT) + CAST(ISNULL (Q4D, 0) AS SMALLINT) AS Total_Score --====average is the total divided by the number of questions#(lf),#(lf)        CASE#(lf)            WHEN outcometooltitle LIKE 'kes%' THEN (#(lf)                CAST(ISNULL(Q1, 0) AS SMALLINT) + CAST(ISNULL(Q2, 0) AS SMALLINT) + CAST(ISNULL(Q3, 0) AS SMALLINT) + CAST(ISNULL(Q4, 0) AS SMALLINT) + CAST(ISNULL(Q5, 0) AS SMALLINT) + CAST(ISNULL(Q6, 0) AS SMALLINT) + CAST(ISNULL(Q7, 0) AS SMALLINT) + CAST(ISNULL(Q8, 0) AS SMALLINT) + CAST(ISNULL(Q9, 0) AS SMALLINT) + CAST(ISNULL(Q10, 0) AS SMALLINT)#(lf)            ) * 1.0 / 10 * 1.0#(lf)            WHEN outcometooltitle = 'Matrix' THEN (#(lf)                CAST(ISNULL(Q1, 0) AS SMALLINT) + CAST(ISNULL(Q2, 0) AS SMALLINT) + CAST(ISNULL(Q3, 0) AS SMALLINT) + CAST(ISNULL(Q4, 0) AS SMALLINT) + CAST(ISNULL(Q5, 0) AS SMALLINT) + CAST(ISNULL(Q6, 0) AS SMALLINT) + CAST(ISNULL(Q7, 0) AS SMALLINT) + CAST(ISNULL(Q8, 0) AS SMALLINT) + CAST(ISNULL(Q9, 0) AS SMALLINT) + CAST(ISNULL(Q10, 0) AS SMALLINT) + CAST(ISNULL(Q11, 0) AS SMALLINT) + CAST(ISNULL(Q12, 0) AS SMALLINT)#(lf)            ) * 1.0 / 12 * 1.0#(lf)            WHEN outcometooltitle = 'Hua Oranga - Primary Care' THEN (#(lf)                CAST(ISNULL(Q1A, 0) AS SMALLINT) + CAST(ISNULL(Q1B, 0) AS SMALLINT) + CAST(ISNULL(Q1C, 0) AS SMALLINT) + CAST(ISNULL(Q1D, 0) AS SMALLINT) + CAST(ISNULL(Q2A, 0) AS SMALLINT) + CAST(ISNULL(Q2B, 0) AS SMALLINT) + CAST(ISNULL(Q2C, 0) AS SMALLINT) + CAST(ISNULL(Q2D, 0) AS SMALLINT) + CAST(ISNULL(Q3A, 0) AS SMALLINT) + CAST(ISNULL(Q3B, 0) AS SMALLINT) + CAST(ISNULL(Q3C, 0) AS SMALLINT) + CAST(ISNULL(Q3D, 0) AS SMALLINT) + CAST(ISNULL(Q4A, 0) AS SMALLINT) + CAST(ISNULL(Q4B, 0) AS SMALLINT) + CAST(ISNULL(Q4C, 0) AS SMALLINT) + CAST(ISNULL(Q4D, 0) AS SMALLINT)#(lf)            ) * 1.0 / 16#(lf)        END AS Avg_Score,#(lf)        CASE#(lf)            WHEN outcometooltitle = 'Hua Oranga - Primary Care' THEN (#(lf)                CAST(ISNULL(Q1A, 0) AS SMALLINT) + CAST(ISNULL(Q1B, 0) AS SMALLINT) + CAST(ISNULL(Q1C, 0) AS SMALLINT) + CAST(ISNULL(Q1D, 0) AS SMALLINT) + CAST(ISNULL(Q2A, 0) AS SMALLINT) + CAST(ISNULL(Q2B, 0) AS SMALLINT) + CAST(ISNULL(Q2C, 0) AS SMALLINT) + CAST(ISNULL(Q2D, 0) AS SMALLINT) + CAST(ISNULL(Q3A, 0) AS SMALLINT) + CAST(ISNULL(Q3B, 0) AS SMALLINT) + CAST(ISNULL(Q3C, 0) AS SMALLINT) + CAST(ISNULL(Q3D, 0) AS SMALLINT) + CAST(ISNULL(Q4A, 0) AS SMALLINT) + CAST(ISNULL(Q4B, 0) AS SMALLINT) + CAST(ISNULL(Q4C, 0) AS SMALLINT) + CAST(ISNULL(Q4D, 0) AS SMALLINT)#(lf)            ) * 1.0 / 4#(lf)        END AS Avg_Score_HOP,#(lf)        q1a + q1b + q1c + q1d AS HOPQ1,#(lf)        q2a + q2b + q2c + q2d AS HOPQ2,#(lf)        q3a + q3b + q3c + q3d AS HOPQ3,#(lf)        q4a + q4b + q4c + q4d AS HOPQ4#(lf)    FROM#(lf)        datablockpivot2_1)#(lf)#(lf)#(tab)#(tab)select * from finalfinal #(lf)#(tab)order by personid, assessmentid;#(lf)#(lf)"]),
