LLINT), 0) AS Q2B,#(lf)        ISNULL(CAST([Q2C] AS SMALLINT), 0) AS Q2C,#(lf)        ISNULL(CAST([Q2D] AS SMALLINT), 0) AS Q2D,#(lf)        ISNULL(CAST([Q3A] AS SMALLINT), 0) AS Q3A,#(lf)        ISNULL(CAST([Q3B] AS SMALLINT), 0) AS Q3B,#(lf)        ISNULL(CAST([Q3C] AS SMALLINT), 0) AS Q3C,#(lf)        ISNULL(CAST([Q3D] AS SMALLINT), 0) AS Q3D,#(lf)        ISNULL(CAST([Q4A] AS SMALLINT), 0) AS Q4A,#(lf)        ISNULL(CAST([Q4B] AS SMALLINT), 0) AS Q4B,#(lf)        ISNULL(CAST([Q4C] AS SMALLINT), 0) AS Q4C,#(lf)        ISNULL(CAST([Q4D] AS SMALLINT), 0) AS Q4D#(lf)    FROM#(lf)        (#(lf)            SELECT#(lf)                PersonID,#(lf)                AssessmentId,#(lf)                personidkey,#(lf)                assessmentidkey,#(lf)                referralassessmentidkey,#(lf)                OutcomeToolTitle,#(lf)                OutcomeToolQuestionID,#(lf)                ResponseAnswerSelectedValue,#(lf)                ResponseCreatedDate--,#(lf)             --   AssessmentCompletedBy#(lf)            FROM#(lf)                datablock1#(lf)        ) AS DATA1 PIVOT (#(lf)            MAX(ResponseAnswerSelectedValue) --doesn't make a difference because there should only be one value per line#(lf)            FOR OutcomeToolQuestionID IN (#(lf)                [Q1],#(lf)                [Q2],#(lf)                [Q3],#(lf)                [Q4],#(lf)                [Q5],#(lf)                [Q6],#(lf)                [Q7],#(lf)                [Q8],#(lf)                [Q9],#(lf)                [Q10],#(lf)                [Q11],#(lf)                [Q12],#(lf)                [Q1A],#(lf)                [Q2A],#(lf)                [Q3A],#(lf)                [Q4A],#(lf)                [Q1B],#(lf)                [Q2B],#(lf)                [Q3B],#(lf)                [Q4B],#(lf)                [Q1C],#(lf)                [Q2C],#(lf)                [Q3C],#(lf)                [Q4C],#(lf)                [Q1D],#(lf)                [Q2D],#(lf)                [Q3D],#(lf)                [Q4D]#(lf)            )#(lf)        ) AS Pvt#(lf)),#(lf)datablockpivot2_0 AS (#(lf)    SELECT#(lf)        DataBlockPivot.PersonID,#(lf)        DataBlockPivot.AssessmentID,#(lf)        finalreferraldata.ReferralID,#(lf)        datablockpivot.personidkey,#(lf)        datablockpivot.assessmentidkey,#(lf)        datablockpivot.referralassessmentidkey,#(lf)        finalreferraldata.referralidkey,#(lf)        CASE#(lf)            WHEN referralassessmentidkey IS NULL#(lf)            AND referralidkey IS NOT NULL THEN 'Referral Derived'#(lf)            WHEN referralassessmentidkey = referralidkey#(lf)            AND referralidkey IS NOT NULL THEN 'Referral Stated'#(lf)            WHEN referralidkey IS NULL THEN 'Referral Not Found'#(lf)        END AS referralstatus,#(lf)        DataBlockPivot.ResponseCreatedDate,#(lf)      --  DataBlockPivot.AssessmentCompletedBy,#(lf)#(tab)    finalreferraldata.TeamIDKey,#(lf)#(tab)#(tab)finalreferraldata.dim_client_team_unique_key,#(lf)        finalreferraldata.TeamID,#(lf)        finalreferraldata.TeamName,#(lf)#(tab)#(tab)finalreferraldata.ageatdischarge,#(lf)#(tab)#(tab)finalreferraldata.AgeAccepted,#(lf)        DatablockPivot.OutcomeToolTitle,#(lf)        DataBlockPivot.Q1,#(lf)        DataBlockPivot.Q2,#(lf)        DataBlockPivot.Q3,#(lf)        DataBlockPivot.Q4,#(lf)        DataBlockPivot.Q5,#(lf)        DataBlockPivot.Q6,#(lf)        DataBlockPivot.Q7,#(lf)        DataBlockPivot.Q8,#(lf)        DataBlockPivot.Q9,#(lf)        DataBlockPivot.Q10,#(lf)        DataBlockPivot.Q11,#(lf)        DataBlockPivot.Q12,#(lf)        datablockpivot.Q1A,#(lf)        datablockpivot.Q1B,#(lf)        datablockpivot.Q1C,#(lf)        datablockpivot.Q1D,#(lf)        datablockpivot.Q2A,#(lf)        datablockpivot.Q2B,#(lf)        datablockpivot.Q2C,#(lf)        datablockpivot.Q2D,#(lf)        datablockpivot.Q3A,#(lf)        datablockpivot.Q3B,#(lf)        datablockpivot.Q3C,#(lf)        datablockpivot.Q3D,#(lf)        datablockpivot.Q4A,#(lf)        datablockpivot.Q4B,#(lf)        datablockpivot.Q4C,#(lf)        datablockpivot.Q4D#(lf)    FROM#(lf)        finalreferraldata#(lf)        INNER JOIN DatablockPivot ON finalreferraldata.PersonidKey = DataBlockPivot.personidkey#(lf)        AND CAST(DataBlockPivot.ResponseCreatedDate AS DATE) BETWEEN dateadd(DAY, - 7, finalreferraldata.accepteddate)#(lf)        AND dateadd(DAY, + 7, finalreferraldata.proxyenddate) --====making sure we join the assessment from a company to the referral from the same company#(lf)        AND LEFT(datablockpivot.assessmentidkey, 3) = LEFT(finalreferraldata.referralidkey, 3)  --ie same company#(lf)) --====where there are two matches for the referral I'm only taking the first one.#(lf),#(lf)datablockpivot2_1 AS (#(lf)    SELECT#(lf)        ROW_NUMBER () OVER (#(lf)            PARTITION BY personidkey,#(lf)            outcometooltitle,#(lf)            assessmentidkey#(lf)            ORDER BY#(lf)                personidkey,#(lf)                outcometooltitle,#(lf)                assessmentidkey,#(lf)                referralidkey#(lf)        ) AS row_count_proxy,#(lf)        *#(lf)    FROM#(lf)        datablockpivot2_0#(lf)),#(lf)--====this is where the others get blitzed.  Exact science? - nope!#(lf)--datablockpivot2 AS (#(lf)--    SELECT#(lf)--        *#(lf)--    FROM#(lf)--        datablockpivot2_1#(lf)--    WHERE#(lf)--        row_count_proxy = 1#(lf)--),#(lf)--==== bringing data together and working out totals and averages#(lf)datablock2 AS (#(lf)    SELECT#(lf)        --Adding row count for each person.#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY Personidkey,#(lf)            outcometooltitle#(lf)            ORDER BY#(lf)                personidkey,#(lf)                ResponseCreatedDate#(lf)        ) AS row_count,#(lf)        -- row count for each person desc#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY Personidkey,#(lf)            outcometooltitle#(lf)            ORDER BY#(lf)                personidkey,#(lf)                ResponseCreatedDate desc#(lf)        ) AS row_count_desc,#(lf)        --row count by referral#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY Personidkey,#(lf)            outcometooltitle,#(lf)            referralid#(lf)            ORDER BY#(lf)                personidkey,#(lf)                outcometooltitle,#(lf)                referralid,#(lf)                ResponseCreatedDate#(lf)        ) AS row_count_ref --row count by referral desc#(lf),#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY Personidkey,#(lf)            outcometooltitle,#(lf)            referralid#(lf)            ORDER BY#(lf)                personidkey,#(lf)                outcometooltitle,#(lf)                referralid,#(lf)                ResponseCreatedDate desc#(lf)        ) AS row_count_ref_desc,#(lf)        PersonID,#(lf)        AssessmentID,#(lf)        ReferralID,#(lf)        personidkey,#(lf)        assessmentidkey,#(lf)        ReferralIDKey,#(lf)        referralassessmentidkey,#(lf)        referralstatus,#(lf)        ResponseCreatedDate,#(lf)     --   AssessmentCompletedBy,#(lf)#(tab)    TeamIDKey,#(lf)#(tab)#(tab)dim_client_team_unique_key,#(lf)        TeamID,#(lf)        TeamName,#(lf)        OutcomeToolTitle,#(lf)        Q1,#(lf)        Q2,#(lf)        Q3,#(lf)        Q4,#(lf)        Q5,#(lf)        Q6,#(lf)        Q7,#(lf)        Q8,#(lf)        Q9,#(lf)        Q10,#(lf)        Q11,#(lf)        Q12,#(lf)        Q1A,#(lf)        Q1B,#(lf)        Q1C,#(lf)        Q1D,#(lf)        Q2A,#(lf)        Q2B,#(lf)        Q2C,#(lf)        Q2D,#(lf)        Q3A,#(lf)        Q3B,#(lf)        Q3C,#(lf)        Q3D,#(lf)        Q4A,#(lf)        Q4B,#(lf)        Q4C,#(lf)        Q4D,#(lf)        CAST(ISNULL (Q1, 0) AS SMALLINT) + CAST(ISNULL (Q2, 0) AS SMALLINT) + CAST(ISNULL (Q3, 0) AS SMALLINT) + CAST(ISNULL (Q4, 0) AS SMALLINT) + CAST(ISNULL (Q5, 0) AS SMALLINT) + CAST(ISNULL (Q6, 0) AS SMALLINT) + CAST(ISNULL (Q7, 0) AS SMALLINT) + CAST(ISNULL (Q8, 0) AS SMALLINT) + CAST(ISNULL (Q9, 0) AS SMALLINT) + CAST(ISNULL (Q10, 0) AS SMALLINT) + CAST(isnull(Q11, 0) AS SMALLINT) + CAST(isnull(Q12, 0) AS SMALLINT) + CAST(ISNULL (Q1A, 0) AS SMALLINT) + CAST(ISNULL (Q1B, 0) AS SMALLINT) + CAST(ISNULL (Q1C, 0) AS SMALLINT) + CAST(ISNULL (Q1D, 0) AS SMALLINT) + CAST(ISNULL (Q2A, 0) AS SMALLINT) + CAST(ISNULL (Q2B, 0) AS SMALLINT) + CAST(ISNULL (Q2C, 0) AS SMALLINT) + CAST(ISNULL (Q2D, 0) AS SMALLINT) + CAST(ISNULL (Q3A, 0) AS SMALLINT) + CAST(ISNULL (Q3B, 0) AS SMALLINT) + CAST(ISNULL (Q3C, 0) AS SMALLINT) + CAST(ISNULL (Q3D, 0) AS SMALLINT) + CAST(ISNULL (Q4A, 0) AS SMALLINT) + CAST(ISNULL (Q4B, 0) AS SMALLINT) + CAST(ISNULL (Q4C, 0) AS SMALLINT) + CAST(ISNULL (Q4D, 0) AS SMALLINT) AS Total_Score --====average is the total divided by the number of questions#(lf),#(lf)        CASE#(lf)            WHEN outcometooltitle LIKE 'kes%' THEN (#(lf)                CAST(ISNULL(Q1, 0) AS SMALLINT) + CAST(ISNULL(Q2, 0) AS SMALLINT) + CAST(ISNULL(Q3, 0) AS SMALLINT) + CAST(ISNULL(Q4, 0) AS SMALLINT) + CAST(ISNULL(Q5, 0) AS SMALLINT) + CAST(ISNULL(Q6, 0) AS SMALLINT) + CAST(ISNULL(Q7, 0) AS SMALLINT) + CAST(ISNULL(Q8, 0) AS SMALLINT) + CAST(ISNULL(Q9, 0) AS SMALLINT) + CAST(ISNULL(Q10, 0) AS SMALLINT)#(lf)            ) * 1.0 / 10 * 1.0#(lf)            WHEN outcometooltitle = 'Matrix' THEN (#(lf)                CAST(ISNULL(Q1, 0) AS SMALLINT) + CAST(ISNULL(Q2, 0) AS SMALLINT) + CAST(ISNULL(Q3, 0) AS SMALLINT) + CAST(ISNULL(Q4, 0) AS SMALLINT) + CAST(ISNULL(Q5, 0) AS SMALLINT) + CAST(ISNULL(Q6, 0) AS SMALLINT) + CAST(ISNULL(Q7, 0) AS SMALLINT) + CAST(ISNULL(Q8, 0) AS SMALLINT) + CAST(ISNULL(Q9, 0) AS SMALLINT) + CAST(ISNULL(Q10, 0) AS SMALLINT) + CAST(ISNULL(Q11, 0) AS SMALLINT) + CAST(ISNULL(Q12, 0) AS SMALLINT)#(lf)            ) * 1.0 / 12 * 1.0#(lf)            WHEN outcometooltitle = 'Hua Oranga - Primary Care' THEN (#(lf)                CAST(ISNULL(Q1A, 0) AS SMALLINT) + CAST(ISNULL(Q1B, 0) AS SMALLINT) + CAST(ISNULL(Q1C, 0) AS 