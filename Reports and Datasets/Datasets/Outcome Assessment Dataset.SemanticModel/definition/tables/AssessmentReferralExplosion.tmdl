	column DateRange = ```
			
			
			if ([Datedifference]<=30 , "  30 Days and Under",
			 if ( [Datedifference]<= 90 , "31 - 90 Days",
			 if ( [Datedifference] > 90 , "Over 90 Days" 
			)))
			```
		lineageTag: 5d683e30-8c3d-4ae9-ae9f-64a488806fc2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column DateRangeFinal = if ( [assessmentstatus]="3. No Assessments",CONCATENATE("No Assessments: ",AssessmentReferralExplosion[DateRange]),AssessmentReferralExplosion[DateRange])
