tab)   else concat(dlDimTeam.teamid,'_5')#(lf)#(tab)   end as dim_client_team_unique_key,#(lf)#(tab)   dlDimTeam.TeamID,#(lf)#(lf)        dlDimTeam.TeamName,#(lf)        dlDimTeamfunction.TeamFunctionName,#(lf)        concat(#(lf)            eth1.ethnicitytext,#(lf)            ',',#(lf)            ethp1.ethnicitytext,#(lf)            ',',#(lf)            eth2.ethnicitytext,#(lf)            ',',#(lf)            ethp2.ethnicitytext,#(lf)            ',',#(lf)            eth3.ethnicitytext,#(lf)            ',',#(lf)            ethp3.ethnicitytext#(lf)        ) AS ethnicitytextall,#(lf)        concat(#(lf)            eth1.ethnicityvalue,#(lf)            ',',#(lf)            ethp1.ethnicityvalue,#(lf)            ',',#(lf)            eth2.ethnicityvalue,#(lf)            ',',#(lf)            ethp2.ethnicityvalue,#(lf)            ',',#(lf)            eth3.ethnicityvalue,#(lf)            ',',#(lf)            ethp3.ethnicityvalue#(lf)        ) AS ethnicityvalueall#(lf)    FROM#(lf)        RBMNB.LegacyFactReferral#(lf)        LEFT JOIN rbmnb.dlDimPerson ON LegacyFactReferral.PersonID = dlDimPerson.PersonID#(lf)        LEFT JOIN rbmnb.dlDimTeam ON LegacyFactReferral.TeamID = dlDimTeam.Teamid#(lf)        LEFT JOIN rbmnb.dlDimTeamfunction ON dlDimTeam.TeamFunctionID = dlDimTeamFunction.TeamFunctionID#(lf)        LEFT JOIN rbmnb.dlDimContract ON dlDimTeam.ContractID = dlDimContract.ContractID#(lf)        LEFT JOIN rbmnb.dlDimEthnicity ON dlDimPerson.Ethnicity1ID = dlDimEthnicity.EthnicityID --LEFT JOIN rbeal.dlDimGenderIdentity#(tab)ON DimPerson.GenderIdentityId#(tab)= dlDimGenderIdentity.GenderIdentityID#(lf)        LEFT JOIN rbmnb.dlDimGender ON dlDimPerson.GenderID = dlDimGender.GenderID#(lf)        LEFT JOIN rbmnb.dlDimEthnicity AS eth1 ON dlDimPerson.Ethnicity1ID = eth1.EthnicityID#(lf)        LEFT JOIN rbmnb.dlDimEthnicity AS ethp1 ON eth1.ethnicityparentid = ethp1.ethnicityid#(lf)        LEFT JOIN rbmnb.dlDimEthnicity AS eth2 ON dlDimPerson.Ethnicity2ID = eth2.EthnicityID#(l