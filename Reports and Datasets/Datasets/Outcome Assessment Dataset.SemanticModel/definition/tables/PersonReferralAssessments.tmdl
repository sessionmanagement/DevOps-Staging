table PersonReferralAssessments
	lineageTag: b7f6e38e-fe0d-4dc8-9c6f-aa6b84779637

	measure QuestionsFirst = calculate(average(PersonReferralAssessments[Response Answer Selected Value]),PersonReferralAssessments[Assessment Performed Type]="First Assessment"&&PersonReferralAssessments[Assessment Status]="")
		formatString: 0.00
		lineageTag: c6581f4d-31ef-45a4-bc03-47e5537fc51d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure QuestionsLast = calculate(average(PersonReferralAssessments[Response Answer Selected Value]),PersonReferralAssessments[Assessment Performed Type]="Last Assessment"&&PersonReferralAssessments[Assessment Status]="")
		formatString: 0.00
		lineageTag: a670fc04-2e55-4d24-a6ed-9ce9920ea2dc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure QuestionsPrevious = calculate(average(PersonReferralAssessments[Response Answer Selected Value]),PersonReferralAssessments[Assessment Performed Type]="Previous Assessment"&&PersonReferralAssessments[Assessment Status]="")
		lineageTag: 165c55fa-bd93-46e0-9d18-1516e6b3111d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Number of last assessments' = calculate(DISTINCTCOUNT(PersonReferralAssessments[Assessment ID Key]),PersonReferralAssessments[order_desc]=1&&PersonReferralAssessments[order_asc]>1,PersonReferralAssessments[Question Text]="Total")
		formatString: 0
		lineageTag: 00baf3e0-b540-4e9f-b0be-833f51664358

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Previous avg total' = calculate(average(PersonReferralAssessments[Response Answer Selected Value]),PersonReferralAssessments[order_desc]=2&&PersonReferralAssessments[order_asc]>1,PersonReferralAssessments[Question Text]="Total")
		formatString: 0.0
		lineageTag: 4ab2e2f4-79ec-4bc4-9f0d-8346364d3ba9

	measure 'First avg total' =
			calculate(average(PersonReferralAssessments[Response Answer Selected Value]),PersonReferralAssessments[Assessment Performed Type]="First Assessment"&&PersonReferralAssessments[Assessment Status] =""
			&&PersonReferralAssessments[Outcome Tool Question ID]<>"Score1"&&PersonReferralAssessments[Outcome Tool Question ID]<>"Score2"&&PersonReferralAssessments[Outcome Tool Question ID]<>"Score3"&&PersonReferralAssessments[Outcome Tool Question ID]<>"Score4"
			,PersonReferralAssessments[Question Text]="Total")
		formatString: 0.0
		lineageTag: 1a2b14b0-5905-4d8c-b4ed-1974673e9f8e

	measure '%Diff Latest to First' = if(isblank([QuestionsFirst])||[QuestionsFirst]=0,blank(), divide([QuestionsLast],[QuestionsFirst])-1)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 076bb877-ca42-4726-ada3-a096c35ef1fd

	measure '%Diff Latest to Previous' = if(isblank([QuestionsPrevious])||[QuestionsPrevious]=0,blank(), divide([QuestionsLast],[QuestionsPrevious])-1)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2e0d2e82-8b0d-4ddf-9fb3-e4334ebc9b29

	measure 'Last avg total' =
			calculate(average(PersonReferralAssessments[Response Answer Selected Value]),PersonReferralAssessments[Assessment Performed Type]="Last Assessment"
			&&PersonReferralAssessments[Outcome Tool Question ID]<>"Score1"&&PersonReferralAssessments[Outcome Tool Question ID]<>"Score2"&&PersonReferralAssessments[Outcome Tool Question ID]<>"Score3"&&PersonReferralAssessments[Outcome Tool Question ID]<>"Score4"
			,PersonReferralAssessments[Question Text]="Total")
		formatString: 0.0
		lineageTag: e2d86da9-b215-48ca-bf85-25dd995f2e7d

	measure '%Diff Latest to First Avg' = if(isblank([First avg total])||[First avg total]=0,blank(), divide([Last avg total],[First avg total])-1)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d90ce3ad-bf33-4c01-a57f-11fee3bc58b7

	measure '%Diff Latest to Previous Avg' = if(isblank([Previous avg total])||[Previous avg total]=0,blank(), divide([Last avg total],[Previous avg total])-1)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 95698c47-67e4-401c-85fa-aab24bb75513

	measure 'Change first to last type' = if([%Diff Latest to First Avg]<0,"Lower","")
		lineageTag: 9d7620db-7295-446a-b998-4e7893466917

	measure 'Number latest assessments' = calculate(DISTINCTCOUNT(PersonReferralAssessments[Assessment ID Key]),PersonReferralAssessments[order_desc]=1&&PersonReferralAssessments[order_asc]>1,PersonReferralAssessments[Question Text]="Total")
		formatString: 0
