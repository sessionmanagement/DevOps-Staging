		source =
				let
				    Source = Sql.Database("Synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="-- ============================================================#(lf)-- Model:  Outcome Assessment Dataset#(lf)-- Table:  PersonReferralAssessments#(lf)-- Source: native query (complex CTE/window) - emitted in full#(lf)-- Used columns: 19 (mapped 19, unmapped 0)  [full query, not trimmed]#(lf)-- Auto-generated from pbi_complete_dump.csv + model M + EDW/ODS schema.#(lf)-- Review before use; verify joins/filters against the model.#(lf)-- ============================================================#(lf)-- USED model columns: Assessment ID Key; Assessment Performed Type; Assessment Status; Outcome Tool Question ID; Outcome Tool Title; PersonID; Question Text; Questions; Response Answer Selected Value; Response Created Date; age_response; assessment_count; date_last_assessment; dim_client_team_unique_key; ethnicitygroup; gendertext; order_asc; order_desc; question#(lf)#(lf)WITH People AS (#(lf)    SELECT#(lf)       'EAL' as company,#(lf)        dlDimPerson.Personid,#(lf)        dlDimPerson.PersonFirstName,#(lf)        dlDimPerson.PersonLastName,#(lf)        dlDimPerson.PersonDateOfBirth,#(lf)        dlDimPerson.PersonDeceasedDate , --ISNULL(dlDimGenderIdentity.GenderIdentityText, 'Unspecified or Unknown') as GenderIdentityText#(lf)        ISNULL(dlDimGender.GenderText, 'Unspecified or Unknown') AS GenderText,#(lf)        concat(#(lf)            eth1.ethnicitytext,#(lf)            ',',#(lf)            ethp1.ethnicitytext,#(lf)            ',',#(lf)            eth2.ethnicitytext,#(lf)            ',',#(lf)            ethp2.ethnicitytext,#(lf)            ',',#(lf)            eth3.ethnicitytext,#(lf)            ',',#(lf)            ethp3.ethnicitytext#(lf)        ) AS ethnicitytextall,#(lf)        concat(#(lf)            eth1.ethnicityvalue,#(lf)            ',',#(lf)            ethp1.ethnicityvalue,#(lf)            ',',#(lf)            eth2.ethnicityvalue,#(lf)            ',',#(lf)            ethp2.ethnicityvalue,#(lf)            ',',#(lf)            eth3.ethnicityvalue,#(lf)            ',',#(lf)            ethp3.ethnicityvalue#(lf)        ) AS ethnicityvalueall#(lf)    FROM#(lf)        RBEAL.dldimperson#(lf)        LEFT JOIN rbeal.dlDimGender ON dlDimPerson.GenderID = dlDimGender.GenderID#(lf)        LEFT JOIN rbeal.dlDimEthnicity AS eth1 ON dlDimPerson.Ethnicity1ID = eth1.EthnicityID#(lf)        LEFT JOIN rbeal.dlDimEthnicity AS ethp1 ON eth1.ethnicityparentid = ethp1.ethnicityid#(lf)        LEFT JOIN rbeal.dlDimEthnicity AS eth2 ON dlDimPerson.Ethnicity2ID = eth2.EthnicityID#(lf)        LEFT JOIN rbeal.dlDimEthnicity AS ethp2 ON eth2.ethnicityparentid = ethp2.ethnicityid#(lf)        LEFT JOIN rbeal.dlDimEthnicity AS eth3 ON dlDimPerson.Ethnicity3ID = eth3.EthnicityID#(lf)        LEFT JOIN rbeal.dlDimEthnicity AS ethp3 ON eth3.ethnicityparentid = ethp3.ethnicityid#(lf)       Union All#(lf)    SELECT#(lf)#(tab)#(tab) 'MNB' as company,#(lf)        dlDimPerson.Personid,#(lf)        dlDimPerson.PersonFirstName,#(lf)        dlDimPerson.PersonLastName,#(lf)        dlDimPerson.PersonDateOfBirth,#(lf)        dlDimPerson.PersonDeceasedDate , --ISNULL(dlDimGenderIdentity.GenderIdentityText, 'Unspecified or Unknown') as GenderIdentityText#(lf)        ISNULL(dlDimGender.GenderText, 'Unspecified or Unknown') AS GenderText,#(lf)        concat(#(lf)            eth1.ethnicitytext,#(lf)            ',',#(lf)            ethp1.ethnicitytext,#(lf)            ',',#(lf)            eth2.ethnicitytext,#(lf)            ',',#(lf)            ethp2.ethnicitytext,#(lf)            ',',#(lf)            eth3.ethnicitytext,#(lf)            ',',#(lf)            ethp3.ethnicitytext#(lf)        ) AS ethnicitytextall,#(lf)        concat(#(lf)            eth1.ethnicityvalue,#(lf)            ',',#(lf)            ethp1.ethnicityvalue,#(lf)            ',',#(lf)            eth2.ethnicityvalue,#(lf)            ',',#(lf)            ethp2.ethnicityvalue,#(lf)            ',',#(lf)            eth3.ethnicityvalue,#(lf)            ',',#(lf)            ethp3.ethnicityvalue#(lf)        ) AS ethnicityvalueall#(lf)    FROM#(lf)        RBMNB.dlDimPerson#(lf)        LEFT JOIN rbmnb.dlDimEthnicity ON dlDimPerson.Ethnicity1ID = dlDimEthnicity.EthnicityID --LEFT JOIN rbeal.dlDimGenderIdentity#(tab)ON DimPerson.GenderIdentityId#(tab)= dlDimGenderIdentity.GenderIdentityID#(lf)        LEFT JOIN rbmnb.dlDimGender ON dlDimPerson.GenderID = dlDimGender.GenderID#(lf)        LEFT JOIN rbmnb.dlDimEthnicity AS eth1 ON dlDimPerson.Ethnicity1ID = eth1.EthnicityID#(lf)        LEFT JOIN rbmnb.dlDimEthnicity AS ethp1 ON eth1.ethnicityparentid = ethp1.ethnicityid#(lf)        LEFT JOIN rbmnb.dlDimEthnicity AS eth2 ON dlDimPerson.Ethnicity2ID = eth2.EthnicityID#(lf)        LEFT JOIN rbmnb.dlDimEthnicity AS ethp2 ON eth2.ethnicityparentid = ethp2.ethnicityid#(lf)        LEFT JOIN rbmnb.dlDimEthnicity AS eth3 ON dlDimPerson.Ethnicity3ID = eth3.EthnicityID#(lf)        LEFT JOIN rbmnb.dlDimEthnicity AS ethp3 ON eth3.ethnicityparentid = ethp3.ethnicityid#(lf)      #(lf))#(lf),#(lf)PeoplewithEthnicityGroup as#(lf)(#(lf)select #(lf)Company+','+cast(Personid as nvarchar) as personidkey,#(lf)* ,#(lf)CASE#(lf)            WHEN ethnicityvalueall LIKE '%,21,%'#(lf)            OR ethnicityvalueall LIKE '21,%'#(lf)            OR ethnicityvalueall LIKE '%,21' THEN 'Maori'#(lf)            WHEN ethnicityvalueall LIKE '31,%'#(lf)            OR ethnicityvalueall LIKE '%,31,%' THEN 'Pasifika'#(lf)            WHEN ethnicityvalueall LIKE '32,%'#(lf)            OR ethnicityvalueall LIKE '33,%'#(lf)            OR ethnicityvalueall LIKE '34,%'#(lf)            OR ethnicityvalueall LIKE '35,%'#(lf)            OR ethnicityvalueall LIKE '36,%'#(lf)            OR ethnicityvalueall LIKE '37,%' THEN 'Pasifika'#(lf)            WHEN ethnicityvalueall LIKE '%,32,%'#(lf)            OR ethnicityvalueall LIKE '%,33,%'#(lf)            OR ethnicityvalueall LIKE '%,34,%'#(lf)            OR ethnicityvalueall LIKE '%,35,%'#(lf)            OR ethnicityvalueall LIKE '%,36,%'#(lf)            OR ethnicityvalueall LIKE '%,37,%' THEN 'Pasifika'#(lf)            WHEN ethnicityvalueall LIKE '%,32%'#(lf)            OR ethnicityvalueall LIKE '%,33%'#(lf)            OR ethnicityvalueall LIKE '%,34%'#(lf)            OR ethnicityvalueall LIKE '%,35%'#(lf)            OR ethnicityvalueall LIKE '%,36%'#(lf)            OR ethnicityvalueall LIKE '%,37%'#(lf)            OR ethnicityvalueall LIKE '%,30%'#(lf)            OR ethnicityvalueall LIKE '30,%' THEN 'Pasifika'#(lf)            WHEN ethnicityvalueall LIKE '40,%'#(lf)            OR ethnicityvalueall LIKE '%,40,%' THEN 'Asian'#(lf)            WHEN ethnicityvalueall LIKE '41,%'#(lf)            OR ethnicityvalueall LIKE '%,41,%' THEN 'Asian'#(lf)            WHEN ethnicityvalueall LIKE '42,%'#(lf)            OR ethnicityvalueall LIKE '43,%'#(lf)            OR ethnicityvalueall LIKE '44,%'#(lf)            OR ethnicityvalueall LIKE '45,%'#(lf)            OR ethnicityvalueall LIKE '46,%'#(lf)            OR ethnicityvalueall LIKE '47,%' THEN 'Asian'#(lf)            WHEN ethnicityvalueall LIKE '%,42,%'#(lf)            OR ethnicityvalueall LIKE '%,43,%'#(lf)            OR ethnicityvalueall LIKE '%,44,%'#(lf)            OR ethnicityvalueall LIKE '%,45,%'#(lf)            OR ethnicityvalueall LIKE '%,46,%'#(lf)            OR ethnicityvalueall LIKE '%,47,%' THEN 'Asian'#(lf)            WHEN ethnicityvalueall LIKE '%,42%'#(lf)            OR ethnicityvalueall LIKE '%,43%'#(lf)            OR ethnicityvalueall LIKE '%,44%'#(lf)            OR ethnicityvalueall LIKE '%,45%'#(lf)            OR ethnicityvalueall LIKE '%,46%'#(lf)            OR ethnicityvalueall LIKE '%,47%' THEN 'Asian'#(lf)            WHEN ethnicitytextall LIKE '%Japanese%'#(lf)            OR ethnicitytextall LIKE '%Korean%'#(lf)            OR ethnicitytextall LIKE '%Cambodian%'#(lf)            OR ethnicitytextall LIKE '%chinese%'#(lf)            OR ethnicitytextall LIKE '%Filipino%'#(lf)            OR ethnicitytextall LIKE '%Sri Lankan%'#(lf)            OR ethnicitytextall LIKE '%Asian%'#(lf)            OR ethnicitytextall LIKE '%vietnamese%' THEN 'Asian'#(lf)            WHEN ethnicityvalueall LIKE '50,%'#(lf)            OR ethnicityvalueall LIKE '%,50,%' THEN 'Middle Eastern, Latin American, African'#(lf)            WHEN ethnicityvalueall LIKE '51,%'#(lf)            OR ethnicityvalueall LIKE '%,51,%' THEN 'Middle Eastern, Latin American, African'#(lf)            WHEN ethnicityvalueall LIKE '52,%'#(lf)            OR ethnicityvalueall LIKE '53,%' THEN 'Middle Eastern, Latin American, African'#(lf)            WHEN ethnicityvalueall LIKE '%,52,%'#(lf)            OR ethnicityvalueall LIKE '%,53,%' THEN 'Middle Eastern, Latin American, African'#(lf)            WHEN ethnicityvalueall LIKE '%,52%'#(lf)            OR ethnicityvalueall LIKE '%,53%' THEN 'Middle Eastern, Latin American, African'#(lf)            WHEN ethnicityvalueall LIKE '10,%'#(lf)            OR ethnicityvalueall LIKE '%,10,%'#(lf)            OR ethnicityvalueall LIKE '11,%'#(lf)            OR ethnicityvalueall LIKE '%,11,%'#(lf)            OR ethnicityvalueall LIKE '12,%'#(lf)            OR ethnicityvalueall LIKE '%,12,%' THEN 'European'#(lf)            WHEN ethnicitytextall LIKE 'australian%'#(lf)            OR ethnicitytextall LIKE 'british%'#(lf)            OR ethnicitytextall LIKE 'dutch%'#(lf)            OR ethnicitytextall LIKE 'german%'#(lf)            OR ethnicitytextall LIKE 'italian%'#(lf)            OR ethnicitytextall LIKE 'greek%'#(lf)            OR ethnicitytextall LIKE 'polish%'#(lf)            OR ethnicitytextall LIKE '%european%'#(lf)            OR ethnicitytextall LIKE '%slav%' THEN 'European'#(lf)            WHEN ethnicityvalueall LIKE '%,54,%'#(lf)            OR ethnicityvalueall LIKE '%,54%'#(lf)            OR ethnicityvalueall LIKE '54,%' THEN 'Other'#(lf)            ELSE 'Unknown'#(lf)        END AS ethnicitygroup,#(lf)        CASE#(lf)            WHEN ethnicityvalueall LIKE '%,21,%'#(lf)            OR ethnicityvalueall LIKE '21,%'#(lf)            OR ethnicityvalueall LIKE '%,21' THEN 1#(lf)            ELSE 0#(lf)        END AS Maori_Indicator,#(lf)        CASE#(lf)            WHEN ethnicityvalueall LIKE '31,%'#(lf)            OR ethnicityvalueall LIKE '%,31,%' THEN 1#(lf)            WHEN ethnicityvalueall LIKE '32,%'#(lf)            OR ethnicityvalueall LIKE '33,%'#(lf)            OR ethnicityvalueall LIKE '34,%'#(lf)            OR ethnicityvalueall LIKE '35,%'#(lf)            OR ethnicityvalueall LIKE '36,%'#(lf)            OR ethnicityvalueall LIKE '37,%' THEN 1#(lf)            WHEN ethnicityvalueall LIKE '%,32,%'#(lf)            OR ethnicityvalueall LIKE '%,33,%'#(lf)            OR ethnicityvalueall LIKE '%,34,%'#(lf)            OR ethnicityvalueall LIKE '%,35,%'#(lf)            OR ethnicityvalueall LIKE '%,36,%'#(lf)            OR ethnicityvalueall LIKE '%,37,%' THEN 1#(lf)            WHEN ethnicityvalueall LIKE '%,32%'#(lf)            OR ethnicityvalueall LIKE '%,33%'#(lf)            OR ethnicityvalueall LIKE '%,34%'#(lf)            OR ethnicityvalueall LIKE '%,35%'#(lf)            OR ethnicityvalueall LIKE '%,36%'#(lf)            OR ethnicityvalueall LIKE '%,37%'#(lf)            OR ethnicityvalueall LIKE '%,30%'#(lf)            OR ethnicityvalueall LIKE '30,%' THEN 1#(lf)            ELSE 0#(lf)        END AS Pasifika_Indicator#(lf)#(tab)from people #(lf)#(tab)),#(lf)#(tab)ReferralDataEAL AS (#(lf)    SELECT#(lf)#(tab)#(tab)'EAL' as company,#(lf)        LegacyFactReferral.PersonID,#(lf)        LegacyFactReferral.ID AS ReferralID,#(lf)        LegacyFactReferral.ServiceStartDate,#(lf)        isnull(LegacyFactReferral.ServiceEndDate,cast(getdate() as date)) AS ServiceEndDate,#(lf)        LegacyFactReferral.ReceivedDate,#(lf)        LegacyFactReferral.CreatedDate,#(lf)        LegacyFactReferral.AcceptedDate,#(lf)        LegacyFactReferral.DischargeDate,#(lf)        ISNULL(LegacyFactReferral.DischargeDate, cast(getdate() as date)) AS ProxyEnd