	measure 'Previous avg total_HuaO' = calculate(average(PersonReferralAssessments[Response Answer Selected Value]),PersonReferralAssessments[order_desc]=2&&PersonReferralAssessments[order_asc]>1&&PersonReferralAssessments[Outcome Tool Title]="Hua Oranga - Primary Care"&&(PersonReferralAssessments[Outcome Tool Question ID]="Score1"||PersonReferralAssessments[Outcome Tool Question ID]="Score2"||PersonReferralAssessments[Outcome Tool Question ID]="Score3"||PersonReferralAssessments[Outcome Tool Question ID]="Score4"))
		formatString: 0.0
