ontractID = dlDimContract.ContractID#(lf)         WHERE#(lf)        --CAST(LegacyFactReferral.ReceivedDate AS DATE) >= '2010-01-01'#(lf)        --AND #(lf)#(tab)#(tab)AcceptedDate IS NOT NULL and isinbound = 1#(lf)),#(lf)Referraldata0 AS (#(lf)    SELECT#(lf)     #(lf)        'EAL,' + CAST(Personid AS varchar(12)) AS PersonidKey,#(lf)        'EAL,' + CAST(Referralid AS varchar(12)) AS ReferralIDKey,#(lf)        *#(lf)    FROM#(lf)        referraldataeal where company = 'eal'#(lf)    UNION ALL#(lf)    SELECT#(lf)   #(lf)        'MNB,' + CAST(Personid AS varchar(12)) AS PersonidKey,#(lf)        'MNB,' + CAST(Referralid AS varchar(12)) AS ReferralIDKey,#(lf)        *#(lf)    FROM#(lf)        ReferralDataEAL where company = 'MNB'#(lf)) --=====================#(lf),#(lf)------=====================================================================#(lf)datablock1 AS (#(lf)    SELECT#(lf)        'EAL' + ',' + CAST(otFactoutcomeToolResponse.PersonID AS varchar(10)) AS personidkey,#(lf)        'EAL' + ',' + CAST(#(lf)            otFactOutcomeToolResponse.OutcomeToolResponseID AS varchar(20)#(lf)        ) AS assessmentidkey,#(lf)        'EAL' + ',' + CAST(#(lf)            otFactOutcomeToolResponse.ReferralID AS varchar(20)#(lf)        ) AS referralassessmentidkey,#(lf)        otFactoutcomeToolResponse.PersonID,#(lf)        cast(otFactOutcomeToolResponse.ResponseCreatedDate as date) as Responsecreateddate,#(lf)       -- dlDimUser.UserUsername AS AssessmentCompletedBy,#(lf)        otFactOutcomeToolResponse.OutcomeToolResponseID AS AssessmentId,#(lf)        otFactOutcomeToolResponse.ReferralID,#(lf)        otFactOutcomeToolResponseAnswer.OutcomeToolQuestionID,#(lf)#(tab)#(tab)otdimoutcometoolTemplate.questiontext,#(lf)        OutcomeToolTitle,#(lf)       -- iSNULL(responseAnswerSelectedValue , 0) AS ResponseAnswerSelectedValue#(lf)#(tab)#(tab)cast(isnull(responseAnswerSelectedValue,0) as int) as responseanswerselectedvalue#(lf)    FROM#(lf)        rbeal.otFactOutcomeToolResponse#(lf)        INNER JOIN rbeal.otDimOutcomeToolTemplate ON otFactOutcomeToolResponse.OutcomeToolTemplateID = otDimOutcomeToolTemplate.OutcomeToolTemplateID#(lf)        AND otdimoutcometooltemplate.OutcomeToolQuestionID IN (#(lf)            'q1',#(lf)            'q2',#(lf)            'q3',#(lf)            'q4',#(lf)            'q5',#(lf)            'q6',#(lf)            'q7',#(lf)            'q8',#(lf)            'q9',#(lf)            'q10',#(lf)            'q11',#(lf)            'q12',#(lf)            'q1A',#(lf)            'q2A',#(lf)            'q3A',#(lf)            'q4A',#(lf)            'q1B',#(lf)            'q2B',#(lf)            'q3B',#(lf)            'q4B',#(lf)            'q1C',#(lf)            'q2C',#(lf)            'q3C',#(lf)            'q4C',#(lf)            'q1D',#(lf)            'q2D',#(lf)            'q3D',#(lf)            'q4D',#(lf)#(tab)#(tab)#(tab)'score1',#(lf)#(tab)#(tab)#(tab)'score2',#(lf)#(tab)#(tab)#(tab)'score3',#(lf)#(tab)#(tab)#(tab)'score4'#(lf)        )#(lf)        AND OutcomeToolTitle IN (#(lf)            'kessler 10',#(lf)            'matrix',#(lf)            'Hua Oranga - Primary Care'#(lf)        )#(lf)        INNER JOIN rbeal.otFactOutcomeToolResponseAnswer ON otDimOutcomeToolTemplate.OutcomeToolTemplateID = otFactOutcomeToolResponseAnswer.OutcomeToolTemplateID#(lf)        AND otDimOutcomeToolTemplate.OutcomeToolQuestionID = otFactOutcomeToolResponseAnswer.outcometoolquestionid#(lf)        AND otFactOutcomeToolResponse.OutcomeToolResponseID = otFactOutcomeToolResponseAnswer.OutcomeToolResponseID#(lf)      --  LEFT OUTER JOIN rbeal.dlDimUser ON otFactOutcomeToolResponse.ResponseCreatedUserID = dlDimUser.UserID#(lf)    UNION ALL#(lf)    SELECT#(lf)        'MNB' + ',' + CAST(otFactoutcomeToolResponse.PersonID AS varchar(10)) AS personidkey,#(lf)        'MNB' + ',' + CAST(#(lf)            otFactOutcomeToolResponse.OutcomeToolResponseID AS varchar(20)#(lf)        ) AS assessmentidkey,#(lf)        'MNB' + ',' + CAST(#(lf)            otFactOutcomeToolResponse.ReferralID AS varchar(20)#(lf)        ) AS referralassessmentidkey,#(lf)        otFactoutcomeToolResponse.PersonID,#(lf)        cast(otFactOutcomeToolResponse.ResponseCreatedDate as date) as ResponseCreatedDate,#(lf)        --dlDimUser.UserUsername AS AssessmentCompletedBy,#(lf)        otFactOutcomeToolResponse.OutcomeToolResponseID AS AssessmentId,#(lf)        otFactOutcomeToolResponse.ReferralID,#(lf)        otFactOutcomeToolResponseAnswer.OutcomeToolQuestionID,#(lf)#(tab)#(tab)otdimoutcometoolTemplate.questiontext,#(lf)        OutcomeToolTitle,#(lf)        -- iSNULL(responseAnswerSelectedValue , 0) AS ResponseAnswerSelectedValue#(lf)#(tab)#(tab)cast(isnull(responseAnswerSelectedValue,0) as int) as responseanswerselectedvalue#(lf)    FROM#(lf)        rbmnb.otFactOutcomeToolResponse#(lf)        INNER JOIN rbmnb.otDimOutcomeToolTemplate ON otFactOutcomeToolResponse.OutcomeToolTemplateID = otDimOutcomeToolTemplate.OutcomeToolTemplateID#(lf)        AND otdimoutcometooltemplate.OutcomeToolQuestionID IN (#(lf)            'q1',#(lf)            'q2',#(lf)            'q3',#(lf)            'q4',#(lf)            'q5',#(lf)            'q6',#(lf)            'q7',#(lf)            'q8',#(lf)            'q9',#(lf)            'q10',#(lf)            'q11',#(lf)            'q12',#(lf)            'q1A',#(lf)            'q2A',#(lf)            'q3A',#(lf)            'q4A',#(lf)            'q1B',#(lf)            'q2B',#(lf)            'q3B',#(lf)            'q4B',#(lf)            'q1C',#(lf)            'q2C',#(lf)            'q3C',#(lf)            'q4C',#(lf)            'q1D',#(lf)            'q2D',#(lf)            'q3D',#(lf)            'q4D',#(lf)#(tab)#(tab)#(tab)'score1',#(lf)#(tab)#(tab)#(tab)'score2',#(lf)#(tab)#(tab)#(tab)'score3',#(lf)#(tab)#(tab)#(tab)'score4'#(lf)        )#(lf)        AND OutcomeToolTitle IN (#(lf)            'kessler 10',#(lf)            'matrix',#(lf)            'Hua Oranga - Primary Care'#(lf)        )#(lf)        INNER JOIN rbmnb.otFactOutcomeToolResponseAnswer ON otDimOutcomeToolTemplate.OutcomeToolTemplateID = otFactOutcomeToolResponseAnswer.OutcomeToolTemplateID#(lf)        AND otDimOutcomeToolTemplate.OutcomeToolQuestionID = otFactOutcomeToolResponseAnswer.outcometoolquestionid#(lf)        AND otFactOutcomeToolResponse.OutcomeToolResponseID = otFactOutcomeToolResponseAnswer.OutcomeToolResponseID#(lf)       -- LEFT OUTER JOIN rbmnb.dlDimUser ON otFactOutcomeToolResponse.ResponseCreatedUserID = dlDimUser.UserID#(lf))#(lf)#(lf)#(lf)#(lf),#(lf)#(lf)----======I need the added scores for Hua Oranga.  Score 1,2,3,4 are place holders for a sum that doesn't exist - looks good in the data table though#(lf)--======= so I'm summing the values for A-D for Q1,2,3 and 4 then inbedding them into what should be Score1,2,3,4 #(lf)--======= things always look good until  you want to use them!#(lf)--===here's the summing#(lf)scores as#(lf)(#(lf)select #(lf)#(lf)personidkey, assessmentidkey,left(outcometoolquestionid,2) as qid , sum(responseanswerselectedvalue ) as score#(lf)#(lf) from datablock1#(lf)where outcometooltitle like 'hua ora%'#(lf)and outcometoolquestionid not like 'score%'#(lf)#(lf)group by #(lf)personidkey, assessmentidkey,left(outcometoolquestionid,2)#(lf)),#(lf)--===making them compatible#(lf)scores_1 as#(lf)(#(lf)#(lf)select personidkey, assessmentidkey, #(lf)case when qid = 'q1' then 'Score1'#(lf)when qid = 'q2' then 'Score2'#(lf)when qid  = 'q3' then 'Score3'#(lf)when qid = 'q4' then 'Score4'#(lf)end as qid,#(lf)score #(lf)from scores#(lf))#(lf)--====and voila - bringing them back together again#(lf),datablock2 as#(lf)(#(lf)select #(lf)datablock1.personidkey#(lf),datablock1.assessmentidkey#(lf),datablock1.referralassessmentidkey#(lf),datablock1.personid#(lf),datablock1.responsecreateddate#(lf),datablock1.assessmentid#(lf),datablock1.referralid#(lf),datablock1.outcometoolquestionid#(lf),#(lf)case when questiontext ='Taha Tinana' then 'Taha Tinana (physical wellbeing)'#(lf)when questiontext = 'Taha Wairua' then 'Taha Wairua (spiritual wellbeing)'#(lf)when questiontext = 'Taha Whanau' then 'Taha Whanau (family wellbeing)'#(lf)when questiontext = 'taha hinengaro' then 'Taha Hinengaro (mental wellbeing)'#(lf)else questiontext#(lf)end as questiontext#(lf)#(lf),datablock1.outcometooltitle#(lf),case when score is not null then score#(lf) else responseanswerselectedvalue#(lf) end as responseanswerselectedvalue#(lf) from datablock1#(lf)left join scores_1 on datablock1.personidkey = scores_1.personidkey#(lf)and datablock1.assessmentidkey = scores_1.assessmentidkey#(lf)and outcometooltitle = 'hua oranga - primary care'#(lf)and datablock1.outcometoolquestionid = scores_1.qid#(lf)),#(lf)alldata as#(lf)(#(lf)select#(lf)datablock2.PersonID,#(lf)        datablock2.AssessmentID,#(lf)        referraldata0.ReferralID,#(lf)        datablock2.personidkey,#(lf)        datablock2.assessmentidkey,#(lf)        datablock2.referralassessmentidkey,#(lf)        referraldata0.referralidkey,#(lf)#(tab)#(tab)referraldata0.company,#(lf)        CASE#(lf)            WHEN referralassessmentidkey IS NULL#(lf)            AND referralidkey IS NOT NULL THEN 'Referral Derived'#(lf)            WHEN referralassessmentidkey = referralidkey#(lf)            AND referralidkey IS NOT NULL THEN 'Referral Stated'#(lf)            WHEN referralidkey IS NULL THEN 'Referral Not Found'#(lf)        END AS referralstatus,#(lf)        datablock2.ResponseCreatedDate,#(lf)      --  datablock2.AssessmentCompletedBy,#(lf)#(tab)    referraldata0.TeamIDKey,#(lf)#(tab)#(tab)Referraldata0.dim_client_team_unique_key,#(lf)        referraldata0.TeamID,#(lf)        referraldata0.TeamName,#(lf)#(tab)#(tab)peoplewithethnicitygroup.persondateofbirth,#(lf)#(tab)#(tab)peoplewithethnicitygroup.ethnicitygroup,#(lf)#(tab)#(tab)peoplewithethnicitygroup.maori_indicator,#(lf)#(tab)#(tab)peoplewithethnicitygroup.pasifika_indicator,#(lf)#(tab)#(tab)peoplewithethnicitygroup.gendertext,#(lf)        datablock2.OutcomeToolTitle,#(lf)        d