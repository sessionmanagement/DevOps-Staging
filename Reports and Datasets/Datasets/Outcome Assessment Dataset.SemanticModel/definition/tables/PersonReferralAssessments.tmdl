	measure 'First avg total_HuaO' =
			calculate(average(PersonReferralAssessments[Response Answer Selected Value]),PersonReferralAssessments[Assessment Performed Type]="First Assessment"&&PersonReferralAssessments[Assessment Status]=""
			&&PersonReferralAssessments[Outcome Tool Title]="Hua Oranga - Primary Care"
