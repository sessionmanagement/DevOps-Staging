		formatString: 0.0
		lineageTag: 7a2b3c4d-5e6f-4a7b-9c8d-0e1f2a3b4c5d

	measure 'Last avg total_HuaO' =
			calculate(average(PersonReferralAssessments[Response Answer Selected Value]),PersonReferralAssessments[Assessment Performed Type]="Last Assessment"
			&&PersonReferralAssessments[Outcome Tool Title]="Hua Oranga - Primary Care"
			&&(PersonReferralAssessments[Outcome Tool Question ID]="Score1"||PersonReferralAssessments[Outcome Tool Question ID]="Score2"||PersonReferralAssessments[Outcome Tool Question ID]="Score3"||PersonReferralAssessments[Outcome Tool Question ID]="Score4"))
		formatString: 0.0
		lineageTag: 8b3c4d5e-6f7a-4b8c-ad9e-1f2a3b4c5d6e

	measure '%Diff Latest to First Avg_HuaO' = if(isblank([First avg total_HuaO])||[First avg total_HuaO]=0,blank(), divide([Last avg total_HuaO],[First avg total_HuaO])-1)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9c4d5e6f-7a8b-4c9d-8e0f-2a3b4c5d6e7f

	measure '%Diff Latest to Previous Avg_HuaO' = if(isblank([Previous avg total_HuaO])||[Previous avg total_HuaO]=0,blank(), divide([Last avg total_HuaO],[Previous avg total_HuaO])-1)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ad5e6f7a-8b9c-4dae-9f1a-3b4c5d6e7f8a

