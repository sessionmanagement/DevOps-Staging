	partition DimDate(Dev)-73f81c8a-4024-48c5-89b4-585530d031e1 = m
		mode: import
		source = ```
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="/****** Script for SelectTopNRows command from SSMS  ******/#(lf)declare @currentmonthend date = eomonth(getdate())#(lf)declare @reportingmonthend date = eomonth(dateadd(month,-1,@currentmonthend))#(lf)declare @reportingmonthstart date =dateadd(day,+1, EOMONTH(DATEADD(month, -1, @reportingmonthend)))#(lf)#(lf)declare @reportingyearstart date = dateadd(month,+1,dateadd(year,-1,@reportingmonthstart))#(lf)declare @reporting3yearstart date = dateadd(month,+1,dateadd(year,-3,@reportingmonthstart))#(lf)#(lf)declare @reportingbd date = eomonth(dateadd(month,-2,@currentmonthend))#(lf)#(lf)#(lf)#(lf)SELECT #(lf)cast(calendar_year as nvarchar)+' '+cast(calendar_month_num as nvarchar) as calendar_date_key,#(lf)#(tab)calendar_date,#(lf)#(tab)calendar_first_day_of_month_date,#(lf)#(tab)calendar_first_day_of_month_flag,#(lf)#(tab)calendar_last_day_of_month_date,#(lf)#(tab)calendar_last_day_of_month_flag,#(lf)#(tab)calendar_month_num,#(lf)#(tab)calendar_year,#(lf)#(tab)calendar_month_name_short,#(lf)#(tab)case when calendar_date between @reportingmonthstart and @reportingmonthend then 1#(lf)#(tab)else 0#(lf)#(tab)end as current_month_indicator,#(lf)#(tab)case when calendar_date >= @reportingyearstart and calendar_date <=@reportingmonthend#(lf)#(tab)then 1#(lf)#(tab)else 0#(lf)#(tab)end as current_year_indicator,#(lf)#(tab)case when calendar_date >= @reporting3yearstart and calendar_date <=@reportingmonthend#(lf)#(tab)then 1#(lf)#(tab)else 0#(lf)#(tab)end as current_3_year_indicator,#(lf)#(tab)case when calendar_date <= @reportingmonthend then 1#(lf)#(tab)else 0#(lf)#(tab)end as reporting_indicator_all,#(lf)#(tab)@reportingmonthstart as currentreportingmonthstart,#(lf)#(tab)@reportingmonthend as currentreportingmonthend, #(lf)#(tab)@reportingyearstart as reportingyearstart,#(lf)#(tab)@reporting3yearstart as reporting3yearstart,#(lf)#(tab)case when calendar_date <= @reportingbd then 1 else 0 end as board_reporting#(lf)#(tab)#(tab)#(lf)  FROM [edw].[vw_dim_date]#(lf)  where calendar_date >= '1990-01-01' #(lf)  and calendar_date <=  @reportingmonthend#(lf)"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"calendar_date", type date}, {"calendar_first_day_of_month_date", type date}, {"calendar_last_day_of_month_date", type date}, {"currentreportingmonthstart", type date}, {"currentreportingmonthend", type date}, {"reportingyearstart", type date}, {"reporting3yearstart", type date}}),
				    #"Duplicated Column" = Table.DuplicateColumn(#"Changed Type", "calendar_month_num", "calendar_month_num - Copy"),
				    #"Duplicated Column1" = Table.DuplicateColumn(#"Duplicated Column", "calendar_month_name_short", "calendar_month_name_short - Copy"),
				    #"Merged Columns" = Table.CombineColumns(Table.TransformColumnTypes(#"Duplicated Column1", {{"calendar_month_num - Copy", type text}}, "en-NZ"),{"calendar_month_num - Copy", "calendar_month_name_short - Copy"},Combiner.CombineTextByDelimiter(" ", QuoteStyle.None),"Merged"),
				    #"Renamed Columns" = Table.RenameColumns(#"Merged Columns",{{"Merged", "Calendar Month"}}),
				
				    // Reference the parameter "Reporting Months Ago"
				    ReportingPeriod = #"Reporting Months Ago",
				
				    // Get the current date and time, and then extract just the date
				    // DateTime.LocalNow() returns the current date and time, DateTime.Date() extracts just the date part
				    Today = DateTime.LocalNow(),
				    TodayDate = DateTime.Date(Today),
				    
				    // Calculate the target month and year based on the current date and the ReportingPeriod parameter
				    TargetDate = Date.AddMonths(TodayDate, -ReportingPeriod),
				    
				    // Create a list of 12 months starting from TargetDate and going 11 months back
				    // List.Transform() applies a function to each item in the original list ({0..11} in this case)
				    TwelveMonthsList = List.Transform({0..11}, each Date.ToText(Date.AddMonths(TargetDate, -_), "yyyy-MM")),
				    
				    // Add a new dynamic calculated column for Reporting Month
				    // This column will label each month relative to the Reporting Month
				    #"Added Reporting Month" = Table.AddColumn(#"Renamed Columns", "Reporting Month", each 
				        let
				            // Extract the calendar_date from the current row
				            CurrentDate = [calendar_date],
				            
				            // Convert the calendar_date to a string in "yyyy-MM" format for easier comparison
				            CurrentDateStr = Date.ToText(CurrentDate, "yyyy-MM"),
				            
				            // Find the position of the current month in the TwelveMonthsList
				            // If the month is not found, List.PositionOf() returns -1
				            MonthOffset = List.PositionOf(TwelveMonthsList, CurrentDateStr)
				        in
				            // Label the month based on its position in the TwelveMonthsList
				            if MonthOffset = 0 then "Reporting Month"
				            else if MonthOffset = 1 then "1 Month Prior to Reporting Month"
				            else if MonthOffset > 1 then Text.From(MonthOffset) & " Months Prior to Reporting Month"
				            else ""
				    )
				in
				    #"Added Reporting Month"
				```

	annotation PBI_ResultType = Table

