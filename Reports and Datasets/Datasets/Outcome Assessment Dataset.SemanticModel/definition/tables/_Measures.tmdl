	measure ---NewFiltersApplied2 = ```
			
			VAR __Year = IF(ISFILTERED('DimDate(Dev)'[calendar_year]), CONCATENATEX(FILTERS('DimDate(Dev)'[calendar_year]), 'DimDate(Dev)'[calendar_year], ", "), BLANK())
			
			VAR __Month = IF(ISFILTERED('DimDate(Dev)'[calendar_month_name_short]), CONCATENATEX(FILTERS('DimDate(Dev)'[calendar_month_name_short]), 'DimDate(Dev)'[calendar_month_name_short], ", "), BLANK())
			
			VAR __ParentAreas = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES('DimTeam(ODS)'[Company]), NOT(ISBLANK('DimTeam(ODS)'[Company]))), 'DimTeam(ODS)'[Company], ASC),
			    "AreaParentName_display", 'DimTeam(ODS)'[Company])
			VAR __ParentAreasCount = IF(ISFILTERED('DimTeam(ODS)'[Company]), COUNTROWS(VALUES('DimTeam(ODS)'[Company])), 0)
			VAR __MoreParentAreas = IF(__ParentAreasCount > 10, " and " & (__ParentAreasCount - 10) & " more", "")
			VAR __Services = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES('DimTeam(ODS)'[Team Name]), NOT(ISBLANK('DimTeam(ODS)'[Team Name]))), 'DimTeam(ODS)'[Team Name], ASC),
			    "TeamName_display", 'DimTeam(ODS)'[Team Name]
			)
			VAR __ServicesCount = IF(ISFILTERED('DimTeam(ODS)'[Team Name]), COUNTROWS(VALUES('DimTeam(ODS)'[Team Name])), 0)
			VAR __MoreServices = IF(__ServicesCount > 10, " and " & (__ServicesCount - 10) & " more", "")
			
			VAR _FC_Year = IF(ISBLANK(__Year), BLANK(), "| Year(s) chosen: " & __Year)
			
			VAR _FC_Month = IF(ISBLANK(__Month), BLANK(), "| Month(s) chosen: " & __Month)
			VAR _FC_ParentAreas = IF(__ParentAreasCount > 0, "| Company: " & CONCATENATEX(__ParentAreas, [AreaParentName_display], ", "), BLANK())
			VAR _FC_MoreParentAreas = IF(__ParentAreasCount > 5, " and " & (__ParentAreasCount - 10) & " more", "")
			
			VAR _FC_Services = IF(__ServicesCount > 0, "| Teams chosen: " & CONCATENATEX(__Services, [TeamName_display], ", "), BLANK())
			VAR _FC_MoreServices = IF(__ServicesCount > 10, " and " & (__ServicesCount - 10) & " more", "")
			
			VAR _FirstDate = MIN('DimDate(Dev)'[calendar_date])
			VAR _LastDate = MAX('DimDate(Dev)'[calendar_date])
			RETURN
			    "-- Summary of filters applied to page: " & " " & _FC_Year & " "  & _FC_Month & " " & _FC_ParentAreas & _FC_MoreParentAreas & " " & _FC_Services & _FC_MoreServices
			
			
			```
		lineageTag: 01896ef3-59fb-433f-87d9-8fee7e34fbd1

