table _Measures
	lineageTag: d7709112-34a3-4bae-9afb-03c288aa6289

	measure 'Average Total Score' = if([Number of Assessments]>0&&[Total Scores]>0, [Total Scores]/[Number of Assessments])
		formatString: 0.0
		displayFolder: Assessments Only
		lineageTag: 2ba984c0-5445-4af2-8a47-21516f663407

	measure 'Number of Assessments' = calculate(countrows(AssessmentOnly),USERELATIONSHIP(AssessmentOnly[Response Created Date],'DimDate(Dev)'[calendar_date]))
		formatString: #,0
		displayFolder: Assessments Only
		lineageTag: e4a7e881-4963-4ad1-b036-e65a7fb1dd66

	measure 'Total Scores' = ```
			
			 calculate
			 (sum(AssessmentOnly[Total_Score]),userelationship(AssessmentOnly[Response Created Date],'DimDate(Dev)'[calendar_date]))
			```
		formatString: 0
		displayFolder: Assessments Only
		lineageTag: f048cfe9-3226-4f99-8f3c-48f140fe2aa7

	measure '% Referrals with only 1 assessment' = ```
			IF([Number of active referrals]>0&&[Referrals witn Only 1 Assessment]>0,[Referrals witn Only 1 Assessment]/[Number of active referrals],0)
			
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Referral Based
		lineageTag: 6871550e-a9af-4dce-8c01-736bfe163532

	measure '%Positive Change Overall' = if([Overall Positive Change]>0 && [More than 1 Assessment]>0, [Overall Positive Change]/[More than 1 Assessment],"")
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Referral Based
		lineageTag: 5eed8f3a-b765-4b36-a079-3cd944b54309

	measure '%Positive Change from last to previous assessment' = if([Positive Change Previous]>0 && [More than 1 Assessment]>0, [Positive Change Previous]/[More than 1 Assessment],"")
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Referral Based
		lineageTag: caaef490-7816-4baf-9834-764537a58a5d

	measure '% active referrals with 2 or more assessments' = IF([Number of active referrals]>0&&[More than 1 Assessment]>0,[More than 1 Assessment]/[Number of active referrals],"")
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Referral Based
		lineageTag: 71c12166-dce4-4da0-86c7-b5fc304f288a

	measure 'More than 1 Assessment' = ```
			
			Var CalculateAss = calculate(DISTINCTCOUNT('AssessmentReferralExplosion'[ReferralIDKey]),'AssessmentReferralExplosion'[assessmentstatus]="1. More than 1 assessment",AssessmentReferralExplosion[referral_counts]=1) 
			Return
			if(CalculateAss > 0 , CalculateAss,0)
			```
		formatString: #,0
		displayFolder: Referral Based
		lineageTag: 27fa69e0-08ee-463a-b2a0-77c564e04e19

	measure 'No Assessment' = ```
			
			Var NoAss = calculate(DISTINCTCOUNT('AssessmentReferralExplosion'[ReferralIDKey]),'AssessmentReferralExplosion'[assessmentstatus]="3. No Assessments",AssessmentReferralExplosion[referral_counts]=1) 
			Return
			if(NoAss >0 , NoAss,0)
			```
		formatString: #,0
		displayFolder: Referral Based
		lineageTag: d07b8a42-8df0-4198-ae2d-5c6dc4c00445

	measure '% active referrals without an assessment' = IF([Number of active referrals]>0&&[No Assessment]>0,[No Assessment]/[Number of active referrals],0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Referral Based
		lineageTag: 9edfa043-e60e-4c8a-b121-32c6d677114e

	measure 'Number of active referrals' =
			
			Var CalculationRef = calculate(DISTINCTCOUNT(AssessmentReferralExplosion[referralidkey]),AssessmentReferralExplosion[referral_counts]=1)
			Return
			if (CalculationRef >0 , CalculationRef,0)
		formatString: #,0
		displayFolder: Referral Based
		lineageTag: 2c586f0e-b5ff-46fe-ad74-e81b58d04612

	measure 'Overall Positive Change' =
			
			calculate(DISTINCTCOUNT('AssessmentReferralExplosion'[ReferralIDKey]),'AssessmentReferralExplosion'[score_change]="Increase")
		formatString: 0
		displayFolder: Referral Based
		lineageTag: 50940146-c929-437c-b40d-57fd6a6b315b

	measure 'Positive Change Previous' =
			
			calculate(DISTINCTCOUNT('AssessmentReferralExplosion'[ReferralIDKey]),'AssessmentReferralExplosion'[score_changeprevious]="Increase")
		formatString: 0
		displayFolder: Referral Based
		lineageTag: c6a41529-f121-480c-b8c5-1f840be1b5e1

	measure 'Referrals witn Only 1 Assessment' =
			
			VAR CalculateAss1 = calculate(DISTINCTCOUNT('AssessmentReferralExplosion'[ReferralIDKey]),'AssessmentReferralExplosion'[assessmentstatus]="2. Only 1 Assessment",AssessmentReferralExplosion[referral_counts]=1)
			RETURN
			if(CalculateAss1 >0, CalculateAss1,0)
		formatString: #,0
		displayFolder: Referral Based
		lineageTag: ef989db3-fe7e-4145-ab90-48ad97cfc758

	measure 'Taha Tinana Average' = ```
			
			Var NewMeasure = 
			calculate(sumx(Distinct(AssessmentOnly),AssessmentOnly[HOPQ1]),USERELATIONSHIP(AssessmentOnly[Response Created Date],'DimDate(Dev)'[calendar_date]))
			Var NewCount = 
			calculate(countx(distinct(AssessmentOnly),AssessmentOnly[HOPQ1]),USERELATIONSHIP(AssessmentOnly[Response Created Date],'DimDate(Dev)'[calendar_date]))
			Return
			if(NewCount>0,
			calculate(NewMeasure/NewCount,USERELATIONSHIP(AssessmentOnly[Response Created Date],'DimDate(Dev)'[calendar_date]))
			
			)
			```
		formatString: 0.0
		displayFolder: Hua Oranga
		lineageTag: 51c5b5fc-815f-46f8-8ff9-93cf57cba05e

