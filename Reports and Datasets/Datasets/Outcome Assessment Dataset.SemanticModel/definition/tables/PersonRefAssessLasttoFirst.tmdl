        --   AssessmentCompletedBy#(lf)            FROM#(lf)                datablock1#(lf)        ) AS DATA1 PIVOT (#(lf)            MAX(ResponseAnswerSelectedValue) --doesn't make a difference because there should only be one value per line#(lf)            FOR OutcomeToolQuestionID IN (#(lf)                [Q1],#(lf)                [Q2],#(lf)                [Q3],#(lf)                [Q4],#(lf)                [Q5],#(lf)                [Q6],#(lf)                [Q7],#(lf)                [Q8],#(lf)                [Q9],#(lf)                [Q10],#(lf)                [Q11],#(lf)                [Q12],#(lf)                [Q1A],#(lf)                [Q2A],#(lf)                [Q3A],#(lf)                [Q4A],#(lf)                [Q1B],#(lf)                [Q2B],#(lf)                [Q3B],#(lf)                [Q4B],#(lf)                [Q1C],#(lf)                [Q2C],#(lf)                [Q3C],#(lf)                [Q4C],#(lf)                [Q1D],#(lf)                [Q2D],#(lf)                [Q3D],#(lf)                [Q4D]#(lf)            )#(lf)        ) AS Pvt#(lf))#(lf)#(lf),#(lf)#(lf)datablockpivot2_0 AS (#(lf)    SELECT#(lf)        DataBlockPivot.PersonID,#(lf)        DataBlockPivot.AssessmentID,#(lf)        referraldata0.ReferralID,#(lf)        datablockpivot.personidkey,#(lf)        datablockpivot.assessmentidkey,#(lf)        datablockpivot.referralassessmentidkey,#(lf)        referraldata0.referralidkey,#(lf)#(tab)#(tab)referraldata0.company,#(lf)        CASE#(lf)            WHEN referralassessmentidkey IS NULL#(lf)            AND referralidkey IS NOT NULL THEN 'Referral Derived'#(lf)            WHEN referralassessmentidkey = referralidkey#(lf)            AND referralidkey IS NOT NULL THEN 'Referral Stated'#(lf)            WHEN referralidkey IS NULL THEN 'Referral Not Found'#(lf)        END AS referralstatus,#(lf)        DataBlockPivot.ResponseCreatedDate,#(lf)      --  DataBlockPivot.AssessmentCompletedBy,#(lf)#(tab)    referraldata0.TeamIDKey,#(lf)#(tab)#(tab)