 = #level_5_AllStaff.employee_job_name#(lf)#(tab)and #levels6_7.dim_company_key = 5#(lf)#(lf)#(lf)--=====level 4 #(lf)select * #(lf)into #levels_4_5_6_7#(lf)from #levels5_6_7#(lf)union#(lf)select #(lf)distinct -- you have to have a service manager here, some people like Vicky Power don't and go straight to district Manager#(lf) #level_4_AllStaff.hierarchy_number,#(lf)   #levels5_6_7.service_name#(lf) , #levels5_6_7.service_id#(lf) , #levels5_6_7.dim_service_key#(lf) , #levels5_6_7.dim_company_key#(lf) , #levels5_6_7.company#(lf) , #levels5_6_7.department_name#(lf) , #levels5_6_7.district_name#(lf) , #levels5_6_7.region_name#(lf) ,#level_4_allstaff.dim_employee_key#(lf) ,#level_4_allstaff.employee_id#(lf) ,#level_4_allstaff.employee_primary_email_address#(lf) ,#level_4_allstaff.employee_current_status#(lf) ,#level_4_allstaff.employee_job_name#(lf) ,#level_4_AllStaff.company AS levelcompany#(lf) --into #levels6_7_5#(lf) from #levels5_6_7#(lf) inner join #level_4_AllStaff on #levels5_6_7.region_name = #level_4_AllStaff.region_name#(lf)#(tab)and #levels5_6_7.levelcompany = #level_4_AllStaff.company#(lf)#(tab)and #levels5_6_7.district_name  not in ('hd clinical operations Manager')#(lf)#(tab)and #level_4_allstaff.employee_job_name not in ('national property & asset manager')#(lf)#(tab)--and #levels6_7_5.levelcompany not like 'mind%'#(lf)union #(lf)select #(lf)distinct -- you have to have a service manager here, some people like Vicky Power don't and go straight to district Manager#(lf) #level_4_AllStaff.hierarchy_number,#(lf)   #levels5_6_7.service_name#(lf) , #levels5_6_7.service_id#(lf) , #levels5_6_7.dim_service_key#(lf) , #levels5_6_7.dim_company_key#(lf) , #levels5_6_7.company#(lf) , #levels5_6_7.department_name#(lf) , #levels5_6_7.district_name#(lf) , #levels5_6_7.region_name#(lf) ,#level_4_allstaff.dim_employee_key#(lf) ,#level_4_allstaff.employee_id#(lf) ,#level_4_allstaff.employee_primary_email_address#(lf) ,#level_4_allstaff.employee_current_status#(lf) ,#level