model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-NZ
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Timi

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DimDate(Dev)","dim_company","info_last_refreshed","_Measures","DimAgeGroup(Dev)","DimEthnicGroup","DimGenderGroup","DimTeam(ODS)","DimOutcomeTool(ODS)","AssessmentReferralExplosion","AssessmentOnly","PersonReferralAssessments","PersonRefAssessLasttoFirst","dim_employee_hierarchy","RB_UserTeamAccess","RB_DimUser","Data & Measure Definition Catalogue","Reporting Months Ago","Database","Server","Additional Access","RLS - New RB Structure ALL services","RLS with Additional Access","Executinve Masking"]

annotation __TEdtr = 1

annotation PBI_ProTooling = ["DevMode"]

ref table DimDate(Dev)
ref table _Measures
ref table dim_company
ref table info_last_refreshed
ref table DimAgeGroup(Dev)
ref table DimEthnicGroup
ref table DimGenderGroup
ref table DimTeam(ODS)
ref table DimOutcomeTool(ODS)
ref table AssessmentReferralExplosion
ref table AssessmentOnly
ref table PersonReferralAssessments
ref table PersonRefAssessLasttoFirst
ref table dim_employee_hierarchy
ref table RB_DimUser
ref table 'Data & Measure Definition Catalogue'
ref table 'RLS with Additional Access'
ref table 'Executinve Masking'

ref role AllAccess
ref role Public

ref cultureInfo en-US

