                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This report shows information from the Power BI Activity Log that is loaded to the Enterprise Data Warehouse.",
                    "textStyle": {
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "For more detailed information on the underlying data that the visuals are built upon, please click the question mark button in the top right-hand corner of any page.",
                    "textStyle": {
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
