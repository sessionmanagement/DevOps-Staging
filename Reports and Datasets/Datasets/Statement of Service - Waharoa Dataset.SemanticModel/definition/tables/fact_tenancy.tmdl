	partition fact_tenancy-86a0de21-ed98-43c9-bb49-729f3ff2eee1 = m
		mode: import
		queryGroup: facts
		source =
				let
				    EDW = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="SELECT#(lf)    property_tenancy_id AS opportunityid,#(lf)    property_id AS zav_property,#(lf)    property_tenancy_tenancy_name AS name,#(lf)    property_tenancy_property_name AS zav_propertyname,#(lf)    property_tenancy_tenancy_start_date AS zav_tenancystartdate,#(lf)    property_tenancy_vacated_date AS zav_vacateddate,#(lf)    property_tenancy_leaving_reason AS zav_leavingreason#(lf)FROM [edw].[dim_property_tenancy]#(lf)WHERE DWHIsCurrent = 1#(lf)    AND DWHDMLOperation <> 'D'#(lf)    AND property_tenancy_id IS NOT NULL#(lf)    AND property_tenant_opportunity_status <> 'Cancelled'"]),
				    #"Changed Type" = Table.TransformColumnTypes(EDW,{{"zav_tenancystartdate", type date}, {"zav_vacateddate", type date}}),
				    #"Uppercased Keys" = Table.TransformColumns(#"Changed Type", {{"opportunityid", Text.Upper}, {"zav_property", Text.Upper}}),
				    ODS = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="WITH RecentOpportunities AS (#(lf)    SELECT#(lf)        opportunityid,#(lf)        parentcontactid,#(lf)        zav_subprogram,#(lf)        SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (PARTITION BY opportunityid ORDER BY SinkModifiedOn DESC) AS rn#(lf)    FROM#(lf)        [Zavanti].[vw_opportunity]#(lf))#(lf)SELECT#(lf)    opportunityid,#(lf)    parentcontactid,#(lf)    zav_subprogram#(lf)FROM#(lf)    RecentOpportunities#(lf)WHERE#(lf)    rn = 1"]),
				    #"ODS Upper" = Table.TransformColumns(ODS, {{"opportunityid", Text.Upper}}),
				    #"Merged Opportunity" = Table.NestedJoin(#"Uppercased Keys", {"opportunityid"}, #"ODS Upper", {"opportunityid"}, "ods_opp", JoinKind.LeftOuter),
				    #"Expanded ods_opp" = Table.ExpandTableColumn(#"Merged Opportunity", "ods_opp", {"parentcontactid", "zav_subprogram"}, {"parentcontactid", "zav_subprogram"}),
				    #"Merged Queries" = Table.NestedJoin(#"Expanded ods_opp", {"zav_property"}, Table.TransformColumns(dim_property, {{"zav_propertyid", Text.Upper}}), {"zav_propertyid"}, "dim_property", JoinKind.LeftOuter),
				    #"Expanded dim_property" = Table.ExpandTableColumn(#"Merged Queries", "dim_property", {"new_postalregionname"}, {"dim_property.new_postalregionname"}),
				    #"Renamed Columns1" = Table.RenameColumns(#"Expanded dim_property",{{"dim_property.new_postalregionname", "region_name"}}),
				    #"Merged Queries1" = Table.NestedJoin(#"Renamed Columns1", {"parentcontactid"}, merged_primary_contact, {"contactid"}, "merged_primary_contact", JoinKind.LeftOuter),
				    #"Expanded merged_primary_contact" = Table.ExpandTableColumn(#"Merged Queries1", "merged_primary_contact", {"fullname", "new_dateofbirth", "zav_ethnicity", "zav_gender"}, {"fullname", "new_dateofbirth", "zav_ethnicity", "zav_gender"}),
				    #"Replaced Value" = Table.ReplaceValue(#"Expanded merged_primary_contact",null,"0",Replacer.ReplaceValue,{"zav_ethnicity"}),
				    #"Replaced Value1" = Table.ReplaceValue(#"Replaced Value",null,100000001,Replacer.ReplaceValue,{"zav_gender"})
				in
				    #"Replaced Value1"

