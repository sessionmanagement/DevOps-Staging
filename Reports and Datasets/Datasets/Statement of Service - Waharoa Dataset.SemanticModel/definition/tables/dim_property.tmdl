	partition dim_property-af9faf11-52bd-4eaf-a854-6da79d37abe4 = m
		mode: import
		queryGroup: dimensions
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="SELECT dp.property_id AS zav_propertyid, CASE dp.property_statuscode WHEN 'Active' THEN 1 WHEN 'Inactive' THEN 2 WHEN 'Disposed' THEN 100000000 END AS statuscode, dp.property_name AS zav_name, dp.property_status AS new_propertystatusname, TRY_CONVERT(int, dp.property_year_built) AS new_yearbuilt, CONVERT(date, dp.property_acquired_date) AS zav_acquireddate, dp.property_property_ownership AS zav_propertyownership, dp.property_property_type AS property_type, CASE WHEN dp.property_property_type IN ('Multi Unit Complex','Apartment Complex','Office/Commercial','Boarding House','Block','Motel Complex','Accommodation Complex') THEN 'No' WHEN dp.property_property_type IS NULL THEN NULL ELSE 'Yes' END AS tenantable_dwelling, dp.property_sub_program AS zav_subprogram, dp.property_program AS property_program, dp.property_postal_region AS new_postalregionname, dp.property_full_address AS zav_fulladdress, dp.property_suburb AS zav_suburb, dp.property_legal_owner AS zav_legalowneridname, dp.property_gifted_name AS zav_giftedname, CAST(dp.property_confirmed_disposal_date AT TIME ZONE 'New Zealand Standard Time' AT TIME ZONE 'UTC' AS date) AS zav_confirmeddisposaldate, CAST(NULL AS nvarchar(50)) AS zav_propertytypeid FROM [edw].[dim_property] dp WHERE dp.[DWHIsCurrent] = 1 AND dp.[DWHDMLOperation] <> 'D' AND dp.[property_id] IS NOT NULL"]),
				    #"Sorted Rows1" = Table.Sort(Source,{{"zav_name", Order.Ascending}}),
