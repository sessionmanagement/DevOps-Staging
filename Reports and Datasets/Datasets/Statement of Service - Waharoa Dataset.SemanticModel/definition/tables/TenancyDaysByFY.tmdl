	column opportunityid
		isHidden
		lineageTag: 7bc54a0e-6e37-4d6d-aee7-be627e7e4298
		summarizeBy: none
		isNameInferred
		sourceColumn: work_tenancy_dates[opportunityid]

		annotation SummarizationSetBy = Automatic

	column tenancy_active_at_fyend =
			
			VAR _FYEnd = RELATED(dim_date[financial_last_day_of_year_date])
			RETURN
			IF(
			    TenancyDaysByFY[zav_vacateddate] >= _FYEnd || ISBLANK(TenancyDaysByFY[zav_vacateddate]), 1, 0
			)
		formatString: 0
		lineageTag: 0fa7a9ef-d0ee-4815-aec8-68b794e9d194
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column tenancy_active_at_fystart =
			
			VAR _FYStart = RELATED(dim_date[financial_first_day_of_year_date])
			RETURN
			IF(
			    TenancyDaysByFY[zav_tenancystartdate] <= _FYStart, 1, 0
			)
		formatString: 0
		lineageTag: 09b322f4-ba93-44e1-96e8-bacabb4cc6bf
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column FullAddress = RELATED(dim_property[zav_fulladdress])
		lineageTag: 46063dd4-6fee-42da-bb8f-f54fc2635557
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition TenancyDaysByFY-2afc06b5-29e9-4fbc-a56b-9deecccdf0d3 = calculated
		mode: import
		source =
				
				SUMMARIZECOLUMNS(
				    //work_tenancy_dates[opportunityid],
				    work_tenancy_dates[opportunityid],
				    work_tenancy_dates[zav_property],
				    work_tenancy_dates[zav_tenancystartdate],
				    work_tenancy_dates[zav_vacateddate],
				    work_tenancy_dates[tenancy_end_date_or_today],
				    work_tenancy_dates[FinancialYear],
				    work_tenancy_dates[zav_ethnicity],
				    work_tenancy_dates[zav_gender],
				    work_tenancy_dates[new_dateofbirth],
				    "TenancyBeginDateForFY", MIN(work_tenancy_dates[date_explosion])
				)

	annotation PBI_Id = c53472ae85e94864923224a754cd7039

