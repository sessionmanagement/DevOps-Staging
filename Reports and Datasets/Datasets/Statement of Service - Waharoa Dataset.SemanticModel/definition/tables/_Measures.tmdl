	measure 'Average Tenancy Length for Tenancies Ended in Selected Month (Days)' =
			
			VAR SelectedMonthStart = CALCULATE(MIN('dim_date'[calendar_date]), ALLSELECTED('dim_date'),SELECTEDVALUE(dim_date[calendar_last_day_of_month_date]) = dim_date[calendar_last_day_of_month_date])
			VAR SelectedMonthEnd = CALCULATE(MAX('dim_date'[calendar_date]), ALLSELECTED('dim_date'),SELECTEDVALUE(dim_date[calendar_last_day_of_month_date]) = dim_date[calendar_last_day_of_month_date])
			
			RETURN
			CALCULATE (
			    AVERAGE (fact_tenancy[Tenancy Length (Days)]),
			    USERELATIONSHIP(dim_date[calendar_date],fact_tenancy[zav_vacateddate]),
			    ALL(dim_date),
			    fact_tenancy[zav_vacateddate] >= SelectedMonthStart,
			    fact_tenancy[zav_vacateddate] <= SelectedMonthEnd
			)
		displayFolder: 2. Measures
		lineageTag: aa650264-f76f-4334-a394-fce943508a77

		annotation PBI_FormatHint = {"isGeneralNumber":true}

