	measure 'NEW FOR HISTORY (Discharged Tenancies page) Number of Tenancies Ended in FY' =
			
			VAR SelectedFY = MAX('dim_date'[financial_year_num])  -- Get selected FY from slicer
			VAR StartFY = SelectedFY - 6  -- Define the earliest FY to include
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(fact_tenancy[opportunityid]),
			    ALL('dim_date'),  -- Remove slicer restrictions
			    'dim_date'[financial_year_num] >= StartFY && 'dim_date'[financial_year_num] <= SelectedFY,
			    USERELATIONSHIP(dim_date[calendar_date], fact_tenancy[zav_vacateddate])
			)
		formatString: 0
