	measure 'Active tenancies at start of Period' =
			
			VAR _PeriodStartDate = MIN(dim_date[calendar_date])
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(TenancyDaysByFY[opportunityid]),
			    TenancyDaysByFY[zav_tenancystartdate] <= _PeriodStartDate,
			    TenancyDaysByFY[zav_vacateddate] >= _PeriodStartDate || ISBLANK(TenancyDaysByFY[zav_vacateddate])
			)
		formatString: #,0
		displayFolder: 4. Rental/Transactions
		lineageTag: 65da5ec0-0faf-47e4-8f10-4315253ccf07

	measure 'Active tenancies at end of Period' =
			
			VAR _PeriodEndDate = MAX(dim_date[calendar_date])
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(TenancyDaysByFY[opportunityid]),
			    TenancyDaysByFY[zav_tenancystartdate] <= _PeriodEndDate,
			    TenancyDaysByFY[zav_vacateddate] >= _PeriodEndDate || ISBLANK(TenancyDaysByFY[zav_vacateddate])
			)
		formatString: #,0
