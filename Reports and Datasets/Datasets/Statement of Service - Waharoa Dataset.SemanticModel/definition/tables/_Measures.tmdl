	measure 'MULTI YEAR Tenancy turnover rate (FY)' = ```
			
			
			VAR SelectedFY =
			    CALCULATE(
			        MAX(dim_date[financial_year_num]),
			        ALLSELECTED(dim_date)
			    )
			
			VAR StartFY = SelectedFY - 6
			
			VAR CurrentFYinVisual = MAX(fy_display_for_history[financial_year_num])
			
