	/// Returns max household members for the selected FY; returns 0 for properties with no tenancy/household-member fact rows.
	measure 'Max Tenants During FY (0 if none)' =
			COALESCE(
			    CALCULATE(
			        MAX(FactHouseholdMembersByFY[MaxHouseholdMembersForTenancyInFY])
			    ),
