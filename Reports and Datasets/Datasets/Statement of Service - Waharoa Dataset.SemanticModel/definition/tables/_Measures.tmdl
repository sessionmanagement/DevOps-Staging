	measure 'MULTI YEAR Average Tenancy Length for Tenancies Ended in FY (Days)' =
			
			VAR SelectedFY =
			    CALCULATE(
			        MAX(dim_date[financial_year_num]),
			        ALLSELECTED(dim_date)
			    )
			
			VAR StartFY = SelectedFY - 6
			
			VAR CurrentFYinVisual = MAX(fy_display_for_history[financial_year_num])
			
			VAR CurrentFYStart =
			    CALCULATE(
			        MIN(fy_display_for_history[calendar_date]),
			        ALL(fy_display_for_history),
			        fy_display_for_history[financial_year_num] = CurrentFYinVisual
			    )
			
			VAR CurrentFYEnd =
			    CALCULATE(
			        MAX(fy_display_for_history[calendar_date]),
			        ALL(fy_display_for_history),
			        fy_display_for_history[financial_year_num] = CurrentFYinVisual
			    )
			
			RETURN
			IF(
			    CurrentFYinVisual >= StartFY && CurrentFYinVisual <= SelectedFY,
			    CALCULATE(
			        AVERAGE(fact_tenancy[Tenancy Length (Days)]),
			        ALL(dim_date),
			        USERELATIONSHIP(fy_display_for_history[calendar_date], fact_tenancy[zav_vacateddate]),  -- explicitly matches original measure relationship
			        fy_display_for_history[calendar_date] >= CurrentFYStart,
			        fy_display_for_history[calendar_date] <= CurrentFYEnd
			    ),
			    BLANK()
			)
		displayFolder: 7. Multi Year Compatible
		lineageTag: 9f5c75e0-08c3-4168-b752-b218e2da5dcd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MULTI YEAR Housing Portfolio Count (by Year)' = ```
			
			
			VAR SelectedFY =
