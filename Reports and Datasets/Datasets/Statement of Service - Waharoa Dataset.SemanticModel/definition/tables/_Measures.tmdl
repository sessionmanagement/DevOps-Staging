	measure 'YoY Growth in Housing Portfolio %' = ```
			
			
			  VAR SelectedFY = MAX('dim_date'[financial_year_num])
			
			  -- Count at END of current FY
			  VAR CurrentFYCount =
			      CALCULATE(
			          [Housing Portfolio Count (by Year)],
			          ALL(dim_date),
			          dim_date[financial_year_num] = SelectedFY
			      )
			
			  -- Count at END of previous FY
			  VAR PrevFYCount =
			      CALCULATE(
			          [Housing Portfolio Count (by Year)],
			          ALL(dim_date),
			          dim_date[financial_year_num] = SelectedFY - 1
			      )
			
			  RETURN
			  DIVIDE(
			      CurrentFYCount - PrevFYCount,
			      PrevFYCount,  -- ← CHANGED: denominator is now PrevFYCount
			      BLANK()
			  )
			```
		formatString: 0%;-0%;0%
		displayFolder: 2. Measures
		lineageTag: 990643cd-409c-454c-bec2-b2381ea90294

	measure 'YoY Growth in Housing Portfolio #' =
			
			
			VAR SelectedFY = MAX('dim_date'[financial_year_num])
			VAR CurrentFYCount =
			    CALCULATE(
			        [Housing Portfolio Count (by Year)],
			        ALL(dim_date),
			        dim_date[financial_year_num] = SelectedFY
			    )
			VAR PrevFYCount =
			    CALCULATE(
			        [Housing Portfolio Count (by Year)],
			        ALL(dim_date),
			        dim_date[financial_year_num] = SelectedFY - 1
			    )
			
			RETURN
			CurrentFYCount - PrevFYCount
		formatString: #,0
		displayFolder: 2. Measures
		lineageTag: 85674381-7c5e-485f-8d34-6da328c470d3

	measure 'Housing Portfolio Count (by Year) 2' =
			
			VAR _FYStart = SELECTEDVALUE(dim_date[financial_first_day_of_year_date])
			VAR _FYEnd = SELECTEDVALUE(dim_date[financial_last_day_of_year_date])
			RETURN
			CALCULATE(
			    COUNTROWS(dim_property),
			    ALL(dim_date),
			    PropertyOwnershipDaysByFY[BeginPropertyOwnershipDateForFY] >= _FYStart,
			    PropertyOwnershipDaysByFY[BeginPropertyOwnershipDateForFY] <= _FYEnd
			)
		formatString: #,0
		displayFolder: 2. Measures
		lineageTag: 16e2b431-16c5-4d01-a7bf-d55560396eca

	measure 'YoY Growth in Housing Portfolio % (limited to before today)' =
			
			IF(
			    MAX(dim_date[financial_year_num]) > YEAR(TODAY()),
			        BLANK(),
			        CALCULATE([YoY Growth in Housing Portfolio %])
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 2. Measures
