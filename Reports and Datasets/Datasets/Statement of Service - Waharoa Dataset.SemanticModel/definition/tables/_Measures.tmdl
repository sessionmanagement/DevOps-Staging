	measure 'Net Acquisitions in FY' = ```
			
			
			VAR SelectedFY = MAX('dim_date'[financial_year_num])
			
			// Count properties acquired during the selected FY
			VAR AcquiredCount =
			    CALCULATE(
			        COUNTROWS(fact_property),
			        ALL(dim_date),
			        dim_date[financial_year_num] = SelectedFY,
			        NOT(ISBLANK(fact_property[zav_acquireddate]))
			    )
			
			// Count properties disposed during the selected FY
			VAR DisposedCount =
			    CALCULATE(
			        COUNTROWS(fact_property_for_disposed),
			        ALL(dim_date),
			        dim_date[financial_year_num] = SelectedFY,
			        NOT(ISBLANK(fact_property_for_disposed[zav_confirmeddisposaldate]))
			    )
			
			RETURN
			AcquiredCount - DisposedCount
			
			```
		formatString: #,0
		displayFolder: 2. Measures
		lineageTag: a1b2c3d4-e5f6-7890-abcd-ef1234567890

