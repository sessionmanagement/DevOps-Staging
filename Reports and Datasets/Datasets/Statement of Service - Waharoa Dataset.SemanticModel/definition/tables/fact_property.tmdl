table fact_property
	lineageTag: d4d29a22-ac0b-44f6-b28f-408a41ad745f

	column zav_propertyid
		dataType: string
		isHidden
		lineageTag: 2b426d8b-a496-4243-adc1-0d6233cce003
		summarizeBy: none
		sourceColumn: zav_propertyid

		annotation SummarizationSetBy = Automatic

	column length_of_ownership_days =
			
			IF(
			    ISBLANK(RELATED(dim_property[zav_confirmeddisposaldate])),
			        DATEDIFF(RELATED(dim_property[zav_acquireddate]),TODAY(),DAY),
			        DATEDIFF(RELATED(dim_property[zav_acquireddate]),RELATED(dim_property[zav_confirmeddisposaldate]),DAY)
			)
		isHidden
		formatString: 0
		lineageTag: 7ad5ec9c-4f0c-4eb6-9351-bf1e01e7b911
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column approx_build_date =
			
			IF(
			    ISBLANK(RELATED(dim_property[new_yearbuilt])),
			    BLANK(),
			    DATE(RELATED(dim_property[new_yearbuilt]),06,01)
			)
		isHidden
		formatString: Short Date
		lineageTag: 4bda149d-b10f-48d4-8be0-a558df4a9e7e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column house_age_days =
			
			IF(
			    ISBLANK(fact_property[approx_build_date]),
			        BLANK(),
			        DATEDIFF(fact_property[approx_build_date],TODAY(),DAY)
			)
		isHidden
		formatString: 0
		lineageTag: 20dbab1f-5839-4f73-8ece-7350016d18ea
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column statuscode
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 119a09eb-019b-4300-b565-26f78a108e5c
		summarizeBy: sum
		sourceColumn: statuscode

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column zav_acquireddate
		dataType: dateTime
		formatString: Short Date
		lineageTag: 91efcec0-d5c5-47c7-a982-8d93e0b519e3
		summarizeBy: none
		sourceColumn: zav_acquireddate

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column zav_confirmeddisposaldate
		dataType: dateTime
		isHidden
		formatString: Long Date
		lineageTag: 8a1a1cc5-84cd-436f-ae8b-52ae140928d1
		summarizeBy: none
		sourceColumn: zav_confirmeddisposaldate

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition fact_property-9a8d6aeb-2156-48d0-8f14-c4b5e27e168a = m
		mode: import
		queryGroup: facts
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="SELECT dp.property_id AS zav_propertyid, CASE dp.property_statuscode WHEN 'Active' THEN 1 WHEN 'Inactive' THEN 2 WHEN 'Disposed' THEN 100000000 END AS statuscode, CONVERT(date, dp.property_acquired_date) AS zav_acquireddate, CAST(dp.property_confirmed_disposal_date AT TIME ZONE 'New Zealand Standard Time' AT TIME ZONE 'UTC' AS date) AS zav_confirmeddisposaldate FROM [edw].[dim_property] dp WHERE dp.[DWHIsCurrent] = 1 AND dp.[DWHDMLOperation] <> 'D' AND dp.[property_id] IS NOT NULL"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"zav_acquireddate", type date}, {"zav_confirmeddisposaldate", type date}}),
				    #"Filtered Rows" = Table.SelectRows(#"Changed Type", each ([zav_propertyid] <> null))
				in
				    #"Filtered Rows"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

