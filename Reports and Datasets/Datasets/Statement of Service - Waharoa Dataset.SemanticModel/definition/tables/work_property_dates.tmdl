	partition work_property_dates-ae503dc0-d590-4345-b5ee-a694cb3839cf = m
		mode: import
		queryGroup: work
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="SELECT dp.property_id AS zav_propertyid, CASE dp.property_statuscode WHEN 'Active' THEN 1 WHEN 'Inactive' THEN 2 WHEN 'Disposed' THEN 100000000 END AS statuscode, TRY_CONVERT(int, dp.property_year_built) AS new_yearbuilt, CONVERT(date, dp.property_acquired_date) AS zav_acquireddate, CONVERT(date, dp.property_disposal_date) AS zav_disposaldate, CAST(dp.property_confirmed_disposal_date AT TIME ZONE 'New Zealand Standard Time' AT TIME ZONE 'UTC' AS date) AS zav_confirmeddisposaldate FROM [edw].[dim_property] dp WHERE dp.[DWHIsCurrent] = 1 AND dp.[DWHDMLOperation] <> 'D' AND dp.[property_id] IS NOT NULL"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"zav_confirmeddisposaldate", type date}, {"zav_acquireddate", type date}}),
				    #"Added Custom" = Table.AddColumn(#"Changed Type", "disposaldateortoday", each if [zav_disposaldate] <> null then [zav_disposaldate] else if [zav_confirmeddisposaldate] <> null then [zav_confirmeddisposaldate] else DateTime.LocalNow()),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Added Custom",{{"disposaldateortoday", type date}}),
				    #"Changed Type2" = Table.TransformColumnTypes(#"Changed Type1",{{"zav_acquireddate", Int64.Type}, {"disposaldateortoday", Int64.Type}}),
				    #"Filtered Rows" = Table.SelectRows(#"Changed Type2", each ([zav_acquireddate] <> null)),
				    #"Added Custom1" = Table.AddColumn(#"Filtered Rows", "explosion", each {[zav_acquireddate]..[disposaldateortoday]}),
				    #"Expanded explosion" = Table.ExpandListColumn(#"Added Custom1", "explosion"),
				    #"Changed Type3" = Table.TransformColumnTypes(#"Expanded explosion",{{"explosion", type date}, {"disposaldateortoday", type date}, {"zav_acquireddate", type date}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type3",{"new_yearbuilt"})
				in
				    #"Removed Columns"

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

