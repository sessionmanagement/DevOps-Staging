	partition work_tenancy_dates-a895aa24-1503-4295-b7fb-41243209478f = m
		mode: import
		queryGroup: work
		source =
				let
				    NormGuid = (g) => if g = null then null else Text.Upper(Text.Replace(Text.Replace(Text.From(g), "{", ""), "}", "")),
				    EDWSource = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="SELECT pt.property_tenancy_id AS opportunityid, pt.property_id AS zav_property, pt.property_tenancy_tenancy_start_date AS zav_tenancystartdate, pt.property_tenancy_vacated_date AS zav_vacateddate, pt.property_tenancy_property_name AS zav_propertyname FROM [edw].[dim_property_tenancy] pt WHERE pt.[DWHIsCurrent] = 1 AND pt.[DWHDMLOperation] <> 'D' AND pt.[property_tenant_opportunity_status] <> 'Cancelled' AND pt.[property_tenancy_id] IS NOT NULL"]),
				    ODSContact = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="WITH RecentOpportunities AS ( SELECT opportunityid, parentcontactid, ROW_NUMBER() OVER (PARTITION BY opportunityid ORDER BY SinkModifiedOn DESC) AS rn FROM [Zavanti].[vw_opportunity] WHERE statuscode <> 4 ) SELECT opportunityid AS ods_opportunityid, parentcontactid FROM RecentOpportunities WHERE rn = 1"]),
				    EDWKeyed = Table.AddColumn(EDWSource, "join_key", each NormGuid([opportunityid]), type text),
				    ODSKeyed = Table.AddColumn(ODSContact, "join_key", each NormGuid([ods_opportunityid]), type text),
				    MergedContact = Table.NestedJoin(EDWKeyed, {"join_key"}, ODSKeyed, {"join_key"}, "ods_contact", JoinKind.LeftOuter),
				    ExpandedContact = Table.ExpandTableColumn(MergedContact, "ods_contact", {"parentcontactid"}, {"parentcontactid"}),
				    Source = Table.RemoveColumns(ExpandedContact, {"join_key"}),
				    #"Merged Queries" = Table.NestedJoin(Source, {"parentcontactid"}, merged_primary_contact, {"contactid"}, "merged_primary_contact", JoinKind.LeftOuter),
				    #"Expanded merged_primary_contact" = Table.ExpandTableColumn(#"Merged Queries", "merged_primary_contact", {"new_dateofbirth", "zav_ethnicity", "zav_gender"}, {"new_dateofbirth", "zav_ethnicity", "zav_gender"}),
				    #"Replaced Value" = Table.ReplaceValue(#"Expanded merged_primary_contact",null,"0",Replacer.ReplaceValue,{"zav_ethnicity"}),
				    #"Replaced Value1" = Table.ReplaceValue(#"Replaced Value",null,100000001,Replacer.ReplaceValue,{"zav_gender"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Replaced Value1",{{"zav_tenancystartdate", type date}, {"zav_vacateddate", type date}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"zav_propertyname"}),
				    #"Filtered Rows" = Table.SelectRows(#"Removed Columns", each [zav_tenancystartdate] <> null and [zav_tenancystartdate] <> ""),
				    #"Added Custom" = Table.AddColumn(#"Filtered Rows", "tenancy_end_date_or_today", each if [zav_vacateddate] <> null then ([zav_vacateddate]) else (DateTime.LocalNow())),
				    #"Changed Type2" = Table.TransformColumnTypes(#"Added Custom",{{"tenancy_end_date_or_today", type date}}),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Changed Type2",{{"tenancy_end_date_or_today", type number}, {"zav_tenancystartdate", Int64.Type}}),
				    #"Added Custom1" = Table.AddColumn(#"Changed Type1", "date_explosion", each {[zav_tenancystartdate]..List.Max({[zav_tenancystartdate], [tenancy_end_date_or_today]})}),
				    #"Expanded date_explosion" = Table.ExpandListColumn(#"Added Custom1", "date_explosion"),
				    #"Changed Type3" = Table.TransformColumnTypes(#"Expanded date_explosion",{{"zav_tenancystartdate", type date}, {"tenancy_end_date_or_today", type date}, {"date_explosion", type date}})
				in
				    #"Changed Type3"

	changedProperty = IsHidden

