			        DATEDIFF(fact_tenancy_for_data_page[zav_tenancystartdate], TODAY(), DAY),
			        DATEDIFF(fact_tenancy_for_data_page[zav_tenancystartdate], fact_tenancy_for_data_page[zav_vacateddate], DAY)
