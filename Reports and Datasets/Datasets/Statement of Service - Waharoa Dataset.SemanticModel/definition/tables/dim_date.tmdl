				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="SELECT [dim_date_key]#(lf)      ,[calendar_date]#(lf)      ,[calendar_day_num]#(lf)      ,[calendar_day_name_full]#(lf)      ,[calendar_day_name_short]#(lf)      ,[calendar_day_name_TeReo]#(lf)      ,[calendar_day_number_in_year]#(lf)      ,[calendar_day_in_week_num]#(lf)      ,[calendar_days_in_month_num]#(lf)      ,[calendar_first_day_of_week_date]#(lf)      ,[calendar_last_day_of_week_date]#(lf)      ,[calendar_week_num]#(lf)      ,[calendar_month_num]#(lf)      ,[calendar_month_name_long]#(lf)      ,[calendar_month_name_short]#(lf)      ,[calendar_month_name_TeReo]#(lf)      ,[calendar_year_month]#(lf)      ,[calendar_first_day_of_month_date]#(lf)      ,[calendar_last_day_of_month_date]#(lf)      ,[calendar_quarter_num]#(lf)      ,[calendar_quarter_full]#(lf)      ,[calendar_first_day_of_quarter_date]#(lf)      ,[calendar_last_day_of_quarter_date]#(lf)      ,[calendar_year]#(lf)      ,[calendar_first_day_of_year_date]#(lf)      ,[calendar_last_day_of_year_date]#(lf)      ,[financial_first_day_of_year_date]#(lf)      ,[financial_last_day_of_year_date]#(lf)      ,[financial_week_num]#(lf)      ,[financial_first_day_of_week_date]#(lf)      ,[financial_last_day_of_week_date]#(lf)      ,[financial_day_of_week_num]#(lf)      ,[financial_month_num]#(lf)      ,[financial_first_Day_of_month_date]#(lf)      ,[financial_last_day_of_month_date]#(lf)      ,[financial_quarter_num]#(lf)      ,[financial_quarter_full]#(lf)      ,[financial_first_day_of_quarter_date]#(lf)      ,[financial_last_day_of_quarter_date]#(lf)      ,[financial_year_num]#(lf)      ,[financial_year_desc]#(lf)      ,[financial_year_month]#(lf)      ,[national_holiday_description]#(lf)      ,[national_holiday_flag]#(lf)      ,[regional_holiday_description]#(lf)      ,[regional_holiday_flag]#(lf)      ,[is_holiday_flag]#(lf)      ,[calendar_first_day_of_month_flag]#(lf)      ,[calendar_last_day_of_month_flag]#(lf)      ,[weekend_flag]#(lf)      ,[weekday_flag]#(lf)      ,[calendar_trading_day_flag]#(lf)      ,[current_date_flag]#(lf)      ,[current_month_flag]#(lf)      ,[current_calendar_year_flag]#(lf)      ,[current_month_to_date_flag]#(lf)      ,[current_calendar_year_to_date_flag]#(lf)      ,[current_financial_year_flag]#(lf)      ,[current_financial_year_to_date_flag]#(lf)      ,[previous_year_date_flag]#(lf)      ,[previous_year_month_flag]#(lf)      ,[previous_calendar_year_flag]#(lf)      ,[previous_year_month_to_date_flag]#(lf)      ,[previous_calendar_year_to_date_flag]#(lf)      ,[previous_financial_year_flag]#(lf)      ,[previous_financial_year_to_date_flag]#(lf)      ,[current_calendar_trading_days_in_month]#(lf)      ,[current_calendar_trading_days_in_month_ytd]#(lf)      ,[current_calendar_trading_days_left_in_month]#(lf)      --,[is_current_date]#(lf)      ,[DWHSourceSystem]#(lf)      ,[DWHCreatedAt]#(lf)      ,[DWHBatchId]#(lf)  FROM [edw].[dim_date]#(lf)WHERE dim_date_key <> 0#(lf)AND calendar_date > DATEADD(year, -90, GETDATE()) AND calendar_date < DATEADD(year, 9, GETDATE())"]),
				    #"Changed Type" = Table.TransformColumnTypes(
				    Source,
				        {
				            {"financial_year_num", Int64.Type},
				            {"calendar_date", type date}
				        }
				    ),
				
				    // Reference the parameter "Reporting Months Ago"
				    ReportingPeriod = #"Reporting Months Ago",
				
				    // Get the current date and time, and then extract just the date
				    // DateTime.LocalNow() returns the current date and time, DateTime.Date() extracts just the date part
				    Today = DateTime.LocalNow(),
				    TodayDate = DateTime.Date(Today),
				    
				    // Calculate the target month and year based on the current date and the ReportingPeriod parameter
				    TargetDate = Date.AddMonths(TodayDate, -ReportingPeriod),
				    
				    // Create a list of 12 months starting from TargetDate and going 12 months back
				    // List.Transform() applies a function to each item in the original list ({0..12} in this case)
				    TwelveMonthsList = List.Transform({0..12}, each Date.ToText(Date.AddMonths(TargetDate, -_), "yyyy-MM")),
				    
				    // Add a new dynamic calculated column for Reporting Month
				    // This column will label each month relative to the Reporting Month
				    #"Added Reporting Month" = Table.AddColumn(#"Changed Type", "Reporting Month", each 
				        let
				            // Extract the calendar_date from the current row
				            CurrentDate = [calendar_date],
				            
				            // Convert the calendar_date to a string in "yyyy-MM" format for easier comparison
				            CurrentDateStr = Date.ToText(CurrentDate, "yyyy-MM"),
				            
				            // Find the position of the current month in the TwelveMonthsList
				            // If the month is not found, List.PositionOf() returns -1
				            MonthOffset = List.PositionOf(TwelveMonthsList, CurrentDateStr)
				        in
				            // Label the month based on its position in the TwelveMonthsList
				            if MonthOffset = 0 then "Reporting Month"
				            else if MonthOffset = 1 then "1 Month Prior to Reporting Month"
				            else if MonthOffset > 1 then Text.From(MonthOffset) & " Months Prior to Reporting Month"
				            else ""
				    )
				in
				    #"Added Reporting Month"
				```

