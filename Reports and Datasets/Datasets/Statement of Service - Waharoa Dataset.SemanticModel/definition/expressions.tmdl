		// return records that have a date for keys returned (zav_datekeyreceivedfromtenant) AND date property was ready for a new tenant (zav_datekeystotenancytimetoallocate) AND status (statecodename) is Inactive.
		// Records are marked inactive when the void is complete.
		
		let
		    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="WITH hashOptionTable AS #(lf)(#(lf)    SELECT#(lf)        [OptionSetName],#(lf)        [Option],#(lf)        [EntityName],#(lf)        HASHBYTES('MD5', [OptionSetName] + CAST([Option] AS nvarchar(100)) + [EntityName]) AS optionHash,#(lf)        [LocalizedLabel]#(lf)    FROM #(lf)        [Zavanti].[vw_GlobalOptionsetMetadata]#(lf)#(lf)    UNION#(lf)#(lf)    SELECT#(lf)        [OptionSetName],#(lf)        [Option],#(lf)        [EntityName],#(lf)        HASHBYTES('MD5', [OptionSetName] + CAST([Option] AS nvarchar(100)) + [EntityName]) AS optionHash,#(lf)        [LocalizedLabel]#(lf)    FROM #(lf)        [Zavanti].[vw_OptionsetMetadata]#(lf)#(lf)    UNION#(lf)#(lf)    SELECT#(lf)        'statuscodename' AS [OptionSetName],#(lf)        [status] AS [Option],#(lf)        [EntityName],#(lf)        HASHBYTES('MD5', 'statuscodename' + CAST([status] AS nvarchar(100)) + [EntityName]) AS optionHash,#(lf)        [LocalizedLabel]#(lf)    FROM #(lf)        [Zavanti].[vw_StatusMetadata]#(lf)#(lf)    UNION#(lf)#(lf)    SELECT#(lf)        'statecodename' AS [OptionSetName],#(lf)        [state] AS [Option],#(lf)        [EntityName],#(lf)        HASHBYTES('MD5', 'statecodename' + CAST([state] AS nvarchar(100)) + [EntityName]) AS optionHash,#(lf)        [LocalizedLabel]#(lf)    FROM #(lf)        [Zavanti].[vw_StateMetadata]#(lf)),#(lf)RecentVoidChecklist AS (#(lf)    SELECT#(lf)        createdon,#(lf)        zav_datekeyreceivedfromtenant,#(lf)        zav_datekeystotenancyteamtoallocate,#(lf)        zav_property,#(lf)        zav_voidcheckliststatus,#(lf)        zav_voidchecklistid,#(lf)        statecode,#(lf)        SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (PARTITION BY zav_voidchecklistid ORDER BY SinkModifiedOn DESC) AS rn#(lf)    FROM #(lf)        [Zavanti].[vw_zav_voidchecklist]#(lf)    WHERE #(lf)        zav_voidchecklistid IS NOT NULL#(lf))#(lf)SELECT#(lf)    rvc.createdon,#(lf)    t1.LocalizedLabel AS statecodename,#(lf)    rvc.zav_datekeyreceivedfromtenant,#(lf)    rvc.zav_datekeystotenancyteamtoallocate,#(lf)    rvc.zav_property,#(lf)    t2.LocalizedLabel AS zav_voidcheckliststatusname,#(lf)    rvc.zav_voidchecklistid#(lf)FROM #(lf)    RecentVoidChecklist rvc#(lf)LEFT OUTER JOIN #(lf)    hashOptionTable t1 ON t1.optionHash = HASHBYTES('MD5', 'statecodename' + CAST(rvc.statecode AS nvarchar(100)) + 'zav_voidchecklist')#(lf)LEFT OUTER JOIN #(lf)    hashOptionTable t2 ON t2.optionHash = HASHBYTES('MD5', 'zav_voidcheckliststatus' + CAST(rvc.zav_voidcheckliststatus AS nvarchar(100)) + 'zav_voidchecklist')#(lf)WHERE#(lf)    rvc.rn = 1"]),
		    #"Filtered Rows" = Table.SelectRows(Source, each ([zav_datekeyreceivedfromtenant] <> null)),
		    #"Changed Type" = Table.TransformColumnTypes(#"Filtered Rows",{{"zav_datekeyreceivedfromtenant", type date}, {"zav_datekeystotenancyteamtoallocate", type date}}),
		    #"Filtered Rows1" = Table.SelectRows(#"Changed Type", each ([statecodename] = "Inactive")),
		    #"Added Custom" = Table.AddColumn(#"Filtered Rows1", "today", each DateTime.LocalNow()),
		    #"Changed Type1" = Table.TransformColumnTypes(#"Added Custom",{{"today", type date}}),
		    #"Filtered Rows2" = Table.SelectRows(#"Changed Type1", each ([zav_datekeystotenancyteamtoallocate] <> null)),
		    #"Merged Queries" = Table.NestedJoin(Table.TransformColumns(#"Filtered Rows2", {{"zav_property", Text.Upper}}), {"zav_property"}, Table.TransformColumns(dim_property, {{"zav_propertyid", Text.Upper}}), {"zav_propertyid"}, "dim_property", JoinKind.LeftOuter),
		    #"Expanded dim_property" = Table.ExpandTableColumn(#"Merged Queries", "dim_property", {"zav_fulladdress"}, {"zav_fulladdress"}),
		    #"Added Custom1" = Table.AddColumn(#"Expanded dim_property", "origin", each "voids_vacated_properties_inactive"),
		    #"Renamed Columns" = Table.RenameColumns(#"Added Custom1",{{"zav_datekeyreceivedfromtenant", "void_start_date"}, {"zav_datekeystotenancyteamtoallocate", "void_end_date"}})
		in
