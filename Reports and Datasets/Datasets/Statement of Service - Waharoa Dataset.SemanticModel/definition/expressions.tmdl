usname,#(lf)    rh.zav_numberofhouseholdmembers,#(lf)    rh.zav_revision,#(lf)    rh.zav_tenancy#(lf)FROM #(lf)    RecentHouseholds rh#(lf)LEFT OUTER JOIN #(lf)    optionHashTable t1 ON t1.optionHash = HASHBYTES('MD5', 'statuscodename' + CAST(rh.statuscode AS nvarchar(100)) + 'zav_household')#(lf)LEFT OUTER JOIN #(lf)    optionHashTable t2 ON t2.optionHash = HASHBYTES('MD5', 'zav_householdstatus' + CAST(rh.zav_householdstatus AS nvarchar(100)) + 'zav_household')#(lf)WHERE#(lf)    rh.rn = 1"]),
