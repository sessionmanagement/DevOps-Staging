alizedLabel AS statecodename,#(lf)    rvc.zav_datekeyreceivedfromtenant,#(lf)    rvc.zav_datekeystotenancyteamtoallocate,#(lf)    rvc.zav_property,#(lf)    t2.LocalizedLabel AS zav_voidcheckliststatusname,#(lf)    rvc.zav_voidchecklistid#(lf)FROM #(lf)    RecentVoidChecklist rvc#(lf)LEFT OUTER JOIN #(lf)    hashOptionTable t1 ON t1.optionHash = HASHBYTES('MD5', 'statecodename' + CAST(rvc.statecode AS nvarchar(100)) + 'zav_voidchecklist')#(lf)LEFT OUTER JOIN #(lf)    hashOptionTable t2 ON t2.optionHash = HASHBYTES('MD5', 'zav_voidcheckliststatus' + CAST(rvc.zav_voidcheckliststatus AS nvarchar(100)) + 'zav_voidchecklist')#(lf)WHERE#(lf)    rvc.rn = 1"]),
