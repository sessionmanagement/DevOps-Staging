	annotation PBI_QueryGroupOrder = 6

queryGroup 'Reference Tables'

	annotation PBI_QueryGroupOrder = 1

queryGroup 'Calculation Tables'

	annotation PBI_QueryGroupOrder = 8

queryGroup 'Role Playing Date Tables'

	annotation PBI_QueryGroupOrder = 5

queryGroup Work

	annotation PBI_QueryGroupOrder = 7

queryGroup 'Row Level Security'

	annotation PBI_QueryGroupOrder = 9

queryGroup 'Fact Tables\Unpivoted Fact Tables'

	annotation PBI_QueryGroupOrder = 0

queryGroup Changelog

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Row Level Security\New RLS for RB'

	annotation PBI_QueryGroupOrder = 0

