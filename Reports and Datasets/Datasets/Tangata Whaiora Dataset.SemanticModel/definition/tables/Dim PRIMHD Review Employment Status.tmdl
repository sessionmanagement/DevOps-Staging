	partition 'Dim PRIMHD Review Employment Status' = m
		mode: import
		queryGroup: 'Dim Tables'
		source =
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ods", [Query="SELECT CAST(t1.[PRIMHDReviewEmploymentStatusID] AS nvarchar(20)) + '-1' AS [Dim PRIMHD Review Employment Status Unique KEY] #(lf)      ,t2.[PRIMHDReviewEmploymentStatusText] AS [ParentPRIMHDReviewEmploymentStatusText]#(lf)#(tab)  ,t1.[PRIMHDReviewEmploymentStatusText]#(lf)      ,t1.[PRIMHDReviewEmploymentStatusValue]#(lf)  FROM#(lf)  [RBMNB].[dlDimPRIMHDReviewEmploymentStatus] t1#(lf)  LEFT OUTER JOIN #(lf)  [RBEAL].[dlDimPRIMHDReviewEmploymentStatus] t2 ON t1.PRIMHDReviewEmploymentStatusParentId = t2.PRIMHDReviewEmploymentStatusID#(lf)  WHERE t1.[PRIMHDReviewEmploymentStatusIsActive] = 1#(lf)  #(lf)  UNION ALL#(lf)#(lf)  SELECT CAST(t1.[PRIMHDReviewEmploymentStatusID] AS nvarchar(20)) + '-5' AS [Dim PRIMHD Review Employment Status Unique KEY] #(lf)      ,t2.[PRIMHDReviewEmploymentStatusText] AS [ParentPRIMHDReviewEmploymentStatusText]#(lf)#(tab)  ,t1.[PRIMHDReviewEmploymentStatusText]#(lf)      ,t1.[PRIMHDReviewEmploymentStatusValue]#(lf)  FROM#(lf)  [RBMNB].[dlDimPRIMHDReviewEmploymentStatus] t1#(lf)  LEFT OUTER JOIN #(lf)  [RBMNB].[dlDimPRIMHDReviewEmploymentStatus] t2 ON t1.PRIMHDReviewEmploymentStatusParentId = t2.PRIMHDReviewEmploymentStatusID#(lf)  WHERE t1.[PRIMHDReviewEmploymentStatusIsActive] = 1"])
