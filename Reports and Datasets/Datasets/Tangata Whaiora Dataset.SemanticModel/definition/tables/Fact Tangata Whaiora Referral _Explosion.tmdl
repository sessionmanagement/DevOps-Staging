	partition 'Fact Tangata Whaiora Referral _Explosion' = m
		mode: import
		queryGroup: 'Fact Tables'
		source =
				let
				    Source = Table.Buffer(#"Fact Tangata Whaiora Referral"),
				    #"Filtered Rows" = Table.SelectRows(Source, each [Tangata Whaiora Referral Accepted Date KEY] <> null),
				    #"Added Custom" = Table.AddColumn(
				        #"Filtered Rows", "Today", each DateTime.ToText(DateTime.LocalNow(), "yyyyMMdd")
				    ),
				    #"Changed Type" = Table.TransformColumnTypes(#"Added Custom", {{"Today", Int64.Type}}),
				    #"Added Custom2" = Table.AddColumn(
				        #"Changed Type",
				        "Today As Date",
				        each Date.FromText(Text.From([Today]), [Format = "yyyyMMdd", Culture = "en-NZ"])
				    ),
				    #"Added Custom3" = Table.AddColumn(
				        #"Added Custom2",
				        "Referral Created Date as Date",
				        each
				            Date.FromText(
				                Text.From([Tangata Whaiora Referral Created Date KEY]), [Format = "yyyyMMdd", Culture = "en-NZ"]
				            )
				    ),
				    #"Added Custom4" = Table.AddColumn(
				        #"Added Custom3",
				        "Discharge Date as Date",
				        each
				            Date.FromText(
				                Text.From([Tangata Whaiora Referral Discharge Date KEY]), [Format = "yyyyMMdd", Culture = "en-NZ"]
				            )
				    ),
				    #"Added Conditional Column" = Table.AddColumn(
				        #"Added Custom4",
				        "End Date or Today Date",
				        each if [Tangata Whaiora Referral End Date KEY] = null then [Today As Date] else [Tangata Whaiora Referral End Date]
				    ),
				    #"Changed Type1" = Table.TransformColumnTypes(
				        #"Added Conditional Column",
				        {{"Referral Created Date as Date", type date}, {"End Date or Today Date", type date}}
				    ),
				    #"Changed Type2" = Table.TransformColumnTypes(
				        #"Changed Type1", {{"Referral Created Date as Date", Int64.Type}, {"End Date or Today Date", Int64.Type}}
				    ),
				    //Explosion is based on Tangata Whaiora Referral Accepted Date and Tangata Whaiora Referral Discharge Date
				    #"Added Custom5" = Table.AddColumn(
				        #"Changed Type2", "Explosion", each {[Referral Created Date as Date].. [End Date or Today Date]}
				    ),
				    #"Expanded Explosion" = Table.ExpandListColumn(#"Added Custom5", "Explosion"),
				    #"Removed Columns" = Table.RemoveColumns(
				        #"Expanded Explosion",
				        {
				            "Today",
				            "Today As Date",
				            "Referral Created Date as Date",
				            "Discharge Date as Date",
				            "End Date or Today Date"
				        }
				    ),
				    #"Changed Type3" = Table.TransformColumnTypes(#"Removed Columns", {{"Explosion", type date}})
				in
				    #"Changed Type3"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

