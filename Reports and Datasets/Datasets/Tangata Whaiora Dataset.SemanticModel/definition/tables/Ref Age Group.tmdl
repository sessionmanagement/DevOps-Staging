	partition 'Ref Age Group' = m
		mode: import
		queryGroup: 'Reference Tables'
		source =
				// Initialize the SQL Database source
				let
				    Source = Sql.Database(Server, Database),
				    // Extract data from the "dim_age_group" table in the "edw" schema
				    edw_dim_age_group = Source{[Schema="edw",Item="vw_dim_age_group"]}[Data],
				    // Function to apply naming conventions to column names
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            // Replace 'client_' prefix with 'Tangata_Whaiora_'
				            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
				            // Replace underscores with spaces for readability
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            // Rename 'DWHBatchId' to 'DWH Batch Id'
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            // Rename 'DWHCreatedAt' to 'DWH Created At'
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            // Rename 'DWHDMLOperation' to 'DWH DML Operation'
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            // Rename 'DWHEffectiveFrom' to 'DWH Effective From'
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            // Rename 'DWHEffectiveTo' to 'DWH Effective To'
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            // Rename 'DWHIsCurrent' to 'DWH Is Current'
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            // Rename 'DWHModifiedOn' to 'DWH Modified On'
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            // Rename 'DWHSourceSystem' to 'DWH Source System'
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            // Capitalize the first letter of each word for uniformity
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            // Fully capitalize 'ID'
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            // Fully capitalize 'KEY'
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            // Fully capitalize 'DWH'
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            // Return the transformed column name
				            capitaliseDWH,
				    // Apply the naming conventions to all column names in the table
				    #"Transformed Column Names" = Table.TransformColumnNames(edw_dim_age_group, each ApplyNamingConventions(_)),
				    // Remove the column "DWH Source System" as it is not needed
				    #"Removed Columns" = Table.RemoveColumns(#"Transformed Column Names",{"DWH Source System"})
				in
				    // Output the final table with transformed column names and removed columns
				    #"Removed Columns"

	annotation PBI_ResultType = Table

