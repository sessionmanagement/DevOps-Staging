	partition 'Dim PRIMHD Review Accommodation Status' = m
		mode: import
		queryGroup: 'Dim Tables'
		source =
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ods", [Query="SELECT CAST(t1.[PRIMHDReviewAccommodationStatusID] AS nvarchar(20)) + '-1' AS [Dim PRIMHD Review Accommodation Status Unique KEY] #(lf)      ,t2.[PRIMHDReviewAccommodationStatusText] AS [ParentPRIMHDReviewAccommodationStatusText]#(lf)#(tab)  ,t1.[PRIMHDReviewAccommodationStatusText]#(lf)      ,t1.[PRIMHDReviewAccommodationStatusValue]#(lf)  FROM#(lf)  [RBMNB].[dlDimPRIMHDReviewAccommodationStatus] t1#(lf)  LEFT OUTER JOIN #(lf)  [RBEAL].[dlDimPRIMHDReviewAccommodationStatus] t2 ON t1.PRIMHDReviewAccommodationStatusParentId = t2.PRIMHDReviewAccommodationStatusID#(lf)  WHERE t1.[PRIMHDReviewAccommodationStatusIsActive] = 1#(lf)  #(lf)  UNION ALL#(lf)#(lf)  SELECT CAST(t1.[PRIMHDReviewAccommodationStatusID] AS nvarchar(20)) + '-5' AS [PRIMHD Review Accommodation Status Unique KEY] #(lf)      ,t2.[PRIMHDReviewAccommodationStatusText] AS [ParentPRIMHDReviewAccommodationStatusText]#(lf)#(tab)  ,t1.[PRIMHDReviewAccommodationStatusText]#(lf)      ,t1.[PRIMHDReviewAccommodationStatusValue]#(lf)  FROM#(lf)  [RBMNB].[dlDimPRIMHDReviewAccommodationStatus] t1#(lf)  LEFT OUTER JOIN #(lf)  [RBMNB].[dlDimPRIMHDReviewAccommodationStatus] t2 ON t1.PRIMHDReviewAccommodationStatusParentId = t2.PRIMHDReviewAccommodationStatusID#(lf)  WHERE t1.[PRIMHDReviewAccommodationStatusIsActive] = 1"])
