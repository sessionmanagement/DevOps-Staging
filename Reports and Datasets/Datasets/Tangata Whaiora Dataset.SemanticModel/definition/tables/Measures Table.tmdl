			        ALL ( 'Dim TW Referral _Explosion' ),
			        'Fact Tangata Whaiora Referral _Explosion'[Tangata Whaiora Referral Discharge Date] >= _StartDate,
			        'Fact Tangata Whaiora Referral _Explosion'[Tangata Whaiora Referral Discharge Date] <= _EndDate
