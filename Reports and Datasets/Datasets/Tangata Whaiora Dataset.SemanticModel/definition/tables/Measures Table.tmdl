		displayFolder: Tangata Whaiora Measures
		lineageTag: d30f6f3d-a09c-4d87-9370-eccf4e2a388a

	measure RefreshedAt_forDisplay =
			
			"Data Last Refreshed: "
			    & FORMAT (
			        LASTDATE ( LastRefreshed[Date Last Refreshed] ),
			        "dd/MM/YYYY - hh:mm AM/PM"
			    )
		lineageTag: 04a35b3d-4080-4dc2-9b46-ed89f4f6f8d1

	measure 'Tangata Whaiora Count (Referral Explosion)' =
			
			DISTINCTCOUNT ( 'Fact Tangata Whaiora Referral _Explosion'[Dim Tangata Whaiora KEY] )
		formatString: 0
		displayFolder: Referral Measures
		lineageTag: 38f8e6d3-f76a-4e57-bf0e-7a807d9e094b

	measure 'Referral Count (Referral Explosion)' =
			
			DISTINCTCOUNT ( 'Fact Tangata Whaiora Referral _Explosion'[Dim Tangata Whaiora Referral KEY] )
		formatString: 0
		lineageTag: 1cf79ffe-038c-4944-a32b-020bdf2b1ac3

	measure 'New referrals in selected range' =
			
			VAR _StartDate =
			    MIN ( 'Dim TW Activity Start Date'[Activity Start Calendar Date] )
			VAR _EndDate =
			    MAX ( 'Dim TW Activity Start Date'[Activity Start Calendar Date] )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'Fact Tangata Whaiora Referral _Explosion'[Dim Tangata Whaiora Referral KEY] ),
			        ALL ( 'Dim TW Referral _Explosion' ),
			        'Fact Tangata Whaiora Referral _Explosion'[Tangata Whaiora Referral Accepted Date] >= _StartDate,
			        'Fact Tangata Whaiora Referral _Explosion'[Tangata Whaiora Referral Accepted Date] <= _EndDate
			    )
		formatString: 0
		lineageTag: a984da9a-e4f6-411d-aced-092ceedc557d

	measure 'Activity Count' =
			
			DISTINCTCOUNT ( 'Fact Tangata Whaiora Activity Breakdown'[Tangata Whaiora Activity ID] )
		formatString: 0
		displayFolder: Activity Measures
		lineageTag: d4a75e50-ec82-4d91-883d-a1afcd8c1eba

	measure 'People Count (PRIMHD Explosion)' =
			
			VAR _StartDate =
			    MIN ( 'Dim TW Activity Start Date'[Activity Start Calendar Date] )
			VAR _EndDate =
			    MAX ( 'Dim TW Activity Start Date'[Activity Start Calendar Date] )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'Fact Tangata Whaiora PRIMHD Review _Explosion'[Dim Tangata Whaiora Unique KEY] ),
			        'Fact Tangata Whaiora PRIMHD Review _Explosion'[explosion] >= _StartDate,
			        'Fact Tangata Whaiora PRIMHD Review _Explosion'[explosion] <= _EndDate
			    )
		formatString: 0
		lineageTag: 88b810c2-28ea-46cd-ab9a-9dd96e4f58eb

	measure 'People Count (Referral Explosion)' =
			
