	measure 'People Count (Length of Stay at Quarter End)' =
			
			VAR _StartDate =
			    MIN ( 'Dim TW Activity Start Date'[Activity Start Calendar Date] )
			VAR _EndDate =
			    MAX ( 'Dim TW Activity Start Date'[Activity Start Calendar Date] )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'Fact Tangata Whaiora Referral Open Days by Quarter'[Dim Tangata Whaiora KEY] ),
			        'Fact Tangata Whaiora Referral Open Days by Quarter'[Referral End Date for Quarter] >= _StartDate,
			        'Fact Tangata Whaiora Referral Open Days by Quarter'[Referral End Date for Quarter] <= _EndDate
			    )
		formatString: 0
		lineageTag: 8b765f3d-d606-45d5-b030-64ccc98fb409

	measure 'People Count (Length of Stay at Quarter End & Referral Ended in Quarter)' =
			
			VAR _StartDate =
			    MIN ( 'Dim TW Activity Start Date'[Activity Start Calendar Date] )
			VAR _EndDate =
			    MAX ( 'Dim TW Activity Start Date'[Activity Start Calendar Date] )
			RETURN
			    CALCULATE (
			        [People Count (Length of Stay at Quarter End)],
			        'Fact Tangata Whaiora Referral Open Days by Quarter'[Tangata Whaiora Referral Discharge Date] >= _StartDate,
			        'Fact Tangata Whaiora Referral Open Days by Quarter'[Tangata Whaiora Referral Discharge Date] <= _EndDate
			    )
		formatString: 0
		lineageTag: 76b1a51d-c09e-40dd-a8d7-9b5fabd7c3f9

