table 'Measures Table'
	lineageTag: 59b1bfb2-6735-4fca-8df4-4dc1cc543ce3

	measure 'Tangata Whaiora Count' =
			
			COUNTROWS ( 'Dim Tangata Whaiora' )
		formatString: 0
		displayFolder: Tangata Whaiora Measures
		lineageTag: c160b0de-565a-4cff-83d7-828e9eb29fba

	measure 'Tangata Whaiora Active Count' =
			
			CALCULATE (
			    [Tangata Whaiora Count],
			    'Dim Tangata Whaiora'[Tangata Whaiora Status Is Active] = "Active"
			)
		formatString: 0
		displayFolder: Tangata Whaiora Measures
		lineageTag: fcc3f024-82e0-406e-9a3d-765f7fd06196

	measure 'Tangata Whaiora Female Count' =
			
			CALCULATE (
			    [Tangata Whaiora Count],
			    'Dim Tangata Whaiora'[Tangata Whaiora Gender] = "Female"
			)
		formatString: 0
		displayFolder: Tangata Whaiora Measures
		lineageTag: 713d03bf-fd50-4c55-9bd5-ccd034469ca8

	measure 'Tangata Whaiora Female Gender %' =
			
			DIVIDE ( [Tangata Whaiora Female Count], [Tangata Whaiora Count], 0 )
		displayFolder: Tangata Whaiora Measures
		lineageTag: 00b76488-c6c2-4b76-b7ef-f6bb7ca1897c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Number Of Referrals' =
			
			COUNTROWS ( 'Fact Tangata Whaiora Referral' )
		formatString: #,0
		displayFolder: Referral Measures
		lineageTag: 05eb99ad-fd40-47f5-9191-8dcd85dfa405

	measure 'Total Current Referrals' =
			
			CALCULATE (
			    [Total Number Of Referrals],
			    'Fact Tangata Whaiora Referral'[Tangata Whaiora Referral End Date KEY]
			        = BLANK ()
			)
		formatString: 0
		displayFolder: Referral Measures
		lineageTag: 3f7c211f-a7d0-4ca4-982a-ffa09c54d0b7

	measure 'Total Closed Referrals' =
			
			CALCULATE (
			    [Total Number Of Referrals],
			    'Fact Tangata Whaiora Referral'[Tangata Whaiora Referral End Date KEY]
			        <> BLANK ()
			)
		formatString: 0
		displayFolder: Referral Measures
		lineageTag: 827175f1-b484-42a1-848f-72a343f52327

	measure 'Tangata Whaiora Number of Referrals' =
			
			DISTINCTCOUNT ( 'Fact Tangata Whaiora Referral'[Tangata Whaiora Referral ID] )
		formatString: #,0
		displayFolder: Tangata Whaiora Measures
		lineageTag: eeded99e-eac8-45bb-a1df-303fb3785604

	measure 'Total Referrals This Month' =
			
			CALCULATE (
			    COUNTROWS ( 'Fact Tangata Whaiora Referral' ),
			    FILTER (
			        ALL ( 'Dim TW Referral Created Date' ),
			        'Dim TW Referral Created Date'[Referral Created Calendar Date] <= TODAY ()
			            && MONTH ( 'Dim TW Referral Created Date'[Referral Created Calendar Date] )
			                = MONTH ( TODAY () )
			            && YEAR ( 'Dim TW Referral Created Date'[Referral Created Calendar Date] )
			                = YEAR ( TODAY () )
			    )
			)
		formatString: 0
		displayFolder: Referral Measures
		lineageTag: 4e84492e-f706-44b1-8a0a-01bc5dcd5e63

	measure 'Tangata Whaiora Missing Address Count' =
			
			COUNTROWS (
			    FILTER (
			        'Dim Tangata Whaiora',
			        [Tangata Whaiora Address Missing Flag]
			            && [DWH Is Current] = 1
			    )
			)
		formatString: 0
		displayFolder: Tangata Whaiora Measures
		lineageTag: c8c441c0-6d49-441d-a844-467f7d5b2366

	measure 'Fact Referral Row Count' =
			
