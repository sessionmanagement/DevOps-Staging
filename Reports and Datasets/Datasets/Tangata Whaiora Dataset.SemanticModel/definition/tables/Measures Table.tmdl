		lineageTag: aee82abf-f37b-4162-893f-ad4dc13e96a9

	measure 'Referral Accepted 2' =
			
			IF (
			    ISBLANK (
			        MAXX (
			            'Fact Tangata Whaiora Referral',
			            'Fact Tangata Whaiora Referral'[Tangata Whaiora Referral Accepted Date KEY]
			        )
			    ),
			    FALSE (),
			    TRUE ()
			)
		formatString: """TRUE"";""TRUE"";""FALSE"""
		displayFolder: Referral Measures
		lineageTag: 10259148-c020-4117-b186-ab5af5e127f0

	measure 'Fact Activity Row Count' =
			
