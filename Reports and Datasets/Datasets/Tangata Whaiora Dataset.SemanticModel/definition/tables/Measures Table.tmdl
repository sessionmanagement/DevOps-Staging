	measure 'Tangata Whaiora Number of Referrals Relationship' =
			
			CALCULATE (
			    DISTINCTCOUNT ( 'Fact Tangata Whaiora Referral'[Tangata Whaiora Referral ID] ),
			    USERELATIONSHIP ( 'Dim Date'[Dim Date KEY], 'Dim TW Referral Created Date'[Referral Created Dim Date KEY] )
			)
