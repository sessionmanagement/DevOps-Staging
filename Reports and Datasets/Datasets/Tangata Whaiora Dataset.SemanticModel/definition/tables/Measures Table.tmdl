	measure 'Activity Duration (Activity Start Date in Selected Period - Hours)' =
			
			VAR _StartDate =
			    MIN ( 'Dim TW Activity Start Date'[Activity Start Calendar Date] )
			VAR _EndDate =
			    MAX ( 'Dim TW Activity Start Date'[Activity Start Calendar Date] )
			RETURN
			    CALCULATE (
			        SUM ( 'Fact Tangata Whaiora Activity Breakdown'[Tangata Whaiora Activity Duration] ) / 60,
			        'Fact Tangata Whaiora Activity Breakdown'[Tangata Whaiora Activity Start Date] >= _StartDate,
			        'Fact Tangata Whaiora Activity Breakdown'[Tangata Whaiora Activity Start Date] <= _EndDate
