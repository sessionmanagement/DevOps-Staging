		annotation SummarizationSetBy = Automatic

	column PRIMHDReviewCompletedWithin48HoursOfReferralDischarge =
			
			IF(
			    'Fact Tangata Whaiora PRIMHD Review'[IsLastReview] = "No" || ISBLANK('Fact Tangata Whaiora PRIMHD Review'[DischargeDate]),
			    "N/A",
			    IF(
			        'Fact Tangata Whaiora PRIMHD Review'[IsLastReview] = "Yes" && 'Fact Tangata Whaiora PRIMHD Review'[HoursBetweenReferralDischargeAndPRIMHDReview] <= 48 && 'Fact Tangata Whaiora PRIMHD Review'[HoursBetweenReferralDischargeAndPRIMHDReview] >= -48,
			        "Yes",
			        "No"
			    )
			)
		lineageTag: c8586136-cbfd-4c7c-bc2b-dbc9bc4af49c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column HoursBetweenReferralDischargeAndPRIMHDReview
