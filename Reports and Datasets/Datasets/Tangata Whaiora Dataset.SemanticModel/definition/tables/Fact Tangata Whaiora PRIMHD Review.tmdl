		dataType: string
		lineageTag: bd099a36-d883-4c80-8bd7-a50c8b1ec046
		summarizeBy: none
		sourceColumn: ReferralIsDischarged

		annotation SummarizationSetBy = Automatic

	column DataQualityErrors =
			
			IF(
			    AND(
			        NOT(ISBLANK('Fact Tangata Whaiora PRIMHD Review'[DaysSincePreviousPRIMHDReview])),
			        'Fact Tangata Whaiora PRIMHD Review'[DaysSincePreviousPRIMHDReview] = 0
			    ) || AND(
			        NOT(ISBLANK('Fact Tangata Whaiora PRIMHD Review'[DaysUntilNextPRIMHDReview])),
			        'Fact Tangata Whaiora PRIMHD Review'[DaysUntilNextPRIMHDReview] = 0
			    ),
			    "Two PRIMHD reviews entered on same date",
			    "No errors"
			)
		lineageTag: b24be67f-c655-4af4-a6a9-0cb5e24009bb
		summarizeBy: none

