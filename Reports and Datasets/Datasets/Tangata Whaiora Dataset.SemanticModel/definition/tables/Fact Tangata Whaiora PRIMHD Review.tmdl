	column PreviousPRIMHDReviewWithin90Days =
			
			IF(
			    ISBLANK(
			        'Fact Tangata Whaiora PRIMHD Review'[DaysSincePreviousPRIMHDReview]
			    ),
			    "N/A",
			    IF(
			        'Fact Tangata Whaiora PRIMHD Review'[DaysSincePreviousPRIMHDReview] <= 90,
			        "Yes",
			        "No"
			    )
			)
		lineageTag: 44df3049-cff3-4a81-94f3-8e86a9723986
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'Fact Tangata Whaiora PRIMHD Review' = m
		mode: import
		queryGroup: 'Fact Tables'
		source =
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ods", [Query="WITH PrimhdServiceReviews AS (#(lf)    SELECT #(lf)        [PrimhdServiceReviewId],#(lf)        CAST(p.[PersonId] AS nvarchar(20)) + '-1' AS [Dim Tangata Whaiora Unique KEY],#(lf)        CAST([PrimhdServiceReviewReviewDate] AS date) AS [PrimhdServiceReviewReviewDate],#(lf)#(tab)#(tab)r.AcceptedDate,#(lf)#(tab)#(tab)CAST(r.AcceptedDate AS date) AS AcceptedDateAsDate,#(lf)        ISNULL(CAST(r.DischargeDate AS date), CAST(GETDATE() AS date)) AS ReferralEndDateOrToday,#(lf)#(tab)#(tab)r.DischargeDate,#(lf)        CAST(p.[ReferralId] AS nvarchar(20)) + '_' + CAST(p.[PersonId] AS nvarchar(20)) + '_1' AS [Dim Tangata Whaiora Referral Unique KEY],#(lf)        CAST([AccommodationStatusId] AS nvarchar(20)) + '-1' AS [Dim PRIMHD Review Accommodation Status Unique KEY],#(lf)        CAST([EmploymentStatusId] AS nvarchar(20)) + '-1' AS [Dim PRIMHD Review Employment Status Unique KEY],#(lf)        CAST([EducationStatusId] AS nvarchar(20)) + '-1' AS [Dim PRIMHD Review Education Status Unique KEY],#(lf)        CAST([WellnessPlanStatusId] AS nvarchar(20)) + '-1' AS [Dim PRIMHD Review Wellness Plan Status Unique KEY],#(lf)        [PrimhdServiceReviewCreatedDate],#(lf)#(tab)#(tab)CAST([PrimhdServiceReviewCreatedDate] AS date) AS [PrimhdServiceReviewCreatedDateASDate],#(lf)#(tab)#(tab)DATEDIFF(Hour, r.AcceptedDate, p.PrimhdServiceReviewReviewDate) AS HoursBetweenReferralStartAndPRIMHDReview,#(lf)#(tab)#(tab)DATEDIFF(Hour, p.PrimhdServiceReviewReviewDate, r.DischargeDate) AS HoursBetweenReferralDischargeAndPRIMHDReview#(lf)#(lf)    FROM [RBEAL].[dlFactPrimhdServiceReview] p#(lf)    INNER JOIN [RBEAL].legacyFactReferral r ON p.ReferralId = r.ID#(lf)    UNION ALL#(lf)    SELECT #(lf)        [PrimhdServiceReviewId],#(lf)        CAST(p.[PersonId] AS nvarchar(20)) + '-5' AS [Dim Tangata Whaiora Unique KEY],#(lf)        CAST([PrimhdServiceReviewReviewDate] AS date) AS [PrimhdServiceReviewReviewDate],#(lf)#(tab)#(tab)r.AcceptedDate,#(lf)#(tab)#(tab)CAST(r.AcceptedDate AS date) AS AcceptedDateAsDate,#(lf)        ISNULL(CAST(r.DischargeDate AS date), CAST(GETDATE() AS date)) AS ReferralEndDateOrToday,#(lf)#(tab)#(tab)r.DischargeDate,#(lf)        CAST(p.[ReferralId] AS nvarchar(20)) + '_' + CAST(p.[PersonId] AS nvarchar(20)) + '_5' AS [Dim Tangata Whaiora Referral Unique KEY],#(lf)        CAST([AccommodationStatusId] AS nvarchar(20)) + '-5' AS [Dim PRIMHD Review Accommodation Status Unique KEY],#(lf)        CAST([EmploymentStatusId] AS nvarchar(20)) + '-5' AS [Dim PRIMHD Review Employment Status Unique KEY],#(lf)        CAST([EducationStatusId] AS nvarchar(20)) + '-5' AS [Dim PRIMHD Review Education Status Unique KEY],#(lf)        CAST([WellnessPlanStatusId] AS nvarchar(20)) + '-5' AS [Dim PRIMHD Review Wellness Plan Status Unique KEY],#(lf)        [PrimhdServiceReviewCreatedDate],#(lf)#(tab)#(tab)CAST([PrimhdServiceReviewCreatedDate] AS date) AS [PrimhdServiceReviewCreatedDateASDate],#(lf)#(tab)#(tab)DATEDIFF(Hour, r.AcceptedDate, p.PrimhdServiceReviewReviewDate) AS HoursBetweenReferralStartAndPRIMHDReview,#(lf)#(tab)#(tab)DATEDIFF(Hour, p.PrimhdServiceReviewReviewDate, r.DischargeDate) AS HoursBetweenReferralDischargeAndPRIMHDReview#(lf)    FROM [RBMNB].[dlFactPrimhdServiceReview] p#(lf)    INNER JOIN [RBEAL].legacyFactReferral r ON p.ReferralId = r.ID#(lf)),#(lf)RankedReviews AS (#(lf)SELECT *,#(lf)    LEAD([PrimhdServiceReviewReviewDate]) OVER (#(lf)        PARTITION BY [Dim Tangata Whaiora Referral Unique KEY] #(lf)        ORDER BY [PrimhdServiceReviewReviewDate]#(lf)    ) AS NextEnteredPrimhdReviewDate,#(lf)    LAG([PrimhdServiceReviewReviewDate]) OVER (#(lf)        PARTITION BY [Dim Tangata Whaiora Referral Unique KEY] #(lf)        ORDER BY [PrimhdServiceReviewReviewDate]#(lf)    ) AS PreviousEnteredPrimhdReviewDate,#(lf)    ROW_NUMBER() OVER (#(lf)        PARTITION BY [Dim Tangata Whaiora Referral Unique KEY] #(lf)        ORDER BY [PrimhdServiceReviewReviewDate]#(lf)    ) AS PRIMHDReviewNumber,#(lf)    ROW_NUMBER() OVER (#(lf)        PARTITION BY [Dim Tangata Whaiora Referral Unique KEY] #(lf)        ORDER BY [PrimhdServiceReviewReviewDate] DESC#(lf)    ) AS ReversePRIMHDReviewNumber#(lf)FROM PrimhdServiceReviews#(lf))#(lf)SELECT *,#(lf)    CASE#(lf)        WHEN NextEnteredPrimhdReviewDate IS NULL OR NextEnteredPrimhdReviewDate > ReferralEndDateOrToday THEN ReferralEndDateOrToday#(lf)        ELSE NextEnteredPrimhdReviewDate#(lf)    END AS PrimhdServiceReviewValidToDate,#(lf)    CASE#(lf)        WHEN ReversePRIMHDReviewNumber = 1 THEN 'Yes'#(lf)        ELSE 'No'#(lf)    END AS IsLastReview,#(lf)#(tab)CASE#(lf)#(tab)#(tab)WHEN DischargeDate IS NOT NULL THEN 'Yes'#(lf)#(tab)#(tab)ELSE 'No'#(lf)#(tab)END AS ReferralIsDischarged#(lf)FROM RankedReviews"]),
				    #"Removed Columns" = Table.RemoveColumns(Source,{"ReversePRIMHDReviewNumber"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Removed Columns",{{"PrimhdServiceReviewReviewDate", type date}, {"ReferralEndDateOrToday", type date}, {"NextEnteredPrimhdReviewDate", type date}, {"PrimhdServiceReviewValidToDate", type date}, {"AcceptedDateAsDate", type date}, {"PreviousEnteredPrimhdReviewDate", type date}, {"PrimhdServiceReviewCreatedDateASDate", type date}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

