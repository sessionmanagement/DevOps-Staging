		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column DaysUntilNextPRIMHDReview =
			
			IF(
			    ISBLANK(
			        'Fact Tangata Whaiora PRIMHD Review'[NextEnteredPrimhdReviewDate]),
			        BLANK(),
			        DATEDIFF(
			            'Fact Tangata Whaiora PRIMHD Review'[PrimhdServiceReviewReviewDate],
			            'Fact Tangata Whaiora PRIMHD Review'[NextEnteredPrimhdReviewDate],
			            DAY
			        )
			)
		formatString: 0
		lineageTag: 451ba736-dcf8-435f-913f-e4e27adb18c0
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column DaysSincePreviousPRIMHDReview =
			
			IF(
			    ISBLANK(
			        'Fact Tangata Whaiora PRIMHD Review'[PreviousEnteredPrimhdReviewDate]),
			        BLANK(),
			        DATEDIFF(
			            'Fact Tangata Whaiora PRIMHD Review'[PreviousEnteredPrimhdReviewDate],
			            'Fact Tangata Whaiora PRIMHD Review'[PrimhdServiceReviewReviewDate],
			            DAY
			        )
			)
		formatString: 0
		lineageTag: 33fce05f-c47a-4d43-bdd1-8617db80f161
		summarizeBy: sum

