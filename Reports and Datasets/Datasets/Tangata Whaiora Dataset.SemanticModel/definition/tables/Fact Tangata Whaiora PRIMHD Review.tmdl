		lineageTag: fbf9f8f1-3148-460b-8efc-fb58d7557332
		summarizeBy: sum
		sourceColumn: PRIMHDReviewNumber

		annotation SummarizationSetBy = Automatic

	column PRIMHDReviewCompletedWithin48HoursOfReferralAcceptance =
			
			IF(
			    'Fact Tangata Whaiora PRIMHD Review'[PRIMHDReviewNumber] > 1 || ISBLANK('Fact Tangata Whaiora PRIMHD Review'[HoursBetweenReferralStartAndPRIMHDReview]),
			    "N/A",
			    IF(
			        'Fact Tangata Whaiora PRIMHD Review'[PRIMHDReviewNumber] = 1 && 'Fact Tangata Whaiora PRIMHD Review'[HoursBetweenReferralStartAndPRIMHDReview] <= 48 && 'Fact Tangata Whaiora PRIMHD Review'[HoursBetweenReferralStartAndPRIMHDReview] >= -48,
			        "Yes",
			        "No"
			    )
			)
		lineageTag: 78f9b75f-d32a-4894-be44-c7bb73ccebe4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

