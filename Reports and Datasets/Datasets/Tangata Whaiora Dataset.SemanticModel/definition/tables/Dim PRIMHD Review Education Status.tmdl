	partition 'Dim PRIMHD Review Education Status' = m
		mode: import
		queryGroup: 'Dim Tables'
		source =
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ods", [Query="SELECT CAST(t1.[PRIMHDReviewEducationStatusID] AS nvarchar(20)) + '-1' AS [Dim PRIMHD Review Education Status Unique KEY] #(lf)      ,t2.[PRIMHDReviewEducationStatusText] AS [ParentPRIMHDReviewEducationStatusText]#(lf)#(tab)  ,t1.[PRIMHDReviewEducationStatusText]#(lf)      ,t1.[PRIMHDReviewEducationStatusValue]#(lf)  FROM#(lf)  [RBMNB].[dlDimPRIMHDReviewEducationStatus] t1#(lf)  LEFT OUTER JOIN #(lf)  [RBEAL].[dlDimPRIMHDReviewEducationStatus] t2 ON t1.PRIMHDReviewEducationStatusParentId = t2.PRIMHDReviewEducationStatusID#(lf)  WHERE t1.[PRIMHDReviewEducationStatusIsActive] = 1#(lf)  #(lf)  UNION ALL#(lf)#(lf)  SELECT CAST(t1.[PRIMHDReviewEducationStatusID] AS nvarchar(20)) + '-5' AS [Dim PRIMHD Review Education Status Unique KEY] #(lf)      ,t2.[PRIMHDReviewEducationStatusText] AS [ParentPRIMHDReviewEducationStatusText]#(lf)#(tab)  ,t1.[PRIMHDReviewEducationStatusText]#(lf)      ,t1.[PRIMHDReviewEducationStatusValue]#(lf)  FROM#(lf)  [RBMNB].[dlDimPRIMHDReviewEducationStatus] t1#(lf)  LEFT OUTER JOIN #(lf)  [RBMNB].[dlDimPRIMHDReviewEducationStatus] t2 ON t1.PRIMHDReviewEducationStatusParentId = t2.PRIMHDReviewEducationStatusID#(lf)  WHERE t1.[PRIMHDReviewEducationStatusIsActive] = 1"])
				in
				    Source

