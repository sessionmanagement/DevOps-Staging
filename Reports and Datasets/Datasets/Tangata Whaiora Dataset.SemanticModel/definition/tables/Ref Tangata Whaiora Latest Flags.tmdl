				let
				    Source = Sql.Database(Server, Database, [Query="WITH missing_orig AS#(lf)(#(lf)    SELECT#(lf)        dim_client_unique_key,#(lf)        CAST(ISNULL(client_contact_phone_missing_flag,1) AS smallint)                AS client_contact_phone_missing_flag,#(lf)        ISNULL(CLIENT_address_missing_flag,1)                                        AS client_address_missing_flag,#(lf)        ISNULL(CLIENT_address_missing_flag_date,1)                                   AS client_address_missing_flag_date,#(lf)        ISNULL(CLIENT_contact_phone_missing_flag_date,1)                             AS client_contact_phone_missing_flag_date,#(lf)        ISNULL(CLIENT_emergency_contact_phone_missing_flag,1)                        AS client_emergency_contact_phone_missing_flag,#(lf)        ISNULL(CLIENT_ethnicity_group_missing_flag,1)                                AS client_ethnicity_group_missing_flag,#(lf)        ISNULL(CLIENT_gp_only_missing_flag,1)                                        AS client_gp_only_missing_flag,#(lf)        ISNULL(CLIENT_gp_registration_missing_flag,1)                                AS client_gp_registration_missing_flag,#(lf)        ISNULL(CLIENT_legal_status_missing_flag,1)                                   AS client_legal_status_missing_flag,#(lf)        ISNULL(CLIENT_mental_health_condition_missing_flag,1)                        AS client_mental_health_condition_missing_flag,#(lf)        ISNULL(CLIENT_physical_condition_missing_flag,1)                             AS client_physical_condition_missing_flag,#(lf)        ISNULL(CLIENT_substance_condition_missing_flag,1)                            AS client_substance_condition_missing_flag,#(lf)        ISNULL(CLIENT_primhd_review_current_flag,1)                                  AS client_primhd_review_current_flag,#(lf)        ISNULL(CLIENT_primhd_review_due_soon_flag,1)                                 AS client_primhd_review_due_soon_flag,#(lf)        ISNULL(CLIENT_primhd_review_missing_flag,1)                                  AS client_primhd_review_missing_flag,#(lf)        ISNULL(CLIENT_primhd_review_overdue_flag,1)                                  AS client_primhd_review_overdue_flag,#(lf)#(lf)        CASE #(lf)            WHEN client_residency_status IS NULL THEN 1#(lf)            ELSE 0#(lf)        END AS client_residency_missing_flag,#(tab)#(tab)#(tab)#(lf)#(lf)        ISNULL(client_smoking_advice_flag,1)                                        AS client_smoking_advice_flag,#(lf)        ISNULL(client_smoking_cessation_referral_flag,1)                            AS client_smoking_cessation_referral_flag,#(lf)        ISNULL(client_smoking_status_missing_flag,1)                                AS client_smoking_status_missing_flag,#(lf)        ISNULL(client_status_is_active,1)                                           AS client_status_is_active,#(lf)        ISNULL(client_gender,1)                                                     AS client_gender,#(lf)#(lf)        CASE #(lf)            WHEN client_gender IS NULL THEN 1#(lf)            WHEN client_gender = 'Unspecified or Unknown' THEN 1#(lf)            ELSE 0#(lf)        END AS client_gender_missing_flag,#(lf)#(lf)        vw_dim_date.calendar_date                                                    AS client_smoking_assessment_date,#(lf)        ISNULL(vw_dim_client.client_smoking_status, 'Missing')                       AS client_smoking_status_current,#(lf)        vw_dim_client.client_smoking_status,#(lf)#(lf)        -- === Newly added column to check if NHI is missing (either NULL or blank) ===#(lf)        CASE #(lf)            WHEN vw_dim_client.client_nhi_number IS NULL #(lf)                 OR LTRIM(RTRIM(vw_dim_client.client_nhi_number)) = '' #(lf)            THEN 1 #(lf)            ELSE 0 #(lf)        END AS client_nhi_is_missing_flag#(lf)#(lf)    FROM edw.vw_dim_client#(lf)    LEFT JOIN edw.vw_dim_date #(lf)        ON vw_dim_client.client_smoking_assessment_date = vw_dim_date.dim_date_key#(lf)    WHERE DWHIsCurrent = 1 #(lf)),#(lf)#(lf)MissingFinal AS#(lf)(#(lf)    SELECT#(lf)        dim_client_unique_key,#(lf)        client_address_missing_flag,#(lf)        client_address_missing_flag_date,#(lf)        client_contact_phone_missing_flag,#(lf)        client_contact_phone_missing_flag_date,#(lf)        client_emergency_contact_phone_missing_flag,#(lf)        client_ethnicity_group_missing_flag,#(lf)        client_gp_only_missing_flag,#(lf)        client_gp_registration_missing_flag,#(lf)#(lf)        CASE #(lf)            WHEN dim_client_unique_key LIKE '%-5%' THEN -1 #(lf)            ELSE client_legal_status_missing_flag#(lf)        END AS client_legal_status_missing_flag,#(lf)#(lf)        CASE #(lf)            WHEN dim_client_unique_key LIKE '%-5%' THEN -1 #(lf)            ELSE client_mental_health_condition_missing_flag#(lf)        END AS client_mental_health_condition_missing_flag,#(lf)#(lf)        CASE #(lf)            WHEN dim_client_unique_key LIKE '%-5%' THEN -1 #(lf)            ELSE client_physical_condition_missing_flag#(lf)        END AS client_physical_condition_missing_flag,#(lf)#(lf)        CASE #(lf)            WHEN dim_client_unique_key LIKE '%-5%' THEN -1 #(lf)            ELSE client_substance_condition_missing_flag#(lf)        END AS client_substance_condition_missing_flag,#(lf)#(lf)        client_primhd_review_current_flag,#(lf)        client_primhd_review_due_soon_flag,#(lf)        client_primhd_review_missing_flag,#(lf)        client_primhd_review_overdue_flag,#(lf)        client_residency_missing_flag,#(lf)        client_smoking_advice_flag,#(lf)#(lf)        --------------------------------------------------------------------------#(lf)        -- Updated logic for client_No_smoking_brief_advice_within_6_months_flag:#(lf)        -- If client_smoking_status_current = 'Never smoked tobacco', set to 1#(lf)        --------------------------------------------------------------------------#(lf)        CASE #(lf)            WHEN client_smoking_status_current LIKE 'Never smoked%' THEN 1#(lf)            WHEN client_smoking_status_missing_flag = 1             THEN ''  #(lf)            WHEN client_smoking_advice_flag = 0                     THEN 1  #(lf)            WHEN client_smoking_advice_flag = 1 #(lf)                 AND DATEDIFF(DAY, client_smoking_assessment_date, GETDATE()) <= 182#(lf)            THEN 1  #(lf)            ELSE 0  #(lf)        END AS client_No_smoking_brief_advice_within_6_months_flag,#(lf)#(lf)        client_smoking_assessment_date,#(lf)        client_smoking_cessation_referral_flag,#(lf)#(lf)        --------------------------------------------------------------------------#(lf)        -- Updated logic for client_smoking_cessation_6_months_flag:#(lf)        -- If client_smoking_status_current = 'Never smoked tobacco', set to 1#(lf)        --------------------------------------------------------------------------#(lf)        CASE #(lf)            WHEN client_smoking_status_current LIKE 'Never smoked%' THEN 1#(lf)            WHEN client_smoking_status_missing_flag = 1 THEN ''  #(lf)            WHEN DATEDIFF(DAY, client_smoking_assessment_date, GETDATE()) <= 182#(lf)            THEN client_smoking_cessation_referral_flag#(lf)            ELSE 0#(lf)        END AS client_smoking_cessation_6_months_flag,#(lf)#(lf)        client_smoking_status_missing_flag,#(lf)        client_status_is_active,#(lf)        client_gender_missing_flag,#(lf)#(lf)        CASE #(lf)            WHEN dim_client_unique_key LIKE '%-1%' OR dim_client_unique_key IN ('N/A','Unknown')#(lf)            THEN #(lf)                client_address_missing_flag#(lf)                + client_contact_phone_missing_flag#(lf)                + client_emergency_contact_phone_missing_flag#(lf)                + client_ethnicity_group_missing_flag#(lf)                + client_gp_only_missing_flag#(lf)                + client_gp_registration_missing_flag#(lf)                + client_legal_status_missing_flag#(lf)                + client_mental_health_condition_missing_flag#(lf)                + client_physical_condition_missing_flag#(lf)                + client_primhd_review_missing_flag#(lf)                + client_residency_missing_flag#(lf)                + client_smoking_status_missing_flag#(lf)                + client_substance_condition_missing_flag#(lf)                + client_gender_missing_flag#(lf)            ELSE #(lf)                client_address_missing_flag#(lf)                + client_contact_phone_missing_flag#(lf)                + client_emergency_contact_phone_missing_flag#(lf)                + client_ethnicity_group_missing_flag#(lf)                + client_gp_only_missing_flag#(lf)                + client_gp_registration_missing_flag#(lf)                + client_primhd_review_missing_flag#(lf)                + client_residency_missing_flag#(lf)                + client_smoking_status_missing_flag#(lf)                + client_gender_missing_flag#(lf)        END AS addition_of_missing,#(lf)#(lf)        client_address_missing_flag#(lf)        + client_contact_phone_missing_flag#(lf)        + client_emergency_contact_phone_missing_flag#(lf)        + client_ethnicity_group_missing_flag#(lf)        + client_gp_only_missing_flag#(lf)        + client_gp_registration_missing_flag#(lf)        -- + client_legal_status_missing_flag           -- Remove for Housing#(lf)        + client_mental_health_condition_missing_flag#(lf)        + client_physical_condition_missing_flag#(lf)        -- + client_primhd_review_missing_flag          -- Remove for Housing#(lf)        + client_residency_missing_flag#(lf)        + client_smoking_status_missing_flag#(lf)        + client_substance_condition_missing_flag#(lf)        + client_gender_missing_flag AS addition_of_missing_Housing,#(lf)#(lf)        CASE #(lf)            WHEN dim_client_unique_key LIKE '%-1%' OR dim_client_unique_key IN ('N/A','Unknown')#(lf)            THEN#(lf)                (FLOOR( client_address_missing_flag#(lf)                      + client_contact_phone_missing_flag#(lf)                      + client_emergency_contact_phone_missing_flag#(lf)                      + client_ethnicity_group_missing_flag#(lf)                      + client_gp_only_missing_flag#(lf)                      + client_gp_registration_missing_flag#(lf)                      + client_legal_status_missing_flag#(lf)                      + client_mental_health_condition_missing_flag#(lf)                      + client_physical_condition_missing_flag#(lf)                      + client_primhd_review_missing_flag#(lf)                      + client_residency_missing_flag#(lf)                      + client_smoking_status_missing_flag#(lf)                      + client_substance_condition_missing_flag#(lf)                      + client_gender_missing_flag ) / 14.0#(lf)                )#(lf)            ELSE#(lf)                (FLOOR( client_address_missing_flag#(lf)                      + client_contact_phone_missing_flag#(lf)                      + client_emergency_contact_phone_missing_flag#(lf)                      + client_ethnicity_group_missing_flag#(lf)                      + client_gp_only_missing_flag#(lf)                      + client_gp_registration_missing_flag#(lf)                      + client_primhd_review_missing_flag#(lf)                      + client_residency_missing_flag#(lf)                      + client_smoking_status_missing_flag#(lf)                      + client_gender_missing_flag ) / 10.0#(lf)                )#(lf)        END AS missing_additions_percent,#(lf)#(lf)        client_smoking_status_current,#(lf)#(lf)        -- Include the newly derived column from 'missing_orig'#(lf)        missing_orig.client_nhi_is_missing_flag#(lf)#(lf)    FROM missing_orig#(lf))#(lf)#(lf)SELECT #(lf)    *,#(lf)    CASE #(lf)        WHEN dim_client_unique_key LIKE '%-5%' THEN 10 - addition_of_missing#(lf)        ELSE 14 - addition_of_missing#(lf)    END AS addition_of_non_missing,#(lf)#(lf)    12 - addition_of_missing_housing AS addition_of_non_missing_housing#(lf)FROM MissingFinal;"]),
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, each ApplyNamingConventions(_)),
				    #"Renamed Columns" = Table.RenameColumns(#"Transformed Column Names",{{"Dim Tangata Whaiora Unique KEY", "Ref Tangata Whaiora Unique KEY"}})
