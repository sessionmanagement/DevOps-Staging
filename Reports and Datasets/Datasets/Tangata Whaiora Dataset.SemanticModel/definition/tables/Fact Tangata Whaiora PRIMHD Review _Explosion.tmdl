	column PreviousPRIMHDReviewWithin90Days =
			
			IF(
			    ISBLANK(
			        'Fact Tangata Whaiora PRIMHD Review _Explosion'[DaysSincePreviousPRIMHDReview]
			    ),
			    "N/A",
			    IF(
			        'Fact Tangata Whaiora PRIMHD Review _Explosion'[DaysSincePreviousPRIMHDReview] <= 90,
			        "Yes",
			        "No"
			    )
			)
		lineageTag: a9dc45f8-843f-4568-a33a-ba5cd54d1bb6
