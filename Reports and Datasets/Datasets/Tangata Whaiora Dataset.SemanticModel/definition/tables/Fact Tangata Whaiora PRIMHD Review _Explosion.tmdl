	column PRIMHDReviewNumber
		dataType: int64
		formatString: 0
		lineageTag: 4e2013de-529b-4db7-8bb0-bac74521991e
		summarizeBy: sum
		sourceColumn: PRIMHDReviewNumber

		annotation SummarizationSetBy = Automatic

	column PRIMHDReviewCompletedWithin48HoursOfReferralAcceptance =
			
			IF(
			    'Fact Tangata Whaiora PRIMHD Review _Explosion'[PRIMHDReviewNumber] > 1 || ISBLANK('Fact Tangata Whaiora PRIMHD Review _Explosion'[HoursBetweenReferralStartAndPRIMHDReview]),
			    "N/A",
			    IF(
			        'Fact Tangata Whaiora PRIMHD Review _Explosion'[PRIMHDReviewNumber] = 1 && 'Fact Tangata Whaiora PRIMHD Review _Explosion'[HoursBetweenReferralStartAndPRIMHDReview] <= 48 && 'Fact Tangata Whaiora PRIMHD Review _Explosion'[HoursBetweenReferralStartAndPRIMHDReview] >= -48,
			        "Yes",
			        "No"
			    )
			)
		lineageTag: b9d7ab9a-6137-45b8-aa7a-5d5eef55720e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column PreviousEnteredPrimhdReviewDate
		dataType: dateTime
		formatString: Short Date
		lineageTag: 25eab9fe-aeea-4bdb-b0d2-86d603af7c62
		summarizeBy: none
		sourceColumn: PreviousEnteredPrimhdReviewDate

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column DaysSincePreviousPRIMHDReview =
			
			IF(
			    ISBLANK(
			        'Fact Tangata Whaiora PRIMHD Review _Explosion'[PreviousEnteredPrimhdReviewDate]),
			        BLANK(),
			        DATEDIFF(
			            'Fact Tangata Whaiora PRIMHD Review _Explosion'[PreviousEnteredPrimhdReviewDate],
			            'Fact Tangata Whaiora PRIMHD Review _Explosion'[PrimhdServiceReviewCreatedDate],
			            DAY
			        )
			)
		formatString: 0
		lineageTag: 27f86a09-0e5b-4998-a472-b8e05001cf82
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column DaysUntilNextPRIMHDReview =
			
			IF(
			    ISBLANK(
			        'Fact Tangata Whaiora PRIMHD Review _Explosion'[NextEnteredPrimhdReviewDate]),
			        BLANK(),
			        DATEDIFF(
			            'Fact Tangata Whaiora PRIMHD Review _Explosion'[PrimhdServiceReviewCreatedDate],
			            'Fact Tangata Whaiora PRIMHD Review _Explosion'[NextEnteredPrimhdReviewDate],
			            DAY
			        )
			)
		formatString: 0
		lineageTag: b2300e25-0eb4-4bb3-95ad-3748973b24cf
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

