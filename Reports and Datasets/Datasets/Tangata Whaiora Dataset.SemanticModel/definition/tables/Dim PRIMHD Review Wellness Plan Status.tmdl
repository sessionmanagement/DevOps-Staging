		source =
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ods", [Query="SELECT CAST(t1.[PRIMHDReviewWellnessPlanStatusID] AS nvarchar(20)) + '-1' AS [Dim PRIMHD Review WellnessPlan Status Unique KEY] #(lf)      ,t2.[PRIMHDReviewWellnessPlanStatusText] AS [ParentPRIMHDReviewWellnessPlanStatusText]#(lf)#(tab)  ,t1.[PRIMHDReviewWellnessPlanStatusText]#(lf)      ,t1.[PRIMHDReviewWellnessPlanStatusValue]#(lf)  FROM#(lf)  [RBMNB].[dlDimPRIMHDReviewWellnessPlanStatus] t1#(lf)  LEFT OUTER JOIN #(lf)  [RBEAL].[dlDimPRIMHDReviewWellnessPlanStatus] t2 ON t1.PRIMHDReviewWellnessPlanStatusParentId = t2.PRIMHDReviewWellnessPlanStatusID#(lf)  WHERE t1.[PRIMHDReviewWellnessPlanStatusIsActive] = 1#(lf)  #(lf)  UNION ALL#(lf)#(lf)  SELECT CAST(t1.[PRIMHDReviewWellnessPlanStatusID] AS nvarchar(20)) + '-5' AS [Dim PRIMHD Review WellnessPlan Status Unique KEY] #(lf)      ,t2.[PRIMHDReviewWellnessPlanStatusText] AS [ParentPRIMHDReviewWellnessPlanStatusText]#(lf)#(tab)  ,t1.[PRIMHDReviewWellnessPlanStatusText]#(lf)      ,t1.[PRIMHDReviewWellnessPlanStatusValue]#(lf)  FROM#(lf)  [RBMNB].[dlDimPRIMHDReviewWellnessPlanStatus] t1#(lf)  LEFT OUTER JOIN #(lf)  [RBMNB].[dlDimPRIMHDReviewWellnessPlanStatus] t2 ON t1.PRIMHDReviewWellnessPlanStatusParentId = t2.PRIMHDReviewWellnessPlanStatusID#(lf)  WHERE t1.[PRIMHDReviewWellnessPlanStatusIsActive] = 1"])
