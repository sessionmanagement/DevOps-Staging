	partition 'Fact Tangata Whaiora Activity Breakdown' = m
		mode: import
		queryGroup: 'Fact Tables'
		source =
				let
				    Source = Sql.Database(Server, Database),
				    edw_fact_client_activity_breakdown = Source{[Schema="edw",Item="vw_fact_client_activity_breakdown"]}[Data],
				    #"Reduce Rows" = if #"Top N Rows" <> "All" then Table.FirstN(edw_fact_client_activity_breakdown, Number.FromText(#"Top N Rows")) else edw_fact_client_activity_breakdown,
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transform Column Names" = Table.TransformColumnNames(#"Reduce Rows", each ApplyNamingConventions(_)),
				    #"Merged Queries" = Table.NestedJoin(#"Transform Column Names", {"Fact Tangata Whaiora Activity Breakdown KEY", "Dim Company KEY"}, #"Fact Tangata Whaiora Max Activity Key", {"Fact Tangata Whaiora Activity Breakdown KEY", "Dim Company KEY"}, "Fact Tangata Whaiora Max Activity Key", JoinKind.LeftOuter),
				    #"Expanded Fact Tangata Whaiora Max Activity Key" = Table.ExpandTableColumn(#"Merged Queries", "Fact Tangata Whaiora Max Activity Key", {"Is Latest Activity"}, {"Is Latest Activity"}),
				    #"Replaced Value" = Table.ReplaceValue(#"Expanded Fact Tangata Whaiora Max Activity Key",null,false,Replacer.ReplaceValue,{"Is Latest Activity"}),
				    #"Filtered Rows" = Table.SelectRows(#"Replaced Value", each ([DWH Dml Operation] <> "D")),
				    #"Removed Columns" = Table.RemoveColumns(#"Filtered Rows",{"DWH Source System", "DWH Dml Operation"}),
				     // New step to add and convert date key columns
				    #"Added and Converted Date Columns" = List.Accumulate(
				        List.Select(Table.ColumnNames(#"Removed Columns"), each Text.EndsWith(_, " Date KEY")),
				        #"Removed Columns",
				        (state, columnName) =>
				            Table.AddColumn(
				                state,
				                Text.BeforeDelimiter(columnName, " KEY"),
				                each
				                    if Record.Field(_, columnName) <> null then
				                        let
				                            dateValue = Text.From(Record.Field(_, columnName)),
				                            yearPart = Text.Start(dateValue, 4),
				                            monthPart = Text.Middle(dateValue, 4, 2),
				                            dayPart = Text.End(dateValue, 2),
				                            formattedDate = yearPart & "-" & monthPart & "-" & dayPart
				                        in
				                            if Text.Length(dateValue) = 8 then
				                                Date.FromText(formattedDate)
				                            else
				                                null
				                    else
				                        null,
				                type date
				            )
				    ),
				    #"Merged Queries1" = Table.NestedJoin(#"Added and Converted Date Columns", {"Dim Tangata Whaiora Referral KEY"}, #"Fact Tangata Whaiora Referral", {"Dim Tangata Whaiora Referral KEY"}, "Fact Tangata Whaiora Referral", JoinKind.LeftOuter),
				    #"Expanded Fact Tangata Whaiora Referral" = Table.ExpandTableColumn(#"Merged Queries1", "Fact Tangata Whaiora Referral", {"Tangata Whaiora Referral Discharge Date", "Tangata Whaiora Referral Accepted Date"}, {"Tangata Whaiora Referral Discharge Date", "Tangata Whaiora Referral Accepted Date"})
				in
				    #"Expanded Fact Tangata Whaiora Referral"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

