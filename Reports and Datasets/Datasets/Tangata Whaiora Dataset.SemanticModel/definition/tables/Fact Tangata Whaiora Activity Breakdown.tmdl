	column 'Data Quality Error Exists for Activity' = ```
			
			IF(
			    NOT(ISBLANK('Fact Tangata Whaiora Activity Breakdown'[Tangata Whaiora Referral Discharge Date])),
			        IF(
			            'Fact Tangata Whaiora Activity Breakdown'[Tangata Whaiora Activity Start Date] < 'Fact Tangata Whaiora Activity Breakdown'[Tangata Whaiora Referral Accepted Date]
			            || 
			            'Fact Tangata Whaiora Activity Breakdown'[Tangata Whaiora Activity Start Date] > 'Fact Tangata Whaiora Activity Breakdown'[Tangata Whaiora Referral Discharge Date]
			            ||
			            'Fact Tangata Whaiora Activity Breakdown'[Tangata Whaiora Activity End Date] < 'Fact Tangata Whaiora Activity Breakdown'[Tangata Whaiora Referral Accepted Date]
			            ||
			            'Fact Tangata Whaiora Activity Breakdown'[Tangata Whaiora Activity End Date] > 'Fact Tangata Whaiora Activity Breakdown'[Tangata Whaiora Referral Discharge Date]
			            ,
			            1,
			            0
			        ),
			                IF(
			            'Fact Tangata Whaiora Activity Breakdown'[Tangata Whaiora Activity Start Date] < 'Fact Tangata Whaiora Activity Breakdown'[Tangata Whaiora Referral Accepted Date]
			            ||
			            'Fact Tangata Whaiora Activity Breakdown'[Tangata Whaiora Activity End Date] < 'Fact Tangata Whaiora Activity Breakdown'[Tangata Whaiora Referral Accepted Date]
			            ,
			            1,
			            0
			        )
			)
			```
