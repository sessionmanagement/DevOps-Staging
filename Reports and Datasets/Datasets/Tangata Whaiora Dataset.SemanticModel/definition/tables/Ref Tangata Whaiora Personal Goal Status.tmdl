				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            // Rename 'DWHSourceSystem' to 'DWH Source System'
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            // Capitalize the first letter of each word for uniformity
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            // Fully capitalize 'ID'
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            // Fully capitalize 'KEY'
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            // Fully capitalize 'DWH'
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            // Return the transformed column name
				            capitaliseDWH,
				    // Apply the naming conventions to all column names in the table
				    #"Transformed Column Names" = Table.TransformColumnNames(edw_dim_client_personal_goal_status, each ApplyNamingConventions(_)),
