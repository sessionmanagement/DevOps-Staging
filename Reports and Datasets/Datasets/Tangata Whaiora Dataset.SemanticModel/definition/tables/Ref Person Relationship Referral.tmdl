rsonRelationshipCreatedDate] DESC#(lf)      ) as [ReferralUserSequence]#(lf)  FROM [RBMNB].[dlFactPersonRelationship] pr#(lf)  join [RBMNB].[dlDimRelationshipType] rt#(lf)  on pr.RelationshipTypeID = rt.RelationshipTypeID#(lf)  join [RBMNB].[dlDimUser] u#(lf)  on pr.UserID = u.UserID"]),
