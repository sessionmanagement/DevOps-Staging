	partition 'Fact Tangata Whaiora Referral' = m
		mode: import
		queryGroup: 'Fact Tables'
		source = ```
				let
				    Source = Sql.Database(Server, Database),
				    edw_fact_client_referral = Source{[Schema="edw",Item="vw_fact_client_referral"]}[Data],
				    #"Reduce Rows" = if #"Top N Rows" <> "All" then Table.FirstN(edw_fact_client_referral, Number.FromText(#"Top N Rows")) else edw_fact_client_referral,
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transform Column Names" = Table.TransformColumnNames(#"Reduce Rows", each ApplyNamingConventions(_)),
				    #"Added Age Column" = Table.AddColumn(#"Transform Column Names", "Referral Age", each let
				                CreatedDate = #date(
				                    Number.RoundDown([Tangata Whaiora Referral Received Date KEY] / 10000),
				                    Number.RoundDown(Number.Mod([Tangata Whaiora Referral Received Date KEY], 10000) / 100),
				                    Number.Mod([Tangata Whaiora Referral Received Date KEY], 100)
				                ),
				                DischargeDate = if [Tangata Whaiora Referral Discharge Date KEY] = null 
				                                then Date.From(DateTime.LocalNow()) 
				                                else #date(
				                                        Number.RoundDown([Tangata Whaiora Referral Discharge Date KEY] / 10000),
				                                        Number.RoundDown(Number.Mod([Tangata Whaiora Referral Discharge Date KEY], 10000) / 100),
				                                        Number.Mod([Tangata Whaiora Referral Discharge Date KEY], 100)
				                                     ),
				                AgeInDays = Duration.Days(DischargeDate - CreatedDate)
				            in
				                AgeInDays),
				    #"Merged Queries" = Table.NestedJoin(#"Added Age Column", {"Fact Tangata Whaiora Referral KEY", "Dim Company KEY", "Dim Tangata Whaiora KEY"}, #"Fact Tangata Whaiora Max Referral KEY", {"Fact Tangata Whaiora Referral KEY", "Dim Company KEY", "Dim Tangata Whaiora KEY"}, "Fact Tangata Whaiora Max Referral KEY", JoinKind.LeftOuter),
				    #"Expanded Fact Tangata Whaiora Max Referral KEY" = Table.ExpandTableColumn(#"Merged Queries", "Fact Tangata Whaiora Max Referral KEY", {"Is Latest Referral"}, {"Is Latest Referral"}),
				    #"Replaced Value" = Table.ReplaceValue(#"Expanded Fact Tangata Whaiora Max Referral KEY",null,false,Replacer.ReplaceValue,{"Is Latest Referral"}),
				    #"Filtered Rows" = Table.SelectRows(#"Replaced Value", each ([Is Latest Referral] = true) and ([DWH Dml Operation] <> "D")),
				    #"Removed Columns" = Table.RemoveColumns(#"Filtered Rows",{"DWH Source System", "DWH Dml Operation"}),
				    #"Reordered Columns" = Table.ReorderColumns(#"Removed Columns",{"Fact Tangata Whaiora Referral KEY", "Fact Tangata Whaiora Referral Unique KEY", "Dim Company KEY", "Dim Employee KEY", "Dim Tangata Whaiora KEY", "Dim Tangata Whaiora Referral KEY", "Dim Tangata Whaiora Team KEY", "Dim Service KEY", "Tangata Whaiora ID", "Tangata Whaiora Referral ID", "Tangata Whaiora Referral Responsible User ID", "User Employee Number", "Tangata Whaiora Team ID", "Tangata Whaiora Referral Person Relationship Start Date KEY", "Tangata Whaiora Referral Person Relationship End Date KEY", "Tangata Whaiora Referral Received Date KEY", "Tangata Whaiora Referral Created Date KEY", "Tangata Whaiora Referral End Date KEY", "Tangata Whaiora Referral Discharge Date KEY", "Tangata Whaiora Referral Accepted Date KEY", "Tangata Whaiora Referral Waitlist Date KEY", "Tangata Whaiora Referral Decline Date KEY", "Tangata Whaiora Referral Bed Nights", "Tangata Whaiora Referral Hospital Nights", "Tangata Whaiora Referral Absence", "Referral Age", "Is Latest Referral", "DWH Batch ID", "DWH Modified On", "DWH Created At"}),
				     // New step to add and convert date key columns
				    #"Added and Converted Date Columns" = List.Accumulate(
				        List.Select(Table.ColumnNames(#"Reordered Columns"), each Text.EndsWith(_, " Date KEY")),
				        #"Reordered Columns",
				        (state, columnName) =>
				            Table.AddColumn(
				                state,
				                Text.BeforeDelimiter(columnName, " KEY"),
				                each
				                    if Record.Field(_, columnName) <> null then
				                        let
				                            dateValue = Text.From(Record.Field(_, columnName)),
				                            yearPart = Text.Start(dateValue, 4),
				                            monthPart = Text.Middle(dateValue, 4, 2),
				                            dayPart = Text.End(dateValue, 2),
				                            formattedDate = yearPart & "-" & monthPart & "-" & dayPart
				                        in
				                            if Text.Length(dateValue) = 8 then
				                                Date.FromText(formattedDate)
				                            else
				                                null
				                    else
				                        null,
				                type date
				            )
				    ),
				    #"Renamed Columns" = Table.RenameColumns(#"Added and Converted Date Columns",{{"Is Latest Referral", "Is Latest Referral Action"}}),
				    #"Added Custom" = Table.AddColumn(#"Renamed Columns", "Ref Tangata Whaiora Unique KEY", each Text.Combine({Text.From([Tangata Whaiora ID], "en-NZ"), "-", Text.From([Dim Company KEY], "en-NZ")})),
				    #"Inserted Merged Column" = Table.AddColumn(#"Added Custom", "Ref Tangata Whaiora Relationsip KEY", each Text.Combine({Text.From([Tangata Whaiora ID], "en-NZ"), "-", Text.From([Dim Company KEY], "en-NZ"), "-", Text.From([Tangata Whaiora Referral ID], "en-NZ")}))
				in
				    #"Inserted Merged Column"
				```

	annotation PBI_ResultType = Table

