	column 'Days Between Referral Received and Referral Accepted Date' =
			
			DATEDIFF(
			    RELATED('Dim TW Referral Received Date'[Referral Received Calendar Date]),
			    RELATED('Dim TW Referral Accepted Date'[Referral Accepted Calendar Date]),
