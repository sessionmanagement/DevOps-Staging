	partition 'Dim TW Referral Person Relationdhip Start Date' = m
		mode: import
		queryGroup: 'Role Playing Date Tables'
		source =
				let
				    Source = #"Dim TW Activity Date",
				
				    // Custom function to rename columns
				    renameColumns = (columnName as text) as text =>
				        let
				            newName = if Text.Contains(columnName, "Activity") then Text.Replace(columnName, "Activity", "Referral Person Relationship Start") else columnName
				        in
				            newName,
				
				    // Transform column names using the custom function
				    RenamedColumns = Table.TransformColumnNames(Source, renameColumns)
				in
				    RenamedColumns

	annotation PBI_ResultType = Table

