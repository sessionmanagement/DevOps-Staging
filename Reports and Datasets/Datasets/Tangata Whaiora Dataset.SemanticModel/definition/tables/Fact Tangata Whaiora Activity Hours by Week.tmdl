	column MoreThan4HoursInWeek =
			
			IF(
			    'Fact Tangata Whaiora Activity Hours by Week'[Hours in Week] >= 4,
			    "4 hours or more",
			    "Less than 4 hours"
			)
		lineageTag: 6c4cd020-36f9-417f-b5ca-8296934554bb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'Fact Tangata Whaiora Activity Hours by Week' = calculated
		mode: import
		source =
				
				// This may need to be done in SQL to avoid missing clients with no records in activity breakdown for a week.
				SUMMARIZECOLUMNS(
				    'Dim Tangata Whaiora'[Dim Tangata Whaiora KEY],
				    'Fact Tangata Whaiora Activity Breakdown'[Dim Tangata Whaiora Referral Key],
				    'Fact Tangata Whaiora Activity Breakdown'[Dim Tangata Whaiora Team Key],
				    'Fact Tangata Whaiora Activity Breakdown'[RelatedWeek],
				    'Fact Tangata Whaiora Activity Breakdown'[RelatedWeekStartDate],
				    'Fact Tangata Whaiora Activity Breakdown'[RelatedWeekEndDate],
				    'Fact Tangata Whaiora Activity Breakdown'[RelatedYear],
				    "Hours in Week",
				    CALCULATE(
				        SUM('Fact Tangata Whaiora Activity Breakdown'[Tangata Whaiora Activity Duration])/60,
				        'Fact Tangata Whaiora Activity Breakdown'[Tangata Whaiora Activity Classification Code] <> "T35"
				))

	annotation PBI_Id = ab7557e791514e3ba98abd9aa41807c9

