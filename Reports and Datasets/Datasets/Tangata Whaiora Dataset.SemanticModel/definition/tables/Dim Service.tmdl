	partition 'Dim Service' = m
		mode: import
		queryGroup: 'Dim Tables'
		source =
				let
				    Source = Sql.Database(Server, Database),
				    edw_dim_service = Source{[Schema="edw",Item="vw_dim_service"]}[Data],
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transformed Column Names" = Table.TransformColumnNames(edw_dim_service, each ApplyNamingConventions(_)),
				    #"Replaced Value" = Table.ReplaceValue(#"Transformed Column Names","N/A","Unknown",Replacer.ReplaceText,{"Company Name"}),
				    #"Replaced Value1" = Table.ReplaceValue(#"Replaced Value","N/A","Unknown",Replacer.ReplaceText,{"Dim Service Unique KEY"}),
				    #"Replaced Value2" = Table.ReplaceValue(#"Replaced Value1","N/A","Unknown",Replacer.ReplaceText,{"Service Code"}),
				    #"Replaced Value3" = Table.ReplaceValue(#"Replaced Value2","N/A","Unknown",Replacer.ReplaceText,{"Service Name"}),
				    #"Replaced Value4" = Table.ReplaceValue(#"Replaced Value3","N/A","Unknown",Replacer.ReplaceText,{"Intellihr Service ID"}),
				    #"Replaced Value5" = Table.ReplaceValue(#"Replaced Value4","N/A","Unknown",Replacer.ReplaceText,{"Datapay Service ID"}),
				    #"Replaced Value6" = Table.ReplaceValue(#"Replaced Value5","N/A","Unknown",Replacer.ReplaceText,{"Service Type Code"}),
				    #"Replaced Value7" = Table.ReplaceValue(#"Replaced Value6","N/A","Unknown",Replacer.ReplaceText,{"Service Type Name"}),
				    #"Replaced Value8" = Table.ReplaceValue(#"Replaced Value7","N/A","Unknown",Replacer.ReplaceText,{"Department Code"}),
				    #"Replaced Value9" = Table.ReplaceValue(#"Replaced Value8","N/A","Unknown",Replacer.ReplaceText,{"Department Name"}),
				    #"Replaced Value10" = Table.ReplaceValue(#"Replaced Value9","N/A","Unknown",Replacer.ReplaceText,{"District Code"}),
				    #"Replaced Value11" = Table.ReplaceValue(#"Replaced Value10","N/A","Unknown",Replacer.ReplaceText,{"District Name"}),
				    #"Replaced Value12" = Table.ReplaceValue(#"Replaced Value11","N/A","Unknown",Replacer.ReplaceText,{"Region Code"}),
				    #"Replaced Value13" = Table.ReplaceValue(#"Replaced Value12","N/A","Unknown",Replacer.ReplaceText,{"Region Name"}),
				    #"Replaced Value14" = Table.ReplaceValue(#"Replaced Value13","N/A","Unknown",Replacer.ReplaceText,{"Location Code"}),
				    #"Replaced Value15" = Table.ReplaceValue(#"Replaced Value14","N/A","Unknown",Replacer.ReplaceText,{"Location Name"}),
				    #"Replaced Value16" = Table.ReplaceValue(#"Replaced Value15","N/A","Unknown",Replacer.ReplaceText,{"Finance Funder Code"}),
				    #"Replaced Value17" = Table.ReplaceValue(#"Replaced Value16","N/A","Unknown",Replacer.ReplaceText,{"Finance Funder Name"}),
				    #"Replaced Value18" = Table.ReplaceValue(#"Replaced Value17","N/A","Unknown",Replacer.ReplaceText,{"Finance Funding Agency Code"}),
				    #"Replaced Value19" = Table.ReplaceValue(#"Replaced Value18","N/A","Unknown",Replacer.ReplaceText,{"Finance Funding Agency Name"}),
				    #"Replaced Value20" = Table.ReplaceValue(#"Replaced Value19","N/A","Unknown",Replacer.ReplaceText,{"Finance Budget Holder Code"}),
