	partition 'Fact Tangata Whaiora Referral _Explosion (Unpivoted)' = m
		mode: import
		queryGroup: 'Fact Tables\Unpivoted Fact Tables'
		source =
				let
				    Source = #"Fact Tangata Whaiora Referral (Unpivoted)",
				    #"Duplicated Column" = Table.DuplicateColumn(Source, "Statusstartdate", "Statusstartdate - Copy"),
				    #"Duplicated Column1" = Table.DuplicateColumn(#"Duplicated Column", "Statusenddate", "Statusenddate - Copy"),
				    #"Renamed Columns" = Table.RenameColumns(
				        #"Duplicated Column1",
				        {{"Statusstartdate - Copy", "Status Start Date"}, {"Statusenddate - Copy", "Status End Date"}}
				    ),
				    #"Changed Type" = Table.TransformColumnTypes(
				        #"Renamed Columns", {{"Statusstartdate", Int64.Type}, {"Statusenddate", Int64.Type}}
				    ),
				    #"Buffered Table" = Table.Buffer(#"Changed Type"),
				    referenceDate = Date.StartOfYear(Date.AddYears(Date.From(DateTime.LocalNow()), -4)),
				    #"Added Custom5" = Table.AddColumn(
				        #"Buffered Table",
				        "Explosion",
				        each
				            if [Status Start Date] >= referenceDate then
				                if [Status] <> "Accepted" and [Status] <> "Discharged" and [Status] <> "Declined" then
				                    {[Statusstartdate].. [Statusenddate]}
				                else
				                    {}
				            else
				                {[Status Start Date]}
				    ),
				    #"Expanded Explosion" = Table.ExpandListColumn(#"Added Custom5", "Explosion"),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Expanded Explosion", {{"Explosion", type date}}),
