table 'Ref Tangata Whaiora Flag Summary'
	lineageTag: e916d9f7-f295-4297-afa1-4c1af1a287a2

	measure 'Total Missing Fields' =
			
			CALCULATE (
			    SUM ( 'Ref Tangata Whaiora Flag Summary'[Missing] ),
			    ALLEXCEPT (
			        'Ref Tangata Whaiora Flag Summary',
			        'Ref Tangata Whaiora Flag Summary'[Field]
			    )
			)
		lineageTag: 1052fd8f-3a6e-4a9b-958e-e4a1b6079647

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Non Missing Fields' =
			
			[Total Fields Count] - [Total Missing Fields]
		lineageTag: fd187bfc-6dd9-4e72-8e97-530aea5a4ca9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top 5 Least Complete Fields' =
			
			IF (
			    RANKX (
			        ALL ( 'Ref Tangata Whaiora Flag Summary'[Field] ),
			        [Total Missing Fields],
			        ,
			        DESC,
			        DENSE
			    ) <= 5,
			    [Total Missing Fields],
			    BLANK ()
			)
		lineageTag: 11a8c49e-fe96-4df0-ad38-dc7856f8bea9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top5 Most Complete Fields' =
			
			IF (
			    RANKX (
			        ALL ( 'Ref Tangata Whaiora Flag Summary'[Field] ),
			        [Total Non Missing Fields],
			        ,
			        DESC,
			        DENSE
			    ) <= 5,
			    [Total Non Missing Fields],
			    BLANK ()
			)
		lineageTag: 12089c87-f2f0-4fc9-a411-3866f416d9b4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Fields Count' =
			
			CALCULATE (
			    COUNTROWS ( 'Ref Tangata Whaiora Flag Summary' ),
			    ALLEXCEPT (
			        'Ref Tangata Whaiora Flag Summary',
			        'Ref Tangata Whaiora Flag Summary'[Field]
			    )
			)
		formatString: 0
		lineageTag: 5dafbbeb-7993-49a2-a1b4-cdb24203475a

	measure 'Percent Missing Fields' =
			
			DIVIDE ( [Total Missing Fields], [Total Fields Count], 0 )
		formatString: 0%;-0%;0%
		lineageTag: 73bfa5e2-d2d2-45ae-85a4-c5dfa02cd6eb

	measure 'Percent Non Missing Fields' =
			
			CALCULATE (
			    IF (
			        RIGHT (
			            MAX ( 'Ref Tangata Whaiora Flag Summary'[Ref Tangata Whaiora Unique KEY] ),
			            2
			        ) = "-5"
			            && VALUES ( 'Ref Tangata Whaiora Flag Summary'[Field] )
			                IN {
			                    "Legal Status",
			                    "Mental Health Condition",
			                    "Physical Condition",
			                    "Substance Use"
			                },
			        0,
			        DIVIDE ( [Total Non Missing Fields], [Total Fields Count], 0 )
			    )
			)
		formatString: 0%;-0%;0%
		lineageTag: ddbc3e62-b3cd-411e-ad33-e12970300f1a

	measure 'Top 5 Least Complete Fields Percent' =
			
			IF (
			    RANKX (
			        ALL ( 'Ref Tangata Whaiora Flag Summary'[Field] ),
			        [Percent Missing Fields],
			        ,
			        DESC,
			        DENSE
			    ) <= 5,
			    [Percent Missing Fields],
			    BLANK ()
			)
		formatString: 0%;-0%;0%
		lineageTag: 4a04fe63-1e78-4427-b8f7-a5c865bc1cbe

	measure 'Top 5 Most Complete Fields Percent' =
			
			IF (
			    RANKX (
			        ALL ( 'Ref Tangata Whaiora Flag Summary'[Field] ),
			        [Percent Non Missing Fields],
			        ,
			        DESC,
			        DENSE
			    ) <= 5,
			    [Percent Non Missing Fields],
			    BLANK ()
			)
		formatString: 0%;-0%;0%
		lineageTag: b0bf64ec-42af-4e94-a30e-42175a09d8a4

	measure 'Rank Percent Missing Fields' =
			
			RANKX (
			    ALL ( 'Ref Tangata Whaiora Flag Summary'[Field] ),
			    [Percent Missing Fields],
			    ,
			    DESC,
			    DENSE
			)
		formatString: 0%;-0%;0%
		lineageTag: 56f22179-7449-4bd3-a644-e410c2d34192

	measure 'Rank Percent Non Missing Fields' =
			
			RANKX (
			    ALL ( 'Ref Tangata Whaiora Flag Summary'[Field] ),
			    [Percent Non Missing Fields],
			    ,
			    DESC,
			    DENSE
			)
		formatString: 0%;-0%;0%
		lineageTag: 1faa3a39-210d-4ee0-a35d-d2f511b20fc4

	measure 'Combined Top 5 Fields Percent' =
			
			VAR CurrentField =
			    SELECTEDVALUE ( 'Ref Tangata Whaiora Flag Summary'[Field] )
			VAR MissingRank = [Rank Percent Missing Fields]
			VAR NonMissingRank = [Rank Percent Non Missing Fields]
			RETURN
			    IF (
			        MissingRank <= 5,
			        - [Percent Missing Fields],
			        -- Negative value for missing to distinguish visually
			        IF (
			            NonMissingRank <= 5,
			            [Percent Non Missing Fields],
			            BLANK ()
			        )
			    )
		formatString: 0%;-0%;0%
		lineageTag: 9fb975f1-836d-4181-ad59-c27c657294ca

	measure 'Combined Fields Percent' =
			
			VAR CurrentField =
			    SELECTEDVALUE ( 'Ref Tangata Whaiora Flag Summary'[Field] )
			VAR NonMissing = [Percent Non Missing Fields]
			VAR Missing = [Percent Missing Fields]
			RETURN
			    IF ( NonMissing >= 0.5, NonMissing, - NonMissing )
		formatString: 0%;-0%;0%
		lineageTag: a1e2ac10-1f51-486a-9007-76df0819ebc8

