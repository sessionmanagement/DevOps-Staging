e_current_status#(lf)--,#employee_hierarchy.hierarchy_number_1#(lf),#employee_hierarchy.hierarchy_number#(lf),#employee_hierarchy.company_field#(lf),#ServicesEDW.service_name#(lf), #ServicesEDW.service_id#(lf), #ServicesEDW.dim_service_key#(lf), #ServicesEDW.dim_company_key#(lf)---=====hard coding  - there is no other way as district = default which is as useful as....#(lf),CASE WHEN employee_id = 601556 THEN #(lf)'HD Easeup Services'#(lf)ELSE #(lf)#ServicesEDW.district_name#(lf)END AS district_name#(lf)---==========================#(lf)#(lf),#ServicesEDW.department_name#(lf),#ServicesEDW.region_name#(lf),#ServicesEDW.company#(lf) INTO #HierarchywithServices_0#(lf) FROM #employee_hierarchy LEFT JOIN #ServicesEDW ON employee_Business_unit_name COLLATE Latin1_General_CI_AI = service_name COLLATE Latin1_General_CI_AI#(lf)   AND #employee_hierarchy.company_field COLLATE Latin1_General_CI_AI = #ServicesEDW.company COLLATE Latin1_General_CI_AI#(lf)#(lf)--======================cost allocations#(lf)SELECT #(lf)employee_number#(lf),displayName#(lf),dim_employee_key#(lf),email_address#(lf),job_title #(lf),datapay_cost_center_name#(lf),intellihr_business_unit_name#(lf),person_is_supervisor#(lf),#servicesedw.service_name#(lf) , #servicesedw.service_id#(lf) , #servicesedw.dim_service_key#(lf) , #servicesedw.dim_company_key#(lf),#servicesedw.region_name#(lf),#servicesedw.district_name#(lf),#ServicesEDW.department_name#(lf),CASE WHEN email_address LIKE '%mind%body%' THEN 'Mind and Body'#(lf)ELSE 'Emerge'#(lf)END AS Company#(lf),employee_job_name#(lf)INTO #CostAllocations#(lf)FROM [landing].[row_level_security_cost_allocations]#(lf)LEFT JOIN #ServicesEDW ON row_level_security_cost_allocations.intellihr_business_unit_name COLLATE Latin1_General_CI_AI = #servicesedw.service_name COLLATE Latin1_General_CI_AI#(lf)LEFT JOIN edw.dim_employee ON row_level_security_cost_allocations.employee_number = dim_employee.employee_id#(lf)AND dim_employee.DWHIsCurrent = 1 #(lf)--========#(lf)#(lf)--========================================#(lf)-- CEO stuff#(lf)#(lf)select * into #HierarchyLevel1CrossJoin from #HierarchywithServices_0 where hierarchy_number = 1;#(lf)#(lf)UPDATE #HierarchyLevel1CrossJoin#(lf)SET hierarchy_number = 7;#(lf)#(lf)SELECT #(lf)    h.dim_employee_hierarchy_key,#(lf)    h.dim_employee_key,#(lf)    h.employee_id,#(lf)    h.employee_primary_email_address,#(lf)    h.employee_company_name,#(lf)    h.employee_Business_unit_name,#(lf)    h.employee_displayname,#(lf)    h.employee_people_leader_email_level_1,#(lf)    h.employee_people_leader_business_unit_name_level_1,#(lf)    h.employee_people_leader_business_unit_name_level_2,#(lf)    h.employee_people_leader_business_unit_name_level_3,#(lf)    h.employee_people_leader_business_unit_name_level_4,#(lf)    h.employee_people_leader_business_unit_name_level_5,#(lf)    h.employee_people_leader_business_unit_name_level_6,#(lf)    h.employee_people_leader_business_unit_name_level_7,#(lf)    h.employee_people_leader_business_unit_name_level_8,#(lf)    h.employee_people_leader_business_unit_name_level_9,#(lf)    h.hierarchy_number_0,#(lf)    h.employee_employment_status,#(lf)    h.employee_job_name,#(lf)    h.employee_current_status,#(lf)    h.hierarchy_number,#(lf)    h.company_field,#(lf)    s.service_name,#(lf)    s.service_id,#(lf)    s.dim_service_key,#(lf)    s.dim_company_key,#(lf)    s.district_name,#(lf)    s.department_name,#(lf)    s.region_name,#(lf)    s.company--,#(lf)   -- s.is_inactive,#(lf)    --s.service_code#(lf)#(tab)INTO #HierarchyLevel1CrossJoinResult#(lf)FROM #HierarchyLevel1CrossJoin h#(lf)CROSS JOIN #ServicesEDW s#(lf)#(lf)--drop table #HierarchyLevel1CrossJoinResult#(lf)#(lf)--insert into #HierarchywithServices select * from #HierarchyLevel1CrossJoinResult#(lf)#(lf)select *#(lf)into #hierarchywithservices#(lf)from #HierarchywithServices_0#(lf)union #(lf)select * from #HierarchyLevel1CrossJoinResult#(lf)#(lf)#(lf)--select * from #hierarchywithservices#(lf)--where employee_primary_email_address like 'elizabeth.ting%'#(lf)#(lf)---=========================================================================#(lf) SELECT * #(lf) INTO #level_1_AllStaff#(lf) FROM  #hierarchywithservices#(lf) WHERE employee_employment_status COLLATE Latin1_General_CI_AI IN ('Current Staff' COLLATE Latin1_General_CI_AI, 'Exiting Staff' COLLATE Latin1_General_CI_AI) AND -- MG: Added Exiting Staff#(lf) hierarchy_number = 1#(lf)#(lf)  #(lf) --Executive Managers#(lf) SELECT * #(lf) INTO #level_2_AllStaff#(lf) FROM  #hierarchywithservices#(lf) WHERE employee_employment_status COLLATE Latin1_General_CI_AI IN ('Current Staff' COLLATE Latin1_General_CI_AI, 'Exiting Staff' COLLATE Latin1_General_CI_AI) AND -- MG: Added Exiting Staff#(lf) hierarchy_number = 2#(lf) #(lf) --=======Senior Managers#(lf) SELECT *#(lf) INTO #level_3_AllStaff#(lf) FROM  #hierarchywithservices#(lf) WHERE employee_employment_status COLLATE Latin1_General_CI_AI IN ('Current Staff' COLLATE Latin1_General_CI_AI, 'Exiting Staff' COLLATE Latin1_General_CI_AI) AND -- MG: Added Exiting Staff#(lf) hierarchy_number = 3#(lf) #(lf) --=====Regional Managers and their equivalent#(lf) SELECT * #(lf) INTO #level_4_AllStaff#(lf) FROM  #HierarchywithServices#(lf) WHERE employee_employment_status COLLATE Latin1_General_CI_AI IN ('Current Staff' COLLATE Latin1_General_CI_AI, 'Exiting Staff' COLLATE Latin1_General_CI_AI) AND -- MG: Added Exiting Staff#(lf) hierarchy_number = 4#(lf) union #(lf) select #(lf) 0 as dim_employee_hierarchy_key,#(lf) dim_employee_key,#(lf) employee_number as employee_id,#(lf) email_address as employee_primary_email_address,#(lf) company as employee_company_name,#(lf) datapay_cost_center_name as employee_business_unit_name,#(lf)displayName as employee_displayName,#(lf)'' as PLEmail1,#(lf)'' as PLBU1,#(lf)'' as PLBU2,#(lf)'' as PLBU3,#(lf)'' as PLBU4,#(lf)'' as PLBU5,#(lf)'' as PLBU6,#(lf)'' as PLBU7,#(lf)'' as PLBU8,#(lf)'' as PLBU9,#(lf)94 as Hierarchy_Number_0,#(lf)'Current Staff' as employee_employmentStatus,#(lf)job_title as employee_job_name,#(lf)1 as employee_current_status,#(lf)4 as hierarchy_number,#(lf)company as company_field,#(lf)service_name ,#(lf)service_id,#(lf)dim_service_key,#(lf)dim_company_key,#(lf)district_name,#(lf)department_name,#(lf)region_name,#(lf)company#(lf) from #CostAllocations#(lf) where job_title in (#(lf)'Housing Operations Manager'#(lf))#(lf)#(lf) --========District Managers and thier Equivalent#(lf) SELECT * #(lf) INTO #level_5_AllStaff #(lf) FROM  #hierarchywithservices#(lf) WHERE employee_employment_status COLLATE Latin1_General_CI_AI IN ('Current Staff' COLLATE Latin1_General_CI_AI, 'Exiting Staff' COLLATE Latin1_General_CI_AI) AND -- MG: Added Exiting Staff#(lf) hierarchy_number = 5#(lf)#(lf) --=======SM's etc who may have BU's different from their own#(lf) SELECT * #(lf) INTO #level_6_AllStaff#(lf) FROM  #hierarchywithservices#(lf) WHERE employee_employment_status COLLATE Latin1_General_CI_AI IN ('Current Staff' COLLATE Latin1_General_CI_AI, 'Exiting Staff' COLLATE Latin1_General_CI_AI) AND -- MG: Added Exiting Staff#(lf) hierarchy_number = 6#(lf) union #(lf) #(lf) select #(lf) #(lf) 0 as dim_employee_hierarchy_key,#(lf) dim_employee_key,#(lf) employee_number as employee_id,#(lf) email_address as employee_primary_email_address,#(lf) company as employee_company_name,#(lf) datapay_cost_center_name as employee_business_unit_name,#(lf)displayName as employee_displayName,#(lf)'' as PLEmail1,#(lf)'' as PLBU1,#(lf)'' as PLBU2,#(lf)'' as PLBU3,#(lf)'' as PLBU4,#(lf)'' as PLBU5,#(lf)'' as PLBU6,#(lf)'' as PLBU7,#(lf)'' as PLBU8,#(lf)'' as PLBU9,#(lf)96 as Hierarchy_Number_0,#(lf)'Current Staff' as employee_employmentStatus,#(lf)job_title as employee_job_name,#(lf)1 as employee_current_status,#(lf)6 as hierarchy_number,#(lf)company as company_field,#(lf)service_name ,#(lf)service_id,#(lf)dim_service_key,#(lf)dim_company_key,#(lf)district_name,#(lf)department_name,#(lf)region_name,#(lf)company#(lf) from #CostAllocations#(lf) where job_title in (#(lf)'Service Manager',#(lf)'Service Manager - Forensics',#(lf)'Team Leader - Housing Services'#(lf))#(lf) --====now lowest level of staff who should not see BU's other than their own#(lf)#(lf)#(lf) SELECT #(lf) *#(lf) INTO #level_7_AllStaff#(lf) FROM  #hierarchywithservices#(lf) WHERE employee_employment_status COLLATE Latin1_General_CI_AI IN ('Current Staff' COLLATE Latin1_General_CI_AI, 'Exiting Staff' COLLATE Latin1_General_CI_AI) AND -- MG: Added Exiting Staff#(lf) hierarchy_number = 7#(lf) union#(lf) select #(lf) #(lf) 0 as dim_employee_hierarchy_key,#(lf) dim_employee_key,#(lf) employee_number as employee_id,#(lf) email_address as employee_primary_email_address,#(lf) company as employee_company_name,#(lf) datapay_cost_center_name as employee_business_unit_name,#(lf)displayName as employee_displayName,#(lf)'' as PLEmail1,#(lf)'' as PLBU1,#(lf)'' as PLBU2,#(lf)'' as PLBU3,#(lf)'' as PLBU4,#(lf)'' as PLBU5,#(lf)'' as PLBU6,#(lf)'' as PLBU7,#(lf)'' as PLBU8,#(lf)'' as PLBU9,#(lf)97 as Hierarchy_Number_0,#(lf)'Current Staff' as employee_employmentStatus,#(lf)job_title as employee_job_name,#(lf)1 as employee_current_status,#(lf)7 as hierarchy_number,#(lf)company as company_field,#(lf)service_name ,#(lf)service_id,#(lf)dim_service_key,#(lf)dim_company_key,#(lf)district_name,#(lf)department_name,#(lf)region_name,#(lf)company#(lf) from #CostAllocations#(lf) where job_title in (#(lf) 'Community Support Worker',#(lf) 'Executive Assistant',#(lf) 'Health Coach',#(lf) 'Housing Services Referral Coordinator',#(lf) 'Learning and Capability Partner',#(lf) 'Mental Health Professional',#(lf) 'Navigator',#(lf) 'Peer Workshop Facilitator',#(lf) 'Practice Advisor',#(lf) 'Social Worker',#(lf) 'Support Worker',#(lf) 'Peer Support/Advocacy Specialist')#(lf)#(lf)#(lf) #(lf) SELECT * #(lf) INTO #noservice#(lf) FROM #HierarchywithServices#(lf) WHERE service_name IS NULL#(lf)#(lf)#(lf)  --==============================#(lf) --=====now we put it all back together.#(lf) --=====this looks like an interesting thing to do, so we're brining in service stuff#(lf)#(lf)  SELECT #(lf) hierarchy_number,#(lf) #ServicesEDW.service_name#(lf) , #servicesedw.service_id#(lf) , #servicesedw.dim_service_key#(lf) , #servicesedw.dim_company_key,#(lf) #ServicesEDW.company,#(lf) #servicesedw.department_name,#(lf) #ServicesEDW.district_name,#(lf) #servicesedw.region_name,#(lf) dim_employee_key,#(lf) employee_id,#(lf) employee_primary_email_address,#(lf) employee_current_status,#(lf) employee_job_name,#(lf) #level_7_AllStaff.company AS levelcompany#(lf) INTO #lowestlevel#(lf) FROM #ServicesEDW#(lf) inner JOIN #level_7_AllStaff ON #servicesedw.service_name COLLATE Latin1_General_CI_AI = #level_7_AllStaff.service_name COLLATE Latin1_General_CI_AI#(lf) WHERE #level_7_AllStaff.company COLLATE Latin1_General_CI_AI =#ServicesEDW.company COLLATE Latin1_General_CI_AI#(lf)----=======and then we have services which bear no resemblance to business unit name#(lf) #(lf) --select * from #level_7_AllStaff#(lf) --where employee_primary_email_address like 'cema%'#(lf)#(lf) --select * from #ServicesEDW#(lf) --where service_name like 'wdhb%awhi ora%'#(lf)#(lf)#(lf)--=====bringing in the cost allocations#(lf)select * #(lf)into #Levels6_7_0#(lf)from #lowestlevel  --===so we're taking all the lowest level people here.#(lf)union #(lf)select #(lf)distinct -- you have to have a service manager here, some people like Vicky Power don't and go straight to district Manager#(lf) #level_6_AllStaff.hierarchy_number,#(lf)   #lowestLevel.service_name#(lf) , #lowestLevel.service_id#(lf) , #lowestLevel.dim_service_key#(lf) , #lowestLevel.dim_company_key#(lf) , #lowestlevel.company#(lf) , #lowestlevel.department_name#(lf) , #lowestlevel.district_name#(lf) , #lowestlevel.region_name#(lf) ,#level_6_allstaff.dim_employee_key#(lf) ,#level_6_allstaff.employee_id#(lf) ,#level_6_allstaff.employee_primary_email_address#(lf) ,#level_6_allstaff.employee_current_status#(lf) ,#level_6_allstaff.employee_job_name#(lf) ,#level_6_AllStaff.company AS levelcompany#(lf) from #lowestlevel#(lf) inner join #level_6_AllStaff on #lowestlevel.service_name = #level_6_AllStaff.service_name#(lf)#(tab)and #lowestlevel.levelcompany = #level_6_AllStaff.company#(lf)#(lf)#(lf)--==== if you're missing because there's a mis match, then I take the people hierarchy#(lf)---=== I add in the person's direct report#(lf)select #lowestlevel.*  #(lf)into #missing7#(lf)from #lowestlevel#(lf)left join #level_6_AllStaff#(lf)on #lowestlevel.service_name = #level_6_AllStaff.service_name#(lf)and #lowestlevel.levelcompany = #level_6_AllStaff.company#(lf)where #level_6_AllStaff.service_id is null#(lf)#(lf)#(lf)--==== I'm taking everyone who didn't have a match from level 7 to level 6 here and merging on their direct report and changing#(lf)--==== the data so it fits as the same above#(lf)select #(lf)distinct #(lf) #HierarchywithServices.hierarchy_number#(lf) ,#missing7.employee_primary_email_address#(lf), #missing7.service_name#(lf) , #missing7.service_id#(lf) , #missing7.dim_service_key#(lf) , #missing7.dim_company_key#(lf) , #missing7.company#(lf) , #missing7.department_name#(lf) , #missing7.district_name#(lf) , #missing7.region_name#(lf) ,#peopleleader_email.dim_employee_key#(lf) ,#peopleleader_email.employee_id#(lf) ,#peopleleader_email.people_leader_email#(lf) ,#hierarchywithservices.employee_current_status#(lf) ,#hierarchywithservices.employee_job_name#(lf) ,#hierarchywithservices.company AS levelcompany#(lf) into #PeopleLeaderMissing7_0#(lf)from #missing7#(lf)#(lf)inner join #peopleleader_email on #missing7.employee_primary_email_address = #peopleleader_email.employee_primary_email_address#(lf)and  #missing7.service_name = #peopleleader_email.leaderservice#(lf)inner join #HierarchywithServices on #peopleLeader_Email.People_Leader_Email = #HierarchywithServices.employee_primary_email_address#(lf)union #(lf)select #(lf)distinct #(lf) #HierarchywithServices.hierarchy_number#(lf) ,#missing7.employee_primary_email_address#(lf), #missing7.service_name#(lf) , #missing7.service_id#(lf) , #missing7.dim_service_key#(lf) , #missing7.dim_company_key#(lf) , #missing7.company#(lf) , #missing7.department_name#(lf) , #missing7.district_name#(lf) , #missing7.region_name#(lf)#(lf) ,#peopleleader_email.dim_employee_key#(lf) ,#peopleleader_email.employee_id#(lf) ,#peopleleader_email.people_leader_email#(lf) ,#hierarchywithservices.employee_current_status#(lf) ,#hierarchywithservices.employee_job_name#(lf) ,#hierarchywithservices.company AS levelcompany#(lf) --into #PeopleLeaderMissing7#(lf)from #missing7#(lf)#(lf)inner join #peopleleader_email on #missing7.employee_primary_email_address = #peopleleader_email.employee_primary_email_address#(lf)--and  #missing7.service_name = #peopleleader_email.leaderservice#(lf)inner join #HierarchywithServices on #peopleLeader_Email.People_Leader_Email = #HierarchywithServices.employee_primary_email_address#(lf)#(lf)#(lf)select #(lf)distinct #(lf) hierarchy_number#(lf), service_name#(lf) , service_id#(lf) , dim_service_key#(lf) , dim_company_key#(lf) , company#(lf) , department_name#(lf) , district_name#(lf) , region_name#(lf) , dim_employee_key#(lf) , employee_id#(lf) , people_leader_email#(lf) , employee_current_status#(lf) , employee_job_name#(lf) , levelcompany#(lf) into #PeopleLeaderMissing7#(lf)from #PeopleLeaderMissing7_0#(lf)where employee_primary_email_address not in (select email_address from #CostAllocations)#(lf)#(lf)#(lf)----======== we only want to go from level 7 to level 6, so I'm taking the level 6 reporting leads only...  I'll add the others in later#(lf)--======= probably when I figure out what to do with them!#(lf)select * #(lf)into #levels6_7#(lf)from #Levels6_7_0#(lf)union #(lf)select * from #peopleleadermissing7#(lf)where hierarchy_number = 6 #(lf)#(lf)---==============================okidoki - now we bring in the district managers or their equivalents#(lf)--===== merge on the level5s.#(lf)#(lf)--select * #(lf)--into #Levels6_7_5_0#(lf)--from #lowestlevel  --===so we're taking all the lowest level people here.#(lf)#(lf)select * #(lf) into #levels5_6_7#(lf)from #levels6_7#(lf)union #(lf)select #(lf)distinct -- you have to have a service manager here, some people like Vicky Power don't and go straight to district Manager#(lf) #level_5_AllStaff.hierarchy_number,#(lf)   #levels6_7.service_name#(lf) , #levels6_7.service_id#(lf) , #levels6_7.dim_service_key#(lf) , #levels6_7.dim_company_key#(lf) , #levels6_7.company#(lf) , #levels6_7.department_name#(lf) , #levels6_7.district_name#(lf) , #levels6_7.region_name#(lf) ,#level_5_allstaff.dim_employee_key#(lf) ,#level_5_allstaff.employee_id#(lf) ,#level_5_allstaff.employee_primary_email_address#(lf) ,#level_5_allstaff.employee_current_status#(lf) ,#level_5_allstaff.employee_job_name#(lf) ,#level_5_AllStaff.company AS levelcompany#(lf)#(lf)  from #levels6_7#(lf) inner join #level_5_AllStaff on #levels6_7.district_name = #level_5_AllStaff.district_name#(lf)#(tab)and #levels6_7.levelcompany = #level_5_AllStaff.company_field#(lf)#(tab)and #levels6_7.dim_company_key <> 5#(lf)#(tab)and #levels6_7.district_name not in ('hd clinical operations Manager')#(lf)#(tab)#(lf)union #(lf)select #(lf)distinct -- there's nothing to join the Operations Manager via district or dept etc, so join on job name and district name, ONLY MnB#(lf) #level_5_AllStaff.hierarchy_number,#(lf)   #levels6_7.service_name#(lf) , #levels6_7.service_id#(lf) , #levels6_7.dim_service_key#(lf) , #levels6_7.dim_company_key#(lf) , #levels6_7.company#(lf) , #levels6_7.department_name#(lf) , #levels6_7.district_name#(lf) , #levels6_7.region_name#(lf) ,#level_5_allstaff.dim_employee_key#(lf) ,#level_5_allstaff.employee_id#(lf) ,#level_5_allstaff.employee_primary_email_address#(lf) ,#level_5_allstaff.employee_current_status#(lf) ,#level_5_allstaff.employee_job_name#(lf) ,#level_5_AllStaff.company AS levelcompany#(lf) from #levels6_7#(lf) inner join #level_5_AllStaff on #levels6_7.district_name