expression 'RLS - New RB Structure ALL services' =
		let
		    Source = Sql.Database(Server, Database, [Query="DROP TABLE IF EXISTS #NoDirectReports;#(lf)DROP TABLE IF EXISTS #employee_hierarchy_0;#(lf)DROP TABLE IF EXISTS #employee_hierarchy;#(lf)DROP TABLE IF EXISTS #PeopleLeaders;#(lf)DROP TABLE IF EXISTS #peopleLeader_Email;#(lf)DROP TABLE IF EXISTS #ServicesEDW;#(lf)DROP TABLE IF EXISTS #HierarchywithServices;#(lf)DROP TABLE IF EXISTS #HierarchywithServices_0;#(lf)DROP TABLE IF EXISTS #CostAllocations;#(lf)DROP TABLE IF EXISTS #level_1_AllStaff;#(lf)DROP TABLE IF EXISTS #level_2_AllStaff;#(lf)DROP TABLE IF EXISTS #level_3_AllStaff;#(lf)DROP TABLE IF EXISTS #level_4_AllStaff;#(lf)DROP TABLE IF EXISTS #level_5_AllStaff;#(lf)DROP TABLE IF EXISTS #level_6_AllStaff;#(lf)DROP TABLE IF EXISTS #level_7_AllStaff;#(lf)DROP TABLE IF EXISTS #noservice;#(lf)DROP TABLE IF EXISTS #lowestlevel;#(lf)DROP TABLE IF EXISTS #missing7;#(lf)DROP TABLE IF EXISTS #PeopleLeaderMissing7;#(lf)DROP TABLE IF EXISTS #levels6_7_0;#(lf)DROP TABLE IF EXISTS #levels6_7;#(lf)DROP TABLE IF EXISTS #levels5_6_7;#(lf)DROP TABLE IF EXISTS #levels_4_5_6_7;#(lf)DROP TABLE IF EXISTS #levels_3_4_5_6_7;#(lf)DROP TABLE IF EXISTS #levels_2_3_4_5_6_7;#(lf)DROP TABLE IF EXISTS #final;#(lf)DROP TABLE IF EXISTS #finalfinal;#(lf)DROP TABLE IF EXISTS #Hierarchylevel1crossjoin#(lf)DROP TABLE IF EXISTS #HierarchyLevel1CrossJoinResult;#(lf)DROP TABLE IF EXISTS #PeopleLeaderMissing7_0;#(lf)DROP TABLE IF EXISTS #Client_Teams;#(lf)#(lf)-- First, create a temp table to identify employees who do not have staff reporting to them#(lf)SELECT #(lf)    E.[employee_id]#(lf)INTO #NoDirectReports#(lf)FROM #(lf)    [edw].[dim_employee_hierarchy] AS E#(lf)WHERE #(lf)    E.[DWHIsCurrent] = 1 AND#(lf)#(tab)E.[employee_primary_email_address] IS NOT NULL AND#(lf)    NOT EXISTS (#(lf)        SELECT 1#(lf)        FROM [edw].[dim_employee_hierarchy] AS E2#(lf)        WHERE #(lf)            E2.[employee_id] <> E.[employee_id] AND#(lf)            (#(lf)                E.[employee_primary_email_address] = E2.[employee_people_leader_email_level_1] OR#(lf)                E.[employee_primary_email_address] = E2.[employee_people_leader_email_level_2] OR#(lf)                E.[employee_primary_email_address] = E2.[employee_people_leader_email_level_3] OR#(lf)                E.[employee_primary_email_address] = E2.[employee_people_leader_email_level_4] OR#(lf)                E.[employee_primary_email_address] = E2.[employee_people_leader_email_level_5] OR#(lf)                E.[employee_primary_email_address] = E2.[employee_people_leader_email_level_6] OR#(lf)                E.[employee_primary_email_address] = E2.[employee_people_leader_email_level_7] OR#(lf)                E.[employee_primary_email_address] = E2.[employee_people_leader_email_level_8] OR#(lf)                E.[employee_primary_email_address] = E2.[employee_people_leader_email_level_9]#(lf)            )#(lf)    )#(lf)#(lf)--=============================#(lf)#(lf) --====bringing in services.  Also changing department names so they're consistent#(lf) SELECT #(lf)  service_name#(lf) , service_id#(lf) , dim_service_key#(lf) , dim_company_key#(lf) , district_name#(lf) ,CASE WHEN department_name COLLATE Latin1_General_CI_AI = 'Health and Disability Services' COLLATE Latin1_General_CI_AI THEN 'Health and Disability Management'#(lf)  WHEN department_name COLLATE Latin1_General_CI_AI = 'Health and Disability' COLLATE Latin1_General_CI_AI THEN 'Health and Disability Management'#(lf)  ELSE department_name#(lf)  END AS department_name, #(lf)  region_name ,#(lf)  CASE WHEN dim_company_key = 5 THEN 'Mind and Body'#(lf)  WHEN company_name COLLATE Latin1_General_CI_AI LIKE '%ignite%' COLLATE Latin1_General_CI_AI THEN 'Ignite'#(lf)  ELSE 'Emerge'#(lf)  END AS company ,#(lf)    --===new company#(lf)  is_inactive --===new field #(lf)  ,service_code#(lf) #(lf)  INTO #ServicesEDW#(lf) FROM edw.dim_service#(lf) WHERE DWHIsCurrent = 1 #(lf) and DWHDMLOperation <> 'd'#(lf) AND service_name COLLATE Latin1_General_CI_AI NOT IN ('tauranga mobile' COLLATE Latin1_General_CI_AI) -- Tauranga isn't missing but I want to change it below.  Easier to union than join#(lf) #(lf) --===this is missing#(lf) UNION #(lf) SELECT #(lf)  'Kia Ora Ake' AS service_name#(lf) , '' service_id#(lf) , '' dim_service_key#(lf) , 1 as dim_company_key#(lf) , 'HD Auckland South Mobile' AS district_name #(lf) , 'Health and Disability' AS department_name#(lf) , 'RM Counties Manukau/Auckland'  AS region_name#(lf) , 'Emerge' AS company#(lf) , 0 as is_inactive#(lf) ,'' as service_code#(lf)  UNION #(lf) SELECT #(lf) --====tauranga mobile hasn't been set up properly, just taking the hierarchy from pounamu - mobile.... #(lf)  'Tauranga Mobile' AS service_name#(lf) , '' service_id#(lf) , '' dim_service_key#(lf) , 1 as dim_company_key#(lf) , 'HD Waikato/Lakes' AS district_name #(lf) ,  'Health and Disability' AS department_name#(lf) , 'RM Midland'  AS region_name#(lf) , 'Emerge' AS company#(lf) , 0 as is_inactive#(lf)  ,'' as service_code#(lf)--=============================#(lf)#(lf)#(lf)#(lf)#(lf)SELECT dim_employee_hierarchy.[dim_employee_hierarchy_key]#(lf)      ,dim_employee_hierarchy.[dim_employee_key]#(lf)      ,dim_employee_hierarchy.[employee_id]#(lf)      ,dim_employee_hierarchy.[employee_primary_email_address]#(lf)      ,dim_employee_hierarchy.[employee_company_name]#(lf)      ,[employee_Business_unit_name]#(lf)      ,[employee_displayname]#(lf)      ,[employee_people_leader_email_level_1]#(lf)      ,[employee_people_leader_business_unit_name_level_1]#(lf)      ,[employee_people_leader_business_unit_name_level_2]#(lf)      ,[employee_people_leader_business_unit_name_level_3]#(lf)      ,[employee_people_leader_business_unit_name_level_4]#(lf)      ,[employee_people_leader_business_unit_name_level_5]#(lf)      ,[employee_people_leader_business_unit_name_level_6]#(lf)      ,[employee_people_leader_business_unit_name_level_7]#(lf)      ,[employee_people_leader_business_unit_name_level_8]#(lf)      ,[employee_people_leader_business_unit_name_level_9]#(lf)#(tab)  ,[employee_people_leader_person_display_name_level_1]#(lf)      ,[employee_people_leader_person_display_name_level_2]#(lf)      ,[employee_people_leader_person_display_name_level_3]#(lf)      ,[employee_people_leader_person_display_name_level_4]#(lf)      ,[employee_people_leader_person_display_name_level_5]#(lf)      ,[employee_people_leader_person_display_name_level_6]#(lf)      ,[employee_people_leader_person_display_name_level_7]#(lf)      ,[employee_people_leader_person_display_name_level_8]#(lf)      ,[employee_people_leader_person_display_name_level_9]#(lf)   #(tab)  ,CASE#(lf)        WHEN NDR.employee_id IS NOT NULL THEN 6#(lf)        ELSE#(lf)            CASE#(lf)                WHEN employee_people_leader_business_unit_name_level_9 IS NOT NULL AND #(lf)                    employee_people_leader_business_unit_name_level_8 IS NOT NULL AND  #(lf)                    employee_people_leader_business_unit_name_level_9 COLLATE Latin1_General_CI_AI = employee_people_leader_business_unit_name_level_8 COLLATE Latin1_General_CI_AI AND #(lf)                    employee_people_leader_business_unit_name_level_8 COLLATE Latin1_General_CI_AI <> employee_people_leader_business_unit_name_level_7 COLLATE Latin1_General_CI_AI#(lf)                    THEN 8#(lf)                WHEN employee_job_name COLLATE Latin1_General_CI_AI = 'cleaner' COLLATE Latin1_General_CI_AI #(lf)                    THEN 8#(lf)                WHEN employee_people_leader_business_unit_name_level_9 IS NULL AND #(lf)                    employee_people_leader_business_unit_name_level_8 IS NOT NULL #(lf)                    THEN 8#(lf)                WHEN employee_people_leader_business_unit_name_level_8 IS NULL AND #(lf)                    employee_people_leader_business_unit_name_level_7 IS NOT NULL #(lf)                    THEN 7#(lf)                WHEN employee_people_leader_business_unit_name_level_7 IS NULL AND #(lf)                    employee_people_leader_business_unit_name_level_6 IS NOT NULL #(lf)                    THEN 6#(lf)                WHEN employee_people_leader_business_unit_name_level_6 IS NULL AND#(lf)                    employee_people_leader_business_unit_name_level_5 IS NOT NULL #(lf)                    THEN 5#(lf)                WHEN employee_people_leader_business_unit_name_level_5 IS NULL AND#(lf)                    employee_people_leader_business_unit_name_level_4 IS NOT NULL #(lf)                    THEN 4#(lf)                WHEN employee_people_leader_business_unit_name_level_4 IS NULL AND #(lf)                    employee_people_leader_business_unit_name_level_3 IS NOT NULL #(lf)                    THEN 3#(lf)                WHEN employee_people_leader_business_unit_name_level_3 IS NULL AND #(lf)                    employee_people_leader_business_unit_name_level_2 IS NOT NULL #(lf)                    THEN 2#(lf)                WHEN employee_people_leader_business_unit_name_level_2 IS NULL AND#(lf)                    employee_people_leader_business_unit_name_level_1 IS NOT NULL #(lf)                    THEN 1#(lf)            END#(lf)    END AS hierarchy_number_0,#(lf)      employee_employment_status,#(lf)      employee_job_name,#(lf)      employee_current_status#(lf)     INTO #employee_hierarchy_0#(lf)  FROM [edw].[dim_employee_hierarchy]#(lf)  INNER JOIN edw.dim_employee ON dim_employee_hierarchy.employee_id = dim_employee.employee_id#(lf)    LEFT JOIN #NoDirectReports NDR #(lf)        ON NDR.employee_id = dim_employee_hierarchy.employee_id#(lf)  WHERE dim_employee.dwhiscurrent = 1#(lf)  AND dim_employee_hierarchy.[DWHDMLOperation] <> 'D' and dim_employee_hierarchy.[DWHIsCurrent] = 1 #(lf)  AND dim_employee.[DWHDMLOperation] <> 'D' and dim_employee.[DWHIsCurrent] = 1 #(lf)  AND dim_employee_hierarchy.employee_company_name COLLATE Latin1_General_CI_AI NOT IN ('previous business entity' COLLATE Latin1_General_CI_AI, 'ignite aotearoa' COLLATE Latin1_General_CI_AI) -- removing test data#(lf) un