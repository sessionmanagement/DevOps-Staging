expression 'Work _PRIMHDExclusionTeams' =
		let
		    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="SELECT DISTINCT#(lf)1 AS CompanyID,#(lf)TeamID,#(lf)CASE#(lf)#(tab)WHEN#(lf)#(tab)#(tab)TeamUDF4 = 1 THEN 1#(lf)#(tab)#(tab)ELSE 0#(lf)#(tab)END#(lf)AS PRIMHDExclusion#(lf)FROM [RBEAL].[dlDimTeam]#(lf)UNION ALL#(lf)SELECT DISTINCT#(lf)5 AS CompanyID,#(lf)TeamID,#(lf)CASE#(lf)#(tab)WHEN#(lf)#(tab)#(tab)TeamUDF4 = 1 THEN 1#(lf)#(tab)#(tab)ELSE 0#(lf)#(tab)END#(lf)AS PRIMHDExclusion#(lf)FROM [RBMNB].[dlDimTeam]"])
		in
		    Source
