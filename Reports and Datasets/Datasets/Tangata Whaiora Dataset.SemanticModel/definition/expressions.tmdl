m_id,#(lf)  dim_client_team_unique_key,#(lf)  #final.dim_company_key#(lf)  into #finalfinal#(lf)  from #final#(lf)  left join edw.dim_service on #final.service_id = dim_service.service_id#(lf)  and dim_service.DWHIsCurrent= 1 and dim_service.DWHDMLOperation <> 'd'#(lf)  left join #client_teams on dim_service.service_code = #client_teams.service_id#(lf)   and dim_service.dim_company_key = #client_teams.fudged_company_id#(lf)#(lf)  select #(lf)    #(lf)  hierarchy_number,#(lf)  dim_employee_key,#(lf)  employee_id,#(lf)  employee_primary_email_address,#(lf)  employee_job_name,#(lf)  service_name,#(lf)  dim_service_key,#(lf)  service_id,#(lf)  department_name,#(lf)  district_name,#(lf)  region_name,#(lf)  company,#(lf)  client_team_area,#(lf)  client_team_function,#(lf)  client_team_name,#(lf)  client_team_id,#(lf)  dim_client_team_unique_key#(lf)   #(lf)  from #finalfinal#(lf)#(lf) order by employee_primary_email_address, service_name #(lf)#(lf) #(lf)#(lf)DROP TABLE IF EXISTS #NoDirectReports;#(lf)DROP TABLE IF EXISTS #employee_hierarchy_0;#(lf)DROP TABLE IF EXISTS #employee_hierarchy;#(lf)DROP TABLE IF EXISTS #PeopleLeaders;#(lf)DROP TABLE IF EXISTS #peopleLeader_Email;#(lf)DROP TABLE IF EXISTS #ServicesEDW;#(lf)DROP TABLE IF EXISTS #HierarchywithServices;#(lf)DROP TABLE IF EXISTS #HierarchywithServices_0;#(lf)DROP TABLE IF EXISTS #CostAllocations;#(lf)DROP TABLE IF EXISTS #level_1_AllStaff;#(lf)DROP TABLE IF EXISTS #level_2_AllStaff;#(lf)DROP TABLE IF EXISTS #level_3_AllStaff;#(lf)DROP TABLE IF EXISTS #level_4_AllStaff;#(lf)DROP TABLE IF EXISTS #level_5_AllStaff;#(lf)DROP TABLE IF EXISTS #level_6_AllStaff;#(lf)DROP TABLE IF EXISTS #level_7_AllStaff;#(lf)DROP TABLE IF EXISTS #noservice;#(lf)DROP TABLE IF EXISTS #lowestlevel;#(lf)DROP TABLE IF EXISTS #missing7;#(lf)DROP TABLE IF EXISTS #PeopleLeaderMissing7;#(lf)DROP TABLE IF EXISTS #levels6_7_0;#(lf)DROP TABLE IF EXISTS #levels6_7;#(lf)DROP TABLE IF EXISTS #levels5_6_7;#(lf)DROP TABLE IF EXISTS #levels_4_5_6_7;#(lf)DR