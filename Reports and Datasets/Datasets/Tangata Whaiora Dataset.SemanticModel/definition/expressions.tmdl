expression 'Fact Tangata Whaiora Max Referral KEY' = ```
		let
		    Source = Sql.Database(Server, Database),
		    edw_fact_client_referral = Source{[Schema="edw",Item="vw_fact_client_referral"]}[Data],
		    #"Reduce Rows" = if #"Top N Rows" <> "All" then Table.FirstN(edw_fact_client_referral, Number.FromText(#"Top N Rows")) else edw_fact_client_referral,
		    ApplyNamingConventions = (columnName as text) as text =>
		        let
		            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
		            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
		            capitaliseWords = Text.Proper(replaceUnderscore),
		            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
		            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY")
		        in
		            capitaliseKEY,
		    #"Transform Column Names" = Table.TransformColumnNames(#"Reduce Rows", each ApplyNamingConventions(_)),
		    #"Filtered Rows" = Table.SelectRows(#"Transform Column Names", each ([Dwhdmloperation] <> "D")),
		    #"Removed Columns" = Table.RemoveColumns(#"Filtered Rows",{"Dwhsourcesystem", "Dwhbatchid", "Dwhdmloperation", "Dwhmodifiedon", "Dwhcreatedat"}),
		    #"Added Age Column" = Table.AddColumn(#"Removed Columns", "Referral Age", each let
		                CreatedDate = #date(
		                    Number.RoundDown([Tangata Whaiora Referral Received Date KEY] / 10000),
		                    Number.RoundDown(Number.Mod([Tangata Whaiora Referral Received Date KEY], 10000) / 100),
		                    Number.Mod([Tangata Whaiora Referral Received Date KEY], 100)
		                ),
		                DischargeDate = if [Tangata Whaiora Referral Discharge Date KEY] = null 
		                                then Date.From(DateTime.LocalNow()) 
		                                else #date(
		                                        Number.RoundDown([Tangata Whaiora Referral Discharge Date KEY] / 10000),
		                                        Number.RoundDown(Number.Mod([Tangata Whaiora Referral Discharge Date KEY], 10000) / 100),
		                                        Number.Mod([Tangata Whaiora Referral Discharge Date KEY], 100)
		                                     ),
		                AgeInDays = Duration.Days(DischargeDate - CreatedDate)
		            in
		                AgeInDays),
		    #"Removed Other Columns" = Table.SelectColumns(#"Added Age Column",{"Fact Tangata Whaiora Referral KEY", "Dim Company KEY", "Dim Tangata Whaiora KEY", "Dim Tangata Whaiora Referral KEY"}),
		    #"Grouped Rows" = Table.Group(#"Removed Other Columns", {"Dim Tangata Whaiora Referral KEY", "Dim Company KEY", "Dim Tangata Whaiora KEY"}, {{"Fact Tangata Whaiora Referral KEY", each List.Max([Fact Tangata Whaiora Referral KEY]), type number}}),
		    #"Sorted Rows" = Table.Sort(#"Grouped Rows",{{"Fact Tangata Whaiora Referral KEY", Order.Ascending}}),
		    #"Added Custom" = Table.AddColumn(#"Sorted Rows", "Is Latest Referral", each true),
		    #"Changed Type" = Table.TransformColumnTypes(#"Added Custom",{{"Is Latest Referral", type logical}}),
		    #"Filtered Rows1" = Table.SelectRows(#"Changed Type", each ([Dim Tangata Whaiora Referral KEY] > 0))
		in
		    #"Filtered Rows1"
		```
	lineageTag: ca992d20-4f35-4f06-96be-b07142a762ee
