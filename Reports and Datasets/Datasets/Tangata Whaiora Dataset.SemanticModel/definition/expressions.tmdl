rral_decline_date_key' THEN 'Declined'#(lf)    END AS Status#(lf)FROM #(lf)    (#(lf)        SELECT #(lf)            *#(lf)        FROM #(lf)            [edw].[vw_fact_client_referral]#(lf)        WHERE #(lf)            [DWHDMLOperation] <> 'D'#(lf)            --AND [client_referral_id] = 131882#(lf)    ) AS SourceTable#(lf)UNPIVOT#(lf)    (#(lf)        DateKey FOR DateType IN #(lf)        (#(lf)            [client_referral_received_date_key],#(lf)            --[client_referral_created_date_key],#(lf)            --[client_referral_end_date_key],#(lf)            [client_referral_pending_date_key],#(lf)            [client_referral_waitlist_date_key],#(lf)            [client_referral_accepted_date_key],#(lf)            [client_referral_discharge_date_key],#(lf)            [client_referral_decline_date_key]#(lf)        )#(lf)    ) AS UnpivotTable;"]),
		    #"Reduce Rows" = if #"Top N Rows" <> "All" then Table.FirstN(Source, Number.FromText(#"Top N Rows")) else Source,
		    ApplyNamingConventions = (columnName as text) as text =>
