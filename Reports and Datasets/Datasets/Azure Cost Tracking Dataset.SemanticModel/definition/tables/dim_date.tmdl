	partition dim_date = m
		mode: import
		queryGroup: Dimensions
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="SELECT#(lf)calendar_date,#(lf)calendar_month_name_short,#(lf)calendar_year,#(lf)calendar_year_month,#(lf)financial_year_num,#(lf)current_date_rolling_financial_year_offset,#(lf)current_date_rolling_month_offset,#(lf)current_date_rolling_year_offset,#(lf)#(tab) DATEDIFF(#(lf)#(tab)#(tab)DAY,#(lf)#(tab)#(tab)CONVERT(datetime, SWITCHOFFSET(CONVERT(datetimeoffset, GETDATE()), DATEPART(TZOFFSET,GETDATE() AT TIME ZONE 'New Zealand Standard Time'))),#(lf)                calendar_date)#(lf)#(tab)#(tab)AS date_offset,#(lf) DATEDIFF(#(lf)        MONTH,#(lf)        CONVERT(datetime, SWITCHOFFSET(CONVERT(datetimeoffset, GETDATE()), DATEPART(TZOFFSET, GETDATE() AT TIME ZONE 'New Zealand Standard Time'))),#(lf)        calendar_date#(lf)    ) AS month_offset,#(lf)    DATEDIFF(#(lf)        YEAR,#(lf)        CONVERT(datetime, SWITCHOFFSET(CONVERT(datetimeoffset, GETDATE()), DATEPART(TZOFFSET, GETDATE() AT TIME ZONE 'New Zealand Standard Time'))),#(lf)        calendar_date#(lf)    ) AS year_offset,#(lf)    financial_year_num - (YEAR(GETDATE()) - CASE #(lf)        WHEN MONTH(GETDATE()) >= 7 THEN 1 #(lf)        ELSE 0 #(lf)    END) AS financial_year_offset#(lf) FROM edw.dim_date #(lf) WHERE dim_date_key <> 0#(lf)AND calendar_date > DATEADD(year, -90, GETDATE()) AND calendar_date < DATEADD(year, 9, GETDATE())"]),
				    #"Changed Type" = Table.TransformColumnTypes(
				    Source,
				        {
				            {"financial_year_num", Int64.Type},
				            {"calendar_date", type date}
				        }
				    ),
				#"Columns removed by Measure Killer"= Table.SelectColumns(#"Changed Type",{"financial_year_num","calendar_year_month","calendar_date","financial_year_offset","calendar_month_name_short","year_offset","calendar_year","month_offset","date_offset"})
				in
				#"Columns removed by Measure Killer"

	annotation PBI_ResultType = Table

