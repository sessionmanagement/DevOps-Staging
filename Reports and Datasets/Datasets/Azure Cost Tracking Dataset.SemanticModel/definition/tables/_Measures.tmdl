	measure '(Parameter) Rolling Average Monthly Costs' =
			
			VAR RollingMonths = SELECTEDVALUE('Rolling Average No. of Months'[Rolling Average No. of Months], 12)
			RETURN
			CALCULATE(
			    AVERAGEX(
			        VALUES(dim_date[calendar_year_month]),
			        CALCULATE([Total Cost])
			    ),
			    FILTER(
			        ALL(dim_date),
			        dim_date[month_offset] <= MAX(dim_date[month_offset]) &&
			        dim_date[month_offset] > MAX(dim_date[month_offset]) - RollingMonths
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 1. Measures
		lineageTag: c14ca901-b772-4467-8047-668fd4a7c12d

	measure '(Parameter) Rolling Daily Average Total Cost' =
			
			VAR RollingMonths = SELECTEDVALUE('Rolling Average No. of Months'[Rolling Average No. of Months], 12)  -- Default to 12 months if none selected
			VAR EndDate = MAX(dim_date[calendar_date])
			VAR StartDate = EDATE(EndDate, -RollingMonths)
			RETURN
			CALCULATE(
			    AVERAGEX(
			        VALUES(dim_date[calendar_date]),
			        CALCULATE(
			            [Total Cost],
			            FILTER(
			                fact_costs,
			                fact_costs[date] = dim_date[calendar_date]
			            )
			        )
			    ),
			    FILTER(
			        ALL(dim_date),
			        dim_date[calendar_date] >= StartDate &&
			        dim_date[calendar_date] <= EndDate
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 1. Measures
		lineageTag: ab61fb69-4113-4ae6-8392-f3db9a89ef59

	measure 'Dynamic Average Monthly Percentage Change' = ```
			
			VAR RollingMonths = SELECTEDVALUE('Rolling Average No. of Months'[Rolling Average No. of Months], 12)  -- Default to 12 months if none selected
			RETURN
			AVERAGEX(
			    DATESINPERIOD(
			        dim_date[calendar_date], 
			        LASTDATE(dim_date[calendar_date]), 
			        -RollingMonths, 
			        MONTH
			    ),
			    [Monthly Percentage Change]
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 1. Measures
		lineageTag: c0ebd06a-669f-4e54-ac20-5564b05e32ca

	measure 'Maxx Daily Cost * 1.05 (for upper bound on Y Axis)' = ```
			
			VAR _Max = 
			CALCULATE(
			    MAXX(
			        SUMMARIZE(
			            fact_costs, 
			            dim_date[calendar_date],
			            "DailyTotal", SUM(fact_costs[total_costs])
			        ),
			        [DailyTotal]
			    ),
			    REMOVEFILTERS()
			)
			RETURN
			_Max * 1.05
			```
		displayFolder: 1. Measures
		lineageTag: c196da9e-9fec-432c-a317-3dad14d60089

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Max Monthly Cost * 1.2 (for upper bound on Y Axis)' = ```
			
