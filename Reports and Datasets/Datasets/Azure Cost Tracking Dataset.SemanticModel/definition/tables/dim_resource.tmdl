				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ods", [Query="-- ============================================================#(lf)-- Model:  Azure Cost Tracking Dataset#(lf)-- Table:  dim_resource#(lf)-- Source: native query (complex CTE/window) - emitted in full#(lf)-- Used columns: 5 (mapped 5, unmapped 0)  [full query, not trimmed]#(lf)-- Auto-generated from pbi_complete_dump.csv + model M + EDW/ODS schema.#(lf)-- Review before use; verify joins/filters against the model.#(lf)-- ============================================================#(lf)-- USED model columns: dim_resource_key; resource; resource_group; servicefamily; subscription_name#(lf)#(lf)WITH data AS (#(lf)    SELECT DISTINCT#(lf)        LOWER(resourceGroupName) AS resource_group,#(lf)        LOWER(SUBSTRING(ResourceId, LEN(ResourceId) - CHARINDEX('/', REVERSE(ResourceId)) + 2, LEN(ResourceId))) AS resource,#(lf)#(tab)#(tab)servicefamily,#(lf)#(tab)#(tab)subscriptionName as subscription_name#(lf)    FROM [dbo].[cost_analysis_current]#(lf)    UNION#(lf)    SELECT DISTINCT#(lf)        LOWER(resourceGroupName) AS resource_group,#(lf)        LOWER(SUBSTRING(ResourceId, LEN(ResourceId) - CHARINDEX('/', REVERSE(ResourceId)) + 2, LEN(ResourceId))) AS resource,#(lf)#(tab)#(tab)serviceFamily,#(lf)#(tab)#(tab)subscriptionName as subscription_name#(lf)    FROM [dbo].[cost_analysis_monthly]#(lf)#(tab))#(lf)#(lf)SELECT#(lf)*,#(lf)HASHBYTES('SHA1',CONCAT(resource_group,resource,servicefamily,subscription_name)) AS dim_resource_key#(lf)FROM data;#(lf)"]),
