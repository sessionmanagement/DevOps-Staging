table ChangeLog
	isHidden
	lineageTag: 2ba64f4c-8a6f-42b2-9958-27ebf5ae0f12

	measure 'Max ChangeLog ID' =
			
			CONCATENATE("Dataset Version ",
			MAX(
			    ChangeLog[Version]
			)
			)
		isHidden
		lineageTag: 487e21d1-080c-418d-bfc6-5b3268ef9c91

		changedProperty = IsHidden

	column 'Change ID'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 08b1f74e-daae-4eff-8e01-bced05436e56
		summarizeBy: count
		sourceColumn: Change ID

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column Version
