model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-NZ
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Dimensions

	annotation PBI_QueryGroupOrder = 0

queryGroup Facts

	annotation PBI_QueryGroupOrder = 1

queryGroup Work

	annotation PBI_QueryGroupOrder = 2

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 3

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["_Measures","LastRefreshed","fact_costs","dim_date","dim_resource","ChangeLog","data_measure_definitions"]

annotation PBI_ProTooling = ["DevMode"]

ref table _Measures
ref table LastRefreshed
ref table fact_costs
ref table dim_date
ref table ResourceMonthlyCostsSummary
ref table dim_resource
ref table ResourceDailyCostsSummary
ref table 'Rolling Average No. of Months'
ref table 'Yearly Budget'
ref table ChangeLog
ref table data_measure_definitions

ref cultureInfo en-US

