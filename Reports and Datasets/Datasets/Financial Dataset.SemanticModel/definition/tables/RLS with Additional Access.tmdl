	partition 'RLS with Additional Access' = m
		mode: import
		queryGroup: 'Row Level Security'
		source = ```
				let
				    // Load both tables
				    RowLevelSecurity = @#"Row Level Security Employee",
				    AdditionalAccess = #"Additional Access",
				    
				    // Join tables
				    JoinedTable = Table.Join(AdditionalAccess, "Person to Impersonate Email", RowLevelSecurity, "User Principal Name", JoinKind.RightOuter),
				    #"Added Conditional Column" = Table.AddColumn(JoinedTable, "Custom", each if [Requester Email] = null then [User Principal Name] else [Requester Email]),
				    #"Removed Columns" = Table.RemoveColumns(#"Added Conditional Column",{"Report", "Requester Email", "Person to Impersonate Email", "Expiry Date", "Access Reason", "Approved By Email", "Approved Date", "Modified", "Created", "Created By Email", "Modified By Email", "Version", "User Principal Name"}),
				    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns",{{"Custom", "User Principal Name"}}),
				    #"Reordered Columns" = Table.ReorderColumns(#"Renamed Columns",{"User Principal Name", "Dim Service KEY"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Reordered Columns",{{"User Principal Name", type text}}),
				    #"Removed Duplicates" = Table.Distinct(#"Changed Type"),
				    #"Appended Query" = Table.Combine({#"Removed Duplicates", #"Row Level Security Employee"}),
				    #"Removed Duplicates1" = Table.Distinct(#"Appended Query"),
				    #"Filtered Rows" = Table.SelectRows(#"Removed Duplicates1", each true)
				in
				    #"Filtered Rows"
				```

