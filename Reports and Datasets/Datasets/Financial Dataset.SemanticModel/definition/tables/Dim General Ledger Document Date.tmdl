	partition 'Dim General Ledger Document Date' = m
		mode: import
		queryGroup: 'Role Playing Date Tables'
		source =
				let
				    // Reference to the DimDate table
				    Source = #"Dim Date",
				
				    // Function to prepend "Budget " to each column name
				    AddBudgetPrefix = (columnName as text) as text =>
				        "General Ledger Document " & columnName,
				
				    // Transforming column names of the source table
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, each AddBudgetPrefix(_)),
				
				    // Final step to output the transformed table
				    FinalTable = #"Transformed Column Names"
				in
				    FinalTable

	annotation PBI_ResultType = Table

