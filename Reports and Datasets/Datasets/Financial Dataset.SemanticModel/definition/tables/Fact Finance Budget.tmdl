		annotation SummarizationSetBy = Automatic

	partition 'Fact Finance Budget' = m
		mode: import
		queryGroup: 'Fact Tables'
		source = ```
				let
				    // 1. Connect to SQL Server and retrieve the Fact Finance Budget view
				    Source = Sql.Database(Server, Database, [Query="SELECT#(lf)    [dim_finance_general_ledger_account_key],#(lf)    [dim_finance_budget_holder_key],#(lf)    [dim_finance_contract_key],#(lf)    [dim_finance_customer_key],#(lf)    [dim_department_key],#(lf)    [dim_district_key],#(lf)    [dim_finance_funder_key],#(lf)    [dim_finance_funding_agency_key],#(lf)    [dim_location_key],#(lf)    [dim_region_key],#(lf)    [dim_service_key],#(lf)    [dim_finance_vendor_key],#(lf)    [dim_company_key],#(lf)    [service_id],#(lf)    [finance_budget_general_ledger_account_no],#(lf)    [finance_budget_budget_name],#(lf)    [finance_budget_date_key],#(lf)    [finance_budget_amount]#(lf)FROM [edw].[vw_fact_finance_budget]#(lf)where DWHDMLOperation <> 'D';"]),
				    // 2. Define a function to rename columns following your conventions
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				
				    // 3. Transform the column names using the ApplyNamingConventions function
				    #"Transformed Column Names" = 
				        Table.TransformColumnNames(
				            Source, 
				            each ApplyNamingConventions(_)
				        ),
				
				    // 6. Convert columns ending with " Date KEY" into proper date columns
				    #"Added and Converted Date Columns" = 
				        List.Accumulate(
				            List.Select(
				                Table.ColumnNames(#"Transformed Column Names"), 
				                each Text.EndsWith(_, " Date KEY")
				            ),
				            #"Transformed Column Names",
				            (state, columnName) =>
				                Table.AddColumn(
				                    state,
				                    Text.BeforeDelimiter(columnName, " KEY"),
				                    each
				                        if Record.Field(_, columnName) <> null then
				                            let
				                                dateValue = Text.From(Record.Field(_, columnName)),
				                                yearPart = Text.Start(dateValue, 4),
				                                monthPart = Text.Middle(dateValue, 4, 2),
				                                dayPart = Text.End(dateValue, 2),
				                                formattedDate = yearPart & "-" & monthPart & "-" & dayPart
				                            in
				                                if Text.Length(dateValue) = 8 then
				                                    Date.FromText(formattedDate)
				                                else
				                                    null
				                        else
				                            null,
				                    type date
				                )
				        ),
				
				    // 7. Change column type for Finance Budget General Ledger Account No
				    #"Changed Type" = 
				        Table.TransformColumnTypes(
				            #"Added and Converted Date Columns",
				            {{"Finance Budget General Ledger Account No", Int64.Type}}
				        ),
				
				    // 8. Calculate Current Financial Year (July-June fiscal year)
				    // If month >= 7 (July onwards), FY = Year + 1, otherwise FY = Year
				    CurrentFinancialYear = 
				        let
				            Today = DateTime.LocalNow(),
				            Month = Date.Month(Today),
				            Year = Date.Year(Today),
				            FY = if Month >= 7 then Year + 1 else Year
				        in
				            Text.From(FY),
				
				    // 9. Add Financial Year column for each row based on Finance Budget Date
				    #"Added Row FY" = 
				        Table.AddColumn(
				            #"Changed Type",
				            "Row Financial Year",
				            each 
				                let
				                    BudgetDate = [Finance Budget Date],
				                    Month = Date.Month(BudgetDate),
				                    Year = Date.Year(BudgetDate),
				                    FY = if Month >= 7 then Year + 1 else Year
				                in
				                    Text.From(FY),
				            type text
				        ),
				
				    // 10. Create lookup table: For each FY, determine the best available budget
				    // Priority: FORECASTQ2 > FORECAST > BUDGET
				    FYBudgetLookup = 
				        let
				            Grouped = Table.Group(
				                #"Added Row FY", 
				                {"Row Financial Year"}, 
				                {{"AvailableBudgets", each List.Distinct([Finance Budget Budget Name])}}
				            ),
				            AddBestBudget = Table.AddColumn(
				                Grouped, 
				                "Best Budget For FY", 
				                each
				                    let
				                        Budgets = [AvailableBudgets]
				                    in
				                        if List.Contains(Budgets, "FORECASTQ2") then "FORECASTQ2"
				                        else if List.Contains(Budgets, "FORECAST") then "FORECAST"
				                        else "BUDGET",
				                type text
				            ),
				            SelectColumns = Table.SelectColumns(AddBestBudget, {"Row Financial Year", "Best Budget For FY"})
				        in
				            SelectColumns,
				
				    // 11. Join the lookup back to the main table
				    #"Joined With Best Budget" = 
				        Table.NestedJoin(
				            #"Added Row FY", 
				            {"Row Financial Year"},
				            FYBudgetLookup, 
				            {"Row Financial Year"},
				            "FYLookup", 
				            JoinKind.LeftOuter
				        ),
				
				    #"Expanded Best Budget" = 
				        Table.ExpandTableColumn(
				            #"Joined With Best Budget", 
				            "FYLookup", 
				            {"Best Budget For FY"}
				        ),
				
				    // 12. Add Budget Type column with the new logic:
				    // - Current FY: Use fxCurrentBudget parameter
				    // - Prior FYs: Use the best available budget for that FY
				    #"Added Budget Type Column" = 
				        Table.AddColumn(
				            #"Expanded Best Budget",
				            "Budget Type",
				            each 
				                let
				                    RowFY = [Row Financial Year],
				                    RowBudget = [Finance Budget Budget Name],
				                    BestBudget = [Best Budget For FY],
				                    IsCurrentFY = (RowFY = CurrentFinancialYear)
				                in
				                    if IsCurrentFY then
				                        if RowBudget = fxCurrentBudget then "Latest Budget" else "Prior Budgets"
				                    else
				                        if RowBudget = BestBudget then "Latest Budget" else "Prior Budgets",
				            type text
				        ),
				
				    // 13. Remove helper columns
				    #"Removed Helper Columns" = 
				        Table.RemoveColumns(
				            #"Added Budget Type Column", 
				            {"Row Financial Year", "Best Budget For FY"}
				        )
				in
				    #"Removed Helper Columns"
				```

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

