	column 'Fact Budget Variance Indicator' = IF('Fact Finance Budget'[Finance Budget General Ledger Account No] < 2000, 'Fact Finance Budget'[Finance Budget Amount] * -1, 'Fact Finance Budget'[Finance Budget Amount])
		lineageTag: edb999cf-c0c8-48dd-8515-165b15c43cb2
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Inverse Budget Amount' =
			
			IF(
			        'Fact Finance Budget'[Finance Budget General Ledger Account No] * 1 < 2000,
			        'Fact Finance Budget'[Finance Budget Amount] * -1,
			        'Fact Finance Budget'[Finance Budget Amount]
			    )
		lineageTag: 4dc01de8-4eba-44c5-b740-13f46c17a603
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Budget Type'
		dataType: string
