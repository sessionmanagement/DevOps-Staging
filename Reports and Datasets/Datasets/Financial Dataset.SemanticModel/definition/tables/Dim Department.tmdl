table 'Dim Department'
	lineageTag: 1cbe58a5-b8b7-48c1-ab57-a67d2213e4b7

	column 'Dim Department KEY'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 0ccf1436-5023-46c9-ac80-3d569133c9e0
		summarizeBy: none
		sourceColumn: Dim Department KEY

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Department Code'
		dataType: string
		lineageTag: ce3d30c9-71e6-4a2c-a0d3-fc14417061bf
		summarizeBy: none
		sourceColumn: Department Code

