				let
				    // 1) Source
				    Source = Sql.Database(Server, Database),
				    edw_dim_date = Source{[Schema="edw",Item="vw_dim_date"]}[Data],
				
				    // 2) Naming conventions
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            capitaliseWords = Text.Proper(replaceUnderscore),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY")
				        in
				            capitaliseKEY,
				    #"Transformed Column Names" = Table.TransformColumnNames(
				        edw_dim_date,
				        each ApplyNamingConventions(_)
				    ),
				
				    // 3) Remove unneeded columns
				    #"Removed Columns" = Table.RemoveColumns(
				        #"Transformed Column Names",
				        {"Dwhsourcesystem", "Dwhcreatedat", "Dwhbatchid"}
				    ),
				
				    // 4) Enforce the one type the logic depends on. If Calendar Date is
				    //    missing or not convertible, this fails here with a clear message
				    //    instead of erroring inside a later column.
