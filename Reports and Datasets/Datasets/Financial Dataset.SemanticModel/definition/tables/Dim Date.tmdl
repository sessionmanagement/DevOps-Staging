				    BoundaryDate = Date.EndOfMonth(Date.AddMonths(StartOfCurrentMonth, -MonthsToGoBack)),
				
				    // 9) The current FY is the FY that contains the last closed month.
				    //    Looked up from the table itself, so the Jul-Jun year definition
				    //    comes from Financial Year Num, not from arithmetic here.
				    BoundaryRows = Table.SelectRows(#"Add Offset Column", each [Calendar Date] = BoundaryDate),
				    ActiveFYNumber = if Table.IsEmpty(BoundaryRows) then null else BoundaryRows{0}[Financial Year Num],
				
				    // 10) Fiscal Year Label
