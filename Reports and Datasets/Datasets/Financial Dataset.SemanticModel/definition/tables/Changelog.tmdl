table Changelog
	lineageTag: 7ed453e7-4252-434d-a754-418189b04f8f

	measure 'Latest Version' =
			
			VAR LatestChangeID =
			    MAX ( 'Changelog'[Change ID] )
			VAR LatestVersion =
			    MAXX (
			        FILTER ( 'Changelog', 'Changelog'[Change ID] = LatestChangeID ),
			        'Changelog'[Version]
			    )
			RETURN
			    "Financial Dataset - v" & LatestVersion
		lineageTag: cdf06246-844f-4d52-aa97-5475a5f5c43f

	column 'Change ID'
		dataType: int64
		formatString: 0
		lineageTag: 0a095911-a448-4e59-94b1-43f5e45a41c6
		summarizeBy: count
		sourceColumn: Change ID

		annotation SummarizationSetBy = Automatic

	column Version
		dataType: string
		lineageTag: acb5e612-e689-44f0-a2eb-615507cae400
		summarizeBy: none
		sourceColumn: Version

		annotation SummarizationSetBy = Automatic

	column 'Change Date'
		dataType: string
		lineageTag: 085f0a72-5bd9-4516-ac4c-9240bf731f3c
		summarizeBy: none
		sourceColumn: Change Date

		annotation SummarizationSetBy = Automatic

	column 'Changed By'
		dataType: string
		lineageTag: 068d3a61-e91d-4e94-84ea-f35ed81686c0
		summarizeBy: none
		sourceColumn: Changed By

		annotation SummarizationSetBy = Automatic

	column 'User Story ID'
		dataType: string
		lineageTag: 76be2fb2-0a78-429f-9e17-07128c5fbf1c
		summarizeBy: none
		sourceColumn: User Story ID

		annotation SummarizationSetBy = Automatic

	column Description
		dataType: string
		lineageTag: c20d23ee-daad-4a7b-a70c-a5401c239eab
		summarizeBy: none
		sourceColumn: Description

		annotation SummarizationSetBy = Automatic

	partition Changelog = m
		mode: import
		queryGroup: 'Change Log'
		source = ```
				let
				    // Define the table schema without the ChangeID column
				    InitialTable = #table(
				        {"Version", "Change Date", "Changed By", "User Story ID", "Description"},
				        {
				            {
				                "1.0.0", /* Version */
				                #date(2024, 6, 27),  /* Date */
				                "Thijs B",  /* Changed By */
				                "#7164",  /* User Story */
				                "Initial release of EDW Finance Dataset"  /* Description */
				            },
				            {
				                "1.0.1", /* Version */
				                #date(2024, 7, 02),  /* Date */
				                "Thijs B",  /* Changed By */
				                "#8133",  /* User Story */
				                "Remove close income statement from GL data"  /* Description */
				            },
				            {
				                "1.1.0", /* Version */
				                #date(2024, 7, 03),  /* Date */
				                "Mike G",  /* Changed By */
				                "#8148",  /* User Story */
				                "Converted relationships between Dim Service to Fact Tables as a Many to Many on service ID instead of slowly changing service key"  /* Description */
				            },
				            {
				                "1.1.1", /* Version */
				                #date(2024, 10, 07),  /* Date */
				                "Greg H",  /* Changed By */
				                "#9090",  /* User Story */
				                "Append the additional access rows to avoid overwriting of original access."  /* Description */
				            },
				            {
				                "1.1.2", /* Version */
				                #date(2024, 10, 07),  /* Date */
				                "Thijs B",  /* Changed By */
				                "#8862",  /* User Story */
				                "Add a few measures to create pinable visuals for Monthly reporting dashboard"  /* Description */
				            }
				        ,
				            {
				                "1.1.3", /* Version */
				                #date(2024, 10, 07),  /* Date */
				                "Thijs B",  /* Changed By */
				                "#-",  /* User Story */
				                "Update measures for Monthly reporting dashboard"  /* Description */
				            },
				                        {
				                "1.2.0", /* Version */
				                #date(2025, 04, 08), /* Change Date (example) */
				                "Mike G",  /* Changed By */
				                "#9833",   /* User Story ID (example) */
				                "Incorporate month parameter with current fiscal year logic to hide incomplete FY data"  /* Description */
				            },
				                        {
				                "1.2.1", /* Version */
				                #date(2025, 04, 09), /* Change Date (example) */
				                "Mike G",  /* Changed By */
				                "#9833",   /* User Story ID (example) */
				                "Removed annual budget filter"  /* Description */
				            },
				            {
				                "1.2.2", /* Version */
				                #date(2025, 04, 09), /* Change Date (example) */
				                "Mike G",  /* Changed By */
				                "#9833",   /* User Story ID (example) */
				                "UpToXMonthsAgoFlag to text"  /* Description */
				            },
				            {
				                "1.3.0", /* Version */
				                #date(2025, 04, 16), /* Change Date (example) */
				                "Mike G",  /* Changed By */
				                "#9833",   /* User Story ID (example) */
				                "New RLS from April 9"  /* Description */
				            },
				            {
				                "1.4.0", /* Version */
				                #date(2025, 05, 07), /* Change Date (example) */
				                "Mike G",  /* Changed By */
				                "#9833",   /* User Story ID (example) */
				                "Removed PBIR"  /* Description */
				            },
				            {
				                "1.5.0", /* Version */
				                #date(2025, 10, 06), /* Change Date (example) */
				                "Thijs B",  /* Changed By */
				                "#11329",   /* User Story ID (example) */
				                "Update RLS to EDW Employee RLS with some expections"  /* Description */
				            },
				            {
				                "1.5.1", /* Version */
				                #date(2025, 11, 27), /* Change Date (example) */
				                "Thijs B",  /* Changed By */
				                "#11823",   /* User Story ID (example) */
				                "Update RLS for Mere Tavai to come from RecordBase RLS"  /* Description */
				            },
				            {
				                "1.6.0", /* Version */
				                #date(2025, 12, 09), /* Change Date */
				                "Mike G",  /* Changed By */
				                "#11097",   /* User Story ID */
				                "Fix Budget Type filter logic to use FORECASTQ2 for prior financial years and fxCurrentBudget parameter for current FY"  /* Description */
				            }
				            ,
				            {
				                "1.6.1", /* Version */
				                #date(2026, 03, 27), /* Change Date */
				                "Thijs B",  /* Changed By */
				                "#12751",   /* User Story ID */
				                "Update RLS to give Elizabeth access to HUB Main Highway"  /* Description */
				            },
				            {
				                "1.6.2", /* Version */
				                #date(2026, 05, 11), /* Change Date */
				                "Thijs B",  /* Changed By */
				                "#12751",   /* User Story ID */
				                "Update RLS to give Sarah Wallbank access to Universal hub"  /* Description */
				            },
				            {
				                "1.6.3", /* Version */
				                #date(2026, 06, 08), /* Change Date */
				                "Thijs B",  /* Changed By */
				                "#13743",   /* User Story ID */
				                "Fix Measure Net Surplus (bef recharge)"  /* Description */
				            },
				            {
				                "1.7.0", /* Version */
				                #date(2026, 06, 23), /* Change Date */
				                "Thijs B & Mike G",  /* Changed By */
				                "#13795",   /* User Story ID */
				                "Clean up unused columns and update measure grouping (controllable, uncontrollable and Recharges)"  /* Description */
				            },
				            {
				                "1.7.1", /* Version */
				                #date(2026, 07, 29), /* Change Date */
				                "Mike G",  /* Changed By */
				                "#14254",   /* User Story ID */
				                "Fix Fiscal Year Label failure after FY rollover)"  /* Description */
				            },
				            {
				                "1.7.2", /* Version */
				                #date(2026, 08, 18), /* Change Date */
				                "Thijs B",  /* Changed By */
				                "#14395",   /* User Story ID */
				                "Paginate report update and fix net surplus (bef recharge) month calc."  /* Description */
				            },
				            {
				                "1.7.3", /* Version */
				                #date(2026, 08, 18), /* Change Date */
				                "Thijs B",  /* Changed By */
				                "#13808",   /* User Story ID */
				                "New Forecasting page"  /* Description */
				            }
				        }
				        
				    ),
				
				    // Add an Index column to generate incremental numbers
				    TableWithIndex = Table.AddIndexColumn(InitialTable, "Change ID", 1, 1, Int64.Type),
				
				    // Reorder the columns to place ChangeID first
				    ReorderedColumns = Table.ReorderColumns(TableWithIndex, {"Change ID", "Version", "Change Date", "Changed By", "User Story ID", "Description"})
				in
				    ReorderedColumns
				```

	annotation PBI_ResultType = Table

