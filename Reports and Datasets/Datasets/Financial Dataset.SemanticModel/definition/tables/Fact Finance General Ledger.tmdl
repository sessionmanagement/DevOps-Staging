	column 'Fact General Ledger Variance Indicator' = IF('Fact Finance General Ledger'[Finance General Ledger Account No] < 2000, 'Fact Finance General Ledger'[Finance General Ledger Amount] * -1, 'Fact Finance General Ledger'[Finance General Ledger Amount])
