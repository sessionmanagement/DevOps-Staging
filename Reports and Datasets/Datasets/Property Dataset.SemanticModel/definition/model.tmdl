	annotation PBI_QueryGroupOrder = 7

queryGroup Changelog

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Dim Date'

	annotation PBI_QueryGroupOrder = 5

queryGroup 'Ref Tables'

	annotation PBI_QueryGroupOrder = 4

annotation PBI_QueryOrder = ["Dataset Name","Server","Database","Top N Rows","Dim Company","Fact Aged Debt (OLD)","RLS Joiner","Measures Table","Dim Date","LastRefreshed","Additional Access","Changelog","Role Playing Template Dim Date","Fact Property Inspection","RLS - New RB Structure ALL services","RLS with Additional Access","Executinve Masking","Fact Property Maintenance Task","Dim Service","Fact Property Tenancy Transaction","Fact Property Tenant","Dim Property","Dim Property Detail","Dim Property Healthy Homes","Dim Property Lease","Dim Property Maintenance Type","Dim Property Maintenance","Dim Property Program","Dim Property Tenancy","Fact Aged Debt","Role Playing As At Dim Date","Dim Property Void Category","Fact Property Void Checklist","Ref Property Tenancy Status","Ref Tenant Missing Flags","Fact Vacant Tenantable Gap","Data and Measure Definitions"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","CalcGroup","MCP-PBIModeling"]

annotation __TEdtr = 1

annotation __LastRPTime = 134174684036822297

