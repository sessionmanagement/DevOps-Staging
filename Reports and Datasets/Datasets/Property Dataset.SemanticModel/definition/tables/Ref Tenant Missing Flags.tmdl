	partition 'Ref Tenant Missing Flags' = m
		mode: import
		queryGroup: 'Ref Tables'
		source = ```
				let
				    // 1. Reference the existing Fact Property Tenant table
				    Source = #"Fact Property Tenant",
				    
				    // 2. Keep only the dimension keys and the three fields we need to check for missing data
				    SelectedColumns = Table.SelectColumns(Source,{"Dim Property KEY", "Dim Property Detail KEY", "Dim Property Healthy Homes KEY", "Dim Property Tenancy KEY", "Occupant Gender Label", "Property Tenant Ethnicity Name", "Property Tenancy Tenant Date Of Birth" }),
				    
				    // 3. Add a flag indicating Gender is missing (null or blank => 1, else 0)
				    AddedGenderFlag = Table.AddColumn(SelectedColumns, "Flag Missing Gender", each if [Occupant Gender Label] = null or [Occupant Gender Label] = "" 
				             then 1 
				             else 0),
				    
				    // 4. Add a flag indicating Ethnicity is missing (null or blank => 1, else 0)
				    AddedEthnicityFlag = Table.AddColumn(
				        AddedGenderFlag, 
				        "Flag Missing Ethnicity", 
				        each if [Property Tenant Ethnicity Name] = null or [Property Tenant Ethnicity Name] = "" 
				             then 1 
				             else 0,
				        Int64.Type
				    ),
				    
				    // 5. Add a flag indicating DOB is missing (null => 1, else 0)
				    AddedDOBFlag = Table.AddColumn(
				        AddedEthnicityFlag, 
				        "Flag Missing DOB", 
				        each if [Property Tenancy Tenant Date Of Birth] = null 
				             then 1 
				             else 0,
				        Int64.Type
				    ),
				    
				    // 6. Remove the original columns used to check missing values, 
				    //    keeping only the dimension keys + the new flag columns
				    RemovedExtraColumns = Table.RemoveColumns(
				        AddedDOBFlag, 
				        {
				            "Occupant Gender Label",
				            "Property Tenant Ethnicity Name",
				            "Property Tenancy Tenant Date Of Birth"
				        }
				    )
				in
				    RemovedExtraColumns
				```

	annotation PBI_NavigationStepName = Navigation

