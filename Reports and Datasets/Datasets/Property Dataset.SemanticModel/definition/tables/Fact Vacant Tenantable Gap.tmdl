	partition 'Fact Vacant Tenantable Gap' = m
		mode: import
		queryGroup: 'Fact Tables'
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="#(lf)-------------------------------------------------------------------------------#(lf)-- 0) Parameter to control negative intervals#(lf)-------------------------------------------------------------------------------#(lf)DECLARE @AllowNegativeIntervals BIT = 1;  #(lf)-- 0 = clamp negative intervals to 0#(lf)-- 1 = allow negative intervals as-is#(lf)#(lf)-------------------------------------------------------------------------------#(lf)-- 1) Cleanup old temp tables#(lf)-------------------------------------------------------------------------------#(lf)IF OBJECT_ID('tempdb..#VoidHistory') IS NOT NULL#(lf)    DROP TABLE #VoidHistory;#(lf)#(lf)IF OBJECT_ID('tempdb..#TenancyHistory') IS NOT NULL#(lf)    DROP TABLE #TenancyHistory;#(lf)#(lf)#(lf)-------------------------------------------------------------------------------#(lf)-- 2) Build #VoidHistory from [fact_void_checklist].#(lf)--    - Exclude 'PROV' and 'Void Category Change'#(lf)--    - If category LIKE 'NEW%' => forcibly use acquired_date as start#(lf)--    - Else SHIFT start if acquired_date > COALESCE(tenancy_terminated, created_on)#(lf)--    - IntervalEndDate = COALESCE(date_keys_to_team, disposal_date, todayNZ) --Commented out todayNZ#(lf)-------------------------------------------------------------------------------#(lf)SELECT#(lf)    dp.property_id,#(lf)    RecordType = 'VoidInterval',#(lf)#(lf)    #(lf)    IntervalStartDate = CONVERT#(lf)    (#(lf)        date,#(lf)        CASE #(lf)            WHEN vc.void_checklist_void_category_name LIKE 'NEW%'#(lf)            THEN dp.property_acquired_date#(lf)            ELSE#(lf)                CASE #(lf)                  WHEN dp.property_acquired_date IS NOT NULL#(lf)                       AND dp.property_acquired_date #(lf)                           > COALESCE(vc.void_checklist_date_tenancy_terminated, vc.void_checklist_created_on)#(lf)                  THEN dp.property_acquired_date#(lf)                  ELSE COALESCE(vc.void_checklist_date_tenancy_terminated, vc.void_checklist_created_on)#(lf)                END#(lf)        END#(lf)    ),#(lf)#(lf)    #(lf)    IntervalEndDate = CONVERT#(lf)    (#(lf)        date,#(lf)        COALESCE#(lf)        (#(lf)            vc.void_checklist_date_keys_to_tenancy_team_to_allocate,#(lf)            dp.property_confirmed_disposal_date -- Commented out to not assign wrong date to void with no tenentable status#(lf)        )#(lf)    ),#(lf)#(lf)    vc.void_checklist_void_category_name   AS VoidCategoryName,#(lf)    vc.void_checklist_status_name          AS VoidStatusName,#(lf)    vc.void_checklist_crba8_comments       AS VoidComments,#(lf)#(lf)    dp.property_confirmed_disposal_date,#(lf)    dp.property_acquired_date,#(lf)    dp.property_void_status,#(lf)    dp.property_status,#(lf)    dp.property_statecode,#(lf)    dp.property_statuscode,#(lf)#(lf)    dp.dim_property_key           AS dim_property_key,#(lf)    NULL                          AS dim_property_tenancy_key,#(lf)    void_checklist_id = vc.void_checklist_id#(lf)INTO #VoidHistory#(lf)FROM [edw].[fact_void_checklist] AS vc#(lf)JOIN [edw].[dim_property]        AS dp#(lf)    ON dp.property_id      = vc.void_checklist_property_id#(lf)   AND dp.DWHIsCurrent      = 1#(lf)   AND dp.DWHDMLOperation  <> 'D'#(lf)WHERE#(lf)    vc.DWHIsCurrent         = 1#(lf)  AND vc.DWHDMLOperation    <> 'D'#(lf)  AND vc.void_checklist_void_category_name <> 'PROV'  -- exclude 'PROV'#(lf)  AND vc.void_checklist_status_name <> 'Void Category Change';  -- exclude 'Void Category Change'#(lf)#(lf)#(lf)-------------------------------------------------------------------------------#(lf)-- 3) Build #TenancyHistory from [dim_property_tenancy],#(lf)--    ignoring ""Cancelled"" tenancies entirely.#(lf)-------------------------------------------------------------------------------#(lf)SELECT#(lf)    dp.property_id,#(lf)    RecordType = 'TenancyInterval',#(lf)#(lf)    IntervalStartDate = CONVERT#(lf)    (#(lf)        date,#(lf)        CASE#(lf)          WHEN dp.property_acquired_date IS NOT NULL#(lf)               AND dp.property_acquired_date > pten.property_tenancy_tenancy_start_date#(lf)          THEN dp.property_acquired_date#(lf)          ELSE pten.property_tenancy_tenancy_start_date#(lf)        END#(lf)    ),#(lf)#(lf)    #(lf)    IntervalEndDate = CONVERT#(lf)    (#(lf)        date,#(lf)        COALESCE#(lf)        (#(lf)            pten.property_tenancy_vacated_date,#(lf)            dp.property_confirmed_disposal_date,#(lf)            (GETUTCDATE() AT TIME ZONE 'UTC') AT TIME ZONE 'New Zealand Standard Time'#(lf)        )#(lf)    ),#(lf)#(lf)    pten.property_tenancy_tenancy_name      AS TenancyName,#(lf)    pten.property_tenancy_id               AS TenancyID,#(lf)    pten.property_tenancy_tenancy_reference AS TenancyReference,#(lf)    pten.property_tenant_opportunity_status AS TenancyStatus,#(lf)#(lf)    dp.property_confirmed_disposal_date,#(lf)    dp.property_acquired_date,#(lf)    dp.property_void_status,#(lf)    dp.property_status,#(lf)    dp.property_statecode,#(lf)    dp.property_statuscode,#(lf)    dp.dim_property_key           AS dim_property_key,#(lf)    pten.dim_property_tenancy_key AS dim_property_tenancy_key#(lf)INTO #TenancyHistory#(lf)FROM [edw].[dim_property_tenancy] AS pten#(lf)JOIN [edw].[dim_property]         AS dp#(lf)    ON dp.property_id       = pten.property_id#(lf)   AND dp.DWHIsCurrent       = 1#(lf)   AND dp.DWHDMLOperation   <> 'D'#(lf)WHERE#(lf)    pten.DWHIsCurrent        = 1#(lf)  AND pten.DWHDMLOperation   <> 'D'#(lf)  AND pten.property_tenant_opportunity_status <> 'Cancelled';#(lf)#(lf)#(lf)-------------------------------------------------------------------------------#(lf)-- 4) Union #VoidHistory & #TenancyHistory => AllIntervals#(lf)--    computing DaysInterval (optionally negative).#(lf)-------------------------------------------------------------------------------#(lf)WITH AllIntervals AS#(lf)(#(lf)    SELECT#(lf)        property_id,#(lf)        RecordType,#(lf)        IntervalStartDate,#(lf)        IntervalEndDate,#(lf)#(lf)        DaysInterval = CASE#(lf)            WHEN @AllowNegativeIntervals = 1#(lf)            THEN DATEDIFF(DAY, IntervalStartDate, IntervalEndDate)#(lf)            ELSE #(lf)                CASE WHEN IntervalStartDate < IntervalEndDate#(lf)                     THEN DATEDIFF(DAY, IntervalStartDate, IntervalEndDate)#(lf)                     ELSE 0#(lf)                END#(lf)        END,#(lf)#(lf)        VoidCategoryName,#(lf)        VoidStatusName,#(lf)        VoidComments,#(lf)#(lf)        TenancyName       = CAST(NULL AS VARCHAR(200)),#(lf)        TenancyID         = CAST(NULL AS UNIQUEIDENTIFIER),#(lf)        TenancyReference  = CAST(NULL AS VARCHAR(50)),#(lf)        TenancyStatus     = CAST(NULL AS VARCHAR(50)),#(lf)#(lf)        property_confirmed_disposal_date,#(lf)        property_acquired_date,#(lf)        property_void_status,#(lf)        property_status,#(lf)        property_statecode,#(lf)        property_statuscode,#(lf)        dim_property_key,#(lf)        dim_property_tenancy_key,#(lf)        void_checklist_id#(lf)    FROM #VoidHistory#(lf)#(lf)    UNION ALL#(lf)#(lf)    SELECT#(lf)        property_id,#(lf)        RecordType,#(lf)        IntervalStartDate,#(lf)        IntervalEndDate,#(lf)#(lf)        DaysInterval = CASE#(lf)            WHEN @AllowNegativeIntervals = 1#(lf)            THEN DATEDIFF(DAY, IntervalStartDate, IntervalEndDate)#(lf)            ELSE #(lf)                CASE WHEN IntervalStartDate < IntervalEndDate#(lf)                     THEN DATEDIFF(DAY, IntervalStartDate, IntervalEndDate)#(lf)                     ELSE 0#(lf)                END#(lf)        END,#(lf)#(lf)        VoidCategoryName  = NULL,#(lf)        VoidStatusName    = NULL,#(lf)        VoidComments      = NULL,#(lf)#(lf)        TenancyName,#(lf)        TenancyID,#(lf)        TenancyReference,#(lf)        TenancyStatus,#(lf)#(lf)        property_confirmed_disposal_date,#(lf)        property_acquired_date,#(lf)        property_void_status,#(lf)        property_status,#(lf)        property_statecode,#(lf)        property_statuscode,#(lf)        dim_property_key,#(lf)        dim_property_tenancy_key,#(lf)        void_checklist_id = CAST(NULL AS UNIQUEIDENTIFIER)#(lf)    FROM #TenancyHistory#(lf)),#(lf)OrderedForward AS#(lf)(#(lf)    #(lf)    SELECT#(lf)        property_id,#(lf)        RecordType,#(lf)        IntervalStartDate,#(lf)        IntervalEndDate,#(lf)        DaysInterval,#(lf)#(lf)        -- next interval's start#(lf)        NextIntervalStartDate = LEAD(IntervalStartDate)#(lf)                                OVER#(lf)                                (#(lf)                                    PARTITION BY property_id#(lf)                                    ORDER BY IntervalStartDate, IntervalEndDate#(lf)                                ),#(lf)#(lf)        VoidCategoryName,#(lf)        VoidStatusName,#(lf)        VoidComments,#(lf)        TenancyName,#(lf)        TenancyID,#(lf)        TenancyReference,#(lf)        TenancyStatus,#(lf)#(lf)        property_confirmed_disposal_date,#(lf)        property_acquired_date,#(lf)        property_void_status,#(lf)        property_status,#(lf)        property_statecode,#(lf)        property_statuscode,#(lf)        dim_property_key,#(lf)        dim_property_tenancy_key,#(lf)        void_checklist_id#(lf)    FROM AllIntervals#(lf)),#(lf)OrderedFull AS#(lf)(#(lf)    #(lf)    SELECT#(lf)        *,#(lf)        ReverseRowNum = ROW_NUMBER() OVER#(lf)        (#(lf)            PARTITION BY property_id#(lf)            ORDER BY IntervalStartDate DESC, IntervalEndDate DESC#(lf)        )#(lf)    FROM OrderedForward#(lf)),#(lf)FinalCTE AS#(lf)(#(lf)    #(lf)    SELECT#(lf)        property_id,#(lf)        RecordType,#(lf)#(lf)        #(lf)        IntervalEndDateFinal = CASE#(lf)            WHEN ReverseRowNum = 1#(lf)                 AND RecordType = 'VoidInterval'#(lf)                 AND IntervalEndDate IS NULL#(lf)            THEN CONVERT#(lf)                 (#(lf)                     date,#(lf)                     (GETUTCDATE() AT TIME ZONE 'UTC') AT TIME ZONE 'New Zealand Standard Time'#(lf)                 )#(lf)            ELSE IntervalEndDate#(lf)        END,#(lf)#(lf)        IntervalStartDate,#(lf)        DaysIntervalOriginal = DaysInterval,#(lf)#(lf)        NextIntervalStartDate,#(lf)#(lf)        VoidCategoryName,#(lf)        VoidStatusName,#(lf)        VoidComments,#(lf)        TenancyName,#(lf)        TenancyID,#(lf)        TenancyReference,#(lf)        TenancyStatus,#(lf)#(lf)        property_confirmed_disposal_date,#(lf)        property_acquired_date,#(lf)        property_void_status,#(lf)        property_status,#(lf)        property_statecode,#(lf)        property_statuscode,#(lf)        dim_property_key,#(lf)        dim_property_tenancy_key,#(lf)#(lf)        void_checklist_id,#(lf)        ReverseRowNum#(lf)    FROM OrderedFull#(lf)),#(lf)FinalOutput AS#(lf)(#(lf)    #(lf)    SELECT#(lf)        f.property_id,#(lf)        f.RecordType,#(lf)        f.IntervalStartDate,#(lf)#(lf)        IntervalEndDate = f.IntervalEndDateFinal,#(lf)#(lf)        DaysInterval = #(lf)        CASE #(lf)            WHEN @AllowNegativeIntervals=1#(lf)            THEN DATEDIFF(DAY, f.IntervalStartDate, f.IntervalEndDateFinal)#(lf)            ELSE#(lf)                CASE #(lf)                  WHEN f.IntervalStartDate < f.IntervalEndDateFinal#(lf)                  THEN DATEDIFF(DAY, f.IntervalStartDate, f.IntervalEndDateFinal)#(lf)                  ELSE 0#(lf)                END#(lf)        END,#(lf)#(lf)        DaysBetweenIntervals = CASE#(lf)            WHEN f.NextIntervalStartDate IS NOT NULL#(lf)            THEN DATEDIFF(DAY, f.IntervalEndDateFinal, f.NextIntervalStartDate)#(lf)#(lf)            #(lf)            WHEN f.ReverseRowNum=1 #(lf)                 AND f.RecordType='VoidInterval'#(lf)            THEN DATEDIFF#(lf)                 (#(lf)                     DAY,#(lf)                     f.IntervalEndDateFinal,#(lf)                     CONVERT#(lf)                     (#(lf)                         date,#(lf)                         (GETUTCDATE() AT TIME ZONE 'UTC') AT TIME ZONE 'New Zealand Standard Time'#(lf)                     )#(lf)                 )#(lf)            ELSE NULL#(lf)        END,#(lf)#(lf)        f.VoidCategoryName,#(lf)        f.VoidStatusName,#(lf)        f.VoidComments,#(lf)        f.TenancyName,#(lf)        f.TenancyID,#(lf)        f.TenancyReference,#(lf)        f.TenancyStatus,#(lf)#(lf)        f.property_confirmed_disposal_date,#(lf)        f.property_acquired_date,#(lf)        f.property_void_status,#(lf)        f.property_status,#(lf)        f.property_statecode,#(lf)        f.property_statuscode,#(lf)        f.dim_property_key,#(lf)        f.dim_property_tenancy_key,#(lf)#(lf)        f.void_checklist_id,#(lf)        f.ReverseRowNum#(lf)    FROM FinalCTE AS f#(lf))#(lf)SELECT#(lf)    property_id                    AS property_id,#(lf)    RecordType                     AS record_type,#(lf)    IntervalStartDate              AS interval_start_date,#(lf)    IntervalEndDate                AS interval_end_date,#(lf)    DaysInterval                   AS days_interval,#(lf)    DaysBetweenIntervals           AS days_between_intervals,#(lf)    VoidCategoryName               AS void_category_name,#(lf)    VoidStatusName                 AS void_status_name,#(lf)    VoidComments                   AS void_comments,#(lf)    TenancyName                    AS tenancy_name,#(lf)    TenancyID                      AS tenancy_id,#(lf)    TenancyReference               AS tenancy_reference,#(lf)    TenancyStatus                  AS tenancy_status,#(lf)    property_confirmed_disposal_date AS property_confirmed_disposal_date,#(lf)    property_acquired_date         AS property_acquired_date,#(lf)    property_void_status           AS property_void_status,#(lf)    property_status                AS property_status,#(lf)    property_statecode             AS property_statecode,#(lf)    property_statuscode            AS property_statuscode,#(lf)    dim_property_key              AS dim_property_key,#(lf)    dim_property_tenancy_key      AS dim_property_tenancy_key,#(lf)    void_checklist_id              AS void_checklist_id,#(lf)    ReverseRowNum                  AS reverse_row_num#(lf)FROM FinalOutput#(lf)--WHERE property_id = 'E41D7375-E8E1-4D0F-A72E-0BE8468F5D71'#(lf)--WHERE property_id = '83B74D35-F098-4D0C-914C-114C7ECFCFDE'#(lf)--WHERE property_id = 'D15066C3-4B69-44F1-842D-BEFA614A08F9'#(lf)--WHERE property_id = '38be05b9-cf17-ef11-840b-000d3a7a050d'#(lf)ORDER BY#(lf)    property_id,#(lf)    IntervalStartDate;#(lf)"]),
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, each ApplyNamingConventions(_)),
				    #"Reordered Columns" = Table.ReorderColumns(#"Transformed Column Names",{"Dim Property KEY", "Dim Property Tenancy KEY", "Property ID", "Record Type", "Interval Start Date", "Interval End Date", "Days Interval", "Days Between Intervals", "Void Category Name", "Void Status Name", "Void Comments", "Tenancy Name", "Tenancy ID", "Tenancy Reference", "Tenancy Status", "Property Confirmed Disposal Date", "Property Acquired Date", "Property Void Status", "Property Status", "Property Statecode", "Property Statuscode", "Void Checklist ID", "Reverse Row Num"})
				in
				    #"Reordered Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Exception

