	partition 'Fact Aged Debt' = m
		mode: import
		queryGroup: 'Fact Tables'
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="SELECT [fact_aged_debt_key]#(lf)      ,[dim_property_tenancy_key]#(lf)      ,[dim_property_key]#(lf)      ,[dim_property_program_key]#(lf)      ,[property_tenancy_id]#(lf)      ,[Property_id]#(lf)      ,[TenantName]#(lf)      ,[ChargeType]#(lf)      ,[AsAtDate]#(lf)      ,[Current_0_6]#(lf)      ,[Days_7_14]#(lf)      ,[Days_15_21]#(lf)      ,[Days_22_28]#(lf)      ,[Days_29_60]#(lf)      ,[Days_61_90]#(lf)      ,[Days_91_Plus]#(lf)      ,[ActualBalance]#(lf)      ,[LastPaymentDate]#(lf)      ,[NoRecentPayment]#(lf)      ,[HasNoOverallDebt]#(lf)      ,[DWHBatchId]#(lf)      ,[DWHCreatedAt]#(lf)      ,[DWHModifiedOn]#(lf)      ,[DWHDMLOperation]#(lf)      ,[DWHSourceSystem]#(lf)  FROM [edw].[fact_aged_debt]", CommandTimeout=#duration(0, 1, 30, 0)]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"NoRecentPayment", type logical}, {"LastPaymentDate", type date}, {"AsAtDate", type date}}),
				    #"Renamed Columns" = Table.RenameColumns(#"Changed Type",{{"AsAtDate", "As_At_Date"}, {"TenantName", "Tenant_Name"}, {"ChargeType", "Charge_Type"}, {"ActualBalance", "Total_Balance"}, {"LastPaymentDate", "Last_Payment_Date"}, {"NoRecentPayment", "No_Recent_Payment"}, {"Current_0_6", "Current_0-6"}, {"Days_7_14", "Days_7-14"}, {"Days_15_21", "Days_15-21"}, {"Days_22_28", "Days_22-28"}}),
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transformed Column Names" = Table.TransformColumnNames(#"Renamed Columns", each ApplyNamingConventions(_)),
				
				    // Step to add and convert date key columns
				    #"Added and Converted Date Columns" = List.Accumulate(
				        List.Select(Table.ColumnNames(#"Transformed Column Names"), each Text.EndsWith(_, " Date KEY")),
				        #"Transformed Column Names",
				        (state, columnName) =>
				            Table.AddColumn(
				                state,
				                Text.BeforeDelimiter(columnName, " KEY"),
				                each
				                    if Record.Field(_, columnName) <> null then
				                        let
				                            dateValue = Text.From(Record.Field(_, columnName)),
				                            yearPart = Text.Start(dateValue, 4),
				                            monthPart = Text.Middle(dateValue, 4, 2),
				                            dayPart = Text.End(dateValue, 2),
				                            formattedDate = yearPart & "-" & monthPart & "-" & dayPart
				                        in
				                            if Text.Length(dateValue) = 8 then
				                                Date.FromText(formattedDate)
				                            else
				                                null
				                    else
				                        null,
				                type date
				            )
				    ),
				
				    // Step to remove columns that start with "DWH" if needed
				    RemoveDWHColumns = Table.RemoveColumns(
				        #"Added and Converted Date Columns",
				        List.Select(Table.ColumnNames(#"Added and Converted Date Columns"), each Text.StartsWith(_, "DWH"))
				    ),
				    #"Renamed Columns1" = Table.RenameColumns(RemoveDWHColumns,{{"Hasnooveralldebt", "Has No Overall Debt"}})
				in
				    #"Renamed Columns1"

	annotation PBI_NavigationStepName = Navigation

