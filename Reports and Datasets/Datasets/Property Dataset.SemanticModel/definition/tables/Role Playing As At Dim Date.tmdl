	partition 'Role Playing As At Dim Date' = m
		mode: import
		queryGroup: 'Role Playing Date Tables'
		source =
				let
				    Source = Sql.Database(#"Server", #"Database"),
				    edw_dim_date = #"Dim Date",
				    AddPrefixToColumns = (columnName as text) as text =>
				        let
				            prefixedColumn = "As At " & columnName
				        in
				            prefixedColumn,
				    #"Prefixed Column Names" = Table.TransformColumnNames(edw_dim_date, each AddPrefixToColumns(_)),
				    #"Added Custom" = Table.AddColumn(#"Prefixed Column Names", "Current Date", each if [As At Current Date Flag] = 1 then "Today" else "Other Dates"),
				    #"Changed Type" = Table.TransformColumnTypes(#"Added Custom",{{"Current Date", type text}})
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

