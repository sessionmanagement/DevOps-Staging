	column 'Property Latest Assigned Tenancy Manager'
		dataType: string
		lineageTag: 7a427206-cee7-444f-aeb5-5aa222d08d50
		summarizeBy: none
		sourceColumn: Property Latest Assigned Tenancy Manager

		annotation SummarizationSetBy = Automatic

	partition 'Dim Property' = m
		mode: import
		queryGroup: 'Dim Tables'
		source = ```
				let
				    Source = Sql.Database(Server, Database, [Query="SELECT#(lf)    [dim_property_key],#(lf)    [property_id],#(lf)    [property_acquired_date],#(lf)    [property_bc_service_name],#(lf)    [property_assigned_tenancy_manager],#(lf)    [property_confirmed_disposal_date],#(lf)    [property_district],#(lf)    [property_name],#(lf)    [property_postal_region],#(lf)    [property_program],#(lf)    [property_sub_program]#(lf)FROM [edw].[vw_dim_property]"]),
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH      
				  Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, each ApplyNamingConventions(_)),
				    // Step to remove columns that start with "DWH" if needed
				    RemoveDWHColumns = Table.RemoveColumns(
				        #"Transformed Column Names",
				        List.Select(Table.ColumnNames(#"Transformed Column Names"), each Text.StartsWith(_, "DWH"))
				    ),
				    // Add new column with latest manager per Property ID
				    LatestManagerLookup =
				        let
				            // Create lookup table with latest manager per Property ID
				            GroupedByPropertyID = Table.Group(
				                RemoveDWHColumns,
				                {"Property ID"},
				                {{"MaxKey", each List.Max([#"Dim Property KEY"]), type nullable number}}
				            ),
				            JoinedForManager = Table.NestedJoin(
				                GroupedByPropertyID,
				                {"Property ID", "MaxKey"},
				                RemoveDWHColumns,
				                {"Property ID", "Dim Property KEY"},
				                "LatestRecord",
				                JoinKind.Inner
				            ),
				            ExpandedManager = Table.ExpandTableColumn(
				                JoinedForManager, "LatestRecord", {"Property Assigned Tenancy Manager"}, {"Latest Manager"}
				            ),
				            LookupTable = Table.SelectColumns(ExpandedManager, {"Property ID", "Latest Manager"})
				        in
				            LookupTable,
				    // Join the lookup table to add latest manager column
				    JoinedWithLatest = Table.NestedJoin(
				        RemoveDWHColumns, {"Property ID"}, LatestManagerLookup, {"Property ID"}, "LatestManagerTemp",
				        JoinKind.LeftOuter
				    ),
				    // Expand to create new column
				    AddedLatestManagerColumn = Table.ExpandTableColumn(
				        JoinedWithLatest, "LatestManagerTemp", {"Latest Manager"}, {"Property Latest Assigned Tenancy Manager"}
				    )
				in
				    AddedLatestManagerColumn
				
				/*let
				    Source = Sql.Database(Server, Database),
				    edw_dim_company = Source{[Schema="edw",Item="vw_dim_property"]}[Data],
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transformed Column Names" = Table.TransformColumnNames(edw_dim_company, each ApplyNamingConventions(_)),
				    
				    // Step to remove columns that start with "DWH" if needed
				    RemoveDWHColumns = Table.RemoveColumns(
				        #"Transformed Column Names",
				        List.Select(Table.ColumnNames(#"Transformed Column Names"), each Text.StartsWith(_, "DWH"))
				    )
				in
				    RemoveDWHColumns
				*/
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

