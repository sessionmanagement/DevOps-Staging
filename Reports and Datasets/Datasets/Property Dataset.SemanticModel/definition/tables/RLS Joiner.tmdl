	partition 'RLS Joiner' = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="-- ============================================================#(lf)-- Model:  Property Dataset#(lf)-- Table:  RLS Joiner#(lf)-- Source: native query (complex CTE/window) - emitted in full#(lf)-- Used columns: 2 (mapped 2, unmapped 0)  [full query, not trimmed]#(lf)-- Auto-generated from pbi_complete_dump.csv + model M + EDW/ODS schema.#(lf)-- Review before use; verify joins/filters against the model.#(lf)-- ============================================================#(lf)-- USED model columns: Dim Property KEY; Dim Service KEY#(lf)#(lf)WITH CurrentMatches AS (#(lf)    SELECT *#(lf)    FROM (#(lf)        SELECT#(lf)            dp.property_id,#(lf)            dp.dim_property_key,#(lf)            dp.property_name,#(lf)            dp.property_contract_bc_service_name,#(lf)            ds.dim_service_key,#(lf)            ds.service_name,#(lf)            ds.service_code,#(lf)            dp.DWHEffectiveFrom,#(lf)            ROW_NUMBER() OVER (#(lf)                PARTITION BY dp.dim_property_key #(lf)                ORDER BY dp.DWHEffectiveFrom DESC#(lf)            ) AS rn#(lf)        FROM edw.vw_dim_property dp#(lf)        LEFT JOIN edw.vw_dim_service ds #(lf)            ON ds.service_code = dp.property_contract_bc_service_code#(lf)    ) X#(lf)    WHERE rn = 1 -- Only keep the single most recent match per dim_property_key#(lf)),#(lf)FallbackMap AS (#(lf)    SELECT *#(lf)    FROM (#(lf)        SELECT#(lf)            property_id,#(lf)            dim_service_key AS fallback_service_key,#(lf)            service_name AS fallback_service_name,#(lf)            service_code AS fallback_service_code,#(lf)            ROW_NUMBER() OVER (#(lf)                PARTITION BY property_id #(lf)                ORDER BY DWHEffectiveFrom DESC#(lf)            ) AS rn#(lf)        FROM CurrentMatches#(lf)        WHERE dim_service_key IS NOT NULL#(lf)    ) Y#(lf)    WHERE rn = 1 -- Only one fallback record per property_id, the most recent successful match#(lf))#(lf)#(lf)SELECT#(lf)    dp.property_id,#(lf)    dp.dim_property_key,#(lf)    dp.property_name,#(lf)    COALESCE(cm.dim_service_key, fm.fallback_service_key) AS dim_service_key,#(lf)    COALESCE(cm.service_name, fm.fallback_service_name) AS service_name,#(lf)    COALESCE(cm.service_code, fm.fallback_service_code) AS service_code#(lf)FROM edw.vw_dim_property dp#(lf)LEFT JOIN CurrentMatches cm#(lf)    ON dp.dim_property_key = cm.dim_property_key #(lf)      AND cm.dim_service_key IS NOT NULL#(lf)LEFT JOIN FallbackMap fm#(lf)    ON dp.property_id = fm.property_id;#(lf)"]),
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, each ApplyNamingConventions(_)),
				
				    // Step to add and convert date key columns
				    #"Added and Converted Date Columns" = List.Accumulate(
				        List.Select(Table.ColumnNames(#"Transformed Column Names"), each Text.EndsWith(_, " Date KEY")),
				        #"Transformed Column Names",
				        (state, columnName) =>
				            Table.AddColumn(
				                state,
				                Text.BeforeDelimiter(columnName, " KEY"),
				                each
				                    if Record.Field(_, columnName) <> null then
				                        let
				                            dateValue = Text.From(Record.Field(_, columnName)),
				                            yearPart = Text.Start(dateValue, 4),
				                            monthPart = Text.Middle(dateValue, 4, 2),
				                            dayPart = Text.End(dateValue, 2),
				                            formattedDate = yearPart & "-" & monthPart & "-" & dayPart
				                        in
				                            if Text.Length(dateValue) = 8 then
				                                Date.FromText(formattedDate)
				                            else
				                                null
				                    else
				                        null,
				                type date
				            )
				    ),
				
				    // Step to remove columns that start with "DWH" if needed
				    RemoveDWHColumns = Table.RemoveColumns(
				        #"Added and Converted Date Columns",
				        List.Select(Table.ColumnNames(#"Added and Converted Date Columns"), each Text.StartsWith(_, "DWH"))
				    )
				in
				    RemoveDWHColumns

