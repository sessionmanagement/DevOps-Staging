	measure 'Tenancy Name Masked' =
			
			VAR _IsMaskedUser =
			    USERPRINCIPALNAME () IN VALUES ( 'Executinve Masking'[User Principal Name] )
			VAR _RawTenancyName =
			    SELECTEDVALUE ( 'Fact Vacant Tenantable Gap'[Tenancy Name] )
			VAR _TenancyReference =
			    SELECTEDVALUE ( 'Fact Vacant Tenantable Gap'[Tenancy Reference] ) /* Position of the delimiter " - " (zero if not found) */
			VAR _DelimiterPos =
			    FIND ( " - ", _RawTenancyName,, 0 ) /* Extract address = everything after the delimiter, trimmed.
			   If the delimiter is missing, use Tenancy Reference instead. */
			VAR _AddressOnly =
			    IF (
			        _DelimiterPos > 0,
			        TRIM (
			            MID (
			                _RawTenancyName,
			                _DelimiterPos + 3,
			                /* skip the 3‑char delimiter */
			                LEN ( _RawTenancyName ) - _DelimiterPos - 2 /* remaining length */
			            )
			        ),
			        _TenancyReference
			    )
			RETURN
			    IF ( _IsMaskedUser, _AddressOnly, _RawTenancyName )
		displayFolder: Data Masking
		lineageTag: c4b9e2af-6a01-4ad3-bcfd-02f715269e2a

	measure 'Total 29 to 60' =
			
			SUM ( 'Fact Aged Debt'[Days 29 60] )
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: Ageing Buckets
		lineageTag: b580d0b8-e2e9-4c4a-851e-b769cfb75912

		annotation PBI_FormatHint = {"currencyCulture":"en-NZ"}

	measure 'Total 61 to 90' =
			
			SUM ( 'Fact Aged Debt'[Days 61 90] )
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: Ageing Buckets
		lineageTag: 4f7a2f91-9c6a-4d25-8d28-8fb0e481728d

		annotation PBI_FormatHint = {"currencyCulture":"en-NZ"}

	measure 'Total 91 Plus' =
			
			SUM ( 'Fact Aged Debt'[Days 91 Plus] )
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: Ageing Buckets
		lineageTag: f66b5520-3752-4858-a9af-0c27c726ceb6

		annotation PBI_FormatHint = {"currencyCulture":"en-NZ"}

	measure 'Percent 60 Plus' =
			
			DIVIDE (
			    SUM ( 'Fact Aged Debt'[Days 61 90] ) + SUM ( 'Fact Aged Debt'[Days 91 Plus] ),
			    [Total Outstanding],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ce1f1b5a-5459-416f-bda6-bd1f8c603b22

	measure 'Percent 91 Plus' =
			
			DIVIDE ( [Total 91 Plus], [Total Outstanding], 0 )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 01bf4812-0f72-4212-9761-80d32887387c

	measure 'Overdue 28 Plus' =
			
			SUM ( 'Fact Aged Debt'[Days 29 60] ) + SUM ( 'Fact Aged Debt'[Days 61 90] )
			    + SUM ( 'Fact Aged Debt'[Days 91 Plus] )
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		lineageTag: 5bf24920-6720-4dde-ac24-1db0e8f5e7d7

		annotation PBI_FormatHint = {"currencyCulture":"en-NZ"}

	measure 'Tenants Severely Overdue Count' =
			
			CALCULATE (
			    DISTINCTCOUNT ( 'Fact Aged Debt'[Property Tenancy ID] ),
			    FILTER (
			        'Fact Aged Debt',
			        'Fact Aged Debt'[Days 61 90] < 0
			            || 'Fact Aged Debt'[Days 91 Plus] < 0
			    )
			)
		formatString: #,0
		lineageTag: 105888b2-e385-44d1-a1b9-7609da303e04

		annotation PBI_FormatHint = {"isDecimal":true}

	/// Returns 1 if current user is an executive (should see masked data), 0 otherwise
	measure 'Is Executive User' =
			
			IF (
			    USERPRINCIPALNAME () IN VALUES ( 'Executinve Masking'[User Principal Name] ),
			    1,
			    0
			)
		formatString: 0
		displayFolder: Data Masking
		lineageTag: a1b2c3d4-e5f6-7890-abcd-ef1234567890

	partition 'Measures Table' = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

