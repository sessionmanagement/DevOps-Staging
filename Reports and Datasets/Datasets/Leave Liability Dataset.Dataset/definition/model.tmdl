model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-NZ
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Workings

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Final Tables'

	annotation PBI_QueryGroupOrder = 1

queryGroup 'Helper Queries'

	annotation PBI_QueryGroupOrder = 2

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["intelli Jobs","DimBusinessUnits","MappingLeaveType","DimPeople","DimLeaveType","DimCompany","FactLeaveBalance","DimPeople working","_Measures","DimDate","Last Refreshed Date","Total Leave Balance Group","Sample File","Transform File","DimPeopleHierarchy","Data & Measure Definition Catalogue","FactLeaveBalanceSummary","Additional Access"]

annotation __TEdtr = 1

annotation PBI_ProTooling = ["DevMode"]

ref table DimPeople
ref table DimLeaveType
ref table DimCompany
ref table _Measures
ref table FactLeaveBalance
ref table DimBusinessUnits
ref table DimDate
ref table 'Last Refreshed Date'
ref table 'Total Leave Balance Group'
ref table MappingLeaveType
ref table DimPeopleHierarchy
ref table 'Data & Measure Definition Catalogue'
ref table FactLeaveBalanceSummary
ref table 'Additional Access'

ref role 'Additional Access'
ref role Public
ref role 'People Experience'
ref role 'Babu Test'
ref role 'Lolita Test'

ref cultureInfo en-US

