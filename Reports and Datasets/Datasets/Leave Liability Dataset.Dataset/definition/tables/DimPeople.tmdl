	partition DimPeople-761b2790-1a80-4808-a6db-65656ce7bdfc = m
		mode: import
		queryGroup: 'Final Tables'
		source =
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="SELECT#(lf)    [id],#(lf)    [code],#(lf)    [company_id],#(lf)    [standard_hours_per_week_value]#(lf)    ,[termination_date]#(lf)    ,[standard_hours_per_week_value]#(lf)    ,[standard_days_per_week_value]#(lf)FROM [Datapay].[employees]#(lf)  WHERE ODSIsCurrent=1;#(lf)"]),
				    /* 2023-05-10 GH - Identified that there are duplicates due to some employees having 2 records for 2 companies. Filtering out the records where the employee has left to match Intelli */
				    #"Add column to identify leavers" = Table.AddColumn(Source, "FilterOutLeavers", each if [termination_date] is null then null else if Date.From([termination_date]) < Date.From(DateTime.LocalNow()) then 1 else null),
				    #"Added Custom" = Table.AddColumn(#"Add column to identify leavers", "Total Hours Per Year", each [standard_hours_per_week_value] * 52),
				    #"Adding HoursPerDay" = Table.AddColumn(#"Added Custom", "HoursPerDay", each if [standard_days_per_week_value] = 0 then 0 else [standard_hours_per_week_value] / [standard_days_per_week_value]),
				    #"Merged Queries" = Table.NestedJoin(#"Adding HoursPerDay", {"code"}, #"DimPeople working", {"employeeNumber"}, "DimPeople working", JoinKind.LeftOuter),
				    #"Expanded DimPeople working" = Table.ExpandTableColumn(#"Merged Queries", "DimPeople working", {"people_id", "displayName", "employmentStatus", "primaryEmailAddress_email"}, {"people_id", "Kaimahi Name", "employmentStatus", "email"}),
				    #"Merged Queries1" = Table.NestedJoin(#"Expanded DimPeople working", {"code"}, #"intelli Jobs", {"person_employeeNumber"}, "intelli Jobs", JoinKind.LeftOuter),
				    #"Expanded intelli Jobs" = Table.ExpandTableColumn(#"Merged Queries1", "intelli Jobs", {"supervisorPerson_displayName"}, {"supervisorPerson_displayName"}),
				    #"Inserted Merged Column" = Table.AddColumn(#"Expanded intelli Jobs", "CompanyID+EmpID", each Text.Combine({[company_id], "+", Text.From([code], "en-US")}), type text),
				    #"Changed Type" = Table.TransformColumnTypes(#"Inserted Merged Column",{{"termination_date", type date}}),
				    #"Flag Active balances" =  Table.AddColumn(#"Changed Type", "StillAround", each if [termination_date] = null or DateTime.Date(DateTimeZone.UtcNow()) < [termination_date] then 1 else 0),
				    #"Filtered Rows" = Table.SelectRows(#"Flag Active balances", each ([StillAround] = 1))
				
				in
				    #"Filtered Rows"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

