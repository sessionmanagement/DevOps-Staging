	measure 'Entitled Annual Leave Balance' = ```
			
			    VAR EntitledBalance = CALCULATE(
			        SUMX(
			            FILTER(
			                FactLeaveBalance,
			                FactLeaveBalance[leave_name] = "Annual Leave" &&
			                FactLeaveBalance[Hourly Entitled Balance] >= 0
			            ),
			            FactLeaveBalance[Hourly Entitled Balance]
			        )
			    )
			    RETURN
			        IF(EntitledBalance < 0, BLANK(), EntitledBalance)
			
			```
		formatString: #,0.00
		displayFolder: Leave Balances
		lineageTag: 2685f2ea-b2c4-4e69-8181-899a9ac93e9f

	measure 'Average Sick Leave' = ```
			
			/* What is the average balance of sick leave */ 
			
			DIVIDE(
			    CALCULATE(
			        SUM('FactLeaveBalance'[Hourly Balance]),
			        FILTER(FactLeaveBalance,
			            FactLeaveBalance[Leave_Name] = "Sick Leave"
			        )
			    ),
			    CALCULATE(
			        COUNTROWS('FactLeaveBalance'),
			        FILTER(
			            FactLeaveBalance,
			            FactLeaveBalance[Leave_Name] = "Sick Leave"
			        )
			    )
			)
			
