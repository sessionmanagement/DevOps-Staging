	measure 'Accrual (Hours)' = ```
			
			    CALCULATE(
			        SUM(FactLeaveBalance[AccrualAtAnnivesary]),
			        FILTER(
			            FactLeaveBalance,
			            FactLeaveBalance[leave_name] = "Annual Leave"
			        )
			    )
			```
		lineageTag: 823a9580-f0b7-4bde-9742-0828cf079a30

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Percentage of Kaimahi 160-200' = ```
			
			VAR Total160to200 = 
			    CALCULATE (
			        COUNTROWS ( 
			            FILTER (
			                SUMMARIZE (
			                    FactLeaveBalance,
			                    FactLeaveBalance[CompanyID+EmpID],
			                    "Total Leave", [Total Leave]
			                ),
			                [Total Leave] > 160
			                &&
			                [Total Leave] < 200
			            )
			        )
			    )
			VAR TotalKaimahi = 
			    DISTINCTCOUNT(FactLeaveBalance[CompanyID+EmpID])
			VAR Total160to200Percentage =
			    DIVIDE ( Total160to200, TotalKaimahi )
			RETURN
			    IF (
			        ISBLANK ( TotalKaimahi ) || ISBLANK ( Total160to200 ),
			        BLANK(),
			        Total160to200Percentage
			    )
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Annual Leave Thresholds
		lineageTag: 48844209-8d7b-42eb-ac5f-714271dbbffd

