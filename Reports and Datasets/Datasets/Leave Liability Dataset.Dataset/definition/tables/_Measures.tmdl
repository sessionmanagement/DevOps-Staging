	measure 'Percentage of Kaimahi Over 200' = ```
			
			VAR TotalOver200 =
			    CALCULATE (
			        COUNTROWS (
			            FILTER (
			                SUMMARIZE (
			                    FactLeaveBalance,
			                    FactLeaveBalance[CompanyID+EmpID],
			                    "Total Leave", [Total Leave]
			                ),
			                [Total Leave] > 200
			            )
			        )
			    )
			VAR TotalKaimahi =
			    DISTINCTCOUNT ( FactLeaveBalance[CompanyID+EmpID] )
			VAR TotalOver200Percentage =
