	measure NewFiltersApplied =
			
			VAR __LeaveTypesCount = IF(ISFILTERED(MappingLeaveType[Leave Name]), COUNTROWS(VALUES(MappingLeaveType[Leave Name])), 0)
			VAR __LeaveType = IF(__LeaveTypesCount > 0, "| LEAVE TYPES CHOSEN: " & CONCATENATEX(FILTERS(MappingLeaveType[Leave Name]), MappingLeaveType[Leave Name], ", "), BLANK())
			
			VAR __BusinessEntityCount = IF(ISFILTERED(DimCompany[Business Entity]), COUNTROWS(VALUES(DimCompany[Business Entity])), 0)
			VAR __BusinessEntity = IF(__BusinessEntityCount > 0, "| BUSINESS ENTITIES CHOSEN: " & CONCATENATEX(FILTERS(DimCompany[Business Entity]), DimCompany[Business Entity], ", "), BLANK())
			
			VAR __KaimahiNames = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(DimPeople[Kaimahi Name]), NOT(ISBLANK(DimPeople[Kaimahi Name]))), DimPeople[Kaimahi Name], ASC),
			    "KaimahiName_Display", DimPeople[Kaimahi Name]
			)
			VAR __KaimahiCount = IF(ISFILTERED(DimPeople[Kaimahi Name]), COUNTROWS(VALUES(DimPeople[Kaimahi Name])), 0)
			
			VAR __ParentAreas = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(DimBusinessUnits[business_unit_hierarchy_level1_name]), NOT(ISBLANK(DimBusinessUnits[business_unit_hierarchy_level1_name]))), DimBusinessUnits[business_unit_hierarchy_level1_name], ASC),
			    "AreaParentName_display", DimBusinessUnits[business_unit_hierarchy_level1_name]
			)
			VAR __ParentAreasCount = IF(ISFILTERED(DimBusinessUnits[business_unit_hierarchy_level1_name]), COUNTROWS(VALUES(DimBusinessUnits[business_unit_hierarchy_level1_name])), 0)
			VAR __MoreParentAreas = IF(__ParentAreasCount > 10, " and " & (__ParentAreasCount - 10) & " more", "")
			
			VAR __Areas = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(DimBusinessUnits[business_unit_hierarchy_level2_name]), NOT(ISBLANK(DimBusinessUnits[business_unit_hierarchy_level2_name]))), DimBusinessUnits[business_unit_hierarchy_level2_name], ASC),
			    "AreaName_display", DimBusinessUnits[business_unit_hierarchy_level2_name]
			)
			VAR __AreasCount = IF(ISFILTERED(DimBusinessUnits[business_unit_hierarchy_level2_name]), COUNTROWS(VALUES(DimBusinessUnits[business_unit_hierarchy_level2_name])), 0)
			VAR __MoreAreas = IF(__AreasCount > 10, " and " & (__AreasCount - 10) & " more", "")
			
			VAR __Services = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(DimBusinessUnits[business_unit_hierarchy_level3_name]), NOT(ISBLANK(DimBusinessUnits[business_unit_hierarchy_level3_name]))), DimBusinessUnits[business_unit_hierarchy_level3_name], ASC),
			    "TeamName_display", DimBusinessUnits[business_unit_hierarchy_level3_name]
			)
			VAR __ServicesCount = IF(ISFILTERED(DimBusinessUnits[business_unit_hierarchy_level3_name]), COUNTROWS(VALUES(DimBusinessUnits[business_unit_hierarchy_level3_name])), 0)
			VAR __MoreServices = IF(__ServicesCount > 10, " and " & (__ServicesCount - 10) & " more", "")
			
			VAR _FC_ParentAreas = IF(__ParentAreasCount > 0, "| PARENT AREAS CHOSEN: " & CONCATENATEX(__ParentAreas, [AreaParentName_display], ", "), BLANK())
			VAR _FC_MoreParentAreas = IF(__ParentAreasCount > 10, " and " & (__ParentAreasCount - 10) & " more", "")
			VAR _FC_Areas = IF(__AreasCount > 0, "| AREAS CHOSEN: " & CONCATENATEX(__Areas, [AreaName_display], ", "), BLANK())
			VAR _FC_MoreAreas = IF(__AreasCount > 10, " and " & (__AreasCount - 10) & " more", "")
			VAR _FC_Services = IF(__ServicesCount > 0, "| SERVICES CHOSEN: " & CONCATENATEX(__Services, [TeamName_display], ", "), BLANK())
			VAR _FC_MoreServices = IF(__ServicesCount > 10, " and " & (__ServicesCount - 10) & " more", "")
			VAR _FC_KaimahiNames = IF(__KaimahiCount > 0, "| KAIMAHI CHOSEN: " & CONCATENATEX(__KaimahiNames, [KaimahiName_Display], ", "), BLANK())
			VAR _FC_MoreKaimahiNames = IF(__KaimahiCount > 10, " and " & (__KaimahiCount - 10) & " more", "")
			
			RETURN
			IF(
			    ISBLANK(_FC_ParentAreas) && ISBLANK(_FC_Areas) && ISBLANK(_FC_Services) && ISBLANK(__BusinessEntity) && ISBLANK(__LeaveType),
			    "",
			    "-- Summary of filters applied to page: " & _FC_ParentAreas & _FC_MoreParentAreas & _FC_Areas & _FC_MoreAreas & _FC_Services & _FC_MoreServices
			) &__BusinessEntity  & __LeaveType & _FC_KaimahiNames & _FC_MoreKaimahiNames
		displayFolder: Filters
		lineageTag: ece8f0f2-ad20-4e99-b1ce-86e689f261f6

	measure FactRowCount = COUNTROWS(FactLeaveBalance)
