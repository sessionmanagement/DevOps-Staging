		sourceColumn: Total Leave

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Total Leave Group' = ```
			
			SWITCH (
			    TRUE (),
			    'FactLeaveBalance'[Total Leave] >= 0
			        && 'FactLeaveBalance'[Total Leave] <= 50, "0-50 Hours",
			    'FactLeaveBalance'[Total Leave] > 50
			        && 'FactLeaveBalance'[Total Leave] <= 100, "51-100 Hours",
			    'FactLeaveBalance'[Total Leave] > 100
			        && 'FactLeaveBalance'[Total Leave] <= 130, "101-130 Hours",
			    'FactLeaveBalance'[Total Leave] > 130
			        && 'FactLeaveBalance'[Total Leave] <= 160, "131-160 Hours",
			    'FactLeaveBalance'[Total Leave] > 160
			        && 'FactLeaveBalance'[Total Leave] <= 200, "161-200 Hours",
			    'FactLeaveBalance'[Total Leave] > 200, "200+ Hours"
			)
			
			```
		lineageTag: 539ba277-981a-4fcf-a9e6-3b1c2327bfdb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

