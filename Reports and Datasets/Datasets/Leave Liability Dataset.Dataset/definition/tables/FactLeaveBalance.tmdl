	column 'Hourly Balance' = ```
			
			VAR LeaveName = FactLeaveBalance[leave_name]
			VAR Balance = FactLeaveBalance[balance]
			VAR StandardHoursPerWeek = RELATED(DimPeople[standard_hours_per_week_value])
			VAR HoursPerDay = RELATED(DimPeople[HoursPerDay])
			RETURN
			    SWITCH(
			        TRUE(),
			        LeaveName = "Annual Leave", Balance * StandardHoursPerWeek,
			        LeaveName = "Well Being Leave", Balance * HoursPerDay,
			        LeaveName = "Sick Leave", Balance * HoursPerDay,
			        LeaveName = "Alternative Holidays", Balance * HoursPerDay,
			        Balance
			    )
			
			```
		lineageTag: 9520dbaf-f737-41d4-b892-adfe2e9c2442
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

