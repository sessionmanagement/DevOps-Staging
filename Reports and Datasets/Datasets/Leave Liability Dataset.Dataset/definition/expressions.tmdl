expression 'intelli Jobs' =
		let
		    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="SELECT#(lf)       [person_id]#(lf)      ,[person_displayName]#(lf)      ,[person_employeeNumber]#(lf)      ,[location_id]#(lf)      ,[businessUnit_id]#(lf)      ,[supervisorPerson_displayName]#(lf)      ,[workType]#(lf)      ,[workClass]#(lf)#(tab)  ,[isprimaryjob]#(lf)#(tab)  ,[companystartdate]#(lf)#(tab)  ,[companyenddate]#(lf)#(tab)  ,jobStatus#(lf)  FROM [IntelliHR].[jobs]#(lf)  WHERE ODSIsCurrent=1#(lf)  --AND jobStatus IN( 'Current Job', 'Ending Job')#(lf)  AND isPrimaryJob = 1#(lf)AND ODSDMLOperation <> 'D'"])
		in
		    Source
	lineageTag: c429f6bf-6402-4fb0-97b5-120b9fa9ed40
	queryGroup: Workings

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression 'DimPeople working' =
		let
		    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="SELECT [people_id]#(lf)      ,[displayName]#(lf)      ,[employeeNumber]#(lf)      ,[primaryEmailAddress_email]#(lf)      ,[employmentStatus]#(lf)  FROM [IntelliHR].[people]#(lf)  WHERE ODSIsCurrent = 1"])
		in
		    Source
	lineageTag: 6bc9673f-511e-432f-9520-a286bd29fcc9
