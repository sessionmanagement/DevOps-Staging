    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Welcome to the ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI"
                    }
                  },
                  {
                    "value": "Waharoa Report",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI",
                      "color": "#018db1"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This report shows information from Waharoa.",
                    "textStyle": {
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "For more detailed information on the underlying data that the visuals are built upon, please click the question mark button in the top right-hand corner of any page.",
                    "textStyle": {
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How to use this report:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "From this page, you can set filters that will be applied throughout the report.",
                    "textStyle": {
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "On each page, you can change the filters rather than doing so by navigating back to this page. To access the filters on each page, click the menu icon in the top left-hand corner. Any changes you make will be reflected on all pages.",
                    "textStyle": {
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "If you wish to reset the filters and set them back to default, you can click the X button in the top right-hand corner from any page",
                    "textStyle": {
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "At the bottom of each page there is a text box detailing any filters that have explicitly been applied. If nothing is showing for Program, for example, it means that ",
                    "textStyle": {
                      "fontFamily": "Segoe UI"
                    }
                  },
                  {
                    "value": "all",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "textDecoration": "underline"
                    }
                  },
                  {
                    "value": " Programs are selected, and there is no active filter applied to that field.",
                    "textStyle": {
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Drill-through is enabled for visualisations that contains owners or property addresses, or where indicated on the report subtitle. Right-click on the row to drill-through and see greater detail for the record or year you have selected.",
                    "textStyle": {
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Please note that the Gender and Ethnicity slicers will ",
                    "textStyle": {
                      "fontFamily": "Segoe UI"
                    }
                  },
                  {
                    "value": "only",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "textDecoration": "underline"
                    }
                  },
                  {
                    "value": " affect tenancy data and will have no effect on property data.",
                    "textStyle": {
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "You will see this icon (     ) throughout the report. Click this icon to see the underlying data relating to the measure or visual.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13.3333px"
                    }
                  }
                ]
              }
