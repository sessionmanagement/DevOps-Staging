table template_1
	lineageTag: 08df5cef-b028-4688-a0c6-d823b6be43a5

	measure 'DV - Template1' = ```
			
			    IFERROR(
			        SWITCH(
			            SELECTEDVALUE(template_1[id]),
			            4,IF(ISBLANK([YoY Growth in Housing Portfolio %]),"No data",FORMAT([YoY Growth in Housing Portfolio %],"Percent")),
			            7,IF(ISBLANK([YoY Growth in Housing Portfolio #]),"No data",FORMAT([YoY Growth in Housing Portfolio #],"0,0")),
			            5,IF(ISBLANK([Average Age of Housing (Days)]),"No data",FORMAT([Average Age of Housing (Days)],"0.0"))/365,
			            6,IF(ISBLANK([Average Property Ownership Length (All)]),"No data",FORMAT([Average Property Ownership Length (All)],"0,0"))/365,
			            8,IF(ISBLANK([Housing Portfolio Count (by Year)]),"No data",FORMAT([Housing Portfolio Count (by Year)],"0,0")),
			            9,IF(ISBLANK([Number of properties owned in FY]),"No data",FORMAT([Number of properties owned in FY],"0,0")),
			            10,IF(ISBLANK([Number of properties leased in FY]),"No data",FORMAT([Number of properties leased in FY],"0,0"))
			        ),
			        "No Data"
			    )
			```
		lineageTag: a78170f3-e99c-4d0a-8ed5-35f8952f3486

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DV - Template1 - Prev Year' =
			
			VAR _year = SELECTEDVALUE(dim_date[financial_year_num])-1
			RETURN
			IFERROR(
			    CALCULATE(
			        [DV - Template1],
			        ALL(dim_date),
			        dim_date[financial_year_num] = _year
			    ),
			    "No Data"
			)
		lineageTag: d4226d4f-4105-43b8-b74d-4d258af66928

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Template 1 Difference %' = ```
			
			IFERROR(
			    IF(SELECTEDVALUE(template_1[id]) IN {4}, BLANK(),
			        ([DV - Template1 - Prev Year] - template_1[DV - Template1]) / [DV - Template1 - Prev Year])
			    * -1,
			    0
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f199e252-0470-45ba-862b-e56d5e2779aa

		changedProperty = IsHidden

