table dim_inspection
	lineageTag: 0185ac51-a682-412b-9c65-a1fb5b61057d

	column zav_inspectionid
		dataType: string
		lineageTag: 267fd95f-cde8-4ef9-99ae-a816aff15947
		summarizeBy: none
		sourceColumn: zav_inspectionid

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column zav_name
		dataType: string
		lineageTag: c34ac03b-9805-4f8b-9108-9faceaa797bb
		summarizeBy: none
		sourceColumn: zav_name

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition dim_inspection = m
		mode: import
		queryGroup: dimensions
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="WITH RecentInspections AS (#(lf)    SELECT#(lf)        fpi.property_inspection_id AS zav_inspectionid,#(lf)        fpi.property_inspection_name AS zav_name,#(lf)        COALESCE(fpi.property_inspection_modified_datetime, fpi.DWHModifiedOn) AS SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY fpi.property_inspection_id#(lf)            ORDER BY COALESCE(fpi.property_inspection_modified_datetime, fpi.DWHModifiedOn) DESC#(lf)        ) AS rn#(lf)    FROM [edw].[fact_property_inspection] fpi#(lf)    WHERE fpi.property_inspection_category IS NOT NULL#(lf)      AND fpi.DWHDMLOperation <> 'D'#(lf))#(lf)SELECT DISTINCT#(lf)    ri.zav_inspectionid,#(lf)    ri.zav_name#(lf)FROM RecentInspections ri#(lf)WHERE ri.rn = 1;"])
				in
				    Source

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

