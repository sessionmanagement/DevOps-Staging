_postalregionname,#(lf)    rp.zav_fulladdress,#(lf)    rp.zav_suburb,#(lf)    rp.zav_legalowneridname,#(lf)    rp.zav_giftedname,#(lf)    rp.zav_confirmeddisposaldate,#(lf)    rp.property_type,#(lf)    rp.tenantable_dwelling#(lf)FROM RankedProperties rp#(lf)WHERE rp.rn = 1;"]),
