	partition dim_inspection_category_type = m
		mode: import
		queryGroup: dimensions
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="WITH RecentZavInspection AS (#(lf)    SELECT#(lf)        fpi.property_inspection_category AS zav_inspectioncategoryname,#(lf)        fpi.property_inspection_type     AS zav_inspectiontypename,#(lf)        fpi.property_inspection_modified_datetime AS SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY fpi.property_inspection_category, fpi.property_inspection_type#(lf)            ORDER BY fpi.property_inspection_modified_datetime DESC#(lf)        ) AS rn#(lf)    FROM [edw].[fact_property_inspection] fpi#(lf)    WHERE fpi.property_inspection_category IS NOT NULL#(lf)      AND fpi.DWHDMLOperation <> 'D'#(lf))#(lf)SELECT DISTINCT#(lf)    #(lf)    rzi.zav_inspectioncategoryname,#(lf)    #(lf)    rzi.zav_inspectiontypename#(lf)FROM RecentZavInspection rzi#(lf)WHERE rzi.rn = 1#(lf)ORDER BY#(lf)    rzi.zav_inspectioncategoryname,#(lf)    rzi.zav_inspectiontypename;"]),
				    #"Inserted Merged Column" = Table.AddColumn(Source, "inspection_category_type_key", each Text.Combine({Text.From([zav_inspectioncategoryname], "en-NZ"), ":", Text.From([zav_inspectiontypename], "en-NZ")})),
				    #"Reordered Columns" = Table.ReorderColumns(#"Inserted Merged Column",{"inspection_category_type_key", "zav_inspectioncategoryname", "zav_inspectiontypename"})
				in
