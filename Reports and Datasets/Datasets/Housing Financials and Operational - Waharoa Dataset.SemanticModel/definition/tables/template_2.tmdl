table template_2
	lineageTag: 02b21bd7-d6c6-4ea0-b3fa-e97cbe1162a2

	measure 'DV - Template2 - Prev Year' =
			
			VAR _year = SELECTEDVALUE(dim_date[financial_year_num])-1
			RETURN
			CALCULATE(
			    [DV - Template2],
			    ALL(dim_date),
			    dim_date[financial_year_num] = _year
			)
		lineageTag: 8ec538d5-1139-4038-b448-b7e7b16535ae

		changedProperty = IsHidden

	measure 'DV - Template2' = ```
			
			    SWITCH(
			        SELECTEDVALUE(template_2[id]),
			        1,IF(ISBLANK([Number of Household Members for Tenancies Active in Selected FY]),"No data", FORMAT([Number of Household Members for Tenancies Active in Selected FY],"0,0")),
			        2,IF(ISBLANK([Average Number of Household Members for Tenancies Active in Selected FY]),"No data", FORMAT([Average Number of Household Members for Tenancies Active in Selected FY],"0.0")),
			        3,IF(ISBLANK([Number of Tenanted Properties]),"No data", FORMAT([Number of Tenanted Properties],"0,0")),
			        4,IF(ISBLANK([Number of Untenanted Properties]),"No data", FORMAT([Number of Untenanted Properties],"0,0")),
			        5,IF(ISBLANK([Average Tenancy Length (All)]),"No data", FORMAT([Average Tenancy Length (All)],"0,0")),
			        6,IF(ISBLANK([Average Tenancy Length for Tenancies Ended in Selected FY (Days)]),"No data",FORMAT([Average Tenancy Length for Tenancies Ended in Selected FY (Days)],"0,0")),
			        7,IF(ISBLANK([Average Tenancy Length for Tenancies Started in Selected FY (Days)]),"No data",FORMAT([Average Tenancy Length for Tenancies Started in Selected FY (Days)],"0,0")),
			        8,IF(ISBLANK([Number of tenancies started in FY]),"No data",FORMAT([Number of tenancies started in FY],"0,0")),
			        9,IF(ISBLANK([Number of tenancies ended in FY]),"No data",FORMAT([Number of tenancies ended in FY],"0,0"))
			    )
			```
		lineageTag: 56b5acb9-cd53-423b-9af6-576e3bb7d3cb

		changedProperty = IsHidden

	measure 'Template 2 Difference %' =
			
			IFERROR(
			([DV - Template2 - Prev Year] - [DV - Template2]) / [DV - Template2 - Prev Year]*-1,
			0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 5fb49cf9-ddf4-4e3f-af06-85098666ae33

		changedProperty = IsHidden

