	partition fact_tenancy_transaction_details-c5f85cd9-c0c6-42c5-b750-11812e159736 = m
		mode: import
		queryGroup: facts
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="WITH RecentTenancyTransactionDetails AS (#(lf)    SELECT#(lf)        fptt.property_tenancy_transaction_id AS zav_tenancytransactiondetailsid,#(lf)        fptt.property_tenancy_transaction_name AS zav_name,#(lf)        fptt.property_tenancy_transaction_suspense_account_flag AS new_suspenseaccount,#(lf)        fptt.property_tenancy_transaction_type_code AS new_transactiontypecode,#(lf)        fptt.property_tenancy_transaction_account_type AS zav_accounttype,#(lf)        fptt.property_tenancy_transaction_amount AS zav_amount,#(lf)        fptt.property_tenancy_transaction_comments AS zav_comments,#(lf)        TRY_CONVERT(date, CAST(fptt.property_tenancy_transaction_date_key AS char(8)), 112) AS zav_date,#(lf)        fptt.property_tenancy_transaction_bc_entry_number AS zav_propertyreferencenumber,#(lf)        fptt.property_tenancy_transaction_rent_nonrent AS zav_rent,#(lf)TRY_CONVERT(date, CAST(fptt.property_tenancy_transaction_rent_paid_to_date_key AS char(8)), 112) AS zav_rentpaidto,#(lf)         #(lf)        fptt.property_tenancy_id AS zav_tenancy,#(lf)        fptt.property_tenancy_transaction_credit_debit AS zav_transactionname,#(lf)        fptt.property_tenancy_transaction_type AS zav_transaction,#(lf)        fptt.property_tenancy_transaction_name AS zav_tenancyname,#(lf)        fptt.property_tenancy_transaction_type AS zav_transactiontypename,#(lf)        fptt.property_tenancy_transaction_subtransaction_name AS zav_subtransactionname,#(lf)        fptt.property_tenancy_transaction_created_datetime AS createdon,#(lf)        COALESCE(fptt.property_tenancy_transaction_modified_datetime, fptt.DWHModifiedOn) AS SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY fptt.property_tenancy_transaction_id#(lf)            ORDER BY COALESCE(fptt.property_tenancy_transaction_modified_datetime, fptt.DWHModifiedOn) DESC#(lf)        ) AS rn#(lf)    FROM edw.fact_property_tenancy_transaction fptt#(lf)    WHERE ISNULL(fptt.property_tenancy_transaction_suspense_account_flag, 0) = 0#(lf)      AND fptt.property_tenancy_transaction_id IS NOT NULL#(lf)      AND DWHDMLOperation <> 'd'#(lf))#(lf)SELECT DISTINCT#(lf)    rtt.zav_tenancytransactiondetailsid,#(lf)    rtt.zav_name,#(lf)    rtt.new_suspenseaccount,#(lf)    rtt.new_transactiontypecode,#(lf)    rtt.zav_accounttype AS zav_accounttypename,#(lf)    rtt.zav_amount,#(lf)    rtt.zav_comments,#(lf)    rtt.zav_date,#(lf)    rtt.zav_propertyreferencenumber,#(lf)    rtt.zav_rent AS zav_rentname,#(lf)    rtt.zav_rentpaidto,#(lf)    rtt.zav_tenancy,#(lf)    zav_transactionname,#(lf)    rtt.zav_tenancyname,#(lf)    rtt.zav_transactiontypename,#(lf)    rtt.zav_subtransactionname,#(lf)    rtt.createdon#(lf)FROM RecentTenancyTransactionDetails rtt#(lf)WHERE rtt.rn = 1;"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"zav_date", type datetime}}),
				    #"Merged Queries" = Table.NestedJoin(#"Changed Type", {"zav_tenancy"}, fact_tenancy, {"opportunityid"}, "fact_tenancy", JoinKind.LeftOuter),
				    #"Expanded fact_tenancy" = Table.ExpandTableColumn(#"Merged Queries", "fact_tenancy", {"zav_property", "zav_subprogram", "zav_tenancystartdate", "zav_vacateddate", "tenancymanagerid", "region_name", "tenancy_has_unresolved_breach", "tenancy_has_open_tenancytribunal_dispute"}, {"zav_property", "zav_subprogram", "zav_tenancystartdate", "zav_vacateddate", "tenancymanagerid", "region_name", "tenancy_has_unresolved_breach", "tenancy_has_open_tenancytribunal_dispute"})
				in
				    #"Expanded fact_tenancy"

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

