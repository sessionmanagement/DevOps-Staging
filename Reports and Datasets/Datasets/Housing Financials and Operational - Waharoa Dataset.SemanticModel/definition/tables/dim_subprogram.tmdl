	partition dim_subprogram-7a345b4d-81ba-44ca-b9df-ce8a500788bf = m
		mode: import
		queryGroup: dimensions
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query=" SELECT#(lf)        dpp.property_subprogram_id   AS zav_subprogramid,#(lf)        dpp.property_subprogram_name AS subprogram_name,#(lf)           dpp.property_program_id AS zav_program,#(lf)       #(lf)        dpp.property_program_name    AS program_name#(lf)        #(lf)     #(lf)        #(lf)    FROM [edw].[dim_property_program] dpp#(lf)    WHERE dpp.property_subprogram_id IS NOT NULL#(lf)      AND dpp.DWHDMLOperation <> 'D'#(lf)      AND DWHIsCurrent = 1#(lf)      AND dpp.property_program_name <> 'Unknown'"]),
				    #"Added Conditional Column" = Table.AddColumn(Source, "commercial_yn", each if Text.Contains([program_name], "Commercial") then 1 else 0),
				    #"Changed Type" = Table.TransformColumnTypes(#"Added Conditional Column",{{"commercial_yn", Int64.Type}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"zav_program"})
				in
				    #"Removed Columns"

