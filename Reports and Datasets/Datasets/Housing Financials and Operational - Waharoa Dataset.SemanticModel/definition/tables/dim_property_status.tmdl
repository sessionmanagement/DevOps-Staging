table dim_property_status
	lineageTag: 423fa5b9-024d-45e8-b155-71c7795d9dec

	column statuscode
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 39a2698c-3c52-4053-9a19-0bdbbed9ef8a
		summarizeBy: none
		sourceColumn: statuscode

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column statuscodename
		dataType: string
		lineageTag: 511be108-83f4-474f-976e-abf495b914fb
		summarizeBy: none
		sourceColumn: statuscodename

		annotation SummarizationSetBy = Automatic

	partition dim_property_status-0d3abb71-2ecc-45bc-8fad-7ad786268036 = m
		mode: import
		queryGroup: dimensions
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="WITH RecentStatus AS (#(lf)    SELECT#(lf)        dp.property_statuscode AS property_statuscode_text,#(lf)        dp.synapse_link_sink_modified_on,#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY dp.property_statuscode#(lf)            ORDER BY dp.synapse_link_sink_modified_on DESC#(lf)        ) AS rn#(lf)    FROM [edw].[dim_property] dp#(lf)    WHERE dp.DWHIsCurrent = 1#(lf)      AND dp.DWHDMLOperation <> 'D'#(lf)      AND dp.property_id IS NOT NULL#(lf)      AND dp.property_statuscode IS NOT NULL#(lf)),#(lf)MappedStatus AS (#(lf)    SELECT#(lf)        CASE UPPER(LTRIM(RTRIM(property_statuscode_text)))#(lf)            WHEN 'DISPOSED' THEN 100000000#(lf)            WHEN 'INACTIVE' THEN 2#(lf)            WHEN 'ACTIVE' THEN 1#(lf)            ELSE NULL#(lf)        END AS statuscode,#(lf)        property_statuscode_text AS statuscodename,#(lf)        rn#(lf)    FROM RecentStatus#(lf))#(lf)SELECT DISTINCT#(lf)    ms.statuscode,#(lf)    ms.statuscodename#(lf)FROM MappedStatus ms#(lf)WHERE ms.rn = 1#(lf)  AND ms.statuscode IS NOT NULL#(lf)ORDER BY ms.statuscode DESC;"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

