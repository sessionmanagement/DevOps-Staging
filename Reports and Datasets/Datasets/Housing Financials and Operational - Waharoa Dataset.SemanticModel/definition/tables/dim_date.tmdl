	column calendar_month_year_combined =
			
			dim_date[calendar_month_name_short] & "-" & RIGHT(YEAR(dim_date[calendar_date]),2)
		lineageTag: b9a69ded-25e6-4fd6-b521-98ce7ab35536
		summarizeBy: none
		sortByColumn: calendar_last_day_of_month_date

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column calendar_month_offset =
			
			VAR _currentDate = TODAY()
			VAR _selectedDate = dim_date[calendar_date]
			VAR _currentYear = YEAR(_currentDate)
			VAR _currentMonth = MONTH(_currentDate)
			VAR _selectedYear = YEAR(_selectedDate)
			VAR _selectedMonth = MONTH(_selectedDate)
			
			VAR _totalCurrentMonths = (_currentYear * 12) + _currentMonth
			VAR _totalSelectedMonths = (_selectedYear * 12) + _selectedMonth
			
			RETURN
			(_totalCurrentMonths - _totalSelectedMonths) * -1
		isHidden
		formatString: 0
		lineageTag: de726fff-d761-404e-91ba-c360242c2978
		summarizeBy: sum
		sortByColumn: calendar_last_day_of_month_date

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

