	measure 'Number of Tenanted Properties' =
			
			VAR SelectedFinancialYearStart = CALCULATE(MIN('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))
			VAR SelectedFinancialYearEnd = CALCULATE(MAX('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))
			RETURN
			    CALCULATE(DISTINCTCOUNT(dim_property[zav_propertyid]),
			    ALL(dim_date),
			    dim_property[zav_acquireddate] <= SelectedFinancialYearEnd,
			    OR(dim_property[zav_confirmeddisposaldate] > SelectedFinancialYearEnd, ISBLANK(dim_property[zav_confirmeddisposaldate])),
			    fact_tenancy[zav_tenancystartdate] <= SelectedFinancialYearEnd,
			    OR(fact_tenancy[zav_vacateddate] > SelectedFinancialYearEnd, ISBLANK(fact_tenancy[zav_vacateddate]))
			    )
		formatString: #,0
		isHidden
		displayFolder: 2. Measures
		lineageTag: 04048443-2a6d-4811-8684-f9f1349f2d6e

	measure 'Number of Untenanted Properties' =
			
			VAR SelectedFinancialYearStart = CALCULATE(MIN('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))
			VAR SelectedFinancialYearEnd = CALCULATE(MAX('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))
			RETURN
			    CALCULATE(DISTINCTCOUNT(dim_property[zav_propertyid]),
			    ALL(dim_date),
			    dim_property[zav_acquireddate] <= SelectedFinancialYearEnd,
			    OR(dim_property[zav_confirmeddisposaldate] > SelectedFinancialYearEnd, ISBLANK(dim_property[zav_confirmeddisposaldate])),
			    OR(fact_tenancy[zav_tenancystartdate] > SelectedFinancialYearEnd, fact_tenancy[zav_tenancystartdate] < SelectedFinancialYearStart),
			    OR(fact_tenancy[zav_vacateddate] < SelectedFinancialYearStart, fact_tenancy[zav_vacateddate] > SelectedFinancialYearEnd)
			    )
		formatString: #,0
		isHidden
		displayFolder: 2. Measures
		lineageTag: abf296dd-24ca-45e4-816b-af4186d2087b

