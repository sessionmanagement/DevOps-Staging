	measure 'YoY Growth in Housing Portfolio %' = ```
			
			
			--date variables
			VAR SelectedFinancialYearStart = CALCULATE(MIN('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))
			VAR SelectedFinancialYearEnd = CALCULATE(MAX('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))
			VAR PrevFinancialYearStart = CALCULATE(MIN('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num])-1)
			VAR PrevFinancialYearEnd = CALCULATE(MAX('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num])-1)
			
			--housing count variables
			VAR PrevFinancialYearCount = 
			CALCULATE(
			    COUNTROWS(fact_property),
			    ALL(dim_date),
			    dim_property[zav_acquireddate] <= PrevFinancialYearEnd,
			    OR(ISBLANK(dim_property[zav_confirmeddisposaldate]),dim_property[zav_confirmeddisposaldate] > PrevFinancialYearEnd)
			)
			
			VAR SelectedFinancialYearCount = 
			CALCULATE(
			    COUNTROWS(fact_property),
			    ALL(dim_date),
			    dim_property[zav_acquireddate] <= SelectedFinancialYearEnd,
			    OR(ISBLANK(dim_property[zav_confirmeddisposaldate]),dim_property[zav_confirmeddisposaldate] > SelectedFinancialYearEnd)
			)
			
			RETURN
			(SelectedFinancialYearCount - PrevFinancialYearCount) / SelectedFinancialYearCount
			```
		formatString: 0%;-0%;0%
		isHidden
		displayFolder: 2. Measures
		lineageTag: 990643cd-409c-454c-bec2-b2381ea90294

	measure 'YoY Growth in Housing Portfolio #' = ```
			
			VAR _Acquired = IF(
			    ISBLANK(DISTINCTCOUNT(fact_property[zav_propertyid])),0,DISTINCTCOUNT(fact_property[zav_propertyid]))
			VAR _Disposed = IF(
			    ISBLANK(DISTINCTCOUNT(fact_property_for_disposed[zav_propertyid])),0,DISTINCTCOUNT(fact_property_for_disposed[zav_propertyid]))
			
			RETURN
			_Acquired - _Disposed
			
			/*
			
			--Simplified measure above. Original below.
			
			--date variables
			VAR SelectedFinancialYearStart = CALCULATE(MIN('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))
			VAR SelectedFinancialYearEnd = CALCULATE(MAX('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))
			VAR PrevFinancialYearStart = CALCULATE(MIN('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num])-1)
			VAR PrevFinancialYearEnd = CALCULATE(MAX('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num])-1)
			
			--housing count variables
			VAR PrevFinancialYearCount = 
			CALCULATE(
			    COUNTROWS(fact_property),
			    ALL(dim_date),
			    dim_property[zav_acquireddate] <= PrevFinancialYearEnd,
			    OR(ISBLANK(dim_property[zav_confirmeddisposaldate]),dim_property[zav_confirmeddisposaldate] > PrevFinancialYearEnd)
			)
			
			VAR SelectedFinancialYearCount = 
			CALCULATE(
			    COUNTROWS(fact_property),
			    ALL(dim_date),
			    dim_property[zav_acquireddate] <= SelectedFinancialYearEnd,
			    OR(ISBLANK(dim_property[zav_confirmeddisposaldate]),dim_property[zav_confirmeddisposaldate] > SelectedFinancialYearEnd)
			)
			
			RETURN
			SelectedFinancialYearCount - PrevFinancialYearCount
			*/
			```
		formatString: 0
		isHidden
		displayFolder: 2. Measures
		lineageTag: 85674381-7c5e-485f-8d34-6da328c470d3

	measure 'Housing Portfolio Count (by Year) 2' =
			
			VAR _FYStart = SELECTEDVALUE(dim_date[financial_first_day_of_year_date])
			VAR _FYEnd = SELECTEDVALUE(dim_date[financial_last_day_of_year_date])
			RETURN
			CALCULATE(
			    COUNTROWS(dim_property),
			    ALL(dim_date),
			    PropertyOwnershipDaysByFY[BeginPropertyOwnershipDateForFY] >= _FYStart,
			    PropertyOwnershipDaysByFY[BeginPropertyOwnershipDateForFY] <= _FYEnd
			)
		formatString: #,0
		isHidden
		displayFolder: 2. Measures
		lineageTag: 16e2b431-16c5-4d01-a7bf-d55560396eca

