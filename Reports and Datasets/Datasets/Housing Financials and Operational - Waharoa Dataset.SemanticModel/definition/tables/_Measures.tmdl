table _Measures
	lineageTag: ed0c1696-2b27-484e-aa11-546df4b7b894

	measure IsActiveDuringSelectedFY =
			
			VAR SelectedFinancialYearStart = CALCULATE(MIN('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))
			VAR SelectedFinancialYearEnd = CALCULATE(MAX('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))
			
			RETURN
			IF (
			    NOT ISBLANK(SELECTEDVALUE(fact_tenancy[zav_tenancystartdate])) &&
			    CALCULATE (
			        COUNTROWS (
			            FILTER (
			                fact_tenancy,
			                SELECTEDVALUE(fact_tenancy[zav_tenancystartdate]) <= SelectedFinancialYearEnd &&
			                (ISBLANK(SELECTEDVALUE(fact_tenancy[zav_vacateddate])) || SELECTEDVALUE(fact_tenancy[zav_vacateddate]) > SelectedFinancialYearStart)
			            )
			        )
			    ) > 0,
			    1,
			    0
			)
		formatString: #,0
		isHidden
		displayFolder: 2. Measures
		lineageTag: 50a5ed40-8ef8-4fbe-817a-b4a7667d018c

	measure 'Average Tenancy Length (Days)' = ```
			
			VAR SelectedFinancialYearStart = CALCULATE(MIN('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))
			VAR SelectedFinancialYearEnd = CALCULATE(MAX('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))
			
			RETURN
			CALCULATE (
			    AVERAGE (fact_tenancy[Tenancy Length (Days)]),
			    FILTER (
			        ALL (dim_date),
			        'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num])
			    ),
			    FILTER (
			        fact_tenancy,
			        NOT ISBLANK(fact_tenancy[zav_tenancystartdate]) &&
			        fact_tenancy[zav_tenancystartdate] <= SelectedFinancialYearEnd &&
			        (ISBLANK(fact_tenancy[zav_vacateddate]) || fact_tenancy[zav_vacateddate] > SelectedFinancialYearStart)
			    )
			)
			
			```
		isHidden
		displayFolder: 2. Measures
		lineageTag: 7f4817e6-88aa-460d-8306-ec4bbc84a8d1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Tenancy Length (All)' =
			
			//CALCULATE(AVERAGE(fact_tenancy[Tenancy Length (Days)]),ALL(dim_date), SELECTEDVALUE(dim_date[financial_year_num]) >= dim_date[financial_year_num]) --old measure that didn't account for the selected FY i.e. not include tenancy lengths after the end of the FY.
			CALCULATE(AVERAGE(TenancyDaysByFY[tenancy_active_days_from_actual_start_to_end_in_fy]),ALL(dim_date),SELECTEDVALUE(dim_date[financial_year_num]) >= dim_date[financial_year_num])
		formatString: 0
		isHidden
		displayFolder: 2. Measures
		lineageTag: 4d0da421-24d6-4090-acf1-b79403dae271

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Average Tenancy Length for Tenancies Ended in Selected FY (Days)' =
			
			VAR SelectedFinancialYearStart = CALCULATE(MIN('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))
			VAR SelectedFinancialYearEnd = CALCULATE(MAX('dim_date'[calendar_date]), ALL('dim_date'), 'dim_date'[financial_year_num] = SELECTEDVALUE('dim_date'[financial_year_num]))
			
			RETURN
			CALCULATE (
			    AVERAGE (fact_tenancy[Tenancy Length (Days)]),
			    ALL(dim_date),
			    fact_tenancy[zav_vacateddate] >= SelectedFinancialYearStart,
			    fact_tenancy[zav_vacateddate] <= SelectedFinancialYearEnd
			)
		isHidden
		displayFolder: 2. Measures
		lineageTag: 6da0043e-b5cb-41c2-816d-72755db7791d

