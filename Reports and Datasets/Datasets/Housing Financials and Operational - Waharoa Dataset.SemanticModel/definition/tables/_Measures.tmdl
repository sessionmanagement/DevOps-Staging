	measure FiltersApplied =
			
			VAR __1FinYear = IF(ISFILTERED(dim_date[financial_year_num]), CONCATENATEX(FILTERS(dim_date[financial_year_num]), dim_date[financial_year_num], ", "), BLANK())
			
			VAR __2LegalOwnerIDNames = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(dim_property[zav_legalowneridname]), NOT(ISBLANK(dim_property[zav_legalowneridname]))), dim_property[zav_legalowneridname], ASC),
			    "LegalOwnerIDName_display", dim_property[zav_legalowneridname]
			)
			VAR __3LegalOwnerIDNamesCount = IF(ISFILTERED(dim_property[zav_legalowneridname]), COUNTROWS(VALUES(dim_property[zav_legalowneridname])), 0)
			VAR __4MoreLegalOwnerIDNames = IF(__3LegalOwnerIDNamesCount > 10, " and " & (__3LegalOwnerIDNamesCount - 10) & " more", "")
			
			VAR __5ProgramNames = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(dim_subprogram[program_name]), NOT(ISBLANK(dim_subprogram[program_name]))), dim_subprogram[program_name], ASC),
			    "ProgramName_display", dim_subprogram[program_name]
			)
			VAR __6ProgramNamesCount = IF(ISFILTERED(dim_subprogram[program_name]), COUNTROWS(VALUES(dim_subprogram[program_name])), 0)
			VAR __7MoreProgramNames = IF(__6ProgramNamesCount > 10, " and " & (__6ProgramNamesCount - 10) & " more", "")
			
			VAR __8SubprogramNames = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(dim_subprogram[subprogram_name]), NOT(ISBLANK(dim_subprogram[subprogram_name]))), dim_subprogram[subprogram_name], ASC),
			    "SubprogramName_display", dim_subprogram[subprogram_name]
			)
			VAR __9SubprogramNamesCount = IF(ISFILTERED(dim_subprogram[subprogram_name]), COUNTROWS(VALUES(dim_subprogram[subprogram_name])), 0)
			VAR __10MoreSubprogramNames = IF(__9SubprogramNamesCount > 10, " and " & (__9SubprogramNamesCount - 10) & " more", "")
			
			VAR __11FullAddresses = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES(dim_property[zav_fulladdress]), NOT(ISBLANK(dim_property[zav_fulladdress]))), dim_property[zav_fulladdress], ASC),
			    "FullAddress_display", dim_property[zav_fulladdress]
			)
			VAR __12FullAddressesCount = IF(ISFILTERED(dim_property[zav_fulladdress]), COUNTROWS(VALUES(dim_property[zav_fulladdress])), 0)
			VAR __13MoreFullAddresses = IF(__12FullAddressesCount > 5, " and " & (__12FullAddressesCount - 5) & " more", "")
			
			// New Filter for Rent Name
			VAR __14RentNames = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(fact_tenancy_transaction_details[zav_rentname]), NOT(ISBLANK(fact_tenancy_transaction_details[zav_rentname]))), fact_tenancy_transaction_details[zav_rentname], ASC),
			    "RentName_display", fact_tenancy_transaction_details[zav_rentname]
			)
			VAR __15RentNamesCount = IF(ISFILTERED(fact_tenancy_transaction_details[zav_rentname]), COUNTROWS(VALUES(fact_tenancy_transaction_details[zav_rentname])), 0)
			VAR __16MoreRentNames = IF(__15RentNamesCount > 10, " and " & (__15RentNamesCount - 10) & " more", "")
			
			// New Filter for Account Type Name
			VAR __17AccountTypeNames = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(fact_tenancy_transaction_details[zav_accounttypename]), NOT(ISBLANK(fact_tenancy_transaction_details[zav_accounttypename]))), fact_tenancy_transaction_details[zav_accounttypename], ASC),
			    "AccountTypeName_display", fact_tenancy_transaction_details[zav_accounttypename]
			)
			VAR __18AccountTypeNamesCount = IF(ISFILTERED(fact_tenancy_transaction_details[zav_accounttypename]), COUNTROWS(VALUES(fact_tenancy_transaction_details[zav_accounttypename])), 0)
			VAR __19MoreAccountTypeNames = IF(__18AccountTypeNamesCount > 10, " and " & (__18AccountTypeNamesCount - 10) & " more", "")
			
			// New Filter for Transaction Type Name
			VAR __20TransactionTypeNames = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(fact_tenancy_transaction_details[zav_transactiontypename]), NOT(ISBLANK(fact_tenancy_transaction_details[zav_transactiontypename]))), fact_tenancy_transaction_details[zav_transactiontypename], ASC),
			    "TransactionTypeName_display", fact_tenancy_transaction_details[zav_transactiontypename]
			)
			VAR __21TransactionTypeNamesCount = IF(ISFILTERED(fact_tenancy_transaction_details[zav_transactiontypename]), COUNTROWS(VALUES(fact_tenancy_transaction_details[zav_transactiontypename])), 0)
			VAR __22MoreTransactionTypeNames = IF(__21TransactionTypeNamesCount > 10, " and " & (__21TransactionTypeNamesCount - 10) & " more", "")
			
			
			VAR _FC_1FinYear = IF(ISBLANK(__1FinYear), BLANK(), "FINANCIAL YEAR CHOSEN: " & __1FinYear)
			VAR _FC_2LegalOwnerIDNames = IF(__3LegalOwnerIDNamesCount > 0, "-- OWNERS CHOSEN: " & CONCATENATEX(__2LegalOwnerIDNames, [LegalOwnerIDName_display], ", "), BLANK())
			VAR _FC_3MoreLegalOwnerIDNames = IF(__3LegalOwnerIDNamesCount > 10, " and " & (__3LegalOwnerIDNamesCount - 10) & " more", "")
			VAR _FC_4ProgramNames = IF(__6ProgramNamesCount > 0, "-- PROGRAMS CHOSEN: " & CONCATENATEX(__5ProgramNames, [ProgramName_display], ", "), BLANK())
			VAR _FC_5MoreProgramNames = IF(__6ProgramNamesCount > 10, " and " & (__6ProgramNamesCount - 10) & " more", "")
			
			VAR _FC_6SubprogramNames = IF(__9SubprogramNamesCount > 0, "-- SUBPROGRAMS CHOSEN: " & CONCATENATEX(__8SubprogramNames, [SubprogramName_display], ", "), BLANK())
			VAR _FC_7MoreSubprogramNames = IF(__9SubprogramNamesCount > 10, " and " & (__9SubprogramNamesCount - 10) & " more", "")
			
			VAR _FC_8FullAddresses = IF(__12FullAddressesCount > 0, "-- PROPERTY ADDRESSES CHOSEN: " & CONCATENATEX(__11FullAddresses, [FullAddress_display], ", "), BLANK())
			VAR _FC_9MoreFullAddresses = IF(__12FullAddressesCount > 5, " and " & (__12FullAddressesCount - 5) & " more", "")
			
			VAR _FC_10RentNames = IF(__15RentNamesCount > 0, "-- RENT TYPES CHOSEN: " & CONCATENATEX(__14RentNames, [RentName_display], ", "), BLANK())
			VAR _FC_11MoreRentNames = IF(__15RentNamesCount > 10, " and " & (__15RentNamesCount - 10) & " more", "")
			VAR _FC_12AccountTypeNames = IF(__18AccountTypeNamesCount > 0, "-- ACCOUNT TYPES CHOSEN: " & CONCATENATEX(__17AccountTypeNames, [AccountTypeName_display], ", "), BLANK())
			VAR _FC_13MoreAccountTypeNames = IF(__18AccountTypeNamesCount > 10, " and " & (__18AccountTypeNamesCount - 10) & " more", "")
			VAR _FC_14TransactionTypeNames = IF(__21TransactionTypeNamesCount > 0, "-- TRANSACTION TYPES CHOSEN: " & CONCATENATEX(__20TransactionTypeNames, [TransactionTypeName_display], ", "), BLANK())
			VAR _FC_15MoreTransactionTypeNames = IF(__21TransactionTypeNamesCount > 10, " and " & (__21TransactionTypeNamesCount - 10) & " more", "")
			
			VAR _FirstDate = MIN(dim_date[calendar_date])
			VAR _LastDate = MAX(dim_date[calendar_date])
			RETURN
			"(" & FORMAT(_FirstDate, "dd/MM/YYYY") & " - " & FORMAT(_LastDate, "dd/MM/YYYY") & ") " &
			IF(
			    ISBLANK(_FC_2LegalOwnerIDNames) && ISBLANK(_FC_4ProgramNames) && ISBLANK(_FC_6SubprogramNames) && ISBLANK(_FC_8FullAddresses) && ISBLANK(_FC_10RentNames) && ISBLANK(_FC_12AccountTypeNames) && ISBLANK(_FC_14TransactionTypeNames),
			    "",
			    "and other selected fields: " & " " & _FC_2LegalOwnerIDNames & _FC_3MoreLegalOwnerIDNames & " " & _FC_4ProgramNames & _FC_5MoreProgramNames & " " & _FC_6SubprogramNames & _FC_7MoreSubprogramNames & " " & _FC_8FullAddresses & _FC_9MoreFullAddresses & " " & _FC_10RentNames & _FC_11MoreRentNames & " " & _FC_12AccountTypeNames & _FC_13MoreAccountTypeNames & " " & _FC_14TransactionTypeNames & _FC_15MoreTransactionTypeNames
			)
		isHidden
		displayFolder: 3. Applied Filters
		lineageTag: ec2bd5a0-bb55-4fde-bb1d-eb6301709819

