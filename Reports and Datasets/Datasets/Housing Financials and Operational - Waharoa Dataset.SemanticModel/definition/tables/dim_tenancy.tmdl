	partition dim_tenancy = m
		mode: import
		queryGroup: dimensions
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="SELECT#(lf)    dpt.property_tenancy_id AS opportunityid, #(lf)    dpt.property_tenancy_tenancy_name AS name,#(lf)    dpt.property_tenancy_vacated_date AS zav_vacateddate#(lf)FROM [edw].[dim_property_tenancy] dpt#(lf)WHERE dpt.property_tenancy_id IS NOT NULL#(lf)and DWHIsCurrent = 1#(lf)      AND dpt.DWHDMLOperation <> 'D'#(lf)      AND ISNULL(dpt.property_tenant_opportunity_status, '') <> 'Cancelled'"]),
				    #"Added Conditional Column" = Table.AddColumn(Source, "tenancy_is_active", each if [zav_vacateddate] = null then "Yes" else "No"),
				    #"Removed Duplicates" = Table.Distinct(#"Added Conditional Column", {"opportunityid"}),
				    #"Removed Columns" = Table.RemoveColumns(#"Removed Duplicates",{"zav_vacateddate"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

