	partition fact_tenancy-86a0de21-ed98-43c9-bb49-729f3ff2eee1 = m
		mode: import
		queryGroup: facts
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="WITH RecentSubprogram AS (#(lf)    SELECT#(lf)        fpt.property_tenancy_id,#(lf)        fpt.property_subprogram_id,#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY fpt.property_tenancy_id#(lf)            ORDER BY COALESCE(fpt.property_tenant_modified_datetime, fpt.DWHModifiedOn) DESC#(lf)        ) AS rn#(lf)    FROM [edw].[fact_property_tenant] fpt#(lf)    WHERE fpt.DWHDMLOperation <> 'D'#(lf)),#(lf)RecentOpportunities AS (#(lf)    SELECT#(lf)        dpt.property_tenancy_id AS opportunityid,#(lf)        dpt.property_tenancy_tenancy_name AS name,#(lf)        dpt.property_tenancy_primary_tenant_recordbaseid AS parentcontactid,#(lf)        dpt.property_tenancy_leaving_reason AS zav_leavingreason,#(lf)        dpt.property_id AS zav_property,#(lf)        rs.property_subprogram_id AS zav_subprogram,#(lf)        dpt.property_tenancy_tenancy_start_date AS zav_tenancystartdate,#(lf)        dpt.property_tenancy_vacated_date AS zav_vacateddate,#(lf)        dpt.property_tenancy_property_name AS zav_propertyname,#(lf)        dpt.property_tenancy_manager_email AS zav_tenancymanagerid,#(lf)        COALESCE(dpt.property_tenancy_modified_datetime, dpt.DWHEffectiveFrom) AS SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY dpt.property_tenancy_id#(lf)            ORDER BY COALESCE(dpt.property_tenancy_modified_datetime, dpt.DWHEffectiveFrom) DESC#(lf)        ) AS rn#(lf)    FROM [edw].[dim_property_tenancy] dpt#(lf)    LEFT JOIN RecentSubprogram rs#(lf)        ON rs.property_tenancy_id = dpt.property_tenancy_id#(lf)       AND rs.rn = 1#(lf)    WHERE dpt.DWHDMLOperation <> 'D'#(lf)      AND (#(lf)            dpt.property_tenant_opportunity_status IS NULL#(lf)            OR UPPER(dpt.property_tenant_opportunity_status) NOT IN ('CANCELED', 'CANCELLED')#(lf)          )#(lf))#(lf)SELECT#(lf)    opportunityid,#(lf)    name,#(lf)    parentcontactid,#(lf)    zav_leavingreason,#(lf)    zav_property,#(lf)    zav_subprogram,#(lf)    zav_tenancystartdate,#(lf)    zav_vacateddate,#(lf)    zav_propertyname,#(lf)    zav_tenancymanagerid#(lf)FROM RecentOpportunities#(lf)WHERE rn = 1;"]),
