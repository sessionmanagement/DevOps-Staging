			    ISBLANK(
			        fact_tenancy[zav_vacateddate]),
			        DATEDIFF(fact_tenancy[zav_tenancystartdate], TODAY(), DAY),
			        DATEDIFF(fact_tenancy[zav_tenancystartdate], fact_tenancy[zav_vacateddate], DAY)
			)
