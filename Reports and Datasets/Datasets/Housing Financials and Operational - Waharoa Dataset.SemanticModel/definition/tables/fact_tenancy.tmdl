				    #"Expanded merged_primary_contact" = Table.ExpandTableColumn(#"Merged Queries1", "merged_primary_contact", {"fullname", "zav_age", "zav_ethnicityname", "zav_gendername"}, {"fullname", "zav_age", "zav_ethnicityname", "zav_gendername"}),
				    #"Merged Queries2" = Table.NestedJoin(#"Expanded merged_primary_contact", {"opportunityid"}, work_open_tenancybreach, {"zav_tenancy"}, "work_open_tenancybreach", JoinKind.LeftOuter),
				    #"Expanded work_open_tenancybreach" = Table.ExpandTableColumn(#"Merged Queries2", "work_open_tenancybreach", {"tenancy_has_unresolved_breach"}, {"tenancy_has_unresolved_breach"}),
