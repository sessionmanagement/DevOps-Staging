	partition fact_property-9a8d6aeb-2156-48d0-8f14-c4b5e27e168a = m
		mode: import
		queryGroup: facts
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="WITH RankedProperties AS (#(lf)    SELECT#(lf)        dp.property_id AS zav_propertyid,#(lf)        dp.property_statuscode AS statuscode,#(lf)        dp.property_year_built AS new_yearbuilt,#(lf)        dp.property_acquired_date AS zav_acquireddate,#(lf)        dp.property_disposal_date AS zav_disposaldate,#(lf)        dp.property_confirmed_disposal_date AS zav_confirmeddisposaldate,#(lf)        COALESCE(dp.synapse_link_sink_modified_on, dp.DWHEffectiveFrom) AS SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY dp.property_id#(lf)            ORDER BY COALESCE(dp.synapse_link_sink_modified_on, dp.DWHEffectiveFrom) DESC#(lf)        ) AS rn#(lf)    FROM edw.dim_property dp#(lf)    WHERE dp.property_id IS NOT NULL#(lf)      AND dp.DWHDMLOperation <> 'D'#(lf))#(lf)SELECT#(lf)    zav_propertyid,#(lf)    statuscode,#(lf)    new_yearbuilt,#(lf)    zav_acquireddate,#(lf)    zav_disposaldate,#(lf)    zav_confirmeddisposaldate#(lf)FROM RankedProperties#(lf)WHERE rn = 1;"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"zav_acquireddate", type date}, {"zav_confirmeddisposaldate", type date}})
				in
				    #"Changed Type"

	changedProperty = IsHidden

	annotation PBI_ResultType = Exception

	annotation PBI_NavigationStepName = Navigation

