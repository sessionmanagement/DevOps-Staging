	partition fact_tenancybreach = m
		mode: import
		queryGroup: facts
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="WITH RecentZavTenancyBreach AS (#(lf)    SELECT#(lf)        fptb.tenancy_breach_id AS zav_tenancybreachid,#(lf)        COALESCE(fptb.breach, fptb.tenancy_breach) AS zav_name,#(lf)        fptb.breach_date AS zav_breachdate,#(lf)        fptb.breach_id AS zav_breachid,#(lf)        fptb.breach_status AS zav_breachstatusname,#(lf)        fptb.property_tenancy_id AS zav_tenancy,#(lf)        fptb.case_number AS zav_casename,#(lf)        fptb.tenancy_breach AS zav_tenancybreachname,#(lf)        COALESCE(fptb.DWHModifiedOn, fptb.DWHCreatedAt) AS SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY fptb.tenancy_breach_id#(lf)            ORDER BY COALESCE(fptb.DWHModifiedOn, fptb.DWHCreatedAt) DESC#(lf)        ) AS rn#(lf)    FROM edw.fact_property_tenancy_breach fptb#(lf)    WHERE fptb.tenancy_breach_id IS NOT NULL#(lf)),#(lf)RecentZavTribunalOrder AS (#(lf)    SELECT#(lf)        fpto.property_tribunal_order_id AS zav_tribunalorderid,#(lf)        fpto.tribunal_order AS tribunalorder_zav_name,#(lf)        CAST(NULL AS DATETIME) AS zav_enddate,#(lf)        fpto.tribunal_order_start_date AS zav_startdate,#(lf)        fpto.tribunal_outcome AS zav_tribunaloutcome,#(lf)        fpto.tribunal_outcome AS zav_tribunaloutcomename,#(lf)        fpto.property_tenancy_breach_id AS zav_tenancybreach,#(lf)        fpto.tribunal_outcome_reason AS zav_tribunaloutcomereasonname,#(lf)        COALESCE(fpto.DWHEffectiveFrom, fpto.modified_date, fpto.created_date) AS SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY fpto.property_tribunal_order_id#(lf)            ORDER BY COALESCE(fpto.DWHEffectiveFrom, fpto.modified_date, fpto.created_date) DESC#(lf)        ) AS rn#(lf)    FROM edw.fact_property_tribunal_order fpto#(lf)    WHERE fpto.property_tribunal_order_id IS NOT NULL#(lf))#(lf)SELECT#(lf)    rtb.zav_tenancybreachid,#(lf)    rtb.zav_name,#(lf)    rtb.zav_breachdate,#(lf)    rtb.zav_breachid,#(lf)    rtb.zav_breachstatusname,#(lf)    rtb.zav_tenancy,#(lf)    rtb.zav_casename,#(lf)    rtb.zav_tenancybreachname,#(lf)    rto.zav_tribunalorderid,#(lf)    rto.tribunalorder_zav_name,#(lf)    rto.zav_enddate,#(lf)    rto.zav_startdate,#(lf)    rto.zav_tribunaloutcome,#(lf)    rto.zav_tribunaloutcomename,#(lf)    rto.zav_tribunaloutcomereasonname#(lf)FROM RecentZavTenancyBreach rtb#(lf)LEFT OUTER JOIN RecentZavTribunalOrder rto#(lf)    ON rto.zav_tenancybreach = rtb.zav_tenancybreachid#(lf)   AND rto.rn = 1#(lf)WHERE rtb.rn = 1;"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"zav_breachdate", type date}}),
				    #"Filtered Rows" = Table.SelectRows(#"Changed Type", each [zav_tenancy] <> null and [zav_tenancy] <> ""),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Filtered Rows",{{"zav_enddate", type date}, {"zav_startdate", type date}}),
				    #"Added Conditional Column" = Table.AddColumn(#"Changed Type1", "breach_went_to_tenancy_tribunal", each if [zav_tribunalorderid] = null then "No" else "Yes"),
				    #"Added Conditional Column1" = Table.AddColumn(#"Added Conditional Column", "breach_closed", each if [zav_breachstatusname] = "Closed" then "Yes" else "No"),
				    #"Merged Queries" = Table.NestedJoin(#"Added Conditional Column1", {"zav_tenancy"}, work_opportunity, {"opportunityid"}, "work_opportunity", JoinKind.LeftOuter),
				    #"Expanded work_opportunity" = Table.ExpandTableColumn(#"Merged Queries", "work_opportunity", {"zav_property", "zav_tenancymanagerid"}, {"zav_property", "zav_tenancymanagerid"})
				in
				    #"Expanded work_opportunity"

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

