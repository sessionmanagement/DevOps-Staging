table template_3
	lineageTag: 8d10fcb1-a1c8-43c0-b832-de02f3014b4a

	measure 'DV - Template3' = ```
			
			    IFERROR(
			        SWITCH(
			            SELECTEDVALUE(template_3[id]),
			            1, LASTNONBLANK(fact_tenancy[FullAddress],1),
			            2, LASTNONBLANK(dim_tenancy[name],1),
			            3, LASTNONBLANK(fact_inspection[zav_name],1),
			            4, LASTNONBLANK(fact_tenancy[tenancy_manager_name],1),
			            5, LASTNONBLANK(fact_inspection[zav_inspectedbyname],1),
			            6, LASTNONBLANK(fact_inspection[zav_inspectiondate],1),
			            7, CONCATENATE(LASTNONBLANK(dim_inspection_category_type[zav_inspectioncategoryname],1) & " - ", LASTNONBLANK(dim_inspection_category_type[zav_inspectiontypename],1)),
			            8, LASTNONBLANK(fact_inspection[average_score],1),
			            9, FORMAT([% undamaged assets],"percent"),
			            10, FORMAT([% working assets],"percent"),
			            11, FORMAT([% clean assets],"percent")
			        ),
			        "No Data"
			    )
			```
