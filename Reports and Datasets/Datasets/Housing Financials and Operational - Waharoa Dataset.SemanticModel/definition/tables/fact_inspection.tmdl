	partition fact_inspection = m
		mode: import
		queryGroup: facts
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="WITH RecentInspections AS (#(lf)    SELECT#(lf)        fpi.property_inspection_id AS zav_inspectionid,#(lf)        fpi.property_inspection_name AS zav_name,#(lf)        fpi.property_inspection_category AS zav_inspectioncategory,#(lf)        dd.calendar_date AS zav_inspectiondate,#(lf)        fpi.property_inspection_summary AS zav_inspectionsummary,#(lf)        fpi.property_inspection_type AS zav_inspectiontype,#(lf)        fpi.property_id AS zav_property,#(lf)        fpi.property_inspection_inspected_by AS zav_inspectedbyname,#(lf)        fpi.property_tenancy_id AS zav_tenant,#(lf)        COALESCE(#(lf)            fpi.property_inspection_modified_datetime,#(lf)            fpi.DWHModifiedOn#(lf)        ) AS SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY fpi.property_inspection_id#(lf)            ORDER BY COALESCE(#(lf)                fpi.property_inspection_modified_datetime,#(lf)                fpi.DWHModifiedOn#(lf)            ) DESC#(lf)        ) AS rn#(lf)    FROM edw.fact_property_inspection fpi#(lf)    LEFT JOIN edw.dim_date dd#(lf)        ON fpi.property_inspection_date_key = dd.dim_date_key#(lf)    WHERE fpi.DWHDMLOperation <> 'D'#(lf)),#(lf)RecentOpportunities AS (#(lf)    SELECT#(lf)        dpt.property_tenancy_id AS opportunityid,#(lf)        dpt.property_tenancy_vacated_date AS zav_vacateddate,#(lf)        dpt.property_tenancy_manager_email AS zav_tenancymanagerid,#(lf)        COALESCE(#(lf)            dpt.property_tenancy_modified_datetime,#(lf)            dpt.DWHEffectiveFrom#(lf)        ) AS SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY dpt.property_tenancy_id#(lf)            ORDER BY COALESCE(#(lf)                dpt.property_tenancy_modified_datetime,#(lf)                dpt.DWHEffectiveFrom#(lf)            ) DESC#(lf)        ) AS rn#(lf)    FROM edw.dim_property_tenancy dpt#(lf)    WHERE dpt.DWHDMLOperation <> 'D'#(lf))#(lf)SELECT#(lf)    ri.zav_inspectionid,#(lf)    ri.zav_name,#(lf)    ri.zav_inspectioncategory,#(lf)    ri.zav_inspectiondate,#(lf)    ri.zav_inspectionsummary,#(lf)    ri.zav_inspectiontype,#(lf)    ri.zav_property,#(lf)    ri.zav_inspectedbyname,#(lf)    ro.opportunityid,#(lf)    ro.zav_vacateddate,#(lf)    ro.zav_tenancymanagerid#(lf)FROM RecentInspections ri#(lf)LEFT JOIN RecentOpportunities ro#(lf)    ON ri.zav_tenant = ro.opportunityid#(lf)WHERE#(lf)    ri.rn = 1#(lf)    AND ro.rn = 1;"]),
				    #"Changed Type1" = Table.TransformColumnTypes(Source,{{"zav_vacateddate", type date}}),
				    #"Added Custom" = Table.AddColumn(#"Changed Type1", "inspection_category_type_key", each Text.Combine({Text.From([zav_inspectioncategory], "en-NZ"), ":", Text.From([zav_inspectiontype], "en-NZ")})),
				    #"Removed Columns" = Table.RemoveColumns(#"Added Custom",{"zav_inspectioncategory", "zav_inspectiontype"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Removed Columns",{{"zav_inspectiondate", type date}}),
				    #"Merged Queries" = Table.NestedJoin(#"Changed Type", {"zav_inspectionid"}, work_inspection_avg_score, {"zav_inspectionid"}, "work_inspection_avg_score", JoinKind.LeftOuter),
				    #"Expanded work_inspection_avg_score" = Table.ExpandTableColumn(#"Merged Queries", "work_inspection_avg_score", {"average_score"}, {"average_score"})
				in
				    #"Expanded work_inspection_avg_score"

	changedProperty = IsHidden

