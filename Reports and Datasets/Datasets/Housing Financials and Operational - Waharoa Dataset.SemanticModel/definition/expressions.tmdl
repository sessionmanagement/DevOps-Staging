		    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="WITH RecentOpportunity AS (#(lf)    SELECT#(lf)        dpt.property_tenancy_id AS opportunityid,#(lf)        dpt.property_id AS zav_property,#(lf)        dpt.property_tenancy_tenancy_start_date AS zav_tenancystartdate,#(lf)        dpt.property_tenancy_vacated_date AS zav_vacateddate,#(lf)        COALESCE(dpt.property_tenancy_property_name, dp.property_name) AS zav_propertyname,#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY dpt.property_tenancy_id#(lf)            ORDER BY COALESCE(#(lf)                dpt.property_tenancy_modified_datetime,#(lf)                CAST(dpt.property_tenancy_created_datetime AS DATETIME2(7)),#(lf)                dpt.DWHEffectiveFrom#(lf)            ) DESC#(lf)        ) AS rn#(lf)    FROM edw.dim_property_tenancy dpt#(lf)    LEFT JOIN edw.dim_property dp#(lf)        ON dp.property_id = dpt.property_id#(lf)       AND dp.DWHIsCurrent = 1#(lf)       AND dp.DWHDMLOperation <> 'D'#(lf)    WHERE dpt.property_tenancy_id IS NOT NULL#(lf)      AND dpt.DWHIsCurrent = 1#(lf)      AND dpt.DWHDMLOperation <> 'D'#(lf))#(lf)SELECT#(lf)    ro.opportunityid,#(lf)    ro.zav_property,#(lf)    ro.zav_tenancystartdate,#(lf)    ro.zav_vacateddate,#(lf)    ro.zav_propertyname#(lf)FROM RecentOpportunity ro#(lf)WHERE ro.rn = 1;"]),
