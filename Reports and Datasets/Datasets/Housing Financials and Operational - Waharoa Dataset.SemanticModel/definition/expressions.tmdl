expression work_opportunity =
		let
		    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="WITH RecentOpportunity AS (#(lf)    SELECT#(lf)        dpt.property_tenancy_id AS opportunityid,#(lf)        dpt.property_id AS zav_property,#(lf)        dpt.property_tenancy_manager_email AS zav_tenancymanagerid,#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY dpt.property_tenancy_id#(lf)            ORDER BY COALESCE(#(lf)                dpt.property_tenancy_modified_datetime,#(lf)                CAST(dpt.property_tenancy_created_datetime AS DATETIME2(7)),#(lf)                dpt.DWHEffectiveFrom#(lf)            ) DESC#(lf)        ) AS rn#(lf)    FROM edw.dim_property_tenancy dpt#(lf)    WHERE dpt.property_tenancy_id IS NOT NULL#(lf)      AND dpt.DWHIsCurrent = 1#(lf)      AND dpt.DWHDMLOperation <> 'D'#(lf))#(lf)SELECT DISTINCT#(lf)    ro.opportunityid,#(lf)    ro.zav_property,#(lf)    ro.zav_tenancymanagerid#(lf)FROM RecentOpportunity ro#(lf)WHERE ro.rn = 1;"])
		in
		    Source
