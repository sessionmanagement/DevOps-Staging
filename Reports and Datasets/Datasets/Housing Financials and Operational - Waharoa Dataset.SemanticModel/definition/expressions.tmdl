expression merged_primary_contact =
		let
		    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="WITH RecentContact AS (#(lf)    SELECT#(lf)        dpt.property_tenancy_primary_tenant_recordbaseid AS contactid,#(lf)        COALESCE(fpt_best.property_tenant_full_name, dpt.property_tenancy_customer_name) AS fullname,#(lf)        CASE#(lf)            WHEN fpt_best.property_tenancy_tenant_date_of_birth IS NULL THEN NULL#(lf)            ELSE DATEDIFF(YEAR, fpt_best.property_tenancy_tenant_date_of_birth, CAST(GETDATE() AS DATE))#(lf)                 - CASE#(lf)                       WHEN DATEADD(#(lf)                                YEAR,#(lf)                                DATEDIFF(YEAR, fpt_best.property_tenancy_tenant_date_of_birth, CAST(GETDATE() AS DATE)),#(lf)                                fpt_best.property_tenancy_tenant_date_of_birth#(lf)                            ) > CAST(GETDATE() AS DATE)#(lf)                       THEN 1 ELSE 0#(lf)                   END#(lf)        END AS zav_age,#(lf)        fpt_best.property_tenant_head_of_household_flag AS zav_primarytenant,#(lf)        fpt_best.property_tenant_ethnicity_name AS zav_ethnicityname,#(lf)        fpt_best.occupant_gender_label AS zav_gendername,#(lf)        COALESCE(#(lf)            fpt_best.property_tenant_modified_datetime,#(lf)            fpt_best.DWHModifiedOn,#(lf)            dpt.property_tenancy_modified_datetime,#(lf)            dpt.DWHEffectiveFrom#(lf)        ) AS SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY dpt.property_tenancy_primary_tenant_recordbaseid#(lf)            ORDER BY COALESCE(#(lf)                fpt_best.property_tenant_modified_datetime,#(lf)                fpt_best.DWHModifiedOn,#(lf)                dpt.property_tenancy_modified_datetime,#(lf)                dpt.DWHEffectiveFrom#(lf)            ) DESC#(lf)        ) AS rn#(lf)    FROM edw.dim_property_tenancy dpt#(lf)    OUTER APPLY (#(lf)        SELECT TOP 1#(lf)            fpt.property_tenant_full_name,#(lf)            fpt.property_tenancy_tenant_date_of_birth,#(lf)            fpt.property_tenant_head_of_household_flag,#(lf)            fpt.property_tenant_ethnicity_name,#(lf)            fpt.occupant_gender_label,#(lf)            fpt.property_tenant_modified_datetime,#(lf)            fpt.DWHModifiedOn#(lf)        FROM edw.fact_property_tenant fpt#(lf)        WHERE fpt.property_tenancy_id = dpt.property_tenancy_id#(lf)          AND fpt.DWHDMLOperation <> 'D'#(lf)        ORDER BY#(lf)            CASE WHEN fpt.property_tenant_id = dpt.property_tenancy_primary_tenant_recordbaseid THEN 0 ELSE 1 END,#(lf)            CASE WHEN NULLIF(fpt.property_tenant_ethnicity_name, '') IS NOT NULL THEN 0 ELSE 1 END,#(lf)            CASE WHEN NULLIF(fpt.occupant_gender_label, '') IS NOT NULL THEN 0 ELSE 1 END,#(lf)            CASE WHEN fpt.property_tenancy_tenant_date_of_birth IS NOT NULL THEN 0 ELSE 1 END,#(lf)            CASE WHEN fpt.property_tenant_head_of_household_flag IS NOT NULL THEN 0 ELSE 1 END,#(lf)            COALESCE(fpt.property_tenant_modified_datetime, fpt.DWHModifiedOn) DESC#(lf)    ) fpt_best#(lf)    WHERE dpt.DWHDMLOperation <> 'D'#(lf)      AND dpt.property_tenancy_primary_tenant_recordbaseid IS NOT NULL#(lf))#(lf)SELECT#(lf)    rc.contactid,#(lf)    rc.fullname,#(lf)    rc.zav_age,#(lf)    rc.zav_primarytenant,#(lf)    rc.zav_ethnicityname,#(lf)    rc.zav_gendername#(lf)FROM RecentContact rc#(lf)WHERE rc.rn = 1;"]),
		    #"Changed Type" = Table.TransformColumnTypes(Source,{{"contactid", type text}})
		in
		    #"Changed Type"
	lineageTag: ff5ff5d0-64a2-4ea3-943f-125a73d6e205
	queryGroup: unloaded

