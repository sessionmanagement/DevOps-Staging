expression fact_maintenancetask =
		let
		    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="WITH RecentMaintenanceTask AS (#(lf)    SELECT#(lf)        f.property_maintenance_task_id AS zav_maintenancetaskid,#(lf)        f.property_maintenance_task_work_task_name AS zav_name,#(lf)#(lf)        -- Not explicitly modeled in current EDW maintenance task model#(lf)        CAST(NULL AS DATE) AS new_actualstartdate,#(lf)        CAST(NULL AS DATE) AS new_invoiceduedate,#(lf)        CAST(NULL AS DATE) AS new_postinspectioncompleteddate,#(lf)        CAST(NULL AS DATE) AS new_reporteddate,#(lf)        CAST(NULL AS DATE) AS new_scheduledcompletiondate,#(lf)        CAST(NULL AS DATE) AS new_scheduledstartdate,#(lf)        CAST(NULL AS DATE) AS new_tenantconsentdate,#(lf)#(lf)        dd_ack.calendar_date AS zav_acknowledgmentdateandtime,#(lf)        dd_ack_end.calendar_date AS zav_acknowledgmentenddateandtime,#(lf)        dd_actual.calendar_date AS zav_actualcompletiondate,#(lf)        COALESCE(dpm.property_maintenance_contractor_status_datetime, dd_contractor_status.calendar_date) AS zav_contractorstatusdateandtime,#(lf)        dd_contractor_work.calendar_date AS zav_contractorworkcompletiondate,#(lf)        dd_expected_completion.calendar_date AS zav_expectedcompletiondate,#(lf)        dd_expected_onsite.calendar_date AS zav_expectedonsitedate,#(lf)#(lf)        CAST(NULL AS DATE) AS zav_invoicepaiddate,#(lf)#(lf)        dpm.property_maintenance_task_status AS zav_taskstatusname,#(lf)#(lf)        CAST(NULL AS DATE) AS zav_tenantsconfirmationdate,#(lf)#(lf)        dpm.property_maintenance_task_urgency AS zav_urgentname,#(lf)        dd_total_capped.calendar_date AS zav_totalcappedamount_date,#(lf)        dd_web_expenses.calendar_date AS zav_webexpensesamount_date,#(lf)#(lf)        COALESCE(#(lf)            f.property_maintenance_task_modified_datetime,#(lf)            CAST(f.property_maintenance_task_created_datetime AS DATETIME2(7)),#(lf)            dpm.property_maintenance_modified_datetime,#(lf)            CAST(dpm.property_maintenance_created_datetime AS DATETIME2(7)),#(lf)            f.DWHModifiedOn#(lf)        ) AS SinkModifiedOn,#(lf)#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY f.property_maintenance_task_id#(lf)            ORDER BY COALESCE(#(lf)                f.property_maintenance_task_modified_datetime,#(lf)                CAST(f.property_maintenance_task_created_datetime AS DATETIME2(7)),#(lf)                dpm.property_maintenance_modified_datetime,#(lf)                CAST(dpm.property_maintenance_created_datetime AS DATETIME2(7)),#(lf)                f.DWHModifiedOn#(lf)            ) DESC#(lf)        ) AS rn#(lf)    FROM edw.fact_property_maintenance_task f#(lf)    LEFT JOIN edw.dim_property_maintenance dpm#(lf)        ON dpm.property_maintenance_id = f.property_maintenance_id#(lf)       AND dpm.DWHIsCurrent = 1#(lf)       AND dpm.DWHDMLOperation <> 'D'#(lf)    LEFT JOIN edw.dim_date dd_ack#(lf)        ON dd_ack.dim_date_key = f.property_maintenance_task_acknowledgment_date_key#(lf)    LEFT JOIN edw.dim_date dd_ack_end#(lf)        ON dd_ack_end.dim_date_key = f.property_maintenance_task_acknowledgment_end_date_key#(lf)    LEFT JOIN edw.dim_date dd_actual#(lf)        ON dd_actual.dim_date_key = f.property_maintenance_task_actual_completion_date_key#(lf)    LEFT JOIN edw.dim_date dd_contractor_work#(lf)        ON dd_contractor_work.dim_date_key = f.property_maintenance_task_contractor_work_completion_date_key#(lf)    LEFT JOIN edw.dim_date dd_expected_completion#(lf)        ON dd_expected_completion.dim_date_key = f.property_maintenance_task_expected_completion_date_key#(lf)    LEFT JOIN edw.dim_date dd_expected_onsite#(lf)        ON dd_expected_onsite.dim_date_key = f.property_maintenance_task_expected_onsite_date_key#(lf)    LEFT JOIN edw.dim_date dd_total_capped#(lf)        ON dd_total_capped.dim_date_key = f.property_maintenance_task_total_capped_amount_date_key#(lf)    LEFT JOIN edw.dim_date dd_web_expenses#(lf)        ON dd_web_expenses.dim_date_key = f.property_maintenance_task_web_expenses_amount_date_key#(lf)    LEFT JOIN edw.dim_date dd_contractor_status#(lf)        ON dd_contractor_status.dim_date_key = f.property_maintenance_task_contractor_status_date_key#(lf)    WHERE f.property_maintenance_task_id IS NOT NULL#(lf)      AND f.DWHDMLOperation <> 'D'#(lf))#(lf)SELECT#(lf)    rmt.zav_maintenancetaskid,#(lf)    rmt.zav_name,#(lf)    rmt.new_actualstartdate,#(lf)    rmt.new_invoiceduedate,#(lf)    rmt.new_postinspectioncompleteddate,#(lf)    rmt.new_reporteddate,#(lf)    rmt.new_scheduledcompletiondate,#(lf)    rmt.new_scheduledstartdate,#(lf)    rmt.new_tenantconsentdate,#(lf)    rmt.zav_acknowledgmentdateandtime,#(lf)    rmt.zav_acknowledgmentenddateandtime,#(lf)    rmt.zav_actualcompletiondate,#(lf)    rmt.zav_contractorstatusdateandtime,#(lf)    rmt.zav_contractorworkcompletiondate,#(lf)    rmt.zav_expectedcompletiondate,#(lf)    rmt.zav_expectedonsitedate,#(lf)    rmt.zav_invoicepaiddate,#(lf)    rmt.zav_taskstatusname,#(lf)    rmt.zav_tenantsconfirmationdate,#(lf)    rmt.zav_urgentname,#(lf)    rmt.zav_totalcappedamount_date,#(lf)    rmt.zav_webexpensesamount_date#(lf)FROM RecentMaintenanceTask rmt#(lf)WHERE rmt.rn = 1;"])
		in
		    Source
	lineageTag: f6d2f721-120c-4aa6-beed-9ecf023f9b00
	queryGroup: unloaded

