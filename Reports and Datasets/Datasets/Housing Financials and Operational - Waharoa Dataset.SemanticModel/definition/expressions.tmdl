expression work_inspection_avg_score =
		let
		    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="WITH RecentInspectionDetails AS (#(lf)    SELECT#(lf)        zav_inspectionid,#(lf)        zav_assetcondition,#(lf)        SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (PARTITION BY zav_inspectionid ORDER BY SinkModifiedOn DESC) AS rn#(lf)    FROM#(lf)        [Zavanti].[vw_zav_inspectiondetail]#(lf)#(tab)WHERE statuscode = 1#(lf)#(tab)#(tab)AND zav_assetcondition <> 100000000#(lf)#(tab)#(tab)AND zav_assetcondition IS NOT NULL#(lf)#(tab)#(tab)#(lf))#(lf)SELECT#(lf)    zav_inspectionid,#(lf)    zav_assetcondition#(lf)FROM#(lf)    RecentInspectionDetails#(lf)WHERE#(lf)    rn = 1"]),
