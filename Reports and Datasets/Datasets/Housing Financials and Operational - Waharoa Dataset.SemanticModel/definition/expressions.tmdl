		    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="WITH RecentPropertyType AS (#(lf)    SELECT#(lf)        dp.property_property_type AS zav_propertytypeid,#(lf)        dp.property_status AS statuscodename,#(lf)        dp.property_name AS zav_name,#(lf)        dp.property_sub_property_type AS zav_tenantabledwelling,#(lf)        COALESCE(dp.synapse_link_sink_modified_on, dp.DWHEffectiveFrom) AS SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY dp.property_property_type#(lf)            ORDER BY COALESCE(dp.synapse_link_sink_modified_on, dp.DWHEffectiveFrom) DESC#(lf)        ) AS rn#(lf)    FROM edw.dim_property dp#(lf)    WHERE dp.property_property_type IS NOT NULL#(lf)      AND dp.DWHDMLOperation <> 'D'#(lf))#(lf)SELECT DISTINCT#(lf)    rpt.zav_propertytypeid,#(lf)    rpt.statuscodename,#(lf)    rpt.zav_name,#(lf)    rpt.zav_tenantabledwelling,#(lf)    CASE#(lf)        WHEN rpt.zav_tenantabledwelling = 'True' THEN 'Yes'#(lf)        ELSE 'No'#(lf)    END AS zav_tenantabledwellingname#(lf)FROM RecentPropertyType rpt#(lf)WHERE rpt.rn = 1;"])
		in
		    Source
