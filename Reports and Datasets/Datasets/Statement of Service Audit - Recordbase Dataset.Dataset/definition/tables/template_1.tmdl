table template_1
	lineageTag: 8fecea98-a2e3-4ea5-89b7-6ebe3d865e40

	measure 'DV - Template1' = ```
			
			    SWITCH(
			        SELECTEDVALUE(template_1[id]),
			        1,FORMAT([Accepted referrals in year],"0,0"),
			        2,FORMAT([Discharged referrals in year],"0,0"),
			        3,FORMAT([Average length of engagement for FY],"0.00"),
			        4,FORMAT([Bed Nights Provided],"0,0"),
			        5,FORMAT([Number of absent nights (hospitalisation - residential and respite only)],"0,0"),
			        6,FORMAT([Number of absent nights (other - residential and respite only)],"0,0"),
			        7,FORMAT([Actual number of accommodation nights provided],"0,0"),
			        8,FORMAT([Number of unique people with referrals in period],"0,0"),
			        9,FORMAT([Number of unique referrals active period],"0,0"),
			        10,FORMAT([Average number of contracted bed nights per person in FY],"0.00"),
			        11,FORMAT([Average length of engagement (all time)],"0.00")
			    )
			```
		lineageTag: 78f3e817-cd8c-4bea-9b29-bb9fef15df11

	measure 'DV - Prev Year' =
			
			VAR _year = SELECTEDVALUE(DimDate[financial_year_num])-1
			RETURN
			CALCULATE(
			    [DV - Template1],
			    ALL(DimDate),
			    DimDate[financial_year_num] = _year
			)
		formatString: 0
		lineageTag: 03427b97-1db9-4592-a38b-b00c94f3d87d

