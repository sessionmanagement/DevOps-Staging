	partition RB_UserTeamAccess_Combined = m
		mode: import
		queryGroup: RLS
		source =
				let
				    // Load the first source table
				    Source1 = RB_UserTeamAccess,
				    // Add a new column to indicate the source
				    Source1WithSourceColumn = Table.AddColumn(Source1, "Surrogate Key", each Text.From([TeamFunctionID]) & "E" & Text.From([TeamID]), type text),
				
				
				    // Load the second source table
				    Source2 = RB_UserTeamAccessMIB,
				    // Add a new column to indicate the source
				    Source2WithSourceColumn = Table.AddColumn(Source2, "Surrogate Key", each Text.From([TeamFunctionID]) & "M" & Text.From([TeamID]), type text),
				
				    // Combine the two tables
				    CombinedTable = Table.Combine({Source1WithSourceColumn, Source2WithSourceColumn})
				in
				    CombinedTable

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

