	column year_offset =
			
			VAR _currentYear = YEAR(TODAY())
			VAR _selectedYear = DimDate[financial_year_num]
			RETURN
			(_currentYear - _selectedYear)*-1
		formatString: 0
		lineageTag: 292ec6cf-71f7-43df-a13b-1f3fc2a73c8c
		summarizeBy: sum

