	partition ODS_RLS = m
		mode: import
		queryGroup: RLS
		source =
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="-- RLS logic#(lf)WITH#(lf)    RankedEmployees#(lf)    -- Select all columns from dim_employee_hierarchy, setting [dim_employee_hierarchy_key] to null to use later for filtering, NullCount to 0 for further logic#(lf)    AS#(lf)    (#(lf)                    SELECT NULL AS [StaffPerson_id_nk], -- Nullifying this column for later use in filtering.#(lf)                [StaffEmployeeNumber],#(lf)                [StaffEmail],#(lf)                [StaffbusinessEntity_name],#(lf)                [home_cost_box_sub_department] AS [StaffBusiness_unit_name],#(lf)                [StaffDisplayName],#(lf)                [L1Supervisor_EmployeeNumber],#(lf)                [L1SupervisorEmail],#(lf)                [L1_business_unit_name],#(lf)                [L1SupervisorDisplayName],#(lf)                [L2SupervisorPerson_EmployeeNumber],#(lf)                [L2SupervisorEmail],#(lf)                [L2business_unit_name],#(lf)                [L2SupervisorDisplayName],#(lf)                [L3SupervisorPerson_EmployeeNumber],#(lf)                [L3SupervisorEmail],#(lf)                [L3business_unit_name],#(lf)                [L3SupervisorDisplayName],#(lf)                [L4SupervisorPerson_EmployeeNumber],#(lf)                [L4SupervisorEmail],#(lf)                [L4business_unit_name],#(lf)                [L4SupervisorDisplayName],#(lf)                [L5SupervisorPerson_EmployeeNumber],#(lf)                [L5SupervisorEmail],#(lf)                [L5business_unit_name],#(lf)                [L5SupervisorDisplayName],#(lf)                [L6SupervisorPerson_EmployeeNumber],#(lf)                [L6SupervisorEmail],#(lf)                [L6business_unit_name],#(lf)                [L6SupervisorDisplayName],#(lf)                [L7SupervisorPerson_EmployeeNumber],#(lf)                [L7SupervisorEmail],#(lf)                [L7business_unit_name],#(lf)                [L7SupervisorDisplayName],#(lf)                [L8SupervisorPerson_EmployeeNumber],#(lf)                [L8SupervisorEmail],#(lf)                [L8business_unit_name],#(lf)                [L8SupervisorDisplayName],#(lf)                [L9SupervisorPerson_EmployeeNumber],#(lf)                [L9SupervisorEmail],#(lf)                [L9business_unit_name],#(lf)                [L9SupervisorDisplayName],#(lf)                0 AS NullCount#(lf)            FROM [ETL].[dim_employee_hierarchy] eh#(lf)#(tab)OUTER APPLY (#(lf)#(tab)#(tab)SELECT DISTINCT [employee_code],#(lf)                    [home_cost_box_sub_department]#(lf)                FROM [Datapay].[cost_allocations]#(lf)#(tab)#(tab)) ca#(lf)            WHERE eh.[StaffEmployeeNumber] = ca.[employee_code]#(lf)#(lf)        UNION ALL#(lf)#(lf)            -- Selecting all columns from dim_employee_hierarchy and calculating NullCount#(lf)            SELECT [StaffPerson_id_nk],#(lf)                [StaffEmployeeNumber],#(lf)                [StaffEmail],#(lf)                [StaffbusinessEntity_name],#(lf)                [StaffBusiness_unit_name],#(lf)                [StaffDisplayName],#(lf)                [L1Supervisor_EmployeeNumber],#(lf)                [L1SupervisorEmail],#(lf)                [L1_business_unit_name],#(lf)                [L1SupervisorDisplayName],#(lf)                [L2SupervisorPerson_EmployeeNumber],#(lf)                [L2SupervisorEmail],#(lf)                [L2business_unit_name],#(lf)                [L2SupervisorDisplayName],#(lf)                [L3SupervisorPerson_EmployeeNumber],#(lf)                [L3SupervisorEmail],#(lf)                [L3business_unit_name],#(lf)                [L3SupervisorDisplayName],#(lf)                [L4SupervisorPerson_EmployeeNumber],#(lf)                [L4SupervisorEmail],#(lf)                [L4business_unit_name],#(lf)                [L4SupervisorDisplayName],#(lf)                [L5SupervisorPerson_EmployeeNumber],#(lf)                [L5SupervisorEmail],#(lf)                [L5business_unit_name],#(lf)                [L5SupervisorDisplayName],#(lf)                [L6SupervisorPerson_EmployeeNumber],#(lf)                [L6SupervisorEmail],#(lf)                [L6business_unit_name],#(lf)                [L6SupervisorDisplayName],#(lf)                [L7SupervisorPerson_EmployeeNumber],#(lf)                [L7SupervisorEmail],#(lf)                [L7business_unit_name],#(lf)                [L7SupervisorDisplayName],#(lf)                [L8SupervisorPerson_EmployeeNumber],#(lf)                [L8SupervisorEmail],#(lf)                [L8business_unit_name],#(lf)                [L8SupervisorDisplayName],#(lf)                [L9SupervisorPerson_EmployeeNumber],#(lf)                [L9SupervisorEmail],#(lf)                [L9business_unit_name],#(lf)                [L9SupervisorDisplayName],#(lf)                (#(lf)#(tab)#(tab)#(tab)-- Counting the number of nulls across the employee_people_leader_employee_number_level_X fields#(lf)#(tab)#(tab)#(tab)CASE #(lf)#(tab)#(tab)#(tab)#(tab)WHEN [L1Supervisor_EmployeeNumber] IS NULL#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)THEN 1#(lf)#(tab)#(tab)#(tab)#(tab)ELSE 0#(lf)#(tab)#(tab)#(tab)#(tab)END + CASE #(lf)#(tab)#(tab)#(tab)#(tab)WHEN [L2SupervisorPerson_EmployeeNumber] IS NULL#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)THEN 1#(lf)#(tab)#(tab)#(tab)#(tab)ELSE 0#(lf)#(tab)#(tab)#(tab)#(tab)END + CASE #(lf)#(tab)#(tab)#(tab)#(tab)WHEN [L3SupervisorPerson_EmployeeNumber] IS NULL#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)THEN 1#(lf)#(tab)#(tab)#(tab)#(tab)ELSE 0#(lf)#(tab)#(tab)#(tab)#(tab)END + CASE #(lf)#(tab)#(tab)#(tab)#(tab)WHEN [L4SupervisorPerson_EmployeeNumber] IS NULL#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)THEN 1#(lf)#(tab)#(tab)#(tab)#(tab)ELSE 0#(lf)#(tab)#(tab)#(tab)#(tab)END + CASE #(lf)#(tab)#(tab)#(tab)#(tab)WHEN [L5SupervisorPerson_EmployeeNumber] IS NULL#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)THEN 1#(lf)#(tab)#(tab)#(tab)#(tab)ELSE 0#(lf)#(tab)#(tab)#(tab)#(tab)END + CASE #(lf)#(tab)#(tab)#(tab)#(tab)WHEN [L6SupervisorPerson_EmployeeNumber] IS NULL#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)THEN 1#(lf)#(tab)#(tab)#(tab)#(tab)ELSE 0#(lf)#(tab)#(tab)#(tab)#(tab)END + CASE #(lf)#(tab)#(tab)#(tab)#(tab)WHEN [L7SupervisorPerson_EmployeeNumber] IS NULL#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)THEN 1#(lf)#(tab)#(tab)#(tab)#(tab)ELSE 0#(lf)#(tab)#(tab)#(tab)#(tab)END + CASE #(lf)#(tab)#(tab)#(tab)#(tab)WHEN [L8SupervisorPerson_EmployeeNumber] IS NULL#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)THEN 1#(lf)#(tab)#(tab)#(tab)#(tab)ELSE 0#(lf)#(tab)#(tab)#(tab)#(tab)END + CASE #(lf)#(tab)#(tab)#(tab)#(tab)WHEN [L9SupervisorPerson_EmployeeNumber] IS NULL#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)THEN 1#(lf)#(tab)#(tab)#(tab)#(tab)ELSE 0#(lf)#(tab)#(tab)#(tab)#(tab)END#(lf)#(tab)#(tab)#(tab)) AS NullCount#(lf)            FROM [ETL].[dim_employee_hierarchy]#(lf)    ),#(lf)    -- CTE RankedResults: Applies a dense ranking to employees within each business unit based on their 'NullCount'.#(lf)    -- This ranking is used to determine the hierarchical position of employees.#(lf)    RankedResults#(lf)    AS#(lf)    (#(lf)        SELECT *,#(lf)            dense_rank() OVER (#(lf)#(tab)#(tab)#(tab)PARTITION BY [StaffBusiness_unit_name] ORDER BY NullCount DESC#(lf)#(tab)#(tab)#(tab)) AS NullManagerCount#(lf)        -- Ranking employees within each business unit based on NullCount#(lf)        FROM RankedEmployees#(lf)    ),#(lf)    ManagerEmail#(lf)    AS#(lf)    (#(lf)        SELECT *,#(lf)            -- Logic to assign roles ('Manager', 'Temp Manager', or 'Staff') based on null counts.#(lf)            -- Logic to assign employee number, email, business unit name, and display name based on hierarchy depth.#(lf)            CASE #(lf)#(tab)#(tab)#(tab)WHEN NullCount = 0#(lf)#(tab)#(tab)#(tab)#(tab)THEN 'Temp Manager' -- Assigning role based on NullCount#(lf)#(tab)#(tab)#(tab)WHEN NullManagerCount = 1#(lf)#(tab)#(tab)#(tab)#(tab)THEN 'Manager' -- Assigning role based on NullManagerCount#(lf)#(tab)#(tab)#(tab)ELSE 'Staff'#(lf)#(tab)#(tab)#(tab)END AS [IsManager],#(lf)            CASE #(lf)#(tab)#(tab)#(tab)WHEN NullCount = 0#(lf)#(tab)#(tab)#(tab)#(tab)THEN [StaffEmployeeNumber]#(lf)#(tab)#(tab)#(tab)WHEN NullManagerCount = 1#(lf)#(tab)#(tab)#(tab)#(tab)THEN COALESCE([L9SupervisorPerson_EmployeeNumber], [L8SupervisorPerson_EmployeeNumber], [L7SupervisorPerson_EmployeeNumber], [L6SupervisorPerson_EmployeeNumber], [L5SupervisorPerson_EmployeeNumber], [L4SupervisorPerson_EmployeeNumber], [L3SupervisorPerson_EmployeeNumber], [L2SupervisorPerson_EmployeeNumber], [L1Supervisor_EmployeeNumber])#(lf)#(tab)#(tab)#(tab)ELSE ''#(lf)#(tab)#(tab)#(tab)END AS [EmployeeNumber], -- Assigning [StaffEmployeeNumber] based on NullManagerCount#(lf)            CASE #(lf)#(tab)#(tab)#(tab)WHEN NullCount = 0#(lf)#(tab)#(tab)#(tab)#(tab)THEN [StaffEmail]#(lf)#(tab)#(tab)#(tab)WHEN NullManagerCount = 1#(lf)#(tab)#(tab)#(tab)#(tab)THEN COALESCE([L9SupervisorEmail], [L8SupervisorEmail], [L7SupervisorEmail], [L6SupervisorEmail], [L5SupervisorEmail], [L4SupervisorEmail], [L3SupervisorEmail], [L2SupervisorEmail], [L1SupervisorEmail])#(lf)#(tab)#(tab)#(tab)ELSE ''#(lf)#(tab)#(tab)#(tab)END AS [Email], -- Assigning [StaffEmail] based on NullCount#(lf)            CASE #(lf)#(tab)#(tab)#(tab)WHEN NullCount = 0#(lf)#(tab)#(tab)#(tab)#(tab)THEN [StaffBusiness_unit_name]#(lf)#(tab)#(tab)#(tab)WHEN NullManagerCount = 1#(lf)#(tab)#(tab)#(tab)#(tab)THEN COALESCE([L9business_unit_name], [L8business_unit_name], [L7business_unit_name], [L6business_unit_name], [L5business_unit_name], [L4business_unit_name], [L3business_unit_name], [L2business_unit_name], [L1_business_unit_name])#(lf)#(tab)#(tab)#(tab)ELSE ''#(lf)#(tab)#(tab)#(tab)END AS [BusinessUnitName], -- Assigning [StaffBusiness_unit_name] based on NullManagerCount#(lf)            CASE #(lf)#(tab)#(tab)#(tab)WHEN NullCount = 0#(lf)#(tab)#(tab)#(tab)#(tab)THEN [StaffDisplayName]#(lf)#(tab)#(tab)#(tab)WHEN NullManagerCount = 1#(lf)#(tab)#(tab)#(tab)#(tab)THEN COALESCE([L9SupervisorDisplayName], [