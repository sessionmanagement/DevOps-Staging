	partition RB_DimUser = m
		mode: import
		queryGroup: RLS
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="SELECT [UserID], [UserUsername], [UserFirstName], [UserLastName], [UserPreferredName], [UserPosition], [ReportsToUserID], [UserEmployeeNumber], [UserDisabledDate], UPPER([UserEmailAddress]) AS [UserEmailAddress] FROM RBEAL.dlDimUser WHERE [UserDisabledDate] IS NULL AND [UserEmailAddress] IS NOT NULL AND UPPER([UserEmailAddress]) <> 'DUMMY@DUMMY.COM' AND [UserID] > 1000 UNION ALL SELECT [UserID], [UserUsername], [UserFirstName], [UserLastName], [UserPreferredName], [UserPosition], [ReportsToUserID], [UserEmployeeNumber], [UserDisabledDate], UPPER([UserEmailAddress]) AS [UserEmailAddress] FROM RBMNB.dlDimUser WHERE [UserDisabledDate] IS NULL AND [UserEmailAddress] IS NOT NULL AND UPPER([UserEmailAddress]) <> 'DUMMY@DUMMY.COM' AND [UserID] > 1000"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

