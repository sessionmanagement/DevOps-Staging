	partition MNB_DimPerson-3649d51e-04de-419f-9ef7-085d840ee5e7 = m
		mode: import
		queryGroup: MNB
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="SELECT#(lf)'MNB' AS CompanyIdentifier,#(lf)CASE WHEN [PersonID]IS NOT NULL THEN CONCAT('M',[PersonID]) ELSE NULL END AS [PersonID],#(lf)CASE WHEN [TitleID]IS NOT NULL THEN CONCAT('M',[TitleID]) ELSE NULL END AS [TitleID],#(lf)CASE WHEN [GenderID]IS NOT NULL THEN CONCAT('M',[GenderID]) ELSE NULL END AS [GenderID],#(lf)CASE WHEN [OldClientID]IS NOT NULL THEN CONCAT('M',[OldClientID]) ELSE NULL END AS [OldClientID],#(lf)CASE WHEN [MaritalStatusID]IS NOT NULL THEN CONCAT('M',[MaritalStatusID]) ELSE NULL END AS [MaritalStatusID],#(lf)CASE WHEN [HighestQualificationTypeID]IS NOT NULL THEN CONCAT('M',[HighestQualificationTypeID]) ELSE NULL END AS [HighestQualificationTypeID],#(lf)CASE WHEN [ReligionID]IS NOT NULL THEN CONCAT('M',[ReligionID]) ELSE NULL END AS [ReligionID],#(lf)CASE WHEN [ResidencyID]IS NOT NULL THEN CONCAT('M',[ResidencyID]) ELSE NULL END AS [ResidencyID],#(lf)CASE WHEN [NationalityID]IS NOT NULL THEN CONCAT('M',[NationalityID]) ELSE NULL END AS [NationalityID],#(lf)CASE WHEN [CountryOfBirthID]IS NOT NULL THEN CONCAT('M',[CountryOfBirthID]) ELSE NULL END AS [CountryOfBirthID],#(lf)CASE WHEN [PrimaryDailyActivityID]IS NOT NULL THEN CONCAT('M',[PrimaryDailyActivityID]) ELSE NULL END AS [PrimaryDailyActivityID],#(lf)CASE WHEN [PrimaryTransportID]IS NOT NULL THEN CONCAT('M',[PrimaryTransportID]) ELSE NULL END AS [PrimaryTransportID],#(lf)CASE WHEN [EducationalActivityTypeID]IS NOT NULL THEN CONCAT('M',[EducationalActivityTypeID]) ELSE NULL END AS [EducationalActivityTypeID],#(lf)CASE WHEN [EmploymentStatusID]IS NOT NULL THEN CONCAT('M',[EmploymentStatusID]) ELSE NULL END AS [EmploymentStatusID],#(lf)CASE WHEN [EmploymentHistoryID]IS NOT NULL THEN CONCAT('M',[EmploymentHistoryID]) ELSE NULL END AS [EmploymentHistoryID],#(lf)CASE WHEN [LivingSituationID]IS NOT NULL THEN CONCAT('M',[LivingSituationID]) ELSE NULL END AS [LivingSituationID],#(lf)CASE WHEN [PrimaryCarerID]IS NOT NULL THEN CONCAT('M',[PrimaryCar