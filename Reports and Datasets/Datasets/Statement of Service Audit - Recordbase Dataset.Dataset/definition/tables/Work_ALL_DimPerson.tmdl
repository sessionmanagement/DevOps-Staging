				    Source = Sql.Database(Server, Database, [Query="SELECT#(lf)'EAL' AS CompanyIdentifier,#(lf)CASE WHEN [PersonID]IS NOT NULL THEN CONCAT('E',[PersonID]) ELSE NULL END AS [PersonID],#(lf)CASE WHEN [TitleID]IS NOT NULL THEN CONCAT('E',[TitleID]) ELSE NULL END AS [TitleID],#(lf)CASE WHEN [GenderID]IS NOT NULL THEN CONCAT('E',[GenderID]) ELSE NULL END AS [GenderID],#(lf)CASE WHEN [OldClientID]IS NOT NULL THEN CONCAT('E',[OldClientID]) ELSE NULL END AS [OldClientID],#(lf)CASE WHEN [MaritalStatusID]IS NOT NULL THEN CONCAT('E',[MaritalStatusID]) ELSE NULL END AS [MaritalStatusID],#(lf)CASE WHEN [HighestQualificationTypeID]IS NOT NULL THEN CONCAT('E',[HighestQualificationTypeID]) ELSE NULL END AS [HighestQualificationTypeID],#(lf)CASE WHEN [ReligionID]IS NOT NULL THEN CONCAT('E',[ReligionID]) ELSE NULL END AS [ReligionID],#(lf)CASE WHEN [ResidencyID]IS NOT NULL THEN CONCAT('E',[ResidencyID]) ELSE NULL END AS [ResidencyID],#(lf)CASE WHEN [NationalityID]IS NOT NULL THEN CONCAT('E',[NationalityID]) ELSE NULL END AS [NationalityID],#(lf)CASE WHEN [CountryOfBirthID]IS NOT NULL THEN CONCAT('E',[CountryOfBirthID]) ELSE NULL END AS [CountryOfBirthID],#(lf)CASE WHEN [PrimaryDailyActivityID]IS NOT NULL THEN CONCAT('E',[PrimaryDailyActivityID]) ELSE NULL END AS [PrimaryDailyActivityID],#(lf)CASE WHEN [PrimaryTransportID]IS NOT NULL THEN CONCAT('E',[PrimaryTransportID]) ELSE NULL END AS [PrimaryTransportID],#(lf)CASE WHEN [EducationalActivityTypeID]IS NOT NULL THEN CONCAT('E',[EducationalActivityTypeID]) ELSE NULL END AS [EducationalActivityTypeID],#(lf)CASE WHEN [EmploymentStatusID]IS NOT NULL THEN CONCAT('E',[EmploymentStatusID]) ELSE NULL END AS [EmploymentStatusID],#(lf)CASE WHEN [EmploymentHistoryID]IS NOT NULL THEN CONCAT('E',[EmploymentHistoryID]) ELSE NULL END AS [EmploymentHistoryID],#(lf)CASE WHEN [LivingSituationID]IS NOT NULL THEN CONCAT('E',[LivingSituationID]) ELSE NULL END AS [LivingSituationID],#(lf)CASE WHEN [PrimaryCarerID]IS NOT NULL THEN CONCAT('E',[PrimaryCarerID]) ELSE NULL END AS [PrimaryCarerID],#(lf)CASE WHEN [Ethnicity1ID]IS NOT NULL THEN CONCAT('E',[Ethnicity1ID]) ELSE NULL END AS [Ethnicity1ID],#(lf)CASE WHEN [Ethnicity2ID]IS NOT NULL THEN CONCAT('E',[Ethnicity2ID]) ELSE NULL END AS [Ethnicity2ID],#(lf)CASE WHEN [Ethnicity3ID]IS NOT NULL THEN CONCAT('E',[Ethnicity3ID]) ELSE NULL END AS [Ethnicity3ID],#(lf)CASE WHEN [Ethnicity4ID]IS NOT NULL THEN CONCAT('E',[Ethnicity4ID]) ELSE NULL END AS [Ethnicity4ID],#(lf)CASE WHEN [Ethnicity5ID]IS NOT NULL THEN CONCAT('E',[Ethnicity5ID]) ELSE NULL END AS [Ethnicity5ID],#(lf)COALESCE(#(lf)CASE WHEN [Ethnicity1ID]IS NOT NULL THEN CONCAT('E',[Ethnicity1ID]) ELSE NULL END,#(lf)CASE WHEN [Ethnicity2ID]IS NOT NULL THEN CONCAT('E',[Ethnicity2ID]) ELSE NULL END,#(lf)CASE WHEN [Ethnicity3ID]IS NOT NULL THEN CONCAT('E',[Ethnicity3ID]) ELSE NULL END,#(lf)CASE WHEN [Ethnicity4ID]IS NOT NULL THEN CONCAT('E',[Ethnicity4ID]) ELSE NULL END,#(lf)CASE WHEN [Ethnicity5ID]IS NOT NULL THEN CONCAT('E',[Ethnicity5ID]) ELSE NULL END#(lf)) AS FirstNonBlankEthnicityID,#(lf)CASE WHEN [GenderIdentityId]IS NOT NULL THEN CONCAT('E',[GenderIdentityId]) ELSE NULL END AS [GenderIdentityId],#(lf)CASE WHEN [PersonCreatedUserID]IS NOT NULL THEN CONCAT('E',[PersonCreatedUserID]) ELSE NULL END AS [PersonCreatedUserID],#(lf)CASE WHEN [PronounsId]IS NOT NULL THEN CONCAT('E',[PronounsId]) ELSE NULL END AS [PronounsId],#(lf)CASE WHEN [MadePrivateOrPublicUserId]IS NOT NULL THEN CONCAT('E',[MadePrivateOrPublicUserId]) ELSE NULL END AS [MadePrivateOrPublicUserId],#(lf)[PersonFirstName],#(lf)[PersonMiddleNames],#(lf)[PersonLastName],#(lf)[PersonPreferredName],#(lf)[PersonMaidenName],#(lf)[PersonDateOfBirth],#(lf)[PersonDeceasedDate],#(lf)[PersonOccupation],#(lf)[PersonDriversLicenceNumber],#(lf)[PersonDriversLicenceExpiry],#(lf)[PersonVehicleRegistrationNumber],#(lf)[PersonVehicleMakeAndModel],#(lf)[PersonVehicleColor],#(lf)[PersonVehicleDescription],#(lf)[PersonPhysicalDescription],#(lf)[PersonCulturalNeeds],#(lf)[PersonSpiritualNeeds],#(lf)[PersonHeight],#(lf)[PersonWeight],#(lf)[PersonBuild],#(lf)[PersonEyeColor],#(lf)[PersonHairColor],#(lf)[PersonHairStyle],#(lf)[PersonEducationalActivityHoursPerWeek],#(lf)[PersonEducationBackground],#(lf)[PersonCaresForOtherFamilyMembers],#(lf)[PersonCaresForOtherFamilyMembersReason],#(lf)[PersonFamilyBackground],#(lf)[PersonEmploymentStatusHoursPerWeek],#(lf)[PersonLastEmploymentDate],#(lf)[PersonEmploymentBackground],#(lf)[PersonReferenceNumber],#(lf)[PersonUDF1],#(lf)[PersonUDF2],#(lf)[PersonUDF3],#(lf)[PersonUDF4],#(lf)[PersonUDF5],#(lf)[PersonSocialBackground],#(lf)[PersonTreatmentBackground],#(lf)[PersonServiceUserConsent],#(lf)[PersonIsPrivate],#(lf)[PersonFosterChildrenCapacity],#(lf)[PersonPreferedFosterCareService],#(lf)[PersonMadePrivateOrPublicReason],#(lf)[PersonMadePrivateOrPublicDate],#(lf)[PersonCreatedDate]#(lf)FROM RBEAL.dlDimPerson"]),
