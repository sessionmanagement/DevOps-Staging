	partition ALL_FactReferral-5e59c666-46a1-4923-a3f8-80713dee8f2a = m
		mode: import
		queryGroup: 'All (Unioned Data)'
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="SELECT#(lf)'EAL' AS CompanyIdentifier,#(lf)CASE WHEN [lfr].[ID] IS NOT NULL THEN CONCAT('E',[lfr].[ID]) ELSE NULL END AS [ID],#(lf)CASE WHEN [lfr].[PersonID] IS NOT NULL THEN CONCAT('E',[lfr].[PersonID]) ELSE NULL END#(tab)AS [PersonID],#(lf)CASE WHEN [lfr].[SourceReferrerID] IS NOT NULL THEN CONCAT('E',[lfr].[SourceReferrerID]) ELSE NULL END AS [SourceReferrerID],#(lf)CASE WHEN [lfr].[SourceReferralID] IS NOT NULL THEN CONCAT('E',[lfr].[SourceReferralID]) ELSE NULL END AS [SourceReferralID],#(lf)CASE WHEN [lfr].[TeamID] IS NOT NULL THEN CONCAT('E',[lfr].[TeamID]) ELSE NULL END AS [TeamID],#(lf)CASE WHEN [lfr].[OrganisationID] IS NOT NULL THEN CONCAT('E',[lfr].[OrganisationID]) ELSE NULL END AS [OrganisationID],#(lf)CASE WHEN [lfr].[CurrentReferralStatusTypeID] IS NOT NULL THEN CONCAT('E',[lfr].[CurrentReferralStatusTypeID]) ELSE NULL END AS [CurrentReferralStatusTypeID],#(lf)CASE WHEN [lfr].[ReferralPriorityID] IS NOT NULL THEN CONCAT('E',[lfr].[ReferralPriorityID]) ELSE NULL END AS [ReferralPriorityID],#(lf)CASE WHEN [lfr].[CreatedUserID] IS NOT NULL THEN CONCAT('E',[lfr].[CreatedUserID]) ELSE NULL END AS [CreatedUserID],#(lf)CASE WHEN [lfr].[InterviewUserID] IS NOT NULL THEN CONCAT('E',[lfr].[InterviewUserID]) ELSE NULL END AS [InterviewUserID],#(lf)CASE WHEN [dt].[TeamFunctionID] IS NOT NULL THEN CONCAT('E',[dt].[TeamFunctionID]) ELSE NULL END AS [TeamFunctionID],#(lf)[lfr].[ServiceStartDate],#(lf)[lfr].[ServiceEndDate],#(lf)[lfr].[ReceivedDate],#(lf)[lfr].[ExpectedArrivalDate],#(lf)[lfr].[ExpectedDepartureDate],#(lf)[lfr].[ActualArrivalDate],#(lf)[lfr].[ActualDepartureDate],#(lf)[lfr].[EndDate],#(lf)[lfr].[Notes], #(lf)[lfr].[InterviewDate], #(lf)[lfr].[CreatedDate], #(lf)[lfr].[IsInbound], #(lf)[lfr].[PendingDate], #(lf)[lfr].[PendingReason],#(lf)[lfr].[WaitlistDate],#(lf)[lfr].[WaitlistReason],#(lf)[lfr].[AcceptedDate],#(lf)[lfr].[AcceptedReason],#(lf)[lfr].[DischargeDate],#(lf)[lfr].[DischargeReason],#(lf)[lfr].[DeclineDate],#(lf)[lfr].[DeclineReason],#(lf)[lfr].[DischargeComments]#(lf)FROM#(lf)RBEAL.[legacyFactReferral] lfr#(lf)LEFT OUTER JOIN RBEAL.[dlDimTeam] dt ON dt.TeamID = lfr.TeamID"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"DischargeDate", type date}, {"AcceptedDate", type date}, {"PendingDate", type date}, {"CreatedDate", type date}, {"EndDate", type date}, {"ServiceStartDate", type date}, {"ServiceEndDate", type date}, {"ReceivedDate", type date}, {"ExpectedArrivalDate", type date}, {"ExpectedDepartureDate", type date}, {"ActualArrivalDate", type date}, {"ActualDepartureDate", type date}, {"InterviewDate", type date}, {"DeclineDate", type date}}),
				    #"Appended Query" = Table.Combine({#"Changed Type", MNB_FactReferral}),
				    #"Inserted Merged Column" = Table.AddColumn(#"Appended Query", "TeamKeyComposite", each Text.Combine({[TeamFunctionID], [TeamID]}), type text)
				in
				    #"Inserted Merged Column"

