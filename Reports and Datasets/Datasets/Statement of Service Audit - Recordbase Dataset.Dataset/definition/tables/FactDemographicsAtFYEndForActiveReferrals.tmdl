	partition FactDemographicsAtFYEndForActiveReferrals-32d5cd6c-b065-40a2-b6ca-c0e8b3359f4e = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    SUMMARIZECOLUMNS (
				        //ALL_Work_ReferralDaysExplosion[ID],
				        ALL_Work_ReferralDaysExplosion[CompanyIdentifier],
				        ALL_Work_ReferralDaysExplosion[PersonID],
				        ALL_Work_ReferralDaysExplosion[FinancialYear],
				        ALL_Work_ReferralDaysExplosion[FYEnd],
				        ALL_Work_ReferralDaysExplosion[PersonDOB],
				        ALL_Work_ReferralDaysExplosion[AgeAtFYEnd],
				        //ALL_Work_ReferralDaysExplosion[AgeAtFYEndBucket],
				        //ALL_Work_ReferralDaysExplosion[Gender],
				        ALL_Work_ReferralDaysExplosion[GenderID],
				        //ALL_Work_ReferralDaysExplosion[Ethnicity],
				        //ALL_Work_ReferralDaysExplosion[EthnicityID],
				        ALL_Work_ReferralDaysExplosion[TeamFunctionID],
				        ALL_Work_ReferralDaysExplosion[TeamID],
				        ALL_Work_ReferralDaysExplosion[TeamKeyComposite],
				
				            "EthnicityID",
				    IF(
				        ISBLANK(MAXX(ALL_Work_ReferralDaysExplosion, ALL_Work_ReferralDaysExplosion[EthnicityID])),
				        "E11787",
				        MAXX(ALL_Work_ReferralDaysExplosion, ALL_Work_ReferralDaysExplosion[EthnicityID])
				    ),
				
				        "ReferralBeginDateForFY", MIN(ALL_Work_ReferralDaysExplosion[Explosion])
				    ),
				    "IsFirstYearForClient",
				    IF (
				        CALCULATE (
				            MIN ( ALL_Work_ReferralDaysExplosion[FinancialYear] ),
				            FILTER (
				                ALL_Work_ReferralDaysExplosion,
				                ALL_Work_ReferralDaysExplosion[PersonID] = EARLIER ( ALL_Work_ReferralDaysExplosion[PersonID] )
				            )
				        ) = ALL_Work_ReferralDaysExplosion[FinancialYear],
				        1,
				        0
				    )
				)

	annotation PBI_Id = 1d690ba0420d4e159e04b727c089e4ef

