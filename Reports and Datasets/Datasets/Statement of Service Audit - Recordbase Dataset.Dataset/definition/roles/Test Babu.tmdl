role 'Test Babu'
	modelPermission: read

	tablePermission RB_UserTeamAccess_Combined = ```
			OR(
			    upper( "babu.chatterji@emergeaotearoa.org.nz" )
			      in
			    { 
			      upper( [UserEmailAddress] )
			     }
			,
			
			    upper( [UserEmailAddress] ) IN
			        SELECTCOLUMNS(
			        FILTER( 'Additional Access', 
			                  'Additional Access'[Requester Email] 
			                   = upper( "babu.chatterji@emergeaotearoa.org.nz" ) ), 
			          "Person to Impersonate Email",
			          [Person to Impersonate Email]
			        )
			
			)
			```

