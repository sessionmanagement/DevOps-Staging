)#(tab)#(tab)#(tab)dw.source As Source,#(lf)#(tab)#(tab)#(tab)Case When dw.receipt_available_flag = 'Y'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)Then 'Yes'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)When dw.receipt_available_flag = 'N'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)Then 'No'#(lf)#(tab)#(tab)#(tab)#(tab)Else 'Unknown'#(lf)#(tab)#(tab)#(tab)#(tab)End As ReceiptAvailableFlag,#(lf)#(tab)#(tab)#(tab)IIf(dw.claimant_login = dw.approver_login, 'Yes', 'No') As SelfApprovingFlag,#(lf)#(tab)#(tab)#(tab)IIf(dw.description Like '%liquor%', 'Yes', 'No') As PossibleAlcoholFlag,#(lf)#(tab)#(tab)#(tab)#(tab)-- An interim way of identifying cash advances is where amounts are equally divided by 10#(lf)#(tab)#(tab)#(tab)IIf(fw.base_amount % 10 = 0 And fw.base_amount >= 10, 'Yes', 'No') As CashAdvanceFlag,#(lf)#(tab)#(tab)#(tab)#(tab)-- Can filter the cash advance data further by the claimants who also have and interest record at some stage#(lf)#(tab)#(tab)#(tab)IIf(fw.base_amount % 10 = 0 And fw.base_amount >= 10 And cwcai.ClaimantName Is Not Null, 'Yes', 'No') As ClaimantHasCashAdvanceInterestFlag,#(lf)#(tab)#(tab)#(tab)IIf(dw.description Like '%cash advance%' And dw.description Like '%interest%', 'Yes', 'No') As CashAdvanceInterestFlag,#(lf)#(tab)#(tab)#(tab)IIf(dw.receipt_available_flag = 'N', 'Yes', 'No') As NoReceiptFlag,#(lf)#(tab)#(tab)#(tab)IIf(dw.description Like '%Dishonoured%' And dw.description Not Like '%Int%', 'Yes', 'No') As DishonouredPaymentFlag,#(lf)#(tab)#(tab)#(tab)IIf(dw.description Like '%Dishonoured%' And dw.description Like '%Int%', 'Yes', 'No') As DishonouredPaymentInterestFlag#(lf)From#(tab)#(tab)edw.vw_fact_webexpenses fw#(lf)#(tab)Inner Join#(tab)edw.vw_dim_webexpenses dw#(lf)#(tab)#(tab)On#(tab)#(tab)fw.dim_webexpense_key = dw.dim_webexpense_key#(lf)#(tab)Left Join#(tab)#ClaimantsWithCashAdvanceInterest cwcai#(lf)#(tab)#(tab)On#(tab)#(tab)dw.claimant_name = cwcai.ClaimantName#(lf)Where#(tab)#(tab)fw.DWHIsCurrent = 1#(lf)#(tab)And#(tab)#(tab)fw.DWHDMLOperation <> 'D'#(lf)#(tab)And#(tab)#(tab)dw.source = 'VIS'#(lf)Order By#(tab)1"]),
