	partition Activities-aa713dff-657f-427c-a296-ae8c9eb13675 = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="/**********************************************************************************************************#(lf) Script     Ease Up Activity Report#(lf) Purpose    Converted from EAL_RB-Prod temp-table script to run on ODS (Synapse Serverless).#(lf)            All temp tables replaced with CTEs. Table references changed from dl.* to RBEAL.dl*.#(lf)            Logic preserved exactly as-is from the original script (including known quirks).#(lf)#(lf)--REVISIONS:#(lf)--Version   Date          Author          Description#(lf)---------   -----------   --------------  --------------------------#(lf)--1.0       2026-02-13    Mike Gencic     Initial conversion from temp-table script to CTEs#(lf)--1.1       2026-06-19    Mike Gencic     Fixed duplicate ActivityID caused by an incomplete join key#(lf)--                                        in data1_cte. The LEFT JOIN to firstcount_cte previously matched#(lf)--                                        only on PersonID + date, but firstcount_cte's grain is#(lf)--                                        (EaseUpRegion, PersonID, activitystartmonth). When a person had a#(lf)--                                        first activity on the same calendar date in two regions (e.g. both#(lf)--                                        Auckland and Waitemata), a single activity row matched multiple#(lf)--                                        firstcount_cte rows, duplicating the ActivityID (e.g. 7240952 /#(lf)--                                        PersonID 156488). Added EaseUpRegion and activitystartmonth to the#(lf)--                                        ON clause so each activity row matches at most one firstcount row.#(lf)**************************************************************************************************************/#(lf)#(lf)WITH#(lf)-----------------------------------------------------------------------#(lf)-- CTE 1: #groups#(lf)-- Group activities with team/person/user info, filtered to '%ease%'#(lf)-----------------------------------------------------------------------#(lf)groups_cte AS (#(lf)    SELECT#(lf)        FactActivity.ActivityID,#(lf)        FactActivity.ActivityStartDate,#(lf)        FactActivity.ActivityEndDate,#(lf)        FactActivity.ActivityCreatedDate,#(lf)        FactActivity.ActivitySubject,#(lf)        FactGroupActivity.GroupActivityCreatedDate,#(lf)        DimTeam.TeamName,#(lf)        DimPerson.PersonID,#(lf)        CASE#(lf)            WHEN DimTeam.TeamName LIKE '%wdhb%' THEN 'Waitemata'#(lf)            WHEN DimTeam.TeamName LIKE '%west%' THEN 'Waitemata'#(lf)            WHEN DimTeam.TeamName LIKE '%north%' THEN 'Waitemata'#(lf)            WHEN DimTeam.TeamName LIKE '%adhb%' THEN 'Auckland'#(lf)            WHEN DimTeam.TeamName LIKE '%waikato%' THEN 'Waikato'#(lf)            ELSE 'Undefined'#(lf)        END AS region,#(lf)        DimUser.UserFirstName,#(lf)        DimUser.UserLastName,#(lf)        user2.UserFirstName AS reportstofirstname,#(lf)        user2.UserLastName AS reportstosurname#(lf)    FROM [RBEAL].[dlFactActivity] AS FactActivity#(lf)    INNER JOIN [RBEAL].[dlDimTeam] AS DimTeam#(lf)        ON FactActivity.TeamID = DimTeam.TeamID#(lf)    INNER JOIN [RBEAL].[dlFactGroupActivity] AS FactGroupActivity#(lf)        ON FactActivity.GroupActivityID = FactGroupActivity.GroupActivityID#(lf)    INNER JOIN [RBEAL].[dlFactActivityParticipant] AS FactActivityParticipant#(lf)        ON FactActivity.ActivityID = FactActivityParticipant.ActivityID#(lf)    INNER JOIN [RBEAL].[dlDimPerson] AS DimPerson#(lf)        ON FactActivityParticipant.EntityID = DimPerson.PersonID#(lf)    INNER JOIN [RBEAL].[dlDimUser] AS DimUser#(lf)        ON FactActivity.ActivityCreatedUserID = DimUser.UserID#(lf)    INNER JOIN [RBEAL].[dlDimUser] AS user2#(lf)        ON DimUser.ReportsToUserID = user2.UserID#(lf)    WHERE DimTeam.TeamName LIKE '%ease%'#(lf)),#(lf)#(lf)-----------------------------------------------------------------------#(lf)-- CTE 2: #groupsgrouped#(lf)-- Count attendees per activity start date#(lf)-----------------------------------------------------------------------#(lf)groupsgrouped_cte AS (#(lf)    SELECT#(lf)        ActivityStartDate,#(lf)        COUNT(PersonID) AS number_attendees#(lf)    FROM groups_cte#(lf)    GROUP BY ActivityStartDate#(lf)),#(lf)#(lf)-----------------------------------------------------------------------#(lf)-- CTE 3: #finaldata#(lf)-- Assign row numbers, group status, and group inclusion#(lf)-----------------------------------------------------------------------#(lf)finaldata_cte AS (#(lf)    SELECT#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY g.ActivityStartDate, g.region#(lf)            ORDER BY g.ActivityStartDate, g.region#(lf)        ) AS countrows,#(lf)        g.ActivityID,#(lf)        g.PersonID,#(lf)        CAST(g.ActivityStartDate AS DATE) AS activitystartdatepure,#(lf)        g.ActivityStartDate,#(lf)        g.ActivityEndDate,#(lf)        g.ActivitySubject,#(lf)        g.TeamName,#(lf)        g.region,#(lf)        g.UserFirstName,#(lf)        g.UserLastName,#(lf)        g.reportstofirstname,#(lf)        g.reportstosurname,#(lf)        CASE#(lf)            WHEN gg.number_attendees = 1 THEN 'Only 1 attendee'#(lf)            WHEN gg.number_attendees BETWEEN 2 AND 14 THEN '2-14 Attendees'#(lf)            WHEN gg.number_attendees > 14 THEN '15 or More'#(lf)            ELSE 'Unknown'#(lf)        END AS group_status,#(lf)        CASE#(lf)            WHEN gg.number_attendees = 1 THEN 'Exclude'#(lf)            ELSE 'Include'#(lf)        END AS group_inclusion,#(lf)        1 AS group_count#(lf)    FROM groups_cte AS g#(lf)    LEFT JOIN groupsgrouped_cte AS gg#(lf)        ON g.ActivityStartDate = gg.ActivityStartDate#(lf)),#(lf)#(lf)-----------------------------------------------------------------------#(lf)-- CTE 4: #finaldata2#(lf)-- Derive sum_sessions and rename columns#(lf)-----------------------------------------------------------------------#(lf)finaldata2_cte AS (#(lf)    SELECT#(lf)        CASE WHEN countrows = 1 THEN 1 ELSE 0 END AS sum_sessions,#(lf)        ActivityID,#(lf)        PersonID,#(lf)        activitystartdatepure,#(lf)        ActivityStartDate,#(lf)        ActivityEndDate,#(lf)        ActivitySubject,#(lf)        TeamName,#(lf)        region,#(lf)        group_inclusion,#(lf)        group_status,#(lf)        UserFirstName AS usercreatedfirstname,#(lf)        UserLastName AS usercreatedlastname,#(lf)        reportstofirstname,#(lf)        reportstosurname AS reportstolastname#(lf)    FROM finaldata_cte#(lf)),#(lf)#(lf)-----------------------------------------------------------------------#(lf)-- CTE 5: #finalgroupstatus#(lf)-- Extract group status per activity for subquery lookups#(lf)-----------------------------------------------------------------------#(lf)finalgroupstatus_cte AS (#(lf)    SELECT#(lf)        ActivityID,#(lf)        PersonID,#(lf)        group_status,#(lf)        ActivityStartDate#(lf)    FROM finaldata2_cte#(lf)),#(lf)#(lf)-----------------------------------------------------------------------#(lf)-- CTE 6: #activity#(lf)-- Main activity query with classification overrides and session inclusions#(lf)-----------------------------------------------------------------------#(lf)activity_cte AS (#(lf)    SELECT#(lf)        CASE#(lf)            WHEN DimTeam.TeamName LIKE '%adhb%' THEN 'Auckland'#(lf)            WHEN DimTeam.TeamName LIKE '%wdhb%' THEN 'Waitemata'#(lf)            WHEN DimTeam.TeamName LIKE '%west%' THEN 'Waitemata'#(lf)            WHEN DimTeam.TeamName LIKE '%north%' THEN 'Waitemata'#(lf)            WHEN DimTeam.TeamName LIKE '%waikato%' THEN 'Waikato'#(lf)            ELSE 'Other Region'#(lf)        END AS EaseUpRegion,#(lf)        FactActivity.ActivityID,#(lf)        DimPerson.PersonID,#(lf)        FactActivityParticipant.ReferralID,#(lf)       -- DimPerson.PersonReferenceNumber,#(lf)        left(DimPerson.PersonFirstName,1) as PersonFirstName,#(lf)        left(DimPerson.PersonLastName ,1) as PersonLastName,#(lf)        --DimPerson.PersonDateOfBirth,#(lf)        DimEthnicity.EthnicityText,#(lf)        DimEthnicity.EthnicityParentId,#(lf)        DimGender.GenderText,#(lf)        DATEDIFF(DAY, DimPerson.PersonDateOfBirth, FactReferral.ReferralCreatedDate) / 365 AS ageatreferral,#(lf)        DATEADD(DAY, 1, EOMONTH(FactActivity.ActivityStartDate, -1)) AS activitystartmonth,#(lf)        FactActivity.ActivityStartDate,#(lf)        FactActivity.ActivityEndDate,#(lf)        DATEDIFF(MINUTE, FactActivity.ActivityStartDate, FactActivity.ActivityEndDate) AS activityduration,#(lf)        CASE#(lf)            WHEN DATEDIFF(MINUTE, FactActivity.ActivityStartDate, FactActivity.ActivityEndDate) < 10 THEN 'Under 10 Minutes'#(lf)            ELSE '10 Minutes and Over'#(lf)        END AS ActivityMinutes,#(lf)        FactActivity.ActivitySubject,#(lf)        DimTeam.TeamID,#(lf)        DimTeam.TeamName,#(lf)        DimActivityClassification.ActivityClassificationCode,#(lf)        CASE#(lf)            WHEN FactActivity.ActivityID IN (SELECT ActivityID FROM finalgroupstatus_cte)#(lf)            THEN 'Individual'#(lf)            ELSE DimActivityClassification.ActivityClassificationName#(lf)        END AS ActivityClassificationName,#(lf)        DimActivityType.ActivityTypeName,#(lf)        DimActivityType.ActivityTypeDescription,#(lf)        1 AS activity_count,#(lf)        CASE#(lf)            WHEN FactActivity.ActivityID IN (SELECT ActivityID FROM finalgroupstatus_cte WHERE group_status IN ('15 or more')) THEN 'Include Group'#(lf)            WHEN DimActivityClassification.ActivityClassificationName IN ('attempted contact', 'did not attend', 'Liaison with Professional', 'Contact with External Agencies', 'Same Day Cancellation') THEN 'Exclude'#(lf)            WHEN FactActivity.ActivitySubject LIKE 'attempt%' THEN 'Exclude'#(lf)            WHEN FactActivity.ActivitySubject LIKE 'phone call attempted%' THEN 'Exclude'#(lf)            WHEN FactActivity.ActivitySubject LIKE 'dna%' THEN 'Exclude'#(lf)            WHEN FactActivity.ActivitySubject LIKE 'text convo%sched%check%' THEN 'Include'#(lf)            WHEN FactActivity.ActivitySubject LIKE '%scheduling%' OR DimActivityClassification.ActivityClassificationName = 'Scheduling' THEN 'Exclude Scheduling'#(lf)            WHEN DimActivityType.ActivityTypeName IN ('SM Text Messaging') AND DATEDIFF(MINUTE, FactActivity.ActivityStartDate, FactActivity.ActivityEndDate) >= 10 THEN 'Include Text'#(lf)            WHEN DimActivityType.ActivityTypeName IN ('SM Text Messaging') THEN 'Exclude Text'#(lf)            WHEN DATEDIFF(MINUTE, FactActivity.ActivityStartDate, FactActivity.ActivityEndDate) < 10 THEN 'Exclude Under 10 minutes'#(lf)            ELSE 'Include'#(lf)        END AS session_inclusions,#(lf)        FactActivity.ActivityWhanauInvolvement,#(lf)        FactActivity.GroupActivityID#(lf)    FROM [RBEAL].[dlFactActivity] AS FactActivity#(lf)    INNER JOIN [RBEAL].[dlFactActivityParticipant] AS FactActivityParticipant#(lf)        ON FactActivity.ActivityID = FactActivityParticipant.ActivityID#(lf)    INNER JOIN [RBEAL].[dlDimActivityType] AS DimActivityType#(lf)        ON FactActivity.ActivityTypeID = DimActivityType.ActivityTypeID#(lf)    INNER JOIN [RBEAL].[dlDimActivityClassification] AS DimActivityClassification#(lf)        ON FactActivity.ActivityClassificationID = DimActivityClassification.ActivityClassificationID#(lf)    INNER JOIN [RBEAL].[dlDimTeam] AS DimTeam#(lf)        ON FactActivity.TeamID = DimTeam.TeamID#(lf)    INNER JOIN [RBEAL].[dlFactReferral] AS FactReferral#(lf)        ON FactActivityParticipant.ReferralID = FactReferral.ReferralID#(lf)    INNER JOIN [RBEAL].[dlDimPerson] AS DimPerson#(lf)        ON FactActivityParticipant.EntityID = DimPerson.PersonID#(lf)    INNER JOIN [RBEAL].[dlDimEthnicity] AS DimEthnicity#(lf)        ON DimPerson.Ethnicity1ID = DimEthnicity.EthnicityID#(lf)    INNER JOIN [RBEAL].[dlDimGender] AS DimGender#(lf)        ON DimPerson.GenderID = DimGender.GenderID#(lf)    LEFT JOIN [RBEAL].[dlFactGroupActivity] AS FactGroupActivity#(lf)        ON FactActivity.ActivityID = FactGroupActivity.GroupActivityID#(lf)    WHERE DimTeam.TeamName LIKE '%Ease%Up%'#(lf)      AND FactReferral.ReferralCreatedDate > '2019-06-30'#(lf)),#(lf)#(lf)-----------------------------------------------------------------------#(lf)-- CTE 7: #ethnicity#(lf)-- Distinct ethnicity lookup for parent-level resolution#(lf)-----------------------------------------------------------------------#(lf)ethnicity_cte AS (#(lf)    SELECT DISTINCT#(lf)        EthnicityID,#(lf)        EthnicityText#(lf)    FROM [RBEAL].[dlDimEthnicity]#(lf)),#(lf)#(lf)-----------------------------------------------------------------------#(lf)-- CTE 8: #activity2#(lf)-- Resolve ethnicity via parent ID, normalise whanau involvement flag#(lf)-----------------------------------------------------------------------#(lf)activity2_cte AS (#(lf)    SELECT#(lf)        a.EaseUpRegion,#(lf)        a.ActivityID,#(lf)        a.PersonID,#(lf)        a.ReferralID,#(lf)        --a.PersonReferenceNumber,#(lf)        a.PersonFirstName,#(lf)        a.PersonLastName,#(lf)        --a.PersonDateOfBirth,#(lf)        a.GenderText,#(lf)        a.ageatreferral,#(lf)        a.activitystartmonth,#(lf)        a.ActivityStartDate,#(lf)        a.ActivityEndDate,#(lf)        a.activityduration,#(lf)        a.ActivityMinutes,#(lf)        a.ActivitySubject,#(lf)        a.TeamID,#(lf)        a.TeamName,#(lf)        a.ActivityClassificationCode,#(lf)        a.ActivityClassificationName,#(lf)        a.ActivityTypeName,#(lf)        a.ActivityTypeDescription,#(lf)        a.activity_count,#(lf)        a.session_inclusions,#(lf)        CASE#(lf)            WHEN e.EthnicityText IS NULL THEN a.EthnicityText#(lf)            WHEN a.EthnicityText = 'Don''t know' THEN e.EthnicityText#(lf)            ELSE a.EthnicityText#(lf)        END AS EthnicityText,#(lf)        CASE#(lf)            WHEN a.ActivityWhanauInvolvement IS NULL THEN 0#(lf)            WHEN a.ActivityWhanauInvolvement = 0 THEN 0#(lf)            ELSE 1#(lf)        END AS activitywhanauinvolvement#(lf)    FROM activity_cte AS a#(lf)    LEFT JOIN ethnicity_cte AS e#(lf)        ON a.EthnicityParentId = e.EthnicityID#(lf)),#(lf)#(lf)-----------------------------------------------------------------------#(lf)-- CTE 9: #firstcount#(lf)-- First included activity date per region/person/month.#(lf)-- NOTE: grain is (EaseUpRegion, PersonID, activitystartmonth) -> the join#(lf)--       in data1_cte below MUST match on all three keys to avoid fan-out.#(lf)-----------------------------------------------------------------------#(lf)firstcount_cte AS (#(lf)    SELECT#(lf)        EaseUpRegion,#(lf)        PersonID,#(lf)        activitystartmonth,#(lf)        MIN(ActivityStartDate) AS firstactivitydate#(lf)    FROM activity2_cte#(lf)    WHERE session_inclusions NOT LIKE 'exclud%'#(lf)    GROUP BY EaseUpRegion, PersonID, activitystartmonth#(lf)),#(lf)#(lf)-----------------------------------------------------------------------#(lf)-- CTE 10: data1 (inner subquery of final SELECT)#(lf)-- Join activity2 with firstcount, derive individualcountpermonth and Session_group#(lf)-----------------------------------------------------------------------#(lf)data1_cte AS (#(lf)    SELECT#(lf)        a2.EaseUpRegion,#(lf)        a2.ActivityID,#(lf)        a2.PersonID,#(lf)        a2.ReferralID,#(lf)        --a2.PersonReferenceNumber,#(lf)        a2.PersonFirstName,#(lf)        a2.PersonLastName,#(lf)      --  a2.PersonDateOfBirth,#(lf)        a2.GenderText,#(lf)        a2.ageatreferral,#(lf)        a2.activitystartmonth,#(lf)        a2.ActivityStartDate,#(lf)        a2.ActivityEndDate,#(lf)        a2.activityduration,#(lf)        a2.ActivityMinutes,#(lf)        a2.ActivitySubject,#(lf)        a2.TeamID,#(lf)        a2.TeamName,#(lf)        a2.ActivityClassificationCode,#(lf)        a2.ActivityClassificationName,#(lf)        a2.ActivityTypeName,#(lf)        a2.ActivityTypeDescription,#(lf)        a2.activity_count,#(lf)        a2.session_inclusions,#(lf)        a2.EthnicityText,#(lf)        a2.activitywhanauinvolvement,#(lf)        CASE#(lf)            WHEN fc.PersonID IS NOT NULL THEN 1#(lf)            ELSE 0#(lf)        END AS individualcountpermonth,#(lf)        CASE#(lf)            WHEN a2.session_inclusions LIKE '%include%' THEN 'Include'#(lf)            ELSE 'Exclude'#(lf)        END AS Session_group#(lf)    FROM activity2_cte AS a2#(lf)    -- ===================================================================#(lf)    -- FIX v1.1: completed the join key to firstcount_cte.#(lf)    -- Previously this joined only on (PersonID + date), but firstcount_cte#(lf)    -- has one row per (EaseUpRegion, PersonID, activitystartmonth). A person#(lf)    -- whose first activity fell on the same calendar date in two regions#(lf)    -- (e.g. ActivityID 7240952 / PersonID 156488: Auckland + Waitemata both#(lf)    -- on 2026-06-18 16:40) matched BOTH firstcount rows, duplicating the#(lf)    -- ActivityID. Adding EaseUpRegion + activitystartmonth guarantees at#(lf)    -- most one match per activity row.#(lf)    -- ===================================================================#(lf)    LEFT JOIN firstcount_cte AS fc#(lf)        ON  a2.EaseUpRegion       = fc.EaseUpRegion        -- FIX v1.1: added#(lf)        AND a2.PersonID           = fc.PersonID#(lf)        AND a2.activitystartmonth = fc.activitystartmonth  -- FIX v1.1: added#(lf)        AND CAST(a2.ActivityStartDate AS DATE) = CAST(fc.firstactivitydate AS DATE)#(lf)),#(lf)#(lf)-----------------------------------------------------------------------#(lf)-- CTE 11: data2 (outer subquery of final SELECT)#(lf)-- Add ROW_NUMBER for individual count deduplication#(lf)-----------------------------------------------------------------------#(lf)data2_cte AS (#(lf)    SELECT#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY EaseUpRegion, PersonID, activitystartmonth, individualcountpermonth#(lf)            ORDER BY individualcountpermonth DESC, ACTIVITYID#(lf)        ) AS Inds,#(lf)        EaseUpRegion,#(lf)        ActivityID,#(lf)        PersonID,#(lf)        ReferralID,#(lf)       -- PersonReferenceNumber,#(lf)        PersonFirstName,#(lf)        PersonLastName,#(lf)      --  PersonDateOfBirth,#(lf)        GenderText,#(lf)        ageatreferral,#(lf)        activitystartmonth,#(lf)        ActivityStartDate,#(lf)        ActivityEndDate,#(lf)        activityduration,#(lf)        ActivityMinutes,#(lf)        ActivitySubject,#(lf)        TeamID,#(lf)        TeamName,#(lf)        ActivityClassificationCode,#(lf)        ActivityClassificationName,#(lf)        ActivityTypeName,#(lf)        ActivityTypeDescription,#(lf)        activity_count,#(lf)        session_inclusions,#(lf)        EthnicityText,#(lf)        activitywhanauinvolvement,#(lf)        individualcountpermonth,#(lf)        Session_group#(lf)    FROM data1_cte#(lf))#(lf)#(lf)-----------------------------------------------------------------------#(lf)-- Final output#(lf)-----------------------------------------------------------------------#(lf)SELECT#(lf)    EaseUpRegion,#(lf)    ActivityID,#(lf)    PersonID,#(lf)    ReferralID,#(lf)   -- PersonReferenceNumber,#(lf)    PersonFirstName,#(lf)    PersonLastName,#(lf)  --  PersonDateOfBirth,#(lf)    GenderText,#(lf)    ageatreferral,#(lf)    activitystartmonth,#(lf)    ActivityStartDate,#(lf)    ActivityEndDate,#(lf)    activityduration,#(lf)    ActivityMinutes,#(lf)    ActivitySubject,#(lf)    TeamID,#(lf)    TeamName,#(lf)    ActivityClassificationCode,#(lf)    ActivityClassificationName,#(lf)    ActivityTypeName,#(lf)    ActivityTypeDescription,#(lf)    activity_count,#(lf)    session_inclusions,#(lf)    EthnicityText,#(lf)    activitywhanauinvolvement,#(lf)    CASE#(lf)        WHEN individualcountpermonth = 0 THEN 0#(lf)        WHEN individualcountpermonth = 1 AND Inds = 1 THEN 1#(lf)        WHEN individualcountpermonth = 1 AND Inds > 1 THEN 0#(lf)    END AS individualcountpermonth,#(lf)    Session_group#(lf)FROM data2_cte;"]),
				    #"Changed Type1" = Table.TransformColumnTypes(Source,{{"activitystartmonth", type date}}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Changed Type1",{"activitystartmonth", type date}),
				    #"Renamed Columns" = Table.RenameColumns(#"Changed Type",{{"Session_group", "Session Group"}, {"ActivityStartDate", "Activity Start Date"}, {"ActivityEndDate", "Activity End Date"}, {"PersonID", "Person ID"}, {"PersonFirstName", "Person First Name"}, {"PersonLastName", "Person Last Name"}, {"ActivityClassificationName", "Activity Classification Name"}, {"ActivitySubject", "Activity Subject"}, {"ActivityTypeName", "Activity Type Name"}, {"activityduration", "Activity Duration"}, {"ActivityMinutes", "Activity Minutes"}}),
				    #"Inserted Merged Column" = Table.AddColumn(#"Renamed Columns", "Person Name", each Text.Combine({[Person First Name], [Person Last Name]}, " "), type text),
				    #"Renamed Columns1" = Table.RenameColumns(#"Inserted Merged Column",{{"session_inclusions", "Session Inclusions"}, {"ActivityID", "Activity ID"}, {"ReferralID", "Referral ID"}})
				in
				    #"Renamed Columns1"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

