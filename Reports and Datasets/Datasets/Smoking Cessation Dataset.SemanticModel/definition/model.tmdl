model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-NZ
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Timi

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dim_date","dim_company","dim_person","dim_team","dim_gender","dim_ethnicity","dim_age","dim_smoking_status","dim_smoking_status_for_prev","fact_smoking_assessment_explosion","fact_smoking_assessment","fact_current_smoking_snapshot","fact_referral","info_last_refreshed","_Measures","template1","work_fact_smoking_assessment_all","work_fact_smoking_assessment_agg","data_measure_definitions","ChangeLog","RLS with Additional Access","Database","Server","Additional Access (2)","RLS - New RB Structure ALL services"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_date
ref table _Measures
ref table dim_company
ref table info_last_refreshed
ref table fact_smoking_assessment_explosion
ref table dim_smoking_status
ref table template1
ref table fact_referral
ref table dim_team
ref table dim_person
ref table dim_smoking_status_for_prev
ref table dim_gender
ref table dim_ethnicity
ref table dim_age
ref table fact_current_smoking_snapshot
ref table fact_all_person_assessment_history_slim
ref table fact_smoking_assessment
ref table data_measure_definitions
ref table 'RLS with Additional Access'
ref table ChangeLog

ref role 'All Access'
ref role Public

ref cultureInfo en-US

