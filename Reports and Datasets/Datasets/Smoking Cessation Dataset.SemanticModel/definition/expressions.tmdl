expression 'RLS - New RB Structure ALL services' =
		let
		    Source = Sql.Database(Server, Database, [Query="-- Recordbase RLS rows from edw.row_level_security_general (one row per viewer and client team).#(lf)-- The team company, and so the E/M prefix of RLS Join, comes from edw.dim_client_team.company_id: 1 = Emerge (E), 5 = Mind and Body (M).#(lf)SELECT DISTINCT#(lf)       g.[employee_level_for_exclusion] AS [hierarchy_number]#(lf)      ,g.[dim_employee_key]#(lf)      ,g.[employee_id]#(lf)      ,g.[email] AS [employee_primary_email_address]#(lf)      ,e.[employee_job_name]#(lf)      ,s.[service_name]#(lf)      ,g.[dim_service_key]#(lf)      ,g.[service_id]#(lf)      ,s.[department_name]#(lf)      ,s.[district_name]#(lf)      ,s.[region_name]#(lf)      ,CASE ct.[company_id] WHEN 1 THEN 'Emerge' WHEN 5 THEN 'Mind and Body' END AS [company]#(lf)      ,ct.[client_team_area]#(lf)      ,ct.[client_team_function]#(lf)      ,ct.[client_team_name]#(lf)      ,ct.[client_team_id]#(lf)      ,g.[dim_company_key]#(lf)  FROM [edw].[row_level_security_general] g#(lf)  INNER JOIN [edw].[dim_client_team] ct#(lf)     ON ct.[dim_client_team_key] = g.[dim_client_team_key]#(lf)    AND ct.[company_id] IN (1, 5)#(lf)    AND ct.[DWHDMLOperation] <> 'D'#(lf)  LEFT JOIN [edw].[dim_service] s#(lf)     ON s.[dim_service_key] = g.[dim_service_key]#(lf)  LEFT JOIN [edw].[dim_employee] e#(lf)     ON e.[dim_employee_key] = g.[dim_employee_key]#(lf)  WHERE g.[RLS_type] = 'Recordbase'#(lf)    AND g.[email] IS NOT NULL"]),
		    ApplyNamingConventions = (columnName as text) as text =>
		        let
		            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
		            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
		            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
		            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
		            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
		            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
		            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
		            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
		            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
		            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
		            capitaliseWords = Text.Proper(renameDWHSourceSystem),
		            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
		            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
		            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
		        in
		            capitaliseDWH,
		    #"Transformed Column Names" = Table.TransformColumnNames(Source, each ApplyNamingConventions(_)),
		    #"Renamed Columns" = Table.RenameColumns(#"Transformed Column Names",{{"Employee Primary Email Address", "User Principal Name"}}),
		    #"Lowercased Text" = Table.TransformColumns(#"Renamed Columns",{{"User Principal Name", each Text.Lower(Text.Trim(_)), type text}}),
		    #"Removed Duplicates" = Table.Distinct(#"Lowercased Text")
		in
		    #"Removed Duplicates"
	lineageTag: aa4a36b7-ae3e-4ea9-b069-557dba15f829
	queryGroup: Timi

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

