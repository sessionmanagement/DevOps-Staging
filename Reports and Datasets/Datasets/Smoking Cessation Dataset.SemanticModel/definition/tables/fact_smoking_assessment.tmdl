		source =
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="-- ============================================================#(lf)-- Model:  Smoking Cessation Dataset#(lf)-- Table:  fact_smoking_assessment#(lf)-- Source: native query (complex CTE/window) - emitted in full#(lf)-- Used columns: 7 (mapped 7, unmapped 0)  [full query, not trimmed]#(lf)-- Auto-generated from pbi_complete_dump.csv + model M + EDW/ODS schema.#(lf)-- Review before use; verify joins/filters against the model.#(lf)-- ============================================================#(lf)-- USED model columns: Company; DimSmokingStatusKey; FirstNonBlankEthnicityID; GenderID; PersonAgeAtAssessmentDate; PersonID; TeamKey#(lf)#(lf)with CTEDimSmokingStatus as#(lf)(#(lf)SELECT#(lf)'EAL' AS Company,#(lf)SmokingStatusID,#(lf)CONCAT('E',SmokingStatusID) AS DimSmokingStatusKey,#(lf)SmokingStatusValue,#(lf)SmokingStatusText,#(lf)CASE #(lf)WHEN SmokingStatusID = 12308 THEN 0#(lf)WHEN SmokingStatusID = 12522 THEN 1#(lf)WHEN SmokingStatusID = 12307 THEN 2#(lf)WHEN SmokingStatusID = 12306 THEN 3#(lf)WHEN SmokingStatusID = 11555 THEN 4#(lf)WHEN SmokingStatusID = 11556 THEN 5#(lf)WHEN SmokingStatusID = 11557 THEN 6#(lf)WHEN SmokingStatusID = 11558 THEN 7#(lf)WHEN SmokingStatusID = 11559 THEN 8#(lf)ELSE NULL END AS Rank#(lf)FROM RBEAL.dlDimSmokingStatus#(lf)WHERE SmokingStatusIsActive = 1#(lf)#(lf)UNION #(lf)#(lf)SELECT#(lf)'MNB' AS Company,#(lf)SmokingStatusID,#(lf)CONCAT('M',SmokingStatusID) AS DimSmokingStatusKey,#(lf)SmokingStatusValue,#(lf)SmokingStatusText,#(lf)CASE #(lf)WHEN SmokingStatusID = 12308 THEN 0#(lf)WHEN SmokingStatusID = 12307 THEN 1#(lf)WHEN SmokingStatusID = 12525 THEN 2#(lf)WHEN SmokingStatusID = 12306 THEN 3#(lf)WHEN SmokingStatusID = 11555 THEN 4#(lf)WHEN SmokingStatusID = 11556 THEN 5#(lf)WHEN SmokingStatusID = 11557 THEN 6#(lf)WHEN SmokingStatusID = 11558 THEN 7#(lf)WHEN SmokingStatusID = 11559 THEN 8#(lf)ELSE NULL END AS Rank#(lf)FROM RBMNB.dlDimSmokingStatus#(lf)WHERE SmokingStatusIsActive = 1#(lf))#(lf), LegacyFactReferral AS #(lf)(#(lf)SELECT #(lf)CASE WHEN fr.TeamID IS NOT NULL THEN CONCAT('M',fr.TeamID) ELSE NULL END AS TeamID,#(lf)CASE WHEN fr.ID IS NOT NULL THEN CONCAT('M',fr.ID) ELSE NULL END AS ReferralID,#(lf)CASE WHEN fr.PersonID IS NOT NULL THEN CONCAT('M',fr.PersonID) ELSE NULL END AS PersonID,#(lf)fr.AcceptedDate,#(lf)fr.DischargeDate#(lf)FROM RBMNB.LegacyFactReferral fr#(lf)#(lf)UNION #(lf)#(lf)SELECT #(lf)CASE WHEN fr.TeamID IS NOT NULL THEN CONCAT('E',fr.TeamID) ELSE NULL END AS TeamID,#(lf)CASE WHEN fr.ID IS NOT NULL THEN CONCAT('E',fr.ID) ELSE NULL END AS ReferralID,#(lf)CASE WHEN fr.PersonID IS NOT NULL THEN CONCAT('E',fr.PersonID) ELSE NULL END AS PersonID,#(lf)fr.AcceptedDate,#(lf)fr.DischargeDate#(lf)FROM RBEAL.LegacyFactReferral fr#(lf))#(lf), Smoking_History AS #(lf)(#(lf)SELECT#(lf)CASE WHEN sh.PersonSmokingHistoryID IS NOT NULL THEN CONCAT('M',sh.PersonSmokingHistoryID) ELSE NULL END AS PersonSmokingHistoryID,#(lf)CASE WHEN sh.PersonID IS NOT NULL THEN CONCAT('M',sh.PersonID) ELSE NULL END AS PersonID,#(lf)COALESCE(#(lf)CASE WHEN dp.Ethnicity1ID IS NOT NULL THEN CONCAT('M',dp.Ethnicity1ID) ELSE NULL END,#(lf)CASE WHEN dp.Ethnicity3ID IS NOT NULL THEN CONCAT('M',dp.Ethnicity3ID) ELSE NULL END,#(lf)CASE WHEN dp.Ethnicity4ID IS NOT NULL THEN CONCAT('M',dp.Ethnicity4ID) ELSE NULL END,#(lf)CASE WHEN dp.Ethnicity5ID IS NOT NULL THEN CONCAT('M',dp.Ethnicity5ID) ELSE NULL END,#(lf)CASE WHEN dp.Ethnicity2ID IS NOT NULL THEN CONCAT('M',dp.Ethnicity2ID) ELSE NULL END#(lf)) AS FirstNonBlankEthnicityID,#(lf)CASE WHEN dp.GenderID IS NOT NULL THEN CONCAT('M',dp.GenderID) ELSE NULL END AS GenderID,#(lf)--dp.PersonDateOfBirth,#(lf)CASE WHEN sh.SmokingStatusId IS NOT NULL THEN CONCAT('M',sh.SmokingStatusId) ELSE NULL END AS DimSmokingStatusKey,#(lf)sh.PersonSmokingHistoryAssessmentDate,#(lf)FLOOR(DATEDIFF(DAY, dp.PersonDateofBirth, sh.PersonSmokingHistoryAssessmentDate)/365) AS AgeAtAssessmentDate,#(lf)'MNB' AS Company,#(lf)CASE WHEN sh.PersonSmokingHistoryBriefAdviceGiven = 1 THEN 'Yes' ELSE 'No' END AS BriefAdviceGiven,#(lf)dss.Rank AS AssessmentRank,#(lf)LAG(dss.Rank) OVER (PARTITION BY sh.PersonID ORDER BY sh.PersonSmokingHistoryAssessmentDate) AS PreviousAssessmentRank,#(lf)'M' + CAST(LAG(sh.SmokingStatusId) OVER (PARTITION BY sh.PersonID ORDER BY sh.PersonSmokingHistoryAssessmentDate) AS varchar(10)) AS PreviousAssessmentSmokingStatusKey,#(lf)--CASE WHEN sh.PersonSmokingHistorySupportServicesOffered IS NOT NULL AND PersonSmokingHistorySupportServicesOffered <> '' THEN 'Yes' ELSE 'No' END AS SupportServicesOfferedYN,#(lf)CASE WHEN sh.PersonSmokingHistorySupportServicesOffered LIKE '%12228%' -- Given nicotine replacement products, quit card, or other stop smoking medication#(lf)OR sh.PersonSmokingHistorySupportServicesOffered LIKE '%12229%' -- Referred to an external stop smoking cessation service#(lf)OR sh.PersonSmokingHistorySupportServicesOffered LIKE '%12230%' -- Gave support, education and/or resources to help stop smoking#(lf)OR sh.PersonSmokingHistorySupportServicesOffered LIKE '%12231%' -- Client refused smoking cessation support#(lf)--OR sh.PersonSmokingHistorySupportServicesOffered LIKE '%12232%' -- Client not asked#(lf)THEN 'Yes' ELSE 'No' END AS SupportServicesOfferedYN,#(lf)CASE WHEN sh.PersonSmokingHistorySupportServicesOffered LIKE '%12229%' THEN 'Yes' ELSE 'No' END AS ReferredToExternalCessationSupportServiceYN,#(lf)dss.SmokingStatusValue,#(lf)FLOOR(DATEDIFF(DAY,dp.PersonDateOfBirth,sh.PersonSmokingHistoryAssessmentDate)/365) AS PersonAgeAtAssessmentDate,#(lf)FLOOR(DATEDIFF(DAY,dp.PersonDateOfBirth,GETDATE())/365) AS PersonAgeNow#(lf)FROM RBMNB.dlFactPersonSmokingHistory sh #(lf)INNER JOIN CTEDimSmokingStatus dss ON sh.SmokingStatusID = dss.SmokingStatusID AND Company = 'MNB'#(lf)LEFT OUTER JOIN RBMNB.dlDimPerson dp ON sh.PersonID = dp.PersonID#(lf)#(lf)#(lf)UNION#(lf)#(lf)SELECT#(lf)CASE WHEN sh.PersonSmokingHistoryID IS NOT NULL THEN CONCAT('E',sh.PersonSmokingHistoryID) ELSE NULL END AS PersonSmokingHistoryID,#(lf)CASE WHEN sh.PersonID IS NOT NULL THEN CONCAT('E',sh.PersonID) ELSE NULL END AS PersonID,#(lf)COALESCE(#(lf)CASE WHEN dp.Ethnicity1ID IS NOT NULL THEN CONCAT('E',dp.Ethnicity1ID) ELSE NULL END,#(lf)CASE WHEN dp.Ethnicity3ID IS NOT NULL THEN CONCAT('E',dp.Ethnicity3ID) ELSE NULL END,#(lf)CASE WHEN dp.Ethnicity4ID IS NOT NULL THEN CONCAT('E',dp.Ethnicity4ID) ELSE NULL END,#(lf)CASE WHEN dp.Ethnicity5ID IS NOT NULL THEN CONCAT('E',dp.Ethnicity5ID) ELSE NULL END,#(lf)CASE WHEN dp.Ethnicity2ID IS NOT NULL THEN CONCAT('E',dp.Ethnicity2ID) ELSE NULL END#(lf)) AS FirstNonBlankEthnicityID,#(lf)CASE WHEN dp.GenderID IS NOT NULL THEN CONCAT('E',dp.GenderID) ELSE NULL END AS GenderID,#(lf)--dp.PersonDateOfBirth,#(lf)CASE WHEN sh.SmokingStatusId IS NOT NULL THEN CONCAT('E',sh.SmokingStatusId) ELSE NULL END AS DimSmokingStatusKey,#(lf)sh.PersonSmokingHistoryAssessmentDate,#(lf)FLOOR(DATEDIFF(DAY, dp.PersonDateofBirth, sh.PersonSmokingHistoryAssessmentDate)/365) AS AgeAtAssessmentDate,#(lf)'EAL' AS Company,#(lf)CASE WHEN sh.PersonSmokingHistoryBriefAdviceGiven = 1 THEN 'Yes' ELSE 'No' END AS BriefAdviceGiven,#(lf)dss.Rank AS AssessmentRank,#(lf)LAG(dss.Rank) OVER (PARTITION BY sh.PersonID ORDER BY sh.PersonSmokingHistoryAssessmentDate) AS PreviousAssessmentRank,#(lf)'E' + CAST(LAG(sh.SmokingStatusId) OVER (PARTITION BY sh.PersonID ORDER BY sh.PersonSmokingHistoryAssessmentDate) AS varchar(10)) AS PreviousAssessmentSmokingStatusKey,#(lf)--CASE WHEN sh.PersonSmokingHistorySupportServicesOffered IS NOT NULL AND PersonSmokingHistorySupportServicesOffered <> '' THEN 'Yes' ELSE 'No' END AS SupportServicesOfferedYN,#(lf)CASE WHEN sh.PersonSmokingHistorySupportServicesOffered LIKE '%12228%' -- Given nicotine replacement products, quit card, or other stop smoking medication#(lf)OR sh.PersonSmokingHistorySupportServicesOffered LIKE '%12229%' -- Referred to an external stop smoking cessation service#(lf)OR sh.PersonSmokingHistorySupportServicesOffered LIKE '%12230%' -- Gave support, education and/or resources to help stop smoking#(lf)OR sh.PersonSmokingHistorySupportServicesOffered LIKE '%12231%' -- Client refused smoking cessation support#(lf)--OR sh.PersonSmokingHistorySupportServicesOffered LIKE '%12232%' -- Client not asked#(lf)THEN 'Yes' ELSE 'No' END AS SupportServicesOfferedYN,#(lf)CASE WHEN sh.PersonSmokingHistorySupportServicesOffered LIKE '%12229%' THEN 'Yes' ELSE 'No' END AS ReferredToExternalCessationSupportServiceYN,#(lf)dss.SmokingStatusValue,#(lf)FLOOR(DATEDIFF(DAY,dp.PersonDateOfBirth,sh.PersonSmokingHistoryAssessmentDate)/365) AS PersonAgeAtAssessmentDate,#(lf)FLOOR(DATEDIFF(DAY,dp.PersonDateOfBirth,GETDATE())/365) AS PersonAgeNow#(lf)FROM RBEAL.dlFactPersonSmokingHistory sh #(lf)INNER JOIN CTEDimSmokingStatus dss ON sh.SmokingStatusID = dss.SmokingStatusID AND Company = 'EAL'#(lf)LEFT OUTER JOIN RBEAL.dlDimPerson dp ON sh.PersonID = dp.PersonID#(lf)#(lf))#(lf)#(lf)SELECT *,#(lf)       CASE WHEN RowNumberAscPerson = 1 THEN 'Yes' ELSE 'No' END AS IsFirstAssessmentForPerson,#(lf)       CASE WHEN RowNumberDescPerson = 1 THEN 'Yes' ELSE 'No' END AS IsLatestAssessmentForPerson,#(lf)#(tab)   CASE WHEN RowNumberAscPersonTeam = 1 THEN 'Yes' ELSE 'No' END AS IsFirstAssessmentForPersonTeam,#(lf)       CASE WHEN RowNumberDescPersonTeam = 1 THEN 'Yes' ELSE 'No' END AS IsLatestAssessmentForPersonTeam,#(lf)#(tab)   CASE WHEN ReferralID IS NULL THEN 'No' ELSE 'Yes' END AS ActiveReferralAtTimeOfAssessmentExists#(lf)FROM (#(lf)    SELECT fr.TeamID, fr.ReferralID, fr.AcceptedDate, fr.DischargeDate, sh.*,#(lf)#(tab)CASE WHEN #(lf)#(tab)LAG(sh.PersonSmokingHistoryAssessmentDate) OVER (PARTITION BY sh.PersonID,fr.TeamID ORDER BY sh.PersonSmokingHistoryAssessmentDate) IS NOT NULL THEN#(lf)#(tab)DATEDIFF(DAY,LAG(sh.PersonSmokingHistoryAssessmentDate) OVER (PARTITION BY sh.PersonID,fr.TeamID ORDER BY sh.PersonSmokingHistoryAssessmentDate),sh.PersonSmokingHistoryAssessmentDate) ELSE NULL END AS DaysBetweenAssessmentPersonTeam,#(lf)#(tab)CASE WHEN #(lf)#(tab)LAG(sh.PersonSmokingHistoryAssessmentDate) OVER (PARTITION BY sh.PersonID ORDER BY sh.PersonSmokingHistoryAssessmentDate) IS NOT NULL THEN#(lf)#(tab)DATEDIFF(DAY,LAG(sh.PersonSmokingHistoryAssessmentDate) OVER (PARTITION BY sh.PersonID ORDER BY sh.PersonSmokingHistoryAssessmentDate),sh.PersonSmokingHistoryAssessmentDate) ELSE NULL END AS DaysBetweenAssessmentPerson,#(lf)#(tab)LAG(sh.PersonSmokingHistoryAssessmentDate) OVER (PARTITION BY sh.PersonID ORDER BY sh.PersonSmokingHistoryAssessmentDate) AS PreviousAssessmentDatePerson,#(lf)#(tab)LAG(sh.PersonSmokingHistoryAssessmentDate) OVER (PARTITION BY sh.PersonID, fr.TeamID ORDER BY sh.PersonSmokingHistoryAssessmentDate) AS PreviousAssessmentDatePersonTeam,#(lf)#(tab)COALESCE(LEAD(DATEADD(DAY, -1, sh.PersonSmokingHistoryAssessmentDate)) OVER (PARTITION BY sh.PersonID ORDER BY sh.PersonSmokingHistoryAssessmentDate),CAST(fr.DischargeDate AS date),CAST(GETDATE() AS date)) AS AssessmentValidTo,#(lf)#(tab)CASE#(lf)#(tab)WHEN (LEAD(sh.PersonSmokingHistoryAssessmentDate) OVER (PARTITION BY sh.PersonID,fr.TeamID ORDER BY sh.PersonSmokingHistoryAssessmentDate)) IS NOT NULL#(lf)#(tab)THEN 'DayBeforeNewerAssessment'#(lf)#(tab)WHEN fr.DischargeDate IS NOT NULL THEN 'ReferralDischargeDate'#(lf)#(tab)ELSE 'ValidToToday' END AS AssessmentValidToReason,#(lf)#(tab)ROW_NUMBER() OVER (PARTITION BY sh.PersonID ORDER BY sh.PersonSmokingHistoryAssessmentDate ASC) AS RowNumberAscPerson,#(lf)#(tab)ROW_NUMBER() OVER (PARTITION BY sh.PersonID ORDER BY sh.PersonSmokingHistoryAssessmentDate DESC) AS RowNumberDescPerson,#(lf)#(tab)ROW_NUMBER() OVER (PARTITION BY sh.PersonID, fr.ReferralID ORDER BY sh.PersonSmokingHistoryAssessmentDate ASC) AS RowNumberAscPersonTeam,#(lf)#(tab)ROW_NUMBER() OVER (PARTITION BY sh.PersonID, fr.ReferralID ORDER BY sh.PersonSmokingHistoryAssessmentDate DESC) AS RowNumberDescPersonTeam#(lf)    FROM Smoking_History sh#(lf)#(tab)LEFT OUTER JOIN LegacyFactReferral fr ON fr.PersonID = sh.PersonID AND sh.PersonSmokingHistoryAssessmentDate BETWEEN fr.AcceptedDate AND COALESCE(fr.DischargeDate,getdate())#(lf)) AS DerivedTable;#(lf)#(lf)-- NOTE: after the query above, the model also applies these in-memory#(lf)-- Power Query row filters (add to the WHERE for an exact row match):#(lf)--   each ([PersonSmokingHistoryAssessmentDate] <> #date(1900, 1, 1))#(lf)"]),
