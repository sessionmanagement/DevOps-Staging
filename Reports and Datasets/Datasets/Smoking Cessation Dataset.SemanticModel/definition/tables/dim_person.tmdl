	partition dim_person-5c2a8edc-dc52-443f-83f6-2a2085def474 = m
		mode: import
		source =
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="SELECT#(lf)'EAL' AS CompanyIdentifier,#(lf)CASE WHEN [PersonID]IS NOT NULL THEN CONCAT('E',[PersonID]) ELSE NULL END AS [PersonID],#(lf)CASE WHEN [GenderID]IS NOT NULL THEN CONCAT('E',[GenderID]) ELSE NULL END AS [GenderID]#(lf)FROM [RBEAL].[dlDimPerson]#(lf)UNION#(lf)SELECT#(lf)'MNB' AS CompanyIdentifier,#(lf)CASE WHEN [PersonID]IS NOT NULL THEN CONCAT('M',[PersonID]) ELSE NULL END AS [PersonID],#(lf)CASE WHEN [GenderID]IS NOT NULL THEN CONCAT('M',[GenderID]) ELSE NULL END AS [GenderID]#(lf)FROM [RBMNB].[dlDimPerson]#(lf)"]),
				    #"Merged Queries" = Table.NestedJoin(Source, {"PersonID"}, work_fact_smoking_assessment_agg, {"PersonID"}, "work_fact_smoking_assessment_agg", JoinKind.LeftOuter),
				    #"Expanded work_fact_smoking_assessment_agg" = Table.ExpandTableColumn(#"Merged Queries", "work_fact_smoking_assessment_agg", {"Count", "EarliestSmokingAssessmentDate", "LatestSmokingAssessmentDate", "HasSmokingAssessment"}, {"Count", "EarliestSmokingAssessmentDate", "LatestSmokingAssessmentDate", "HasSmokingAssessment"}),
				    #"Renamed Columns" = Table.RenameColumns(#"Expanded work_fact_smoking_assessment_agg",{{"Count", "NumberOfSmokingAssessments"}})
				in
				    #"Renamed Columns"

