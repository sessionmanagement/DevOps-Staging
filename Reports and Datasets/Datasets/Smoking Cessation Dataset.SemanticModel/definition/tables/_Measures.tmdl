			        VALUES ( fact_all_person_assessment_history_slim[PersonID] ),
			        FILTER (
			            ALL ( fact_all_person_assessment_history_slim ),
			            fact_all_person_assessment_history_slim[PersonSmokingHistoryAssessmentDate] <= _MaxDate &&
			            fact_all_person_assessment_history_slim[MaxRowNumberAscPerson] = MAXX (
