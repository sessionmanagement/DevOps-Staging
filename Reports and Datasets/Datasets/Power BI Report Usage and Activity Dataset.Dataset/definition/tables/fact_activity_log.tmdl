				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="SELECT#(lf)    *,#(lf)    REPLACE(CONVERT(char(8), nz_create_date, 112), '-', '') AS dim_create_date_key_nz,#(lf)    CAST(REPLACE(REPLACE(CONVERT(char(8), nz_create_time, 108), ':', ''), '-', '') AS int) dim_create_time_key_nz#(lf)#(tab)FROM (#(lf)#(tab)#(tab)SELECT#(lf)#(tab)#(tab)al.fact_powerbi_activity_log_key#(lf)#(tab)#(tab),al.powerbi_activity_log_internal_id#(lf)#(tab)#(tab)--,al.dim_create_date_key /* commented out as these are UTC time. Conversions to NZ time created further down */#(lf)#(tab)#(tab)--,al.dim_create_time_key#(lf)#(tab)#(tab)--,al.dim_create_date_key#(lf)#(tab)#(tab),al.dim_powerbi_activity_type_key#(lf)#(tab)#(tab),HASHBYTES('MD5',COALESCE(al.item_name,'Unknown') + ' (' + COALESCE(al.item_type,'') + ')' + COALESCE(al.bk_workspace_id,'Unknown') + ' (' + COALESCE(al.workspace_name,'N/A') + ')') AS full_item_hash_key#(lf)#(tab)#(tab)-- al.bk_dataset_id /* hash key created because bk_dataset_id is not unique and has multiple values for dataset_name in some cases */#(lf)#(tab)#(tab),HASHBYTES('MD5',COALESCE(al.bk_dataset_id,'Unknown') + ' (' + COALESCE(al.dataset_name,'') + ')') AS dataset_hash_key#(lf)#(tab)#(tab),bk_dataset_id#(lf)#(tab)#(tab),al.is_success#(lf)#(tab)#(tab),al.user_type#(lf)#(tab)#(tab),CASE WHEN al.user_id LIKE '%@%' THEN LOWER(al.user_id) ELSE al.user_id END AS user_id#(lf)#(tab)#(tab),al.client_ip#(lf)#(tab)#(tab),al.user_agent#(lf)#(tab)#(tab),al.distribution_method#(lf)#(tab)#(tab),al.consumption_method#(lf)#(tab)#(tab),        CONVERT(#(lf)#(tab)#(tab)            date, #(lf)#(tab)#(tab)            SWITCHOFFSET(#(lf)#(tab)#(tab)                CONVERT(#(lf)#(tab)#(tab)                    datetimeoffset, #(lf)#(tab)#(tab)                    CONCAT(create_date, ' ', create_time)#(lf)#(tab)#(tab)                ), #(lf)#(tab)#(tab)                DATEPART(TZOFFSET, SYSDATETIMEOFFSET() AT TIME ZONE 'New Zealand Standard Time')#(lf)#(tab)#(tab)            )#(lf)#(tab)#(tab)        ) AS nz_create_date#(lf)#(tab)#(tab),        CONVERT(#(lf)#(tab)#(tab)            time, #(lf)#(tab)#(tab)            SWITCHOFFSET(#(lf)#(tab)#(tab)                CONVERT(#(lf)#(tab)#(tab)                    datetimeoffset, #(lf)#(tab)#(tab)                    CONCAT(create_date, ' ', create_time)#(lf)#(tab)#(tab)                ), #(lf)#(tab)#(tab)                DATEPART(TZOFFSET, SYSDATETIMEOFFSET() AT TIME ZONE 'New Zealand Standard Time')#(lf)#(tab)#(tab)            )#(lf)#(tab)#(tab)        ) AS nz_create_time#(lf)#(tab)#(tab),        CONVERT(#(lf)#(tab)#(tab)            datetime, #(lf)#(tab)#(tab)            SWITCHOFFSET(#(lf)#(tab)#(tab)                CONVERT(#(lf)#(tab)#(tab)                    datetimeoffset, #(lf)#(tab)#(tab)                    CONCAT(create_date, ' ', create_time)#(lf)#(tab)#(tab)                ), #(lf)#(tab)#(tab)                DATEPART(TZOFFSET, SYSDATETIMEOFFSET() AT TIME ZONE 'New Zealand Standard Time')#(lf)#(tab)#(tab)            )#(lf)#(tab)#(tab)        ) AS nz_create_datetime#(lf)#(tab)#(tab)FROM [edw].[fact_powerbi_activity_log] al)#(lf)AS t1"]),
