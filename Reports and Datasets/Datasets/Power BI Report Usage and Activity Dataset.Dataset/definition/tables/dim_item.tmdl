	partition dim_item = m
		mode: import
		queryGroup: Dimensions
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="SELECT DISTINCT#(lf)CASE WHEN al.workspace_name IS NULL THEN 'N/A' ELSE al.workspace_name END AS workspace_name#(lf),CASE#(lf)WHEN workspace_name LIKE 'PersonalWorkspace%' THEN 'Personal'#(lf)WHEN workspace_name LIKE 'PowerBIAdminGroupDisplayName' THEN 'Admin'#(lf)WHEN workspace_name <> '' THEN 'Workspace'#(lf)ELSE 'N/A'#(lf)END AS workspace_type,#(lf)COALESCE(al.item_name,'Unknown') AS item_name#(lf),CASE WHEN al.item_type IS NULL THEN NULL ELSE UPPER(SUBSTRING(al.item_type, 1, 1)) + LOWER(SUBSTRING(al.item_type, 2, LEN(al.item_type) - 1)) END AS item_type#(lf),COALESCE(al.item_name,'Unknown') + ' (' + al.item_type + ')' AS ItemNameLong#(lf),HASHBYTES('MD5',COALESCE(al.item_name,'Unknown') + ' (' + COALESCE(al.item_type,'') + ')' + COALESCE(al.bk_workspace_id,'Unknown') + ' (' + COALESCE(al.workspace_name,'N/A') + ')') AS full_item_hash_key#(lf)FROM [edw].[fact_powerbi_activity_log] al"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"full_item_hash_key", type text}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

