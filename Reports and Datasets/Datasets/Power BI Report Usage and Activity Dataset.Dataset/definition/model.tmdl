model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-NZ
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Dimensions

	annotation PBI_QueryGroupOrder = 0

queryGroup Facts

	annotation PBI_QueryGroupOrder = 1

queryGroup Work

	annotation PBI_QueryGroupOrder = 2

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["_Measures","LastRefreshed","dim_date","dim_time","dim_activity_type","fact_activity_log","dim_item","dim_dataset","dim_employee_hierarchy","data_measure_definitions"]

annotation PBI_ProTooling = ["DevMode"]

ref table _Measures
ref table LastRefreshed
ref table dim_date
ref table dim_time
ref table dim_activity_type
ref table fact_activity_log
ref table dim_item
ref table dim_dataset
ref table dim_employee_hierarchy
ref table data_measure_definitions

ref cultureInfo en-US

