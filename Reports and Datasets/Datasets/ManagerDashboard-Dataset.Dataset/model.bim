            "name": "IsActiveToday_Desc",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": "IF(RB_FactReferrals[IsActiveToday] && ISBLANK(RB_FactReferrals[ReferralEndDate]), \"Active\", \"Inactive\")",
            "isDataTypeInferred": true,
            "lineageTag": "142640e6-6075-402b-bb6e-548933ef6c04",
