        "measures": [
          {
            "name": "ReportViewerLT",
            "expression": [
              "",
              "VAR ManagerDisplayName =",
              "    LOOKUPVALUE (",
              "        reference_row_level_security[employee_display_name],",
              "        reference_row_level_security[employee_email], UPPER ( USERPRINCIPALNAME() )",
              "    )",
              "// VAR RequesterDisplayName =",
              "//     LOOKUPVALUE (",
              "//         LkpPowerBIReportAdditionalAccess_usedInRLSforDenJob[RequesterDisplayName],",
              "//         LkpPowerBIReportAdditionalAccess_usedInRLSforDenJob[RequesterEmailAddress], UPPER ( USERPRINCIPALNAME() )",
              "//     )",
              "RETURN",
              "    IF (",
              "        ManagerDisplayName = BLANK (),",
              "        IF ( /*RequesterDisplayName =*/ BLANK (), USERPRINCIPALNAME(), /*RequesterDisplayName*/ BLANK() ),",
              "        ManagerDisplayName",
              "    )"
            ],
            "lineageTag": "0c23cfb5-732c-4a19-b375-31cc81960790"
          }
        ],
        "partitions": [
          {
            "name": "reference_row_level_security",
            "mode": "import",
            "queryGroup": "HR",
            "source": {
              "expression": [
                "let",
                "    Source = Sql.Databases(\"synapseausprod-ondemand.sql.azuresynapse.net\"),",
                "    ODS = Source{[Name=\"ODS\"]}[Data],",
                "    dbo_reference_row_level_security = ODS{[Schema=\"dbo\",Item=\"reference_row_level_security\"]}[Data],",
                "    #\"Uppercased Text\" = Table.TransformColumns(dbo_reference_row_level_security,{{\"employee_email\", Text.Upper, type text}, {\"supervisor_email\", Text.Upper, type text}}),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Uppercased Text\",{{\"employee_number\", type text}, {\"supervisor_employee_number\", type text}}),",
                "    #\"Merged Queries\" = Table.NestedJoin(#\"Changed Type\", {\"employee_email\"}, RB_UserTeamAccess, {\"UserEmailAddress\"}, \"RB_UserTeamAccess\", JoinKind.LeftOuter),",
                "    #\"Expanded RB_UserTeamAccess\" = Table.ExpandTableColumn(#\"Merged Queries\", \"RB_UserTeamAccess\", {\"TeamID\"}, {\"RB_UserTeamAccess.TeamID\"})",
                "in",
                "    #\"Expanded RB_UserTeamAccess\""
              ],
              "type": "m"
            }
          }
        ]
      },
