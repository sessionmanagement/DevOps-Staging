                "value": "Automatic"
              }
            ],
            "dataType": "dateTime",
            "formatString": "General Date",
            "lineageTag": "c98e09b3-769e-4ebe-b971-d79680f3bfb9",
            "sourceColumn": "DataRefreshDate",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "0064ec3c-8d69-4e01-a613-3754dcba7d81",
        "measures": [
          {
            "name": "RefreshedAt_forDisplay",
            "expression": "\"Refreshed at: \" & FORMAT( LASTDATE( VersionOfDataset[DataRefreshDate] ), \"dd/MM/YYYY HH:mm\" )",
            "lineageTag": "25ecc2cd-9538-4b72-84a0-d991f7f8d828"
          },
          {
            "name": "RefreshLate_message",
            "expression": "IF( VersionOfDataset[IsRefreshLate], \"NOTE: There was an error in the refresh last night. Your data is Not up to date. Te Pataka is fixing the error\", \"\")",
            "lineageTag": "c9f06ac9-4a82-400a-9d2b-1dd731021761"
          },
          {
            "name": "IsRefreshLate",
            "expression": "DATEDIFF( LASTDATE(VersionOfDataset[DataRefreshDate]), TODAY(), DAY) > 1",
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\"",
            "lineageTag": "4faf053b-bddc-4f2b-a511-2e80708c0742"
          }
        ],
        "partitions": [
          {
            "name": "VersionOfDataset-a10db5fa-1e5c-45ba-af4f-b2f1d9547ba5",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText(\"i45WMjRS0lECodhYAA==\", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [DatasetVersion = _t, VersionComment = _t, VersionReleaseDate = _t]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"DatasetVersion\", Int64.Type}, {\"VersionReleaseDate\", type date}}),",
                "",
                "    #\"Added Refresh Date\" = Table.AddColumn(#\"Changed Type\", \"DataRefreshDate\", ",
                "        each DateTimeZone.FixedLocalNow(), type datetimezone),",
                "    #\"Changed Type2\" = Table.TransformColumnTypes(#\"Added Refresh Date\",{{\"DataRefreshDate\", type datetime}})",
                "in",
                "    #\"Changed Type2\""
              ],
              "type": "m"
            }
          }
        ]
      },
