          {
            "name": "Month",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": "Format('calc_Date'[calc_DateVal], \"MMM\")",
            "isDataTypeInferred": true,
            "lineageTag": "c98d2fda-3132-4a7c-9cae-feccecc8c967",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Quarter",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "expression": "QUARTER('calc_Date'[calc_DateVal])",
            "formatString": "0",
            "isDataTypeInferred": true,
            "lineageTag": "3e88b9d0-e8d2-4e1f-a0ab-0a9224962b0e",
            "summarizeBy": "sum",
            "type": "calculated"
          },
          {
            "name": "Fiscal Quarter",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "expression": [
              "",
              "IF (",
              "    'calc_Date'[Quarter] = 1,",
              "    3,",
              "    IF (",
              "        'calc_Date'[Quarter] = 2,",
              "        4,",
              "        IF ( 'calc_Date'[Quarter] = 3, 1, IF ( 'calc_Date'[Quarter] = 4, 2, BLANK () ) )",
              "    )",
              ")",
              ""
            ],
            "formatString": "0",
            "isDataTypeInferred": true,
            "lineageTag": "b18fb99d-89f7-462a-bf19-6d879753c8d6",
            "summarizeBy": "sum",
            "type": "calculated"
          },
          {
            "name": "Fiscal Year",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "expression": [
              "",
              "IF (",
              "    'calc_Date'[Fiscal Quarter] = 3,",
              "    'calc_Date'[Year],",
              "    IF (",
              "        'calc_Date'[Fiscal Quarter] = 4,",
              "        'calc_Date'[Year],",
              "        IF (",
              "            'calc_Date'[Fiscal Quarter] = 1,",
              "            'calc_Date'[Year] + 1,",
              "            IF ( 'calc_Date'[Fiscal Quarter] = 2, 'calc_Date'[Year] + 1 )",
              "        )",
              "    )",
              ")",
              ""
            ],
            "formatString": "0",
            "isDataTypeInferred": true,
            "lineageTag": "45e1f504-b782-4c38-9c7a-52ce84c3c6f3",
            "summarizeBy": "sum",
            "type": "calculated"
          },
