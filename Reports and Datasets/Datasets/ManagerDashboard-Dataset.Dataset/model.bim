          {
            "name": "UserFirstName_lastActivityStaff",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "VAR lastActivityID_forClient = CALCULATE ( MAX ( RB_FactActivityParticipant[ActivityID] ), ",
              "                                           FILTER( RB_FactActivityParticipant, RB_DimPerson_forGoals[PersonID] = RB_FactActivityParticipant[ClientPersonID] && ",
              "                                                                               not ISBLANK( RB_FactActivityParticipant[EmpUserID]) )",
              "                                         ) ",
              "",
              "VAR lastActivityUserID = CALCULATE ( SUM (  RB_FactActivityParticipant[EmpUserID] ),  RB_FactActivityParticipant[ActivityID] = lastActivityID_forClient ) ",
              "",
              "RETURN ",
              "      CALCULATE ( MAX (  RB_DimUser[UserFirstName] ),  RB_DimUser[UserID] = lastActivityUserID ) "
            ],
            "isDataTypeInferred": true,
            "lineageTag": "5447ff32-9816-4892-b0f0-2a31517ed32f",
            "summarizeBy": "none",
            "type": "calculated"
          },
