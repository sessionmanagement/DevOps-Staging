    "roles": [
      {
        "name": "_ Babu Test",
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "aee7db3e7cb84eab87c866e48f3a3384"
          }
        ],
        "modelPermission": "read",
        "tablePermissions": [
          {
            "name": "RB_UserTeamAccess",
            "filterExpression": [
              "UPPER(\"babu.chatterji@emergeaotearoa.org.nz\") = UPPER([UserEmailAddress])",
              ""
            ]
          },
          {
            "name": "reference_row_level_security",
            "filterExpression": "UPPER(\"babu.chatterji@emergeaotearoa.org.nz\") = UPPER([supervisor_email])"
          }
        ]
      },
      {
        "name": "Additional Access",
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "f967bdf5f2244136b5db05d5e5215b6e"
          }
        ],
        "modelPermission": "read",
        "tablePermissions": [
          {
            "name": "RB_UserTeamAccess",
            "filterExpression": [
              "OR(",
              "    UPPER(USERPRINCIPALNAME()) = UPPER([UserEmailAddress]),",
              "",
              "    UPPER([UserEmailAddress]) IN",
              "    SELECTCOLUMNS(",
              "\t\tFILTER( 'Additional Access', ",
              "\t\t\t\t  'Additional Access'[Requester Email] ",
              "\t\t\t\t   = UPPER(USERPRINCIPALNAME())), ",
              "\t\t  \"Person to Impersonate Email\",",
              "\t\t  [Person to Impersonate Email]",
              "    )",
              ")"
            ]
          },
          {
            "name": "reference_row_level_security",
            "filterExpression": [
              "OR(",
              "    UPPER(USERPRINCIPALNAME()) = UPPER([supervisor_email]),",
              "",
              "    UPPER([supervisor_email]) IN",
              "    SELECTCOLUMNS(",
              "\t\tFILTER( 'Additional Access', ",
              "\t\t\t\t  'Additional Access'[Requester Email] ",
              "\t\t\t\t   = UPPER(USERPRINCIPALNAME())), ",
              "\t\t  \"Person to Impersonate Email\",",
              "\t\t  [Person to Impersonate Email]",
              "    )",
              ")"
            ]
          }
        ]
      },
