              "",
              "VAR lastActivityID = CALCULATE ( MAX ( RB_FactActivityParticipant[ActivityID] ) )",
              "VAR lastActivityUserID = CALCULATE ( SUM (  RB_FactActivityParticipant[EmpUserID] ),  RB_FactActivityParticipant[ActivityID] = lastActivityID ) ",
              "RETURN ",
              "      CALCULATE ( MAX (  RB_DimUser[UserFirstName] ),  RB_DimUser[UserID] = lastActivityUserID ) "
