          {
            "name": "Age",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "int64",
            "expression": "DATEDIFF(RB_FactReferrals[PersonDateOfBirth] , TODAY(), YEAR)",
            "formatString": "0",
            "isDataTypeInferred": true,
            "lineageTag": "aa7410af-2c2e-4e1b-9f6e-56c27363479e",
            "summarizeBy": "sum",
            "type": "calculated"
          },
          {
            "name": "Age_Bucket",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "if(",
              "               RB_FactReferrals[Age] <= 21, \"21 and Under\", ",
              "                    if(RB_FactReferrals[Age] <= 30, \"22 - 30\", ",
              "                         if(RB_FactReferrals[Age] <= 40, \"31 - 40\", ",
              "                            if(RB_FactReferrals[Age] <= 50, \"41 - 50\", ",
              "                                 if(RB_FactReferrals[Age] <= 60, \"51 - 60\", ",
              "                                    if(RB_FactReferrals[Age] <= 70, \"61 - 70\", ",
              "                                       \"Unknown\")",
              "                                    )",
              "                                )",
              "                            )",
              "                        )",
              "                    )"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "6e6491de-0321-410f-90ed-8216b9e5bb39",
            "summarizeBy": "none",
            "type": "calculated"
