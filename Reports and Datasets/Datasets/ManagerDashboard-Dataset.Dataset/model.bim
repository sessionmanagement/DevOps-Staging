            "name": "RBss_ClientReferral_Last-a07984ef-19b4-4b1a-b2a4-414893f97f1b",
            "mode": "import",
            "queryGroup": "RB",
            "source": {
              "expression": [
                "let",
                "    Source = RBss_ClientReferral,",
                "    #\"Grouped Rows\" = Table.Group(Source, {\"PersonID\"}, {{\"MaxSnapshotDate\", each List.Max([SnapshotDate]), type date}}),",
                "    #\"Merged Queries\" = Table.NestedJoin(#\"Grouped Rows\", {\"PersonID\", \"MaxSnapshotDate\"}, RBss_ClientReferral, {\"PersonID\",\"SnapshotDate\"}, \"RBss_ClientReferral\", JoinKind.Inner),",
                "    #\"Expanded RBss_ClientReferral\" = Table.ExpandTableColumn(#\"Merged Queries\", \"RBss_ClientReferral\", ",
                "            {\"TeamID\", \"ReferralID\", \"EthnicityID\", \"Ethnicity\", \"EthnicityGroup\", \"ResidencyID\", \"Residency\", ",
                "             \"PersonDateOfBirth\", \"GenderID\", \"Gender\", \"EmploymentStatusID\"}, ",
                "            {\"RBss_ClientReferral.TeamID\", \"RBss_ClientReferral.ReferralID\", \"RBss_ClientReferral.EthnicityID\", \"RBss_ClientReferral.Ethnicity\", \"RBss_ClientReferral.EthnicityGroup\", \"RBss_ClientReferral.ResidencyID\", \"RBss_ClientReferral.Residency\", ",
                "             \"RBss_ClientReferral.PersonDateOfBirth\", \"RBss_ClientReferral.GenderID\", \"RBss_ClientReferral.Gender\", \"RBss_ClientReferral.EmploymentStatusID\"})",
                "in",
                "    #\"Expanded RBss_ClientReferral\""
              ],
              "type": "m"
            }
          }
        ]
      },
