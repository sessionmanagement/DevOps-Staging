          "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers1\",{{\"Business Central Code\", Int64.Type}, {\"Business Central Name\", type text}, {\"Dynmaics SL Code\", type any}, {\"Dynmaics SL name\", type text}, {\"CategoryID\", type any}, {\"Category\", type text}, {\"DrCrSignMultiplier\", type any}, {\"ParentCategoryID\", type any}}),",
          "    #\"Removed Columns\" = Table.RemoveColumns(#\"Changed Type\",{\"Dynmaics SL Code\", \"Dynmaics SL name\"}),",
          "    #\"Removed Duplicates\" = Table.Distinct(#\"Removed Columns\", {\"Business Central Code\"}),",
          "    #\"Replaced Value\" = Table.ReplaceValue(#\"Removed Duplicates\",\"NULL\",\"unknown category\",Replacer.ReplaceText,{\"Category\"}),",
          "    #\"Replaced Value1\" = Table.ReplaceValue(#\"Replaced Value\",\"NULL\",-1,Replacer.ReplaceValue,{\"CategoryID\"}),",
          "    #\"Filtered Rows\" = Table.SelectRows(#\"Replaced Value1\", each ([Business Central Code] <> 0)),",
          "    #\"Changed Type1\" = Table.TransformColumnTypes(#\"Filtered Rows\",{{\"Business Central Code\", type text}}),",
          "    #\"Replaced Value2\" = Table.ReplaceValue(#\"Changed Type1\",\"NULL\",\"\",Replacer.ReplaceValue,{\"DrCrSignMultiplier\"}),",
          "    #\"Changed Type2\" = Table.TransformColumnTypes(#\"Replaced Value2\",{{\"DrCrSignMultiplier\", Int64.Type}, {\"ParentCategoryID\", Int64.Type}, {\"CategoryID\", Int64.Type}})",
          "in",
          "    #\"Changed Type2\""
        ],
