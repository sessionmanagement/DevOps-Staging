          {
            "name": "Employee_Unique_ID",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "VAR employeeID = reference_row_level_security[employee_number]",
              "VAR managerID = reference_row_level_security[supervisor_employee_number]",
              "VAR sameEmployeeID =",
              "    SUMMARIZE (",
              "        FILTER (",
              "            reference_row_level_security,",
              "            reference_row_level_security[employee_number] = employeeID",
              "        ),",
              "        reference_row_level_security[employee_number],",
              "        reference_row_level_security[supervisor_employee_number]",
              "    )",
              "VAR rk =",
              "    RANKX ( sameEmployeeID, [supervisor_employee_number], managerID, ASC, DENSE )",
              "RETURN",
              "    employeeID",
              "        & IF ( rk > 1, \"_\" & rk, \"\" )",
              ""
            ],
            "isDataTypeInferred": true,
            "lineageTag": "5d657ff7-6ece-4c4d-8151-142765284a12",
            "summarizeBy": "none",
            "type": "calculated"
          },
          {
            "name": "Hierarchy",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "VAR p =",
              "    PATH (",
              "        reference_row_level_security[Employee_Unique_ID],",
              "        reference_row_level_security[supervisor_employee_number]",
              "    )",
              "VAR m =",
              "    SEARCH ( \"_\", p, 1, LEN ( p ) + 1 )",
              "VAR r =",
              "    LEFT ( p, m - 1 )",
              "RETURN",
              "    r",
              "",
              ""
            ],
            "isDataTypeInferred": true,
            "lineageTag": "08656a24-e4f9-4f26-a2a0-acd360578fc7",
            "summarizeBy": "none",
            "type": "calculated"
          },
