            "lineageTag": "f2f78313-0e18-4096-95ec-94bc54fb414a",
            "summarizeBy": "sum",
            "type": "calculated"
          },
          {
            "name": "MonthNo",
            "annotations": [
              {
                "name": "SummarizationSetBy",
