	partition 'Whanau Services Spreadsheet' = m
		mode: import
		source =
				let
				    Source = SharePoint.Files("https://emergeaotearoaltd.sharepoint.com/sites/SPHC2/", [ApiVersion = 15]),
				    #"Whanau Services Info xlsx_https://emergeaotearoaltd sharepoint com/sites/SPHC2/Shared Documents/" = Source{[Name="Whanau Services Info.xlsx",#"Folder Path"="https://emergeaotearoaltd.sharepoint.com/sites/SPHC2/Shared Documents/"]}[Content],
