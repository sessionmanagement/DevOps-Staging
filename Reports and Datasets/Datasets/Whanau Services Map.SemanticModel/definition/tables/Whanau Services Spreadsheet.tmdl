				    #"Whanau Services List_Sheet" = #"Imported Excel Workbook"{[Item="Whanau Services List",Kind="Sheet"]}[Data],
				    #"Promoted Headers" = Table.PromoteHeaders(#"Whanau Services List_Sheet", [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"Service Name", type text}, {"Key Contact within Service", type text}, {"Service Type", type text}, {"How best to contact the service", type text}, {"URL Link to their website", type text}, {"Website URL", type text}, {"What does the service offer?", type text}, {"Referral Criteria", type text}, {"Emerge's Region", type text}, {"Street Number", type any}, {"Street Name", type text}, {"Suburb", type text}, {"City", type text}, {"Postcode", Int64.Type}, {"Latitude", type number}, {"Longitude", type number}}),
				    #"Inserted Replaced Text" = Table.AddColumn(#"Changed Type", "Replaced Text", each Text.Replace([Service Type], "?", "ā"), type text),
				    #"Removed Columns" = Table.RemoveColumns(#"Inserted Replaced Text",{"URL Link to their website", "Service Type"}),
				    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns",{{"Replaced Text", "Service Type"}}),
				    #"Reordered Columns" = Table.ReorderColumns(#"Renamed Columns",{"Service Name", "Key Contact within Service", "How best to contact the service", "Service Type", "Website URL", "What does the service offer?", "Referral Criteria", "Emerge's Region", "Street Number", "Street Name", "Suburb", "City", "Postcode", "Latitude", "Longitude"})
				in
				    #"Reordered Columns"

	annotation PBI_NavigationStepName = Navigation

