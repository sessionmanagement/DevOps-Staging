table 'Whanau Services Spreadsheet'
	lineageTag: 8cb513e7-e880-4552-ba65-5f6b62d3383e

	measure HASONEVALUE = IF(HASONEVALUE('Whanau Services Spreadsheet'[Service Name]),1,0)
