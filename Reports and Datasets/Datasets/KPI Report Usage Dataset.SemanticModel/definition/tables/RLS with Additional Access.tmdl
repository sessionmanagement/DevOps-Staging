table 'RLS with Additional Access'
	lineageTag: d98cead6-a875-4005-bd59-1bb66643b03e

	column 'Manager ID'
		dataType: int64
		formatString: 0
		lineageTag: bdbae027-035e-4ca7-860f-554aec85f9f5
		summarizeBy: count
		sourceColumn: Manager ID

		annotation SummarizationSetBy = Automatic

	column 'Employee ID'
		dataType: int64
		formatString: 0
		lineageTag: 99fda977-da64-418e-932e-7b32a3f0cc51
		summarizeBy: none
		sourceColumn: Employee ID

