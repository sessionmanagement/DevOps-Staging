	measure 'Unique Users 12MR' =
			
			VAR _EndDate = MAX(dim_date[Date])
			VAR _CurrentMonthNumber = MONTH(MAX(dim_date[Date]))
			VAR _CurrentYearNumber = YEAR(MAX(dim_date[date]))
			VAR _StartDate = EOMONTH(DATE(_CurrentYearNumber-1,_CurrentMonthNumber,01),1)+1
			RETURN
			CALCULATE(
			    [Employee Count (fact_activity_log)],
			    ALL(dim_date),
			    dim_date[Date] >= _StartDate,
			    dim_date[Date] <= _EndDate
			)
			
			
			/*
			VAR _MaxDate = MAX(dim_date[Date])
			VAR _Year = MAX(dim_date[calendar_year])
			RETURN
			CALCULATE(
			    [Employee Count (fact_activity_log)],
			    ALL(dim_date),
			    dim_date[calendar_year] = _Year,
			    dim_date[Date] <= _MaxDate
			)
			*/
		formatString: 0
		lineageTag: 05dff8cd-6c0e-4702-9b01-67b9c4382d04

	measure 'Distinct count of date' =
			
			DISTINCTCOUNT(fact_activity_log[nz_create_date])
		formatString: 0
		lineageTag: 32a3c9d2-c691-4bb9-9428-577049a2279d

	measure 'Days between earliest and latest activity' =
			
			DATEDIFF(
			    MIN(
			        fact_activity_log[nz_create_date]),
			        MAX(
			            fact_activity_log[nz_create_date]),
			            DAY
			)
			+1
		formatString: 0
		lineageTag: 101ddb88-1aaf-4930-85d6-48b193b2989f

	measure 'Daily Utilisation Over Est. Lifespan' =
			
			DIVIDE(
			    [Distinct count of date],
			    [Days between earliest and latest activity]
			)
		formatString: 0.00%;-0.00%;0.00%
		isHidden
		lineageTag: 9df8d1c9-e5cb-4468-9e9b-45741b3e4a2e

	measure FiltersApplied_KPIreport = ```
			
			// Date Filters
			//VAR YearFilter = IF(ISFILTERED(dim_date[calendar_year]), CONCATENATEX(FILTERS(dim_date[calendar_year]), dim_date[calendar_year], ", "), BLANK())
			//VAR MonthFilter = IF(ISFILTERED(dim_date[calendar_month_name_short]), CONCATENATEX(FILTERS(dim_date[calendar_month_name_short]), dim_date[calendar_month_name_short], ", "), BLANK())
			
			
			// Department Name Filter Summary
			VAR L2BusinessUnitsFiltered = TOPN(10, FILTER(VALUES(dim_employee_hierarchy[department_name]), NOT(ISBLANK(dim_employee_hierarchy[department_name]))), dim_employee_hierarchy[department_name], ASC)
			VAR L2BusinessUnitsCount = IF(ISFILTERED(dim_employee_hierarchy[department_name]), COUNTROWS(VALUES(dim_employee_hierarchy[department_name])), 0)
			VAR MoreL2BusinessUnits = IF(L2BusinessUnitsCount > 10, " and " & (L2BusinessUnitsCount - 10) & " more", "")
			VAR L2BusinessUnitFilterSummary = IF(L2BusinessUnitsCount > 0, "| DEPARTMENT: " & CONCATENATEX(L2BusinessUnitsFiltered, dim_employee_hierarchy[department_name], ", "), BLANK()) & MoreL2BusinessUnits
			
			// Region Name Filter Summary
			VAR RegionFiltered = TOPN(10, FILTER(VALUES(dim_employee_hierarchy[region_name]), NOT(ISBLANK(dim_employee_hierarchy[region_name]))), dim_employee_hierarchy[region_name], ASC)
			VAR RegionCount = IF(ISFILTERED(dim_employee_hierarchy[region_name]), COUNTROWS(VALUES(dim_employee_hierarchy[region_name])), 0)
			VAR MoreRegions = IF(RegionCount > 10, " and " & (RegionCount - 10) & " more", "")
			VAR RegionFilterSummary = IF(RegionCount > 0, "| REGION: " & CONCATENATEX(RegionFiltered, dim_employee_hierarchy[region_name], ", "), BLANK()) & MoreRegions
			
			// District Name Filter Summary
			VAR DistrictFiltered = TOPN(10, FILTER(VALUES(dim_employee_hierarchy[district_name]), NOT(ISBLANK(dim_employee_hierarchy[district_name]))), dim_employee_hierarchy[district_name], ASC)
			VAR DistrictCount = IF(ISFILTERED(dim_employee_hierarchy[district_name]), COUNTROWS(VALUES(dim_employee_hierarchy[district_name])), 0)
			VAR MoreDistricts = IF(DistrictCount > 10, " and " & (DistrictCount - 10) & " more", "")
			VAR DistrictFilterSummary = IF(DistrictCount > 0, "| DISTRICT: " & CONCATENATEX(DistrictFiltered, dim_employee_hierarchy[district_name], ", "), BLANK()) & MoreDistricts
			
			// District Name Filter Summary
			VAR ServiceFiltered = TOPN(10, FILTER(VALUES(dim_employee_hierarchy[service_name]), NOT(ISBLANK(dim_employee_hierarchy[service_name]))), dim_employee_hierarchy[service_name], ASC)
			VAR ServiceCount = IF(ISFILTERED(dim_employee_hierarchy[service_name]), COUNTROWS(VALUES(dim_employee_hierarchy[service_name])), 0)
			VAR MoreServices = IF(DistrictCount > 10, " and " & (DistrictCount - 10) & " more", "")
			VAR ServiceFilterSummary = IF(ServiceCount > 0, "| SERVICE: " & CONCATENATEX(ServiceFiltered, dim_employee_hierarchy[service_name], ", "), BLANK()) & MoreServices
			
			
			// Date Range Calculation with Error Handling
			// VAR StartDate = MIN(dim_date[date])
			// VAR EndDate = MAX(dim_date[date])
			// VAR DateRange = IF(
			//     NOT(ISBLANK(StartDate)) && NOT(ISBLANK(EndDate)),
			//     "Data shown is based on the following date range: " & FORMAT(StartDate, "dd/MM/YYYY") & " - " & FORMAT(EndDate, "dd/MM/YYYY") & " ",
			//     "Date range not available. "
			// )
			
			// Final Output Construction
			RETURN
			    //DateRange &
			    IF(
			       // ISBLANK(YearFilter) && ISBLANK(MonthFilter) && 
			        ISBLANK(L2BusinessUnitFilterSummary) && ISBLANK(RegionFilterSummary) && ISBLANK(DistrictFilterSummary) && ISBLANK(ServiceFilterSummary),
			        "",
			        "Summary of filters applied: " & 
			        //YearFilter & " " & MonthFilter & " "  &
			        L2BusinessUnitFilterSummary & " " & RegionFilterSummary & " " & DistrictFilterSummary & " " & ServiceFilterSummary
			    )
			```
		lineageTag: a6139ca4-c7a8-409d-a571-8ac36bc475ac

