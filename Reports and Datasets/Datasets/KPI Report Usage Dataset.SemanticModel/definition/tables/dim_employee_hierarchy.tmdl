	partition dim_employee_hierarchy = m
		mode: import
		queryGroup: Dimensions
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="#(lf)SELECT DISTINCT#(lf)       e.[dim_employee_key]#(lf)      ,e.[employee_id]#(lf)      ,e.[employee_name]#(lf)      ,ds.dim_service_key#(lf)      ,ds.service_id#(lf)      ,ds.department_name#(lf)      ,ds.region_name#(lf)      ,ds.district_name#(lf)      ,ds.service_name#(lf)      ,LOWER (e.[employee_primary_email_address]) AS employee_primary_email_address#(lf)#(tab)  ,h.[employee_people_leader_business_unit_name_level_1]#(lf)#(tab)  ,h.[employee_people_leader_business_unit_name_level_2]#(lf)#(tab)  ,h.[employee_people_leader_business_unit_name_level_3]#(lf)#(tab)  ,h.[employee_people_leader_business_unit_name_level_4]#(lf)#(tab)  ,h.[employee_people_leader_business_unit_name_level_5]#(lf)#(tab)  ,h.[employee_people_leader_business_unit_name_level_6]#(lf)#(tab)  ,h.[employee_people_leader_business_unit_name_level_7]#(lf)#(tab)  ,h.[employee_people_leader_business_unit_name_level_8]#(lf)#(tab)  ,h.[employee_people_leader_business_unit_name_level_9]#(lf)#(tab)#(tab),CONCAT(#(lf)#(tab)#(tab)    ISNULL(h.[employee_people_leader_business_unit_name_level_1] + CASE WHEN h.[employee_people_leader_business_unit_name_level_2] IS NOT NULL THEN ' -> ' ELSE '' END, ''),#(lf)#(tab)#(tab)    ISNULL(h.[employee_people_leader_business_unit_name_level_2] + CASE WHEN h.[employee_people_leader_business_unit_name_level_3] IS NOT NULL THEN ' -> ' ELSE '' END, ''),#(lf)#(tab)#(tab)    ISNULL(h.[employee_people_leader_business_unit_name_level_3] + CASE WHEN h.[employee_people_leader_business_unit_name_level_4] IS NOT NULL THEN ' -> ' ELSE '' END, ''),#(lf)#(tab)#(tab)    ISNULL(h.[employee_people_leader_business_unit_name_level_4] + CASE WHEN h.[employee_people_leader_business_unit_name_level_5] IS NOT NULL THEN ' -> ' ELSE '' END, ''),#(lf)#(tab)#(tab)    ISNULL(h.[employee_people_leader_business_unit_name_level_5] + CASE WHEN h.[employee_people_leader_business_unit_name_level_6] IS NOT NULL THEN ' -> ' ELSE '' END, ''),#(lf)#(tab)#(tab)    ISNULL(h.[employee_people_leader_business_unit_name_level_6] + CASE WHEN h.[employee_people_leader_business_unit_name_level_7] IS NOT NULL THEN ' -> ' ELSE '' END, ''),#(lf)#(tab)#(tab)    ISNULL(h.[employee_people_leader_business_unit_name_level_7] + CASE WHEN h.[employee_people_leader_business_unit_name_level_8] IS NOT NULL THEN ' -> ' ELSE '' END, ''),#(lf)#(tab)#(tab)    ISNULL(h.[employee_people_leader_business_unit_name_level_8] + CASE WHEN h.[employee_people_leader_business_unit_name_level_9] IS NOT NULL THEN ' -> ' ELSE '' END, ''),#(lf)#(tab)#(tab)    ISNULL(h.[employee_people_leader_business_unit_name_level_9], '')#(lf)    ) AS [business_unit_hierarchy]#(lf)  FROM [edw].[dim_employee] e#(lf)  LEFT OUTER JOIN [edw].[dim_employee_hierarchy] h ON e.dim_employee_key = h.dim_employee_key#(lf)  LEFT JOIN edw.dim_service ds ON ds.service_name = h.employee_Business_unit_name#(lf)  WHERE#(lf)  h.DWHIsCurrent =1 #(lf)  AND h.DWHDMLOperation <> 'd'#(lf)  AND ds.DWHIsCurrent = 1 #(lf)  AND ds.DWHDMLOperation <> 'd'#(lf)  AND ds.dim_company_key <> 5#(lf)  AND ds.service_id <> 115892#(lf)  AND#(lf)  e.dim_employee_key > 0 AND #(lf)  e.[DWHIsCurrent] = 1 AND h.[DWHIsCurrent] = 1#(lf)#(lf)  UNION ALL#(lf)#(lf)SELECT #(lf)    *,#(lf)    employee_people_leader_business_unit_name_level_1 + ' -> ' + employee_people_leader_business_unit_name_level_2 AS business_unit_hierarchy#(lf)FROM #(lf)    (#(lf)        SELECT DISTINCT#(lf)            9999999 AS dim_employee_key,#(lf)            NULL AS employee_id,#(lf)            CASE #(lf)                WHEN CHARINDEX('.', t1.user_id) > 0 AND CHARINDEX('@', t1.user_id) > CHARINDEX('.', t1.user_id) THEN#(lf)                    CONCAT(#(lf)                        LEFT(t1.user_id, CHARINDEX('.', t1.user_id) - 1), #(lf)                        ' ', #(lf)                        SUBSTRING(#(lf)                            t1.user_id, #(lf)                            CHARINDEX('.', t1.user_id) + 1, #(lf)                            CHARINDEX('@', t1.user_id) - CHARINDEX('.', t1.user_id) - 1#(lf)                        )#(lf)                    )#(lf)                ELSE#(lf)                    t1.user_id#(lf)            END AS employee_name,#(lf)            999999 as dim_service_key,#(lf)            999999 as service_id,#(lf)            'Unknown' as department_name,#(lf)            'Unknown' as region_name,#(lf)            'Unknown' as district_name,#(lf)            'Unknown' as service_name,#(lf)            t1.user_id AS employee_primary_email_address,#(lf)            'External' AS employee_people_leader_business_unit_name_level_1,#(lf)            SUBSTRING(#(lf)                t1.user_id, #(lf)                CHARINDEX('@', t1.user_id) + 1, #(lf)                CHARINDEX('.', t1.user_id, CHARINDEX('@', t1.user_id)) - CHARINDEX('@', t1.user_id) - 1#(lf)            ) + ' (External)' AS employee_people_leader_business_unit_name_level_2,#(lf)            NULL AS employee_people_leader_business_unit_name_level_3,#(lf)            NULL AS employee_people_leader_business_unit_name_level_4,#(lf)            NULL AS employee_people_leader_business_unit_name_level_5,#(lf)            NULL AS employee_people_leader_business_unit_name_level_6,#(lf)            NULL AS employee_people_leader_business_unit_name_level_7,#(lf)            NULL AS employee_people_leader_business_unit_name_level_8,#(lf)            NULL AS employee_people_leader_business_unit_name_level_9#(lf)        FROM #(lf)            [edw].[fact_powerbi_activity_log] t1#(lf)        WHERE #(lf)            t1.user_id LIKE '%@%' AND #(lf)            t1.user_id NOT LIKE '%emergeaotearoa%' AND #(lf)            t1.user_id NOT LIKE '%ignite.org.nz' AND #(lf)            t1.user_id NOT LIKE '%mindandbody.co.nz'#(lf)#(lf)        UNION#(lf)#(lf)        SELECT#(lf)            9999999,#(lf)            NULL,#(lf)            'Unknown/System',#(lf)            999999,#(lf)            999999,#(lf)             'Unknown' ,#(lf)            'Unknown' ,#(lf)            'Unknown' ,#(lf)            'Unknown' ,#(lf)            'unknown@unknown.com',#(lf)            'Unknown',#(lf)            'Unknown',#(lf)            NULL,#(lf)            NULL,#(lf)            NULL,#(lf)            NULL,#(lf)            NULL,#(lf)            NULL,#(lf)            NULL#(lf)    ) AS t2;#(lf)#(lf)-- Row filter(s) defined in REFERENCED Power Query expressions (verify which apply to this source before adding to WHERE):#(lf)--   each Text.Contains([Folder Path], ""KPI"")#(lf)--   each ([Folder Path] = ""https://emergeaotearoaltd.sharepoint.com/sites/OPS_ITServices/Shared Documents/Data and Analytics/_New Structure/Projects/KPI Project/"")#(lf)"]),
				    #"Merged Queries" = Table.FuzzyNestedJoin(Source, {"employee_primary_email_address"}, #"PowerBi User List", {"userPrincipalName"}, "PowerBi User List", JoinKind.LeftOuter, [IgnoreCase=true, IgnoreSpace=false]),
				    #"Expanded PowerBi User List" = Table.ExpandTableColumn(#"Merged Queries", "PowerBi User List", {"isUser"}, {"isUser"})
				in
				    #"Expanded PowerBi User List"

	annotation PBI_ResultType = Exception

