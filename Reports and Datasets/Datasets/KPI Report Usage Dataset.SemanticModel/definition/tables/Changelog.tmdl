table Changelog
	lineageTag: 9d64320d-ea62-450d-8e1f-4bf77469b2d9

	measure 'Latest Version' =
			
			VAR LatestChangeID =
			    MAX ( 'Changelog'[Change ID] )
			VAR LatestVersion =
			    MAXX (
			        FILTER ( 'Changelog', 'Changelog'[Change ID] = LatestChangeID ),
			        'Changelog'[Version]
			    )
			RETURN
			    "Key Measure Usage Dataset - v" & LatestVersion
		lineageTag: a6f73b9f-2124-48d2-b059-799b16eadc6d

	column 'Change ID'
		dataType: int64
		formatString: 0
		lineageTag: c48c5b85-41f7-4f83-bdbe-ff06e15d078c
		summarizeBy: count
		sourceColumn: Change ID

		annotation SummarizationSetBy = Automatic

	column Version
		dataType: string
		lineageTag: aaacc7c0-c80a-490a-b3e0-c6fe4d076da6
		summarizeBy: none
		sourceColumn: Version

		annotation SummarizationSetBy = Automatic

	column 'Change Date'
		dataType: string
		lineageTag: f74062ae-4df3-406f-a0ce-a8e8176e1e05
		summarizeBy: none
		sourceColumn: Change Date

		annotation SummarizationSetBy = Automatic

	column 'Changed By'
		dataType: string
		lineageTag: aab7af79-e959-466a-aa97-49a27dc4bfd7
		summarizeBy: none
		sourceColumn: Changed By

		annotation SummarizationSetBy = Automatic

	column 'User Story ID'
		dataType: string
		lineageTag: fa4f3fb8-ed35-4474-820b-b71fd600295b
		summarizeBy: none
		sourceColumn: User Story ID

		annotation SummarizationSetBy = Automatic

	column Description
		dataType: string
		lineageTag: 8009fd62-097f-4a01-9c7c-8b951ad9b8cd
		summarizeBy: none
		sourceColumn: Description

		annotation SummarizationSetBy = Automatic

	partition Changelog = m
		mode: import
		source =
				let
				    // Define the table schema without the ChangeID column
				    InitialTable = #table(
				        {"Version", "Change Date", "Changed By", "User Story ID", "Description"},
				        {
				
				             {
				                "1.2.0", /* Version */
				                #date(2026, 10, 8),  /* Date */
				                "Mike G",  /* Changed By */
				                "TBC",  /* User Story */
				                "Migrated RLS to edw.row_level_security_general (RLS_type 'Employee'), replacing the inline edw.dim_employee_hierarchy people-leader query, and removed the unused RLS columns and the unused 'Additional Access (2)' query. Cost-allocated service managers, team leaders and district managers gain whole subtrees; managers lose past staff's activity, depth-9 staff lose their own row, and leaders who are not current or exiting staff drop out."  /* Description */
				            },{
				                "1.1.1", /* Version */
				                #date(2026, 07, 06),  /* Date */
				                "Thijs",  /* Changed By */
				                "13877",  /* User Story */
				                "Remove unused columns"  /* Description */
				            },{
				                "1.1.0", /* Version */
				                #date(2026, 05, 29),  /* Date */
				                "Thijs",  /* Changed By */
				                "13716",  /* User Story */
				                "Update additional access"  /* Description */
				            },{
				                "1.0.0", /* Version */
				                #date(2026, 02, 25),  /* Date */
				                "Thijs",  /* Changed By */
				                "12836",  /* User Story */
				                "First Release"  /* Description */
				            }
				        }
				    ),
				
				    // Add an Index column to generate incremental numbers
				    TableWithIndex = Table.AddIndexColumn(InitialTable, "Change ID", 1, 1, Int64.Type),
				
				    // Reorder the columns to place ChangeID first
				    ReorderedColumns = Table.ReorderColumns(TableWithIndex, {"Change ID", "Version", "Change Date", "Changed By", "User Story ID", "Description"})
				in
				    ReorderedColumns

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

