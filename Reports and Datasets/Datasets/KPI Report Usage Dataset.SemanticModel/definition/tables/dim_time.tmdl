			                                                                    IF(
			                                                                        dim_time[hour24h] = "17", "5:00pm - 5:59pm",
			                                                                        IF(
			                                                                            dim_time[hour24h] = "18", "6:00pm - 6:59pm",
			                                                                            IF(
			                                                                                dim_time[hour24h] = "19", "7:00pm - 7:59pm",
			                                                                                IF(
