	column FourHourlyBucket =
			
			IF(
			    dim_time[dim_time_key] < 40000, "12:00am - 3:59am",
			    IF(
			        dim_time[dim_time_key] < 80000, "4:00am - 7:59am",
			        IF(
			            dim_time[dim_time_key] < 120000, "8:00am - 11:59am",
			            IF(
			                dim_time[dim_time_key] < 160000, "12:00pm - 3:59pm",
			                IF(
			                    dim_time[dim_time_key] < 20000, "4:00pm - 7:59pm",
			                    "8:00pm - 11.59pm"
			                )
			            )
			        )
			    )
			)
		isHidden
		lineageTag: 951a57cc-9f5e-4eac-a96f-96f8aebf0ba0
		summarizeBy: none
		sortByColumn: FourHourlyBucketSort

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column EightHourlyBucket =
			
			IF(
			    dim_time[dim_time_key] < 80000, "12:00am - 7:59am",
			    IF(
			        dim_time[dim_time_key] < 160000, "8:00am - 5:59pm",
			        "6:00pm - 11:59pm"
			    )
			)
		isHidden
		lineageTag: 32b12d5e-1b56-4060-8ad0-460b9e7335c4
		summarizeBy: none
		sortByColumn: EightHourlyBucketSort

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column FourHourlyBucketSort =
			
			IF(
			    dim_time[dim_time_key] < 40000, 1,
			    IF(
			        dim_time[dim_time_key] < 80000, 2,
			        IF(
			            dim_time[dim_time_key] < 120000, 3,
			            IF(
			                dim_time[dim_time_key] < 160000, 4,
			                IF(
			                    dim_time[dim_time_key] < 20000, 5,
			                    6
			                )
			            )
			        )
			    )
			)
		isHidden
		formatString: 0
