erarchy] de#(lf)  LEFT JOIN#(lf)  edw.vw_dim_service ds ON ds.service_name = de.employee_Business_unit_name#(lf)  WHERE#(lf)  de.DWHIsCurrent =1 #(lf)  AND de.DWHDMLOperation <> 'd'#(lf)  AND ds.DWHIsCurrent =1 #(lf)  AND ds.DWHDMLOperation <> 'd')#(lf)#(lf)  SELECT#(lf)  PBI.*#(lf)  ,dim_service_key#(lf)    ,service_id#(lf)  FROM PBI#(lf)  LEFT JOIN#(lf)  service on employee_primary_email_address = user_id;#(lf)"]),
