	partition PayRates-acb50edf-e48a-4cd3-9bef-95b497c37fdf = m
		mode: import
		queryGroup: 'Final Tables'
		source =
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="SELECT [id]#(lf)      ,[type]#(lf)      ,[company_id]#(lf)      ,[code]#(lf)      ,[first_name] + ' ' + [last_name] AS display_name#(lf)      ,[gender]#(lf)      ,[pay_rate_value]#(lf)      ,[standard_hours_per_week_value]#(lf)      ,[standard_days_per_week_value]#(lf)      ,[ODSIsCurrent]#(lf)  FROM [Datapay].[employees]#(lf)  WHERE ODSIsCurrent = 1#(lf)  AND termination_date IS NULL#(lf)  --These are dummy/test people#(lf)  AND code NOT IN ('40000001', '5000001')"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"pay_rate_value", type number}}),
				    #"Added Custom" = Table.AddColumn(#"Changed Type", "HourlyPay", each if [pay_rate_value] < 500 then [pay_rate_value] else [pay_rate_value] / 2080),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Added Custom",{{"HourlyPay", Currency.Type}}),
				    #"Replaced Errors" = Table.ReplaceErrorValues(#"Changed Type1", {{"HourlyPay", 0}}),
				    #"Changed Type2" = Table.TransformColumnTypes(#"Replaced Errors",{{"HourlyPay", type number}}),
				    #"Rounded Off" = Table.TransformColumns(#"Changed Type2",{{"HourlyPay", each Number.Round(_, 2), type number}})
				in
				    #"Rounded Off"

	annotation PBI_ResultType = Table

