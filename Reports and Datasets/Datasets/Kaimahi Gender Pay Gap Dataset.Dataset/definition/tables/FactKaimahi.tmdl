	column ActiveStatus = IF('FactKaimahi'[companyEndDate] = BLANK() || 'FactKaimahi'[companyEndDate]>TODAY(),"Active", "Not Active")
		lineageTag: 905760e0-a6d1-44c2-aca7-83154c72459f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Index
		dataType: int64
		formatString: 0
		lineageTag: e1541e35-f725-4ebf-a01b-548323a13bcd
		summarizeBy: sum
		sourceColumn: Index

		annotation SummarizationSetBy = Automatic

	column LatestJobRank = COUNTROWS(FILTER(ALL('FactKaimahi'),'FactKaimahi'[Index]<=EARLIER('FactKaimahi'[Index]) && 'FactKaimahi'[person_id]=EARLIER('FactKaimahi'[person_id])))
		formatString: 0
		lineageTag: 6ff0ac7d-6e78-47ea-a451-4612d8835222
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column NewRank =
			
			VAR R1 =
			    COUNTROWS(
			        FILTER(
			            ALL( 'FactKaimahi' ),
			            'FactKaimahi'[Index]
			                <= EARLIER( 'FactKaimahi'[Index] )
			                && 'FactKaimahi'[person_id]
			                    = EARLIER( 'FactKaimahi'[person_id] )
			                && 'FactKaimahi'[ActiveStatus] = "Not Active"
			        )
			    )
			RETURN
			    IF(
			        'FactKaimahi'[jobStatus] = "Active" && 'FactKaimahi'[ActiveStatus] = "Active",
			        0,
			        R1
			    )
		formatString: 0
		lineageTag: c2e95925-3e63-4f58-9f1a-687ed8da72bf
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

