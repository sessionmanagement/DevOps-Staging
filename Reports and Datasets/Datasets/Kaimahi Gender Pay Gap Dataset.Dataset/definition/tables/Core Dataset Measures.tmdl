	measure '% Undisclosed' =
			
			CALCULATE(
			    DISTINCTCOUNT( 'intellihr jobs'[person_id] ),
			    'intellihr people'[gender] = "Undisclosed"
			    ,ALLCROSSFILTERED(Dates)
			)
			    / CALCULATE(
			        DISTINCTCOUNT( 'intellihr jobs'[person_id] )
			        ,ALLCROSSFILTERED(Dates)
