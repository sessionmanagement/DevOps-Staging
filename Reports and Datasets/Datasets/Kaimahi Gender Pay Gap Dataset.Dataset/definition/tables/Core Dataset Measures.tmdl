			CALCULATE(AVERAGE(FactKaimahi[HourlyPay]), FactKaimahi[Gender] = "Female")
			
			
			```
		displayFolder: Gender Pay Gap
		lineageTag: 31a09ed2-6735-4e7d-80b9-dc1c773cdecb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Hourly Male Pay' = CALCULATE(AVERAGE(FactKaimahi[HourlyPay]), FactKaimahi[Gender] = "Male")
		displayFolder: Gender Pay Gap
		lineageTag: 9d4068fe-adad-46bf-8d6f-c8d49f86c049

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Gender Pay Gap' = ```
			
			// Threshold for how many employees need to count for each Gender for the Pay Gap calculation to matter - i.e if only 1 employee then there's no point and if only 2, grain is too small
			VAR Threshold = [PayGapThreshold] // How many males are in the selected population
			VAR TotalMales = [Number of Males]
			     // How many females are in the selected population
			VAR TotalFemales = [Number of Females]
			    // Calculate Gender Pay Gap
			VAR GenderPayGap =
			    IF (
			        // Calculate the Gender Pay gap only if the amount of males or females exceeds the threshold set by the PX team
			        TotalMales < Threshold
			            || TotalFemales < Threshold,
			        0,
			        ( [Average Hourly Male Pay] - [Average Hourly Female Pay] )
			            / [Average Hourly Male Pay]
			    )
			RETURN
			    GenderPayGap
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Gender Pay Gap
		lineageTag: c322b4ac-20ac-48d4-887c-9d5c9be5e459

	measure PayGapThreshold = 5
		formatString: 0
		displayFolder: Gender Pay Gap
		lineageTag: 13eb96ed-2a10-49e1-b364-c26842968ce6

	measure 'Median Gender Pay Gap' = ```
			
			// Threshold for how many employees need to count for each Gender for the Pay Gap calculation to matter - i.e if only 1 employee then there's no point and if only 2, grain is too small
			VAR Threshold = [PayGapThreshold] // How many males are in the selected population
			VAR TotalMales = [Number of Males]
			     // How many females are in the selected population
			VAR TotalFemales = [Number of Females] // Calculate Gender Pay Gap
			VAR GenderPayGap =
			    IF (
			        // Calculate the Gender Pay gap only if the amount of males or females exceeds the threshold set by the PX team
			        TotalMales < Threshold
			            || TotalFemales < Threshold,
			        0,
			       ( [Median Male Pay Ratio] - [Median Female Pay Ratio])
			       / [Median Male Pay Ratio]
			
			    )
			RETURN
			    GenderPayGap
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: fb41e549-1063-4b26-bf5f-a45ec6df2fce

