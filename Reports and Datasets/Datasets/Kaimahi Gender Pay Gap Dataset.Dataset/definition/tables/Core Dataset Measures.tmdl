table 'Core Dataset Measures'
	lineageTag: 90eae8c9-0ea2-4b3a-ae8e-24b08f9f6b2f

	measure 'Head Count' =
			
			CALCULATE (
			   DISTINCTCOUNT('FactKaimahi'[person_id])
			    ,'FactKaimahi'[companyStartDate] < TODAY ()
			)
		formatString: 0
		lineageTag: dd7312e0-68c8-4f4a-b4c6-c6b374da3c07

		changedProperty = FormatString

	measure _CurrentStaff = ```
			
			VAR Currentdate =
			    MAX( Dates[Date] )
			VAR MinDate =
			    MIN( Dates[Date] )
			RETURN
			    CALCULATE(
			        SUMX(
			            'FactKaimahi',
			            IF(
			                'FactKaimahi'[companyStartDate] <= Currentdate
			                    && OR(
			                        'FactKaimahi'[companyEndDate] >= MinDate,
			                        ISBLANK( 'FactKaimahi'[companyEndDate] )
			                    ),
			                1,
			                BLANK()
			            )
			        ),
			        ALLCROSSFILTERED( Dates )
			    )
			
			```
		formatString: 0
		lineageTag: 3e9fc369-e1af-41c3-a9c2-09074bebbf5a

	measure SelectedDate = FORMAT(FIRSTDATE('Dates'[Date]), "dd/MM/YYYY") & " - " & FORMAT(LASTDATE('Dates'[Date]), "dd/MM/YYYY")
		displayFolder: Filter Notes
		lineageTag: 639e4d16-b46c-45cd-b86c-fba8e3645bb3

	measure PreviousYearStaff = CALCULATE([_CurrentStaff], SAMEPERIODLASTYEAR(Dates[Date]))
		formatString: 0
		lineageTag: e9022133-b0d1-4cb6-906b-575809dd5895

	measure _ActiveStaffEOM = ```
			
			VAR Currentdate =
			    MAX( Dates[Date] )
			RETURN
			    CALCULATE(
			        SUMX(
			            'FactKaimahi',
			            IF(
			                'FactKaimahi'[companyStartDate] <= Currentdate
			                    && OR(
			                        'FactKaimahi'[companyEndDate] >= Currentdate,
			                        ISBLANK( 'FactKaimahi'[companyEndDate] )
			                    ),
			                1,
			                BLANK()
			            )
			        ),
			        ALLCROSSFILTERED( Dates )
			    )
			
			```
		formatString: 0
		lineageTag: 1bf7045d-01fe-42df-9b90-bb382739cfd5

	measure _ActiveStaffSOM = ```
			
			VAR Currentdate =
			    MIN( Dates[Date] )
			RETURN
			    CALCULATE(
			        SUMX(
			            'FactKaimahi',
			            IF(
			                'FactKaimahi'[companyStartDate] <= Currentdate
			                    && OR(
			                        'FactKaimahi'[companyEndDate] >= Currentdate,
			                        ISBLANK( 'FactKaimahi'[companyEndDate] )
			                    ),
			                1,
			                BLANK()
			            )
			        ),
			        ALLCROSSFILTERED( Dates )
			    )
			
			```
		formatString: 0
		lineageTag: c2d6e32d-4d33-4e7f-bb4b-028a436e3568

	measure 'Attrition Rate' = DIVIDE([_ActiveStaffSOM]+[_ActiveStaffEOM],2,0)
		lineageTag: 8f6acf50-53be-4659-849a-e2f60e884cd2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure EndedDuringMonth = [StaffEntering] - [StaffLeaving]
		formatString: 0
		lineageTag: 7228939f-3baa-4a33-83bc-bcec1979f6d0

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isDecimal":true}

	measure _MonthlyAttritionPercentage =
			
			DIVIDE(
			    CALCULATE(
			        [StaffLeaving]
			    ),
			    [Attrition Rate],
			    0
			)
		lineageTag: cae4fa9d-44bd-4268-802e-05b471f465a0

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure TotalJobTitle =
			
			CALCULATE(
			    COUNT( 'FactKaimahi'[Job Title] ),
			    ALLCROSSFILTERED( Dates )
			)
		formatString: 0
		lineageTag: 0c3548b8-5289-463e-937e-5b40df0f7bda

	measure StaffLeaving = ```
			
			CALCULATE (
			    DISTINCTCOUNT('FactKaimahi'[person_id]),
			    USERELATIONSHIP ( Dates[Date], 'FactKaimahi'[companyEndDate])
			   ,FILTER('FactKaimahi', 
			        'FactKaimahi'[LatestJobRank] = 1
			        )
			)
			```
		formatString: 0
		lineageTag: 2f55e095-6c20-4999-9817-f71a289f7799

	measure StaffEntering =
			
			CALCULATE (
			    COUNTA('FactKaimahi'[Kaimahi Name]),
			    USERELATIONSHIP ( Dates[Date], 'FactKaimahi'[companyStartDate] )
			)
		formatString: 0
		lineageTag: da20af3d-0688-4cda-885f-a1f8a31d878c

	measure StaffLeavingNegative =
			
			CALCULATE (
			   [Head Count],
			    USERELATIONSHIP ( Dates[Date], 'FactKaimahi'[companyEndDate] ),
			    FILTER ( 'FactKaimahi', 'FactKaimahi'[companyEndDate] >= MIN ( Dates[Date] ) )
			) * -1
		formatString: 0
		lineageTag: 5e65f2de-7a2e-4b9f-b417-3e7f46f46244

	measure 'Moving 12 month sum' = CALCULATE(sum('FactPeople'[people_id]),DATESINPERIOD(Dates[Date],MAX(Dates[Date]),-12,MONTH))
		formatString: 0
		lineageTag: bfd4ec92-81f5-4bcd-a3e5-ea27a09e979f

		changedProperty = FormatString

	measure 'Annual Turnover Rate' =
			
			VAR sd =
			    LASTDATE(
			        DATEADD(
			            Dates[Date],
			            -1,
			            YEAR
			        )
			    )
			RETURN
			    CALCULATE(
			        SUMX(
			            SUMMARIZE(
			                'FactKaimahi',
			                "AnnualAttrition", [_MonthlyAttritionPercentage]
			            ),
			            [_MonthlyAttritionPercentage]
			        ),
			        FILTER(
			            ALL( Dates ),
			            Dates[Date] > sd
			                && Dates[Date]
			                    <= MAX( Dates[Date] )
			        )
			        --,CROSSFILTER(Dates[Date],'intellihr jobs'[companyStartDate],None),CROSSFILTER(Dates[Date],'intellihr jobs'[companyEndDate],None)
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 23d52c19-99eb-4dfd-9e23-df3e3e1b29fe

		changedProperty = FormatString

	measure RefreshedAt_forDisplay = "Date Last Refreshed: " & FORMAT( LASTDATE( 'Last Refreshed Date'[Date Last Refreshed] ), "dd/MM/YYYY" )
		lineageTag: 04891d79-1145-4e52-a3a3-d8b03ffc2dec

