		        else if [employee_ethnicity] = "English" then "European"
		        else if [employee_ethnicity] = "English,German" then "European"
		        else if [employee_ethnicity] = "European" then "European"
		        else if [employee_ethnicity] = "German" then "European"
		        else if [employee_ethnicity] = "German,Niuean,Tongan" then "European"
		        else if [employee_ethnicity] = "Greek (including Greek Cypriot)" then "European"
		        else if [employee_ethnicity] = "Hungarian" then "European"
		        else if [employee_ethnicity] = "Indian,South African" then "European"
		        else if [employee_ethnicity] = "Irish" then "European"
		        else if [employee_ethnicity] = "Italian" then "European"
		        else if [employee_ethnicity] = "Lithuanian" then "European"
		        else if [employee_ethnicity] = "Maltese" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,African American" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,Asian,Japanese,Malaysian Chinese" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,Australian Aboriginal" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,Australian,Canadian,Italian" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,Brazilian" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,Canadian" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,Cook Island Maori" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,Cook Islander" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,Croat / Croatian,Irish,Jamaican" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,Croat / Croatian,Swiss" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,Danish,Samoan,Tongan" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,Dutch / Netherlands" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,English" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,Fijian (except Fiji Indian / Indo-Fijian),Scottish (Scots)" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,Finnish" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,Iranian / Persian" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,Italian" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,Japanese" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,Malaysian" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,Niuean" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,Other European" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,Pacific Peoples" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,Romany / Gypsy,Scottish (Scots)" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,Russian" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,Samoan" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,Scottish (Scots)" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,South African" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,Swiss" then "European"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,Tongan" then "European"
		        else if [employee_ethnicity] = "New Zealander" then "European"
		        else if [employee_ethnicity] = "Other European" then "European"
		        else if [employee_ethnicity] = "Portuguese" then "European"
		        else if [employee_ethnicity] = "Russian" then "European"
		        else if [employee_ethnicity] = "Scandinavian" then "European"
		        else if [employee_ethnicity] = "Scottish (Scots)" then "European"
		        else if [employee_ethnicity] = "Serb / Serbian" then "European"
		        else if [employee_ethnicity] = "Serb / Serbian,Turkish (including Turkish Cypriot)" then "European"
		        else if [employee_ethnicity] = "Slovak" then "European"
		        else if [employee_ethnicity] = "South African" then "European"
		        else if [employee_ethnicity] = "Swedish" then "European"
		        else if [employee_ethnicity] = "Swiss" then "European"
		        else if [employee_ethnicity] = "Welsh" then "European"
		        
		        // Asian
		        else if [employee_ethnicity] = "Afghan" then "Asian"
		        else if [employee_ethnicity] = "Asian" then "Asian"
		        else if [employee_ethnicity] = "Asian,Indian" then "Asian"
		        else if [employee_ethnicity] = "Asian,Nepalese" then "Asian"
		        else if [employee_ethnicity] = "Bangladeshi" then "Asian"
		        else if [employee_ethnicity] = "Burmese,Nepalese" then "Asian"
		        else if [employee_ethnicity] = "Ca Kong Chinese,Samoan" then "Asian"
		        else if [employee_ethnicity] = "Cambodian" then "Asian"
		        else if [employee_ethnicity] = "Chinese" then "Asian"
		        else if [employee_ethnicity] = "Chinese,Indonesian" then "Asian"
		        else if [employee_ethnicity] = "Fijian Indian / Indo-Fijian" then "Asian"
