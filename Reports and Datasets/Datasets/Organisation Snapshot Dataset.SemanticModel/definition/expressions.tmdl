expression 'Ethnicity Historical Mapping' = ```
		let
		    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [employee_ethnicity = _t]),
		    #"Changed Type" = Table.TransformColumnTypes(Source,{{"employee_ethnicity", type text}}),
		    
		    #"Added Ethnicity Group" = Table.AddColumn(#"Changed Type", "Ethnicity Group", each 
		        if [employee_ethnicity] = null then "Unspecified"
		        
		        // Maori
		        else if [employee_ethnicity] = "Māori" then "Maori"
		        else if [employee_ethnicity] = "Māori,Niuean" then "Maori"
		        else if [employee_ethnicity] = "New Zealand European / Pakeha,Māori" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,Cook Island Maori" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,Cook Island Maori,European" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,Cook Islander,Samoan" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,Croat / Croatian" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,Dutch / Netherlands" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,English,German,Samoan" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,English,Scottish (Scots),Swedish" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,European,New Zealander" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,Fijian (except Fiji Indian / Indo-Fijian)" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,French,Māori" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,Hungarian" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,Irish" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,Irish,Samoan" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,Italian,Portuguese" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,Māori,Niuean" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,New Zealand European / Pakeha" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,New Zealand European / Pakeha,Australian,Polish" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,New Zealand European / Pakeha,Cook Island Maori" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,New Zealand European / Pakeha,Dutch / Netherlands" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,New Zealand European / Pakeha,Irish,Polish,Scottish (Scots)" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,New Zealand European / Pakeha,Niuean" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,New Zealand European / Pakeha,Samoan" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,New Zealand European / Pakeha,Tokelauan" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,New Zealand European / Pakeha,Tongan" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,New Zealand European / Pakeha,Welsh" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,Niuean" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,Niuean,Samoan" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,Pacific Peoples" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,Polish" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,Samoan" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,Samoan,Tokelauan" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,Samoan,Tongan" then "Maori"
		        else if [employee_ethnicity] = "New Zealand Māori,Tongan" then "Maori"
		        
		        // European
		        else if [employee_ethnicity] = "American (US)" then "European"
		        else if [employee_ethnicity] = "American (US),Indian" then "European"
		        else if [employee_ethnicity] = "Australian" then "European"
		        else if [employee_ethnicity] = "Australian,Samoan" then "European"
		        else if [employee_ethnicity] = "British" then "European"
		        else if [employee_ethnicity] = "British,Dutch / Netherlands" then "European"
		        else if [employee_ethnicity] = "Bulgarian" then "European"
		        else if [employee_ethnicity] = "Canadian" then "European"
		        else if [employee_ethnicity] = "Canadian,Samoan" then "European"
		        else if [employee_ethnicity] = "Celtic" then "European"
		        else if [employee_ethnicity] = "Dutch / Netherlands" then "European"
		        else if [employee_ethnicity] = "Dutch / Netherlands,Indonesian" then "European"
