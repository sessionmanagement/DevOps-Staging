		        else if [employee_ethnicity] = "Cook Island Maori,Tongan" then "Pacific Peoples"
		        else if [employee_ethnicity] = "Cook Islander" then "Pacific Peoples"
		        else if [employee_ethnicity] = "Cook Islander,Samoan" then "Pacific Peoples"
		        else if [employee_ethnicity] = "Fijian (except Fiji Indian / Indo-Fijian)" then "Pacific Peoples"
