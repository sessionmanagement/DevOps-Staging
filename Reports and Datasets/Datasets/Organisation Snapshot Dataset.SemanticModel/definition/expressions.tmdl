		        else if [employee_ethnicity] = "Khmer / Kampuchean / Cambodian" then "Asian"
		        else if [employee_ethnicity] = "Korean" then "Asian"
		        else if [employee_ethnicity] = "Malaysian" then "Asian"
		        else if [employee_ethnicity] = "Malaysian Chinese" then "Asian"
		        else if [employee_ethnicity] = "Nepalese" then "Asian"
		        else if [employee_ethnicity] = "Pakistani" then "Asian"
		        else if [employee_ethnicity] = "Punjabi" then "Asian"
		        else if [employee_ethnicity] = "Sikh" then "Asian"
		        else if [employee_ethnicity] = "Singaporean" then "Asian"
