	partition 'Service Groupings' = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="SELECT#(lf)  dim_service.company_name#(lf) ,dim_service.service_id#(lf) ,dim_service.dim_service_key#(lf) ,dim_service.dim_service_unique_key#(lf) ,CASE #(lf)    WHEN LTRIM(RTRIM(ISNULL(dim_kpi_service_type_grouping.service_type_group_name, ''))) = '' #(lf)    THEN 'Ungrouped'#(lf)    ELSE dim_kpi_service_type_grouping.service_type_group_name#(lf)  END AS service_type_group_name#(lf)FROM edw.dim_service#(lf)LEFT JOIN edw.dim_kpi_service_type #(lf)  ON dim_service.service_type_name = dim_kpi_service_type.service_type#(lf)  AND dim_kpi_service_type.dwhiscurrent = 1#(lf)  AND dim_kpi_service_type.dwhdmloperation <> 'D'#(lf)LEFT JOIN edw.bridge_kpi_service_type_to_grouping #(lf)  ON dim_kpi_service_type.dim_kpi_service_type_key = bridge_kpi_service_type_to_grouping.dim_kpi_service_type_key#(lf)LEFT JOIN edw.dim_kpi_service_type_grouping #(lf)  ON bridge_kpi_service_type_to_grouping.dim_kpi_service_type_grouping_key = dim_kpi_service_type_grouping.dim_kpi_service_type_grouping_key#(lf)  AND dim_kpi_service_type_grouping.dwhiscurrent = 1#(lf)WHERE dim_service.dwhiscurrent = 1#(lf)  AND dim_service.dwhdmloperation <> 'D'#(lf)  AND dim_service.dim_service_key > 0"]),
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, each ApplyNamingConventions(_)),
				    #"Filtered Rows" = Table.SelectRows(#"Transformed Column Names", each true)
				in
				    #"Filtered Rows"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

