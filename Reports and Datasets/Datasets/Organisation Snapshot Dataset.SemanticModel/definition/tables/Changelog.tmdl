				                "13189",  /* User Story */
				                "Added YOY Growth measures for % change 'distance to goal' formatting"  /* Description */
				             },
				              {
				                "1.0.4", /* Version */
				                #date(2026, 02, 23),  /* Date */
				                "Greg H",  /* Changed By */
				                "12133",  /* User Story */
				                "Added SPLY for current measures"  /* Description */
				             },
				              {
				                "1.0.3", /* Version */
				                #date(2025, 12, 12),  /* Date */
				                "Greg H",  /* Changed By */
				                "9564",  /* User Story */
				                "Added titles for current measures"  /* Description */
				             },
				              {
				                "1.0.2", /* Version */
				                #date(2025, 12, 12),  /* Date */
				                "Greg H",  /* Changed By */
				                "9564",  /* User Story */
				                "Added ratios for current measures"  /* Description */
				            },
				            {
				                "1.0.1", /* Version */
				                #date(2025, 12, 12),  /* Date */
				                "Greg H",  /* Changed By */
				                "9564",  /* User Story */
				                "Added Length of Service Sort column"  /* Description */
				            },
				            {
				                "1.0.0", /* Version */
				                #date(2025, 12, 12),  /* Date */
				                "Greg H",  /* Changed By */
				                "9564",  /* User Story */
				                "Release: Convert to PBIP format, add Changelog page, cleanup old files"  /* Description */
				            },
				            {
				                "0.9.0", /* Version */
				                #date(2025, 12, 11),  /* Date */
				                "Greg H",  /* Changed By */
				                "9564",  /* User Story */
				                "Add Service Information page, update filtering options, add current impact measures"  /* Description */
				            },
				            {
				                "0.8.0", /* Version */
				                #date(2025, 12, 5),  /* Date */
				                "Greg H",  /* Changed By */
				                "9564",  /* User Story */
				                "Add header/footer to Annual Impact page, fix filter button formatting"  /* Description */
				            },
				            {
				                "0.7.0", /* Version */
				                #date(2025, 11, 21),  /* Date */
				                "Greg H",  /* Changed By */
				                "9564",  /* User Story */
				                "Fix filter menu functionality, add hover area descriptions"  /* Description */
				            },
				            {
				                "0.6.0", /* Version */
				                #date(2025, 11, 19),  /* Date */
				                "Greg H",  /* Changed By */
				                "9564",  /* User Story */
				                "Incorporate Chris review feedback and fixes"  /* Description */
				            },
				            {
				                "0.5.0", /* Version */
				                #date(2025, 11, 18),  /* Date */
				                "Greg H",  /* Changed By */
				                "9564",  /* User Story */
				                "Add YOY growth measures, fix age group filtering, implement info hovers"  /* Description */
				            },
				            {
				                "0.4.0", /* Version */
				                #date(2025, 11, 13),  /* Date */
				                "Greg H",  /* Changed By */
				                "9564",  /* User Story */
				                "Add hover icons and interactive tooltips"  /* Description */
				            },
				            {
				                "0.3.0", /* Version */
				                #date(2025, 11, 5),  /* Date */
				                "Greg H",  /* Changed By */
				                "9564",  /* User Story */
				                "Develop Home page, add Trends and KPIs, start Service info"  /* Description */
				            },
				            {
				                "0.2.0", /* Version */
				                #date(2025, 10, 30),  /* Date */
				                "Greg H",  /* Changed By */
				                "9564",  /* User Story */
				                "Backfill ethnicity data, implement daily average Kaimahi/Referrals measures, add Whanau query"  /* Description */
				            },
				            {
				                "0.1.0", /* Version */
				                #date(2025, 10, 24),  /* Date */
				                "Greg H",  /* Changed By */
				                "9564",  /* User Story */
				                "Initial referral data model with monthly snapshot, add Fact Extras table"  /* Description */
				            },
				            {
