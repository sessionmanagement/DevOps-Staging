				                #date(2024, 11, 12),  /* Date */
				                "Greg H",  /* Changed By */
				                "8906",  /* User Story */
				                "First Publishing"  /* Description */
				            },
				            {
				                "0.0.0", /* Version */
				                #date(2024, 11, 12),  /* Date */
				                "Greg H",  /* Changed By */
				                "8906",  /* User Story */
				                "Dataset Creation"  /* Description */
				            }
				        }
				    ),
				
				    // Reverse the order of the rows so new entries are at the top
				    ReversedTable = Table.ReverseRows(InitialTable),
				
				    // Add an Index column to generate incremental numbers
				    TableWithIndex = Table.AddIndexColumn(ReversedTable, "Change ID", 1, 1, Int64.Type),
				
				    // Add a new column for the parameter "Dataset Name"
				    TableWithParameter = Table.AddColumn(TableWithIndex, "Dataset Name", each #"Dataset Name"),
				
				    // Reorder the columns to place ChangeID first
				    ReorderedColumns = Table.ReorderColumns(TableWithParameter, {"Change ID", "Version", "Change Date", "Changed By", "User Story ID", "Description", "Dataset Name"})
				in
				    ReorderedColumns
				```

