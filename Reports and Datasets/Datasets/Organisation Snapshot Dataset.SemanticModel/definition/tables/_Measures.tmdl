	measure 'Unique Referrals' = ```
			
			VAR TotalTW = 
			    CALCULATE(
			        DISTINCTCOUNT('Fact Referrals'[Unique Referral ID])
			        ,'Fact Referrals'[Was Accepted] = 1
			        , 'Dim Team'[Exclude From Reporting] = "No"
			        
			    )
			RETURN 
			    IF(ISBLANK(TotalTW), 0, TotalTW)
			```
		formatString: #,0
		displayFolder: Referrals
		lineageTag: 2cf8e217-1caa-457d-a428-604b3da015ea

	measure 'Number of Referrals as at June' = ```
			
			VAR CurrentFY = MAX('Dim Date'[Financial Year Num])
			VAR JuneDateInCurrentFY = 
			    CALCULATE(
			        MAX('Dim Date'[Calendar Date]),
			        ALL('Dim Date'),
			        'Dim Date'[Financial Year Num] = CurrentFY,
			        'Dim Date'[Financial Month Num] = 12
			    )
			RETURN
			CALCULATE(
			    [Unique Referrals],
			    ALL('Dim Date'),
			    'Fact Referrals'[Referral Accepted Date] <= JuneDateInCurrentFY,
			    'Fact Referrals'[Referral Ended Date] >= JuneDateInCurrentFY 
			        || ISBLANK('Fact Referrals'[Referral Ended Date])
			)
			```
		formatString: #,0
		displayFolder: Referrals
		lineageTag: 00b1c315-2ae6-49bb-894b-2ca055fda73f

	measure 'Number of Referrals (Average Monthly)' = ```
			
			VAR SelectedFY = SELECTEDVALUE('Dim Date'[Financial Year Desc])
			VAR MonthEndDates = 
			    CALCULATETABLE(
			        VALUES('Dim Date'[Calendar Date]),
			        ALL('Dim Date'),
			        'Dim Date'[Financial Year Desc] = SelectedFY,
			        'Dim Date'[Calendar Date] = EOMONTH('Dim Date'[Calendar Date], 0)  // Only month-ends
			    )
			VAR MonthlyCountsTable = 
			    ADDCOLUMNS(
			        MonthEndDates,
			        "@Count",
			        VAR CurrentDate = 'Dim Date'[Calendar Date]
			        RETURN
			        CALCULATE(
			            [Unique Referrals],
			            'Dim Date'[Calendar Date] = CurrentDate,
			            'Fact Referrals'[Referral Ended Date] >= CurrentDate 
			                || ISBLANK('Fact Referrals'[Referral Ended Date])
			        )
			    )
			VAR MonthlyAverage = AVERAGEX(MonthlyCountsTable, [@Count])
			RETURN 
			    IF(ISBLANK(MonthlyAverage), 0, MonthlyAverage)
			```
		formatString: 0
		displayFolder: Referrals
		lineageTag: bd3f5697-87c7-4ef1-affd-4643d30be5db

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Number of Referrals as at June SPLY' =
			
			CALCULATE(
