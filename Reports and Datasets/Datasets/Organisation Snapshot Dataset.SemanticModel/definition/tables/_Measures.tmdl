	measure 'Referrals as at June SPLY' = ```
			
			VAR SelectedFY = SELECTEDVALUE('Dim Date'[Financial Year Num])
			VAR PriorFY = SelectedFY - 1
			VAR LastDayOfJuneInPriorFY = 
			    CALCULATE(
			        MAX('Dim Date'[Calendar Date]),
			        'Dim Date'[Financial Year Num] = PriorFY,
			        'Dim Date'[Financial Month Num] = 12
			    )
			RETURN
			IF(
			    NOT ISBLANK(LastDayOfJuneInPriorFY),
			    CALCULATE(
			        DISTINCTCOUNT('Fact Referrals'[Unique Referral ID]),
			        ALL('Dim Date'),
			        'Fact Referrals'[Was Accepted] = 1,
			        'Dim Team'[Exclude From Reporting] = "No",
			        'Fact Referrals'[Referral Accepted Date] <= LastDayOfJuneInPriorFY,
			        'Fact Referrals'[Referral Ended Date] > LastDayOfJuneInPriorFY 
			            || ISBLANK('Fact Referrals'[Referral Ended Date])
			    ),
			    0
			)
			```
