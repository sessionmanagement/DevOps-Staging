	measure 'Current Kaimahi YoY %' =
			
			DIVIDE(
			    [Number of Kaimahi (Current)] - [Number of Kaimahi (Current SPLY)],
			    [Number of Kaimahi (Current SPLY)]
			)
		displayFolder: Kaimahi
