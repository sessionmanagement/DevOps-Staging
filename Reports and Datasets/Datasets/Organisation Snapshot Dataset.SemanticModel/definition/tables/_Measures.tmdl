	measure 'Service Description Tooltip' =
			
			VAR ServiceName = SELECTEDVALUE('Dim Service'[Service Name], "No service selected")
			VAR ServiceType = SELECTEDVALUE('Dim Service'[Service Type Name], "")
			VAR ServiceDesc = SELECTEDVALUE('Dim Service'[Description], "")
			VAR HasDescription = ServiceDesc <> ""
			VAR HasServiceType = ServiceType <> ""
			VAR NL = UNICHAR(10)
			VAR KaimahiCount = [Number of Kaimahi (Current)]
			VAR ReferralCount = [Number of Referrals (Current)]
			
			RETURN
			    IF(
			        ServiceName = "No service selected",
			        "No service selected",
			        "📋 " & ServiceName
			            & IF(HasServiceType, NL & NL & "🏷️ " & ServiceType, "")
			            & NL & NL
			            & IF(
			                HasDescription,
			                ServiceDesc,
			                "(No description available)"
			              )
			            & NL & NL
			            & "──────────────────"
			            & NL & NL
			            & "👤 Kaimahi:     " & KaimahiCount
			            & NL & NL
			            & "📥 Referrals:   " & ReferralCount
			    )
		displayFolder: Titles
		lineageTag: 131618e3-cf49-48ee-b951-f5fd41436ade

