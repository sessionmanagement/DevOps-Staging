	measure 'Number of Social Housing Offerings' = ```
			
			VAR CurrentFY = MAX('Dim Date'[Financial Year Num])
			VAR CurrentFYEndDate = 
			    CALCULATE(
			        MAX('Dim Date'[Calendar Date]),
			        ALL('Dim Date'),
			        'Dim Date'[Financial Year Num] = CurrentFY,
			        'Dim Date'[Financial Month Num] = 12
			    )
			VAR CurrentFYStartDate = 
			    CALCULATE(
			        MIN('Dim Date'[Calendar Date]),
			        ALL('Dim Date'),
			        'Dim Date'[Financial Year Num] = CurrentFY,
			        'Dim Date'[Financial Month Num] = 1
			    )
			VAR PropertyCount = 
			    CALCULATE(
			        DISTINCTCOUNT('Dim Property'[Property ID]),
			        FILTER(
			            'Dim Property',
			            AND(
			                'Dim Property'[Property Acquired Date] <= CurrentFYEndDate,
			                AND(
			                    'Dim Property'[Property Confirmed Disposal Date] <> 'Dim Property'[Property Acquired Date],
			                    OR(
			                        ISBLANK('Dim Property'[Property Confirmed Disposal Date]),
			                        'Dim Property'[Property Confirmed Disposal Date] > CurrentFYEndDate
			                    )
			                )
			            )
			        )
			    )
			RETURN 
			    IF([Is Filtered], BLANK(), PropertyCount)
			```
		formatString: 0
		displayFolder: Social Homes
		lineageTag: f285e076-4ac2-4bec-b98a-8dd446aafd98

