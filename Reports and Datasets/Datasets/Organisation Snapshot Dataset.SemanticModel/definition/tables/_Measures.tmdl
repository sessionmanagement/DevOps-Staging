	measure '1737 (Unique Callers - for Peers)' = ```
			
			VAR TotalUniqueCalls = CALCULATE(
			    SUM('Fact Extras'[Value]),
			    'Fact Extras'[Measure] = "Unique Calls",
			    'Fact Extras'[Source] = "1737"
			)
			VAR IsServiceFiltered = 
			    ISCROSSFILTERED('Dim Service') ||
			    ISFILTERED('Dim Ethnicity'[Ethnicity Group]) ||
			    ISFILTERED('Dim Age'[Age Group Impact]) ||
			    ISFILTERED('Dim Gender'[Gender Name])
			RETURN 
			    IF(IsServiceFiltered, "", TotalUniqueCalls)
			```
