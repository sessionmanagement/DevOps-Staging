	measure 'Filters Applied' = ```
			
			//----------------------------------------------
			// Financial Year
			//----------------------------------------------
			VAR __FYLabels =
			    ADDCOLUMNS (
			        TOPN (
			            5,
			            FILTER (
			                VALUES ( 'Dim Date'[Financial Year Desc] ),
			                NOT ( ISBLANK ( 'Dim Date'[Financial Year Desc] ) )
			            ),
			            'Dim Date'[Financial Year Desc], ASC
			        ),
			        "FYDesc_display", 'Dim Date'[Financial Year Desc]
			    )
			VAR __FYLabelsCount =
			    IF (
			        ISFILTERED ( 'Dim Date'[FY Label] ),
			        COUNTROWS ( VALUES ( 'Dim Date'[FY Label] ) ),
			        0
			    )
			VAR __MoreFYLabels =
			    IF ( __FYLabelsCount > 5, " and " & ( __FYLabelsCount - 5 ) & " more ", "" )
			VAR _FC_FYLabels =
			    IF (
			        __FYLabelsCount > 0,
			        "| Financial Year: " & CONCATENATEX ( __FYLabels, [FYDesc_display], ", " ) & __MoreFYLabels,
			        BLANK ()
			    )
			//----------------------------------------------
			// Service Region
			//----------------------------------------------
			VAR __Regions =
			    ADDCOLUMNS (
			        TOPN (
			            5,
			            FILTER (
			                VALUES ( 'Dim Service'[Region Name] ),
			                NOT ( ISBLANK ( 'Dim Service'[Region Name] ) )
			            ),
			            'Dim Service'[Region Name], ASC
			        ),
			        "Region_display", 'Dim Service'[Region Name]
			    )
			VAR __RegionsCount =
			    IF (
			        ISFILTERED ( 'Dim Service'[Region Name] ),
			        COUNTROWS ( VALUES ( 'Dim Service'[Region Name] ) ),
			        0
			    )
			VAR __MoreRegions =
			    IF ( __RegionsCount > 5, " and " & ( __RegionsCount - 5 ) & " more ", "" )
			VAR _FC_Regions =
			    IF (
			        __RegionsCount > 0,
			        "| Region: " & CONCATENATEX ( __Regions, [Region_display], ", " ) & __MoreRegions,
			        BLANK ()
			    ) 
			
			//----------------------------------------------
			// Service District
			//----------------------------------------------
			VAR __Districts =
			    ADDCOLUMNS (
			        TOPN (
			            5,
			            FILTER (
			                VALUES ( 'Dim Service'[District Name] ),
			                NOT ( ISBLANK ( 'Dim Service'[District Name] ) )
			            ),
			            'Dim Service'[District Name], ASC
			        ),
			        "District_display", 'Dim Service'[District Name]
			    )
			VAR __DistrictCount =
			    IF (
			        ISFILTERED ( 'Dim Service'[District Name] ),
			        COUNTROWS ( VALUES ( 'Dim Service'[District Name] ) ),
			        0
			    )
			VAR __MoreDistricts =
			    IF ( __DistrictCount > 5, " and " & ( __DistrictCount - 5 ) & " more ", "" )
			VAR _FC_Districts =
			    IF (
			        __DistrictCount > 0,
			        "| District: " & CONCATENATEX ( __Districts, [District_display], ", " ) & __MoreDistricts,
			        BLANK ()
			    )
			
			//----------------------------------------------
			// Service Name
			//----------------------------------------------
			VAR __Services =
			    ADDCOLUMNS (
			        TOPN (
			            5,
			            FILTER (
			                VALUES ( 'Dim Service'[Service Name] ),
			                NOT ( ISBLANK ( 'Dim Service'[Service Name] ) )
			            ),
			            'Dim Service'[Service Name], ASC
			        ),
			        "ServiceName_display", 'Dim Service'[Service Name]
			    )
			VAR __ServicesCount =
			    IF (
			        ISFILTERED ( 'Dim Service'[Service Name] ),
			        COUNTROWS ( VALUES ( 'Dim Service'[Service Name] ) ),
			        0
			    )
			VAR __MoreServices =
			    IF ( __ServicesCount > 5, " and " & ( __ServicesCount - 5 ) & " more ", "" )
			VAR _FC_Services =
			    IF (
			        __ServicesCount > 0,
			        "| Service: " & CONCATENATEX ( __Services, [ServiceName_display], ", " ) & __MoreServices,
			        BLANK ()
			    )
			
			//----------------------------------------------
			// Service Type
			//----------------------------------------------
			VAR __ServiceType =
			    ADDCOLUMNS (
			        TOPN (
			            5,
			            FILTER (
			                VALUES ( 'Dim Service'[Service Type Name]),
			                NOT ( ISBLANK ( 'Dim Service'[Service Type Name]) )
			            ),
			            'Dim Service'[Service Type Name], ASC
			        ),
			        "ServiceType_display", 'Dim Service'[Service Type Name]
			    )
			VAR __ServiceTypeCount =
			    IF (
			        ISFILTERED ( 'Dim Service'[Service Type Name] ),
			        COUNTROWS ( VALUES ('Dim Service'[Service Type Name] ) ),
			        0
			    )
			VAR __MoreServiceTypes =
			    IF (
			        __ServiceTypeCount > 5,
			        " and " & ( __ServiceTypeCount - 5 ) & " more ",
			        ""
			    )
			VAR _FC_ServiceTypes =
			    IF (
			        __ServiceTypeCount > 0,
			        "| Service Type(s): "
			            & CONCATENATEX ( __ServiceType, [ServiceType_display], ", " ) & __MoreServiceTypes,
			        BLANK ()
			    )
			
			//----------------------------------------------
			// Service Type Group
			//----------------------------------------------
			VAR __ServiceTypeGroup =
			    ADDCOLUMNS (
			        TOPN (
			            5,
			            FILTER (
			                VALUES ( 'Dim Service'[Service Type Group Name]),
			                NOT ( ISBLANK ( 'Dim Service'[Service Type Group Name]) )
			            ),
			            'Dim Service'[Service Type Group Name], ASC
			        ),
			        "ServiceTypeGroupName_display", 'Dim Service'[Service Type Group Name]
			    )
			VAR __ServiceTypeGroupCount =
			    IF (
			        ISFILTERED ( 'Dim Service'[Service Type Group Name] ),
			        COUNTROWS ( VALUES ('Dim Service'[Service Type Group Name] ) ),
			        0
			    )
			VAR __MoreServiceTypeGroups =
			    IF (
			        __ServiceTypeGroupCount > 5,
			        " and " & ( __ServiceTypeGroupCount - 5 ) & " more ",
			        ""
			    )
			VAR _FC_ServiceTypeGroups =
			    IF (
			        __ServiceTypeGroupCount > 0,
			        "| Service Type(s): "
			            & CONCATENATEX ( __ServiceTypeGroup, [ServiceTypeGroupName_display], ", " ) & __MoreServiceTypeGroups,
			        BLANK ()
			    )
			
			//----------------------------------------------
			// Ethnicity Group
			//----------------------------------------------
			VAR __EthnicityGroup =
			    ADDCOLUMNS (
			        TOPN (
			            5,
			            FILTER (
			                VALUES ( 'Dim Ethnicity'[Ethnicity Group]),
			                NOT ( ISBLANK ( 'Dim Ethnicity'[Ethnicity Group]) )
			            ),
			            'Dim Ethnicity'[Ethnicity Group], ASC
			        ),
			        "EthnicityGroup_display", 'Dim Ethnicity'[Ethnicity Group]
			    )
			VAR __EthnicityGroupCount =
			    IF (
			        ISFILTERED ( 'Dim Ethnicity'[Ethnicity Group]),
			        COUNTROWS ( VALUES ( 'Dim Ethnicity'[Ethnicity Group] ) ),
			        0
			    )
			VAR __MoreEthnicityGroups =
			    IF (
			        __EthnicityGroupCount > 5,
			        " and " & ( __EthnicityGroupCount - 5 ) & " more ",
			        ""
			    )
			VAR _FC_EthnicityGroups =
			    IF (
			        __EthnicityGroupCount > 0,
			        " | Ethnicity Group(s): "
			            & CONCATENATEX ( __EthnicityGroup, [EthnicityGroup_display], ", " ) & __MoreEthnicityGroups,
			        BLANK ()
			    )
			
			//----------------------------------------------
			// Gender
			//----------------------------------------------
			VAR __Gender =
			    ADDCOLUMNS (
			        TOPN (
			            5,
			            FILTER (
			                VALUES ( 'Dim Gender'[Gender Name]),
			                NOT ( ISBLANK ( 'Dim Gender'[Gender Name]) )
			            ),
			            'Dim Gender'[Gender Name], ASC
			        ),
			        "Gender_display", 'Dim Gender'[Gender Name]
			    )
			VAR __GenderCount =
			    IF (
			        ISFILTERED ('Dim Gender'[Gender Name]),
			        COUNTROWS ( VALUES ( 'Dim Gender'[Gender Name]) ),
			        0
			    )
			VAR __MoreGenders =
			    IF (
			        __GenderCount > 5,
			        " and " & ( __GenderCount - 5 ) & " more ",
			        ""
			    )
			VAR _FC_Genders =
			    IF (
			        __GenderCount > 0,
			        " | Gender(s): "
			            & CONCATENATEX ( __Gender, [Gender_display], ", " ) & __MoreGenders,
			        BLANK ()
			    )
			
			//----------------------------------------------
			// Age Groups
			//----------------------------------------------
			VAR __AgeGroups =
			    ADDCOLUMNS (
			        TOPN (
			            5,
			            FILTER (
			                VALUES ( 'Dim Age'[Age Group Impact]),
			                NOT ( ISBLANK ( 'Dim Age'[Age Group Impact]) )
			            ),
			            'Dim Age'[Age Group Impact], ASC
			        ),
			        "AgeGroup_display", 'Dim Age'[Age Group Impact]
			    )
			VAR __AgeGroupCount =
			    IF (
			        ISFILTERED ('Dim Age'[Age Group Impact]),
			        COUNTROWS ( VALUES ('Dim Age'[Age Group Impact]) ),
			        0
			    )
			VAR __MoreAgeGroups =
			    IF (
			        __AgeGroupCount > 5,
			        " and " & ( __AgeGroupCount - 5 ) & " more ",
			        ""
			    )
			VAR _FC_AgeGroups =
			    IF (
			        __AgeGroupCount > 0,
			        " | Age Group(s): "
			            & CONCATENATEX ( __AgeGroups, [AgeGroup_display], ", " ) & __MoreAgeGroups,
			        BLANK ()
			    )
			
			
			//----------------------------------------------
			// Combine All Filters
			//----------------------------------------------
			VAR __AllFilters =
			          _FC_FYLabels
			        & _FC_Regions
			        & _FC_Districts
			        & _FC_Services
			        & _FC_ServiceTypes
			        & _FC_ServiceTypeGroups
			        & _FC_EthnicityGroups
			        & _FC_Genders
			        & _FC_AgeGroups
			
			VAR __HasFilters =
			    NOT ( ISBLANK ( __AllFilters ) )
			VAR __CleanedFilters =
			    IF (
			        __HasFilters,
			        IF (
			            LEFT ( __AllFilters, 3 ) = " | ",
			            MID ( __AllFilters, 4, LEN ( __AllFilters ) - 3 ),
			            __AllFilters
			        ),
			        BLANK ()
			    )
			RETURN
			    IF (
			        __HasFilters,
			        "Filters Applied: " & __CleanedFilters,
			        "No filters applied"
			    )
			```
		displayFolder: Titles
		lineageTag: 57c6bb72-2fc0-4de8-adc9-73b483eba54b

