		lineageTag: 4049ef1f-7858-4d69-9426-ba8bab7d4486

	measure 'Footer disclaimer' = ```
			
			VAR KaimahiCount = FORMAT(ROUND([Number of Kaimahi (Average Daily)], 0), "#,##0")
			VAR ReferralCount = FORMAT(ROUND([Number of Referrals (Average Daily)], 0), "#,##0")
			VAR Disclaimer = 
			    "Asterisked* figures represent average daily counts (" & 
			    KaimahiCount & " kaimahi and " & 
			    ReferralCount & " referrals) adjusted for the actual duration that staff were employed or referrals were active during the financial year."
			RETURN 
			    Disclaimer
