	measure 'Pasifika Sentence' = ```
			
			-- Calculate org-wide Pasifika percentage, ignoring current filters
			VAR PasifikaCount = 
			    CALCULATE(
			        [Number of Kaimahi (Average Daily)],
			        ALL('Fact Kaimahi'),  -- Clear all fact table filters
			        'Fact Kaimahi'[Original Ethnicity] = "Pacific Peoples",
			        VALUES('Dim Date'[Financial Year Desc])  -- Keep FY filter
			    )
			
			VAR TotalCount = 
			    CALCULATE(
			        [Number of Kaimahi (Average Daily)], 
			        ALL('Fact Kaimahi'),  -- Clear all fact table filters
			        VALUES('Dim Date'[Financial Year Desc])  -- Keep FY filter
			    )
			
			VAR Percentage = DIVIDE(PasifikaCount, TotalCount)
			
			RETURN
			IF(
			    ISBLANK(PasifikaCount) || PasifikaCount = 0,
			    "There are no Pasifika Kaimahi in this selection",
			    "Of the " & 
			        FORMAT(Percentage, "0.0%") & " (" & FORMAT(PasifikaCount, "0") & ") " &
			        " Pasifika Kaimahi we employ: *"
			)
			```
		displayFolder: Titles
		lineageTag: e4841bf3-ec8c-4209-b792-ee03a7ca3a5a

	measure 'Maori Sentence' = ```
			
			-- Calculate org-wide Maori percentage, ignoring current filters
			VAR MaoriCount = 
			    CALCULATE(
			        [Number of Kaimahi (Average Daily)],
			        ALL('Fact Kaimahi'),
			        'Fact Kaimahi'[Original Ethnicity] = "Maori",
			        VALUES('Dim Date'[Financial Year Desc])
			    )
			VAR TotalCount = 
			    CALCULATE(
			        [Number of Kaimahi (Average Daily)], 
			        ALL('Fact Kaimahi'),  -- Clear all fact table filters
			        VALUES('Dim Date'[Financial Year Desc])  -- Keep FY filter
			    )
			
			VAR Percentage = DIVIDE(MaoriCount, TotalCount)
			
			RETURN
			IF(
			    ISBLANK(MaoriCount) || MaoriCount = 0,
			    "There are no Māori Kaimahi in this selection",
			    "Of the " & 
			        FORMAT(Percentage, "0.0%") & " (" & FORMAT(MaoriCount, "0") & ") " &
			        " Māori Kaimahi we employ: (Top 5 Iwi) *"
			)
			```
		displayFolder: Titles
		lineageTag: 316973f6-80bc-4e5c-ac53-a07e149a15be

	measure 'Average Daily Kaimahi to Referrals Ratio' =
			
			VAR KaimahiCount = [Number of Kaimahi (Average Daily)]
			VAR ReferralCount = [Number of Referrals (Average Daily)]
			VAR Ratio = DIVIDE(ReferralCount, KaimahiCount, BLANK())  -- Returns BLANK if division by zero
			RETURN
			    IF(
			        NOT ISBLANK(Ratio),
			        ROUND(Ratio, 1),
			        BLANK()
			    )
		formatString: 0.0
		displayFolder: Ratios
		lineageTag: fb8efc3e-33e0-4a26-a13d-716b429bd5ed

	measure 'Average Daily Kaimahi to Referrals Ratio Tooltip' =
			
			VAR RoundedRatio = [Average Daily Kaimahi to Referrals Ratio]
			RETURN
			IF(
			   NOT ISBLANK(RoundedRatio),
			   "There are " & RoundedRatio & " Tāngata Whaiora for every 1 Kaimahi in this group.",
			    BLANK()
			)
		displayFolder: Ratios
		lineageTag: ff725391-c77a-49c4-8bf7-cb42153dbf05

	measure 'Number of Referrals (Average Daily)' = ```
			
			VAR SelectedFY = SELECTEDVALUE('Dim Date'[Financial Year Desc])
			VAR TotalReferralDays = 
			    CALCULATE(
			        SUM('Fact Referrals'[Days Active In Month]),
			        REMOVEFILTERS('Dim Date'),
			        'Fact Referrals'[Financial Year Desc] = SelectedFY,
			        'Fact Referrals'[Was Accepted] = 1,
			        'Dim Team'[Exclude From Reporting] = "No"
			    )
			VAR TotalDaysInFY = 
			    CALCULATE(
			        COUNTROWS(VALUES('Dim Date'[Calendar Date])),
			        REMOVEFILTERS('Dim Date'),
			        'Dim Date'[Financial Year Desc] = SelectedFY
			    )
			VAR AverageReferrals = DIVIDE(TotalReferralDays, TotalDaysInFY, 0)
			RETURN IF(ISBLANK(AverageReferrals),0,AverageReferrals)
			```
		formatString: #,0
		displayFolder: Referrals
		lineageTag: 7bb12f68-e862-49d3-a634-17b4e6afa702

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Number of Kaimahi (Average Daily)' = ```
			
			VAR SelectedFY = SELECTEDVALUE('Dim Date'[Financial Year Desc])
			VAR TotalKaimahiDays = 
			    CALCULATE(
			        SUM('Fact Kaimahi'[Days Active In Month]),
			        REMOVEFILTERS('Dim Date'),
			        'Fact Kaimahi'[Financial Year Desc] = SelectedFY,
			        'Fact Kaimahi'[DWHiscurrent] = 1,
			        'Fact Kaimahi'[Employee Name] <> "Test Employee",
			        'Fact Kaimahi'[Fact Employee Remuneration Work Type] <> "Unpaid"
			    )
			VAR TotalDaysInFY = 
			    CALCULATE(
			        COUNTROWS('Dim Date'),
			        REMOVEFILTERS('Dim Date'),
			        'Dim Date'[Financial Year Desc] = SelectedFY,
			        'Dim Date'[Calendar Date] <= TODAY()  -- Only count days up to today for current FY
			    )
			VAR AvgDailyKaimahi = DIVIDE(TotalKaimahiDays, TotalDaysInFY, 0)
			RETURN IF(ISBLANK(AvgDailyKaimahi),0,AvgDailyKaimahi)
			```
		formatString: #,0
		displayFolder: Kaimahi
		lineageTag: a68bfa32-f136-496b-a97f-f45d1891935c

		annotation PBI_FormatHint = {"isDecimal":true}

