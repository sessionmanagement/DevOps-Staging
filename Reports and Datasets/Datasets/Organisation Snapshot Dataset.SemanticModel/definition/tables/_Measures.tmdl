	measure 'Current Kaimahi to Referrals Ratio' =
			
			VAR KaimahiCount = [Number of Kaimahi (Current)]
			VAR ReferralCount = [Number of Referrals (Current)]
			VAR Ratio = DIVIDE(ReferralCount, KaimahiCount, BLANK())  -- Returns BLANK if division by zero
			RETURN
