	measure 'Current Maori Sentence' = ```
			
			-- Calculate org-wide Maori percentage, ignoring current filters
			VAR MaoriCount = 
			    CALCULATE(
			        [Number of Kaimahi (Current)],
			        ALL('Fact Kaimahi'),  -- Clear all fact table filters
			        'Fact Kaimahi'[Original Ethnicity] = "Maori",
			        VALUES('Dim Date'[Financial Year Desc])  -- Keep FY filter
			    )
			
			VAR TotalCount = 
			    CALCULATE(
			        [Number of Kaimahi (Current)], 
			        ALL('Fact Kaimahi'),  -- Clear all fact table filters
			        VALUES('Dim Date'[Financial Year Desc])  -- Keep FY filter
			    )
			
			VAR Percentage = DIVIDE(MaoriCount, TotalCount)
			
			RETURN
			IF(
			    ISBLANK(MaoriCount) || MaoriCount = 0,
			    "There are no Māori Kaimahi in this selection",
			    "Of the " &
			        FORMAT(Percentage, "0.0%") & " (" & MaoriCount & ") " &
			        " Māori Kaimahi we employ: (Top 5 Iwi)"
			)
			```
		displayFolder: Titles
		lineageTag: ffd94bff-8b53-44bb-9320-007495ae4be1

