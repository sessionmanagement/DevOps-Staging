	measure 'Exclusions Summary' = ```
			
			VAR ExcludedFunctions = 
			    CALCULATETABLE(
			        VALUES('Dim Team'[Tangata Whaiora Team Function]),
			        'Dim Team'[Exclude From Reporting] = "Yes",
			        ALLSELECTED('Dim Team')
			    )
			VAR FunctionList = 
			    CONCATENATEX(
			        ExcludedFunctions,
			        'Dim Team'[Tangata Whaiora Team Function],
			        ", ",
			        'Dim Team'[Tangata Whaiora Team Function], ASC
			    )
			VAR ExcludedTeams = 
			    CALCULATETABLE(
			        VALUES('Dim Team'[Tangata Whaiora Team Name]),
			        'Dim Team'[Exclude From Reporting] = "Yes",
			        ALLSELECTED('Dim Team')
			    )
			VAR TeamList = 
			    CONCATENATEX(
			        ExcludedTeams,
			        'Dim Team'[Tangata Whaiora Team Name],
			        ", ",
			        'Dim Team'[Tangata Whaiora Team Name], ASC
			    )
			VAR TeamCount = COUNTROWS(ExcludedTeams)
			VAR FunctionCount = COUNTROWS(ExcludedFunctions)
			RETURN
			"EXCLUDED TEAM FUNCTIONS (" & FunctionCount & "):" & 
			UNICHAR(10) & FunctionList & 
			UNICHAR(10) & "─────────────────────────" & UNICHAR(10) &
			"EXCLUDED TEAMS (" & TeamCount & "):" & 
			UNICHAR(10) & TeamList
			```
		displayFolder: Titles
		lineageTag: ef2b9044-fbce-4fc2-8248-02166eacad9e

	measure 'Kaimahi YOY Change %' = ```
			
			VAR CurrentValue = [Number of Kaimahi (Average Daily)]
			
			-- Use whatever column you have in your table (replace if needed)
			VAR CurrentFY = SELECTEDVALUE('Dim Date'[FY Label])
			
			VAR PriorFY = "FY" & FORMAT(VALUE(RIGHT(CurrentFY, 2)) - 1, "00")
			
			VAR PriorYearValue = 
			    CALCULATE(
			        [Number of Kaimahi (Average Daily)],
			        ALL('Dim Date'[FY Label]),
			        'Dim Date'[FY Label] = PriorFY
			    )
			
			RETURN DIVIDE(CurrentValue - PriorYearValue, PriorYearValue, BLANK())
