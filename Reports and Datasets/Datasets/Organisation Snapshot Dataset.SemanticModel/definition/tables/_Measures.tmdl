		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Number of Kaimahi (Current SPLY)' = ```
			
			VAR OneYearAgo = EDATE(TODAY(), -12)
			VAR SPLYKaimahi = CALCULATE(
			    [Unique Kaimahi],
			    ALL('Dim Date'),
			    'Fact Kaimahi'[Company Start Date] <= OneYearAgo,
			    'Fact Kaimahi'[Company End Date] >= OneYearAgo 
			        || ISBLANK('Fact Kaimahi'[Company End Date])
			)
			RETURN IF(ISBLANK(SPLYKaimahi), 0, SPLYKaimahi)
			```
		formatString: 0
		displayFolder: Kaimahi
		lineageTag: 9ec6df3c-2f7c-4c4b-b8b3-ac4e7d9846d8

	measure 'Number of Referrals (Current SPLY)' =
			
			VAR OneYearAgo = EDATE(TODAY(), -12)
			VAR SPLYReferrals =
			    CALCULATE(
			        [Unique Referrals],
			        ALL('Dim Date'),
			        'Fact Referrals'[Referral Accepted Date] <= OneYearAgo,
			        'Fact Referrals'[Referral Ended Date] >= OneYearAgo
			            || ISBLANK('Fact Referrals'[Referral Ended Date])
			    )
			RETURN IF(ISBLANK(SPLYReferrals), 0, SPLYReferrals)
		formatString: #,0
		displayFolder: Referrals
		lineageTag: 3f8ce57f-9344-4f10-8fb3-2d0f2c2814aa

	measure 'Current Referrals YOY %' =
			
			DIVIDE(
			    [Number of Referrals (Current)] - [Number of Referrals (Current SPLY)],
			    [Number of Referrals (Current SPLY)]
			)
		displayFolder: Referrals
		lineageTag: f91f383a-97dd-4b0f-8ef7-ef29c5dffbd2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Active Business Units YOY %' =
			
