	partition 'Dim Date' = m
		mode: import
		queryGroup: Dims
		source = ```
				let
				    Source = Sql.Database(Server, Database, [Query="SELECT #(lf)    dim_date_key,#(lf)    calendar_date,#(lf)    calendar_year,#(lf)    calendar_month_num,#(lf)    calendar_month_name_long,#(lf)    financial_year_num,#(lf)    financial_year_month,#(lf)    financial_year_desc,#(lf)    financial_quarter_num,#(lf)    financial_month_num,#(lf)    current_financial_year_flag,#(lf)    previous_financial_year_flag,#(lf)    current_date_rolling_financial_year_offset,#(lf)    financial_last_day_of_year_date#(lf)FROM [edw].[vw_dim_date]#(lf)WHERE financial_year_num >= YEAR(DATEADD(YEAR, -2, GETDATE())) - 1#(lf)  AND current_date_rolling_financial_year_offset <= 0"]),
				    
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, each ApplyNamingConventions(_)),
				    
				    #"Changed Type" = Table.TransformColumnTypes(#"Transformed Column Names", {
				        {"Dim Date KEY", Int64.Type},
				        {"Calendar Date", type date},
				        {"Calendar Year", Int64.Type},
				        {"Calendar Month Num", Int64.Type},
				        {"Calendar Month Name Long", type text},
				        {"Financial Year Num", Int64.Type},
				        {"Financial Year Desc", type text},
				        {"Financial Quarter Num", Int64.Type},
				        {"Financial Month Num", Int64.Type},
				        {"Current Financial Year Flag", Int64.Type},
				        {"Previous Financial Year Flag", Int64.Type},
				        {"Current Date Rolling Financial Year Offset", Int64.Type},
				        {"Financial Last Day Of Year Date", type date}
				    }),
				    #"Added Custom" = Table.AddColumn(#"Changed Type", "FY Label", each "FY" & Text.End([Financial Year Desc], 2))
				in
				    #"Added Custom"
				```

	annotation PBI_NavigationStepName = Navigation

