	column 'Is Latest Snapshot' = ```
			
			VAR CurrentEmployeeNum = 'Fact Kaimahi'[Fact Employee Remuneration Employee Number]
			VAR CurrentSnapshot = 'Fact Kaimahi'[Snapshot Date]
			VAR MaxSnapshot = 
			    CALCULATE(
			        MAX('Fact Kaimahi'[Snapshot Date]),
			        FILTER(
			            ALL('Fact Kaimahi'),
			            'Fact Kaimahi'[Fact Employee Remuneration Employee Number] = CurrentEmployeeNum
			        )
			    )
			RETURN
			IF(CurrentSnapshot = MaxSnapshot, 1, 0)
			```
		formatString: 0
		lineageTag: 71923784-b3d3-42b2-b56a-c6cf6d136468
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

