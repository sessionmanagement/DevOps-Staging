	partition 'Fact Kaimahi' = m
		mode: import
		queryGroup: Facts
		source = ```
				let
				    Source = Sql.Database(Server, Database, [Query="WITH EmployeeData AS (#(lf)    SELECT #(lf)        [fact_employee_remuneration_key],#(lf)        [dim_company_key],#(lf)        [dim_employee_key],#(lf)        [dim_location_key],#(lf)        [dim_service_key],#(lf)        [dim_ethnicity_key],#(lf)        [dim_job_start_date_key],#(lf)        [dim_job_end_date_key],#(lf)        [dim_position_start_date_key],#(lf)        [dim_position_end_date_key],#(lf)        [fact_employee_remuneration_employee_number],#(lf)        [fact_employee_remuneration_fte],#(lf)        [fact_employee_remuneration_businessunit_id],#(lf)        [fact_employee_remuneration_work_type],#(lf)        [fact_employee_remuneration_work_class],#(lf)        [fact_employee_remuneration_primary_job_indicator],#(lf)        [fact_employee_remuneration_company_startdate],#(lf)        [fact_employee_remuneration_company_enddate],#(lf)        [fact_employee_remuneration_position_startdate],#(lf)        [fact_employee_remuneration_maori_indicator],#(lf)        [fact_employee_remuneration_pasifika_indicator],#(lf)        [fact_employee_remuneration_job_status],#(lf)        [dwhiscurrent],#(lf)        #(lf)        CAST([fact_employee_remuneration_employee_number] AS VARCHAR(50)) + '-' + #(lf)            CAST([dim_company_key] AS VARCHAR(50)) AS unique_employee_id,#(lf)        CAST([fact_employee_remuneration_job_key] AS VARCHAR(50)) + '-' + #(lf)            CAST([dim_company_key] AS VARCHAR(50)) AS unique_job_id,#(lf)        #(lf)        TRY_CONVERT(DATE, CAST([dim_job_start_date_key] AS CHAR(8))) AS job_start_date,#(lf)        TRY_CONVERT(DATE, CAST([dim_job_end_date_key] AS CHAR(8))) AS job_end_date,#(lf)        TRY_CONVERT(DATE, CAST([dim_position_start_date_key] AS CHAR(8))) AS position_start_date,#(lf)        TRY_CONVERT(DATE, CAST([dim_position_end_date_key] AS CHAR(8))) AS position_end_date,#(lf)        #(lf)        CASE WHEN [fact_employee_remuneration_company_enddate] IS NULL THEN 1 ELSE 0 END AS is_currently_employed,#(lf)        CASE WHEN [fact_employee_remuneration_primary_job_indicator] = 1 THEN 1 ELSE 0 END AS is_primary_job#(lf)        #(lf)    FROM [edw].[fact_employee_remuneration]#(lf)    WHERE [dwhdmloperation] <> 'D'#(lf)        AND [dwhiscurrent] = 1#(lf)),#(lf)#(lf)month_ends AS (#(lf)    SELECT DISTINCT #(lf)        EOMONTH(calendar_date) AS snapshot_date,#(lf)        financial_year_num,#(lf)        financial_year_desc,#(lf)        financial_month_num#(lf)    FROM edw.vw_dim_date#(lf)    WHERE financial_year_num >= YEAR(DATEADD(YEAR, -3, GETDATE())) - 1#(lf))#(lf)#(lf)SELECT#(lf)    ed.fact_employee_remuneration_key,#(lf)    ed.dim_company_key,#(lf)    ed.dim_employee_key,#(lf)    ed.dim_service_key,#(lf)    ed.dim_location_key,#(lf)    ed.dim_ethnicity_key,#(lf)    ed.fact_employee_remuneration_employee_number,#(lf)    ed.unique_employee_id,#(lf)    ed.unique_job_id,#(lf)    ed.[fact_employee_remuneration_businessunit_id],#(lf)#(lf)    ed.fact_employee_remuneration_fte,#(lf)    ed.fact_employee_remuneration_work_type,#(lf)    ed.fact_employee_remuneration_work_class,#(lf)    ed.fact_employee_remuneration_job_status,#(lf)    ed.is_primary_job,#(lf)    #(lf)    ed.fact_employee_remuneration_company_startdate AS company_start_date,#(lf)    ed.fact_employee_remuneration_company_enddate AS company_end_date,#(lf)    ed.job_start_date,#(lf)    ed.job_end_date,#(lf)    ed.position_start_date,#(lf)    ed.position_end_date,#(lf)    #(lf)    me.snapshot_date,#(lf)    me.financial_year_num,#(lf)    me.financial_year_desc,#(lf)    me.financial_month_num,#(lf)    #(lf)    -- Demographics from vw_dim_employee#(lf)    de.employee_name,#(lf)    de.employee_first_name,#(lf)    de.employee_last_name,#(lf)    de.employee_gender,#(lf)    de.employee_date_of_birth,#(lf)    de.employee_ethnicity,#(lf)    de.primary_ethnicity,#(lf)    de.secondary_ethnicity,#(lf)    de.primary_ethnicity_group,#(lf)    de.primary_ethnicity_section,#(lf)    de.primary_iwi, -- Point-in-time iwi (will be null for pre-FY25)#(lf)    de.is_maori_flag,#(lf)    de.is_pasifika_flag,#(lf)    de.employee_people_manager_name,#(lf)    de.employee_people_manager_id,#(lf)    de.employee_job_name,#(lf)    #(lf)#(lf)    -- NEW: Current iwi data (for all snapshots)#(lf)    COALESCE(NULLIF(de_current.primary_iwi, ''), 'Not Specified') AS current_primary_iwi,#(lf)    de_current.primary_waka AS current_primary_waka,#(lf)    #(lf)    -- Gender dimension#(lf)    dg.dim_gender_key,#(lf)    dg.intellihr_gender_key,#(lf)    dg.gender_name AS gender_display_name,#(lf)    #(lf)    -- Age at snapshot#(lf)    CASE #(lf)        WHEN de.employee_date_of_birth IS NULL THEN -99999#(lf)        ELSE DATEDIFF(YEAR, de.employee_date_of_birth, me.snapshot_date) -#(lf)            CASE#(lf)                WHEN MONTH(de.employee_date_of_birth) > MONTH(me.snapshot_date)#(lf)                    OR (MONTH(de.employee_date_of_birth) = MONTH(me.snapshot_date)#(lf)                        AND DAY(de.employee_date_of_birth) > DAY(me.snapshot_date))#(lf)                THEN 1#(lf)                ELSE 0#(lf)            END#(lf)    END AS age_at_snapshot,#(lf)    #(lf)    -- Age at hire#(lf)    CASE #(lf)        WHEN de.employee_date_of_birth IS NULL THEN -99999#(lf)        ELSE DATEDIFF(YEAR, de.employee_date_of_birth, ed.fact_employee_remuneration_company_startdate) -#(lf)            CASE#(lf)                WHEN MONTH(de.employee_date_of_birth) > MONTH(ed.fact_employee_remuneration_company_startdate)#(lf)                    OR (MONTH(de.employee_date_of_birth) = MONTH(ed.fact_employee_remuneration_company_startdate)#(lf)                        AND DAY(de.employee_date_of_birth) > DAY(ed.fact_employee_remuneration_company_startdate))#(lf)                THEN 1#(lf)                ELSE 0#(lf)            END#(lf)    END AS age_at_hire,#(lf)    #(lf)    -- Tenure at snapshot#(lf)    DATEDIFF(MONTH, ed.fact_employee_remuneration_company_startdate, me.snapshot_date) AS tenure_months_at_snapshot,#(lf)    #(lf)    -- Employment status at snapshot#(lf)    CASE#(lf)        WHEN ed.fact_employee_remuneration_company_enddate IS NOT NULL #(lf)            AND ed.fact_employee_remuneration_company_enddate <= me.snapshot_date #(lf)            THEN 'Inactive'#(lf)        WHEN ed.fact_employee_remuneration_company_startdate <= me.snapshot_date #(lf)            THEN 'Active'#(lf)        ELSE 'Not Yet Started'#(lf)    END AS employment_status_at_snapshot,#(lf)    #(lf)    ed.fact_employee_remuneration_maori_indicator,#(lf)    ed.fact_employee_remuneration_pasifika_indicator,#(lf)    #(lf)    ed.dwhiscurrent#(lf)#(lf)FROM EmployeeData ed#(lf)#(lf)CROSS APPLY (#(lf)    SELECT#(lf)        snapshot_date,#(lf)        financial_year_num,#(lf)        financial_year_desc,#(lf)        financial_month_num#(lf)    FROM month_ends#(lf)    WHERE snapshot_date >= ed.fact_employee_remuneration_company_startdate#(lf)        AND snapshot_date < COALESCE(#(lf)            DATEADD(MONTH, 1, EOMONTH(ed.fact_employee_remuneration_company_enddate, 0)),#(lf)            '2999-12-31'#(lf)        )#(lf)        AND DATEADD(MONTH, DATEDIFF(MONTH, 0, snapshot_date), 0) <= #(lf)            COALESCE(ed.fact_employee_remuneration_company_enddate, CAST(GETDATE() AS DATE))#(lf)) me#(lf)#(lf)LEFT JOIN edw.vw_dim_employee de#(lf)    ON ed.fact_employee_remuneration_employee_number = de.employee_id#(lf)    AND me.snapshot_date BETWEEN de.DWHEffectiveFrom AND ISNULL(de.DWHEffectiveTo, '2999-12-31 23:59:59.000')#(lf)    AND de.DWHDMLOperation <> 'D'#(lf)#(lf)-- NEW: Get current iwi data#(lf)LEFT JOIN edw.vw_dim_employee de_current#(lf)    ON ed.fact_employee_remuneration_employee_number = de_current.employee_id#(lf)    AND de_current.DWHIsCurrent = 1#(lf)    AND de_current.DWHDMLOperation <> 'D'#(lf)#(lf)-- Gender mapping#(lf)LEFT JOIN edw.dim_gender dg#(lf)    ON CASE #(lf)           WHEN de.employee_gender = 'Non-binary' THEN 'Other'#(lf)           WHEN de.employee_gender = '' THEN 'Undisclosed'#(lf)           ELSE de.employee_gender#(lf)       END = dg.intellihr_gender_key#(lf)#(lf)-- FIXED: Include employees in their termination month's snapshot#(lf)WHERE ed.fact_employee_remuneration_company_startdate <= me.snapshot_date#(lf)    AND (ed.fact_employee_remuneration_company_enddate IS NULL #(lf)         OR EOMONTH(ed.fact_employee_remuneration_company_enddate, 0) >= me.snapshot_date)#(lf)          AND de.employee_name <> 'TEST - Jayne Smythe'"]),
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transformed Column Names" = Table.TransformColumnNames(#"Source", each ApplyNamingConventions(_)),
				   
				    // Merge with ethnicity mapping table
				    #"Merged with Ethnicity Mapping" = Table.NestedJoin(
				        #"Transformed Column Names", 
				        {"Employee Ethnicity"}, 
				        #"Ethnicity Historical Mapping",
				        {"employee_ethnicity"}, 
				        "EthnicityMapping", 
				        JoinKind.LeftOuter
				    ),
				    
				    // Expand the Ethnicity Group column from the mapping table
				    #"Expanded Ethnicity Mapping" = Table.ExpandTableColumn(
				        #"Merged with Ethnicity Mapping", 
				        "EthnicityMapping", 
				        {"Ethnicity Group"},
				        {"Mapped Ethnicity Group"}
				    ),
				    
				    // Backfill Primary Ethnicity Section with mapped value if blank
				    #"Added Original Ethnicity" = Table.AddColumn(
				        #"Expanded Ethnicity Mapping", 
				        "Original Ethnicity", 
				        each if [Primary Ethnicity Section] <> null and [Primary Ethnicity Section] <> "" 
				             then [Primary Ethnicity Section]
				             else if [Mapped Ethnicity Group] <> null and [Mapped Ethnicity Group] <> ""
				             then [Mapped Ethnicity Group]
				             else "Unspecified",
				        type text
				    ),
				    
				    // Remove the temporary column
				    #"Removed Temporary Column" = Table.RemoveColumns(
				        #"Added Original Ethnicity", 
				        {"Mapped Ethnicity Group"}
				    ),
				    
				    // Add Days Active In Month column
				    #"Added Days Active" = Table.AddColumn(
				        #"Removed Temporary Column", 
				        "Days Active In Month", 
				        each 
				            let
				                monthStart = Date.StartOfMonth([Snapshot Date]),
				                monthEnd = [Snapshot Date],
				                actualStart = List.Max({[Company Start Date], monthStart}),
				                actualEnd = if [Company End Date] = null then monthEnd else List.Min({[Company End Date], monthEnd}),
				                daysActive = Duration.Days(actualEnd - actualStart) + 1
				            in
				                daysActive,
				        Int64.Type
				    ),
				    
				    // Add Length of Service category
				    #"Added Length of Service" = Table.AddColumn(
				        #"Added Days Active", 
				        "Length of Service", 
				        each 
				            let
				                tenureMonths = [Tenure Months At Snapshot]
				            in
				                if tenureMonths = null then "Unknown"
				                else if tenureMonths < 36 then "Up to 2 years"
				                else if tenureMonths < 72 then "3 - 5 years"
				                else if tenureMonths < 132 then "6 - 10 years"
				                else if tenureMonths < 252 then "11 - 20 years"
				                else "21+ years",
				        type text
				    ),
				    
				    // Add Length of Service Sort Order
				    #"Added Sort Order" = Table.AddColumn(
				        #"Added Length of Service", 
				        "Length of Service Sort", 
				        each 
				            if [Length of Service] = "Up to 2 years" then 1
				            else if [Length of Service] = "3 - 5 years" then 2
				            else if [Length of Service] = "6 - 10 years" then 3
				            else if [Length of Service] = "11 - 20 years" then 4
				            else if [Length of Service] = "21+ years" then 5
				            else 999,
				        Int64.Type
				    ),
				    
				    #"Added Custom" = Table.AddColumn(#"Added Sort Order", "Company Intelli BU", each Text.From([Dim Company KEY]) & "_" & [Fact Employee Remuneration Businessunit ID])
				in
				    #"Added Custom"
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

