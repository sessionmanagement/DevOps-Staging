	partition 'Dim Service' = m
		mode: import
		queryGroup: Dims
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="SELECT#(lf)    [dim_service_key],#(lf)    [company_name],#(lf)    [service_id],#(lf)    [dim_company_key],#(lf)    [intellihr_service_id],#(lf)    [service_name],#(lf)    [dim_service_unique_key],#(lf)    [service_type_name],#(lf)    [district_name],#(lf)    [region_name],#(lf)    [DWHEffectiveFrom],#(lf)    [DWHEffectiveTo],#(lf)    [DWHIsCurrent],#(lf)    [is_inactive],#(lf)    [latitude],#(lf)    [longitude]#(lf)FROM [edw].[dim_service]#(lf)WHERE (([DWHDMLOperation] <> 'D') AND ((([dim_service_key] <> -1 AND [dim_service_key] <> 0) AND [service_id] > 0))) AND ([DWHIsCurrent] = 1);"]),
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, each ApplyNamingConventions(_)),
				    #"Added Conditional Column" = Table.AddColumn(#"Transformed Column Names", "Company Short Code", each if [Company Name] = "Mind and Body Consultants Ltd" then "MBC" else if [Company Name] = "Emerge Aotearoa Housing Trust" then "EAHT" else if [Company Name] = "Ignite Aotearoa Limited" then "IGN" else "EAL", type text),
				    #"Changed Type" = Table.TransformColumnTypes(#"Added Conditional Column",{{"Latitude", type number}, {"Longitude", type number}, {"DWH Effective From", type date}, {"DWH Effective To", type date}}),
				    #"Added Custom" = Table.AddColumn(#"Changed Type", "Company Intelli BU", each Text.From([Dim Company KEY]) & "_" & [Intellihr Service ID]),
				    #"Inserted Merged Column" = Table.AddColumn(#"Added Custom", "CompanyServiceID", each Text.Combine({Text.From([Dim Company KEY], "en-NZ"), Text.From([Service ID], "en-NZ")}), type text),
				    #"Added Test Column" = Table.AddColumn(#"Inserted Merged Column", "Active At FY End", each if [DWH Effective From] <= #date(2024,6,30) and ([DWH Effective To] = null or [DWH Effective To] > #date(2024,6,30)) then "Yes" else "No"),
				    #"Merged Queries" = Table.NestedJoin(#"Added Test Column", {"Service Name"}, #"Service Descriptions", {"Service"}, "Service Descriptions", JoinKind.LeftOuter),
				    #"Expanded Service Descriptions" = Table.ExpandTableColumn(#"Merged Queries", "Service Descriptions", {"Description"}, {"Description"}),
				    #"Merged Queries1" = Table.NestedJoin(#"Expanded Service Descriptions", {"Dim Service Unique KEY"}, #"Service Groupings", {"Dim Service Unique KEY"}, "Service Groupings", JoinKind.LeftOuter),
				    #"Expanded Service Groupings" = Table.ExpandTableColumn(#"Merged Queries1", "Service Groupings", {"Service Type Group Name"}, {"Service Type Group Name"}),
				    #"Filtered Rows1" = Table.SelectRows(#"Expanded Service Groupings", each ([Company Intelli BU] <> null))
				in
				    #"Filtered Rows1"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

