	column 'Days Active In Month'
		dataType: int64
		formatString: 0
		lineageTag: e631c6f8-6280-4ff7-9b88-ce8b1bc955a5
		summarizeBy: sum
		sourceColumn: Days Active In Month

		annotation SummarizationSetBy = Automatic

	partition 'Fact Referrals' = m
		mode: import
		queryGroup: Facts
		source = ```
				let
				    Source = Sql.Database(Server, Database, [Query="WITH referral_base AS (#(lf)    SELECT#(lf)        fcr.fact_client_referral_key,#(lf)        fcr.fact_client_referral_unique_key,#(lf)        fcr.dim_client_referral_key,#(lf)        fcr.dim_company_key,#(lf)        fcr.dim_service_key,#(lf)        fcr.dim_client_team_key,#(lf)        fcr.dim_client_key,#(lf)        fcr.dim_employee_key,#(lf)        fcr.client_referral_id,#(lf)        fcr.client_id,#(lf)        fcr.client_team_id,#(lf)#(lf)        CAST(fcr.client_id AS VARCHAR(50)) + '-' + CAST(fcr.dim_company_key AS VARCHAR(50)) AS unique_client_id,#(lf)        CAST(fcr.client_referral_id AS VARCHAR(50)) + '-' + CAST(fcr.dim_company_key AS VARCHAR(50)) AS unique_referral_id,#(lf)#(lf)        dcr.client_referral_type,#(lf)        dct.dim_client_team_unique_key,#(lf)#(lf)        TRY_CONVERT(DATE, CAST(fcr.client_referral_received_date_key AS CHAR(8))) AS referral_received_date,#(lf)        TRY_CONVERT(DATE, CAST(fcr.client_referral_pending_date_key AS CHAR(8))) AS referral_pending_date,#(lf)        TRY_CONVERT(DATE, CAST(fcr.client_referral_waitlist_date_key AS CHAR(8))) AS referral_waitlisted_date,#(lf)        TRY_CONVERT(DATE, CAST(fcr.client_referral_accepted_date_key AS CHAR(8))) AS referral_accepted_date,#(lf)        TRY_CONVERT(DATE, CAST(fcr.client_referral_decline_date_key AS CHAR(8))) AS referral_declined_date,#(lf)        TRY_CONVERT(DATE, CAST(fcr.client_referral_discharge_date_key AS CHAR(8))) AS referral_discharged_date,#(lf)#(lf)        COALESCE(#(lf)            TRY_CONVERT(DATE, CAST(fcr.client_referral_end_date_key AS CHAR(8))),#(lf)            TRY_CONVERT(DATE, CAST(fcr.client_referral_decline_date_key AS CHAR(8))),#(lf)            TRY_CONVERT(DATE, CAST(fcr.client_referral_discharge_date_key AS CHAR(8)))#(lf)        ) AS referral_ended_date,#(lf)#(lf)        -- Status flags#(lf)        CASE WHEN fcr.client_referral_accepted_date_key IS NOT NULL THEN 1 ELSE 0 END AS was_accepted,#(lf)        CASE WHEN fcr.client_referral_decline_date_key IS NOT NULL THEN 1 ELSE 0 END AS was_declined,#(lf)        CASE WHEN fcr.client_referral_discharge_date_key IS NOT NULL THEN 1 ELSE 0 END AS was_discharged,#(lf)#(lf)        CASE WHEN fcr.client_referral_accepted_date_key = fcr.client_referral_discharge_date_key THEN 1 ELSE 0 END AS same_day_accepted_and_discharged#(lf)#(lf)    FROM edw.vw_fact_client_referral fcr#(lf)    INNER JOIN edw.dim_client_referral dcr#(lf)        ON fcr.dim_client_referral_key = dcr.dim_client_referral_key#(lf)    LEFT JOIN edw.dim_client_team dct#(lf)        ON fcr.dim_client_team_key = dct.dim_client_team_key#(lf)        AND dct.DWHDMLOperation <> 'D'#(lf)    WHERE fcr.DWHDMLOperation <> 'D'#(lf)        AND dcr.client_referral_type = 'inboundreferral'#(lf)),#(lf)#(lf)available_month_ends AS (#(lf)    SELECT DISTINCT#(lf)        EOMONTH(calendar_date) AS snapshot_date,#(lf)        financial_year_num,#(lf)        financial_year_desc,#(lf)        financial_month_num#(lf)    FROM edw.vw_dim_date#(lf)    WHERE financial_year_num >= YEAR(DATEADD(YEAR, -3, GETDATE())) - 1#(lf)        -- Includes last 4-5 financial years depending on current date#(lf))#(lf)#(lf)SELECT#(lf)    rb.fact_client_referral_key,#(lf)    rb.fact_client_referral_unique_key,#(lf)    rb.dim_client_referral_key,#(lf)    rb.dim_company_key,#(lf)    rb.dim_service_key,#(lf)    rb.dim_client_team_key,#(lf)    rb.dim_client_key,#(lf)    rb.dim_employee_key,#(lf)    rb.client_referral_id,#(lf)    rb.client_id,#(lf)    rb.client_team_id,#(lf)    rb.unique_client_id,#(lf)    rb.unique_referral_id,#(lf)    rb.client_referral_type,#(lf)    rb.dim_client_team_unique_key,#(lf)    rb.referral_received_date,#(lf)    rb.referral_pending_date,#(lf)    rb.referral_waitlisted_date,#(lf)    rb.referral_accepted_date,#(lf)    rb.referral_declined_date,#(lf)    rb.referral_discharged_date,#(lf)    rb.referral_ended_date,#(lf)    rb.was_accepted,#(lf)    rb.was_declined,#(lf)    rb.was_discharged,#(lf)    rb.same_day_accepted_and_discharged,#(lf)#(lf)    me.snapshot_date,#(lf)    me.financial_year_num,#(lf)    me.financial_year_desc,#(lf)    me.financial_month_num,#(lf)#(lf)    -- Demographics as of the snapshot date#(lf)    dc.client_date_of_birth,#(lf)    dc.client_gender,#(lf)    dc.client_ethnicity_group,#(lf)    #(lf)    -- Gender dimension#(lf)    dg.dim_gender_key,#(lf)#(lf)    -- Exact age calculation as of snapshot date (accounts for birthday occurrence)#(lf)    DATEDIFF(YEAR, dc.client_date_of_birth, me.snapshot_date) -#(lf)    CASE#(lf)        WHEN MONTH(dc.client_date_of_birth) > MONTH(me.snapshot_date)#(lf)            OR (MONTH(dc.client_date_of_birth) = MONTH(me.snapshot_date)#(lf)                AND DAY(dc.client_date_of_birth) > DAY(me.snapshot_date))#(lf)        THEN 1#(lf)        ELSE 0#(lf)    END AS age_at_snapshot,#(lf)#(lf)    -- Exact age at acceptance (accounts for birthday occurrence)#(lf)    DATEDIFF(YEAR, dc.client_date_of_birth, rb.referral_accepted_date) -#(lf)    CASE#(lf)        WHEN MONTH(dc.client_date_of_birth) > MONTH(rb.referral_accepted_date)#(lf)            OR (MONTH(dc.client_date_of_birth) = MONTH(rb.referral_accepted_date)#(lf)                AND DAY(dc.client_date_of_birth) > DAY(rb.referral_accepted_date))#(lf)        THEN 1#(lf)        ELSE 0#(lf)    END AS age_at_acceptance,#(lf)#(lf)    -- Current status as of this snapshot#(lf)    CASE#(lf)        WHEN rb.referral_declined_date <= me.snapshot_date THEN 'Declined'#(lf)        WHEN rb.referral_discharged_date <= me.snapshot_date THEN 'Discharged'#(lf)        WHEN rb.referral_accepted_date <= me.snapshot_date THEN 'Accepted'#(lf)        WHEN rb.referral_waitlisted_date <= me.snapshot_date THEN 'Waitlisted'#(lf)        WHEN rb.referral_pending_date <= me.snapshot_date THEN 'Pending'#(lf)        ELSE 'Received'#(lf)    END AS status_at_snapshot#(lf)#(lf)FROM referral_base rb#(lf)#(lf)-- OPTIMIZATION: Use CROSS APPLY to only generate month-ends within each referral's date range#(lf)-- This is more efficient than CROSS JOIN + WHERE filter as SQL Server can push predicates into the apply#(lf)CROSS APPLY (#(lf)    SELECT#(lf)        snapshot_date,#(lf)        financial_year_num,#(lf)        financial_year_desc,#(lf)        financial_month_num#(lf)    FROM available_month_ends#(lf)    WHERE snapshot_date >= rb.referral_accepted_date#(lf)        AND snapshot_date < COALESCE(#(lf)            DATEADD(MONTH, 1, EOMONTH(rb.referral_ended_date)),  -- Month after the end month#(lf)            '2999-12-31'  -- Still active#(lf)        )#(lf)        AND DATEADD(MONTH, DATEDIFF(MONTH, 0, snapshot_date), 0) <= COALESCE(rb.referral_ended_date, CAST(GETDATE() AS DATE))#(lf)        -- First day of snapshot month must be <= referral end date (ensures referral was active during the month)#(lf)) me#(lf)#(lf)-- SCD Type 2 join: Get demographics as they were at the snapshot date#(lf)LEFT JOIN edw.dim_client dc#(lf)    ON rb.client_id = dc.client_id#(lf)    AND rb.dim_company_key = dc.company_id#(lf)    AND dc.DWHDMLOperation <> 'D'#(lf)    AND me.snapshot_date BETWEEN dc.DWHEffectiveFrom AND ISNULL(dc.DWHEffectiveTo, '2999-12-31 23:59:59.000')#(lf)#(lf)-- Gender dimension join for clients#(lf)LEFT JOIN edw.dim_gender dg#(lf)    ON dc.client_gender = dg.gender_name#(lf)#(lf)WHERE rb.was_accepted = 1;"]),
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transformed Column Names" = Table.TransformColumnNames(#"Source", each ApplyNamingConventions(_)),
				    #"Changed Type" = Table.TransformColumnTypes(#"Transformed Column Names",{{"Snapshot Date", type date}, {"Referral Received Date", type date}, {"Referral Pending Date", type date}, {"Referral Waitlisted Date", type date}, {"Referral Accepted Date", type date}, {"Referral Discharged Date", type date}, {"Referral Ended Date", type date}, {"Tangata Whaiora Date Of Birth", type date}}),
				    #"Added Days Active" = Table.AddColumn(#"Changed Type", "Days Active In Month", each 
				        let
				            monthStart = Date.StartOfMonth([Snapshot Date]),
				            monthEnd = [Snapshot Date],
				            actualStart = List.Max({[Referral Accepted Date], monthStart}),
				            actualEnd = if [Referral Ended Date] = null then monthEnd else List.Min({[Referral Ended Date], monthEnd}),
				            daysActive = Duration.Days(actualEnd - actualStart) + 1
				        in
				            daysActive,
				        Int64.Type)
				in
				    #"Added Days Active"
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

