table 'Dim Ethnicity'
	lineageTag: bef1b8b1-4586-4ad5-9511-73e9fc9a0d8d

	column 'Original Ethnicity'
		dataType: string
		lineageTag: 73a6e265-86e1-4741-8bca-8de3e774760d
		summarizeBy: none
		sourceColumn: Original Ethnicity

