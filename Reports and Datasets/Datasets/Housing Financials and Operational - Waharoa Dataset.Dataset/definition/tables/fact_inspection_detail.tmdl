	partition fact_inspection_detail = m
		mode: import
		queryGroup: facts
		source =
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="WITH optionHashTable AS #(lf)(#(lf)    SELECT#(lf)        [OptionSetName],#(lf)        [Option],#(lf)        [EntityName],#(lf)        HASHBYTES('MD5', [OptionSetName] + CAST([Option] AS nvarchar(100)) + [EntityName]) AS optionHash,#(lf)        [LocalizedLabel]#(lf)    FROM #(lf)        [Zavanti].[vw_GlobalOptionsetMetadata]#(lf)#(lf)    UNION#(lf)#(lf)    SELECT#(lf)        [OptionSetName],#(lf)        [Option],#(lf)        [EntityName],#(lf)        HASHBYTES('MD5', [OptionSetName] + CAST([Option] AS nvarchar(100)) + [EntityName]) AS optionHash,#(lf)        [LocalizedLabel]#(lf)    FROM #(lf)        [Zavanti].[vw_OptionsetMetadata]#(lf)#(lf)    UNION#(lf)#(lf)    SELECT#(lf)        'statuscodename' AS [OptionSetName],#(lf)        [status] AS [Option],#(lf)        [EntityName],#(lf)        HASHBYTES('MD5', 'statuscodename' + CAST([status] AS nvarchar(100)) + [EntityName]) AS optionHash,#(lf)        [LocalizedLabel]#(lf)    FROM #(lf)        [Zavanti].[vw_StatusMetadata]#(lf)#(lf)    UNION#(lf)#(lf)    SELECT#(lf)        'statecodename' AS [OptionSetName],#(lf)        [state] AS [Option],#(lf)        [EntityName],#(lf)        HASHBYTES('MD5', 'statecodename' + CAST([state] AS nvarchar(100)) + [EntityName]) AS optionHash,#(lf)        [LocalizedLabel]#(lf)    FROM #(lf)        [Zavanti].[vw_StateMetadata]#(lf)),#(lf)RecentInspectionDetails AS (#(lf)    SELECT#(lf)        zav_inspectiondetailid,#(lf)        zav_assetcondition,#(lf)        zav_clean,#(lf)        zav_undamaged,#(lf)        zav_working,#(lf)        zav_comments,#(lf)        zav_inspectionid,#(lf)        zav_assetsname,#(lf)        zav_areaname,#(lf)        zav_propertyassetsname,#(lf)        SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (PARTITION BY zav_inspectiondetailid ORDER BY SinkModifiedOn DESC) AS rn#(lf)    FROM #(lf)        [Zavanti].[vw_zav_inspectiondetail]#(lf)#(tab)WHERE#(lf)#(tab)#(tab)zav_inspectiondetailid IS NOT NULL#(lf))#(lf)SELECT#(lf)    rid.zav_inspectiondetailid,#(lf)    rid.zav_assetcondition,#(lf)    t1.LocalizedLabel AS zav_assetconditionname,#(lf)    t2.LocalizedLabel AS zav_cleanname,#(lf)    rid.zav_comments,#(lf)    rid.zav_inspectionid,#(lf)    t3.LocalizedLabel AS zav_undamagedname,#(lf)    t4.LocalizedLabel AS zav_workingname,#(lf)    rid.zav_assetsname,#(lf)    rid.zav_areaname,#(lf)    rid.zav_propertyassetsname#(lf)FROM #(lf)    RecentInspectionDetails rid#(lf)LEFT OUTER JOIN #(lf)    optionHashTable t1 ON t1.optionHash = HASHBYTES('MD5', 'zav_assetcondition' + CAST(rid.zav_assetcondition AS nvarchar(100)) + 'zav_inspectiondetail')#(lf)LEFT OUTER JOIN #(lf)    optionHashTable t2 ON t2.optionHash = HASHBYTES('MD5', 'zav_clean' + CAST(rid.zav_clean AS nvarchar(100)) + 'zav_inspectiondetail')#(lf)LEFT OUTER JOIN #(lf)    optionHashTable t3 ON t3.optionHash = HASHBYTES('MD5', 'zav_undamaged' + CAST(rid.zav_undamaged AS nvarchar(100)) + 'zav_inspectiondetail')#(lf)LEFT OUTER JOIN #(lf)    optionHashTable t4 ON t4.optionHash = HASHBYTES('MD5', 'zav_working' + CAST(rid.zav_working AS nvarchar(100)) + 'zav_inspectiondetail')#(lf)WHERE#(lf)    rid.rn = 1"])
				in
				    Source

	annotation PBI_ResultType = Table

