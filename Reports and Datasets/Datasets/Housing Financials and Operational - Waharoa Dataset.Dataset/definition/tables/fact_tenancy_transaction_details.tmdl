SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (PARTITION BY zav_tenancytransactiondetailsid ORDER BY SinkModifiedOn DESC) AS rn#(lf)    FROM #(lf)        [Zavanti].[vw_zav_tenancytransactiondetails]#(lf)#(tab)WHERE#(lf)#(tab)#(tab)new_suspenseaccount = 'False'#(lf))#(lf)SELECT DISTINCT#(lf)    rtt.zav_tenancytransactiondetailsid,#(lf)    rtt.zav_name,#(lf)    rtt.new_suspenseaccount,#(lf)    rtt.new_transactiontypecode,#(lf)    t1.LocalizedLabel AS zav_accounttypename,#(lf)    rtt.zav_amount,#(lf)    rtt.zav_comments,#(lf)    rtt.zav_date,#(lf)    rtt.zav_propertyreferencenumber,#(lf)    t2.LocalizedLabel AS zav_rentname,#(lf)    rtt.zav_rentpaidto,#(lf)    rtt.zav_tenancy,#(lf)    t3.LocalizedLabel AS zav_transactionname,#(lf)    rtt.zav_tenancyname,#(lf)    rtt.zav_transactiontypename,#(lf)    rtt.zav_subtransactionname,#(lf)    rtt.createdon#(lf)FROM #(lf)    RecentTenancyTransactionDetails rtt#(lf)LEFT OUTER JOIN #(lf)    optionHashTable t1 ON t1.optionHash = HASHBYTES('MD5', 'zav_accounttype' + CAST(rtt.zav_accounttype AS nvarchar(100)) + 'zav_tenancytransactiondetails')#(lf)LEFT OUTER JOIN #(lf)    optionHashTable t2 ON t2.optionHash = HASHBYTES('MD5', 'zav_rent' + CAST(rtt.zav_rent AS nvarchar(100)) + 'zav_tenancytransactiondetails')#(lf)LEFT OUTER JOIN #(lf)    optionHashTable t3 ON t3.optionHash = HASHBYTES('MD5', 'zav_transaction' + CAST(rtt.zav_transaction AS nvarchar(100)) + 'zav_tenancytransactiondetails')#(lf)WHERE#(lf)    rtt.rn = 1"]),
