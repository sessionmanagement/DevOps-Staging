	column tenancy_has_open_breach_or_tribunal_action =
			
			IF(
			    fact_tenancy_transaction_details[tenancy_has_open_tenancytribunal_dispute] = "Yes"
			    || fact_tenancy_transaction_details[tenancy_has_unresolved_breach] = "Yes",
			    "Yes",
			    "No"
			)
		isHidden
		lineageTag: e1709028-2aa1-4d33-b495-bf4f3747140d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

