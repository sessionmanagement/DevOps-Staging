	column zav_fulladdress = RELATED(dim_property[zav_fulladdress])
		lineageTag: 43b165ca-0748-4b17-bf7b-f12ceb77fcbc
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column overall_breach_status =
			
			IF(
			    fact_tenancy_transaction_details[tenancy_has_open_tenancytribunal_dispute] = "Yes", "Open tribunal action exists",
			    IF(
			        fact_tenancy_transaction_details[tenancy_has_unresolved_breach] = "Yes", "Open breach exists",
			        "No open issues"
			    )
			)
		lineageTag: 4cbde77a-e82b-4cdf-a91e-1739454882c0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

