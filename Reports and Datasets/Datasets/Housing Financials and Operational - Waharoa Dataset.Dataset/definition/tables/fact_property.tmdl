table fact_property
	lineageTag: d4d29a22-ac0b-44f6-b28f-408a41ad745f

	column zav_propertyid
		dataType: string
		isHidden
		lineageTag: 2b426d8b-a496-4243-adc1-0d6233cce003
		summarizeBy: none
		sourceColumn: zav_propertyid

		annotation SummarizationSetBy = Automatic

	column length_of_ownership_days =
			
			IF(
			    ISBLANK(RELATED(dim_property[zav_confirmeddisposaldate])),
			        DATEDIFF(RELATED(dim_property[zav_acquireddate]),TODAY(),DAY),
			        DATEDIFF(RELATED(dim_property[zav_acquireddate]),RELATED(dim_property[zav_confirmeddisposaldate]),DAY)
			)
		isHidden
		formatString: 0
		lineageTag: 7ad5ec9c-4f0c-4eb6-9351-bf1e01e7b911
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column approx_build_date =
			
			IF(
			    ISBLANK(RELATED(dim_property[new_yearbuilt])),
			    BLANK(),
			    DATE(RELATED(dim_property[new_yearbuilt]),06,01)
			)
		isHidden
		formatString: Short Date
		lineageTag: 4bda149d-b10f-48d4-8be0-a558df4a9e7e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column house_age_days =
			
			IF(
			    ISBLANK(fact_property[approx_build_date]),
			        BLANK(),
			        DATEDIFF(fact_property[approx_build_date],TODAY(),DAY)
			)
		isHidden
		formatString: 0
		lineageTag: 20dbab1f-5839-4f73-8ece-7350016d18ea
		summarizeBy: sum

