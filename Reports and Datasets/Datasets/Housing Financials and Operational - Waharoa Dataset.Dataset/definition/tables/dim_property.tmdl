	column latest_tenancy_end_date_or_today
		dataType: dateTime
		isHidden
		formatString: Long Date
		lineageTag: e48d9955-5f96-4b11-8957-a6110d2223ab
		summarizeBy: none
		sourceColumn: latest_tenancy_end_date_or_today

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column property_currently_tenanted_yn =
			
			IF(
			    ISBLANK(dim_property[latest_tenancy_end_date_or_today]),0,
			    IF(
			        dim_property[latest_tenancy_end_date_or_today] < TODAY(),0,1)
			)
		isHidden
		formatString: 0
		lineageTag: 714fd227-4ed6-4de8-b68f-69cd2d2721d2
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column property_has_been_tenanted_yn =
			
			IF(
			    ISBLANK(dim_property[latest_tenancy_end_date_or_today]),0,1
			)
		isHidden
		formatString: 0
		lineageTag: aaa9e6eb-0998-44b8-bbb2-0f54c6a3a154
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column days_since_last_tenancy =
			
			IF(
			    dim_property[property_currently_tenanted_yn] = 0 && dim_property[property_has_been_tenanted_yn] = 1,
			    DATEDIFF(
			        dim_property[latest_tenancy_end_date_or_today], TODAY(), DAY
			    ),
			    BLANK()
			)
		formatString: 0
		lineageTag: eaf42b00-afd8-473f-84e5-5c4d028cbee5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column property_tenancy_status =
			
			IF(
			    dim_property[latest_tenancy_end_date_or_today] = TODAY(), "Currently tenanted",
			    IF(
			        dim_property[property_currently_tenanted_yn] = 0 && dim_property[property_has_been_tenanted_yn] = 1, "Currently vacant but previously tenanted",
			        IF(
			            dim_property[property_has_been_tenanted_yn] = 0, "Never been tenanted"
			        )
			    )
			)
		isHidden
		lineageTag: 652b4f67-74dd-4831-91b9-1fcbb0db8662
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column weeks_since_last_tenanted =
			
			IF(
			    ISBLANK(dim_property[days_since_last_tenancy]),BLANK(),
			    IF(
			        dim_property[days_since_last_tenancy] < 7, "0",
			    IF(
			        dim_property[days_since_last_tenancy] < 14, "1",
			        IF(
			            dim_property[days_since_last_tenancy] < 21, "2",
			            IF(
			                dim_property[days_since_last_tenancy] < 28, "3",
			                IF(
			                    dim_property[days_since_last_tenancy] < 35, "4",
			                    IF(
			                        dim_property[days_since_last_tenancy] < 42, "5",
			                        IF(
			                            dim_property[days_since_last_tenancy] < 49, "6",
			                            IF(
			                                dim_property[days_since_last_tenancy] < 56, "7",
			                                IF(
			                                    dim_property[days_since_last_tenancy] >= 56, "8+"
			                                    ,BLANK()
			                                )
			                            ))))))))
			
			)
		lineageTag: f3530f71-ff3a-434b-869e-896d04c2ebc1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column property_is_active_as_of_today =
			
			IF(
			    ISBLANK(dim_property[zav_confirmeddisposaldate]),1,
			    IF(
			        dim_property[zav_confirmeddisposaldate] >= TODAY(), 1,
			        0
			    )
			)
		isHidden
		formatString: 0
		lineageTag: d3058ef8-3cdd-4612-81f6-4011eb823c0e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

