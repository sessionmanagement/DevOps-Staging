	partition dim_household-f420bab1-03d8-4fc6-8e49-950cac3c03b6 = m
		mode: import
		queryGroup: dimensions
		source =
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="WITH RecentHouseholds AS (#(lf)    SELECT#(lf)        zav_name,#(lf)        zav_hhid,#(lf)        zav_tenancy,#(lf)        zav_tenancyname,#(lf)        SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (PARTITION BY zav_hhid ORDER BY SinkModifiedOn DESC) AS rn#(lf)    FROM#(lf)        [Zavanti].[vw_zav_household]#(lf))#(lf)SELECT#(lf)    zav_name,#(lf)    zav_hhid,#(lf)    zav_tenancy,#(lf)    zav_tenancyname#(lf)FROM#(lf)    RecentHouseholds#(lf)WHERE#(lf)    rn = 1"]),
				    #"Sorted Rows" = Table.Sort(Source,{{"zav_name", Order.Ascending}}),
				    #"Added Custom" = Table.AddColumn(#"Sorted Rows", "Composite", each [zav_name]&[zav_hhid]&[zav_tenancy]&[zav_tenancyname]),
				    #"Filtered Rows" = Table.SelectRows(#"Added Custom", each ([Composite] <> null)),
				    #"Removed Duplicates" = Table.Distinct(#"Filtered Rows", {"zav_hhid"})
				in
				    #"Removed Duplicates"

	annotation PBI_ResultType = Table

