	column inspection_url =
			
			CONCATENATE("https://emergeaotearoa.crm6.dynamics.com/main.aspx?appid=cf3d4408-7345-453c-8775-1e5538c40ddf&forceUCI=1&pagetype=entityrecord&etn=zav_inspection&id=",fact_inspection[zav_inspectionid])
