	partition fact_inspection = m
		mode: import
		queryGroup: facts
		source =
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="WITH RecentInspections AS (#(lf)    SELECT#(lf)        zav_inspectionid,#(lf)        zav_name,#(lf)        zav_inspectioncategory,#(lf)        zav_inspectiondate,#(lf)        zav_inspectionsummary,#(lf)        zav_inspectiontype,#(lf)        zav_property,#(lf)        zav_inspectedbyname,#(lf)        zav_tenant,#(lf)        SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (PARTITION BY zav_inspectionid ORDER BY SinkModifiedOn DESC) AS rn#(lf)    FROM#(lf)        [Zavanti].[vw_zav_inspection]#(lf)),#(lf)RecentOpportunities AS (#(lf)    SELECT#(lf)        opportunityid,#(lf)        zav_vacateddate,#(lf)        zav_tenancymanagerid,#(lf)        SinkModifiedOn,#(lf)        ROW_NUMBER() OVER (PARTITION BY opportunityid ORDER BY SinkModifiedOn DESC) AS rn#(lf)    FROM#(lf)        [Zavanti].[vw_opportunity]#(lf))#(lf)SELECT#(lf)    ri.zav_inspectionid,#(lf)    ri.zav_name,#(lf)    ri.zav_inspectioncategory,#(lf)    ri.zav_inspectiondate,#(lf)    ri.zav_inspectionsummary,#(lf)    ri.zav_inspectiontype,#(lf)    ri.zav_property,#(lf)    ri.zav_inspectedbyname,#(lf)    ro.opportunityid,#(lf)    ro.zav_vacateddate,#(lf)    ro.zav_tenancymanagerid#(lf)FROM #(lf)    RecentInspections ri#(lf)LEFT OUTER JOIN #(lf)    RecentOpportunities ro ON ri.zav_tenant = ro.opportunityid#(lf)WHERE#(lf)    ri.rn = 1 AND ro.rn = 1"]),
				    #"Changed Type1" = Table.TransformColumnTypes(Source,{{"zav_vacateddate", type date}}),
				    #"Added Custom" = Table.AddColumn(#"Changed Type1", "inspection_category_type_key", each Text.Combine({Text.From([zav_inspectioncategory], "en-NZ"), ":", Text.From([zav_inspectiontype], "en-NZ")})),
				    #"Removed Columns" = Table.RemoveColumns(#"Added Custom",{"zav_inspectioncategory", "zav_inspectiontype"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Removed Columns",{{"zav_inspectiondate", type date}}),
				    #"Merged Queries" = Table.NestedJoin(#"Changed Type", {"zav_inspectionid"}, work_inspection_avg_score, {"zav_inspectionid"}, "work_inspection_avg_score", JoinKind.LeftOuter),
				    #"Expanded work_inspection_avg_score" = Table.ExpandTableColumn(#"Merged Queries", "work_inspection_avg_score", {"average_score"}, {"average_score"})
				in
				    #"Expanded work_inspection_avg_score"

	annotation PBI_ResultType = Table

