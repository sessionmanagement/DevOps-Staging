	partition 'Ref Tangata Whaiora Goals' = m
		mode: import
		queryGroup: 'Reference Tables'
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="--=====================================================================================================================================================================#(lf)--=====creating the clients I need to create the table#(lf)--=====================================================================================================================================================================#(lf)with #clients as #(lf)(#(lf)SELECT #(lf)#(tab)dim_client_unique_key,#(lf)#(tab)client_id,#(lf)#(tab)client_display_name#(lf)#(lf)from edw.vw_dim_client#(lf)where dwhiscurrent =1 #(lf)#(lf)--=====nb this will include people who have no referrals - long story but they should be inactive so shouldn't show up in the report#(lf)),#(lf)--================================================================================#(lf)#(tab)#(tab)--=====creating person centred goals#(lf)--================================================================================#(lf)#client_PC_Goal as#(lf)(#(lf)select#(lf)#(tab)#(tab)--====putting in distinct so that I don't get duplicates from the table which contains more than one row per goal#(lf)distinct #(lf)#(tab)#(tab)--======creating a unique key here so I can join the tables together#(lf)#(tab)cast(vw_fact_client_personal_goal.client_id as nvarchar(10))+'-'+cast(vw_fact_client_personal_goal.dim_company_key as nvarchar(2)) as dim_client_unique_key#(lf)#(tab),client_personal_goal_id #(lf)#(tab)#(tab)--====working out whether the goal is closed or not#(lf),case#(lf)#(tab)when client_personal_goal_close_date_key is null then 0#(lf)#(tab)when client_personal_goal_close_date_key <> 0 then 1#(lf)#(tab)else 0#(lf)#(tab)end as closed_personal_goals ,#(lf)#(tab)dim_client_referral_key,#(lf)#(tab)#(tab)--==== I need created date later on to work out the time taken between referral acceptance and created date#(lf)#(tab)client_personal_goal_created_date_key#(lf)#(lf)from edw.vw_fact_client_personal_goal#(lf)#(tab)#(tab)--====getting rid of deleted rows#(lf)where vw_fact_client_personal_goal.DWHDMLOperation <> 'd'#(lf)),#(lf)--===== creating a table which calculates the number of closed goals and the total number of goals that were created#(lf)#Person_Centred_goals as#(lf)(#(lf)select #(lf)#(tab)dim_client_unique_key, #(lf)#(tab)sum(closed_personal_goals) as closed_pc_goals, #(lf)#(tab)count(closed_personal_goals) as total_pc_goals#(lf)from #client_PC_Goal#(lf)group by dim_client_unique_key#(lf)),#(lf)#Person_Centred_Goals_Due as#(lf)(#(lf)select #(tab)cast(vw_fact_client_personal_goal.client_id as nvarchar(10))+'-'+cast(vw_fact_client_personal_goal.dim_company_key as nvarchar(2)) as dim_client_unique_key#(lf)#(tab),client_personal_goal_id ,#(lf)#(tab)case when client_personal_goal_action_id is not null then 1#(lf)#(tab)else 0#(lf)#(tab)end as goal_action_count,#(lf)#(tab)dim_date.calendar_date as goal_action_due_date ,#(lf)#(tab)date2.calendar_date as goal_action_completed_date ,#(lf)#(tab)case when dim_date.calendar_date is null then 1#(lf)#(tab)else 0#(lf)#(tab)end as No_Action_Due_date ,#(lf)#(tab)case #(lf)#(tab)when dim_date.calendar_date is null then 0#(lf)#(tab)when date2.calendar_date is not null then 0#(lf)#(tab)when dim_date.calendar_date > getdate() then 0#(lf)#(tab)else 1#(lf)#(tab)end as Action_Over_Due ,#(lf)#(tab)datediff(day, getdate(),dim_date.calendar_date) #(tab)as daystodue,#(lf)#(tab)case when datediff(day,getdate(),dim_date.calendar_date) between 0 and 30 #(lf)#(tab)and date2.calendar_date is null#(lf)#(tab)then 1#(lf)#(tab)else 0#(lf)#(tab)end as due_in_30_days#(lf)#(lf)#(lf)#(tab)from edw.vw_fact_client_personal_goal#(lf)left join edw.dim_date on vw_fact_client_personal_goal.client_personal_goal_action_due_date_key = dim_date.dim_date_key#(lf)left join edw.dim_date as date2 on vw_fact_client_personal_goal.client_personal_goal_action_completed_date_key = date2.dim_date_key#(lf)#(lf)),#(lf)#Person_Centred_Goal_Summary0#(lf)as #(lf)(#(lf)#(lf)select #(lf)dim_client_unique_key, client_personal_goal_id, sum(No_Action_Due_Date) as Goal_Actions_with_no_due_date,#(lf)sum(Action_Over_due) as Goal_Actions_OverDue, sum(due_in_30_days) as Goal_Actions_Due_in_30_Days,#(lf)sum(goal_action_count) as goal_action_count#(lf)#(lf)from #Person_Centred_Goals_Due#(lf)group by dim_client_unique_key, client_personal_goal_id#(lf)),#(lf)#(lf)#Person_Centre_Goal_Summaryb as (#(lf)select#(lf)#Person_Centred_goals.*,#(lf)--====I'm keeping these here even though Simon doesn't think they're necessary#(lf)#(lf)case when Goal_Actions_with_no_due_date = 1 and closed_pc_goals = total_pc_goals then 0#(lf)else goal_actions_with_no_due_date #(lf)end as goal_actions_with_no_due_date,#(lf)goal_actions_overdue,#(lf)goal_actions_due_in_30_days,#(lf)goal_action_count,#(lf)#(lf)case when closed_pc_goals = total_pc_goals and goal_actions_overdue > 0#(lf)then 1#(lf)else 0#(lf)end as pc_goal_closed_open_actions#(lf)#(lf)from #Person_Centred_goals#(lf)#(lf)left join #Person_Centred_Goal_Summary0 on #Person_Centred_goals.dim_client_unique_key = #Person_Centred_Goal_Summary0.dim_client_unique_key#(lf)#(lf)),#(lf)#Person_Centre_Goal_Summary as#(lf)(#(lf)select #(lf)dim_client_unique_key,#(lf)max(closed_pc_goals) as closed_PC_Goals,#(lf)max(total_pc_goals) as total_pc_goals,#(lf)sum(goal_actions_with_no_due_date) as goal_actions_with_no_due_date,#(lf)sum(goal_actions_overdue) as goal_actions_overdue,#(lf)sum(goal_actions_due_in_30_days) as goal_actions_due_in_30_days,#(lf)sum(goal_action_count) as goal_action_count,#(lf)sum(pc_goal_closed_open_actions) as pc_goal_closed_open_actions#(lf)from #Person_Centre_Goal_Summaryb#(lf)#(lf)group by#(lf)dim_client_unique_key#(lf)) ,#(lf)#(lf)#(lf)--=====================================================================================================================================================================#(lf)--=======Referral Goals.  Using the fact_client_referral_goal table because it has date stamps for referral goals which fact_client_personal_goal table doesn't have#(lf)--=======also, you can have a referral goal without a personal goal so the referral goal won't appear in fact_client_personal_goal #(lf)--=====================================================================================================================================================================#(lf)#referralgoalsall as#(lf)(#(tab)select #(lf)#(tab)dim_client_unique_key#(lf)#(tab), client_referral_goal_id#(lf)#(tab), closed_Ref_goals #(lf)#(tab),case when closed_Ref_goals = 1 then 0#(lf)#(tab)#(tab)when closed_Ref_goals = 0 and days_to_due_date < 0#(lf)#(tab)#(tab)then 1#(lf)#(tab)#(tab)else 0#(lf)#(tab)#(tab)end as referral_goal_overdue,#(lf)#(tab)case when closed_Ref_goals = 1 then 0#(lf)#(tab)#(tab)when closed_Ref_goals = 0 and days_to_due_date between 0 and 30#(lf)#(tab)#(tab)then 1#(lf)#(tab)#(tab)else 0#(lf)#(tab)#(tab)end as referral_goal_due_30_days#(lf)#(lf)from#(lf)(#(lf)select#(lf)#(lf)#(tab)cast(client_id as nvarchar(10))+'-'+cast(dim_company_key as nvarchar(2)) as dim_client_unique_key#(lf)#(tab), client_referral_goal_id#(lf), case #(lf)#(tab)when client_referral_goal_end_date_key is null then 0#(lf)#(tab)when client_referral_goal_end_date_key <> 0 then 1#(lf)#(tab)else 0#(lf)#(tab)end as closed_Ref_goals ,#(lf)#(tab)client_referral_goal_created_date_key, #(lf)#(tab)client_referral_goal_start_date_key,#(lf)#(tab)client_referral_goal_end_date_key,#(lf)#(tab)dim_date.calendar_date as client_referral_goal_due_date,#(lf)#(tab)datediff(day,getdate(),calendar_date) as days_to_due_date#(lf)#(lf)from edw.vw_fact_client_referral_goal #(lf)left join edw.dim_date on vw_fact_client_referral_goal.client_referral_goal_next_review_date_key = dim_date.dim_date_key#(lf)) as orig_data#(lf)#(lf)),#(lf)#client_referral_goals as#(lf)(#(lf)--===== creating a count#(lf)select #(lf)#(tab)dim_client_unique_key, #(lf)#(tab)sum(closed_Ref_goals) as closed_Ref_goals, #(lf)#(tab)count(closed_Ref_goals) as total_Ref_goals,#(lf)#(tab)sum(referral_goal_overdue) as overdue_Ref_goals,#(lf)#(tab)sum(referral_goal_due_30_days) as due_Ref_goals_30_days#(lf)from#(lf)#ReferralGoalsAll#(lf)group by dim_client_unique_key#(lf))#(lf)#(lf)#(lf)--===========================================================================#(lf)--=====bringing them together#(lf)--===========================================================================#(lf)#(lf)select #(lf)#(tab)#clients.dim_client_unique_key,#(lf)#(tab)#clients.client_id,#(lf)#(tab)case#(lf)#(tab)when total_pc_goals > 0 then 0#(lf)#(tab)when total_pc_goals is null then 1#(lf)#(tab)else 1#(lf)#(tab)end as Person_Centred_goal_is_Missing,#(lf)case #(lf)#(tab)when total_ref_goals > 0 then 0#(lf)#(tab)when total_ref_goals is null then 1#(lf)#(tab)else 1#(lf)#(tab)end as Referral_Goal_Is_Missing,#(lf)#(tab)isnull(#Person_Centre_Goal_Summary.total_pc_goals    ,0)#(tab)#(tab)#(tab)as total_pc_goals,#(lf)#(tab)isnull(#Person_Centre_Goal_Summary.closed_pc_goals   ,0)#(tab)#(tab)#(tab)as closed_pc_goals,#(lf)#(tab)isnull(#client_referral_goals.total_Ref_goals  ,0)#(tab)#(tab)#(tab)#(tab)#(tab)as total_ref_goals,#(lf)#(tab)isnull(#client_referral_goals.closed_Ref_goals ,0)#(tab)#(tab)#(tab)#(tab)#(tab)as closed_ref_goals,#(lf)#(tab)isnull(#client_referral_goals.overdue_Ref_goals  ,0)#(tab)#(tab)#(tab)#(tab)as review_overdue,#(lf)#(tab)isnull(#client_referral_goals.due_Ref_goals_30_days ,0)#(tab)#(tab)#(tab)#(tab)as review_due_within_30_days,#(lf)#(tab)isnull(#Person_Centre_Goal_Summary.pc_goal_closed_open_actions,0)#(tab)as pc_goal_closed_open_actions,#(lf)#(tab)isnull(#Person_Centre_Goal_Summary.Goal_Actions_OverDue,0)#(tab)#(tab)#(tab)as pc_goal_actions_overdue,#(lf)#(tab)isnull(#Person_Centre_Goal_Summary.Goal_Actions_Due_in_30_Days,0)#(tab)as pc_goal_actions_due_in_30_Days,#(lf)#(tab)isnull(#Person_Centre_Goal_Summary.Goal_Action_count,0)#(tab)#(tab)#(tab)#(tab)as pc_goal_actions_count#(lf)from #clients#(lf)left join #client_referral_goals on #clients.dim_client_unique_key = #client_referral_goals.dim_client_unique_key#(lf)left join #Person_Centre_Goal_Summary on #clients.dim_client_unique_key = #Person_Centre_Goal_Summary.dim_client_unique_key#(lf)#(lf)"]),
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, each ApplyNamingConventions(_)),
				    #"Renamed Columns" = Table.RenameColumns(#"Transformed Column Names",{{"Dim Tangata Whaiora Unique KEY", "Ref Tangata Whaiora Unique KEY"}})
				in
				    #"Renamed Columns"

	annotation PBI_ResultType = Table

