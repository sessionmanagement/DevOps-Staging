	partition Changelog = m
		mode: import
		queryGroup: Changelog
		source = ```
				let
				    // Define the table schema with the entries reversed
				    InitialTable = #table(
				        {"Version", "Change Date", "Changed By", "User Story ID", "Description"},
				        {
				            // Add new entries at the top here
				                       {
				                "2.3.3", /* Version */
				                #date(2026, 07, 28),  /* Date */
				                "Timi",  /* Changed By */
				                "14165",  /* User Story */
				                "Adding Filter application to make more sense"  /* Description */
				            }, 
				                         {
				                "2.3.2", /* Version */
				                #date(2026, 07, 21),  /* Date */
				                "Timi",  /* Changed By */
				                "14165",  /* User Story */
				                "Changing dataset so it matches the MORe Report Visuals - Using AI"  /* Description */
				            },{
				                "2.3.1", /* Version */
				                #date(2026, 07, 07),  /* Date */
				                "Timi",  /* Changed By */
				                "14164",  /* User Story */
				                "Added measures from TW Demographic Report Using AI"  /* Description */
				            },
				                      {
				                "2.3.0", /* Version */
				                #date(2026, 07, 07),  /* Date */
				                "Timi",  /* Changed By */
				                "",  /* User Story */
				                "Removed Family and Whanau and added it to the Fact TW Referral Table"  /* Description */
				            },  {
				                "2.2.0", /* Version */
				                #date(2026, 06, 29),  /* Date */
				                "Timi",  /* Changed By */
				                "",  /* User Story */
				                "Added pending days and days in service correction. Got rid of PII in dim_employee"  /* Description */
				            }, 
				                   {
				                "2.1.00", /* Version */
				                #date(2026, 06, 29),  /* Date */
				                "Timi",  /* Changed By */
				                "",  /* User Story */
				                "Added in Family and Whanau Involvement"  /* Description */
				            },  {
				            
				                "2.0.00", /* Version */
				                #date(2026, 04, 29),  /* Date */
				                "Timi",  /* Changed By */
				                "9379",  /* User Story */
				                "Taking out unused columns, PII, Ready for Self Service"  /* Description */
				            },  {
				                "1.0.23", /* Version */
				                #date(2026, 01, 26),  /* Date */
				                "Timi",  /* Changed By */
				                "9379",  /* User Story */
				                "Added Unknown Flag to Dim_Tangata_Whaiora"  /* Description */
				            }, 
				                  {
				                "1.0.22", /* Version */
				                #date(2025, 12, 10),  /* Date */
				                "Timi",  /* Changed By */
				                "9379",  /* User Story */
				                "Changed Measures and Definition Table to point to Tangata Whaiora Referral Dataset"  /* Description */
				            },  {
				                "1.0.21", /* Version */
				                #date(2025, 11, 12),  /* Date */
				                "Timi",  /* Changed By */
				                "9379",  /* User Story */
				                "New column Referral Status over all to add discharged to accepted"  /* Description */
				            }, 
				               {
				                "1.0.20", /* Version */
				                #date(2025, 10, 22),  /* Date */
				                "Timi",  /* Changed By */
				                "9379",  /* User Story */
				                "Exclusion column added to dim_team"  /* Description */
				            },  
				             {
				                "1.0.19", /* Version */
				                #date(2025, 10, 21),  /* Date */
				                "Timi",  /* Changed By */
				                "9379",  /* User Story */
				                "gender diverse fix"  /* Description */
				            },      
				            {
				                "1.0.18", /* Version */
				                #date(2025, 10, 21),  /* Date */
				                "Timi",  /* Changed By */
				                "9379",  /* User Story */
				                "Added Asian and European Flags, Added Service Group to get HD, Housing"  /* Description */
				            }, 
				             {
				                "1.0.17", /* Version */
				                #date(2025, 10, 20),  /* Date */
				                "Timi",  /* Changed By */
				                "9379",  /* User Story */
				                "Added length of stay variable to get current LOS"  /* Description */
				            },      {
				                "1.0.16", /* Version */
				                #date(2025, 10, 16),  /* Date */
				                "Timi",  /* Changed By */
				                "9379",  /* User Story */
				                "Added financial quarter offset to dim date"  /* Description */
				            },
				             {
				                "1.0.15", /* Version */
				                #date(2025, 10, 15),  /* Date */
				                "Timi",  /* Changed By */
				                "9379",  /* User Story */
				                "Changed the join in Fact Referral to use client_id not the dim key"  /* Description */
				            },
				            {
				                "1.0.14", /* Version */
				                #date(2025, 09, 24),  /* Date */
				                "Timi",  /* Changed By */
				                "9379",  /* User Story */
				                "Accepted and Discharged on Same day not showing as active, adding in."  /* Description */
				            },
				            {
				                "1.0.13", /* Version */
				                #date(2025, 07, 03),  /* Date */
				                "Mike G",  /* Changed By */
				                "9379",  /* User Story */
				                "Added exec masking."  /* Description */
				            },
				            {
				                "1.0.12", /* Version */
				                #date(2025, 06, 04),  /* Date */
				                "Timi",  /* Changed By */
				                "9379",  /* User Story */
				                "Added Column for easy switch between referral types"  /* Description */
				            },
				            {
				                "1.0.11", /* Version */
				                #date(2025, 03, 04),  /* Date */
				                "Timi",  /* Changed By */
				                "9379",  /* User Story */
				                "Changed link between for dim_service to Fact_TW_Referral"  /* Description */
				            },
				            {
				                "1.0.10", /* Version */
				                #date(2025, 03, 03),  /* Date */
				                "Timi",  /* Changed By */
				                "9379",  /* User Story */
				                "Changed link between dim_service and dim_client_team"  /* Description */
				            },
				             {
				                "1.0.9", /* Version */
				                #date(2025, 02, 04),  /* Date */
				                "Timi",  /* Changed By */
				                "9620",  /* User Story */
				                "Changed filter on additional access"  /* Description */
				            },
				            {
				                "1.0.8", /* Version */
				                #date(2025, 01, 27),  /* Date */
				                "Mike",  /* Changed By */
				                "8643",  /* User Story */
				                "Added RecordBase RLS model"  /* Description */
				            },
				            {
				                "1.0.7", /* Version */
				                #date(2024, 12, 2),  /* Date */
				                "Timi",  /* Changed By */
				                "8643",  /* User Story */
				                "Changed dim service mapping from joining to dim client team to joining to fact client referral"  /* Description */
				            },
							{
				                "1.0.5", /* Version */
				                #date(2024, 9, 3),  /* Date */
				                "Timi",  /* Changed By */
				                "6787",  /* User Story */
				                "Error in absences - had select top 100 - so have changed it"  /* Description */
				            },
							{
				                "1.0.4", /* Version */
				                #date(2024, 9, 3),  /* Date */
				                "Timi",  /* Changed By */
				                "6787",  /* User Story */
				                "Changing Company Name blank and N/A to Unknown"  /* Description */
				            },
				            {
				                "1.0.3", /* Version */
				                #date(2024, 9, 3),  /* Date */
				                "Timi",  /* Changed By */
				                "6787",  /* User Story */
				                "Adding to TW Fact Referral Absence Data"  /* Description */
				            },
							{
				                "1.0.2", /* Version */
				                #date(2024, 8, 2),  /* Date */
				                "Timi",  /* Changed By */
				                "6787",  /* User Story */
				                "Adding in Dim Age Group"  /* Description */
				            },
							{
				                "1.0.1", /* Version */
				                #date(2024, 7, 5),  /* Date */
				                "Timi",  /* Changed By */
				                "6787",  /* User Story */
				                "Dataset Creation "  /* Description */
				            }
				        }
				    ),
				
				    // Reverse the order of the rows so new entries are at the top
				    ReversedTable = Table.ReverseRows(InitialTable),
				
				    // Add an Index column to generate incremental numbers
				    TableWithIndex = Table.AddIndexColumn(ReversedTable, "Change ID", 1, 1, Int64.Type),
				
				    // Reorder the columns to place ChangeID first
				    ReorderedColumns = Table.ReorderColumns(TableWithIndex, {"Change ID", "Version", "Change Date", "Changed By", "User Story ID", "Description"}),
				    #"Sorted Rows" = Table.Sort(ReorderedColumns,{{"Change ID", Order.Descending}})
				in
				    #"Sorted Rows"
				```

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

