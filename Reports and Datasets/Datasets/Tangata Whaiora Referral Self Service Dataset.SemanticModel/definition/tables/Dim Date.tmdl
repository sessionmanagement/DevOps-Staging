	partition 'Dim Date' = m
		mode: import
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="select #(lf)dim_date_key,#(lf)calendar_date,#(lf)calendar_day_num,#(lf)--calendar_day_name_full,#(lf)--calendar_day_name_short,#(lf)--calendar_day_name_TeReo,#(lf)calendar_day_number_in_year,#(lf)--calendar_day_in_week_num,#(lf)calendar_days_in_month_num,#(lf)calendar_first_day_of_week_date,#(lf)calendar_last_day_of_week_date,#(lf)--calendar_week_num,#(lf)calendar_month_num,#(lf)calendar_month_name_long,#(lf)calendar_month_name_short,#(lf)--calendar_month_name_TeReo,#(lf)calendar_year_month,#(lf)calendar_first_day_of_month_date,#(lf)calendar_last_day_of_month_date,#(lf)calendar_quarter_num,#(lf)calendar_quarter_full,#(lf)--calendar_first_day_of_quarter_date,#(lf)--calendar_last_day_of_quarter_date,#(lf)calendar_year,#(lf)--calendar_first_day_of_year_date,#(lf)--calendar_last_day_of_year_date,#(lf)--financial_first_day_of_year_date,#(lf)--financial_last_day_of_year_date,#(lf)--financial_week_num,#(lf)--financial_first_day_of_week_date,#(lf)--financial_last_day_of_week_date,#(lf)--financial_day_of_week_num,#(lf)financial_month_num,#(lf)financial_first_Day_of_month_date,#(lf)financial_last_day_of_month_date,#(lf)financial_quarter_num,#(lf)financial_quarter_full,#(lf)financial_first_day_of_quarter_date,#(lf)financial_last_day_of_quarter_date,#(lf)financial_year_num,#(lf)financial_year_desc,#(lf)financial_year_month,#(lf)--national_holiday_description,#(lf)--national_holiday_flag,#(lf)--regional_holiday_description,#(lf)--regional_holiday_flag,#(lf)--is_holiday_flag,#(lf)calendar_first_day_of_month_flag,#(lf)calendar_last_day_of_month_flag,#(lf)--weekend_flag,#(lf)--weekday_flag,#(lf)--calendar_trading_day_flag,#(lf)current_date_flag,#(lf)current_month_flag,#(lf)current_calendar_year_flag,#(lf)current_month_to_date_flag,#(lf)current_calendar_year_to_date_flag,#(lf)current_financial_year_flag,#(lf)current_financial_year_to_date_flag,#(lf)previous_year_date_flag,#(lf)previous_year_month_flag,#(lf)previous_calendar_year_flag,#(lf)previous_year_month_to_date_flag,#(lf)previous_calendar_year_to_date_flag,#(lf)previous_financial_year_flag,#(lf)previous_financial_year_to_date_flag,#(lf)--current_calendar_trading_days_in_month,#(lf)--current_calendar_trading_days_in_month_ytd,#(lf)--current_calendar_trading_days_left_in_month,#(lf)current_date_rolling_year_offset,#(lf)current_date_rolling_month_offset,#(lf)current_date_rolling_day_offset,#(lf)#(lf)current_date_rolling_financial_month_offset,#(lf)current_date_rolling_financial_year_offset,#(lf)current_financial_year_quarter_offset as current_financial_year_quarter_offset_dimdate,#(lf)#(lf)#(lf)#(lf)    CAST(financial_year_num AS int) -#(lf)        (SELECT MAX(CAST(financial_year_num AS int))#(lf)         FROM edw.dim_date#(lf)         WHERE calendar_date >= '2022-07-01'#(lf)           AND calendar_date <= DATEADD(day, +1, GETDATE())#(lf)           AND dwhdmloperation <> 'd') AS current_financial_year_offset,#(lf)              DATEDIFF(#(lf)        QUARTER,#(lf)        (SELECT MIN(calendar_date) FROM [edw].[dim_date] WHERE current_financial_year_flag = 1 AND financial_quarter_num = (SELECT financial_quarter_num FROM [edw].[dim_date] WHERE current_financial_year_flag = 1 AND current_date_flag = 1)),#(lf)        calendar_date#(lf)    ) as current_financial_year_quarter_offset#(lf)#(lf)from edw.dim_date#(lf)where calendar_date between '2022-07-01' and dateadd(day,1,getdate())#(lf)#(lf)#(lf)#(lf)"]),
				    edw_dim_date = Source,
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            capitaliseWords = Text.Proper(replaceUnderscore),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY")
				        in
				            capitaliseKEY,
				    #"Transformed Column Names" = Table.TransformColumnNames(edw_dim_date, each ApplyNamingConventions(_))
				in
				    #"Transformed Column Names"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

