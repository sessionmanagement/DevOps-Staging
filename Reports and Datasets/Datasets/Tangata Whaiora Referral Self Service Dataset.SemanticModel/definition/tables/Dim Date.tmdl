table 'Dim Date'
	lineageTag: 2a482973-710f-4441-8451-e9b821e4d38f
	dataCategory: Time

	measure FinancialMonthDisplay = ```
			
			VAR FinMonthNum = calculate(max('Dim Date'[Financial Month Num]))
			VAR MonthName = FORMAT(DATE(2000, FinMonthNum + 6, 1), "MMM") 
			RETURN
			FinMonthNum & " - " & MonthName
			```
		displayFolder: Date Measure
		lineageTag: 3f02634f-1c7a-44f0-a49d-17904342d3cb

		changedProperty = IsHidden

	measure '__Reporting Month' = ```
			
			var startingpoint =
			calculate(max('Dim Date'[Calendar First Day Of Month Date]),'Dim Date'[Current Date Rolling Month Offset] = -1)
			var textmonth = 
			CONCATENATE(Format(startingpoint,"MMM")," ")
			RETURN
			concatenate(textmonth,year(startingpoint))
			```
		formatString: mmmm yyyy
		displayFolder: Date Measure
		lineageTag: eac96532-681e-4940-aa1f-9cb0423942e8

		changedProperty = IsHidden

	measure '__Reporting Month LY' = ```
			
			var startingpoint =
			calculate(max('Dim Date'[Calendar First Day Of Month Date]),'Dim Date'[Current Date Rolling Month Offset] = -13)
			var textmonth = 
			CONCATENATE(Format(startingpoint,"MMM")," ")
			RETURN
			concatenate(textmonth,year(startingpoint))
			```
		formatString: mmmm yyyy
		displayFolder: Date Measure
		lineageTag: 9aac24b0-f04f-40d6-a277-52038749dadc

		changedProperty = IsHidden

