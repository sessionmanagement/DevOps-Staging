roup = 'Residual Categories' then 'Unknown'#(lf)when dim_client_current.client_ethnicity_group is null then 'Unknown'#(lf)else 'Known'#(lf)end as Unknown_flag_current,#(lf)case #(lf)when dim_client_current.client_ethnicity_group = 'Asian' then 'Asian'#(lf)when dim_client_current.primary_ethnicity in #(lf)('Asian nfd'#(lf),'Chinese'#(lf),'Chinese nfd'#(lf),'Fijian'#(lf),'Filipino'#(lf),'Indian'#(lf),'Japanese'#(lf),'Khmer/Kampuchean/Cambodian'#(lf),'Korean'#(lf),'Other Asian'#(lf),'Other Southeast Asian'#(lf),'Southeast Asian'#(lf),'Southeast Asian NFD'#(lf),'Southeast Asian nec'#(lf),'Sri Lankan'#(lf),'Vietnamese'#(lf),'Cambodian'#(lf),'Asian nec'#(lf),'Sri Lankan nfd'#(lf),'Indian nfd'#(lf)#(lf)) then 'Asian'#(lf)when dim_client_current.client_secondary_ethnicity in (#(lf)'Asian nfd'#(lf),'Chinese'#(lf),'Chinese nfd'#(lf),'Fijian'#(lf),'Filipino'#(lf),'Indian'#(lf),'Japanese'#(lf),'Khmer/Kampuchean/Cambodian'#(lf),'Korean'#(lf),'Other Asian'#(lf),'Other Southeast Asian'#(lf),'Southeast Asian'#(lf),'Southeast Asian NFD'#(lf),'Southeast Asian nec'#(lf),'Sri Lankan'#(lf),'Vietnamese'#(lf),'Cambodian'#(lf),'Asian nec'#(lf),'Sri Lankan nfd'#(lf),'Indian nfd'#(lf)) then 'Asian'#(lf)when dim_client_current.client_tertiary_ethnicity in (#(lf)'Asian nfd'#(lf),'Chinese'#(lf),'Chinese nfd'#(lf),'Fijian'#(lf),'Filipino'#(lf),'Indian'#(lf),'Japanese'#(lf),'Khmer/Kampuchean/Cambodian'#(lf),'Korean'#(lf),'Other Asian'#(lf),'Other Southeast Asian'#(lf),'Southeast Asian'#(lf),'Southeast Asian NFD'#(lf),'Southeast Asian nec'#(lf),'Sri Lankan'#(lf),'Vietnamese'#(lf),'Cambodian'#(lf),'Asian nec'#(lf),'Sri Lankan nfd'#(lf),'Indian nfd'#(lf)) then 'Asian'#(lf)else 'Non Asian'#(lf)end as Asian_Flag_current,#(lf)#(lf)case when dim_client_current.client_primary_ethnicity in (#(lf)'European nfd',#(lf)'German',#(lf)'Dutch',#(lf)'European',#(lf)'Greek',#(lf)'European nec',#(lf)'Australian',#(lf)'New Zealand European',#(lf)'British nfd',#(lf)'Polish',#(lf)'Italian',#(lf)'South Slav nfd'#(lf),'British and Irish'#(lf),'European nfd'#(lf),'Other European'#(lf),'Greek (including Greek Cypriot)'#(lf),'Other European NFD'#(lf),'South Slav (formerly Yugoslav)'#(lf)) or dim_client_current.client_primary_ethnicity like 'new zealand european%'#(lf)#(lf)then 'European'#(lf) when dim_client_current.client_secondary_ethnicity in (#(lf)'European nfd',#(lf)'German',#(lf)'Dutch',#(lf)'European',#(lf)'Greek',#(lf)'European nec',#(lf)'Australian',#(lf)'New Zealand European',#(lf)'British nfd',#(lf)'Polish',#(lf)'Italian',#(lf)'South Slav nfd'#(lf),'British and Irish'#(lf),'European nfd'#(lf),'Other European'#(lf),'Greek (including Greek Cypriot)'#(lf),'Other European NFD'#(lf),'South Slav (formerly Yugoslav)'#(lf))#(lf)or dim_client_current.client_secondary_ethnicity like 'new zealand european%'#(lf)then 'European'#(lf)when dim_client_current.client_tertiary_ethnicity in (#(lf)'European nfd',#(lf)'German',#(lf)'Dutch',#(lf)'European',#(lf)'Greek',#(lf)'European nec',#(lf)'Australian',#(lf)'New Zealand European',#(lf)'British nfd',#(lf)'Polish',#(lf)'Italian',#(lf)'South Slav nfd'#(lf),'British and Irish'#(lf),'European nfd'#(lf),'Other European'#(lf),'Greek (including Greek Cypriot)'#(lf),'Other European NFD'#(lf),'South Slav (formerly Yugoslav)'#(lf))#(lf)or dim_client_current.client_tertiary_ethnicity like 'new zealand european%'#(lf)#(lf)then 'European'#(lf)else 'Non European'#(lf)end #(lf)as European_Current_flag#(lf)from edw.vw_dim_client#(lf)left join edw.vw_dim_client as dim_client_current #(lf)on vw_dim_client.dim_client_unique_key = dim_client_current.dim_client_unique_key#(lf)and dim_client_current.DWHIsCurrent = 1 and dim_client_current.DWHDMLOperation <> 'd'#(lf)and vw_dim_client.DWHDMLOperation <> 'd'#(lf)#(lf)where vw_dim_client.DWHDMLOperation <> 'd'#(lf)#(lf)#(lf)"]),
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, each ApplyNamingConventions(_)),
				    #"Changed Type2" = Table.TransformColumnTypes(#"Transformed Column Names", {"Tangata Whaiora ID", type text}),
