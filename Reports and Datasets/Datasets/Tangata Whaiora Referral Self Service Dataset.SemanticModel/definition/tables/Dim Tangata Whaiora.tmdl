	partition 'Dim Tangata Whaiora' = m
		mode: import
		queryGroup: 'Dim Tables'
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="select#(lf)#(lf)vw_dim_client.dim_client_key,#(lf)vw_dim_client.company_id,#(lf)vw_dim_client.dim_client_unique_key,#(lf)vw_dim_client.client_id,#(lf)vw_dim_client.client_display_name,#(lf)left(vw_dim_client.client_first_name,1)+left(isnull(vw_dim_client.client_middle_name,' '),1)+left(vw_dim_client.client_last_name,1) as client_initials,#(lf)--vw_dim_client.client_primary_iwi,#(lf)--vw_dim_client.client_primary_region,#(lf)--vw_dim_client.client_primary_waka_iwi_unknown_flag,#(lf)vw_dim_client.client_primary_ethnicity,#(lf)--vw_dim_client.client_secondary_iwi,#(lf)--vw_dim_client.client_secondary_region,#(lf)--vw_dim_client.client_secondary_waka_iwi_unknown_flag,#(lf)vw_dim_client.client_secondary_ethnicity,#(lf)--vw_dim_client.client_tertiary_iwi,#(lf)--vw_dim_client.client_tertiary_region,#(lf)--vw_dim_client.client_tertiary_waka_iwi_unknown_flag,#(lf)vw_dim_client.client_tertiary_ethnicity,#(lf)vw_dim_client.client_maori_flag,#(lf)vw_dim_client.client_pasifika_flag,#(lf)--vw_dim_client.client_ethnicity_group_missing_flag,#(lf)vw_dim_client.client_ethnicity_group,#(lf)vw_dim_client.client_gender,#(lf)vw_dim_client.client_age_years,#(lf)--vw_dim_client.client_smoking_status,#(lf)--vw_dim_client.client_smoking_cigarettes_per_day,#(lf)--vw_dim_client.client_smoking_assessment_date,#(lf)--vw_dim_client.client_legal_status_missing_flag,#(lf)--vw_dim_client.client_legal_status,#(lf)--vw_dim_client.client_mental_health_condition_missing_flag,#(lf)--vw_dim_client.client_mental_health_condition,#(lf)--vw_dim_client.client_physical_condition_missing_flag,#(lf)--vw_dim_client.client_physical_condition,#(lf)--vw_dim_client.client_substance_condition_missing_flag,#(lf)--vw_dim_client.client_substance_condition,#(lf)--vw_dim_client.client_smoking_status_missing_flag,#(lf)--vw_dim_client.client_smoking_advice_flag,#(lf)--vw_dim_client.client_smoking_ces