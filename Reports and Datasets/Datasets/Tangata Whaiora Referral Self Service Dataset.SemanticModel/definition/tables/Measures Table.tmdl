	measure 'Missing Percent (All)' =
			
			(
			    SUM ( 'Ref Tangata Whaiora Latest Flags'[Addition of Missing] ) / ( [Number of Tangata Whaiora] * 14 )
			)
		displayFolder: MORe Measures
		lineageTag: a877cd4b-d366-4f22-b644-a08e15d1d66e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Non Missing Percent (All)' =
			
			DIVIDE (
			    SUM ( 'Ref Tangata Whaiora Latest Flags'[Addition Of Non Missing] ),
			    SUM ( 'Ref Tangata Whaiora Latest Flags'[Addition Of Missing] )
			        + SUM ( 'Ref Tangata Whaiora Latest Flags'[Addition Of Non Missing] ),
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: MORe Measures
		lineageTag: 2d222ef0-e61f-4031-a09f-301320b87c78

	measure 'Non Missing Percent Address' =
			
			IF (
			    ISBLANK (
			        SUM ( 'Ref Tangata Whaiora Latest Flags'[Tangata Whaiora Address Missing Flag] )
			    ),
			    BLANK (),
			    1
			        - SUM ( 'Ref Tangata Whaiora Latest Flags'[Tangata Whaiora Address Missing Flag] ) / [Number of Tangata Whaiora]
			)
