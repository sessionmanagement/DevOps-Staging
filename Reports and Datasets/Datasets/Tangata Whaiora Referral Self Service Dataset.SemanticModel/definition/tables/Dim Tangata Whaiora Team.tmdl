	partition 'Dim Tangata Whaiora Team' = m
		mode: import
		queryGroup: 'Dim Tables'
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="select #(lf)service_id,  --Service ID#(lf)client_team_id, --Tangata Whaiora Team ID#(lf)client_team_name , --Tangata Whaiora Team Name#(lf)client_team_description, --Tangata Whaiora Team Description#(lf)client_team_function, --Tangata Whaiora Team Function#(lf)client_team_is_accommodation_based, --Tangata Whaiora Team Is Accommodation Based#(lf)dim_client_team_start_date, --Dim Tangata Whaiora Team Start Date#(lf)dim_client_team_end_date, --Dim Tangata Whaiora Team End Date#(lf)client_team_bed_number, --Tangata Whaiora Team Bed Number#(lf)#(lf)--Tangata Whaiora Team Is Allocated Support#(lf)--Tangata Whaiora Team Is Employment Team#(lf)#(lf)client_team_status , --Tangata Whaiora Team Status#(lf)#(lf)company_id, --Company ID#(lf)dim_client_team_key, --Dim Tangata Whaiora Team KEY#(lf)dim_service_key, --Dim Service KEY#(lf)dim_client_team_unique_key, --Dim Tangata Whaiora Team Unique KEY#(lf)#(lf)--DWH Batch ID#(lf)--DWH Modified On#(lf)--DWH Created At#(lf)#(lf)case when client_team_primhd_exclusion_flag = 1 then 'True'#(lf)else 'False'#(lf)end as client_team_is_excluded_from_PRIMHD_Reporting ,#(lf)#(lf)--Tangata Whaiora Team Is Excluded From PRIMHD Reporting#(lf)client_team_primhd_exclusion_flag, --Tangata Whaiora Team Primhd Exclusion Flag#(lf)client_team_area, --Tangata Whaiora Team Area#(lf)case #(lf)when client_team_name like 'Pto res clinical%' then 'Keep'#(lf)when client_team_name like '%f/up%' or client_team_name like '%follow up%' then 'Exclude Follow Up Teams'#(lf)when client_team_name like '%non%clinical%' then 'Keep'#(lf)when client_team_name like '%%clinical%' then 'Exclude Clinical Teams'#(lf)when client_team_name like 'thvm referral errors%' then 'Exclude Not real team'#(lf)when client_team_function like '%follow up%' then 'Exclude Team Function is Follow Up'#(lf)else 'Keep'#(lf)end as team_exclusions , --Team Exclusions#(lf)client_team_parent_area, --Tangata Whaiora Team Parent Area#(lf)client_team_grand_parent_area --Tangata Whaiora Team Grand Parent Area#(lf)--,DWHDMLOperation#(lf),dim_client_team_end_date#(lf)#(lf)#(lf)from edw.dim_client_team #(lf)where dwhdmloperation not in ('d','m')#(lf)and (client_team_status not in ('closed')#(lf)or dim_client_team_end_date >= '2022-07-01')#(lf)#(lf)#(lf)#(lf)"]),
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, each ApplyNamingConventions(_)),
				    #"Changed Type" = Table.TransformColumnTypes(#"Transformed Column Names",{"Tangata Whaiora Team Is Accommodation Based", type logical}),
				    #"Sorted Rows" = Table.Sort(#"Changed Type",{{"Tangata Whaiora Team ID", Order.Ascending}})
				in
				    #"Sorted Rows"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

