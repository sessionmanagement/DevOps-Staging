	measure __BedDaysperMonthCapacity =
			VAR MonthsInContext = VALUES('Dim Date'[Calendar First Day Of Month Date])
			RETURN
			SUMX(
			    MonthsInContext,
			    VAR MonthDays = CALCULATE(MAX('Dim Date'[Calendar Days In Month Num]))
			    VAR MonthBeds =
			        CALCULATE(
			            SUM('Dim Tangata Whaiora Team'[Tangata Whaiora Team Bed Number]),
			            KEEPFILTERS('Dim Date'[Calendar Last Day Of Month Flag] = 1)
			        )
			    RETURN
			        COALESCE(MonthBeds, 0) * COALESCE(MonthDays, 0)
			)
		lineageTag: df42971e-70e9-479f-b62f-43c5e8f27a4e

		changedProperty = IsHidden

