			--(divide([__TotalReferralsAcceptedDuringMonth_CRM],[__TotalReferralsAcceptedDuringMonth_CRM_LY],""))-1
			VAR current_R = [__TotalReferralsActiveDuringMonth_CRM]
			VAR previous = [__TotalReferralsActiveDuringMonth_CRM_LY]
