			calculate(SUM('Fact Tangata Whaiora Referral'[Declined]),'Dim Tangata Whaiora'[European Flag]="European")
		lineageTag: 5174965c-39d7-480f-a926-1bee0290425c

		changedProperty = IsHidden

	measure '%European Decline Overall' = ```
			
			var totalall = 
			CALCULATE([__DeclineEuropean],REMOVEFILTERS('Dim Tangata Whaiora Referral'[Tangata Whaiora Referral Declined Reason (groups)]))
			return
			divide([__DeclineEuropean],totalall)
			```
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: fcf22337-8563-4f69-b869-0ff93b53d476

		changedProperty = IsHidden

	measure __TotalReferralsActive =
			
			/*calculate(DISTINCTCOUNT('Fact Tangata Whaiora Referral'[Tangata Whaiora ID]),'Fact Tangata Whaiora Referral'[Referral Status] = "Accepted",filter('Dim Date','Dim Date'[Current Date Rolling Month Offset]=-1),userelationship('Fact Tangata Whaiora Referral'[Dim Date KEY],'Dim Date'[Dim Date KEY]))*/
			calculate(DISTINCTCOUNT('Fact Tangata Whaiora Referral'[Ref Tangata Whaiora Relationsip KEY]),'Fact Tangata Whaiora Referral'[Referral Status] in {"Accepted","Accepted and Discharged","Discharged"},userelationship('Fact Tangata Whaiora Referral'[Dim Date KEY],'Dim Date'[Dim Date KEY]))
		formatString: #,0
		lineageTag: 4d8f608b-78e4-476e-8697-4bff0bb86196

	measure '__Number of Tangata Whaiora Active' =
			
			calculate(DISTINCTCOUNT('Fact Tangata Whaiora Referral'[Fact Tangata Whaiora Referral Unique KEY]),userelationship('Dim Date'[Dim Date KEY],'Fact Tangata Whaiora Referral'[Dim Date KEY]))
		formatString: 0
		lineageTag: 10a09171-c54a-47db-8efe-93a79eddfceb

	measure __TotalReferrals_Whanau_Involvement =
			
			COALESCE(
			    CALCULATE(
			        DISTINCTCOUNT('Fact Tangata Whaiora Referral'[Ref Tangata Whaiora Relationsip KEY]),
			        'Fact Tangata Whaiora Referral'[Referral Status] IN {
			            "Accepted",
			            "Accepted and Discharged",
			            "Discharged"
			        },
			        'Fact Tangata Whaiora Referral'[Tangata Whaiora Activity Whanau Involvement] = 1,
			        USERELATIONSHIP(
			            'Fact Tangata Whaiora Referral'[Dim Date KEY],
			            'Dim Date'[Dim Date KEY]
			        )
			    ),
			    0
			)
		formatString: 0
		lineageTag: 5925329d-d0de-4ae6-b918-790a0e32240b

	measure '__%Whanau Involvement' = divide([__TotalReferrals_Whanau_Involvement],[__TotalReferralsActive])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e00fb5a4-3dd1-4bf9-b495-4806c1239724

