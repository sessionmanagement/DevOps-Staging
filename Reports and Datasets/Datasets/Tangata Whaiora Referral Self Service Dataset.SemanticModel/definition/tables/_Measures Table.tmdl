table '_Measures Table'
	lineageTag: 9bc1be18-3417-42d5-b2de-ea0b3527404a

	measure 'Tangata Whaiora Display Name (Referral) Masked' =
			
			IF (
			    USERPRINCIPALNAME() IN VALUES('Executinve Masking'[User Principal Name]),
			    "Tangata Whaiora ID: " & FORMAT(SELECTEDVALUE('Dim Tangata Whaiora'[Tangata Whaiora ID]), "0"),
			    SELECTEDVALUE('Dim Tangata Whaiora'[Tangata Whaiora Display Name])
			)
		displayFolder: Data Masking
		lineageTag: 624e5720-7f28-4813-bbd0-1a5348d45bd2

		changedProperty = IsHidden

