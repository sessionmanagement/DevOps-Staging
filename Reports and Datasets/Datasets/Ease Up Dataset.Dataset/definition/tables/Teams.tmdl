	partition Teams-419fd425-1a35-4b43-b600-3dceefbe96a1 = m
		mode: import
		source =
				let
				    Source = Sql.Database("eal-sql01.database.windows.net", "Recordbase_EmergeAotearoa_Elite", [Query="select teamname , teamfunctionname , teamid as team_id,#(lf)case when teamname like '%adhb%' then 'Auckland'#(lf)when teamname like '%wdhb%' then 'Waitemata'#(lf)when teamname like 'easeup%west%' then 'Waitemata'#(lf)when teamname like 'easeup%north%' then 'Waitemata'#(lf)when teamname like '%waikato%' then 'Waikato'#(lf)else 'Other Region'#(lf)end as TeamRegion#(lf)#(lf)from dl.dimteam#(lf)#(lf)inner join dl.DimTeamFunction on dimteam.TeamFunctionID = DimTeamFunction.TeamFunctionID#(lf)where teamname like '%ease%up%'"]),
				    #"Renamed Columns" = Table.RenameColumns(Source,{{"teamname", "Team Name"}})
				in
				    #"Renamed Columns"

