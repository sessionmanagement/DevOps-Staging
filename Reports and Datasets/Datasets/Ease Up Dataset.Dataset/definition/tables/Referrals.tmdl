	measure Discharges = ```
			
			VAR SumDischarges=
			sum(Referrals[Exit (Discharged)])
			return
			divide(sumdischarges,1,0)
			
			```
		formatString: 0
		lineageTag: 0a7f6290-75db-41fd-88a9-085d0c22f6ed

