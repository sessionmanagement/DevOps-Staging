	partition Referrals-271a86cb-5c80-4639-b952-30cf5d96ca5b = m
		mode: import
		source = ```
				let
				    Source = Sql.Database("eal-sql01.database.windows.net", "Recordbase_EmergeAotearoa_Elite", [Query="#(lf)#(lf)if object_id ('tempdb..#test') is not null drop table #test#(lf)if object_id ('tempdb..#testy2') is not null drop table #testy2#(lf)if object_id ('tempdb..#referralbystatus2') is not null drop table #referralbystatus2#(lf)if object_id ('tempdb..#accepts2') is not null drop table #accepts2#(lf)if object_id ('tempdb..#createdpivot') is not null drop table #createdpivot #(lf)if object_id ('tempdb..#lastdata') is not null drop table #lastdata #(lf)if object_id ('tempdb..#ethnicity') is not null drop table #ethnicity #(lf)if object_id ('tempdb..#outbound') is not null drop table #outbound #(lf)if object_id ('tempdb..#ALMOSTFINAL') is not null drop table #ALMOSTFINAL #(lf)if object_id ('tempdb..#FINAL') is not null drop table #FINAL #(lf)if object_id ('tempdb..#grouponly') is not null drop table #grouponly#(lf)if object_id ('tempdb..#grouponly1') is not null drop table #grouponly1#(lf)if object_id ('tempdb..#grouponly0') is not null drop table #grouponly0#(lf)if object_id ('tempdb..#maxseen') is not null drop table #maxseen #(lf)if object_id ('tempdb..#seenwithgroup') is not null drop table #seenwithgroup  #(lf)if object_id ('tempdb..#finalfinal') is not null drop table #finalfinal#(lf)#(lf)SELECT factreferralstatus.ReferralID#(lf), referralstatusstartdate#(lf),referralstatustypecode#(lf), referralstatustypegroup#(lf), referralstatustypestatusorder#(lf), factreferral.personid#(lf), ReferralReceivedDate#(lf), dimteam.TeamID#(lf), teamname #(lf), personfirstname#(lf), personlastname #(lf), PersonDateOfBirth#(lf), EthnicityText#(lf), EthnicityParentId#(lf), ReferralStatusTypeReasonDescription#(lf), ReferrerDescription#(lf), ReferrerName#(lf),datediff(day,persondateofbirth, referralstatusstartdate)/365.0 as age_start#(lf)into #test#(lf)  FROM [dl].[FactReferralStatus]#(lf)  inner join dl.DimReferralStatusType on FactReferralStatus.ReferralStatusTypeID = DimReferralStatusType.ReferralStatusTypeID#(lf)  inner join dl.factreferral on FactReferralStatus.referralid = factreferral.referralid#(lf)  inner join dl.DimPerson on factreferral.PersonID = dimperson.personid#(lf)  inner join dl.dimteam on factreferral.teamid = dimteam.teamid#(lf)  inner join dl.DimTeamFunction on dimteam.TeamFunctionID = dimteamfunction.TeamFunctionID#(lf)  inner join dl.dimethnicity on dimperson.ethnicity1id = dimethnicity.EthnicityID#(lf)  left join dl.DimReferralStatusTypeReason on FactReferralStatus.ReferralStatusTypeReasonID = DimReferralStatusTypeReason.ReferralStatusTypeReasonID#(lf)  left join dl.dimreferrer on FactReferral.SourceReferrerID = DimReferrer.ReferrerID#(lf)  where   teamname like '%ease%up%'and ReferralStatusStartDate >'2019-06-30'#(lf)  order by ReferralStatusStartDate#(lf)#(lf)  select *, floor(age_start) as ageatreferralstart #(lf)  into #referralbystatus2#(lf)  from #test#(lf)#(lf)  select #(lf)  row_number () over (partition by personid order by personid, referralstatustypegroup, referralstatusstartdate desc) as referralno,#(lf)    *#(lf)  into #accepts2#(lf)  from #referralbystatus2#(lf)  where referralstatustypecode = 'accepted'#(lf)  #(lf)  select#(lf)#(tab)personid,#(lf)#(tab)[1],#(lf)#(tab)[2],#(lf)#(tab)[3],#(lf)#(tab)[4],#(lf)#(tab)[5],#(lf)#(tab)datediff(month,[2],[1]) as diff2and1,#(lf)#(tab)datediff(month,[3],[2]) as diff3and2,#(lf)#(tab)datediff(month,[4],[3]) as diff4and3,#(lf)#(tab)datediff(month,[5],[4]) as diff5and4#(lf)into #createdpivot#(lf)from#(lf)(select personid , referralno, referralstatusstartdate#(lf)from #accepts2 #(lf)) as data1#(lf)pivot(max(referralstatusstartdate) for #(lf)referralno in #(lf)([1],#(lf)[2],#(lf)[3],#(lf)[4],#(lf)[5]#(lf)))as pvt #(lf)order by personid #(lf)#(lf)--===only has 1 referral - all good, take this referral#(lf)select personid , [1] as createddate #(lf)into #testy2#(lf)from #createdpivot #(lf)where [2] is null #(lf)#(lf)union all#(lf)#(lf)--===where there is a second referral only#(lf)select personid, [1] from #createdpivot #(lf)where [2] is not null and diff2and1 >3 and [3] is null#(lf)union all#(lf)select personid, [2] from #createdpivot #(lf)where [2] is not null and diff2and1 >3 and [3] is null#(lf)--so first referral is over 11 months of second referral so both are ok so take both#(lf)#(lf)--=====first is within 11 months of second referral - take second referral only#(lf)#(lf)union all#(lf)select personid, [2] from #createdpivot #(lf)where [2] is not null and diff2and1 <=3 and [3] is null#(lf)--===================================#(lf)--===where there is a 3rd referral#(lf)-- if all referrals are more than 11 months then keep all 3 referrals#(lf)union all#(lf)select personid, [3] from #createdpivot#(lf)where [3] is not null and [4] is null and diff3and2 >3 and diff2and1 >3 #(lf)union all#(lf)select personid, [2] from #createdpivot#(lf)where [3] is not null and [4] is null and diff3and2 >3 and diff2and1 >3#(lf)union all#(lf)select personid, [1] from #createdpivot#(lf)where [3] is not null and [4] is null and diff3and2 >3 and diff2and1 >3 #(lf)--======#(lf)union all#(lf)select personid, [3] from #createdpivot#(lf)where [3] is not null and [4] is null and diff3and2 >3 and diff2and1 <=3 #(lf)union all#(lf)select personid, [2] from #createdpivot#(lf)where [3] is not null and [4] is null and diff3and2 >3 and diff2and1 <=3#(lf)#(lf)union all#(lf)select personid, [3] from #createdpivot#(lf)where [3] is not null and [4] is null and diff3and2 <=3 and diff2and1 <=3 #(lf)--=================================#(lf)--and where there's a 4th referral.... #(lf)union all#(lf)select personid, [4] from #createdpivot#(lf)where [4] is not null and [5] is  null and diff4and3 >3 and diff3and2 >3 and diff2and1 >3 #(lf)union all#(lf)select personid, [3] from #createdpivot#(lf)where [4] is not null and [5] is null and diff4and3 >3 and diff3and2 >3 and diff2and1 >3#(lf)union all#(lf)select personid, [2] from #createdpivot#(lf)where [4] is not null and [5] is null and diff4and3 >3 and diff3and2 >3 and diff2and1 >3 #(lf)union all#(lf)select personid, [1] from #createdpivot#(lf)where [4] is not null and [5] is null and diff4and3 >3 and diff3and2 >3 and diff2and1 >3#(lf)--=========================#(lf)union all#(lf)select personid, [4] from #createdpivot#(lf)where [4] is not null and [5] is null  and diff4and3 >3 and diff3and2 >3 and diff2and1<=3#(lf)union all#(lf)select personid, [3] from #createdpivot#(lf)where [4] is not null and [5] is null  and diff4and3 >3 and diff3and2 >3 and diff2and1<=3#(lf)union all#(lf)select personid, [2] from #createdpivot#(lf)where [4] is not null and [5] is null  and diff4and3 >3 and diff3and2 >3 and diff2and1<=3#(lf)--======#(lf)union all#(lf)select personid, [4] from #createdpivot#(lf)where [4] is not null and [5] is null  and diff4and3 >3 and diff3and2 <=3 and diff2and1<=3#(lf)union all#(lf)select personid, [3] from #createdpivot#(lf)where [4] is not null and [5] is null  and diff4and3 >3 and diff3and2 <=3 and diff2and1<=3#(lf)--======#(lf)union all#(lf)select personid, [4] from #createdpivot#(lf)where [4] is not null and [5] is null  and diff4and3 <=3 and diff3and2 <=3 and diff2and1<=3#(lf)---====and god forbid, someone has 5 referrals #(lf)union all#(lf)select personid, [5] from #createdpivot#(lf)where [4] is not null and [5] is  not null and diff5and4 >3 and diff4and3 >3 and diff3and2 >3 and diff2and1 >3 #(lf)union all#(lf)select personid, [4] from #createdpivot#(lf)where [4] is not null and [5] is not null and diff5and4 >3 and diff4and3 >3  and diff3and2 >3 and diff2and1 >3#(lf)union all#(lf)select personid, [3] from #createdpivot#(lf)where [4] is not null and [5] is not null and diff5and4 >3 and diff4and3 >3  and diff3and2 >3 and diff2and1 >3 #(lf)union all#(lf)select personid, [2] from #createdpivot#(lf)where [4] is not null and [5] is not null and diff5and4 >3 and diff4and3 >3 and  diff3and2 >3 and diff2and1 >3#(lf)union all#(lf)select personid, [1] from #createdpivot#(lf)where [4] is not null and [5] is not null and diff5and4 >3  and diff4and3 >3 and diff3and2 >3 and diff2and1 >3#(lf)--=========================#(lf)union all#(lf)select personid, [5] from #createdpivot#(lf)where [4] is not null and [5] is not null  and diff5and4 >3 and diff4and3 >3 and diff3and2 >3 and diff2and1<=3#(lf)union all#(lf)select personid, [4] from #createdpivot#(lf)where [4] is not null and [5] is not null  and diff5and4 >3 and diff4and3 >3 and diff3and2 >3 and diff2and1<=3#(lf)union all#(lf)select personid, [3] from #createdpivot#(lf)where [4] is not null and [5] is not null and diff5and4 >3 and diff4and3 >3 and diff3and2 >3 and diff2and1<=3#(lf)union all#(lf)select personid, [2] from #createdpivot#(lf)where [4] is not null and [5] is not null  and diff5and4 >3 and diff4and3 >3 and diff3and2 >3 and diff2and1<=3#(lf)--====#(lf)union all#(lf)select personid, [5] from #createdpivot#(lf)where [4] is not null and [5] is not null  and diff5and4 >3 and diff4and3 >3 and diff3and2 <=3 and diff2and1<=3#(lf)union all#(lf)select personid, [4] from #createdpivot#(lf)where [4] is not null and [5] is not null  and diff5and4 >3 and diff4and3 >3 and diff3and2 <=3 and diff2and1<=3#(lf)union all#(lf)select personid, [3] from #createdpivot#(lf)where [4] is not null and [5] is not null and diff5and4 >3 and diff4and3 >3 and diff3and2 <=3 and diff2and1<=3#(lf)--======#(lf)union all#(lf)select personid, [5] from #createdpivot#(lf)where [4] is not null and [5] is not null  and diff5and4 >3 and diff4and3 <=3 and diff3and2 <=3 and diff2and1<=3#(lf)union all#(lf)select personid, [4] from #createdpivot#(lf)where [4] is not null and [5] is not null  and diff5and4 >3 and diff4and3 <=3 and diff3and2 <=3 and diff2and1<=3#(lf)--=====#(lf)union all#(lf)select personid, [5] from #createdpivot#(lf)where [5] is not null and [5] is not null  and diff5and4 <=3 and diff4and3 <=3 and diff3and2 <=3 and diff2and1<=3#(lf)order by 1,2 desc#(lf)--======#(lf)#(lf)SELECT #(lf)#(tab)factreferral.ID as referralid#(lf)#(tab),receiveddate as referralstatusstartdate#(lf)#(tab),'' as referralstatustypecode#(lf)#(tab), '' as referralstatustypegroup#(lf)#(tab), '' as referralstatustypestatusorder#(lf)#(tab),factreferral.personid#(lf)#(tab), ReceivedDate#(lf)#(tab), team2.TeamID#(lf)#(tab), team2.teamname #(lf)#(tab), personfirstname#(lf)#(tab), personlastname #(lf)#(tab), PersonDateOfBirth#(lf)#(tab), EthnicityText#(lf)#(tab), EthnicityParentId#(lf)#(tab), ReferrerDescription#(lf)#(tab), ReferrerName#(lf)#(tab), 'Outbound Referral' as ReferralStatusTypeReasonDescription#(lf)#(tab),datediff(day,persondateofbirth, receiveddate)/365.0 as age_start#(lf)into #outbound#(lf)  FROM legacy.factreferral#(lf)  inner join dl.DimPerson on factreferral.PersonID = dimperson.personid#(lf)  left join dl.dimteam on factreferral.teamid = dimteam.teamid#(lf)  left join  dl.factreferral as ref2 on factreferral.sourcereferralid = ref2.referralid#(lf)  left join dl.dimteam as team2 on ref2.teamid = team2.teamid#(lf)  inner join dl.dimethnicity on dimperson.ethnicity1id = dimethnicity.EthnicityID#(lf)  left join dl.DimReferrer on factreferral.SourceReferrerID = dimreferrer.ReferrerID#(lf)  where team2.teamname like 'ease%' and factreferral.teamid is null and year(receiveddate) > 2018#(lf)  order by ReferralStatusStartDate#(lf)#(lf)SELECT #(lf)'Seen this Month' as datatype,#(lf)case when  createddate is not null then 1#(lf)else 0#(lf)end as seen_count,#(lf)0 as discharged_count,#(lf)0 as outbound_count,#(lf)#(lf)#accepts2.*,#(lf)case when createddate is null then 'Seen in the last 3 months'#(lf)else 'Accept not Seen last 3 months'#(lf)end as seenstatus #(lf)into #lastdata#(lf)from #accepts2#(lf)left join #testy2 on #accepts2.personid = #testy2.personid and #accepts2.ReferralStatusStartDate = #testy2.createddate#(lf)#(lf)union all#(lf)#(lf)select#(lf)--top 4 #(lf)'Discharged this month', #(lf)0 as seen_count,#(lf)1 as discharged_count,#(lf)0 as outbound_count,#(lf)'' as referralno,#(lf)*, #(lf)floor(age_start) as ageatreferralstart,#(lf)'' as seenstatus from #test#(lf)where ReferralStatusTypeCode = 'Discharged'#(lf)#(lf)union all#(lf)select#(lf)--top 4 #(lf)'Declined this month', #(lf)0 as seen_count,#(lf)1 as discharged_count,#(lf)0 as outbound_count,#(lf)'' as referralno,#(lf)*, #(lf)floor(age_start) as ageatreferralstart,#(lf)'' as seenstatus #(lf)#(lf)from #test#(lf) #(lf)where ReferralStatusTypeCode = 'declined'#(lf)--and ReferralStatusStartDate between '2022-04-01' and '2022-04-30'#(lf)#(lf)union all#(lf)select#(lf)'OutBound Referral', #(lf)0 as seen_count,#(lf)0 as discharged_count,#(lf)1 as outbound_count,#(lf)'' as referralno,#(lf)*, #(lf)floor(age_start) as ageatreferralstart,#(lf)'' as seenstatus #(lf)from #outbound#(lf)#(lf)order by teamname#(lf)#(lf)#(lf)select distinct Ethnicityid, ethnicitytext , ETHNICITYVALUE#(lf)into #ethnicity#(lf)from dl.dimethnicity #(lf)#(lf)#(lf)#(lf)select#(lf)datatype#(lf),seen_count#(lf),discharged_count#(lf),outbound_count#(lf),referralno#(lf),ReferralID#(lf),referralstatusstartdate#(lf),referralstatustypecode#(lf),referralstatustypegroup#(lf),referralstatustypestatusorder#(lf),personid#(lf),ReferralReceivedDate#(lf),teamid#(lf),teamname#(lf),personfirstname#(lf),personlastname#(lf),PersonDateOfBirth#(lf),ReferralStatusTypeReasonDescription#(lf),age_start#(lf),ageatreferralstart#(lf),seenstatus#(lf), ReferrerDescription#(lf), ReferrerName#(lf)#(lf),case when teamname like '%adhb%' then 'Auckland'#(lf)when teamname like '%Wdhb%' then 'Waitemata'#(lf)when teamname like '%waikato%' then 'Waikato'#(lf)else 'Other Region'#(lf)end as TeamRegion#(lf)#(lf),cast (referralstatusstartdate as date) as referraldatepure#(lf),case when datatype = 'Seen this Month' then 'Accepted'#(lf)when datatype = 'Declined this month' then 'Declined'#(lf)else 'Discharged'#(lf)end as referraltype,#(lf)#(lf)case when #ethnicity.ethnicitytext is null then #lastdata.EthnicityTExt#(lf)when #lastdata.EthnicityText = 'Don''t know' then #Ethnicity.EthnicityText#