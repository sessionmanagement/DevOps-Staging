				    Source = Sql.Database("eal-sql01.database.windows.net", "Recordbase_EmergeAotearoa_Elite", [Query="if object_id ('tempdb..#activity') is not null drop table #activity#(lf)if object_id ('tempdb..#ethnicity') is not null drop table #ethnicity#(lf)if object_id ('tempdb..#activity2') is not null drop table #activity2#(lf)if object_id ('tempdb..#firstcount') is not null drop table #firstcount#(lf)if object_id ('tempdb..#groups') is not null drop table #groups#(lf)if object_id ('tempdb..#finaldata') is not null drop table #finaldata#(lf)if object_id ('tempdb..#groupsgrouped') is not null drop table #groupsgrouped#(lf)if object_id ('tempdb..#finaldata2') is not null drop table #finaldata2#(lf)if object_id ('tempdb..#finalgroupstatus') is not null drop table #finalgroupstatus#(lf)#(lf)select #(lf)factactivity.activityid,#(lf)activitystartdate,#(lf)activityenddate, #(lf)activitycreateddate,#(lf)activitysubject,#(lf)groupactivitycreateddate,#(lf)teamname,#(lf)dimperson.PersonID,#(lf)case when teamname like '%wdhb%' then 'Waitemata'#(lf) when teamname like '%west%' then 'Waitemata'#(lf)  when teamname like '%north%' then 'Waitemata'#(lf)when teamname like '%adhb%' then 'Auckland'#(lf)when teamname like '%waikato%' then 'Waikato'#(lf)else 'Undefined'#(lf)end as region ,#(lf)dimuser.userfirstname,#(lf)dimuser.userlastname,#(lf)user2.userfirstname as reportstofirstname,#(lf)user2.userlastname as reportstosurname#(lf)#(lf)into #groups#(lf)#(lf) from dl.factactivity#(lf)INNER JOIN dl.DimTeam#(tab)#(tab)#(tab)#(tab)#(tab)  ON FactActivity.TeamID = DimTeam.TeamID#(lf)inner join dl.factgroupactivity on factactivity.groupactivityid = factgroupactivity.groupactivityid#(lf)INNER JOIN dl.FactActivityParticipant   ON FactActivity.ActivityID                   = FactActivityParticipant.ActivityID#(lf)INNER JOIN dl.DimPerson#(tab)#(tab)#(tab)#(tab)  ON FactActivityParticipant.EntityID = DimPerson.PersonID#(lf)inner join dl.dimuser on FactActivity.ActivityCreatedUserID = dimuser.userid#(lf)inner join dl.dimuser user2 on dimuser.ReportsToUserID = user2.userid#(lf)#(lf)where --year(activitystartdate) = 2021 and month(activitystartdate) = 9#(lf) teamname like '%ease%'#(lf)  order by activitystartdate, teamname#(lf)#(lf)#(lf) select #(lf) activitystartdate,  count(personid) as number_attendees#(lf) into #groupsgrouped#(lf) from #groups #(lf) group by activitystartdate#(lf)#(lf) order by activitystartdate#(lf)#(lf)-- select #(lf)--*,#(lf)-- case when number_attendees =1 then 'Only 1 attendee'#(lf)-- when number_attendees between 2 and 14 then '2-14 Attendees'#(lf)-- when number_ATTENDEES >14 then '15 or More'#(lf)-- else 'Unknown'#(lf)-- end as group_status #(lf)#(lf)-- from #groupsgrouped#(lf)#(lf)  select#(lf)  row_number () over (partition by  #groups.activitystartdate, region order by #groups.activitystartdate, region) as countrows,#(lf)  #groups.activityid,#(lf)  #groups.personid,#(lf)  cast(#groups.activitystartdate as date) as activitystartdatepure,#(lf)  #groups.activitystartdate,#(lf)  #groups.activityenddate,#(lf)  #groups.activitysubject,#(lf)  #groups.teamname,#(lf)  #groups.region,#(lf)  #groups.UserFirstName,#(lf)  #groups.UserLastName,#(lf)  #groups.reportstofirstname,#(lf)  #groups.reportstosurname,#(lf) #(lf) case when number_attendees =1 then 'Only 1 attendee'#(lf) when number_attendees between 2 and 14 then '2-14 Attendees'#(lf) when number_ATTENDEES >14 then '15 or More'#(lf) else 'Unknown'#(lf) end as group_status ,#(lf) case when number_attendees =1 then 'Exclude'#(lf)  else 'Include'#(lf) end as group_inclusion ,#(lf) 1 as group_count#(lf) into #finaldata#(lf)  from #groups#(lf) left join #groupsgrouped on #groups.activitystartdate = #groupsgrouped.activitystartdate#(lf)  order by #groups.activitystartdate#(lf)#(lf)#(lf) select #(lf) case when countrows=1 then 1 #(lf) else 0#(lf) end as sum_sessions,#(lf) activityid,#(lf) personid,#(lf) activitystartdatepure,#(lf) activitystartdate,#(lf) activityenddate,#(lf) activitysubject,#(lf) teamname,#(lf) region,#(lf) group_inclusion,#(lf) group_status,#(lf) userfirstname as usercreatedfirstname,#(lf)userlastname as usercreatedlastname,#(lf)reportstofirstname as reportstofirstname,#(lf)reportstosurname as reportstolastname#(lf)into #finaldata2#(lf) from #finaldata#(lf) order by activitystartdate, region#(lf)#(lf) select#(lf) activityid, personid , group_status, ActivityStartDate#(lf) into #finalgroupstatus#(lf) from #finaldata2#(lf)#(lf)#(lf)#(lf)SELECT  #(lf)#(lf)case when teamname like '%adhb%' then 'Auckland'#(lf)when teamname like '%wdhb%' then  'Waitemata'#(lf) when teamname like '%west%' then 'Waitemata'#(lf)  when teamname like '%north%' then 'Waitemata'#(lf)when teamname like '%waikato%' then 'Waikato'#(lf)else 'Other Region'#(lf)end as EaseUpRegion#(lf),FactActivity.ActivityID#(lf),DimPerson.PersonID#(lf),FactActivityParticipant.ReferralID#(lf),DimPerson.PersonReferenceNumber#(lf),DimPerson.PersonFirstName#(lf),DimPerson.PersonLastName#(lf),DimPerson.PersonDateOfBirth#(lf),DimEthnicity.EthnicityText#(lf),DimEthnicity.EthnicityParentId#(lf),DimGender.GenderText#(lf),Datediff(day,persondateofbirth,ReferralCreatedDate)/365 as ageatreferral#(lf)#(lf),dateadd(day,1,eomonth(activitystartdate,-1)) as activitystartmonth#(lf),FactActivity.ActivityStartDate#(lf),FactActivity.ActivityEndDate#(lf),datediff(minute,FactActivity.ActivityStartDate,FactActivity.ActivityEndDate) as activityduration#(lf),case when datediff(minute,FactActivity.ActivityStartDate,FactActivity.ActivityEndDate) < 10 then 'Under 10 Minutes'#(lf)else '10 Minutes and Over'#(lf)end #(lf)as ActivityMinutes#(lf),FactActivity.ActivitySubject#(lf), DimTeam.TeamID#(lf),DimTeam.TeamName#(lf),DimActivityClassification.ActivityClassificationCode#(lf),case when factactivity.activityid in  (select activityid from #finalgroupstatus --where group_status not in ('15 or more') -- been changed#(lf))#(lf)then 'Individual'#(lf)else DimActivityClassification.ActivityClassificationName#(lf)end as activityclassificationname#(lf),DimActivityType.ActivityTypeName#(lf),DimActivityType.ActivityTypeDescription#(lf), 1 as activity_count#(lf)--,activitybreakdownduration#(lf)--,activitybreakdowntypename#(lf), case #(lf)when FactActivity.activityid in (select activityid from #finalgroupstatus where group_status in ('15 or more')) then 'Include Group'#(lf)when activityclassificationname in ('attempted contact','did not attend','Liaison with Professional','Contact with External Agencies'#(lf),'Same Day Cancellation'#(lf)) then 'Exclude'#(lf)when ActivitySubject like 'attempt%' then 'Exclude'#(lf)when activitysubject like 'phone call attempted%' then 'Exclude'#(lf)when activitysubject like 'dna%' then 'Exclude'#(lf)when activitysubject like 'text convo%sched%check%' then 'Include'#(lf)when activitysubject like '%scheduling%' or activityclassificationname = 'Scheduling' then 'Exclude Scheduling'#(lf)when ActivityTypeName in ('SM Text Messaging') and datediff(minute,FactActivity.ActivityStartDate,FactActivity.ActivityEndDate) >= 10 then 'Include Text'#(lf)when ActivityTypeName in ('SM Text Messaging')  then 'Exclude Text'#(lf)#(lf)when datediff(minute,FactActivity.ActivityStartDate,FactActivity.ActivityEndDate) <10 then 'Exclude Under 10 minutes'#(lf)else 'Include'#(lf)end as session_inclusions,#(lf)activitywhanauinvolvement,#(lf)factactivity.groupactivityid#(lf)into #activity#(lf)#(lf)          FROM       dl.FactActivity             #(lf)#(lf)          INNER JOIN dl.FactActivityParticipant   ON FactActivity.ActivityID                   = FactActivityParticipant.ActivityID#(lf)          INNER JOIN dl.DimActivityType           ON FactActivity.ActivityTypeID               = DimActivityType.ActivityTypeID#(lf)         -- INNER JOIN dl.FactActivityBreakdown     ON FactActivity.ActivityID                   = FactActivityBreakdown.ActivityID#(lf)         -- INNER JOIN dl.DimActivityBreakdownType  ON FactActivityBreakdown.ActivityBreakdownTypeID    = DimActivityBreakdownType.ActivityBreakdownTypeID#(lf)          INNER JOIN dl.DimActivityClassification ON FactActivity.ActivityClassificationID = DimActivityClassification.ActivityClassificationID#(lf)#(tab)#(tab)  INNER JOIN dl.DimTeam#(tab)#(tab)#(tab)#(tab)#(tab)  ON FactActivity.TeamID = DimTeam.TeamID#(lf)#(tab)#(tab)  INNER JOIN dl.FactReferral#(tab)#(tab)#(tab)  ON FactActivityParticipant.ReferralID = FactReferral.ReferralID#(lf)#(tab)#(tab)  INNER JOIN dl.DimPerson#(tab)#(tab)#(tab)#(tab)  ON FactActivityParticipant.EntityID = DimPerson.PersonID#(lf)#(tab)#(tab)  INNER JOIN dl.DimEthnicity#(tab)#(tab)#(tab)  ON DimPerson.Ethnicity1ID = DimEthnicity.EthnicityID -- taking first Ethnicity#(lf)#(tab)#(tab)  INNER JOIN dl.DimGender#(tab)#(tab)#(tab)      ON DimPerson.GenderID = DimGender.GenderID#(lf)#(tab)#(tab)  left join dl.FactGroupActivity on factactivity.ActivityID = FactGroupActivity.GroupActivityID#(lf)#(tab)#(tab)  #(lf)#(lf)#(tab)#(tab)  WHERE     #(lf)#(tab)#(tab)   Teamname like '%Ease%Up%' -- and ActivitySubject = 'Initial Assessment'#(lf)#(tab)#(tab)   and ReferralCreatedDate >'2019-06-30'#(lf)#(lf)#(tab)#(tab)   ORDER by FactActivityParticipant.ReferralID, ActivityStartDate#(lf)#(lf)#(tab)#(tab)   #(tab)#(tab)#(tab) #(lf)select distinct Ethnicityid, ethnicitytext #(lf)into #ethnicity#(lf)from dl.dimethnicity #(lf)#(tab)#(tab)  #(lf)select #(lf)--distinct#(lf)EaseUpRegion,#(lf)ActivityID,#(lf)PersonID,#(lf)Referralid,#(lf)PersonReferenceNumber,#(lf)PersonFirstName,#(lf)PersonLastName,#(lf)PersonDateOfBirth,#(lf)GenderText,#(lf)ageatreferral,#(lf)activitystartmonth,#(lf)ActivityStartDate,#(lf)ActivityEndDate,#(lf)activityduration,#(lf)ActivityMinutes,#(lf)ActivitySubject,#(lf)TeamID,#(lf)TeamName,#(lf)ActivityClassificationCode,#(lf)ActivityClassificationName,#(lf)ActivityTypeName,#(lf)ActivityTypeDescription,#(lf)activity_count,#(lf)session_inclusions,#(lf)#(lf)case when #ethnicity.ethnicitytext is null then #Activity.EthnicityTExt#(lf)when #activity.EthnicityText = 'Don''t know' then #Ethnicity.EthnicityText#(lf)else #activity.EthnicityText#(lf)end as EthnicityText#(lf)--,activitybreakdownduration#(lf)--,activitybreakdowntypename#(lf),case when ActivityWhanauInvolvement is null then 0#(lf)when ActivityWhanauInvolvement = 0 then 0#(lf)else 1#(lf)end#(lf) as activitywhanauinvolvement#(lf)into #activity2#(lf)from #activity#(lf)left join #ethnicity on #activity.EthnicityParentId = #ethnicity.EthnicityID#(lf)order by personid , activitystartdate, session_inclusions desc#(lf)#(lf)--drop table #firstcount #(lf)#(lf)select easeupregion, personid, activitystartmonth, min(activitystartdate) as firstactivitydate#(lf)into #firstcount#(lf)from #activity2#(lf)where session_inclusions not like 'exclud%' --or activityclassificationname like '%group%'#(lf)group by easeupregion, personid, activitystartmonth#(lf)#(lf)#(lf)select #(lf)EaseUpRegion,#(lf)ActivityID,#(lf)PersonID,#(lf)Referralid,#(lf)PersonReferenceNumber,#(lf)PersonFirstName,#(lf)PersonLastName,#(lf)PersonDateOfBirth,#(lf)GenderText,#(lf)ageatreferral,#(lf)activitystartmonth,#(lf)ActivityStartDate,#(lf)ActivityEndDate,#(lf)activityduration,#(lf)ActivityMinutes,#(lf)ActivitySubject,#(lf)TeamID,#(lf)TeamName,#(lf)ActivityClassificationCode,#(lf)ActivityClassificationName,#(lf)ActivityTypeName,#(lf)ActivityTypeDescription,#(lf)activity_count,#(lf)session_inclusions,#(lf)EthnicityText,#(lf) activitywhanauinvolvement,#(lf) case when individualcountpermonth = 0 then 0#(lf) when individualcountpermonth = 1 and inds = 1 then 1#(lf) when individualcountpermonth = 1 and inds >1 then 0#(lf) end as individualcountpermonth,#(lf) Session_group#(lf)#(lf) from (#(lf)SELECT #(lf)ROW_NUMBER () OVER (PARTITION BY EASEUPREGION, PERSONID,ACTIVITYSTARTMONTH, individualcountpermonth ORDER BY EASEUPREGION, PERSONID, ACTIVITYSTARTMONTH,#(lf)individualcountpermonth desc)#(lf)AS Inds,#(lf)* #(lf)from #(lf)(#(lf)select #activity2.*, #(lf)case when #firstcount.personid is not null then 1#(lf)else 0#(lf)end as individualcountpe