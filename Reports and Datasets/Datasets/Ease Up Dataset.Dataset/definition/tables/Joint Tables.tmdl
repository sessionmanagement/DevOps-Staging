	partition 'Joint Tables-2301dcdb-9cff-4d1c-94d3-6050986711c2' = m
		mode: import
		source =
				let
				    Source = Sql.Database("eal-sql01.database.windows.net", "Recordbase_EmergeAotearoa_Elite", [Query="#(lf)if object_id ('tempdb..#test') is not null drop table #test#(lf)if object_id ('tempdb..#testy2') is not null drop table #testy2#(lf)if object_id ('tempdb..#referralbystatus2') is not null drop table #referralbystatus2#(lf)if object_id ('tempdb..#accepts2') is not null drop table #accepts2#(lf)if object_id ('tempdb..#createdpivot') is not null drop table #createdpivot #(lf)if object_id ('tempdb..#lastdata') is not null drop table #lastdata #(lf)if object_id ('tempdb..#lastdata2') is not null drop table #lastdata2#(lf)#(lf)SELECT factreferralstatus.ReferralID#(lf), referralstatusstartdate#(lf), referralstatustypecode#(lf), referralstatustypegroup#(lf), referralstatustypestatusorder#(lf), factreferral.personid#(lf), factreferral.ReferralReceivedDate#(lf), dimTeam.TeamID#(lf), dimTeam.teamname #(lf), dimperson.personfirstname#(lf), dimperson.personlastname #(lf),ReferralStatusTypeReasonDescription#(lf)#(lf)into #test#(lf) #(lf) FROM [dl].[FactReferralStatus]#(lf)#(lf)  inner join dl.DimReferralStatusType on FactReferralStatus.ReferralStatusTypeID = DimReferralStatusType.ReferralStatusTypeID#(lf)  inner join dl.factreferral on FactReferralStatus.referralid = factreferral.referralid#(lf)  inner join dl.DimPerson on factreferral.PersonID = dimperson.personid#(lf)  inner join dl.dimteam on factreferral.teamid = dimteam.teamid#(lf)  inner join dl.DimTeamFunction on dimteam.TeamFunctionID = dimteamfunction.TeamFunctionID#(lf)--  inner join dl.dimethnicity on dimperson.ethnicity1id = dimethnicity.EthnicityID#(lf)  left join dl.DimReferralStatusTypeReason on FactReferralStatus.ReferralStatusTypeReasonID = DimReferralStatusTypeReason.ReferralStatusTypeReasonID#(lf)#(lf)  where #(lf)  teamname like '%ease%up%'#(lf)  and ReferralStatusStartDate >'2019-06-30'#(lf)  #(lf)#(lf)  order by ReferralStatusStartDate#(lf)#(lf)#(lf)#(lf)  select * #(lf)  into #referralbystatus2#(lf)  from #test#(lf)   select #(lf)  row_number () over (partition by personid order by personid, referralstatustypegroup, referralstatusstartdate desc) as referralno,#(lf)   *#(lf)  into #accepts2#(lf)  from #referralbystatus2#(lf)  where referralstatustypecode = 'accepted'#(lf)#(lf)   #(lf)  select#(lf)  personid,#(lf)  [1],#(lf)[2],#(lf)[3],#(lf)[4],#(lf)[5],#(lf)#(lf)datediff(month,[2],[1]) as diff2and1,#(lf)datediff(month,[3],[2]) as diff3and2,#(lf)datediff(month,[4],[3]) as diff4and3,#(lf)datediff(month,[5],[4]) as diff5and4#(lf)#(lf)into #createdpivot#(lf)#(lf)from#(lf)(#(lf)#(lf)  select personid , referralno, referralstatusstartdate#(lf)from #accepts2 #(lf)) as data1#(lf)pivot(max(referralstatusstartdate) for #(lf)referralno in #(lf)(#(lf)[1],#(lf)[2],#(lf)[3],#(lf)[4],#(lf)[5]#(lf))#(lf))as pvt #(lf)#(lf)order by personid #(lf)#(lf)#(lf)--===only has 1 referral - all good, take this referral#(lf)select personid , [1] as createddate #(lf)into #testy2#(lf)from #createdpivot #(lf)where [2] is null #(lf)#(lf)union all#(lf)#(lf)--===where there is a second referral only#(lf)select personid, [1] from #createdpivot #(lf)where [2] is not null and diff2and1 >3 and [3] is null#(lf)union all#(lf)select personid, [2] from #createdpivot #(lf)where [2] is not null and diff2and1 >3 and [3] is null#(lf)--so first referral is over 3 months of second referral so both are ok so take both#(lf)#(lf)--=====first is within 3 months of second referral - take second referral only#(lf)#(lf)union all#(lf)select personid, [2] from #createdpivot #(lf)where [2] is not null and diff2and1 <=3 and [3] is null#(lf)#(lf)#(lf)#(lf)--===================================#(lf)#(lf)--===where there is a 3rd referral#(lf)-- if all referrals are more than 3 months then keep all 3 referrals#(lf)union all#(lf)select personid, [3] from #createdpivot#(lf)where [3] is not null and [4] is null and diff3and2 >3 and diff2and1 >3 #(lf)union all#(lf)select personid, [2] from #createdpivot#(lf)where [3] is not null and [4] is null and diff3and2 >3 and diff2and1 >3#(lf)union all#(lf)select personid, [1] from #createdpivot#(lf)where [3] is not null and [4] is null and diff3and2 >3 and diff2and1 >3 #(lf)#(lf)--======#(lf)union all#(lf)select personid, [3] from #createdpivot#(lf)where [3] is not null and [4] is null and diff3and2 >3 and diff2and1 <=3 #(lf)union all#(lf)select personid, [2] from #createdpivot#(lf)where [3] is not null and [4] is null and diff3and2 >3 and diff2and1 <=3#(lf)#(lf)union all#(lf)select personid, [3] from #createdpivot#(lf)where [3] is not null and [4] is null and diff3and2 <=3 and diff2and1 <=3 #(lf)#(lf)--=================================#(lf)--and where there's a 4th referral.... #(lf)union all#(lf)select personid, [4] from #createdpivot#(lf)where [4] is not null and [5] is  null and diff4and3 >3 and diff3and2 >3 and diff2and1 >3 #(lf)union all#(lf)select personid, [3] from #createdpivot#(lf)where [4] is not null and [5] is null and diff4and3 >3 and diff3and2 >3 and diff2and1 >3#(lf)union all#(lf)select personid, [2] from #createdpivot#(lf)where [4] is not null and [5] is null and diff4and3 >3 and diff3and2 >3 and diff2and1 >3 #(lf)union all#(lf)select personid, [1] from #createdpivot#(lf)where [4] is not null and [5] is null and diff4and3 >3 and diff3and2 >3 and diff2and1 >3#(lf)--=========================#(lf)#(lf)union all#(lf)select personid, [4] from #createdpivot#(lf)where [4] is not null and [5] is null  and diff4and3 >3 and diff3and2 >3 and diff2and1<=3#(lf)union all#(lf)select personid, [3] from #createdpivot#(lf)where [4] is not null and [5] is null  and diff4and3 >3 and diff3and2 >3 and diff2and1<=3#(lf)union all#(lf)select personid, [2] from #createdpivot#(lf)where [4] is not null and [5] is null  and diff4and3 >3 and diff3and2 >3 and diff2and1<=3#(lf)#(lf)--======#(lf)#(lf)union all#(lf)select personid, [4] from #createdpivot#(lf)where [4] is not null and [5] is null  and diff4and3 >3 and diff3and2 <=3 and diff2and1<=3#(lf)union all#(lf)select personid, [3] from #createdpivot#(lf)where [4] is not null and [5] is null  and diff4and3 >3 and diff3and2 <=3 and diff2and1<=3#(lf)#(lf)--======#(lf)union all#(lf)select personid, [4] from #createdpivot#(lf)where [4] is not null and [5] is null  and diff4and3 <=3 and diff3and2 <=3 and diff2and1<=3#(lf)#(lf)---====and god forbid, someone has 5 referrals #(lf)#(lf)union all#(lf)select personid, [5] from #createdpivot#(lf)where [4] is not null and [5] is  not null and diff5and4 >3 and diff4and3 >3 and diff3and2 >3 and diff2and1 >3 #(lf)union all#(lf)select personid, [4] from #createdpivot#(lf)where [4] is not null and [5] is not null and diff5and4 >3 and diff4and3 >3  and diff3and2 >3 and diff2and1 >3#(lf)union all#(lf)select personid, [3] from #createdpivot#(lf)where [4] is not null and [5] is not null and diff5and4 >3 and diff4and3 >3  and diff3and2 >3 and diff2and1 >3 #(lf)union all#(lf)select personid, [2] from #createdpivot#(lf)where [4] is not null and [5] is not null and diff5and4 >3 and diff4and3 >3 and  diff3and2 >3 and diff2and1 >3#(lf)union all#(lf)select personid, [1] from #createdpivot#(lf)where [4] is not null and [5] is not null and diff5and4 >3  and diff4and3 >3 and diff3and2 >3 and diff2and1 >3#(lf)--=========================#(lf)#(lf)union all#(lf)select personid, [5] from #createdpivot#(lf)where [4] is not null and [5] is not null  and diff5and4 >3 and diff4and3 >3 and diff3and2 >3 and diff2and1<=3#(lf)union all#(lf)select personid, [4] from #createdpivot#(lf)where [4] is not null and [5] is not null  and diff5and4 >3 and diff4and3 >3 and diff3and2 >3 and diff2and1<=3#(lf)union all#(lf)select personid, [3] from #createdpivot#(lf)where [4] is not null and [5] is not null and diff5and4 >3 and diff4and3 >3 and diff3and2 >3 and diff2and1<=3#(lf)union all#(lf)select personid, [2] from #createdpivot#(lf)where [4] is not null and [5] is not null  and diff5and4 >3 and diff4and3 >3 and diff3and2 >3 and diff2and1<=3#(lf)--====#(lf)#(lf)#(lf)union all#(lf)select personid, [5] from #createdpivot#(lf)where [4] is not null and [5] is not null  and diff5and4 >3 and diff4and3 >3 and diff3and2 <=3 and diff2and1<=3#(lf)union all#(lf)select personid, [4] from #createdpivot#(lf)where [4] is not null and [5] is not null  and diff5and4 >3 and diff4and3 >3 and diff3and2 <=3 and diff2and1<=3#(lf)union all#(lf)select personid, [3] from #createdpivot#(lf)where [4] is not null and [5] is not null and diff5and4 >3 and diff4and3 >3 and diff3and2 <=3 and diff2and1<=3#(lf)#(lf)--======#(lf)#(lf)union all#(lf)select personid, [5] from #createdpivot#(lf)where [4] is not null and [5] is not null  and diff5and4 >3 and diff4and3 <=3 and diff3and2 <=3 and diff2and1<=3#(lf)union all#(lf)select personid, [4] from #createdpivot#(lf)where [4] is not null and [5] is not null  and diff5and4 >3 and diff4and3 <=3 and diff3and2 <=3 and diff2and1<=3#(lf)--=====#(lf)union all#(lf)select personid, [5] from #createdpivot#(lf)where [5] is not null and [5] is not null  and diff5and4 <=3 and diff4and3 <=3 and diff3and2 <=3 and diff2and1<=3#(lf)#(lf)order by 1,2 desc#(lf)--======#(lf)#(lf)SELECT #(lf)'Seen this Month' as datatype,#(lf)case when  createddate is not null then 1#(lf)else 0#(lf)end as seen_count,#(lf)0 as discharged_count,#(lf)#(lf)#(lf)#accepts2.*,#(lf)case when createddate is null then 'Seen in the last 3 months'#(lf)else 'Accept not Seen'#(lf)end as seenstatus #(lf)into #lastdata#(lf)from #accepts2#(lf)left join #testy2 on #accepts2.personid = #testy2.personid and #accepts2.ReferralStatusStartDate = #testy2.createddate#(lf)#(lf)union all#(lf)#(lf)select#(lf)--top 4 #(lf)'Discharged this month', #(lf)0 as seen_count,#(lf)1 as discharged_count,#(lf)'' as referralno,#(lf)*, #(lf)#(lf)'' as seenstatus from #test#(lf)where ReferralStatusTypeCode = 'Discharged'#(lf)#(lf)union all#(lf)select#(lf)--top 4 #(lf)'Declined this month', #(lf)0 as seen_count,#(lf)1 as discharged_count,#(lf)'' as referralno,#(lf)*, #(lf)#(lf)'' as seenstatus #(lf)#(l