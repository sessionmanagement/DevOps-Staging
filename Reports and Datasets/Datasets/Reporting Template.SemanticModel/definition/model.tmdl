model Model
	culture: en-NZ
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-NZ
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Common Components'

	annotation PBI_QueryGroupOrder = 2

queryGroup 'Primary Datasets'

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Dim Date","_Measures","_Report Components","Server","Database","LastRefreshed","Changelog","Dim Employee","Fact Employee Leave","Dim Business Unit","Dim Gender","Dim Ethnicity","Dim Age Group"]

annotation PBI_ProTooling = ["TMDLView_Desktop","DevMode"]

ref table 'Dim Date'
ref table _Measures
ref table '_Report Components'
ref table LastRefreshed
ref table Changelog
ref table 'Dim Employee'
ref table 'Fact Employee Leave'
ref table 'Dim Business Unit'
ref table 'Dim Gender'
ref table 'Dim Ethnicity'
ref table 'Dim Age Group'

ref cultureInfo en-NZ

