	partition 'Fact Tangata Whaiora Referral' = m
		mode: import
		queryGroup: 'Fact Tables'
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="--if object_id ('tempdb..#referrals') is not null drop table #referrals#(lf)#(lf)with#(lf)datetable as (#(lf)select dim_date_key, calendar_date#(lf)from edw.dim_date #(lf)where calendar_date between '2022-07-01' and dateadd(day,1,getdate())#(lf)),#(lf)#(lf)referrals_1 as (#(lf)select#(lf)#(lf)#(tab)fact_client_referral_key,#(lf)#(tab)fact_client_referral_unique_key,#(lf)#(tab)fact_client_referral_v2.dim_client_referral_key,#(lf)#(tab)dim_company_key,#(lf)#(tab)fact_client_referral_v2.dim_service_key,#(lf)#(tab)fact_client_referral_v2.dim_client_team_key,#(lf)#(tab)fact_client_referral_v2.dim_client_key,#(lf)#(tab)fact_client_referral_v2.dim_employee_key,#(lf)#(tab)fact_client_referral_v2.client_referral_id,#(lf)#(tab)fact_client_referral_v2.client_id,#(lf)#(tab)fact_client_referral_v2.client_team_id,#(lf)#(tab)case when client_referral_received_date_key is not null then #(lf)#(tab)cast(concat(#(lf)#(tab)#(tab)#(tab)  left(client_referral_received_date_key,4),'-',#(lf)#(tab)substring(cast(client_referral_received_date_key as nvarchar(8)),5,2),'-',#(lf)#(tab)#(tab)#(tab) right(client_referral_received_date_key,2)#(lf)#(tab)#(tab)#(tab))  as date)  #(lf)#(tab)#(tab)#(tab)end #(lf)#(tab) referral_received_date,#(lf)#(tab)case when client_referral_pending_date_key is not null then #(lf)#(tab)#(tab)cast(concat(#(lf)#(tab)#(tab)#(tab)  left(client_referral_pending_date_key,4),'-',#(lf)#(tab)substring(cast(client_referral_pending_date_key as nvarchar(8)),5,2),'-',#(lf)#(tab)#(tab)#(tab) right(client_referral_pending_date_key,2)#(lf)#(tab)#(tab)#(tab))  as date) #(lf)#(tab)#(tab)#(tab)end#(lf)#(tab)as referral_pending_date,#(lf)#(tab)case when client_referral_waitlist_date_key is not null then #(lf)#(tab)#(tab)cast(concat(#(lf)#(tab)#(tab)#(tab)  left(client_referral_waitlist_date_key,4),'-',#(lf)#(tab)substring(cast(client_referral_waitlist_date_key as nvarchar(8)),5,2),'-',#(lf)#(tab)#(tab)#(tab) right(client_referral_waitlist_date_key,2)#(lf)#(tab)#(tab)#(tab))  as date) #(lf)#(tab)#(tab)#(tab)end #(lf)#(tab)#(tab)#(tab)as referral_waitlisted_date,#(lf)#(tab)#(tab)#(tab)case when client_referral_decline_date_key is not null then #(lf)#(tab)#(tab)#(tab)#(tab)cast(concat(#(lf)#(tab)#(tab)#(tab)  left(client_referral_decline_date_key,4),'-',#(lf)#(tab)substring(cast(client_referral_decline_date_key as nvarchar(8)),5,2),'-',#(lf)#(tab)#(tab)#(tab) right(client_referral_decline_date_key,2)#(lf)#(tab)#(tab)#(tab))  as date) #(lf)#(tab)#(tab)#(tab)end#(lf)#(tab) as referral_declined_date,#(lf)#(tab) case when client_referral_accepted_date_key is not null then #(lf)#(tab) #(tab)cast(concat(#(lf)#(tab)#(tab)#(tab)  left(client_referral_accepted_date_key,4),'-',#(lf)#(tab)substring(cast(client_referral_accepted_date_key as nvarchar(8)),5,2),'-',#(lf)#(tab)#(tab)#(tab) right(client_referral_accepted_date_key,2)#(lf)#(tab)#(tab)#(tab))  as date) #(lf)#(tab)#(tab)#(tab)end #(lf)#(tab) as referral_accepted_date,#(lf)#(tab) case when client_referral_discharge_date_key is not null then #(lf)#(tab) #(tab)cast(concat(#(lf)#(tab)#(tab)#(tab)  left(client_referral_discharge_date_key,4),'-',#(lf)#(tab)substring(cast(client_referral_discharge_date_key as nvarchar(8)),5,2),'-',#(lf)#(tab)#(tab)#(tab) right(client_referral_discharge_date_key,2)#(lf)#(tab)#(tab)#(tab))  as date) #(lf)#(tab)#(tab)#(tab)end#(lf)#(tab) as referral_discharged_date,#(lf)#(tab)--======there must have been a cull in 2017 declined date and discharge date have been entered but no end date#(lf)#(tab)--=======calculated here#(lf)#(lf)case #(lf)when  client_referral_end_date_key is null and client_referral_decline_date_key is not null #(lf)#(tab)then #(lf)#(tab)cast(concat(#(lf)#(tab)left(client_referral_decline_date_key,4),'-',#(lf)#(tab)substring(cast(client_referral_decline_date_key as nvarchar(8)),5,2),'-',#(lf)#(tab)right(client_referral_decline_date_key,2))  as date) #(lf)#(lf)when client_referral_end_date_key is null and client_referral_discharge_date_key is not null #(lf)#(lf)then  #(tab)cast(concat(#(lf)#(tab)#(tab)#(tab)  left(client_referral_discharge_date_key,4),'-',#(lf)#(tab)substring(cast(client_referral_discharge_date_key as nvarchar(8)),5,2),'-',#(lf)#(tab)#(tab)#(tab) right(client_referral_discharge_date_key,2)#(lf)#(tab)#(tab)#(tab))  as date) #(lf)when client_referral_end_date_key is not null then #(lf) #(tab)cast(concat(#(lf)#(tab)#(tab)#(tab)  left(client_referral_end_date_key,4),'-',#(lf)#(tab)substring(cast(client_referral_end_date_key as nvarchar(8)),5,2),'-',#(lf)#(tab)#(tab)#(tab) right(client_referral_end_date_key,2)#(lf)#(tab)#(tab)#(tab))  as date) #(lf)end as referral_endded_date,#(lf)#(lf)#(tab)client_date_of_birth,#(lf)#(tab)client_referral_type,#(lf)#(tab)dim_client_team.client_team_is_accommodation_based,#(lf)#(tab)dim_client_team.client_team_bed_number,#(lf)#(tab)dim_client_team.dim_client_team_unique_key#(lf)from edw.fact_client_referral_v2#(lf)--left join edw.dim_date as accepted on fact_client_referral_v2.client_referral_accepted_date_key = accepted.dim_date_key#(lf)--left join edw.dim_date as discharged on fact_client_referral_v2.client_referral_discharge_date_key = discharged.dim_date_key#(lf)--left join edw.dim_date as received on fact_client_referral_v2.client_referral_received_date_key = received.dim_date_key#(lf)--left join edw.dim_date as waitlisted on fact_client_referral_v2.client_referral_waitlist_date_key = waitlisted.dim_date_key#(lf)--left join edw.dim_date as pending on fact_client_referral_v2.client_referral_pending_date_key = pending.dim_date_key#(lf)--left join edw.dim_date as declined on fact_client_referral_v2.client_referral_decline_date_key = declined.dim_date_key#(lf)--left join edw.dim_date as ended on fact_client_referral_v2.client_referral_end_date_key = ended.dim_date_key#(lf)#(lf)left join edw.dim_client on fact_client_referral_V2.client_id = dim_client.client_id #(lf)and fact_client_referral_v2.dim_company_key = dim_client.company_id#(lf)and dim_client.DWHIsCurrent = 1 and dim_client.DWHDMLOperation <> 'd'#(lf)#(lf)--left join edw.dim_client_team on fact_client_referral_V2.client_team_id = dim_client_team.client_team_id#(lf)--and dim_client_team.DWHDMLOperation <> 'd' and dim_client_team.company_id = fact_client_referral_V2.dim_company_key#(lf)#(lf)left join edw.dim_client_team on fact_client_referral_V2.dim_client_team_key = dim_client_team.dim_client_team_Key#(lf)and dim_client_team.DWHDMLOperation <> 'd' #(lf)#(lf)inner join edw.dim_client_referral on fact_client_referral_V2.dim_client_referral_key = dim_client_referral.dim_client_referral_key#(lf)#(lf)where #(lf)fact_client_referral_V2.dwhdmloperation <> 'd' and client_referral_type = 'inboundreferral'#(lf)#(lf)#(lf)--======for testing#(lf) --and  fact_client_referral_V2.client_id like '108%'#(lf) --=======#(lf)),#(lf)Referrals_2 as#(lf)(select #(lf)#(lf)#(tab)datetable.dim_date_key,#(lf)#(tab)datetable.calendar_date,#(lf)#(tab)fact_client_referral_key,#(lf)#(tab)fact_client_referral_unique_key,#(lf)#(tab)dim_client_referral_key,#(lf)#(tab)dim_client_key,#(lf)#(tab)dim_company_key,#(lf)#(tab)dim_service_key,#(lf)#(tab)dim_client_team_key,#(lf)#(tab)dim_client_team_unique_key,#(lf)#(tab)client_team_is_accommodation_based,#(lf)#(tab)client_team_bed_number,#(lf)#(tab)referrals_1.dim_employee_key,#(lf)#(tab)client_referral_id,#(lf)#(tab)client_id,#(lf)#(tab)client_team_id,#(lf)#(tab)referral_received_date,#(lf)#(tab)referral_pending_date,#(lf)#(tab)referral_waitlisted_date,#(lf)#(tab)referral_declined_date,#(lf)#(tab)referral_accepted_date,#(lf)#(tab)referral_discharged_date,#(lf)#(tab)isnull(referral_endded_date,getutcdate()) as referral_endded_date,#(lf)case #(lf)#(tab)when referral_discharged_date = referral_accepted_date then 'Accepted and Discharged'#(lf)#(tab)when calendar_date = referral_declined_date then 'Declined'#(lf)#(tab)when calendar_date = referral_discharged_date then 'Discharged'#(lf)#(tab)when calendar_date = referral_accepted_date then 'Accepted'#(lf)#(tab)when calendar_date = referral_waitlisted_date then 'Waitlisted'#(lf)#(tab)when calendar_date = referral_pending_date then 'Pending'#(lf)#(tab)when calendar_date between referral_pending_date and referral_declined_date and referral_waitlisted_date is null then 'Pending'#(lf)#(tab)when calendar_date between referral_pending_date and referral_accepted_date and referral_waitlisted_date is  null  then 'Pending'#(lf)#(tab)when calendar_date between referral_pending_date and referral_waitlisted_date then 'Pending'#(lf)#(tab)when calendar_date between referral_waitlisted_date and referral_declined_date then 'Waitlisted'#(lf)#(tab)when calendar_date between referral_waitlisted_date and referral_accepted_date then 'Waitlisted'#(lf)#(tab)when calendar_date >= referral_waitlisted_date and referral_accepted_date is null and referral_discharged_date is null and#(lf)#(tab)referral_declined_date is null then 'Waitlisted'#(lf)#(tab)when calendar_date >= referral_pending_date and referral_accepted_date is null and referral_discharged_date is null and#(lf)#(tab)referral_declined_date is null then 'Pending'#(lf)#(tab)when calendar_date between referral_accepted_date and isnull(referral_endded_date,getutcdate()) then 'Accepted'#(lf) else ''#(lf)end as Referral_status,#(lf)--=====setting up count columns#(lf)case when calendar_date = referral_received_date then 1 #(lf)#(tab)else 0 #(lf)#(tab)end as pending,#(lf)case when calendar_date = referral_waitlisted_date then 1 #(lf)#(tab)else 0 #(lf)#(tab)end as waitlist,#(lf)case when calendar_date = referral_accepted_date then 1 #(lf)#(tab)else 0 #(lf)#(tab)end as accepted,#(lf)case when calendar_date = referral_declined_date then 1 #(lf)#(tab)else 0 #(lf)#(tab)end as declined,#(lf)case when calendar_date = referral_discharged_date #(lf)#(tab)then 1 #(lf)#(tab)else 0 #(lf)#(tab)end as discharged,#(lf)#(tab)client_date_of_birth,#(lf)--===for some reason doesn't work for the actual birthday so I've put in a case statement#(lf)case #(lf)#(tab)when month(client_date_of_birth) = month(calendar_date) and day(client_date_of_birth) = day(calendar_date) #(lf)#(tab)then datediff(year,cast(client_date_of_birth as date),cast(calendar_date as date))#(lf)#(tab)else #(lf)#(tab)floor(datediff(day,cast(client_date_of_birth as date) ,cast(calendar_date as date))/365.250000) #(lf)#(tab)end as age_on_day#(lf)from referrals_1#(lf)--=====creating an explosion table#(lf)cross join datetable#(lf)where datetable.calendar_date between referral_received_date and isnull(referral_endded_date,getutcdate())#(lf)),#(lf)#(lf)absences as (#(lf)SELECT #(lf)#(lf)#(tab)#(tab)client_id, #(lf)#(tab)#(tab)company_id,#(lf)       [client_absence_start_date_time]#(lf)      ,[client_absence_end_date_time]#(lf)      ,[client_absence_type]#(lf)      ,[client_absence_reason]#(lf)    #(lf)  FROM [edw].[dim_client_absence]#(lf)  where dwhiscurrent = 1#(lf)#(lf)#(lf)#(lf)  --=====for testing#(lf)  --and  client_id like '108%'#(lf)  ),#(lf)  --===================#(lf)  #(lf)  dates as #(lf)  (select calendar_date from datetable #(lf) #(lf)  --where calendar_date between '2024-07-01' and '2024-07-31'#(lf)  ),#(lf)  #(lf)  client_absences_cal as #(lf)  ( select#(lf)  #(lf)#(tab)client_id,#(lf)#(tab)company_id,#(lf)#(tab)datediff(day,client_absence_start_date_time, client_absence_end_date_time) totalabsences, #(lf)#(tab)calendar_date, #(lf)#(tab)client_absence_start_date_time, #(lf)#(tab)client_absence_end_date_time, #(lf)#(tab)client_absence_type,#(lf)#(tab)client_absence_reason,#(lf)  --===hard coding in a counter#(lf)#(tab)1 as absent_night#(lf)  from dates#(lf)  cross join absences  #(lf)  where calendar_date > cast(client_absence_start_date_time as date) and calendar_date <= cast(client_absence_end_date_time as date)#(lf) )#(lf)  ,referrals_with_absence as#(lf) (select referrals_2.*,  --===I know we shouldn't use the *#(lf)case #(lf)#(tab)when referral_status = 'accepted' then 1#(lf)#(tab)else 0 #(lf)end as active_accepted_flag,#(lf)case #(lf)#(tab)when referral_status = 'pending' #(lf)#(tab)then 1#(lf)#(tab)else 0 #(lf)end as active_pending_flag,#(lf)case#(lf)#(tab)when referral_status = 'waitlisted' then 1#(lf)#(tab)else 0 #(lf)end as active_waitlisted_flag,#(lf)case #(lf)#(tab)when referral_status in ('discharged','declined') then 1#(lf)#(tab)else 0 #(lf)end as inactive_flag,#(lf)#(tab)client_absences_cal.client_absence_start_date_time,#(lf)#(tab)client_absences_cal.client_absence_end_date_time,#(lf)#(tab)client_absences_cal.absent_night as daily_absent,#(lf)#(tab)client_absences_cal.client_absence_type,#(lf)#(tab)client_absences_cal.client_absence_reason#(lf)from referrals_2#(lf)left join client_absences_cal on referrals_2.calendar_date = client_absences_cal.calendar_date#(lf)and referrals_2.client_id = client_absences_cal.client_id #(lf)and referrals_2.dim_company_key = client_absences_cal.company_id #(lf)and referrals_2.client_team_is_accommodation_based = 1 #(lf)where referrals_2.calendar_date >='2020-07-01' #(lf))#(lf)#(lf)select#(lf)#(lf)* ,  --====there's that * again!#(lf)case #(lf)#(tab)when daily_absent is null then active_accepted_flag#(lf)#(tab)else active_accepted_flag - daily_absent#(lf)end as actual_bed_night,#(lf)case when referral_discharged_date is not null #(lf)and calendar_date = referral_discharged_date#(lf)then #(lf)datediff(day,referral_accepted_date, referral_discharged_date) #(lf)#(lf)end as lengthofStay,#(lf)case when accepted=1#(lf)then #(lf)datediff(day,referral_pending_date, referral_accepted_date) #(lf)#(lf)end as lengthofPending,#(lf)case #(lf)when referral_received_date = calendar_date and accepted = 1 then 'Received and Accepted'#(lf)when referral_accepted_date = referral_discharged_date then 'Accepted and Discharged'#(lf)when accepted = 1 then 'Accepted'#(lf)when declined = 1 then 'Declined'#(lf)when discharged = 1 then 'Discharged'#(lf)when referral_received_date = calendar_date then 'Received'#(lf)end as Referral_Status_By_Day,#(lf)datediff(day,referral_accepted_date, calendar_date) as current_days_in_service#(lf)#(lf)from #(lf)referrals_with_absence #(lf)#(lf)#(lf)#(lf)#(lf)#(lf)#(lf)", CreateNavigationProperties=false]),
