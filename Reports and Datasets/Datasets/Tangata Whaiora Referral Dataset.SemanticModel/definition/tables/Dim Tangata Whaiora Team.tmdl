	partition 'Dim Tangata Whaiora Team' = m
		mode: import
		queryGroup: 'Dim Tables'
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="select *,#(lf)case #(lf)when client_team_name like 'Pto res clinical%' then 'Keep'#(lf)when client_team_name like '%f/up%' or client_team_name like '%follow up%' then 'Exclude Follow Up Teams'#(lf)when client_team_name like '%non%clinical%' then 'Keep'#(lf)when client_team_name like '%%clinical%' then 'Exclude Clinical Teams'#(lf)when client_team_name like 'thvm referral errors%' then 'Exclude Not real team'#(lf)else 'Keep'#(lf)end as team_exclusions#(lf)#(lf)from edw.dim_client_team #(lf)#(lf)#(lf)"]),
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, each ApplyNamingConventions(_)),
				    #"Changed Type" = Table.TransformColumnTypes(#"Transformed Column Names",{{"Tangata Whaiora Team Is Accommodation Based", type logical}, {"Tangata Whaiora Team Is Allocated Support", type logical}, {"Tangata Whaiora Team Is Employment Team", type logical}}),
				    #"Filtered Rows" = Table.SelectRows(#"Changed Type", each ([DWH Dml Operation] <> "D")),
				    #"Removed Columns" = Table.RemoveColumns(#"Filtered Rows",{"DWH Source System", "DWH Dml Operation"}),
				    // Added PRIMHD Exclusion flag. This can be removed when the field is added to the EDW as we can pull directly from dim_client_team.
				    #"Merged Queries" = Table.NestedJoin(#"Removed Columns", {"Company ID", "Tangata Whaiora Team ID"}, #"Work _PRIMHDExclusionTeams", {"CompanyID", "TeamID"}, "Work _PRIMHDExclusionTeams", JoinKind.LeftOuter),
				    #"Expanded Work _PRIMHDExclusionTeams" = Table.ExpandTableColumn(#"Merged Queries", "Work _PRIMHDExclusionTeams", {"PRIMHDExclusion"}, {"PRIMHDExclusion"}),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Expanded Work _PRIMHDExclusionTeams",{{"PRIMHDExclusion", type logical}}),
				    #"Replaced Value" = Table.ReplaceValue(#"Changed Type1",null,false,Replacer.ReplaceValue,{"PRIMHDExclusion"}),
				    #"Renamed Columns" = Table.RenameColumns(#"Replaced Value",{{"PRIMHDExclusion", "Tangata Whaiora Team Is Excluded From PRIMHD Reporting"}}),
				    #"Sorted Rows" = Table.Sort(#"Renamed Columns",{{"Tangata Whaiora Team ID", Order.Ascending}})
				in
				    #"Sorted Rows"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

