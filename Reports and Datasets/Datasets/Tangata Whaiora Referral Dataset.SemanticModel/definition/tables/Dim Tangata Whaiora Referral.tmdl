	column 'Tangata Whaiora Referral Declined Reason (groups)' =
			SWITCH(
				TRUE,
				ISBLANK('Dim Tangata Whaiora Referral'[Tangata Whaiora Referral Declined Reason]),
				"(Blank)",
				'Dim Tangata Whaiora Referral'[Tangata Whaiora Referral Declined Reason] IN {"Consumer declined service.",
					"Consumer did not attend following the referral",
					"Client accepted private rental before service initiation",
					"Client accepted social housing before service initiation",
					"Client declined service (give reasons in comments)",
					"Client does not believe service is necessary",
					"Client does not want to work with provider",
					"Client unable to commit to trial duration",
					"Client would like more time to decide",
					"Did not engage with the service",
					"No longer wants any support",
					"Peer declined service",
					"Person no longer wants to access the service"},
				"Client Decision",
				'Dim Tangata Whaiora Referral'[Tangata Whaiora Referral Declined Reason] IN {"Client did not engage or was uncontactable (record approval from Operations Manager)",
					"Consumer who has been referred is unable to be contacted and decision is made to decline the referral.",
					"Gone no address or lost to follow up",
					"Person did not attend following the referral",
					"Referral declined due to non-attendance, no contact after initial referral",
					"Unable to contact client, client did not engage"},
				"Contact Issues",
				'Dim Tangata Whaiora Referral'[Tangata Whaiora Referral Declined Reason] IN {"Client did not meet service criteria",
					"Declined by Motelier (record approval from Operations Manager)",
					"Not eligible for service",
					"Tnt not eligible for service (give reasons in comments)"},
				"Eligibility Issues",
				'Dim Tangata Whaiora Referral'[Tangata Whaiora Referral Declined Reason] IN {"Client is too unwell to participate in trial",
					"Deceased - do not use"},
				"Health Related",
				'Dim Tangata Whaiora Referral'[Tangata Whaiora Referral Declined Reason] IN {"Inability to provide services requested",
					"Unable to progress, client ref bk to WINZ",
					"Unallocated referral (oversubscription)"},
				"Inability to provide services",
				'Dim Tangata Whaiora Referral'[Tangata Whaiora Referral Declined Reason] IN {"Internal transfer to Emerge EH ppty",
					"Transfer to other Emerge TH service"},
				"Internal Transfer/Service Provision",
				'Dim Tangata Whaiora Referral'[Tangata Whaiora Referral Declined Reason] IN {"Client accepted HNZ tenancy before service initiation",
					"Client accessed private rental before service initiation",
					"Client found Emerg Hous location unsuitable",
					"Client has moved out of service area",
					"Client is moving out of social housing"},
				"Location/Relocation Issues",
				'Dim Tangata Whaiora Referral'[Tangata Whaiora Referral Declined Reason] IN {"Accommod not suited to needs",
					"Accommodation not suited to needs (record approval from Operations Manager)",
					"Client found TH accommodation location unsuitable",
					"Other services more appropriate",
					"Referral declined - Inability to provide services requested.",
					"Referral declined - Other services more appropriate.",
					"Service not suited to needs",
					"Transfer to another service within Mind & Body (different DHB)",
					"Transfer to another service within Mind & Body (same DHB)",
					"Transferred to other Emerge TH service",
					"Unable to appropriately place client in service (give reasons in comments & record approval from Operations Manager)"},
				"Service Suitability",
				"Other"
			)
		lineageTag: 4cceb2ed-6aae-4315-abbe-0a71bc3785a7
		summarizeBy: none

