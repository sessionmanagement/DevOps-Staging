model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-NZ
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 'Fact Tables'

	annotation PBI_QueryGroupOrder = 2

queryGroup 'Dim Tables'

	annotation PBI_QueryGroupOrder = 3

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 4

queryGroup 'To Sort'

	annotation PBI_QueryGroupOrder = 6

queryGroup 'Reference Tables'

	annotation PBI_QueryGroupOrder = 1

queryGroup 'Calculation Tables'

	annotation PBI_QueryGroupOrder = 8

queryGroup 'Role Playing Date Tables'

	annotation PBI_QueryGroupOrder = 5

queryGroup Work

	annotation PBI_QueryGroupOrder = 7

queryGroup 'Row Level Security'

	annotation PBI_QueryGroupOrder = 9

queryGroup 'Fact Tables\Unpivoted Fact Tables'

	annotation PBI_QueryGroupOrder = 0

queryGroup Changelog

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Row Level Security\New RLS for RB'

	annotation PBI_QueryGroupOrder = 0

annotation PBI_QueryOrder = ["Server","Database","Top N Rows","Dim Company","Dim Service","Dim Employee","Dim Employee Hierarchy","Dim Tangata Whaiora","Fact Tangata Whaiora Max Referral KEY","Fact Tangata Whaiora Max Activity Key","Dim Tangata Whaiora Referral","Fact Tangata Whaiora Referral","Dim Tangata Whaiora Team","Dim Date","LastRefreshed","Work _PRIMHDExclusionTeams","Ref Referrer Groupings","Additional Access","Row Level Security Employee","Row Level Security Client","Employee RLS with Additional Access","Client RLS with Additional Access","Data and Measure Definitions","Changelog","Fact Tangata Whaiora Referral Daily","Dim Age Group","RLS - New RB Structure ALL services","RLS with Additional Access","Executinve Masking","_Measures Table"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","CalcGroup","TMDLView_Desktop"]

annotation __TEdtr = 1

ref table 'Dim Tangata Whaiora'
ref table 'Dim Tangata Whaiora Referral'
ref table 'Fact Tangata Whaiora Referral'
ref table 'Dim Tangata Whaiora Team'
ref table 'Dim Company'
ref table 'Dim Service'
ref table 'Dim Employee'
ref table 'Dim Employee Hierarchy'
ref table 'Dim Date'
ref table LastRefreshed
ref table 'Ref Referrer Groupings'
ref table 'Data and Measure Definitions'
ref table Changelog
ref table 'Dim Age Group'
ref table 'RLS with Additional Access'
ref table 'Executinve Masking'
ref table '_Measures Table'

ref role 'All Access'
ref role 'Timi RLS'

ref cultureInfo en-US

