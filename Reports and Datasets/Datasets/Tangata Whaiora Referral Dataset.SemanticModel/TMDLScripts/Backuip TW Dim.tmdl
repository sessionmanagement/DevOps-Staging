createOrReplace

	table 'Dim Tangata Whaiora'
		lineageTag: 7f510e9f-9136-4891-8674-1c348336db95

		column 'Latest Tangata Whaiora Ethnicity Group' = ```
				
				VAR MaxKey = 
				    CALCULATE(
				        MAX('Dim Tangata Whaiora'[Dim Tangata Whaiora KEY]),
				        ALLEXCEPT('Dim Tangata Whaiora', 'Dim Tangata Whaiora'[Company ID], 'Dim Tangata Whaiora'[Tangata Whaiora ID])
				    )
				RETURN
				    CALCULATE(
				        VALUES('Dim Tangata Whaiora'[Tangata Whaiora Ethnicity Group]),
				        'Dim Tangata Whaiora'[Dim Tangata Whaiora KEY] = MaxKey,
				        ALLEXCEPT('Dim Tangata Whaiora', 'Dim Tangata Whaiora'[Company ID], 'Dim Tangata Whaiora'[Tangata Whaiora ID])
				    )
				```
			lineageTag: 408833a2-65a6-4caa-913b-def312c8d358
			summarizeBy: none

			annotation SummarizationSetBy = Automatic

