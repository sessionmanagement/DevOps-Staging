			sourceColumn: Tangata Whaiora URL

			annotation SummarizationSetBy = Automatic

		partition 'Dim Tangata Whaiora' = m
			mode: import
			queryGroup: 'Dim Tables'
			source =
					let
					    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01"),
					    edw_dim_client = Source{[Schema = "edw", Item = "vw_dim_client"]}[Data],
					    ApplyNamingConventions = (columnName as text) as text =>
					        let
					            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
					            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
					            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
					            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
					            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
					            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
					            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
					            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
					            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
					            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
					            capitaliseWords = Text.Proper(renameDWHSourceSystem),
					            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
					            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
					            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
					        in
					            capitaliseDWH,
					    #"Transformed Column Names" = Table.TransformColumnNames(edw_dim_client, each ApplyNamingConventions(_)),
					    #"Changed Type" = Table.TransformColumnTypes(
					        #"Transformed Column Names", {{"Tangata Whaiora Address Missing Flag", Int64.Type}}
					    ),
					    #"Changed Type1" = Table.TransformColumnTypes(
					        #"Changed Type", {{"Tangata Whaiora Contact Phone Missing Flag", Int64.Type}}
					    ),
					    #"Filtered Rows" = Table.SelectRows(#"Changed Type1", each ([DWH Dml Operation] <> "D")),
					    #"Removed Columns" = Table.RemoveColumns(#"Filtered Rows", {"DWH Source System", "DWH Dml Operation"}),
					    #"Changed Type2" = Table.TransformColumnTypes(#"Removed Columns", {"Tangata Whaiora ID", type text}),
					    #"Duplicated Column" = Table.DuplicateColumn(
					        #"Changed Type2", "Tangata Whaiora Maori Flag", "Tangata Whaiora Maori"
					    ),
					    #"Changed Type3" = Table.TransformColumnTypes(#"Duplicated Column", {{"Tangata Whaiora Maori", type text}}),
					    #"Replaced Value" = Table.ReplaceValue(
					        #"Changed Type3", "1", "Māori", Replacer.ReplaceText, {"Tangata Whaiora Maori"}
					    ),
					    #"Replaced Value1" = Table.ReplaceValue(
					        #"Replaced Value", "0", "Non-Māori", Replacer.ReplaceText, {"Tangata Whaiora Maori"}
					    ),
					    #"Replaced Value2" = Table.ReplaceValue(
					        #"Replaced Value1", null, "Unknown", Replacer.ReplaceValue, {"Tangata Whaiora Maori"}
					    ),
					    #"Duplicate Pasifika" = Table.DuplicateColumn(
					        #"Replaced Value2", "Tangata Whaiora Pasifika Flag", "Tangata Whaiora Pasifika"
					    ),
					    #"Changed Type4" = Table.TransformColumnTypes(#"Duplicate Pasifika", {{"Tangata Whaiora Pasifika", type text}}),
					    #"Replaced Value3" = Table.ReplaceValue(
					        #"Changed Type4", "1", "Pasifika", Replacer.ReplaceText, {"Tangata Whaiora Pasifika"}
					    ),
					    #"Replaced Value4" = Table.ReplaceValue(
					        #"Replaced Value3", "0", "Non-Pasifika", Replacer.ReplaceText, {"Tangata Whaiora Pasifika"}
					    ),
					    #"Replaced Value5" = Table.ReplaceValue(
					        #"Replaced Value4", null, "Unknown", Replacer.ReplaceValue, {"Tangata Whaiora Pasifika"}
					    ),
					    #"Added Hyperlink" = Table.AddColumn(
					        #"Replaced Value5",
					        "Tangata Whaiora URL",
					        each
					            let
					                UniqueKey = [Dim Tangata Whaiora Unique KEY], Client = [Tangata Whaiora ID]
					            in
					                if Text.End(UniqueKey, 2) = "-1" then
					                    "https://emergeaotearoa.wildbamboo.co.nz/person/" & Client
					                else if Text.End(UniqueKey, 2) = "-5" then
					                    "https://mindandbody.wildbamboo.co.nz/person/" & Client
					                else
					                    null
					    ),
					    #"Replaced Value6" = Table.ReplaceValue(#"Added Hyperlink","Another Gender / He ira kē anō","Gender Diverse / He ira kē anō",Replacer.ReplaceText,{"Tangata Whaiora Gender"})
					in
					    #"Replaced Value6"

		annotation PBI_ResultType = Table

		annotation PBI_NavigationStepName = Navigation

