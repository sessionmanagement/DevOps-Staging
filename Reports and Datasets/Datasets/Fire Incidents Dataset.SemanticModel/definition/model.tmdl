model Model
	culture: en-NZ
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-NZ
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Individual Sources'

	annotation PBI_QueryGroupOrder = 1

queryGroup 'Common Components'

	annotation PBI_QueryGroupOrder = 2

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Waharoa Data","RecordBase Data","EcoPortal Data","Fire Incident Data","Dim Date","_Measures","_Report Components","Server","Database","LastRefreshed","Changelog","Date Range Data","EcoPortal RecordBase ID Mismatch","RecordBase All Incident IDs"]

annotation PBI_ProTooling = ["TMDLView_Desktop","DevMode"]

ref table 'Fire Incident Data'
ref table 'Dim Date'
ref table _Measures
ref table '_Report Components'
ref table LastRefreshed
ref table Changelog
ref table 'Date Range Data'
ref table 'EcoPortal RecordBase ID Mismatch'

ref cultureInfo en-NZ

