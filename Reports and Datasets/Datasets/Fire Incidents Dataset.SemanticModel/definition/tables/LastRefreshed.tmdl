table LastRefreshed
	lineageTag: c2b6a792-d3ac-4081-a801-911dd70771d1

	column 'Date Last Refreshed'
		dataType: dateTime
		formatString: General Date
		lineageTag: 79c20f43-a274-41ff-9f16-94f733121aee
		summarizeBy: none
		sourceColumn: Date Last Refreshed

		annotation SummarizationSetBy = Automatic

	partition LastRefreshed = m
		mode: import
		queryGroup: 'Common Components'
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="SELECT DISTINCT#(lf)CONVERT(datetime, SWITCHOFFSET(CONVERT(datetimeoffset, GETDATE()), DATEPART(TZOFFSET,GETDATE() AT TIME ZONE 'New Zealand Standard Time'))) AS [Date Last Refreshed]#(lf)FROM information_schema.columns"])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

