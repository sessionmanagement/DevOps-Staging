expression RB_UserTeamAccessMIB =
		let
		    Source = Sql.Database("eal-sql01.database.windows.net", "Recordbase_MindAndBody_Elite", [Query="#(lf)select ut.UserID,#(lf)       ut.TeamID,#(lf)#(tab)   u.UserEmailAddress,#(lf)#(tab)   u.UserEmployeeNumber,#(lf)#(tab)   t.TeamUDF5,    -- Finance Cost Centers#(lf)#(tab)   t.TeamCode,#(lf)#(tab)   t.TeamName#(lf)from       dl.FactUserTeam    ut#(lf)inner join dl.DimUser         u  on u.UserID      = ut.UserID#(lf)inner join dl.DimTeam         t  on t.TeamID      = ut.TeamID#(lf)inner join dl.DimUserType     ty on ty.UserTypeID = u.UserTypeID#(lf)where t.TeamEndDate         is   null#(lf)and   ty.UserTypeIsHidden   =    0#(lf)and   ut.UserTeamDeletedDate is null#(lf)and   u.UserDisabledDate     is null#(lf)-- remove Finance/Quality Team users who have overarching access#(lf)and   upper(u.UserEmailAddress) not in #(lf)        (#(lf)         'BASIL.DRAIN@EMERGEAOTEAORA.ORG.NZ'#(lf)        ,'DAVID.VANTURNHOUT@EMERGEAOTEAROA.ORG.NZ'#(lf)        ,'BRAD.PALMER@EMERGEAOTEAROA.ORG.NZ'#(lf)        ,'ELLA.LYNCH@EMERGEAOTEAROA.ORG.NZ'#(lf)        ,'JAY.GONSAL-KORALE@EMERGEAOTEAROA.ORG.NZ'#(lf)        ,'NICOLENE.PIENAAR@EMERGEAOTEAROA.ORG.NZ'#(lf)        ,'JASMINE.MOHAMMED@EMERGEAOTEAROA.ORG.NZ'#(lf)        ,'CHAMARA.ILLAN@EMERGEAOTEAROA.ORG.NZ'#(lf)        ,'RIKKI-LEE.JOYCE@EMERGEAOTEAROA.ORG.NZ'#(lf)        ,'GONDA.SOLLIE@EMERGEAOTEAROA.ORG.NZ'#(lf)        ,'TREVOR.COOPER@EMERGEAOTEAROA.ORG.NZ'#(lf)        ,'STEFEN.HASSELBERG@EMERGEAOTEAROA.ORG.NZ'#(lf)        ,'GREG.HUBBARD@EMERGEAOTEAROA.ORG.NZ'#(lf)        ,'KATHY.CRIBBETT@EMERGEAOTEAROA.ORG.NZ'#(lf)        ,'CATHERINE.BENNETT@EMERGEAOTEAROA.ORG.NZ'#(lf)        ,'ANDY.DIMOND@EMERGEAOTEAROA.ORG.NZ'#(lf)        ,'WENDY.BECK@EMERGEAOTEAROA.ORG.NZ'#(lf)        ,'NATHAN.BARTHOW@EMERGEAOTEAROA.ORG.NZ'#(lf)        ,'MICHELLE.BRADSHAW@EMERGEAOTEAROA.ORG.NZ'#(lf)        ,'ANDREW.BOLITHO@EMERGEAOTEAROA.ORG.NZ'#(lf)        ,'HELEN.EGAN@EMERGEAOTEAROA.ORG.NZ'#(lf)        ,'MARVIN.KAGIRI@EMERGEAOTEAROA.ORG.NZ'#(lf)        ,'FAYE.LOGAN@EMERGEAOTEAROA.ORG.NZ'#(lf)        ,'COLLEEN.ZIMRI@EMERGEAOTEAROA.ORG.NZ'#(lf)        ,'JOHN.COOK@EMERGEAOTEAROA.ORG.NZ'#(lf)        ,'CELENE.JOHNSON@EMERGEAOTEAROA.ORG.NZ'#(lf)        ,'CHRIS.MAXWELL@EMERGEAOTEAROA.ORG.NZ'#(lf)        )"])
		in
		    Source
