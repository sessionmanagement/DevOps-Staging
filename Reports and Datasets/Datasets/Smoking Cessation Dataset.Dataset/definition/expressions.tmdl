expression work_fact_smoking_assessment_all =
		let
		    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="with CTEDimSmokingStatus as#(lf)(#(lf)SELECT#(lf)'EAL' AS Company,#(lf)SmokingStatusID,#(lf)CONCAT('E',SmokingStatusID) AS DimSmokingStatusKey,#(lf)SmokingStatusValue,#(lf)SmokingStatusText,#(lf)CASE #(lf)WHEN SmokingStatusID = 12308 THEN 0#(lf)WHEN SmokingStatusID = 12522 THEN 1#(lf)WHEN SmokingStatusID = 12307 THEN 2#(lf)WHEN SmokingStatusID = 12306 THEN 3#(lf)WHEN SmokingStatusID = 11555 THEN 4#(lf)WHEN SmokingStatusID = 11556 THEN 5#(lf)WHEN SmokingStatusID = 11557 THEN 6#(lf)WHEN SmokingStatusID = 11558 THEN 7#(lf)WHEN SmokingStatusID = 11559 THEN 8#(lf)ELSE NULL END AS [Rank]#(lf)FROM [RBEAL].[dlDimSmokingStatus]#(lf)WHERE SmokingStatusIsActive = 1#(lf)#(lf)UNION #(lf)#(lf)SELECT#(lf)'MNB' AS Company,#(lf)SmokingStatusID,#(lf)CONCAT('M',SmokingStatusID) AS DimSmokingStatusKey,#(lf)SmokingStatusValue,#(lf)SmokingStatusText,#(lf)CASE #(lf)WHEN SmokingStatusID = 12308 THEN 0#(lf)WHEN SmokingStatusID = 12307 THEN 1#(lf)WHEN SmokingStatusID = 12525 THEN 2#(lf)WHEN SmokingStatusID = 12306 THEN 3#(lf)WHEN SmokingStatusID = 11555 THEN 4#(lf)WHEN SmokingStatusID = 11556 THEN 5#(lf)WHEN SmokingStatusID = 11557 THEN 6#(lf)WHEN SmokingStatusID = 11558 THEN 7#(lf)WHEN SmokingStatusID = 11559 THEN 8#(lf)ELSE NULL END AS [Rank]#(lf)FROM [RBMNB].[dlDimSmokingStatus]#(lf)WHERE SmokingStatusIsActive = 1#(lf))#(lf)#(lf)SELECT#(lf)CASE WHEN sh.PersonSmokingHistoryID IS NOT NULL THEN CONCAT('M',sh.PersonSmokingHistoryID) ELSE NULL END AS PersonSmokingHistoryID,#(lf)CASE WHEN sh.PersonID IS NOT NULL THEN CONCAT('M',sh.PersonID) ELSE NULL END AS PersonID,#(lf)CASE WHEN sh.SmokingStatusId IS NOT NULL THEN CONCAT('M',sh.SmokingStatusId) ELSE NULL END AS DimSmokingStatusKey,#(lf)CASE WHEN dt.TeamFunctionID IS NOT NULL THEN CONCAT('M',dt.TeamFunctionID) ELSE NULL END AS TeamFunctionID,#(lf)CASE WHEN fr.TeamID IS NOT NULL THEN CONCAT('M',fr.TeamID) ELSE NULL END AS TeamID,#(lf)CASE WHEN fr.ID IS NOT NULL THEN CONCAT('M',fr.ID) ELSE NULL END AS ReferralID,#(lf)CASE WHEN dt.TeamFunctionID IS NOT NULL AND fr.TeamID IS NOT NULL THEN CONCAT('M',dt.TeamFunctionID,'M',fr.TeamID) ELSE NULL END AS TeamKeyComposite,#(lf)sh.PersonSmokingHistoryAssessmentDate,#(lf)CASE #(lf)#(tab)WHEN fr.AcceptedDate IS NULL THEN 'No' ELSE 'Yes' END AS ActiveReferralAtTimeOfAssessmentExists,#(lf)COALESCE(LEAD(DATEADD(DAY, -1, sh.PersonSmokingHistoryAssessmentDate)) OVER (PARTITION BY sh.PersonID, fr.TeamID ORDER BY sh.PersonSmokingHistoryAssessmentDate),CAST(fr.DischargeDate AS date),CAST(GETDATE() AS date)) AS AssessmentValidTo,#(lf)CASE#(lf)#(tab)WHEN (LEAD(sh.PersonSmokingHistoryAssessmentDate) OVER (PARTITION BY sh.PersonID ORDER BY sh.PersonSmokingHistoryAssessmentDate)) IS NOT NULL#(lf)#(tab)THEN 'DayBeforeNewerAssessment'#(lf)#(tab)WHEN fr.DischargeDate IS NOT NULL THEN 'ReferralDischargeDate'#(lf)#(tab)ELSE 'ValidToToday' END AS AssessmentValidToReason,#(lf)FLOOR(DATEDIFF(DAY, dp.PersonDateofBirth, sh.PersonSmokingHistoryAssessmentDate)/365) AS AgeAtAssessmentDate,#(lf)'MNB' AS Company,#(lf)CASE WHEN sh.PersonSmokingHistoryBriefAdviceGiven = 1 THEN 'Yes' ELSE 'No' END AS BriefAdviceGiven,#(lf)dss.[Rank] AS AssessmentRank,#(lf)LAG(dss.[Rank]) OVER (PARTITION BY sh.PersonID, fr.TeamID ORDER BY sh.PersonSmokingHistoryAssessmentDate) AS PreviousAssessmentRank,#(lf)'M' + CAST(LAG(sh.SmokingStatusId) OVER (PARTITION BY sh.PersonID, fr.TeamID ORDER BY sh.PersonSmokingHistoryAssessmentDate) AS varchar(10)) AS PreviousAssessmentSmokingStatusKey,#(lf)CASE WHEN sh.PersonSmokingHistorySupportServicesOffered IS NOT NULL AND PersonSmokingHistorySupportServicesOffered <> '' THEN 'Yes' ELSE 'No' END AS SupportServicesOfferedYN#(lf)FROM [RBMNB].[dlFactPersonSmokingHistory] sh #(lf)LEFT OUTER JOIN [RBMNB].[legacyFactReferral] fr#(lf)ON fr.PersonID = sh.PersonID AND sh.PersonSmokingHistoryAssessmentDate BETWEEN fr.AcceptedDate AND fr.DischargeDate#(lf)LEFT OUTER JOIN [RBMNB].[dlDimTeam] dt ON fr.TeamID = dt.TeamID#(lf)LEFT OUTER JOIN [RBMNB].[dlDimPerson] dp ON sh.PersonID = dp.PersonID#(lf)LEFT OUTER JOIN CTEDimSmokingStatus dss ON sh.SmokingStatusID = dss.SmokingStatusID AND Company = 'MNB'#(lf)#(lf)UNION#(lf)#(lf)SELECT#(lf)CASE WHEN sh.PersonSmokingHistoryID IS NOT NULL THEN CONCAT('E',sh.PersonSmokingHistoryID) ELSE NULL END AS PersonSmokingHistoryID,#(lf)CASE WHEN sh.PersonID IS NOT NULL THEN CONCAT('E',sh.PersonID) ELSE NULL END AS PersonID,#(lf)CASE WHEN sh.SmokingStatusId IS NOT NULL THEN CONCAT('E',sh.SmokingStatusId) ELSE NULL END AS SmokingStatusId,#(lf)CASE WHEN dt.TeamFunctionID IS NOT NULL THEN CONCAT('E',dt.TeamFunctionID) ELSE NULL END AS TeamFunctionID,#(lf)CASE WHEN fr.TeamID IS NOT NULL THEN CONCAT('E',fr.TeamID) ELSE NULL END AS TeamID,#(lf)CASE WHEN fr.ID IS NOT NULL THEN CONCAT('E',fr.ID) ELSE NULL END AS ReferralID,#(lf)CASE WHEN dt.TeamFunctionID IS NOT NULL AND fr.TeamID IS NOT NULL THEN CONCAT('E',dt.TeamFunctionID,'E',fr.TeamID) ELSE NULL END AS TeamKeyComposite,#(lf)sh.PersonSmokingHistoryAssessmentDate,#(lf)CASE #(lf)#(tab)WHEN fr.AcceptedDate IS NULL THEN 'No' ELSE 'Yes' END AS ActiveReferralAtTimeOfAssessmentExists,#(lf)COALESCE(LEAD(DATEADD(DAY, -1, sh.PersonSmokingHistoryAssessmentDate)) OVER (PARTITION BY sh.PersonID, fr.TeamID ORDER BY sh.PersonSmokingHistoryAssessmentDate),CAST(fr.DischargeDate AS date),CAST(GETDATE() AS date)) AS AssessmentValidTo,#(lf)CASE#(lf)#(tab)WHEN (LEAD(sh.PersonSmokingHistoryAssessmentDate) OVER (PARTITION BY sh.PersonID ORDER BY sh.PersonSmokingHistoryAssessmentDate)) IS NOT NULL#(lf)#(tab)THEN 'DayBeforeNewerAssessment'#(lf)#(tab)WHEN fr.DischargeDate IS NOT NULL THEN 'ReferralDischargeDate'#(lf)#(tab)ELSE 'ValidToToday' END AS AssessmentValidToReason,#(lf)FLOOR(DATEDIFF(DAY, dp.PersonDateofBirth, sh.PersonSmokingHistoryAssessmentDate)/365) AS AgeAtAssessmentDate,#(lf)'EAL',#(lf)CASE WHEN sh.PersonSmokingHistoryBriefAdviceGiven = 1 THEN 'Yes' ELSE 'No' END AS BriefAdviceGiven,#(lf)dss.[Rank] AS AssessmentRank,#(lf)LAG(dss.[Rank]) OVER (PARTITION BY sh.PersonID, fr.TeamID ORDER BY sh.PersonSmokingHistoryAssessmentDate) AS PreviousAssessmentRank,#(lf)'E' + CAST(LAG(sh.SmokingStatusId) OVER (PARTITION BY sh.PersonID, fr.TeamID ORDER BY sh.PersonSmokingHistoryAssessmentDate) AS varchar(10)) AS PreviousAssessmentSmokingStatusKey,#(lf)CASE WHEN sh.PersonSmokingHistorySupportServicesOffered IS NOT NULL AND PersonSmokingHistorySupportServicesOffered <> '' THEN 'Yes' ELSE 'No' END AS SupportServicesOfferedYN#(lf)FROM [RBEAL].[dlFactPersonSmokingHistory] sh #(lf)LEFT OUTER JOIN [RBEAL].[legacyFactReferral] fr#(lf)ON fr.PersonID = sh.PersonID AND sh.PersonSmokingHistoryAssessmentDate BETWEEN fr.AcceptedDate AND fr.DischargeDate#(lf)LEFT OUTER JOIN [RBEAL].[dlDimTeam] dt ON fr.TeamID = dt.TeamID#(lf)LEFT OUTER JOIN [RBEAL].[dlDimPerson] dp ON sh.PersonID = dp.PersonID#(lf)LEFT OUTER JOIN CTEDimSmokingStatus dss ON sh.SmokingStatusID = dss.SmokingStatusID AND Company = 'EAL'#(lf)#(lf)ORDER BY PersonID,PersonSmokingHistoryAssessmentDate"]),
		    #"Changed Type" = Table.TransformColumnTypes(Source,{{"PersonSmokingHistoryAssessmentDate", type date}, {"AssessmentValidTo", type date}}),
		    #"Filtered Rows" = Table.SelectRows(#"Changed Type", each ([PersonSmokingHistoryAssessmentDate] <> #date(1900, 1, 1))),
		    #"Removed Other Columns" = Table.SelectColumns(#"Filtered Rows",{"PersonSmokingHistoryID", "PersonID", "PersonSmokingHistoryAssessmentDate"}),
		    #"Reordered Columns" = Table.ReorderColumns(#"Removed Other Columns",{"PersonID", "PersonSmokingHistoryAssessmentDate"})
		in
		    #"Reordered Columns"
	lineageTag: eca67a0d-87db-4b8f-9c7f-1a86921f967a

