table info_last_refreshed
	lineageTag: 81ba1ec2-25b8-4917-9dd6-36639e00ebb6

	column 'Date Last Refreshed'
		dataType: dateTime
		formatString: General Date
		lineageTag: a0f2bffe-6be1-41c1-9514-37bfd2017148
		summarizeBy: none
		sourceColumn: Date Last Refreshed

		annotation SummarizationSetBy = Automatic

	partition info_last_refreshed-906d86bc-38a6-473d-81db-41b934d4d39a = m
		mode: import
		source =
				let
				    Source = Sql.Database("sql-dev-aue-svc-datawarehouse-01.database.windows.net", "sqldb-dev-datawarehouse-01", [Query="SELECT DISTINCT#(lf)CONVERT(datetime, SWITCHOFFSET(CONVERT(datetimeoffset, GETDATE()), DATEPART(TZOFFSET,GETDATE() AT TIME ZONE 'New Zealand Standard Time'))) AS [Date Last Refreshed]#(lf)FROM information_schema.columns"])
				in
