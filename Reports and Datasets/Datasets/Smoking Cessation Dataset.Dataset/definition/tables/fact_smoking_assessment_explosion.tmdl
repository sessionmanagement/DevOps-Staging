	column ImprovementOnPrevAssessmentStatus =
			
			IF(
			    ISBLANK(fact_smoking_assessment_explosion[PreviousAssessmentRank]),"No prior assessment",
			    IF(fact_smoking_assessment_explosion[AssessmentRank] < fact_smoking_assessment_explosion[PreviousAssessmentRank], "Improvement",
			    IF(fact_smoking_assessment_explosion[AssessmentRank] = fact_smoking_assessment_explosion[PreviousAssessmentRank], "No change",
			    IF(fact_smoking_assessment_explosion[AssessmentRank] > fact_smoking_assessment_explosion[PreviousAssessmentRank], "Regression"
			    )))
			)
