	column ImprovementFromFirstToLatestAssessment =
			
			IF(
			    fact_current_smoking_snapshot[NumberOfAssessments] = 1, "Person has only had one assessment",
			    IF(fact_current_smoking_snapshot[RankOfLatestAssessment] < fact_current_smoking_snapshot[RankOfFirstAssessment], "Improvement",
			    IF(fact_current_smoking_snapshot[RankOfFirstAssessment] = fact_current_smoking_snapshot[RankOfLatestAssessment], "No change",
			    IF(fact_current_smoking_snapshot[RankOfLatestAssessment] > fact_current_smoking_snapshot[RankOfFirstAssessment], "Regression"
			    )))
			)
		lineageTag: a15d1773-0dd9-41d3-ab60-373d1043f92f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column DaysBetweenFirstAndLastAssessment =
			
			IF(
			    fact_current_smoking_snapshot[NumberOfAssessments] = 1, BLANK(),
			    DATEDIFF(fact_current_smoking_snapshot[DateOfFirstAssessment], fact_current_smoking_snapshot[DateOfLatestAssessment], DAY)
			)
		formatString: 0
		lineageTag: 8e340538-69c3-4219-a1bb-e8e2be434da1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column AvgDaysBetweenAssessments =
			
			IF(
			    fact_current_smoking_snapshot[NumberOfAssessments] = 1, BLANK(),
			    fact_current_smoking_snapshot[DaysBetweenFirstAndLastAssessment] / fact_current_smoking_snapshot[NumberOfAssessments]
			)
		formatString: 0
		lineageTag: 049ffc6f-dbd5-442d-9ac1-28b8600bd607
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDecimal":true}

	column DaysSinceLastAssessment =
			
			DATEDIFF(fact_current_smoking_snapshot[DateOfLatestAssessment], TODAY(), DAY)
		formatString: 0
		lineageTag: 3cf84d76-f6c2-4139-9199-50f5bf57de7e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

