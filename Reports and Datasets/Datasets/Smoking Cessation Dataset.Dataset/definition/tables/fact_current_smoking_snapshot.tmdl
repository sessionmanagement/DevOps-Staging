		source =
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="with CTEDimSmokingStatus as#(lf)(#(lf)SELECT#(lf)'EAL' AS Company,#(lf)SmokingStatusID,#(lf)CONCAT('E',SmokingStatusID) AS DimSmokingStatusKey,#(lf)SmokingStatusValue,#(lf)SmokingStatusText,#(lf)CASE #(lf)WHEN SmokingStatusID = 12308 THEN 0#(lf)WHEN SmokingStatusID = 12522 THEN 1#(lf)WHEN SmokingStatusID = 12307 THEN 2#(lf)WHEN SmokingStatusID = 12306 THEN 3#(lf)WHEN SmokingStatusID = 11555 THEN 4#(lf)WHEN SmokingStatusID = 11556 THEN 5#(lf)WHEN SmokingStatusID = 11557 THEN 6#(lf)WHEN SmokingStatusID = 11558 THEN 7#(lf)WHEN SmokingStatusID = 11559 THEN 8#(lf)ELSE NULL END AS Rank#(lf)FROM RBEAL.dlDimSmokingStatus#(lf)WHERE SmokingStatusIsActive = 1#(lf)#(lf)UNION #(lf)#(lf)SELECT#(lf)'MNB' AS Company,#(lf)SmokingStatusID,#(lf)CONCAT('M',SmokingStatusID) AS DimSmokingStatusKey,#(lf)SmokingStatusValue,#(lf)SmokingStatusText,#(lf)CASE #(lf)WHEN SmokingStatusID = 12308 THEN 0#(lf)WHEN SmokingStatusID = 12307 THEN 1#(lf)WHEN SmokingStatusID = 12525 THEN 2#(lf)WHEN SmokingStatusID = 12306 THEN 3#(lf)WHEN SmokingStatusID = 11555 THEN 4#(lf)WHEN SmokingStatusID = 11556 THEN 5#(lf)WHEN SmokingStatusID = 11557 THEN 6#(lf)WHEN SmokingStatusID = 11558 THEN 7#(lf)WHEN SmokingStatusID = 11559 THEN 8#(lf)ELSE NULL END AS Rank#(lf)FROM RBMNB.dlDimSmokingStatus#(lf)WHERE SmokingStatusIsActive = 1#(lf))#(lf)#(lf), CTE_Original AS #(lf)(#(lf)SELECT#(lf)CASE WHEN sh.PersonSmokingHistoryID IS NOT NULL THEN CONCAT('M',sh.PersonSmokingHistoryID) ELSE NULL END AS PersonSmokingHistoryID,#(lf)CASE WHEN sh.PersonID IS NOT NULL THEN CONCAT('M',sh.PersonID) ELSE NULL END AS PersonID,#(lf)COALESCE(#(lf)CASE WHEN dp.Ethnicity1ID IS NOT NULL THEN CONCAT('M',dp.Ethnicity1ID) ELSE NULL END,#(lf)CASE WHEN dp.Ethnicity3ID IS NOT NULL THEN CONCAT('M',dp.Ethnicity3ID) ELSE NULL END,#(lf)CASE WHEN dp.Ethnicity4ID IS NOT NULL THEN CONCAT('M',dp.Ethnicity4ID) ELSE NULL END,#(lf)CASE WHEN dp.Ethnicity5ID IS NOT NULL THEN CONCAT('M',dp.Ethnicity5ID) ELSE NULL END,#(lf)CASE WHEN dp.Ethnicity2ID IS NOT NULL THEN CONCAT('M',dp.Ethnicity2ID) ELSE NULL END#(lf)) AS FirstNonBlankEthnicityID,#(lf)CASE WHEN dp.GenderID IS NOT NULL THEN CONCAT('M',dp.GenderID) ELSE NULL END AS GenderID,#(lf)dp.PersonDateOfBirth,#(lf)CASE WHEN sh.SmokingStatusId IS NOT NULL THEN CONCAT('M',sh.SmokingStatusId) ELSE NULL END AS DimSmokingStatusKey,#(lf)CASE WHEN dt.TeamFunctionID IS NOT NULL THEN CONCAT('M',dt.TeamFunctionID) ELSE NULL END AS TeamFunctionID,#(lf)CASE WHEN fr.TeamID IS NOT NULL THEN CONCAT('M',fr.TeamID) ELSE NULL END AS TeamID,#(lf)CASE WHEN fr.ID IS NOT NULL THEN CONCAT('M',fr.ID) ELSE NULL END AS ReferralID,#(lf)CASE WHEN dt.TeamFunctionID IS NOT NULL AND fr.TeamID IS NOT NULL THEN CONCAT('M',dt.TeamFunctionID,'M',fr.TeamID) ELSE NULL END AS TeamKeyComposite,#(lf)sh.PersonSmokingHistoryAssessmentDate,#(lf)CASE #(lf)#(tab)WHEN fr.AcceptedDate IS NULL THEN 'No' ELSE 'Yes' END AS ActiveReferralAtTimeOfAssessmentExists,#(lf)COALESCE(LEAD(DATEADD(DAY, -1, sh.PersonSmokingHistoryAssessmentDate)) OVER (PARTITION BY sh.PersonID, fr.TeamID ORDER BY sh.PersonSmokingHistoryAssessmentDate),CAST(fr.DischargeDate AS date),CAST(GETDATE() AS date)) AS AssessmentValidTo,#(lf)CASE#(lf)#(tab)WHEN (LEAD(sh.PersonSmokingHistoryAssessmentDate) OVER (PARTITION BY sh.PersonID ORDER BY sh.PersonSmokingHistoryAssessmentDate)) IS NOT NULL#(lf)#(tab)THEN 'DayBeforeNewerAssessment'#(lf)#(tab)WHEN fr.DischargeDate IS NOT NULL THEN 'ReferralDischargeDate'#(lf)#(tab)ELSE 'ValidToToday' END AS AssessmentValidToReason,#(lf)FLOOR(DATEDIFF(DAY, dp.PersonDateofBirth, sh.PersonSmokingHistoryAssessmentDate)/365) AS AgeAtAssessmentDate,#(lf)'MNB' AS Company,#(lf)CASE WHEN sh.PersonSmokingHistoryBriefAdviceGiven = 1 THEN 'Yes' ELSE 'No' END AS BriefAdviceGiven,#(lf)dss.Rank AS AssessmentRank,#(lf)LAG(dss.Rank) OVER (PARTITION BY sh.PersonID, fr.TeamID ORDER BY sh.PersonSmokingHistoryAssessmentDate) AS PreviousAssessmentRank,#(lf)'M' + CAST(LAG(sh.SmokingStatusId) OVER (PARTITION BY sh.PersonID, fr.TeamID ORDER BY sh.PersonSmokingHistoryAssessmentDate) AS varchar(10)) AS PreviousAssessmentSmokingStatusKey,#(lf)--CASE WHEN sh.PersonSmokingHistorySupportServicesOffered IS NOT NULL AND PersonSmokingHistorySupportServicesOffered <> '' THEN 'Yes' ELSE 'No' END AS SupportServicesOfferedYN,#(lf)CASE WHEN sh.PersonSmokingHistorySupportServicesOffered LIKE '%12228%'#(lf)OR sh.PersonSmokingHistorySupportServicesOffered LIKE '%12229%'#(lf)OR sh.PersonSmokingHistorySupportServicesOffered LIKE '%12230%' THEN 'Yes' ELSE 'No' END AS SupportServicesOfferedYN,#(lf)CASE WHEN sh.PersonSmokingHistorySupportServicesOffered LIKE '%12229%' THEN 'Yes' ELSE 'No' END AS ReferredToExternalCessationSupportServiceYN,#(lf)dss.SmokingStatusValue,#(lf)FLOOR(DATEDIFF(DAY,dp.PersonDateOfBirth,sh.PersonSmokingHistoryAssessmentDate)/365) AS PersonAgeAtAssessmentDate,#(lf)FLOOR(DATEDIFF(DAY,dp.PersonDateOfBirth,GETDATE())/365) AS PersonAgeNow,#(lf)fr.DischargeDate,#(lf)fr.AcceptedDate#(lf)FROM RBMNB.dlFactPersonSmokingHistory sh #(lf)INNER JOIN RBMNB.legacyFactReferral fr#(lf)ON fr.PersonID = sh.PersonID AND sh.PersonSmokingHistoryAssessmentDate BETWEEN fr.AcceptedDate AND COALESCE(fr.DischargeDate,getdate())#(lf)INNER JOIN CTEDimSmokingStatus dss ON sh.SmokingStatusID = dss.SmokingStatusID AND Company = 'MNB'#(lf)LEFT OUTER JOIN RBMNB.dlDimTeam dt ON fr.TeamID = dt.TeamID#(lf)LEFT OUTER JOIN RBMNB.dlDimPerson dp ON sh.PersonID = dp.PersonID#(lf)#(lf)#(lf)UNION#(lf)#(lf)SELECT#(lf)CASE WHEN sh.PersonSmokingHistoryID IS NOT NULL THEN CONCAT('E',sh.PersonSmokingHistoryID) ELSE NULL END AS PersonSmokingHistoryID,#(lf)CASE WHEN sh.PersonID IS NOT NULL THEN CONCAT('E',sh.PersonID) ELSE NULL END AS PersonID,#(lf)COALESCE(#(lf)CASE WHEN dp.Ethnicity1ID IS NOT NULL THEN CONCAT('M',dp.Ethnicity1ID) ELSE NULL END,#(lf)CASE WHEN dp.Ethnicity3ID IS NOT NULL THEN CONCAT('M',dp.Ethnicity3ID) ELSE NULL END,#(lf)CASE WHEN dp.Ethnicity4ID IS NOT NULL THEN CONCAT('M',dp.Ethnicity4ID) ELSE NULL END,#(lf)CASE WHEN dp.Ethnicity5ID IS NOT NULL THEN CONCAT('M',dp.Ethnicity5ID) ELSE NULL END,#(lf)CASE WHEN dp.Ethnicity2ID IS NOT NULL THEN CONCAT('M',dp.Ethnicity2ID) ELSE NULL END#(lf)) AS FirstNonBlankEthnicityID,#(lf)CASE WHEN dp.GenderID IS NOT NULL THEN CONCAT('E',dp.GenderID) ELSE NULL END AS GenderID,#(lf)dp.PersonDateOfBirth,#(lf)CASE WHEN sh.SmokingStatusId IS NOT NULL THEN CONCAT('E',sh.SmokingStatusId) ELSE NULL END AS SmokingStatusId,#(lf)CASE WHEN dt.TeamFunctionID IS NOT NULL THEN CONCAT('E',dt.TeamFunctionID) ELSE NULL END AS TeamFunctionID,#(lf)CASE WHEN fr.TeamID IS NOT NULL THEN CONCAT('E',fr.TeamID) ELSE NULL END AS TeamID,#(lf)CASE WHEN fr.ID IS NOT NULL THEN CONCAT('E',fr.ID) ELSE NULL END AS ReferralID,#(lf)CASE WHEN dt.TeamFunctionID IS NOT NULL AND fr.TeamID IS NOT NULL THEN CONCAT('E',dt.TeamFunctionID,'E',fr.TeamID) ELSE NULL END AS TeamKeyComposite,#(lf)sh.PersonSmokingHistoryAssessmentDate,#(lf)CASE #(lf)#(tab)WHEN fr.AcceptedDate IS NULL THEN 'No' ELSE 'Yes' END AS ActiveReferralAtTimeOfAssessmentExists,#(lf)COALESCE(LEAD(DATEADD(DAY, -1, sh.PersonSmokingHistoryAssessmentDate)) OVER (PARTITION BY sh.PersonID, fr.TeamID ORDER BY sh.PersonSmokingHistoryAssessmentDate),CAST(fr.DischargeDate AS date),CAST(GETDATE() AS date)) AS AssessmentValidTo,#(lf)CASE#(lf)#(tab)WHEN (LEAD(sh.PersonSmokingHistoryAssessmentDate) OVER (PARTITION BY sh.PersonID ORDER BY sh.PersonSmokingHistoryAssessmentDate)) IS NOT NULL#(lf)#(tab)THEN 'DayBeforeNewerAssessment'#(lf)#(tab)WHEN fr.DischargeDate IS NOT NULL THEN 'ReferralDischargeDate'#(lf)#(tab)ELSE 'ValidToToday' END AS AssessmentValidToReason,#(lf)FLOOR(DATEDIFF(DAY, dp.PersonDateofBirth, sh.PersonSmokingHistoryAssessmentDate)/365) AS AgeAtAssessmentDate,#(lf)'EAL',#(lf)CASE WHEN sh.PersonSmokingHistoryBriefAdviceGiven = 1 THEN 'Yes' ELSE 'No' END AS BriefAdviceGiven,#(lf)dss.Rank AS AssessmentRank,#(lf)LAG(dss.Rank) OVER (PARTITION BY sh.PersonID, fr.TeamID ORDER BY sh.PersonSmokingHistoryAssessmentDate) AS PreviousAssessmentRank,#(lf)'E' + CAST(LAG(sh.SmokingStatusId) OVER (PARTITION BY sh.PersonID, fr.TeamID ORDER BY sh.PersonSmokingHistoryAssessmentDate) AS varchar(10)) AS PreviousAssessmentSmokingStatusKey,#(lf)--CASE WHEN sh.PersonSmokingHistorySupportServicesOffered IS NOT NULL AND PersonSmokingHistorySupportServicesOffered <> '' THEN 'Yes' ELSE 'No' END AS SupportServicesOfferedYN,#(lf)CASE WHEN sh.PersonSmokingHistorySupportServicesOffered LIKE '%12228%'#(lf)OR sh.PersonSmokingHistorySupportServicesOffered LIKE '%12229%'#(lf)OR sh.PersonSmokingHistorySupportServicesOffered LIKE '%12230%' THEN 'Yes' ELSE 'No' END AS SupportServicesOfferedYN,#(lf)CASE WHEN sh.PersonSmokingHistorySupportServicesOffered LIKE '%12229%' THEN 'Yes' ELSE 'No' END AS ReferredToExternalCessationSupportServiceYN,#(lf)dss.SmokingStatusValue,#(lf)FLOOR(DATEDIFF(DAY,dp.PersonDateOfBirth,sh.PersonSmokingHistoryAssessmentDate)/365) AS PersonAgeAtAssessmentDate,#(lf)FLOOR(DATEDIFF(DAY,dp.PersonDateOfBirth,GETDATE())/365) AS PersonAgeNow,#(lf)fr.DischargeDate,#(lf)fr.AcceptedDate#(lf)FROM RBEAL.dlFactPersonSmokingHistory sh #(lf)INNER JOIN RBEAL.legacyFactReferral fr#(lf)ON fr.PersonID = sh.PersonID AND sh.PersonSmokingHistoryAssessmentDate BETWEEN fr.AcceptedDate AND COALESCE(fr.DischargeDate,getdate())#(lf)INNER JOIN CTEDimSmokingStatus dss ON sh.SmokingStatusID = dss.SmokingStatusID AND Company = 'EAL'#(lf)LEFT OUTER JOIN RBEAL.dlDimTeam dt ON fr.TeamID = dt.TeamID#(lf)LEFT OUTER JOIN RBEAL.dlDimPerson dp ON sh.PersonID = dp.PersonID#(lf)),#(lf)Final_Table AS (#(lf)SELECT DISTINCT #(lf)t1.PersonID,#(lf)t1.FirstNonBlankEthnicityID,#(lf)t1.GenderID,#(lf)t1.PersonDateOfBirth,#(lf)t1.PersonAgeNow,#(lf)t1.ReferralID,#(lf)t1.AcceptedDate,#(lf)t1.DischargeDate,#(lf)t1.TeamID AS TeamKey, --Fixed by Mike R on 3/12/2024 - was using TeamFunctionID.#(lf)t2.PersonSmokingHistoryAssessmentDate AS DateOfFirstAssessment,#(lf)t2.AssessmentRank AS RankOfFirstAssessment,#(lf)t2.DimSmokingStatusKey AS DimSmokingStatusKeyFirstAssessment,#(lf)t2.AgeAtAssessmentDate AS AgeAtFirstAssessment,#(lf)t2.SmokingStatusValue AS SmokingStatusValueAtFirstAssessment,#(lf)t2.BriefAdviceGiven AS BriefAdviceGivenAtFirstAssessment,#(lf)t2.SupportServicesOfferedYN AS SupportServicesOfferedAtFirstAssessment,#(lf)t2.ReferredToExternalCessationSupportServiceYN AS ReferredToExternalCessationSupportServiceAtFirstAssessment,#(lf)t1.PersonSmokingHistoryAssessmentDate AS DateOfLatestAssessment,#(lf)t1.AssessmentRank AS RankOfLatestAssessment,#(lf)t1.DimSmokingStatusKey AS DimSmokingStatusKeyLatestAssessment,#(lf)t1.AgeAtAssessmentDate AS AgeAtLatestAssessment,#(lf)t1.SmokingStatusValue AS SmokingStatusValueAtLastAssessment,#(lf)t1.BriefAdviceGiven AS BriefAdviceGivenAtLastAssessment,#(lf)t1.SupportServicesOfferedYN AS SupportServicesOfferedAtLastAssessment,#(lf)t1.ReferredToExternalCessationSupportServiceYN AS ReferredToExternalCessationSupportServiceAtLastAssessment,#(lf)t3.NumberOfAssessments#(lf)#(lf)FROM (#(lf)SELECT * FROM (#(lf)    SELECT *,#(lf)           ROW_NUMBER() OVER (PARTITION BY PersonID ORDER BY PersonSmokingHistoryAssessmentDate ASC) AS RowNumberAsc,#(lf)           ROW_NUMBER() OVER (PARTITION BY PersonID ORDER BY PersonSmokingHistoryAssessmentDate DESC) AS RowNumberDesc#(lf)    FROM CTE_Original#(lf)#(tab)) d1 WHERE d1.RowNumberDesc = 1#(lf)#(lf)) AS t1#(lf)#(lf)LEFT OUTER JOIN #(lf)(#(lf)SELECT * FROM (#(lf)    SELECT *,#(lf)           ROW_NUMBER() OVER (PARTITION BY PersonID ORDER BY PersonSmokingHistoryAssessmentDate ASC) AS RowNumberAsc,#(lf)           ROW_NUMBER() OVER (PARTITION BY PersonID ORDER BY PersonSmokingHistoryAssessmentDate DESC) AS RowNumberDesc#(lf)    FROM CTE_Original#(lf)#(tab)) d2 WHERE d2.RowNumberAsc = 1#(lf)) AS t2 #(lf)ON t1.PersonID = t2.PersonID#(lf)#(lf)LEFT OUTER JOIN#(lf)(#(lf)SELECT #(lf)d3.PersonID,#(lf)MAX(NumberOfAssessments) AS NumberOfAssessments#(lf)FROM (#(lf)    SELECT PersonID,#(lf)           ROW_NUMBER() OVER (PARTITION BY PersonID ORDER BY PersonSmokingHistoryAssessmentDate ASC) AS NumberOfAssessments#(lf)    FROM CTE_Original#(lf)#(tab)) d3#(lf)GROUP BY d3.PersonID#(lf)) AS t3#(lf)ON t1.PersonID = t3.PersonID#(lf)WHERE t1.DischargeDate IS NULL#(lf))#(lf)SELECT * from Final_Table -- where PersonID = 'E187355'"]),
