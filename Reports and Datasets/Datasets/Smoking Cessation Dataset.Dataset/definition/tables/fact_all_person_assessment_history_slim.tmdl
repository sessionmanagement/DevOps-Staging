	partition fact_all_person_assessment_history_slim = calculated
		mode: import
		source = ```
				
				// This table has been created specifically for the "Number of current clients whose most recent smoking status is current smoker" measure. Do not join it or use for any other purpose unless you're sure.
				SUMMARIZE(
				    fact_smoking_assessment_explosion, 
				    fact_smoking_assessment_explosion[PersonID], 
				    fact_smoking_assessment_explosion[PersonSmokingHistoryAssessmentDate],
				    "MaxRowNumberAscPerson", MAX(fact_smoking_assessment_explosion[RowNumberAscPerson]),
				    "SmokerStatus", LASTNONBLANK(fact_smoking_assessment_explosion[SmokerOrNonSmoker], 1),
				    "BriefAdviceGiven", LASTNONBLANK(fact_smoking_assessment_explosion[BriefAdviceGiven], 1),
				    "ReferredToCessationServices", LASTNONBLANK(fact_smoking_assessment_explosion[ReferredToExternalCessationSupportServiceYN], 1),
				    "GivenSupportServices", LASTNONBLANK(fact_smoking_assessment_explosion[SupportServicesOfferedYN], 1)
				)
				```

	annotation PBI_Id = ad497ffeab8c4923bf4db22c9310a35c

