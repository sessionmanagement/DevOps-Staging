	partition fact_referral-37b3b13b-edc8-47e1-bed8-c1443f198128 = m
		mode: import
		source =
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="SELECT DISTINCT#(lf)'EAL' AS CompanyIdentifier,#(lf)CAST(lfr.AcceptedDate AS DATE) AS AcceptedDate,#(lf)CASE WHEN CAST(lfr.DischargeDate AS DATE) IS NULL THEN CAST(GETDATE() AS DATE) ELSE CAST(lfr.DischargeDate AS DATE) END AS DischargeDateOrToday,#(lf)CAST(lfr.DischargeDate AS DATE) AS DischargeDateTrue,#(lf)CASE WHEN lfr.ID IS NOT NULL THEN CONCAT('E',lfr.ID) ELSE NULL END AS ID,#(lf)CASE WHEN lfr.PersonID IS NOT NULL THEN CONCAT('E',lfr.PersonID) ELSE NULL END AS PersonID,#(lf)CASE WHEN lfr.TeamID IS NOT NULL THEN CONCAT('E',lfr.TeamID) ELSE NULL END AS TeamID,#(lf)CASE WHEN tf.TeamFunctionID IS NOT NULL THEN CONCAT('E',tf.TeamFunctionID) ELSE NULL END AS TeamFunctionID,#(lf)COALESCE(#(lf)CASE WHEN dp.Ethnicity1ID IS NOT NULL THEN CONCAT('E',dp.Ethnicity1ID) ELSE NULL END,#(lf)CASE WHEN dp.Ethnicity3ID IS NOT NULL THEN CONCAT('E',dp.Ethnicity3ID) ELSE NULL END,#(lf)CASE WHEN dp.Ethnicity4ID IS NOT NULL THEN CONCAT('E',dp.Ethnicity4ID) ELSE NULL END,#(lf)CASE WHEN dp.Ethnicity5ID IS NOT NULL THEN CONCAT('E',dp.Ethnicity5ID) ELSE NULL END,#(lf)CASE WHEN dp.Ethnicity2ID IS NOT NULL THEN CONCAT('E',dp.Ethnicity2ID) ELSE NULL END#(lf)) AS FirstNonBlankEthnicityID,#(lf)CASE WHEN dp.GenderID IS NOT NULL THEN CONCAT('E',dp.GenderID) ELSE NULL END AS GenderID,#(lf)dp.PersonDateOfBirth#(lf)FROM [RBEAL].[legacyFactReferral] lfr#(lf)LEFT OUTER JOIN [RBEAL].[dlDimTeam] t ON t.TeamID = lfr.TeamID#(lf)LEFT OUTER JOIN [RBEAL].[dlDimTeamFunction] tf ON tf.TeamFunctionID = t.TeamFunctionID#(lf)LEFT OUTER JOIN [RBEAL].[dlDimPerson] dp ON dp.PersonID = lfr.PersonID#(lf)WHERE ID IS NOT NULL#(lf)AND AcceptedDate IS NOT NULL#(lf)#(lf)UNION#(lf)#(lf)SELECT DISTINCT#(lf)'MNB' AS CompanyIdentifier,#(lf)CAST(lfr.AcceptedDate AS DATE) AS AcceptedDate,#(lf)CASE WHEN CAST(lfr.DischargeDate AS DATE) IS NULL THEN CAST(GETDATE() AS DATE) ELSE CAST(lfr.DischargeDate AS DATE) END AS DischargeDateOrToday,#(lf)CAST(lfr.DischargeDate AS DATE) AS DischargeDateTrue,#(lf)CASE WHEN lfr.ID IS NOT NULL THEN CONCAT('M',lfr.ID) ELSE NULL END AS ID,#(lf)CASE WHEN lfr.PersonID IS NOT NULL THEN CONCAT('M',lfr.PersonID) ELSE NULL END AS PersonID,#(lf)CASE WHEN lfr.TeamID IS NOT NULL THEN CONCAT('M',lfr.TeamID) ELSE NULL END AS TeamID,#(lf)CASE WHEN tf.TeamFunctionID IS NOT NULL THEN CONCAT('M',tf.TeamFunctionID) ELSE NULL END AS TeamFunctionID,#(lf)COALESCE(#(lf)CASE WHEN dp.Ethnicity1ID IS NOT NULL THEN CONCAT('M',dp.Ethnicity1ID) ELSE NULL END,#(lf)CASE WHEN dp.Ethnicity3ID IS NOT NULL THEN CONCAT('M',dp.Ethnicity3ID) ELSE NULL END,#(lf)CASE WHEN dp.Ethnicity4ID IS NOT NULL THEN CONCAT('M',dp.Ethnicity4ID) ELSE NULL END,#(lf)CASE WHEN dp.Ethnicity5ID IS NOT NULL THEN CONCAT('M',dp.Ethnicity5ID) ELSE NULL END,#(lf)CASE WHEN dp.Ethnicity2ID IS NOT NULL THEN CONCAT('M',dp.Ethnicity2ID) ELSE NULL END#(lf)) AS FirstNonBlankEthnicityID,#(lf)CASE WHEN dp.GenderID IS NOT NULL THEN CONCAT('M',dp.GenderID) ELSE NULL END AS GenderID,#(lf)dp.PersonDateOfBirth#(lf)FROM [RBMNB].[legacyFactReferral] lfr#(lf)LEFT OUTER JOIN [RBMNB].[dlDimTeam] t ON t.TeamID = lfr.TeamID#(lf)LEFT OUTER JOIN [RBMNB].[dlDimTeamFunction] tf ON tf.TeamFunctionID = t.TeamFunctionID#(lf)LEFT OUTER JOIN [RBMNB].[dlDimPerson] dp ON dp.PersonID = lfr.PersonID#(lf)WHERE ID IS NOT NULL#(lf)AND AcceptedDate IS NOT NULL"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"AcceptedDate", type date}, {"DischargeDateOrToday", type date}, {"DischargeDateTrue", type date}}),
				    #"Renamed Columns" = Table.RenameColumns(#"Changed Type",{{"TeamID", "TeamKey"}}),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Renamed Columns",{{"AcceptedDate", Int64.Type}, {"DischargeDateOrToday", Int64.Type}}),
				    #"Added Custom" = Table.AddColumn(#"Changed Type1", "ReferralExplosion", each {[AcceptedDate]..[DischargeDateOrToday]}),
				    #"Expanded ReferralExplosion" = Table.ExpandListColumn(#"Added Custom", "ReferralExplosion"),
				    #"Changed Type2" = Table.TransformColumnTypes(#"Expanded ReferralExplosion",{{"ReferralExplosion", type date}, {"AcceptedDate", type date}, {"DischargeDateOrToday", type date}, {"PersonDateOfBirth", type date}})
				in
				    #"Changed Type2"

