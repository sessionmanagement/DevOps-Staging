	partition ChangeLog = m
		mode: import
		source =
				let
				    // Define the table schema without the ChangeID column
				    InitialTable = #table(
				        {"Version", "Change Date", "Changed By", "User Story ID", "Description"},
				        {
				            {
				                "1.0.2",
				                #date(2024, 1, 1),  /* Placeholder date - update with actual date when known */
				                "N/A",
				                "#7392",
				                "Fixed RLS issue #7392"
