				                "N/A",
				                "#7300",
				                "ODS RLS"
				            },
				            {
				                "1.1.1",
				                #date(2024, 1, 1),  /* Placeholder date - update with actual date when known */
				                "N/A",
				                "#7620",
				                "point dim_date to production server and database"
				            },
				            {
				                "1.1.2",
				                #date(2024, 1, 1),  /* Placeholder date - update with actual date when known */
				                "N/A",
				                "#7988",
				                "Formatted Smoking Status to capitalize each word for better readability in visuals"
				            },
				            {
				                "1.1.3",
				                #date(2024, 1, 1),  /* Placeholder date - update with actual date when known */
				                "N/A",
				                "#8107",
				                "Fixed All Access RLS"
				            },
				                {
				                "1.1.4", /* Version: Update this to the new version number */
				                #date(2024, 7, 9),  /* Change Date: Update year, month, day */
				                "Mike R",  /* Changed By: Update with the name of the person making the change, or leave as "N/A" */
				                "8197",  /* User Story ID: Update if applicable, otherwise leave as "N/A" */
				                "Add mechanism for closed teams to be easily filtered out by the user"  /* Description: Provide a brief description of the change */
				            },
				                {
				                "1.1.5", /* Version: Update this to the new version number */
				                #date(2024, 8, 20),  /* Change Date: Update year, month, day */
				                "Mike R",  /* Changed By: Update with the name of the person making the change, or leave as "N/A" */
				                "8197",  /* User Story ID: Update if applicable, otherwise leave as "N/A" */
				                "Updated Applied Filters measures to support new filter for team status and modernise it"  /* Description: Provide a brief description of the change */
				            },
				                {
				                "1.2.0", /* Version: Update this to the new version number */
				                #date(2024, 11, 04),  /* Change Date: Update year, month, day */
				                "Mike G",  /* Changed By: Update with the name of the person making the change, or leave as "N/A" */
				                "9196",  /* User Story ID: Update if applicable, otherwise leave as "N/A" */
				                "New RLS"  /* Description: Provide a brief description of the change */
				            },
				            {
				                "1.3.0", /* Version: Update this to the new version number */
				                #date(2024, 12, 02),  /* Change Date: Update year, month, day */
				                "Mike G",  /* Changed By: Update with the name of the person making the change, or leave as "N/A" */
				                "9385",  /* User Story ID: Update if applicable, otherwise leave as "N/A" */
				                "RLS - New RB Structure ALL services"  /* Description: Provide a brief description of the change */
				            }
				        }
				    ),
				
				    // Add an Index column to generate incremental numbers (Change ID)
				    // This automatically assigns a unique ID to each entry
				    TableWithIndex = Table.AddIndexColumn(InitialTable, "Change ID", 1, 1, Int64.Type),
				
				    // Reorder the columns to place ChangeID first
				    // This ensures the Change ID appears as the first column in the final table
				    ReorderedColumns = Table.ReorderColumns(TableWithIndex, {"Change ID", "Version", "Change Date", "Changed By", "User Story ID", "Description"})
				in
				    ReorderedColumns
				
				// How to add a new entry:
				// 1. Copy the template entry block from the InitialTable
				// 2. Paste it above the comment "Entries from the image"
				// 3. Update the information in each field:
				//    - "Version": Update to the new version number
				//    - #date(): Update the year, month, and day (currently set to 2024-01-01 as placeholder)
				//    - "Changed By": Update with the name of the person making the change, or leave as "N/A"
				//    - "User Story ID": Update with the relevant ID (e.g., "#1234")
				//    - "Description": Provide a brief description of the change
				// 4. Ensure there's a comma after the closing brace } of the previous entry
				// 5. Remove the comma after the closing brace } of the last entry in the list
				
				// Note: The Change ID will be automatically assigned when the query is refreshed

