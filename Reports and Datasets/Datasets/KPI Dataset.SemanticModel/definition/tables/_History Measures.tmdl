	measure 'Achieving % Diff (Latest vs Prev)' =
			
			VAR _LatestSnap =
			    CALCULATE (
			        MAX ( 'Fact History'[Snapshot Date] ),
			        ALLSELECTED ( 'Fact History'[Snapshot Date] )
			    )
			VAR _PrevSnap =
			    CALCULATE (
			        MAX ( 'Fact History'[Snapshot Date] ),
			        FILTER (
			            ALLSELECTED ( 'Fact History'[Snapshot Date] ),
			            'Fact History'[Snapshot Date] < _LatestSnap
			        )
			    )
			VAR _LatestPct =
			    CALCULATE (
			        [Hist_Percentage Achieving %],
			        'Fact History'[Snapshot Date] = _LatestSnap
			    )
			VAR _PrevPct =
			    CALCULATE (
			        [Hist_Percentage Achieving %],
			        'Fact History'[Snapshot Date] = _PrevSnap
			    )
			RETURN
			    IF (
			        ISBLANK ( _PrevSnap ),
			        BLANK (),
			        _LatestPct - _PrevPct
			    )
