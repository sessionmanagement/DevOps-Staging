	measure 'Hist_Percentage Review %' = ```
			
			 VAR _Green =   COALESCE(CALCULATE (
			        COUNTROWS (
			            SUMMARIZE (
			                'Fact History',
			                'Fact History'[Entity KEY],
			                'Fact History'[KPI Value],
			                'Fact History'[Kpi ID]
			            )
			        ),
			        'Fact History'[KPI Status] = "Achieving"
			    ), 0)
			
			
			VAR _Amber = 
			 COALESCE(CALCULATE (
			        COUNTROWS (
			            SUMMARIZE (
			                'Fact History',
			                'Fact History'[Entity KEY],
			                'Fact History'[KPI Value],
			                'Fact History'[Kpi ID]
			            )
			        ),
			        'Fact History'[KPI Status] = "Review"
			    ), 0)
			
			VAR _Red = 
			COALESCE(CALCULATE (
			        COUNTROWS (
			            SUMMARIZE (
			                'Fact History',
			                'Fact History'[Entity KEY],
			                'Fact History'[KPI Value],
			                'Fact History'[Kpi ID]
			            )
			        ),
			        'Fact History'[KPI Status] = "Take Action"
			    ), 0)
			RETURN
			IF(_Amber = 0, 0,
			DIVIDE(_Amber,(_Green+_Amber+_Red))
			)
			```
		formatString: 0%;-0%;0%
