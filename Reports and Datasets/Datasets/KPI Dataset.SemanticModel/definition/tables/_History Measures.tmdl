table '_History Measures'
	excludeFromModelRefresh
	lineageTag: 209d7e86-114d-40d4-943f-b71fa975e4c9

	measure 'Hist_Percentage Take Action %' = ```
			
			VAR _Green = 
			 CALCULATE (
			        COUNTROWS (
			            SUMMARIZE (
			                'Fact History',
			                'Fact History'[Entity KEY],
			                'Fact History'[KPI Value],
			                'Fact History'[Kpi ID]
			            )
			        ),
			        'Fact History'[KPI Status] = "Achieving"
			    )
			
			VAR _Amber = 
			 CALCULATE (
			        COUNTROWS (
			            SUMMARIZE (
			                'Fact History',
			                'Fact History'[Entity KEY],
			                'Fact History'[KPI Value],
			                'Fact History'[Kpi ID]
			            )
			        ),
			        'Fact History'[KPI Status] = "Review"
			    )
			
			VAR _Red = 
			
			    CALCULATE (
			        COUNTROWS (
			            SUMMARIZE (
			                'Fact History',
			                'Fact History'[Entity KEY],
			                'Fact History'[KPI Value],
			                'Fact History'[Kpi ID]
			            )
			        ),
			        'Fact History'[KPI Status] = "Take Action"
			    )
			
			
			RETURN
			DIVIDE(_Red,(_Green+_Amber+_Red))
			```
		formatString: 0%;-0%;0%
		lineageTag: a5cd18aa-e7e7-4aa7-910e-3bb3e2bf3b81

	measure 'Take Action % Diff (Latest vs Prev)' =
			
			VAR _LatestSnap =
			    CALCULATE (
			        MAX ( 'Fact History'[Snapshot Date] ),
			        ALLSELECTED ( 'Fact History'[Snapshot Date] )
			    )
			VAR _PrevSnap =
			    CALCULATE (
			        MAX ( 'Fact History'[Snapshot Date] ),
			        FILTER (
			            ALLSELECTED ( 'Fact History'[Snapshot Date] ),
			            'Fact History'[Snapshot Date] < _LatestSnap
			        )
			    )
			VAR _LatestPct =
			    CALCULATE (
			        [Hist_Percentage Take Action %],
			        'Fact History'[Snapshot Date] = _LatestSnap
			    )
			VAR _PrevPct =
			    CALCULATE (
			        [Hist_Percentage Take Action %],
			        'Fact History'[Snapshot Date] = _PrevSnap
			    )
			RETURN
			    IF (
			        ISBLANK ( _PrevSnap ),
			        BLANK (),
			        _LatestPct - _PrevPct
			    )
		formatString: 0%;-0%;0%
		lineageTag: 7597b6b0-3385-4650-a808-649e444df27c

	measure 'Top Take Action diff (Measure)' =
			
			VAR Summary =
			    ADDCOLUMNS (
			        SUMMARIZE ( 'Dim KPI', 'Dim KPI'[Sim Title] ),
			        "__Value", [Take Action % Diff (Latest vs Prev)]
			    )
			
			VAR TopValue =
			    MAXX ( Summary, [__Value] )
			
			VAR TopSimTitle =
			    MAXX (
			        FILTER ( Summary, [__Value] = TopValue ),
			        'Dim KPI'[Sim Title]
			    )
			
			
			
			RETURN
			TopSimTitle & "   (" & FORMAT(TopValue, "+0%;-0%;0%" ) & ")"
		lineageTag: b56a94a0-8d10-4146-9d12-496409fc0745

	measure 'Top Take action diff (Region) VAR Summary' = ```
			
			
			VAR Summary =
			    // ADDCOLUMNS (
			    //     SUMMARIZE ( 'Dim Service', 'Dim Service'[Region Name] ),
			    //     "__Value", [Take Action % Diff (Latest vs Prev)]
			    // )
			      ADDCOLUMNS (
			    FILTER (
			        SUMMARIZE ( 
			            'Dim Service', 
			            'Dim Service'[Region Name] 
			        ),
			        NOT (
			            ISBLANK ( 'Dim Service'[Region Name] ) ||
			            'Dim Service'[Region Name] = "N/A" ||
			            'Dim Service'[Region Name] = "Unknown"
			        )
			    ),
			    "__Value", [Take Action % Diff (Latest vs Prev)]
			)
			
			VAR TopValue =
			    MAXX ( Summary, [__Value] )
			
			VAR TopRegion =
			    MAXX (
			        FILTER ( Summary, [__Value] = TopValue ),
			        'Dim Service'[Region Name]
			    )
			
			
			
			RETURN
			TopRegion & "   (" & FORMAT(TopValue, "+0%;-0%;0%" ) & ")"
			
			```
		lineageTag: 487d8252-a13e-4a72-898b-430f7277b9c4

