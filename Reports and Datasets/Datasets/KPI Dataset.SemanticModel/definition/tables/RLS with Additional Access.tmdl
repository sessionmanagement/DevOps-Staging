	column 'Relevant Bu'
		dataType: string
		lineageTag: fafc87b8-020a-4bb4-b5ed-842869af3485
		summarizeBy: none
		sourceColumn: Relevant Bu

		annotation SummarizationSetBy = Automatic

	partition 'RLS with Additional Access' = m
		mode: import
		queryGroup: 'RLS\RLS - RB'
		source =
				let
				    // Load both tables
				    RowLevelSecurity = @#"RLS - New RB Structure ALL services",
				    AdditionalAccess = #"Additional Access",
				    // Join tables
				    JoinedTable = Table.Join(
				        AdditionalAccess, "Person to Impersonate Email", RowLevelSecurity, "User Principal Name", JoinKind.RightOuter
				    ),
				
				    #"Added Conditional Column" = Table.AddColumn(
				        JoinedTable, "Custom", each if [Requester Email] = null then [User Principal Name] else [Requester Email]
				    ),
				
				    #"Removed Columns" = Table.RemoveColumns(
				        #"Added Conditional Column",
				        {
				            "Report",
				            "Requester Email",
				            "Person to Impersonate Email",
				            "Expiry Date",
				            "Access Reason",
				            "Approved By Email",
				            "Approved Date",
				            "Modified",
				            "Created",
				            "Created By Email",
				            "Modified By Email",
				            "Version",
				            "User Principal Name"
				        }
				    ),
				
				    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns", {{"Custom", "User Principal Name"}}),
				
				    #"Reordered Columns" = Table.ReorderColumns(
				        #"Renamed Columns", {"User Principal Name"}
				    ),
				
				    #"Changed Type" = Table.TransformColumnTypes(#"Reordered Columns", {{"User Principal Name", type text}}),
				    #"Appended Query" = Table.Combine({#"Changed Type", #"RLS - New RB Structure ALL services"}),
				    #"Removed Duplicates" = Table.Distinct(#"Appended Query"),
				    #"Merged Queries1" = Table.NestedJoin(#"Removed Duplicates", {"Employee Job Name"}, Persona, {"Role"}, "Persona", JoinKind.LeftOuter),
				    #"Expanded Persona" = Table.ExpandTableColumn(#"Merged Queries1", "Persona", {"Proposed persona"}, {"Proposed persona"}),
				    #"Added Conditional Column1" = Table.AddColumn(#"Expanded Persona", "Persona", each if [Proposed persona] = null then "Exec & Senior Leaders" else [Proposed persona], type text),
				    #"Removed Columns1" = Table.RemoveColumns(#"Added Conditional Column1",{"Proposed persona"}),
				    Custom2 = Table.AddColumn(
				    #"Removed Columns1",
				    "Relevant Bu",
				    each
				        let
				            dept = if [Department Name] = null then "" else Text.Trim([Department Name]),
				            reg  = if [Region Name]   = null then "" else Text.Trim([Region Name]),
				            comp = [Dim Company KEY]
				        in
				            if dept = "" and Text.Contains(reg, "Tenancy", Comparer.OrdinalIgnoreCase) then "Tenancy"
				            else if dept = "" and reg = "" and comp = 6 then "Unknown"
				            else if Text.Contains(dept, "Health", Comparer.OrdinalIgnoreCase) and Text.Contains(dept, "Disability", Comparer.OrdinalIgnoreCase) then "Health & Disability"
				            else if Text.Contains(dept, "Peer", Comparer.OrdinalIgnoreCase) then "Health & Disability"
				            else if Text.Contains(dept, "Housing", Comparer.OrdinalIgnoreCase) then "Housing"
				            else if Text.Contains(dept, "Tenancy", Comparer.OrdinalIgnoreCase) then "Tenancy"
				            else if Text.Contains(dept, "Owned", Comparer.OrdinalIgnoreCase) then "Tenancy"
				            else if Text.Contains(dept, "Leased", Comparer.OrdinalIgnoreCase) then "Tenancy"
				            else if Text.Contains(dept, "Shared", Comparer.OrdinalIgnoreCase) then "Shared Services"
				            else "Unknown"
				)
				in
				    Custom2

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Exception

