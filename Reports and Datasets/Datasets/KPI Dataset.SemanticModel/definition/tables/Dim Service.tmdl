		annotation SummarizationSetBy = Automatic

	partition 'Dim Service' = m
		mode: import
		queryGroup: 'EDW Dim Tables'
		source = ```
				let
				    Source = Sql.Database(Server, Database, [Query="SELECT  [dim_service_key]#(lf)      ,[dim_company_key]#(lf)      ,[service_id]#(lf)      ,[dim_service_unique_key]#(lf)      ,[service_code]#(lf)      ,[service_name]#(lf)      #(lf)      #(lf)      ,[service_type_code]#(lf)      ,[service_type_name]#(lf)      ,[department_code]#(lf)      ,[department_name]#(lf)      ,[district_code]#(lf)      ,[district_name]#(lf)      ,[region_code]#(lf)      ,[region_name]#(lf)      #(lf)    #(lf)      ,[company_name]#(lf)      ,[service_last_modified_date_time]#(lf)     #(lf)      ,[DWHIsCurrent]#(lf)  FROM [edw].[vw_dim_service]#(lf)  WHERE DWHDMLOperation <> 'd'"]),
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceKaimahi = Text.Replace(columnName, "employee_", "Kaimahi_"),
				            replaceClient = Text.Replace(replaceKaimahi, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, each ApplyNamingConventions(_)),
				    #"Merged Queries" = Table.NestedJoin(#"Transformed Column Names", {"Dim Service KEY"}, #"Dim Target Definitions", {"Dim Service KEY"}, "Dim Target Definitions", JoinKind.LeftOuter),
				    #"Expanded Dim Target Definitions" = Table.ExpandTableColumn(#"Merged Queries", "Dim Target Definitions", {"Service Action Plan Link"}, {"Dim Target Definitions.Service Action Plan Link"}),
				    #"Added Tenancy Column" = Table.AddColumn(
				        #"Expanded Dim Target Definitions",
				        "Tenancy District Name",
				        each if List.Contains(
				            {
				                "Pam Hollows - Tenancy Manager",
				                "Cairy Timpson - Tenancy Manager",
				                "Kate Zabranski-Todd - Tenancy Manager",
				                "Bridget White - Tenancy Manager",
				                "Paull Hart-Tahi - Tenancy Manager",
				                "Hardy Narang - Tenancy Manager",
				                "Tenancy Manager",
				                "Nikita Safole - Tenancy Manager",
				                "Lynda Peach - Tenancy Manager",
				                "Julie Rogers - Tenancy Manager"
				            },
				            [District Name]
				        ) then "Tenancy Manager" else [District Name] 
				    ),
				    #"Removed Columns1" = Table.RemoveColumns(#"Added Tenancy Column",{"District Name"}),
				    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns1",{{"Tenancy District Name", "District Name"}}),
				    Custom1 = Table.AddColumn(#"Renamed Columns", "Business Unit", each let
				            dept = if [Department Name] = null then "" else Text.Trim([Department Name]),
				            reg  = if [Region Name]   = null then "" else Text.Trim([Region Name]),
				            comp = [Dim Company KEY]
				        in
				            if dept = "" and Text.Contains(reg, "Tenancy", Comparer.OrdinalIgnoreCase) then "Tenancy"
				            else if dept = "" and reg = "" and comp = 6 then "Unknown"
				            else if Text.Contains(dept, "Health", Comparer.OrdinalIgnoreCase) and Text.Contains(dept, "Disability", Comparer.OrdinalIgnoreCase) then "Health & Disability"
				            else if Text.Contains(dept, "Peer", Comparer.OrdinalIgnoreCase) then "Health & Disability"
				            else if Text.Contains(dept, "Housing", Comparer.OrdinalIgnoreCase) then "Housing"
				            else if Text.Contains(dept, "Tenancy", Comparer.OrdinalIgnoreCase) then "Tenancy"
				            else if Text.Contains(dept, "Owned", Comparer.OrdinalIgnoreCase) then "Tenancy"
				            else if Text.Contains(dept, "Leased", Comparer.OrdinalIgnoreCase) then "Tenancy"
				            else if Text.Contains(dept, "Shared", Comparer.OrdinalIgnoreCase) then "Shared Services"
				            else "Unknown")
				in
				    Custom1
				```

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

