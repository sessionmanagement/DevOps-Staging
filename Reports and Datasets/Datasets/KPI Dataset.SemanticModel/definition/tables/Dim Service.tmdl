	column Service_Name_(abbrev) = ```
			
			IF(
			    SEARCH("Emergency Housing", 'Dim Service'[Service Name], 1, 0) > 0, 
			    "EH " & MID('Dim Service'[Service Name], SEARCH("Housing", 'Dim Service'[Service Name], 1) + 7, LEN('Dim Service'[Service Name])), 
			
			IF(
			    SEARCH("SNG Motels", 'Dim Service'[Service Name], 1, 0) > 0, 
			    "SNG " & MID('Dim Service'[Service Name], SEARCH("Motels", 'Dim Service'[Service Name], 1) + 6, LEN('Dim Service'[Service Name])),
			
			IF(
			    SEARCH("Sustaining Tenancies", 'Dim Service'[Service Name], 1, 0) > 0, 
			    "ST " & MID('Dim Service'[Service Name], SEARCH("Tenancies", 'Dim Service'[Service Name], 1) + 9, LEN('Dim Service'[Service Name])),
			
			    'Dim Service'[Service Name]
			)))
			```
		lineageTag: 716365bb-be61-4634-8234-4dcdf6c3fc24
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

