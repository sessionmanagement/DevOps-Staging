	column 'Entity Type' =
			SWITCH(
			    TRUE(),
			    LEFT('Fact KPI'[Entity KEY], 3) = "555", "Service",
			    LEFT('Fact KPI'[Entity KEY], 3) = "666", "Kaimahi",
			    LEFT('Fact KPI'[Entity KEY], 3) = "777", "Property",
			    LEFT('Fact KPI'[Entity KEY], 3) = "888", "Tenancy",
			    LEFT('Fact KPI'[Entity KEY], 3) = "999", "Referral",
			    ""
			)
