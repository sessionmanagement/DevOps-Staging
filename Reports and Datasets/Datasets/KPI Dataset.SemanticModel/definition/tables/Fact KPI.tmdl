	partition 'Fact KPI' = m
		mode: import
		queryGroup: 'Dataset Fact Tables'
		source = ```
				let
				    Source = Sql.Database(Server, Database, [Query="SELECT#(lf)    [dim_kpi_key],#(lf)    [dim_company_key],#(lf)    [dim_employee_key],#(lf)    [dim_property_key],#(lf)    [dim_property_tenancy_key],#(lf)    [kpi_id],#(lf)    [service_id],#(lf)    [client_referral_id],#(lf)    [entity_key],#(lf)    [kpi_value],#(lf)    [user_friendly_score_explanation],#(lf)    [kpi_status],#(lf)    [snapshot_date]#(lf)FROM [kpi].[fact_kpi_current];"]),
				    TestRows = #"Test KPIs Combined",
				    TestKpiIds = List.Buffer(List.Distinct(TestRows[kpi_id])),
				    ProdMinusTest = Table.SelectRows(Source, each not List.Contains(TestKpiIds, [kpi_id])),
				    edw_dim_company = Table.Combine({ProdMinusTest, TestRows}),
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceKaimahi = Text.Replace(columnName, "employee_", "Kaimahi_"),
				            replaceClient = Text.Replace(replaceKaimahi, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transformed Column Names" = Table.TransformColumnNames(edw_dim_company, each ApplyNamingConventions(_)),
				    #"Filtered Rows" = Table.SelectRows(#"Transformed Column Names", each not (List.Contains({12, 26, 71, 92}, [Kpi ID]) and not List.Contains(TestKpiIds, [Kpi ID]))),
				    #"Added Conditional Column" = Table.AddColumn(#"Filtered Rows", "Custom", each if [Kpi Status] = 3 then "Achieving" else if [Kpi Status] = 1 then "Take Action" else if [Kpi Status] = 2 then "Review" else null, type text),
				    #"Removed Columns1" = Table.RemoveColumns(#"Added Conditional Column",{"Kpi Status"}),
				    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns1",{{"Custom", "KPI Status"}}),
				    #"Added Custom" = Table.AddColumn(#"Renamed Columns", "Service_Grouping_KEY", each 
				            Text.From([Dim Company KEY]) & Text.From([Service ID]) & Text.From([Kpi ID])
				        ),
				    Custom1 = Table.AddColumn(#"Added Custom", "Tenancy_Grouping_KEY", each if  Text.StartsWith([Entity KEY], "777") then 
				            Text.From([Dim Company KEY]) & Text.From([Dim Property KEY]) & Text.From([Kpi ID])
				        else if Text.StartsWith([Entity KEY], "888") then 
				            Text.From([Dim Company KEY]) & Text.From([Dim Property Tenancy KEY]) & Text.From([Kpi ID])
				       
				        else 
				            null),
				    #"Merged Queries" = Table.NestedJoin(Custom1, {"Service ID"}, #"Dim Service_current", {"Service ID"}, "Dim Service", JoinKind.LeftOuter),
				    #"Expanded Dim Service1" = Table.ExpandTableColumn(#"Merged Queries", "Dim Service", {"Dim Service KEY"}, {"Dim Service.Dim Service KEY"}),
				    #"Renamed Columns1" = Table.RenameColumns(#"Expanded Dim Service1",{{"Dim Service.Dim Service KEY", "Latest_Dim Service KEY"}}),
				    #"Reordered Columns" = Table.ReorderColumns(#"Renamed Columns1",{"Fact Kpi ID", "Dim Kpi KEY", "Dim Company KEY", "Dim Kaimahi KEY", "Dim Tangata Whaiora KEY", "Dim Tangata Whaiora Referral KEY", "Dim Property KEY", "Dim Property Tenancy KEY", "Dim Service KEY", "Latest_Dim Service KEY", "Kpi ID", "Service ID", "Kaimahi ID", "Tangata Whaiora ID", "Tangata Whaiora Referral ID", "Property ID", "Property Tenancy ID", "Entity KEY", "Kpi Value", "User Friendly Score Explanation", "Snapshot Date", "KPI Status", "Service_Grouping_KEY"}),
				    Custom2 = Table.AddColumn(#"Reordered Columns", "Entity_KPI_KEY", each 
				            Text.From([Entity KEY]) & Text.From([Kpi ID])
				        ),
				    Addcolumn    = Table.AddColumn(#"Custom2", "KPI_BU_KEY", each 
				            Text.From([Service ID]) & "_" & Text.From([Kpi ID])
				        )
				in
				    Addcolumn
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Exception

