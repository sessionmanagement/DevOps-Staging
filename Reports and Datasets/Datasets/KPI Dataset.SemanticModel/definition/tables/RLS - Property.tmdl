		source =
				let
				    Source = Sql.Database(Server, Database, [Query="-- ============================================================#(lf)-- Model:  KPI Dataset#(lf)-- Table:  RLS - Property#(lf)-- Source: native query (complex CTE/window) - emitted in full#(lf)-- Used columns: 2 (mapped 2, unmapped 0)  [full query, not trimmed]#(lf)-- Auto-generated from pbi_complete_dump.csv + model M + EDW/ODS schema.#(lf)-- Review before use; verify joins/filters against the model.#(lf)-- ============================================================#(lf)-- USED model columns: Dim Property KEY; User Principal Name#(lf)#(lf)WITH LatestTenancy AS (#(lf)    SELECT #(lf)        dpt.property_tenancy_manager_name AS property_assigned_tenancy_manager,#(lf)        dpt.property_id,#(lf)        dpt.property_tenancy_tenancy_start_date,#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY dpt.property_id #(lf)            ORDER BY dpt.property_tenancy_tenancy_start_date DESC#(lf)        ) AS rn#(lf)    FROM edw.vw_dim_property_tenancy dpt#(lf)    WHERE #(lf)        dpt.DWHDMLOperation <> 'D'#(lf)        AND dpt.DWHIsCurrent = 1#(lf)        AND dpt.property_tenant_opportunity_status NOT IN ('cancelled')#(lf)),#(lf)#(lf)tenancy_managers AS (#(lf)SELECT #(lf)    lt.property_assigned_tenancy_manager,#(lf)    p.property_name,#(lf)    p.dim_property_key,#(lf)    p.property_status,#(lf)    p.property_id#(lf)FROM edw.vw_dim_property p#(lf)JOIN LatestTenancy lt#(lf)    ON p.property_id = lt.property_id#(lf)    AND lt.rn = 1  -- only keep the latest tenancy record#(lf)WHERE #(lf)    p.DWHDMLOperation <> 'D'#(lf)    AND p.DWHIsCurrent = 1#(lf)    AND p.property_id IS NOT NULL#(lf)    AND p.property_statuscode <> 'disposed'#(lf)    AND lt.property_assigned_tenancy_manager IS NOT NULL   #(lf)#(lf)),#(lf)employee_hierarchy AS (#(lf)    SELECT#(lf)        deh.employee_id,#(lf)        deh.employee_primary_email_address,#(lf)        tm.property_id,#(lf)        tm.property_name,#(lf)        tm.property_status,#(lf)        tm.dim_property_key,#(lf)        hierarchy_levels.level_number,#(lf)        hierarchy_levels.leader_email#(lf)    FROM edw.dim_employee_hierarchy deh#(lf)    INNER JOIN edw.dim_employee de#(lf)        ON deh.employee_id = de.employee_id#(lf)        AND de.DWHDMLOperation <> 'D'#(lf)        AND de.DWHIsCurrent = 1#(lf)   INNER JOIN tenancy_managers tm#(lf)    ON tm.property_assigned_tenancy_manager COLLATE Latin1_General_CI_AI =  #(lf)       LTRIM(RTRIM(#(lf)           CASE #(lf)               WHEN CHARINDEX('(', deh.employee_displayname) > 0 #(lf)                    AND CHARINDEX(')', deh.employee_displayname) > CHARINDEX('(', deh.employee_displayname)#(lf)               THEN #(lf)                   REPLACE(#(lf)                       STUFF(#(lf)                           deh.employee_displayname,#(lf)                           CHARINDEX('(', deh.employee_displayname),#(lf)                           CHARINDEX(')', deh.employee_displayname) - CHARINDEX('(', deh.employee_displayname) + 1,#(lf)                           ''#(lf)                       ), '  ', ' '#(lf)                   )#(lf)               ELSE deh.employee_displayname#(lf)           END#(lf)       ))#(lf)#(lf)#(lf)#(lf)    CROSS APPLY (#(lf)        VALUES#(lf)            (1, employee_people_leader_email_level_1),#(lf)            (2, employee_people_leader_email_level_2),#(lf)            (3, employee_people_leader_email_level_3),#(lf)            (4, employee_people_leader_email_level_4),#(lf)            (5, employee_people_leader_email_level_5),#(lf)            (6, employee_people_leader_email_level_6),#(lf)            (7, employee_people_leader_email_level_7),#(lf)            (8, employee_people_leader_email_level_8),#(lf)            (9, employee_people_leader_email_level_9)#(lf)    ) AS hierarchy_levels(level_number, leader_email)#(lf)    WHERE deh.DWHDMLOperation <> 'D'#(lf)    AND deh.DWHIsCurrent = 1#(lf)    AND deh.employee_company_name COLLATE Latin1_General_CI_AI#(lf)        NOT IN ('previous business entity', 'ignite aotearoa')#(lf)    AND hierarchy_levels.leader_email IS NOT NULL#(lf))#(lf)#(lf)    #(lf)#(lf)   SELECT DISTINCT#(lf)        property_id,#(lf)        dim_property_key,#(lf)        property_name,#(lf)        leader_email AS user_principal_name#(lf)    FROM employee_hierarchy#(lf) rls_access#(lf)WHERE leader_email IS NOT NULL;#(lf)#(lf)-- Row filter(s) defined in REFERENCED Power Query expressions (verify which apply to this source before adding to WHERE):#(lf)--   each ([Requester Email] <> null)#(lf)--   each [Expiry Date] >= Date.From(DateTime.LocalNow())#(lf)--   each ([Report] = ""KPI Dataset"")#(lf)"]),
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
