		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition 'KPI Test Comparison' = m
		mode: import
		queryGroup: 'KPI Testing'
		source =
				let
				    // Formula-firewall safe: prod data comes from a dedicated source query (#"Prod KPI Snapshot"),
				    // and the test kpi_ids filter it LOCALLY. No data-source call consumes another query's data.
				    testIds = List.Buffer(List.Distinct(#"Test KPIs Combined"[kpi_id])),
				    prodForTest = if List.IsEmpty(testIds) then #table(type table [kpi_id = Int64.Type, service_id = Int64.Type, kpi_status = Int64.Type, kpi_value = number, entity_key = text], {}) else Table.SelectRows(#"Prod KPI Snapshot", each List.Contains(testIds, [kpi_id])),
				    prodTagged = Table.AddColumn(prodForTest, "Version", each "Current (prod)", type text),
				    newSel = Table.SelectColumns(#"Test KPIs Combined", {"kpi_id", "service_id", "kpi_status", "kpi_value", "entity_key"}, MissingField.UseNull),
				    newTagged = Table.AddColumn(newSel, "Version", each "New (test)", type text),
				    both = Table.Combine({prodTagged, newTagged}),
				    grouped = Table.Group(both, {"kpi_id", "Version"}, {
				        {"Rows", each Table.RowCount(_), Int64.Type},
				        {"Entities", each List.Count(List.Distinct(List.RemoveNulls(_[entity_key]))), Int64.Type},
				        {"Green", each List.Count(List.Select(_[kpi_status], each _ = 3)), Int64.Type},
				        {"Amber", each List.Count(List.Select(_[kpi_status], each _ = 2)), Int64.Type},
				        {"Red", each List.Count(List.Select(_[kpi_status], each _ = 1)), Int64.Type},
				        {"Avg Value", each List.Average(List.RemoveNulls(_[kpi_value])), type number},
				        {"Sum Value", each List.Sum(List.RemoveNulls(_[kpi_value])), type number}
				    }),
				    sorted = Table.Sort(grouped, {{"kpi_id", Order.Ascending}, {"Version", Order.Descending}})
				in
				    sorted

	annotation PBI_ResultType = Exception

	annotation PBI_NavigationStepName = Navigation

