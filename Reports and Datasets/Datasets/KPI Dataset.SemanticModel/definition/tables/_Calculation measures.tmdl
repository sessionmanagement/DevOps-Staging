table '_Calculation measures'
	excludeFromModelRefresh
	lineageTag: eba018af-685d-4dd1-be0a-ba0e93d2141d

	measure Driver_Percentage =
			
			VAR SelectedDrivers =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Dim KPI'[Related Outcome] ),
			        ALLSELECTED ( 'Dim KPI'[Related Outcome] )
			    )
			VAR X =
			    [Number of Achieving Items]
			VAR Y =
			    DISTINCTCOUNT('Fact KPI'[Entity KEY])
			RETURN
			    IF ( SelectedDrivers = 1, DIVIDE ( X, Y ), "" )
		formatString: 0%;-0%;0%
		lineageTag: 00a55ebb-b2dc-4d9b-81f8-c034b3778ff0

	measure 'Number of Review Items' = ```
			
			
			 COALESCE(CALCULATE (
			        COUNTROWS (
			            SUMMARIZE (
			                'Fact KPI',
			                'Fact KPI'[Entity KEY],
			                'Fact KPI'[KPI Value],
			                'Fact KPI'[Kpi ID]
			            )
			        ),
			    'Fact KPI'[KPI Status] = "Review"
			),0)
			```
		formatString: 0
		lineageTag: 884c2f2d-3f2f-47eb-9125-289aca09c3ba

