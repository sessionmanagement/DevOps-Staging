		lineageTag: 48a9cd8e-62a8-4148-bfdd-f05288565404

	measure 'Tooltip Entity Count' = ```
			
			CALCULATE(
			    COUNT('Fact History'[Entity KEY]),
			    ALL('Fact History'[KPI Status])
			)
			
