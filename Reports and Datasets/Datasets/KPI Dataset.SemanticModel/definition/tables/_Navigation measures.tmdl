table '_Navigation measures'
	excludeFromModelRefresh
	lineageTag: 308f32b0-3d99-4c19-b8e4-fd1ff8855f23

	measure 'Entity SM Navigation' = ```
			
			IF(SELECTEDVALUE('Fact KPI'[Entity Type]) = "Service", "Service Detail - SM",
			    IF(SELECTEDVALUE('Fact KPI'[Entity Type]) = "Kaimahi", "Kaimahi Detail - SM",
			        IF(SELECTEDVALUE('Fact KPI'[Entity Type]) = "Property", "Property Detail - SM",
			        IF(SELECTEDVALUE('Fact KPI'[Entity Type]) = "Tenancy", "Tenancy Detail - SM",
			            IF(SELECTEDVALUE('Fact KPI'[Entity Type]) = "Client", "Client Detail - SM",
			                IF(SELECTEDVALUE('Fact KPI'[Entity Type]) = "Referral", "Referral Detail - SM",
			        
			        "Check"
			        )
			    )
			))))
			```
		lineageTag: f83296c3-fe92-484a-bc11-ce98cd517607

	measure PageNavigation =
			
			IF(SELECTEDVALUE('Dim KPI'[Kpi ID]) = 129, " Goals after 14 days",
			    IF(SELECTEDVALUE('Dim KPI'[Kpi ID]) = 132, "Assessment within 4 weeks",
			        IF(SELECTEDVALUE('Dim KPI'[Kpi ID]) = 134, "Goals after 28 days",
			        "Check"
			        )
			    )
			)
		lineageTag: f1952b4b-9591-4abc-9cd5-71271300df8c

	measure PersonaNavigation = ```
			
			// var _role= CALCULATE(SELECTEDVALUE('RLS with Additional Access'[Persona])) //,FILTER('RLS with Additional Access','RLS with Additional Access'[User Principal Name]=USERPRINCIPALNAME()))
			// return 
			// IF (_role = "Service Leaders", "Driver : UE - SM ", 
