			//         )
			//     )
			
			var _role= CALCULATE(SELECTEDVALUE('RLS with Additional Access'[Persona]),FILTER('RLS with Additional Access','RLS with Additional Access'[User Principal Name]=USERPRINCIPALNAME()))
			
			var _PersonaNav = IF (_role = "Service Leaders", "Driver : UE - SM ", 
			    IF (_role = "Manager of Leaders", "Driver : UE - DM ", 
			        IF (_role = "Manager of Managers", "Driver : UE - RM ", 
			            IF (_role = "Exec & Senior Leaders", "Driver : UE - Exec ", 
			            "Driver : UE - Exec "))))
			
			
			RETURN 
			_PersonaNav
			
