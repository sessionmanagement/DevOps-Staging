	measure AreaNavigation = ```
			
			// VAR _DistinctAreaCount =
			//     CALCULATE(
			//         DISTINCTCOUNT('RLS with Additional Access'[Area]),
			//         FILTER(
			//             'RLS with Additional Access',
			//             NOT ISBLANK('RLS with Additional Access'[Area])
			//         )
			//     )
			
			// VAR _Areas = 
			//     IF(
			//         _DistinctAreaCount > 1,
			//         "Area Navigation",
			//         CALCULATE(
			//             SELECTEDVALUE('RLS with Additional Access'[Persona])//,
			           
			//         )
			//     )
			
			var _role= CALCULATE(SELECTEDVALUE('RLS with Additional Access'[Persona])) 
			
			var _PersonaNav = IF (_role = "Service Leaders", "Driver : UE - SM ", 
			    IF (_role = "Manager of Leaders", "Driver : UE - DM ", 
			        IF (_role = "Manager of Managers", "Driver : UE - RM ", 
			            IF (_role = "Exec & Senior Leaders", "Driver : UE - Exec ", 
			            "Driver : UE - Exec "))))
			
			
			
			RETURN
			 IF(
			        HASONEVALUE('DIM_ServiceGrouping'[relevant_bu]),
			        _PersonaNav,
			        ""
			        )
			    
			
			```
		lineageTag: 11abf4e3-3ca4-4507-a8e5-417edaff9d98

	measure 'Driver SM Navigation' =
			
			IF(SELECTEDVALUE('Dim KPI'[Sfa Rollup Areas Lookup Value]) = "UNDERSTANDING EXCELLENCE", "Driver : UE - SM ",
			    IF(SELECTEDVALUE('Dim KPI'[Sfa Rollup Areas Lookup Value]) = "OUR KAIMAHI", "Driver : OK - SM ",
			        IF(SELECTEDVALUE('Dim KPI'[Sfa Rollup Areas Lookup Value]) = "OUR PERFORMANCE", "Driver : OP - SM ",
			            IF(SELECTEDVALUE('Dim KPI'[Sfa Rollup Areas Lookup Value]) = "OUR PLANET", "Driver : OW - SM ",
			                IF(SELECTEDVALUE('Dim KPI'[Sfa Rollup Areas Lookup Value]) = "OUR SERVICES", "Driver : OS - SM ",
			                    IF(SELECTEDVALUE('Dim KPI'[Sfa Rollup Areas Lookup Value]) = "OUR RELATIONSHIPS", "Driver : OR - SM ",
			                        IF(SELECTEDVALUE('Dim KPI'[Sfa Rollup Areas Lookup Value]) = "TANGATA TIRITI", "Driver : TT - SM ",
			        "Check"
			        )
			    )
			)))))
		lineageTag: 35a2c751-ebbc-43dd-8b4e-c8188667e021

