			//         IF (_role = "Manager of Managers", "Driver : UE - RM ", 
			//             IF (_role = "Exec & Senior Leaders", "Driver : UE - Exec ", 
			//             "Driver : UE - Exec "))))
			
			
			VAR _countAreasForUser =
			    CALCULATE(
			        DISTINCTCOUNT('DIM_ServiceGrouping'[relevant_bu]),
			        FILTER(
			            'RLS with Additional Access',
			            'RLS with Additional Access'[User Principal Name] = USERPRINCIPALNAME() )
