	partition 'Dim Referral' = m
		mode: import
		queryGroup: 'EDW Dim Tables'
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="#(lf)-- GET KAIMAHI INFO FROM  EMPLOYEE HIERARCHY FIRST#(lf)WITH Kaimahi_assigned AS#(lf)(SELECT vw_dim_employee_hierarchy.employee_displayname AS kaimahi_assigned#(lf),vw_dim_employee_hierarchy.employee_id#(lf)#(lf)FROM edw.vw_dim_employee_hierarchy#(lf)WHERE vw_dim_employee_hierarchy.DWHIsCurrent = 1#(lf)   AND vw_dim_employee_hierarchy.DWHDMLOperation <> 'd'#(lf)     AND vw_dim_employee_hierarchy.dim_employee_key > 0 )#(lf)#(lf)#(lf)#(tab)#(tab)#(lf)   SELECT DISTINCT#(lf)        vw_fact_client_referral.dim_company_key,#(lf)#(tab)#(tab)vw_fact_client_referral.dim_client_key,#(lf)#(tab)#(tab)vw_fact_client_referral.client_id,#(lf)#(tab)#(tab)vw_fact_client_referral.dim_client_key_latest,#(lf)#(tab)#(tab)vw_dim_client.dim_client_unique_key,#(lf)#(tab)#(tab)vw_dim_client.client_display_name,#(lf)#(tab)#(tab)--===added#(lf)#(tab)#(tab)vw_fact_client_referral.dim_client_referral_key,#(lf)#(tab)#(tab)vw_fact_client_referral.client_referral_id,#(lf)#(tab)#(tab)vw_fact_client_referral.client_team_id,#(lf)#(tab)#(tab)vw_dim_client_team.client_team_name,#(lf)#(tab)#(tab)--========#(lf)       #(tab)vw_dim_service.dim_service_key,#(lf)#(tab)#(tab)--===added#(lf)#(tab)#(tab)vw_dim_service.service_code,#(lf)#(tab)#(tab)vw_dim_service.service_id,#(lf)#(tab)#(tab)vw_dim_client_referral.client_referral_status,#(lf)#(tab)#(tab)ROW_NUMBER() OVER (PARTITION BY vw_fact_client_referral.client_id #(lf)#(tab)#(tab)ORDER BY vw_fact_client_referral.client_id, vw_fact_client_referral.dim_client_referral_key) AS row_num_by_client,#(lf)    #(lf)#(tab)--====rationale for the count.  If you want to know the active clients take row_number_by_client = 1#(lf)#(tab)#(tab)ROW_NUMBER() OVER (PARTITION BY vw_fact_client_referral.client_id, vw_fact_client_referral.dim_service_key #(lf)#(tab)#(tab)ORDER BY  vw_fact_client_referral.dim_client_referral_key, vw_fact_client_referral.dim_service_key) AS row_num_by_client_per_service#(lf)#(tab)--====if you want to know the number of active client referrals then count(dim_client_referral_key).#(lf)#(tab)--====if you want to know the number of active clients per service then count by service where row_num_by_client_per_service = 1 #(lf)#(tab), kaimahi_assigned#(lf)#(tab), CASE #(lf)        WHEN vw_fact_client_referral .dim_company_key = 1 THEN #(lf)            'https://emergeaotearoa.wildbamboo.co.nz/person/' + CAST(vw_fact_client_referral .client_id AS VARCHAR)#(lf)        WHEN vw_fact_client_referral .dim_company_key = 5 THEN #(lf)            'https://mindandbody.wildbamboo.co.nz/person/' + CAST(vw_fact_client_referral .client_id AS VARCHAR)#(lf)        ELSE NULL#(lf)    END AS URL#(lf)   #(lf)#(tab)FROM edw.vw_fact_client_referral #(lf)#(tab)INNER JOIN edw.vw_dim_client #(tab)#(tab)#(tab) ON vw_fact_client_referral.dim_client_key = vw_dim_client.dim_client_key#(lf)#(tab)INNER JOIN edw.vw_dim_client_team        ON vw_dim_client_team.dim_client_team_key  = VW_fact_client_referral.dim_client_team_key #(lf)    INNER JOIN edw.vw_dim_service            ON vw_fact_client_referral.dim_service_key = vw_dim_service.dim_service_key#(lf)#(tab)--====added#(lf)#(tab)INNER JOIN edw.vw_dim_client_referral    on vw_fact_client_referral.dim_client_referral_key = vw_dim_client_referral.dim_client_referral_key#(lf)#(tab)--===========#(lf)#(tab)LEFT JOIN Kaimahi_assigned ON Kaimahi_assigned.employee_id = vw_fact_client_referral.user_employee_number#(lf)    WHERE #(lf)#(tab)#(tab)vw_fact_client_referral.DWHDMLOperation       <> 'D'#(lf)#(tab)#(tab)--=== discussion with Thijs, he says we need waitlist and pending... therefore need to add an extra column for client_referral_status.  Any confusion is his doing#(lf)#(tab)#(tab)--AND vw_fact_client_referral.client_referral_accepted_date_key is not null#(lf)#(tab)#(tab)AND vw_dim_client_referral.client_referral_type = 'InboundReferral'#(lf)#(tab)#(tab)AND vw_dim_client_referral.client_status_is_active = 'Active'#(lf)#(tab)#(tab)--dim_client_team doesn't keep history - keep only the valid ones - because we're using team id.#(lf)#(tab)#(tab)AND vw_dim_client_team.DWHDMLOperation       <> 'D'#(lf)#(tab)--#(tab)and vw_dim_service.dwhiscurrent  = 1#(lf)#(tab)#(tab)and vw_dim_service.dwhdmloperation <> 'd'#(lf)#(lf)#(tab)#(tab)#(lf)#(tab)order by client_id;#(lf)"]),
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceKaimahi = Text.Replace(columnName, "employee_", "Kaimahi_"),
				            replaceClient = Text.Replace(replaceKaimahi, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, each ApplyNamingConventions(_))
				in
				    #"Transformed Column Names"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

