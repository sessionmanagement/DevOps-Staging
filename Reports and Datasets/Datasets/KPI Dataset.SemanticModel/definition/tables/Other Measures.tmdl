	measure 'Roll Up HISTORY KPI Status' = ```
			
			
			-- total distinct entity/KPIValue combinations in current filter context
			VAR _kpi =
			    COUNTROWS (
			        SUMMARIZE (
			            'Fact History',
			            'Fact History'[Entity KEY],
			            'Fact History'[KPI Value],
			             'Fact History'[Kpi ID]
			        )
			    )
			
			-- total distinct KPIs in the selection (respects filter context)
			VAR _kpi_count =
			    CALCULATE ( DISTINCTCOUNT ( 'Fact History'[Kpi ID] ) )
			
			-- counts per status in the current context
			VAR _countgreen =
			    CALCULATE (
			        COUNTROWS (
			            SUMMARIZE (
			                'Fact History',
			                'Fact History'[Entity KEY],
			                'Fact History'[KPI Value],
			                'Fact History'[Kpi ID]
			            )
			        ),
			        'Fact History'[KPI Status] = "Achieving"
			    )
			
			VAR _countamber =
			    CALCULATE (
			        COUNTROWS (
			            SUMMARIZE (
			                'Fact History',
			                'Fact History'[Entity KEY],
			                'Fact History'[KPI Value],
			                'Fact History'[Kpi ID]
			            )
			        ),
			        'Fact History'[KPI Status] = "Review"
			    )
			
			VAR _countred =
			    CALCULATE (
			        COUNTROWS (
			            SUMMARIZE (
			                'Fact History',
			                'Fact History'[Entity KEY],
			                'Fact History'[KPI Value],
			                'Fact History'[Kpi ID]
			            )
			        ),
			        'Fact History'[KPI Status] = "Take Action"
			    )
			
			-- thresholds for single KPI roll-up (from Dim KPI)
			VAR _rollupGreenThreshold =
			    CALCULATE (
			        MAXX (
			            FILTER (
			                ADDCOLUMNS (
			                    SUMMARIZE ( 'Fact History', 'Fact History'[Entity KEY] ),
			                    "Thres", MAX ( 'Dim KPI'[Kpi Ru G Value] )
			                ),
			                NOT ISBLANK ( [Thres] )
			            ),
			            [Thres]
			        )
			    )
			
			VAR _rollupAmberThreshold = 
			    CALCULATE (
			        MAXX (
			            FILTER (
			                ADDCOLUMNS (
			                    SUMMARIZE ( 'Fact History', 'Fact History'[Entity KEY] ),
			                    "Thres", MAX ( 'Dim KPI'[Kpi Ru A Value] )
			                ),
			                NOT ISBLANK ( [Thres] )
			            ),
			            [Thres]
			        )
			    )
			
			-- thresholds for multiple KPI roll-up (static)
			VAR _rollupGreenThreshold_multiple = 0.9
			VAR _rollupAmberThreshold_multiple = 0.8
			
			-- choose thresholds based on number of KPIs in context
			VAR _greenThresholdToUse =
			    IF ( _kpi_count > 1, _rollupGreenThreshold_multiple, _rollupGreenThreshold )
			
			VAR _amberThresholdToUse =
			    IF ( _kpi_count > 1, _rollupAmberThreshold_multiple, _rollupAmberThreshold )
			
			-- precompute rates
			VAR _greenRate =
			    DIVIDE ( _countgreen, _kpi, 0 )
			
			VAR _greenAmberRate =
			    DIVIDE ( _countgreen + _countamber, _kpi, 0 )
			
			RETURN
			IF (
			    _kpi = 0,
			    "No data",
			    SWITCH (
			        TRUE (),
			        _greenRate >= _greenThresholdToUse, "Achieving",
			        _greenAmberRate > _amberThresholdToUse
			            && _greenRate < _greenThresholdToUse, "Review",
			        "Take Action"
			    )
			)
			
			
			
			
			// VAR _kpi =
			//     COUNTROWS (
			//         SUMMARIZE (
			//             'Fact History',
			//             'Fact History'[Entity KEY],
			//             'Fact History'[KPI Value]
			//         )
			//     )
			
			// VAR _countgreen =
			//     CALCULATE (
			//         COUNTROWS (
			//             SUMMARIZE (
			//                 'Fact History',
			//                 'Fact History'[Entity KEY],
			//                 'Fact History'[KPI Value]
			//             )
			//         ),
			//         'Fact History'[KPI Status] = "Achieving"
			//     )
			
			// VAR _countamber =
			//     CALCULATE (
			//         COUNTROWS (
			//             SUMMARIZE (
			//                 'Fact History',
			//                 'Fact History'[Entity KEY],
			//                 'Fact History'[KPI Value]
			//             )
			//         ),
			//         'Fact History'[KPI Status] = "Review"
