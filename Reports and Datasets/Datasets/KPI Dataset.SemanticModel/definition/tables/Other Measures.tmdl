			//                 'Fact History'[Entity KEY],
			//                 'Fact History'[KPI Value]
			//             )
			//         ),
			//         'Fact History'[KPI Status] = "Take Action"
			//     )
			
			// VAR _rollupGreenThreshold =
			//     CALCULATE (
			//         MAXX (
			//             FILTER (
			//                 ADDCOLUMNS (
			//                     SUMMARIZE ( 'Fact History', 'Fact History'[Entity KEY] ),
			//                     "Thres", MAX ( 'Dim KPI'[Kpi Ru G Value] )
			//                 ),
			//                 NOT ISBLANK ( [Thres] )
