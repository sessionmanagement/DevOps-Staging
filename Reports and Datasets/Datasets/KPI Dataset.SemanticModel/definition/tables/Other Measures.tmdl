	measure 'Roll Up KPI Status' = ```
			
			
			
			-- total distinct entity/KPIValue combinations in current filter context
			VAR _kpi =
			    COUNTROWS (
			        SUMMARIZE (
			            'Fact KPI',
			            'Fact KPI'[Entity KEY],
			            'Fact KPI'[KPI Value],
			            'Fact KPI'[Kpi ID]
			        )
			    )
			
			-- total distinct KPIs in the selection (respects filter context)
			VAR _kpi_count =
			    CALCULATE ( DISTINCTCOUNT ( 'Fact KPI'[Kpi ID] ) )
			
			-- counts per status in the current context
			VAR _countgreen =
			    CALCULATE (
			        COUNTROWS (
			            SUMMARIZE (
			                'Fact KPI',
			                'Fact KPI'[Entity KEY],
			                'Fact KPI'[KPI Value],
			                'Fact KPI'[Kpi ID]
			            )
			        ),
			        'Fact KPI'[KPI Status] = "Achieving"
			    )
			
			VAR _countamber =
			    CALCULATE (
			        COUNTROWS (
			            SUMMARIZE (
			                'Fact KPI',
			                'Fact KPI'[Entity KEY],
			                'Fact KPI'[KPI Value],
			                'Fact KPI'[Kpi ID]
			            )
			        ),
			        'Fact KPI'[KPI Status] = "Review"
			    )
			
			VAR _countred =
			    CALCULATE (
			        COUNTROWS (
			            SUMMARIZE (
			                'Fact KPI',
			                'Fact KPI'[Entity KEY],
			                'Fact KPI'[KPI Value],
			                'Fact KPI'[Kpi ID]
			            )
			        ),
			        'Fact KPI'[KPI Status] = "Take Action"
			    )
			
			-- thresholds for single KPI roll-up (taken from Dim KPI)
			VAR _rollupGreenThreshold =
			    CALCULATE (
			        MAXX (
			            FILTER (
			                ADDCOLUMNS (
			                    SUMMARIZE ( 'Fact KPI', 'Fact KPI'[Entity KEY] ),
			                    "Thres", MAX ( 'Dim KPI'[Kpi Ru G Value] )
			                ),
			                NOT ISBLANK ( [Thres] )
			            ),
			            [Thres]
			        )
			    )
			
			VAR _rollupAmberThreshold =
			    CALCULATE (
			        MAXX (
			            FILTER (
			                ADDCOLUMNS (
			                    SUMMARIZE ( 'Fact KPI', 'Fact KPI'[Entity KEY] ),
			                    "Thres", MAX ( 'Dim KPI'[Kpi Ru A Value] )
			                ),
			                NOT ISBLANK ( [Thres] )
			            ),
			            [Thres]
			        )
			    )
			
			-- thresholds for multiple KPI roll-up (static values as requested)
			VAR _rollupGreenThreshold_multiple = 0.9
			VAR _rollupAmberThreshold_multiple = 0.8
			
			-- choose which thresholds to use based on number of KPIs in context
			VAR _greenThresholdToUse =
			    IF ( _kpi_count > 1, _rollupGreenThreshold_multiple, _rollupGreenThreshold )
			
			VAR _amberThresholdToUse =
			    IF ( _kpi_count > 1, _rollupAmberThreshold_multiple, _rollupAmberThreshold )
			
			-- precompute rates to keep the SWITCH readable
			VAR _greenRate =
			    DIVIDE ( _countgreen, _kpi, 0 )
			
			VAR _greenAmberRate =
			    DIVIDE ( _countgreen + _countamber, _kpi, 0 )
			
			RETURN
			
			IF (
			    _kpi = 0,
			    "No data",
			    SWITCH (
			        TRUE (),
			        _greenRate >= _greenThresholdToUse, "Achieving",
			        _greenAmberRate > _amberThresholdToUse
			            && _greenRate < _greenThresholdToUse, "Review",
			        "Take Action"
			    )
			)
			
			
			// -- total distinct entity/KPIValue combinations in current filter context
			// VAR _kpi =
			//     COUNTROWS(
			//         SUMMARIZE(
			//             'Fact KPI',
			//             'Fact KPI'[Entity KEY],
			//             'Fact KPI'[KPI Value]
			//         )
			//     )
			
			// -- total distinct KPIs in the selection
			// VAR _kpi_count =
			//     CALCULATE(DISTINCTCOUNT('Fact KPI'[Kpi ID]))
			
			// -- counts are calculated by re-evaluating the SUMMARIZE inside CALCULATE so filters apply
			// VAR _countgreen =
