			//             SUMMARIZE (
			//                 'Fact KPI',
			//                 'Fact KPI'[Entity KEY],
			//                 'Fact KPI'[KPI Value]
			//             )
			//         ),
			//         'Fact KPI'[KPI Status] = "Achieving"
			//     )
			
			// VAR _countamber =
			//     CALCULATE (
