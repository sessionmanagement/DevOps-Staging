			//                 'Fact KPI',
			//                 'Fact KPI'[Entity KEY],
			//                 'Fact KPI'[KPI Value]
			//             )
			//         ),
			//         'Fact KPI'[KPI Status] = "Review"
			//     )
			
			// VAR _countred =
			//     CALCULATE (
			//         COUNTROWS (
