table 'Other Measures'
	lineageTag: 4e143469-6c06-4689-9b26-bdfbdd1d9f3b

	measure 'Strategic Focus Area KPI' = ```
			
			VAR _kpi =
			    DISTINCTCOUNT ( 'Fact KPI'[Entity KEY] )
			VAR _countgreen =
			    CALCULATE (
			        COUNTROWS (
			            SUMMARIZE (
			                'Fact KPI',
			                'Fact KPI'[Entity KEY],
			                'Fact KPI'[KPI Value]
			            )
			        ),
			        'Fact KPI'[KPI Status] = "Achieving"
			    )
			VAR _countamber =
			    CALCULATE (
			        COUNTROWS (
			            SUMMARIZE (
			                'Fact KPI',
			                'Fact KPI'[Entity KEY],
			                'Fact KPI'[KPI Value]
			            )
			        ),
			        'Fact KPI'[KPI Status] = "Review"
			    )
			VAR _countred =
			    CALCULATE (
			        COUNTROWS (
			            SUMMARIZE (
			                'Fact KPI',
			                'Fact KPI'[Entity KEY],
			                'Fact KPI'[KPI Value]
			            )
			        ),
			        'Fact KPI'[KPI Status] = "Take Action"
			    )
			VAR _rollupGreenThreshold =
			
			CALCULATE (
			    MAXX (
			        FILTER (
			            ADDCOLUMNS (
			                SUMMARIZE ( 'Fact KPI', 'Fact KPI'[Entity KEY] ),
			                "Rollup Green Threshold", MAX ( 'Dim KPI'[Kpi Ru G Value] )
			            ),
			            NOT ISBLANK ( [Rollup Green Threshold] )
			        ),
			        [Rollup Green Threshold]
			    )
			)
			    // CALCULATE (
			    //     MAXX (
			    //         SUMMARIZE (
			    //             'Fact KPI',
			    //             'Fact KPI'[Entity KEY],
			    //             "Rollup Green Threshold", MAX('Dim KPI'[Kpi Ru G Value])
			    //         ),
			    //         [Rollup Green Threshold]
			    //     )
			    // )
			
			
			VAR _rollupAmberThreshold =
			CALCULATE (
			    MAXX (
			        FILTER (
			            ADDCOLUMNS (
			                SUMMARIZE ( 'Fact KPI', 'Fact KPI'[Entity KEY] ),
			                "Rollup Amber Threshold", MAX ( 'Dim KPI'[Kpi Ru A Value] )
			            ),
			            NOT ISBLANK ( [Rollup Amber Threshold] )
			        ),
			        [Rollup Amber Threshold]
			    )
			)
			
			    // CALCULATE (
			    //     MAXX (
			    //         SUMMARIZE (
			    //             'Fact KPI',
			    //             'Fact KPI'[Entity KEY],
			    //             "Rollup Amber Threshold", MAX('Dim KPI'[Kpi Ru A Value])
			    //         ),
			    //         [Rollup Amber Threshold]
			    //     )
			    // )
			RETURN
			
			    IF (
			        _kpi > 0,
			        SWITCH (
			            TRUE (),
			            DIVIDE ( _countgreen, _kpi, 0 ) >= _rollupGreenThreshold, "Achieving",
			            DIVIDE ( _countgreen + _countamber, _kpi, 0 ) > _rollupAmberThreshold
			                && DIVIDE ( _countgreen, _kpi, 0 ) < _rollupGreenThreshold, "Review",
			            "Take Action"
			        ),
			        "No data"
			        //BLANK ()
			    )
			
			```
		lineageTag: 367d96c4-f18c-4a63-aa6b-7d6a52c0f03e

