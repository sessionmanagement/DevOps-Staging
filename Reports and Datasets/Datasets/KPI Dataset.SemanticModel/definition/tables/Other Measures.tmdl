	measure 'MSForms Dynamic Hyperlink' = ```
			
			
			VAR __SelectedServices =
			CONCATENATEX(
			    VALUES('Fact KPI'[Service ID]),
			    SUBSTITUTE('Fact KPI'[Service ID], 
			    " ", "%20"),
			    ";"
			)
			
			
			RETURN
			IF(HASONEVALUE('Dim KPI'[Sim Title]),
			    "https://forms.office.com/Pages/ResponsePage.aspx?id=5pwaljhNL0WdnSaUJZm74Bi141T6_MhAomzln6LwAm1UOVUxWkVXNlM4QkRLMkZFNzRDWDZJWTNVTi4u"
			    & "&rdf81682663434d93aa3c2020db0b5c4f=" & MAX('Dim KPI'[Sim Title]) //1. Measure selected
			    & "&rd670e6a47bd54ee2941d0b73b0c22eec="  //2. Please provide your commentary below
			    & "&r9b1a88fb7dc1451da1a76abea9af20e7=" & FORMAT(MAX('Dim Service'[Dim Company KEY]), "0")  //3. Company ID
			    & "&r9e4a1859ee48430ca572888e143e2f6a=" & __SelectedServices //4. Service IDs
			    & "&r7bbf2e7c772748b79b4bbf21dfce399b=" & MAX('Dim KPI'[Kpi ID]) ,
			    "#")
			
			```
