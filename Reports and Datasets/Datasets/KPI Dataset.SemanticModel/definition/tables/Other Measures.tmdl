	measure 'Info Page Link' =
			
			VAR _HousingLink = "https://emergeaotearoaltd.sharepoint.com/sites/OperationalSuccessManagement/SitePages/About-our-measures-Housing.aspx?csf=1&web=1&e=AaC0nb&clickparams=eyAiWC1BcHBOYW1lIiA6ICJNaWNyb3NvZnQgT3V0bG9vayIsICJYLUFwcFZlcnNpb24iIDogIjE2LjAuMTg4MjcuMjAyMDIiLCAiT1MiIDogIldpbmRvd3MiIH0%3d&CID=1859b7a1-70e1-5000-949e-33e37be474c8&cidOR=SPO"
			
			VAR _HDLink = "https://emergeaotearoaltd.sharepoint.com/sites/OperationalSuccessManagement/SitePages/About-our-measures-H&D.aspx?csf=1&web=1&e=EofsAi&clickparams=eyAiWC1BcHBOYW1lIiA6ICJNaWNyb3NvZnQgT3V0bG9vayIsICJYLUFwcFZlcnNpb24iIDogIjE2LjAuMTg4MjcuMjAyMDIiLCAiT1MiIDogIldpbmRvd3MiIH0%3d&CID=1859b7a1-00e1-5000-949e-37d2bea4dc84&cidOR=SPO"
			
			VAR _TenancyLink = "https://emergeaotearoaltd.sharepoint.com/sites/OperationalSuccessManagement/SitePages/About-our-measures---Tenancy.aspx"
			
			VAR _GeneralLink = "https://emergeaotearoaltd.sharepoint.com/sites/OperationalSuccessManagement/SitePages/How-to-use-the-dashboards.aspx"
			
			VAR _AccessibleServices =
			    VALUES('Fact KPI'[Latest_Dim Service KEY])
			
			VAR _DistinctAreaCount =
			    CALCULATE(
			        DISTINCTCOUNT('Dim Service'[Business Unit]),
			        TREATAS(
			            _AccessibleServices,
			            'Dim Service'[Dim Service Key]
			        )
			    )
			
			VAR _SelectedArea =
			    CALCULATE(
			        SELECTEDVALUE('Dim Service'[Business Unit]),
			        TREATAS(
			            _AccessibleServices,
			            'Dim Service'[Dim Service Key]
			        )
			    )
			
			VAR _Area =
			    IF(
			        _DistinctAreaCount = 1,
			        _SelectedArea,
			        "General"
			    )
			
			RETURN
			    SWITCH(
			        _Area,
			        "Housing", _HousingLink,
			        "Health & Disability", _HDLink,
			        "Tenancy", _TenancyLink,
			        _GeneralLink
			    )
		lineageTag: e914952b-a1e9-4164-b459-23d53676e65e

