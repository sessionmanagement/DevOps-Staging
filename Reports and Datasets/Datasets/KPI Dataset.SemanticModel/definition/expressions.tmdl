ee_job_name COLLATE Latin1_General_CI_AI IN ('Group Director, Lived Experience & Diversity' )#(lf)#(lf)    and #levels_3_4_5_6_7.service_name  like '%lived experience%'#(lf)#(lf)#(tab)#(lf)  select #(lf)  * #(lf)  into #final#(lf)  from #levels_2_3_4_5_6_7#(lf)  union#(lf)  select #(lf)   DISTINCT#(lf) #level_1_AllStaff.hierarchy_number,#(lf)   #levels_2_3_4_5_6_7.service_name#(lf) , #levels_2_3_4_5_6_7.service_id#(lf) , #levels_2_3_4_5_6_7.dim_service_key#(lf) , #levels_2_3_4_5_6_7.dim_company_key#(lf) , #levels_2_3_4_5_6_7.company#(lf) , #levels_2_3_4_5_6_7.department_name#(lf) , #levels_2_3_4_5_6_7.district_name#(lf) , #levels_2_3_4_5_6_7.region_name#(lf) ,#level_1_allstaff.dim_employee_key#(lf) ,#level_1_allstaff.employee_id#(lf) ,#level_1_allstaff.employee_primary_email_address#(lf) ,#level_1_allstaff.employee_current_status#(lf) ,#level_1_allstaff.employee_job_name#(lf) ,#level_1_AllStaff.company AS levelcompany#(lf)    #(lf)  from #levels_2_3_4_5_6_7#(lf)  cross join #level_1_AllStaff#(lf)#(lf)  order by employee_primary_email_address#(lf)#(lf) -- drop table #finalfinal#(lf)#(lf) select#(lf)  client_team_area,#(lf)  client_team_function,#(lf)  client_team_name,#(lf)  client_team_id,#(lf)  dim_client_team_unique_key,#(lf)  case when dim_client_team_unique_key like '%_1' then 1#(lf)  when dim_client_team_unique_key like '%_15' then 5#(lf)  else 1#(lf)  end as fudged_company_id ,#(lf)  service_id#(lf)  into #client_teams #(lf)  from edw.dim_client_team #(lf)  where dwhdmloperation <> 'd'#(lf)#(lf)  select #(lf)  case when employee_job_name = 'Group Chief Executive' then 1#(lf)  else hierarchy_number#(lf)  end as   #(lf)  hierarchy_number,#(lf)  dim_employee_key,#(lf)  employee_id,#(lf)  employee_primary_email_address,#(lf)  employee_job_name,#(lf)  #final.service_name,#(lf)  #final.dim_service_key,#(lf)  #final.service_id,#(lf)  #final.department_name,#(lf)  #final.district_name,#(lf)  #final.region_name,#(lf)  company,#(lf)  client_team_area,#(lf)  client_team_function,#(lf)  client_team_name,#(lf)  client_team_id,#(lf)  dim_client_team_unique_key,#(lf)  #final.dim_company_key#(lf)  into #finalfinal#(lf)  from #final#(lf)  left join edw.dim_service on #final.service_id = dim_service.service_id#(lf)  and dim_service.DWHIsCurrent= 1 and dim_service.DWHDMLOperation <> 'd'#(lf)  left join #client_teams on dim_service.service_code = #client_teams.service_id#(lf)   and dim_service.dim_company_key = #client_teams.fudged_company_id#(lf)#(lf)  select #(lf)    #(lf)  hierarchy_number,#(lf)  dim_employee_key,#(lf)  employee_id,#(lf)  employee_primary_email_address,#(lf)  employee_job_name,#(lf)  service_name,#(lf)  dim_service_key,#(lf)  service_id,#(lf)  department_name,#(lf)  district_name,#(lf)  region_name,#(lf)  company,#(lf)  client_team_area,#(lf)  client_team_function,#(lf)  client_team_name,#(lf)  client_team_id,#(lf)  dim_client_team_unique_key,#(lf)  dim_company_key#(lf)   #(lf)  from #finalfinal#(lf)#(lf)#(lf)#(lf) UNION#(lf)#(lf) SELECT#(lf)    NULL AS hierarchy_number,#(lf)    de.dim_employee_key#(lf)    AS dim_employee_key,#(lf)    de.employee_id AS employee_id,#(lf)    rls.user_principal_name AS employee_primary_email_address,#(lf)    de.employee_job_name AS employee_job_name,#(lf)    ds.service_name,#(lf)    rls.dim_service_key,#(lf)    ds.service_id AS service_id,#(lf)    ds.department_name AS department_name,#(lf)    ds.district_name AS district_name,#(lf)    ds.region_name AS region_name,#(lf)    ds.company_name AS company,#(lf)    dct.dim_client_team_area AS client_team_area,#(lf)    dct.client_team_function AS client_team_function,#(lf)    dct.client_team_name,#(lf)    dct.client_team_id AS client_team_id,#(lf)    dct.dim_client_team_unique_key AS dim_client_team_unique_key,#(lf)    ds.dim_company_key AS dim_company_key#(lf)FROM edw.vw_row_level_security rls#(lf)LEFT JOIN edw.vw_dim_service ds#(lf)    ON ds.dim_service_key = rls.dim_service_key#(lf)LEFT JOIN edw.vw_dim_client_team dct#(lf)    ON dct.dim_service_key = rls.dim_service_key#(lf)LEFT JOIN edw.vw_dim_employee de ON rls.user_principal_name = de.employee_primary_email_address#(lf)WHERE rls.user_principal_name LIKE '%martinique%'#(lf)  AND rls.dim_service_key IS NOT NULL#(lf)  AND ds.DWHIsCurrent = 1#(lf)  AND ds.DWHDMLOperation <> 'd'#(lf)  AND dct.DWHDMLOperation <> 'd'#(lf)  AND de.DWHIsCurrent = 1#(lf)  AND de.DWHDMLOperation <> 'd'#(lf)#(lf)ORDER BY#(lf)    employee_primary_email_address,#(lf)    service_name;#(lf)#(lf)DROP TABLE IF EXISTS #NoDirectReports;#(lf)DROP TABLE IF EXISTS #employee_hierarchy_0;#(lf)DROP TABLE IF EXISTS #employee_hierarchy;#(lf)DROP TABLE IF EXISTS #PeopleLeaders;#(lf)DROP TABLE IF EXISTS #peopleLeader_Email;#(lf)DROP TABLE IF EXISTS #ServicesEDW;#(lf)DROP TABLE IF EXISTS #HierarchywithServices;#(lf)DROP TABLE IF EXISTS #HierarchywithServices_0;#(lf)DROP TABLE IF EXISTS #CostAllocations;#(lf)DROP TABLE IF EXISTS #level_1_AllStaff;#(lf)DROP TABLE IF EXISTS #level_2_AllStaff;#(lf)DROP TABLE IF EXISTS #level_3_AllStaff;#(lf)DROP TABLE IF EXISTS #level_4_AllStaff;#(lf)DROP TABLE IF EXISTS #level_5_AllStaff;#(lf)DROP TABLE IF EXISTS #level_6_AllStaff;#(lf)DROP TABLE IF EXISTS #level_7_AllStaff;#(lf)DROP TABLE IF EXISTS #noservice;#(lf)DROP TABLE IF EXISTS #lowestlevel;#(lf)DROP TABLE IF EXISTS #missing7;#(lf)DROP TABLE IF EXISTS #PeopleLeaderMissing7;#(lf)DROP TABLE IF EXISTS #levels6_7_0;#(lf)DROP TABLE IF EXISTS #levels6_7;#(lf)DROP TABLE IF EXISTS #levels5_6_7;#(lf)DROP TABLE IF EXISTS #levels_4_5_6_7;#(lf)DROP TABLE IF EXISTS #levels_3_4_5_6_7;#(lf)DROP TABLE IF EXISTS #levels_2_3_4_5_6_7;#(lf)DROP TABLE IF EXISTS #final;#(lf)DROP TABLE IF EXISTS #finalfinal;#(lf)DROP TABLE IF EXISTS #Hierarchylevel1crossjoin;#(lf)DROP TABLE IF EXISTS #HierarchyLevel1CrossJoinResult;#(lf)DROP TABLE IF EXISTS #client_teams;#(lf)DROP TABLE IF EXISTS #PeopleLeaderMissing7_0;#(lf)"]),
