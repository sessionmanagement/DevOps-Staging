expression fnExtractProcBody =
		(procText as text) as text =>
		let
		    src = procText,
		    upper = Text.Upper(src),
		    len = Text.Length(src),
		    isIdentChar = (c as nullable text) as logical =>
		        if c = null then false
		        else let n = Character.ToNumber(c) in (n >= 48 and n <= 57) or (n >= 65 and n <= 90) or (n >= 97 and n <= 122) or n = 95,
		    positions = List.Select({0..len - 2}, each Text.Range(upper, _, 2) = "AS" and not isIdentChar(if _ = 0 then null else Text.Middle(src, _ - 1, 1)) and not isIdentChar(if _ + 2 >= len then null else Text.Middle(src, _ + 2, 1))),
		    asPos = if List.IsEmpty(positions) then null else List.First(positions),
		    body = if asPos = null then src else Text.Range(src, asPos + 2)
		in
		    body
	lineageTag: 2b73e203-f270-4e60-a92e-a3b2e6d36925
	queryGroup: 'KPI Testing'

expression fnAlignToFactKpi =
		(resultTable as table) as table =>
		let
		    defaults = [
		        fact_kpi_id = null,
		        dim_kpi_key = -9,
		        dim_company_key = -9,
		        dim_employee_key = -9,
		        dim_client_key = -9,
		        dim_client_referral_key = -9,
		        dim_property_key = -9,
		        dim_property_tenancy_key = -9,
		        dim_service_key = -9,
		        kpi_id = null,
		        service_id = -9,
		        employee_id = -9,
		        client_id = -9,
		        client_referral_id = -9,
		        property_id = null,
		        property_tenancy_id = null,
		        entity_key = null,
		        kpi_value = null,
		        user_friendly_score_explanation = null,
		        kpi_status = null,
		        snapshot_date = null
		    ],
		    targetCols = Record.FieldNames(defaults),
		    have = Table.ColumnNames(resultTable),
		    added = List.Accumulate(targetCols, resultTable, (state, col) => if List.Contains(have, col) then state else Table.AddColumn(state, col, each Record.Field(defaults, col))),
		    aligned = Table.TransformColumns(Table.SelectColumns(added, targetCols, MissingField.UseNull), {{"snapshot_date", Date.From, type date}})
		in
		    aligned
	lineageTag: 8923e161-e2b8-4603-bc91-1b75f70f1656
	queryGroup: 'KPI Testing'

expression 'Test KPI 63 Inspections' =
		let
		    ProcText = "CREATE PROCEDURE [edw].[kpi_tenancy_sp_63_inspections]#(lf)AS#(lf)/**********************************************************************************************************#(lf) Procedure: [edw].[kpi_tenancy_sp_63_inspections]#(lf) Author: GitHub Copilot#(lf) Created: 2026-04-29#(lf) Purpose: Calculates the number of completed qualifying inspections in the last 12 months for#(lf)          qualifying tenancy records for KPI 63.#(lf) User Story: 13462#(lf)#(lf) Notes: Built from the tenancy KPI stored procedure pattern with temp tables and indexing.#(lf) *************************************************************************************************************#(lf)#(lf) REVISIONS:#(lf) Version   Date         Author              Description#(lf)-------   ------------ ------------------- ---------------------------------------------------------------#(lf) 1.0      2026-04-29   GitHub Copilot      Initial version#(lf) 1.1      2026-05-14   GitHub Copilot      Removed CPP (Spot) and Hapai Housing from the IRRS filter#(lf) *************************************************************************************************************/#(lf)#(lf)BEGIN#(lf)    SET NOCOUNT ON;#(lf)#(lf)    DECLARE @SnapshotDate DATE = CAST(GETDATE() AT TIME ZONE 'UTC' AT TIME ZONE 'New Zealand Standard Time' AS DATE);#(lf)    DECLARE @KPI_ID INT = 63;#(lf)#(lf)    -------------------------------------------------------------------------------#(lf)    -- Temp Table 1: CurrentNZTime#(lf)    -------------------------------------------------------------------------------#(lf)    IF OBJECT_ID('tempdb..#CurrentNZTime') IS NOT NULL DROP TABLE #CurrentNZTime;#(lf)#(lf)    SELECT#(lf)        CAST(((GETUTCDATE() AT TIME ZONE 'UTC') AT TIME ZONE 'New Zealand Standard Time') AS DATETIME2) AS CurrentDateTime#(lf)    INTO #CurrentNZTime;#(lf)#(lf)    -------------------------------------------------------------------------------#(lf)    -- Temp Table 2: SelectedKPI#(lf)    -------------------------------------------------------------------------------#(lf)    IF OBJECT_ID('tempdb..#SelectedKPI') IS NOT NULL DROP TABLE #SelectedKPI;#(lf)#(lf)    SELECT TOP 1#(lf)        dim_kpi.kpi_id,#(lf)        dim_kpi.dim_kpi_key,#(lf)        dim_kpi.what_is_measured,#(lf)        dim_kpi.kpi_g_value,#(lf)        dim_kpi.kpi_a_value,#(lf)        dim_kpi.kpi_g_sign,#(lf)        dim_kpi.kpi_a_sign#(lf)    INTO #SelectedKPI#(lf)    FROM edw.dim_kpi#(lf)    WHERE dim_kpi.DWHDMLOperation <> 'D'#(lf)      AND dim_kpi.DWHIsCurrent = 1#(lf)      AND dim_kpi.kpi_id = @KPI_ID#(lf)    ORDER BY dim_kpi.dim_kpi_key DESC;#(lf)#(lf)    -------------------------------------------------------------------------------#(lf)    -- Temp Table 3: Service_type_grouping#(lf)    -------------------------------------------------------------------------------#(lf)    IF OBJECT_ID('tempdb..#Service_type_grouping') IS NOT NULL DROP TABLE #Service_type_grouping;#(lf)#(lf)    SELECT DISTINCT#(lf)        dim_kpi.kpi_id,#(lf)        dim_kpi.dim_kpi_key,#(lf)        dim_service.service_id#(lf)    INTO #Service_type_grouping#(lf)    FROM edw.dim_kpi#(lf)    LEFT JOIN edw.bridge_kpi_measure_to_service_type_group#(lf)        ON dim_kpi.dim_kpi_key = bridge_kpi_measure_to_service_type_group.dim_kpi_key#(lf)    LEFT JOIN edw.dim_kpi_service_type_grouping#(lf)        ON bridge_kpi_measure_to_service_type_group.service_type_grouping_id = dim_kpi_service_type_grouping.dim_kpi_service_type_grouping_key#(lf)        AND dim_kpi_service_type_grouping.DWHIsCurrent = 1#(lf)    LEFT JOIN edw.bridge_kpi_service_type_to_grouping#(lf)        ON bridge_kpi_measure_to_service_type_group.dim_kpi_service_type_grouping_key = bridge_kpi_service_type_to_grouping.dim_kpi_service_type_grouping_key#(lf)    LEFT JOIN edw.dim_kpi_service_type#(lf)        ON bridge_kpi_service_type_to_grouping.dim_kpi_service_type_key = dim_kpi_service_type.dim_kpi_service_type_key#(lf)    LEFT JOIN edw.dim_service#(lf)        ON dim_kpi_service_type.service_type = dim_service.service_type_name#(lf)        AND dim_service.DWHIsCurrent = 1#(lf)        AND dim_service.DWHDMLOperation <> 'D'#(lf)    WHERE dim_kpi.DWHIsCurrent = 1#(lf)      AND dim_kpi.kpi_id = (SELECT kpi_id FROM #SelectedKPI);#(lf)#(lf)    CREATE NONCLUSTERED INDEX IX_Service_type_grouping ON #Service_type_grouping(dim_kpi_key, service_id);#(lf)#(lf)    -------------------------------------------------------------------------------#(lf)    -- Temp Table 4: ms_count_0#(lf)    -------------------------------------------------------------------------------#(lf)    IF OBJECT_ID('tempdb..#ms_count_0') IS NOT NULL DROP TABLE #ms_count_0;#(lf)#(lf)    SELECT#(lf)        (SELECT DISTINCT kpi_id FROM #SelectedKPI) AS kpi_id,#(lf)        service_id#(lf)    INTO #ms_count_0#(lf)    FROM #Service_type_grouping;#(lf)#(lf)    -------------------------------------------------------------------------------#(lf)    -- Temp Table 5: ms_count#(lf)    -------------------------------------------------------------------------------#(lf)    IF OBJECT_ID('tempdb..#ms_count') IS NOT NULL DROP TABLE #ms_count;#(lf)#(lf)    SELECT#(lf)        kpi_id,#(lf)        COUNT(service_id) AS service_count#(lf)    INTO #ms_count#(lf)    FROM #ms_count_0#(lf)    GROUP BY kpi_id;#(lf)#(lf)    -------------------------------------------------------------------------------#(lf)    -- Temp Table 6: Dim_Current_Tenancies#(lf)    -------------------------------------------------------------------------------#(lf)    IF OBJECT_ID('tempdb..#Dim_Current_Tenancies') IS NOT NULL DROP TABLE #Dim_Current_Tenancies;#(lf)#(lf)    SELECT#(lf)        vw_dim_service.dim_company_key,#(lf)        vw_dim_property_tenancy.property_tenancy_id,#(lf)        vw_dim_property_tenancy.dim_property_tenancy_key,#(lf)        COALESCE(vw_dim_service.dim_service_key, dim_service_2.dim_service_key) AS dim_service_key,#(lf)        COALESCE(vw_dim_service.service_id, dim_service_2.service_id) AS service_id,#(lf)        vw_dim_property.property_program,#(lf)        vw_dim_property.property_sub_program,#(lf)        vw_dim_property.property_sub_property_type,#(lf)        vw_dim_property_tenancy.property_tenancy_tenancy_start_date#(lf)    INTO #Dim_Current_Tenancies#(lf)    FROM edw.vw_dim_property_tenancy#(lf)    CROSS JOIN #CurrentNZTime cnt#(lf)    INNER JOIN edw.vw_dim_property#(lf)        ON vw_dim_property_tenancy.property_id = vw_dim_property.property_id#(lf)        AND vw_dim_property.DWHIsCurrent = 1#(lf)        AND vw_dim_property.DWHDMLOperation <> 'D'#(lf)    LEFT JOIN edw.vw_dim_service#(lf)        ON vw_dim_property.property_contract_bc_service_code = vw_dim_service.service_code#(lf)        AND vw_dim_service.DWHIsCurrent = 1#(lf)        AND vw_dim_service.DWHDMLOperation <> 'D'#(lf)    LEFT JOIN edw.vw_dim_service AS dim_service_2#(lf)        ON vw_dim_property.property_bc_service_code = dim_service_2.service_code#(lf)        AND dim_service_2.DWHIsCurrent = 1#(lf)        AND dim_service_2.DWHDMLOperation <> 'D'#(lf)    WHERE vw_dim_property_tenancy.DWHIsCurrent = 1#(lf)      AND vw_dim_property_tenancy.DWHDMLOperation <> 'D'#(lf)      AND vw_dim_property.dim_property_key > 0#(lf)      AND vw_dim_property.property_statecode = 'Active'#(lf)      AND vw_dim_property_tenancy.property_tenant_opportunity_status IN ('new', 'active arrears', 'active')#(lf)      AND vw_dim_property_tenancy.property_tenancy_vacate_confirmation_flag = 0#(lf)      AND vw_dim_property_tenancy.property_tenancy_actual_close_date IS NULL#(lf)      AND vw_dim_property.property_name NOT LIKE '%parent%'#(lf)      AND ISNULL(vw_dim_property.property_confirmed_disposal_date, '2099-12-31') > CAST(cnt.CurrentDateTime AS DATE)#(lf)      AND ISNULL(vw_dim_property.property_acquired_date, '2099-12-31') <= CAST(cnt.CurrentDateTime AS DATE)#(lf)      AND LOWER(ISNULL(vw_dim_property.property_status, '')) <> 'vacant: un-tenantable'#(lf)      AND vw_dim_property.property_current_tenancy IS NOT NULL#(lf)      AND (#(lf)            (#(lf)                (#(lf)                    (ISNULL(vw_dim_property.property_program, '') = 'Affordable Housing Management' AND ISNULL(vw_dim_property.property_sub_program, '') = 'Rotorua Lakes Council')#(lf)                 OR (ISNULL(vw_dim_property.property_program, '') = 'Affordable Rental' AND ISNULL(vw_dim_property.property_sub_program, '') = 'Affordable Rental')#(lf)                 OR (ISNULL(vw_dim_property.property_program, '') = 'Boarding' AND ISNULL(vw_dim_property.property_sub_program, '') = 'Residential Services Boarding')#(lf)                 OR (ISNULL(vw_dim_property.property_program, '') = 'IRRS' AND ISNULL(vw_dim_property.property_sub_program, '') IN (#(lf)                        'CCP (Creating Positive Pathways Spot)',#(lf)                        'Housing First (SPOT)',#(lf)                        'Social Housing (Capacity)',#(lf)                        'Social Housing (SPOT)',#(lf)                        'Social Housing TM'#(lf)                    ))#(lf)                )#(lf)                AND vw_dim_property_tenancy.property_tenancy_tenancy_start_date IS NOT NULL#(lf)                AND DATEDIFF(DAY, vw_dim_property_tenancy.property_tenancy_tenancy_start_date, CAST(cnt.CurrentDateTime AS DATE)) >= 365#(lf)            )#(lf)         OR (#(lf)                ISNULL(vw_dim_property.property_program, '') = 'Transitional Housing'#(lf)            AND ISNULL(vw_dim_property.property_sub_program, '') = 'Transitional Housing'#(lf)            AND ISNULL(vw_dim_property.property_sub_property_type, '') <> 'Office'#(lf)            )#(lf)      )#(lf)      AND ISNULL(vw_dim_property.property_program, '') <> 'Motels'#(lf)      AND ISNULL(vw_dim_property.property_sub_program, '') NOT IN ('Motels', 'Motels (CLS)');#(lf)#(lf)    CREATE CLUSTERED INDEX IX_Dim_Current_Tenancies ON #Dim_Current_Tenancies(property_tenancy_id);#(lf)    CREATE NONCLUSTERED INDEX IX_Dim_Current_Tenancies_service ON #Dim_Current_Tenancies(service_id, dim_company_key);#(lf)#(lf)    -------------------------------------------------------------------------------#(lf)    -- Temp Table 7: DimCurrentTenancies2#(lf)    -------------------------------------------------------------------------------#(lf)    IF OBJECT_ID('tempdb..#DimCurrentTenancies2') IS NOT NULL DROP TABLE #DimCurrentTenancies2;#(lf)#(lf)    SELECT#(lf)        vw_dim_service.dim_company_key,#(lf)        dct.dim_service_key,#(lf)        dct.property_tenancy_id,#(lf)        dct.dim_property_tenancy_key,#(lf)        dct.service_id,#(lf)        dim_kpi_service_type_grouping.service_type_grouping#(lf)    INTO #DimCurrentTenancies2#(lf)    FROM #Dim_Current_Tenancies dct#(lf)    LEFT JOIN edw.vw_dim_service#(lf)        ON dct.dim_service_key = vw_dim_service.dim_service_key#(lf)        AND vw_dim_service.DWHDMLOperation <> 'D'#(lf)        AND vw_dim_service.DWHIsCurrent = 1#(lf)    LEFT JOIN edw.dim_kpi_service_type#(lf)        ON vw_dim_service.service_type_name = dim_kpi_service_type.service_type#(lf)        AND dim_kpi_service_type.DWHIsCurrent = 1#(lf)    LEFT JOIN edw.bridge_kpi_service_type_to_grouping#(lf)        ON dim_kpi_service_type.dim_kpi_service_type_key = bridge_kpi_service_type_to_grouping.dim_kpi_service_type_key#(lf)    LEFT JOIN edw.dim_kpi_service_type_grouping#(lf)        ON bridge_kpi_service_type_to_grouping.service_type_grouping_id = dim_kpi_service_type_grouping.service_type_grouping_id#(lf)        AND dim_kpi_service_type_grouping.DWHIsCurrent = 1#(lf)    WHERE dct.dim_service_key IS NOT NULL;#(lf)#(lf)    CREATE CLUSTERED INDEX IX_DimCurrentTenancies2 ON #DimCurrentTenancies2(property_tenancy_id);#(lf)    CREATE NONCLUSTERED INDEX IX_DimCurrentTenancies2_service ON #DimCurrentTenancies2(service_id, dim_company_key);#(lf)#(lf)    -------------------------------------------------------------------------------#(lf)    -- Temp Table 8: QualifyingInspections#(lf)    -------------------------------------------------------------------------------#(lf)    IF OBJECT_ID('tempdb..#QualifyingInspections') IS NOT NULL DROP TABLE #QualifyingInspections;#(lf)#(lf)    SELECT#(lf)        fact_property_inspection.property_tenancy_id,#(lf)        fact_property_inspection.property_inspection_id#(lf)    INTO #QualifyingInspections#(lf)    FROM edw.fact_property_inspection#(lf)    INNER JOIN edw.dim_date#(lf)        ON fact_property_inspection.property_inspection_completion_date_key = dim_date.dim_date_key#(lf)    WHERE fact_property_inspection.DWHDMLOperation <> 'D'#(lf)      AND fact_property_inspection.property_tenancy_id IS NOT NULL#(lf)      AND fact_property_inspection.property_inspection_status = 'Completed'#(lf)      AND dim_date.current_date_rolling_month_offset BETWEEN -12 AND 0#(lf)      AND fact_property_inspection.property_inspection_category IN (#(lf)            'Tenancy Routine Inspection',#(lf)            'Tenancy Inspection Report',#(lf)            'Property Condition Report'#(lf)      )#(lf)      AND fact_property_inspection.property_inspection_type IN (#(lf)            'Ad-hoc Inspection',#(lf)            'Ad-hoc inspection',#(lf)            'Ingoing tenancy',#(lf)            'Ingoing Tenancy',#(lf)            'Outgoing tenancy',#(lf)            'Outgoing Tenancy',#(lf)            'Pre-vacate Inspection',#(lf)            'Residential condition inspection',#(lf)            'Residential Condition Inspection',#(lf)            'Routine tenancy',#(lf)            'Routine Inspection',#(lf)            'Welcome Inspection'#(lf)      );#(lf)#(lf)    CREATE CLUSTERED INDEX IX_QualifyingInspections ON #QualifyingInspections(property_tenancy_id);#(lf)#(lf)    -------------------------------------------------------------------------------#(lf)    -- Temp Table 9: CountInspections#(lf)    -------------------------------------------------------------------------------#(lf)    IF OBJECT_ID('tempdb..#CountInspections') IS NOT NULL DROP TABLE #CountInspections;#(lf)#(lf)    SELECT#(lf)        property_tenancy_id,#(lf)        CAST(COUNT(DISTINCT property_inspection_id) AS NUMERIC(8, 2)) AS kpi_value#(lf)    INTO #CountInspections#(lf)    FROM #QualifyingInspections#(lf)    GROUP BY property_tenancy_id;#(lf)#(lf)    CREATE CLUSTERED INDEX IX_CountInspections ON #CountInspections(property_tenancy_id);#(lf)#(lf)    -------------------------------------------------------------------------------#(lf)    -- Temp Table 10: FinalTable#(lf)    -------------------------------------------------------------------------------#(lf)    IF OBJECT_ID('tempdb..#FinalTable') IS NOT NULL DROP TABLE #FinalTable;#(lf)#(lf)    SELECT#(lf)        dct2.dim_company_key,#(lf)        dct2.dim_property_tenancy_key,#(lf)        dct2.property_tenancy_id,#(lf)        dct2.dim_service_key,#(lf)        dct2.service_id,#(lf)        ISNULL(ci.kpi_value, 0) AS kpi_value#(lf)    INTO #FinalTable#(lf)    FROM #DimCurrentTenancies2 dct2#(lf)    LEFT JOIN #CountInspections ci#(lf)        ON dct2.property_tenancy_id = ci.property_tenancy_id;#(lf)#(lf)    CREATE CLUSTERED INDEX IX_FinalTable ON #FinalTable(property_tenancy_id);#(lf)    CREATE NONCLUSTERED INDEX IX_FinalTable_service ON #FinalTable(service_id, dim_company_key);#(lf)#(lf)    -------------------------------------------------------------------------------#(lf)    -- Final SELECT - Returns the tenancy KPI snapshot shape#(lf)    -------------------------------------------------------------------------------#(lf)    SELECT#(lf)        sk.dim_kpi_key,#(lf)        ft.dim_company_key,#(lf)        ft.dim_property_tenancy_key,#(lf)        ft.dim_service_key,#(lf)        CONCAT('888', '_', ft.property_tenancy_id, '_', ft.service_id, '_', ft.dim_company_key) AS entity_key,#(lf)        @KPI_ID AS kpi_id,#(lf)        ft.property_tenancy_id,#(lf)        ft.service_id,#(lf)        ft.kpi_value,#(lf)        CASE#(lf)            WHEN ft.kpi_value = 0 THEN 'No completed inspections in last 12 months'#(lf)            WHEN ft.kpi_value = 1 THEN '1 completed inspection in last 12 months'#(lf)            ELSE CONCAT(CAST(ft.kpi_value AS INT), ' completed inspections in last 12 months')#(lf)        END AS user_friendly_score_explanation,#(lf)        CASE#(lf)            WHEN ft.kpi_value IS NULL THEN 1#(lf)            WHEN (sk.kpi_g_sign = '>=' AND ft.kpi_value >= sk.kpi_g_value)#(lf)              OR (sk.kpi_g_sign = '>' AND ft.kpi_value > sk.kpi_g_value)#(lf)              OR (sk.kpi_g_sign = '<=' AND ft.kpi_value <= sk.kpi_g_value)#(lf)              OR (sk.kpi_g_sign = '<' AND ft.kpi_value < sk.kpi_g_value)#(lf)              OR (sk.kpi_g_sign = '=' AND ft.kpi_value = sk.kpi_g_value)#(lf)                THEN 3#(lf)            WHEN (sk.kpi_a_sign = '>=' AND ft.kpi_value >= sk.kpi_a_value)#(lf)              OR (sk.kpi_a_sign = '>' AND ft.kpi_value > sk.kpi_a_value)#(lf)              OR (sk.kpi_a_sign = '<=' AND ft.kpi_value <= sk.kpi_a_value)#(lf)              OR (sk.kpi_a_sign = '<' AND ft.kpi_value < sk.kpi_a_value)#(lf)              OR (sk.kpi_a_sign = '=' AND ft.kpi_value = sk.kpi_a_value)#(lf)                THEN 2#(lf)            ELSE 1#(lf)        END AS kpi_status,#(lf)        @SnapshotDate AS snapshot_date#(lf)    FROM #FinalTable ft#(lf)    CROSS JOIN #SelectedKPI sk#(lf)    LEFT JOIN #Service_type_grouping stg#(lf)        ON sk.dim_kpi_key = stg.dim_kpi_key#(lf)        AND ft.service_id = stg.service_id#(lf)    LEFT JOIN #ms_count mc#(lf)        ON mc.kpi_id = sk.kpi_id#(lf)    WHERE (mc.service_count IS NULL OR mc.service_count = 0)#(lf)       OR (stg.service_id IS NOT NULL);#(lf)#(lf)END",
		    Body = fnExtractProcBody(ProcText),
		    Result = Value.NativeQuery(Sql.Database(Server, Database, [CommandTimeout=#duration(0,0,10,0)]), Body, null, [EnableFolding=false]),
		    Aligned = fnAlignToFactKpi(Result)
		in
		    Aligned
	lineageTag: 06083a37-59e0-40b6-a5b5-2d0dc2afe31a
	queryGroup: 'KPI Testing'

	annotation PBI_ResultType = Table

expression 'Test KPIs Combined' =
		let
		    parts = if #"Enable KPI Testing" then { #"Test KPI 63 Inspections" } else {},
		    combined = if List.IsEmpty(parts) then fnAlignToFactKpi(#table({}, {})) else Table.Combine(parts),
		    removed = Table.RemoveColumns(combined, {"fact_kpi_id"}),
		    indexed = Table.AddIndexColumn(removed, "fact_kpi_id", 900000000, 1, Int64.Type)
		in
		    indexed
	lineageTag: fbf10c96-9b9a-4fb4-9294-9f966b4581f4
	queryGroup: 'KPI Testing'

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

expression 'Prod KPI Snapshot' =
		let
		    Source = Sql.Database(Server, Database),
		    data = Source{[Schema="kpi",Item="fact_kpi_current"]}[Data],
		    sel = Table.SelectColumns(data, {"kpi_id", "service_id", "kpi_status", "kpi_value", "entity_key"})
		in
		    sel
	lineageTag: 982e159a-56a9-45aa-8725-da4d5635d148
	queryGroup: 'KPI Testing'

	annotation PBI_ResultType = Table

expression 'Enable KPI Testing' = false meta [IsParameterQuery=true, DefaultValue=false, Type="Logical", IsParameterQueryRequired=true]
	lineageTag: 939b40e0-734b-4b08-b2b1-1b7370e678d6
	queryGroup: 'KPI Testing'

	annotation PBI_ResultType = Logical

