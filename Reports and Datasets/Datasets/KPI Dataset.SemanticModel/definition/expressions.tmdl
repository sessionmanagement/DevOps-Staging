 AND de.DWHIsCurrent = 1#(lf)     INNER JOIN tenancy_managers tm#(lf)    ON tm.property_assigned_tenancy_manager = #(lf)       LTRIM(RTRIM(#(lf)           CASE #(lf)               WHEN CHARINDEX('(', deh.employee_displayname) > 0 #(lf)                    AND CHARINDEX(')', deh.employee_displayname) > CHARINDEX('(', deh.employee_displayname)#(lf)               THEN #(lf)                   REPLACE(#(lf)                       STUFF(#(lf)                           deh.employee_displayname,#(lf)                           CHARINDEX('(', deh.employee_displayname),#(lf)                           CHARINDEX(')', deh.employee_displayname) - CHARINDEX('(', deh.employee_displayname) + 1,#(lf)                           ''#(lf)                       ), '  ', ' '#(lf)                   )#(lf)               ELSE deh.employee_displayname#(lf)           END#(lf)       ))#(lf)    CROSS APPLY (#(lf)        VALUES#(lf)            (1, employee_people_leader_email_level_1),#(lf)            (2, employee_people_leader_email_level_2),#(lf)            (3, employee_people_leader_email_level_3),#(lf)            (4, employee_people_leader_email_level_4),#(lf)            (5, employee_people_leader_email_level_5),#(lf)            (6, employee_people_leader_email_level_6),#(lf)            (7, employee_people_leader_email_level_7),#(lf)            (8, employee_people_leader_email_level_8),#(lf)            (9, employee_people_leader_email_level_9)#(lf)    ) AS hierarchy_levels(level_number, leader_email)#(lf)    WHERE deh.DWHDMLOperation <> 'D'#(lf)    AND deh.DWHIsCurrent = 1#(lf)    AND deh.employee_company_name COLLATE Latin1_General_CI_AI#(lf)        NOT IN ('previous business entity', 'ignite aotearoa')#(lf)    AND hierarchy_levels.leader_email IS NOT NULL#(lf))#(lf)#(lf)   SELECT DISTINCT#(lf)        property_id,#(lf)        dim_property_key,#(lf)        dim_property_tenancy_key,#(lf)        property_tenancy_id,#(lf)        property_name,#(lf)        leader_email AS user_principal_name#(lf)    FROM employee_hierarchy#(lf) --rls_access#(lf)WHERE leader_email IS NOT NULL#(lf)AND dim_property_tenancy_key IS NOT NULL#(lf)--AND property_name   LIKE '%Rm 3/578 Fraser Street%'#(lf)"]),
		    ApplyNamingConventions = (columnName as text) as text =>
		        let
		            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
		            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
		            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
