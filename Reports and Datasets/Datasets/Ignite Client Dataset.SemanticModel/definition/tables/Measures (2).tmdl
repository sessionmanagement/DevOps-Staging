	measure 'Active Users Ratio - Sector' = ```
			
			VAR __SUM = CALCULATE([Active Users % - Average]
			                        ,ALLEXCEPT('Dim Organisation', 'Dim Organisation'[Sector],'Dim Organisation'[Exclude from Any Comparative Measures])
			                    )
			VAR __CALC = IF(ISBLANK([Active Users % - Average]),
			                0,
			                DIVIDE([Active Users % - Average],
			                       __SUM
			                        )   
			                -1)
			RETURN
