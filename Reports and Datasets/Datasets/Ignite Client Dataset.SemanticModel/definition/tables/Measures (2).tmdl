	measure 'DV - Template 1 - Average across all organisations' =
			
			SWITCH(
			    SELECTEDVALUE(Template_1[ID])
			    ,1, FORMAT([Active Users Ratio - Average Across All Organisation],"0.0%")
			    ,2, FORMAT([Mood Diary Usage Ratio - Average Across All Organisations],"0.0%")
			    ,3, FORMAT([Wellbeing Utilization Ratio - Average Across All Organisations],"0.0%")
			    ,4, [Average Wellbeing Per Domain Ratio - Average Across All Organisations]
			)
		displayFolder: Template 1 Measures
		lineageTag: bcf50684-62ff-4655-9ab8-a3b7a8564060

	measure 'DV - Template 1 - Average across industry' =
			
			VAR __ChosenSector = SELECTEDVALUE('Dim Organisation'[Sector])
			
			RETURN
			SWITCH(
			    SELECTEDVALUE(Template_1[ID])
			    ,1, FORMAT(CALCULATE([Active Users Ratio - Sector],'Dim Organisation'[Sector]=__ChosenSector),"0.0%")
			    ,2, FORMAT(CALCULATE([Mood Diary Usage Ratio - Sector],'Dim Organisation'[Sector]=__ChosenSector),"0.0%")
			    ,3, FORMAT(CALCULATE([Wellbeing Utilization Ratio - Sector],'Dim Organisation'[Sector]=__ChosenSector),"0.0%")
			    ,4, CALCULATE([Average Wellbeing Per Domain Ratio - Sector],'Dim Organisation'[Sector]=__ChosenSector)
			)
		displayFolder: Template 1 Measures
		lineageTag: 64413737-2688-42e7-b160-da6c0e793f45

	measure 'DV - Template 1 - Average for this organisation' =
			
			VAR __ChosenOrganisation = SELECTEDVALUE('Dim Organisation'[Organisation])
			RETURN
			SWITCH(
			    SELECTEDVALUE(Template_1[ID])
			    ,1, FORMAT([Active Users %],"0.0%")
			    ,2, FORMAT([Mood Diary Usage %],"0.0%")
			    ,3, FORMAT([Wellbeing Utilization %],"0.0%")
			    ,4, CALCULATE(AVERAGE('Ignite Data'[Average Wellbeing per domain]),'Dim Organisation'[Organisation]=__ChosenOrganisation)
			)
		displayFolder: Template 1 Measures
		lineageTag: 57c96ad2-6bdd-4a14-ad40-93d00a6a613a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Active Users Ratio - Average Across All Organisation' = ```
			
