table 'Measures (2)'
	lineageTag: 8c2df8b3-27fe-4e33-95b8-381048057087

	measure 'Max Date' = MAX('Wellbeing Data'[Date])
		formatString: General Date
		lineageTag: 95210750-f29c-49ae-8cb2-04457af499e4

	measure 'Min Date' = MIN('Wellbeing Data'[Date])
		formatString: General Date
		lineageTag: 3f0f9029-5c35-4d9b-a058-9c25ee3b9785

	measure 'Selected Month' = Format([Max Date],"Mmmm YYYY")
		displayFolder: Selected Values
		lineageTag: db5cb4b8-7368-4de3-b2fc-f410a03a265f

	measure 'Selected Organisation' = SELECTEDVALUE('Dim Organisation'[Organisation],"More than one Organisation is selected")
		displayFolder: Selected Values
		lineageTag: 03219d46-2868-42df-83b6-f723eecf6479

	measure 'Page Header - Users - Org' = [Selected Organisation] & " summary data"
		displayFolder: Page Headers
		lineageTag: bdb53eb5-c010-4040-b565-2474b55a2b53

	measure 'Page Header - Users - Date Banner' = UPPER([Selected Month]) & " REPORT DATA"
		displayFolder: Page Headers
		lineageTag: 37e22b93-3961-4e60-95a3-d0717b41945d

	measure 'Active Users %' = ```
			
			VAR __Total = 
			    DIVIDE (
			        SUM ('Ignite Data'[Active Users] ),
			        SUM ('Ignite Data'[Total Users])
			        )
			VAR __IfErr = IF(ISBLANK(SUM('Ignite Data'[Total Users])),
			    0,
			    __Total
			    )
			RETURN
			__Total
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Active Users
		lineageTag: 99cbde29-e4bb-4bd3-958e-c0e817a4972e

	measure 'Bookings Same Period Last Year' = ```
			
			CALCULATE(
			    SUM('Ignite Data'[New Bookings]), 
			    SAMEPERIODLASTYEAR(Dates[Date])
			)
			```
		formatString: 0
		lineageTag: 1327f487-ecbc-4e8a-b44a-efd9f4137a42

	measure 'Current Quarter Average Rating' =
			
			CALCULATE(AVERAGE('Wellbeing Data'[Rating])
			            ,Dates[Current Quarter]=1)
		formatString: 0.0
		displayFolder: Wellbeing Domains
		lineageTag: ca4a4b8e-1805-44d4-a958-f94f704376a6

	measure 'Previous Quarter Average Rating' =
			
			CALCULATE(AVERAGE('Wellbeing Data'[Rating])
			            ,Dates[Q-1]=1)
		formatString: 0.0
		displayFolder: Wellbeing Domains
		lineageTag: 7f3d4e82-a0bf-4631-82e0-3d3d2a478ad9

	measure 'Three Quarters Ago Average Rating' =
			
			CALCULATE(AVERAGE('Wellbeing Data'[Rating])
			            ,Dates[Q-3]=1)
		formatString: 0.0
		displayFolder: Wellbeing Domains
		lineageTag: 5e501d06-1fea-4fb8-afa4-bca837e24016

	measure 'Two Quarter Ago Average Rating' =
			
			CALCULATE(AVERAGE('Wellbeing Data'[Rating])
			            ,Dates[Q-2]=1)
		formatString: 0.0
		displayFolder: Wellbeing Domains
		lineageTag: 61901b50-79c3-48f9-926d-0cf4ca3be5ce

	measure 'Highest Rated Domain' = ```
			
			VAR __Tbl = SUMMARIZE (FILTER('Wellbeing Data',RELATED(Dates[Current Quarter])=1)
			                        ,'Wellbeing Data'[Wellbeing Domains]
			                        ,"Average", Average ( 'Wellbeing Data'[Rating] )
			                        )
			VAR __TOP1 = MAXX (TOPN ( 1
			                        ,__Tbl
			                         ,[Average], DESC
			                         ),
			                         'Wellbeing Data'[Wellbeing Domains]
			                        )   
			VAR __NoData = "Latest Quarter Data Unavailable"
			RETURN
			
			IF(ISBLANK(__TOP1),__NoData,__TOP1)
			/* Commented out by CN 2022-03-08
			CALCULATE(
			    FIRSTNONBLANK('Wellbeing Data'[Domain],1) 
			        ,'Wellbeing Data'[Rating] = MAX('Wellbeing Data'[Rating])
			        ,Dates[Current Quarter] = 1
			)
			CALCULATE(
			    FIRSTNONBLANK('Wellbeing Data'[Domain],1) 
			    ,[Current Quarter Average Rating] = MAX([Current Quarter Average Rating])
			    ,Dates[Current Quarter] = 1
			)
			*/
			```
		displayFolder: Wellbeing Domains
		lineageTag: 7a0b77a4-e01f-4086-a7b2-db58cdd08c0c

