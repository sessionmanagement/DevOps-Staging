	measure 'Mood Diary Usage %' = ```
			
			    IF(ISBLANK(SUM('Ignite Data'[Mood User Utilisation])),
			    0,
			    DIVIDE (
			        SUM ('Ignite Data'[Mood User Utilisation] ),
			        SUM ('Ignite Data'[Active Users])
			        )
			    )
