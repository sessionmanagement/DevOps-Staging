	measure 'DV - Template 2 - Average across all organisations' =
			
			VAR __AllExcept = ALLEXCEPT('Dim Organisation', 'Dim Organisation'[Exclude from Any Comparative Measures])
			RETURN
			SWITCH(
			    SELECTEDVALUE(Template_2[ID])
			    ,1, CALCULATE(AVERAGE('Ignite Data'[Mind]),__AllExcept)
			    ,2, CALCULATE(AVERAGE('Ignite Data'[Body]),__AllExcept)
			    ,3, CALCULATE(AVERAGE('Ignite Data'[Habits]),__AllExcept)
			    ,4, CALCULATE(AVERAGE('Ignite Data'[Home]),__AllExcept)
			    ,5, CALCULATE(AVERAGE('Ignite Data'[Relationships]),__AllExcept)
			    ,6, CALCULATE(AVERAGE('Ignite Data'[Occupation]),__AllExcept)
			    ,7, CALCULATE(AVERAGE('Ignite Data'[Finances]),__AllExcept)
			    ,8, CALCULATE(AVERAGE('Ignite Data'[Recreation]),__AllExcept)
			    ,9, CALCULATE(AVERAGE('Ignite Data'[Identity]),__AllExcept)
			    ,10, CALCULATE(AVERAGE('Ignite Data'[Beliefs]),__AllExcept)
			    ,11, CALCULATE(AVERAGE('Ignite Data'[Culture]),__AllExcept)
			    ,12, CALCULATE(AVERAGE('Ignite Data'[Connectedness]),__AllExcept)
			)
		displayFolder: Template 2 Measures
		lineageTag: 3fdbf5c4-0caa-4216-9cc9-16b4581af947

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DV - Template 2 - Average across industry' =
			
			VAR __AllExcept = ALLEXCEPT('Dim Organisation', 'Dim Organisation'[Sector],'Dim Organisation'[Exclude from Any Comparative Measures])
			VAR __ChosenSector = SELECTEDVALUE('Dim Organisation'[Sector])
			
			RETURN
			SWITCH(
			    SELECTEDVALUE(Template_2[ID])
			    ,1, CALCULATE(AVERAGE('Ignite Data'[Mind]),__AllExcept,'Dim Organisation'[Sector]=__ChosenSector)
			    ,2, CALCULATE(AVERAGE('Ignite Data'[Body]),__AllExcept,'Dim Organisation'[Sector]=__ChosenSector)
			    ,3, CALCULATE(AVERAGE('Ignite Data'[Habits]),__AllExcept,'Dim Organisation'[Sector]=__ChosenSector)
			    ,4, CALCULATE(AVERAGE('Ignite Data'[Home]),__AllExcept,'Dim Organisation'[Sector]=__ChosenSector)
			    ,5, CALCULATE(AVERAGE('Ignite Data'[Relationships]),__AllExcept,'Dim Organisation'[Sector]=__ChosenSector)
			    ,6, CALCULATE(AVERAGE('Ignite Data'[Occupation]),__AllExcept,'Dim Organisation'[Sector]=__ChosenSector)
			    ,7, CALCULATE(AVERAGE('Ignite Data'[Finances]),__AllExcept,'Dim Organisation'[Sector]=__ChosenSector)
			    ,8, CALCULATE(AVERAGE('Ignite Data'[Recreation]),__AllExcept,'Dim Organisation'[Sector]=__ChosenSector)
			    ,9, CALCULATE(AVERAGE('Ignite Data'[Identity]),__AllExcept,'Dim Organisation'[Sector]=__ChosenSector)
			    ,10, CALCULATE(AVERAGE('Ignite Data'[Beliefs]),__AllExcept,'Dim Organisation'[Sector]=__ChosenSector)
			    ,11, CALCULATE(AVERAGE('Ignite Data'[Culture]),__AllExcept,'Dim Organisation'[Sector]=__ChosenSector)
			    ,12, CALCULATE(AVERAGE('Ignite Data'[Connectedness]),__AllExcept,'Dim Organisation'[Sector]=__ChosenSector)
			)
		displayFolder: Template 2 Measures
		lineageTag: b634e4dc-7ba6-4e42-9bf3-ab1c2f268ebb

