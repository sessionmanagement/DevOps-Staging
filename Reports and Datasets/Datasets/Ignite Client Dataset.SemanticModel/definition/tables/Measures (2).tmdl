	measure 'DV - Template 1 - Average across similar sized organisations' =
			
			VAR __ChosenSizeOfOrg = SELECTEDVALUE('Dim Organisation'[Size of Organisation])
			
			RETURN
			SWITCH(
			    SELECTEDVALUE(Template_1[ID])
			    ,1, FORMAT(CALCULATE([Active Users Ratio - Similar Size],'Dim Organisation'[Size of Organisation]=__ChosenSizeOfOrg),"0.0%")
			    ,2, FORMAT(CALCULATE([Mood Diary Usage Ratio - Similar Size],'Dim Organisation'[Size of Organisation]=__ChosenSizeOfOrg),"0.0%")
			    ,3, FORMAT(CALCULATE([Wellbeing Utilization Ratio - Similar Size],'Dim Organisation'[Size of Organisation]=__ChosenSizeOfOrg),"0.0%")
			    ,4, CALCULATE([Average Wellbeing Per Domain Ratio - Similar Size],'Dim Organisation'[Size of Organisation]=__ChosenSizeOfOrg)
			)
