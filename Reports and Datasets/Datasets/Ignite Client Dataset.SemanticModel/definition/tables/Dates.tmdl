	measure 'Wellbeing Utilization Ratio - Similar Size' = ```
			
			VAR __SUM = CALCULATE([Wellbeing Utilization %]
			                        ,ALLEXCEPT('Dim Organisation', 'Dim Organisation'[Size of Organisation],'Dim Organisation'[Exclude from Any Comparative Measures])
			                    )
			VAR __CALC = IF(ISBLANK([Wellbeing Utilization %]),
			                0,
			                DIVIDE([Wellbeing Utilization %],
			                       __SUM
			                        )   
			                -1)
			RETURN
			__SUM
			```
