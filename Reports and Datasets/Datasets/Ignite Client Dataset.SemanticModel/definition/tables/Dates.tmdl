	column 'Current Quarter' = ```
			
			VAR DateinQ = MAX(Dates[Date])
			RETURN
			    IF(Dates[YrQtr] = 
			        YEAR (DateinQ) & CONCATENATE ( "Q", CEILING ( MONTH(DateinQ) / 3, 1 ) ) 
			        ,1
			        ,0
			        )
			```
		formatString: 0
		lineageTag: c5e358b8-1924-489e-929f-b41772014b14
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Q-1 = ```
			
			VAR __DateinQ = QUARTER(MAX(Dates[Date]))
			VAR __DateinY = YEAR(MAX(Dates[Date]))
			VAR __PrevQuarter = if(__DateinQ > 1
			                        , __DateinY & "Q" & __DateinQ-1
			                        , __DateinY-1 & "Q" & 4)
			
			//VAR __CurrentQuarter = YEAR ( __DateinQ ) & CONCATENATE ( "Q", CEILING ( MONTH ( __DateinQ ) / 3, 1 ) )
			
			RETURN
			    IF(Dates[YrQtr] = 
			        __PrevQuarter 
			        ,1
			        ,0
			        )
			//MAX(Dates[Date])
			//__DateinY
			//__CurrentQuarter
			//__PrevQuarter
			```
		formatString: 0
		lineageTag: f50bc7f0-f471-4b02-8d30-b85fc0d0eb4d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Q-2 = ```
			
			VAR __DateinQ = QUARTER(MAX(Dates[Date]))
			VAR __DateinY = YEAR(MAX(Dates[Date]))
			VAR __PrevQuarter = if(OR(__DateinQ = 3, __DateinQ = 4)
			                        , __DateinY & "Q" & __DateinQ-2
			                        , __DateinY-1 & "Q" & __DateinQ+2)
			
			//VAR __CurrentQuarter = YEAR ( __DateinQ ) & CONCATENATE ( "Q", CEILING ( MONTH ( __DateinQ ) / 3, 1 ) )
			
			RETURN
			    IF(Dates[YrQtr] = 
			        __PrevQuarter 
			        ,1
			        ,0
			        )
			//MAX(Dates[Date])
			//__DateinY
			//__CurrentQuarter
			//__PrevQuarter
			```
		formatString: 0
		lineageTag: 7dac6fe9-0469-45c0-a139-be2fe9960348
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Q-3 = ```
			
			VAR __DateinQ = QUARTER(MAX(Dates[Date]))
			VAR __DateinY = YEAR(MAX(Dates[Date]))
			VAR __PrevQuarter = if(__DateinQ = 4
			                        , __DateinY & "Q1"
			                        , __DateinY-1 & "Q" & __DateinQ+1)
			
			//VAR __CurrentQuarter = YEAR ( __DateinQ ) & CONCATENATE ( "Q", CEILING ( MONTH ( __DateinQ ) / 3, 1 ) )
			
			RETURN
			    IF(Dates[YrQtr] = 
			        __PrevQuarter 
			        ,1
			        ,0
			        )
			//MAX(Dates[Date])
			//__DateinY
			//__CurrentQuarter
			//__PrevQuarter
			```
		formatString: 0
		lineageTag: a3bbce9c-a5e1-4cef-8cd8-ccf7e48d7277
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Current Month' =
			
			VAR DateinM = MAX(Dates[Date])
			RETURN
			    IF(  Dates[YrMonth] = 100 * YEAR(DateinM) + MONTH(DateinM)
			        ,1
			        ,0
			        )
		formatString: 0
		lineageTag: 6caa2dc5-6b79-4e92-9674-00e45c6bae33
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition Dates-f1b7b90c-411c-4a33-b4aa-ce4fe776bd0e = calculated
		mode: import
		source = ```
				
				VAR MinDate = [Min Date]
				VAR MaxDate = [Max Date]
				
				VAR BaseCalendar =
				    CALENDAR ( MinDate, MaxDate )
				RETURN
				    GENERATE (
				        BaseCalendar,
				        VAR BaseDate = [Date]
				        VAR YearDate =
				            YEAR ( BaseDate )
				        VAR MonthNumber =
				            MONTH ( BaseDate )
				        VAR YrMonth =
				            100 * YEAR ( BaseDate )
				                + MONTH ( BaseDate )
				        VAR Qtr =
				            CONCATENATE ( "Q", CEILING ( MONTH ( BaseDate ) / 3, 1 ) )
				        VAR YrMonthQtr =
				            100 * YEAR ( BaseDate )
				                + MONTH ( BaseDate )
				                & CONCATENATE ( "Q", CEILING ( MONTH ( BaseDate ) / 3, 1 ) )
				        VAR YrQtr =
				            YEAR ( BaseDate )
				                & CONCATENATE ( "Q", CEILING ( MONTH ( BaseDate ) / 3, 1 ) )                
				        VAR YrMonthQtrDay =
				            100 * YEAR ( BaseDate )
				                + MONTH ( BaseDate )
				                & CONCATENATE ( "Q", CEILING ( MONTH ( BaseDate ) / 3, 1 ) )
				                & DAY ( BaseDate )
				        RETURN
				            ROW (
				                "Day", BaseDate,
				                "Year", YearDate,
				                "Month Number", MonthNumber,
				                "Month", FORMAT ( BaseDate, "mmmm" ),
				                "Year Month", FORMAT ( BaseDate, "mmm yy" ),
				                "YrMonth", YrMonth,
				                "Qtr", Qtr,
				                "YrMonthQtr", YrMonthQtr,
				                "YrQtr", YrQtr,
				                "YrMonthQtrday", YrMonthQtrDay
				            ))
				```

	annotation PBI_Id = 3411ca9b548a48c289c4d4f4820f3050

