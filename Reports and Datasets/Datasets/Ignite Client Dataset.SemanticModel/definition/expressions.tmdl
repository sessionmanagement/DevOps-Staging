expression 'Import Data' = ```
		let
		    // ------------------------------
		    // 1. GET SOURCE FILES
		    // ------------------------------
		    Source = SharePoint.Files(
		        "https://emergeaotearoaltd.sharepoint.com/sites/IgniteClientandKPIreporting/",
		        [ApiVersion = 15]
		    ),
		
		    #"Filtered Rows" =
		        Table.SelectRows(Source, each [Extension] = ".csv"),
		
		    #"Filtered Rows1" =
		        Table.SelectRows(#"Filtered Rows", each Text.Contains([Name], "Platform Report Data")),
		
		    #"Reordered Columns" =
		        Table.ReorderColumns(
		            #"Filtered Rows1",
		            {"Content", "Name", "Extension", "Date accessed", "Date modified", "Date created", "Folder Path", "Attributes"}
		        ),
		
		    #"Filtered Rows2" =
		        Table.SelectRows(
		            #"Reordered Columns",
		            each [Folder Path] =
		                "https://emergeaotearoaltd.sharepoint.com/sites/IgniteClientandKPIreporting/Shared Documents/Client Report/"
		        ),
		
		
		    // -------------------------------------------------------------
		    // 2. UNIVERSAL HEADER NORMALISATION FUNCTION
		    // -------------------------------------------------------------
		    // This removes underscores, dashes, extra spaces,
		    // lowercases everything, and trims. This ensures that:
		    //   "Active_Users" → "active users"
		    //   "ACTIVE-USERS" → "active users"
		    //   "Active Users" → "active users"
		    HeaderNormalize = (colName as text) as text =>
		        let
		            s1 = Text.Replace(colName, "_", " "),
		            s2 = Text.Replace(s1, "-", " "),
		            s3 = Text.Lower(s2),
		            s4 = Text.Trim(Text.Clean(s3)),
		            s5 = Text.Combine(List.Select(Text.Split(s4, " "), each _ <> ""), " ")
		        in
		            s5,
		
		
		    // -------------------------------------------------------------
		    // 3. APPLY TRANSFORM FILE & NORMALISE HEADERS INSIDE EACH FILE
		    // -------------------------------------------------------------
		    #"Invoke Custom Function1" =
		        Table.AddColumn(
		            #"Filtered Rows2",
		            "Transform File",
		            each
		                let
		                    t = #"Transform File"([Content]),
		                    normalized = Table.TransformColumnNames(t, HeaderNormalize)
		                in
		                    normalized
		        ),
		
		    #"Renamed Columns1" =
		        Table.RenameColumns(#"Invoke Custom Function1", {"Name", "Source.Name"}),
		
		    #"Removed Other Columns1" =
		        Table.SelectColumns(#"Renamed Columns1", {"Source.Name", "Transform File"}),
		
		    #"Removed Errors1" =
		        Table.RemoveRowsWithErrors(#"Removed Other Columns1", {"Transform File"}),
		
		
		    // -------------------------------------------------------------
		    // 4. BUILD THE EXPANSION COLUMN LIST USING THE NORMALISED HEADERS
		    // -------------------------------------------------------------
		    SampleTable = #"Transform File"(#"Sample File"),
		    NormalizedSample =
		        Table.TransformColumnNames(SampleTable, HeaderNormalize),
		
		    ColumnsToExpand = Table.ColumnNames(NormalizedSample),
		
		
		    // -------------------------------------------------------------
		    // 5. EXPAND THE CLEANED TABLES USING NORMALISED COLUMN NAMES
		    // -------------------------------------------------------------
		    #"Expanded Table Column1" =
		        Table.ExpandTableColumn(
		            #"Removed Errors1",
		            "Transform File",
		            ColumnsToExpand,
		            ColumnsToExpand
		        ),
		
		
		    // -------------------------------------------------------------
		    // 6. REST OF YOUR ORIGINAL LOGIC
		    // -------------------------------------------------------------
		    #"Duplicated Column" =
		        Table.DuplicateColumn(#"Expanded Table Column1", "Source.Name", "Date"),
		
		    #"Replaced Value" =
		        Table.ReplaceValue(#"Duplicated Column", "Platform Report Data ", "01 ", Replacer.ReplaceText, {"Date"}),
		
		    #"Replaced Value1" =
		        Table.ReplaceValue(#"Replaced Value", ".csv", "", Replacer.ReplaceText, {"Date"}),
		
		
		    #"Changed Type" =
		        Table.TransformColumnTypes(
		        #"Replaced Value1",
		        {
		            
		            { HeaderNormalize("Organisation"), type text },
		            { HeaderNormalize("Total Users"), Int64.Type },
		            { HeaderNormalize("Total Users Previous Month"), Int64.Type },
		            { HeaderNormalize("Active Users"), Int64.Type },
		            { HeaderNormalize("Active Users Percentage"), Percentage.Type },
		            { HeaderNormalize("Inactive Users"), Int64.Type },
		            { HeaderNormalize("Users added"), Int64.Type },
		            { HeaderNormalize("Bookings All Time"), Int64.Type },
		            { HeaderNormalize("Total Users Booking Support"), Int64.Type },
		            { HeaderNormalize("Booking User Utilisation"), Percentage.Type },
		            { HeaderNormalize("New Bookings"), Int64.Type },
		            { HeaderNormalize("Moods All Time"), Int64.Type },
		            { HeaderNormalize("Moods Previous Month"), Int64.Type },
		            { HeaderNormalize("New Moods"), Int64.Type },
		            { HeaderNormalize("Mood User Utilisation"), Int64.Type },
		            { HeaderNormalize("Percentage of Mood Active Users "), Percentage.Type },
		            { HeaderNormalize("Average Mood Monthly"), Int64.Type },
		            { HeaderNormalize("Wellbeing Tests All Time"), Int64.Type },
		            { HeaderNormalize("Wellbeing Tests Previous Month"), Int64.Type },
		            { HeaderNormalize("New Wellbeing Tests"), Int64.Type },
		            { HeaderNormalize("Wellbeing Test User Utilisation"), Int64.Type },
		            { HeaderNormalize("Percentage of Wellbeing Test Active Users"), Percentage.Type },
		            { HeaderNormalize("Average Wellbeing per domain"), type number },
		            { HeaderNormalize("Mind"), type number  },
		            { HeaderNormalize("Body"), type number  },
		            { HeaderNormalize("Habits"), type number  },
		            { HeaderNormalize("Home"), type number  },
		            { HeaderNormalize("Relationships"), type number  },
		            { HeaderNormalize("Occupation"), type number  },
		            { HeaderNormalize("Finances"), type number  },
		            { HeaderNormalize("Recreation"), type number  },
		            { HeaderNormalize("Identity"), type number  },
		            { HeaderNormalize("Beliefs"), type number  },
		            { HeaderNormalize("Culture"), type number  },
		            { HeaderNormalize("Connectedness"), type number  },
		
		            { HeaderNormalize("MEDIUM-Video"), Int64.Type },
		            { HeaderNormalize("MEDIUM-In Person"), Int64.Type },
		            { HeaderNormalize("MEDIUM-Phone"), Int64.Type },
		
		            { HeaderNormalize("PROVIDERTYPE-Addiction Practitioner"), Int64.Type },
		            { HeaderNormalize("PROVIDERTYPE-Coach"), Int64.Type },
		            { HeaderNormalize("PROVIDERTYPE-Counsellor"), Int64.Type },
		            { HeaderNormalize("PROVIDERTYPE-Financial Advisor"), Int64.Type },
		            { HeaderNormalize("PROVIDERTYPE-Financial Mentor"), Int64.Type },
		            { HeaderNormalize("PROVIDERTYPE-Human Resources Consultant"), Int64.Type },
		            { HeaderNormalize("PROVIDERTYPE-Mentor"), Int64.Type },
		            { HeaderNormalize("PROVIDERTYPE-NLP Practitioner Mentor"), Int64.Type },
		            { HeaderNormalize("PROVIDERTYPE-Occupational Therapist"), Int64.Type },
		            { HeaderNormalize("PROVIDERTYPE-Psychologist"), Int64.Type },
		            { HeaderNormalize("PROVIDERTYPE-Registered Nurse"), Int64.Type },
		            { HeaderNormalize("PROVIDERTYPE-Social Worker"), Int64.Type },
		            { HeaderNormalize("PROVIDERTYPE-Supervisor"), Int64.Type },
		            { HeaderNormalize("PROVIDERTYPE-Wellbeing Practitioner RN"), Int64.Type },
		            { HeaderNormalize("PROVIDERTYPE-Yoga Teacher"), Int64.Type },
		            { HeaderNormalize("PROVIDERTYPE-Dietitian"), Int64.Type },
		            { HeaderNormalize("PROVIDERTYPE-Creative Arts Therapist"), Int64.Type },
		            { HeaderNormalize("PROVIDERTYPE-EFT Tapping"), Int64.Type },
		            { HeaderNormalize("PROVIDERTYPE-Meditation Teacher"), Int64.Type },
		            { HeaderNormalize("PROVIDERTYPE-Rongoa Practitioner"), Int64.Type },
		            { HeaderNormalize("PROVIDERTYPE-Tai Chi  Qigong"), Int64.Type },
		            { HeaderNormalize("PROVIDERTYPE-Holistic Counsellor"), Int64.Type },
		            { HeaderNormalize("PROVIDERTYPE- Hypnotherapist"), Int64.Type },
		            { HeaderNormalize("PROVIDERTYPE- Wellbeing Practitioner"), Int64.Type },
		
		            { ("Date"), type date }
		        }
		    ),
		
		    #"Filtered Rows3" =
		        Table.SelectRows(#"Changed Type", each [organisation] <> ""),
		
		    #"Sorted Rows1" =
		        Table.Sort(#"Filtered Rows3", {{"Date", Order.Descending}}),
		
		    #"Merged Queries" =
		        Table.NestedJoin(
		            #"Sorted Rows1",
		            {"organisation"},
		            #"Dim Organisation",
		            {"Recorded Organisation Name"},
		            "Organisation Names",
		            JoinKind.LeftOuter
		        ),
		
		    #"Expanded Organisation Names" =
		        Table.ExpandTableColumn(#"Merged Queries", "Organisation Names", {"dim_organisation_key"}, {"dim_organisation_key"}),
		    Custom1 = Table.TransformColumnNames(
		        #"Expanded Organisation Names",
		        each Text.Proper(_)
		    )
		in
		    Custom1
		
		
		
		
		
		
		
		
		
		
		
		// let
		//     Source = SharePoint.Files("https://emergeaotearoaltd.sharepoint.com/sites/IgniteClientandKPIreporting/", [ApiVersion = 15]),
		//     #"Filtered Rows" = Table.SelectRows(Source, each ([Extension] = ".csv")),
		//     #"Filtered Rows1" = Table.SelectRows(#"Filtered Rows", each Text.Contains([Name], "Platform Report Data")),
