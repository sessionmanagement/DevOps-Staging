expression 'Support Session Summary' =
		let
		    // Load source table
		    Source = #"Import Data",
		
		    // --- HEADER NORMALISATION STEP ---
		    // 1. Create a function to normalise column names (same logic as earlier)
		    NormalizeHeader = (colName as text) as text =>
		        let
		            lower = Text.Lower(colName),
		            trimmed = Text.Trim(lower),
		            replacedHyphens = Text.Replace(trimmed, "-", " "),
		            replacedUnderscore = Text.Replace(replacedHyphens, "_", " "),
		            collapsedSpaces = Text.Combine(List.Select(Text.Split(replacedUnderscore, " "), each _ <> ""), " ")
		        in
		            collapsedSpaces,
		
		    // 2. Apply the normalisation to the actual table column names
		    NormalisedTable = Table.TransformColumnNames(Source, each NormalizeHeader(_)),
		
		    // Build a normalised list of the columns you want to select
		    ColumnsToSelectRaw = {
		        "MEDIUM-Video", "MEDIUM-In Person", "MEDIUM-Phone",
		        "PROVIDERTYPE-Addiction Practitioner", "PROVIDERTYPE-Coach", "PROVIDERTYPE-Counsellor",
		        "PROVIDERTYPE-Financial Advisor", "PROVIDERTYPE-Financial Mentor",
		        "PROVIDERTYPE-Human Resources Consultant", "PROVIDERTYPE-Mentor",
		        "PROVIDERTYPE-NLP Practitioner Mentor", "PROVIDERTYPE-Occupational Therapist",
		        "PROVIDERTYPE-Psychologist", "PROVIDERTYPE-Registered Nurse",
		        "PROVIDERTYPE-Social Worker", "PROVIDERTYPE-Supervisor",
		        "PROVIDERTYPE-Wellbeing Practitioner RN", "PROVIDERTYPE-Yoga Teacher",
		        "PROVIDERTYPE- Wellbeing Practitioner", "PROVIDERTYPE- Hypnotherapist",
		        "PROVIDERTYPE-Holistic Counsellor",
		        "Date", "dim_organisation_key"
		    },
		
		    ColumnsToSelect = List.Transform(ColumnsToSelectRaw, each NormalizeHeader(_)),
		
		    // Select columns using the normalised names
		    #"Removed Other Columns" = Table.SelectColumns(NormalisedTable, ColumnsToSelect),
		
		    // Unpivot, split and shape
		    #"Unpivoted Columns" = Table.UnpivotOtherColumns(
		        #"Removed Other Columns",
		        {"dim organisation key", "date"},
		        "Attribute", "Value"
		    ),
		
		    #"Split Column" = Table.SplitColumn(
		        #"Unpivoted Columns",
		        "Attribute",
		        Splitter.SplitTextByDelimiter(" ", QuoteStyle.Csv),
		        {"Attribute.1", "Attribute.2"}
		    ),
		
		    #"Filtered Rows1" = Table.SelectRows(#"Split Column", each [Attribute.1] = "medium"),
		
		    #"Replaced Value" = Table.ReplaceValue(#"Filtered Rows1", "medium", "total", Replacer.ReplaceText, {"Attribute.1"}),
		
		    #"Grouped Rows" = Table.Group(
		        #"Replaced Value",
		        {"date", "dim organisation key", "Attribute.1"},
		        {{"Value", each List.Sum([Value]), type number}}
		    ),
		
		    #"Renamed Columns1" = Table.RenameColumns(#"Grouped Rows",{{"Attribute.1", "Mode - Provider"}, {"Value", "Session Booked Count"}, {"date", "Date"}, {"dim organisation key", "Dim_Organisation_Key"}})
		in
		    #"Renamed Columns1"
		
		
		
		
		
		
		
		
		
