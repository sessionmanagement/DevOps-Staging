 J8 ON J7.supervisorPerson_id = J8.person_id#(lf)#(tab)#(tab)AND J7.ODSIsCurrent = 1#(lf)#(tab)#(tab)AND J8.ODSIsCurrent = 1#(lf)#(tab)INNER JOIN IntelliHR.jobs AS J9 ON J8.supervisorPerson_id = J9.person_id#(lf)#(tab)#(tab)AND J8.ODSIsCurrent = 1#(lf)#(tab)#(tab)AND J9.ODSIsCurrent = 1#(lf)#(tab)INNER JOIN IntelliHR.people AS P ON J.person_id = P.people_id#(lf)#(tab)#(tab)AND J.ODSIsCurrent = 1#(lf)#(tab)#(tab)AND P.ODSIsCurrent = 1#(lf)#(tab)#(tab)AND J.isPrimaryJob = 1#(lf)#(tab)INNER JOIN IntelliHR.people AS P1 ON J9.supervisorPerson_id = P1.people_id#(lf)#(tab)#(tab)AND J9.ODSIsCurrent = 1#(lf)#(tab)#(tab)AND P1.ODSIsCurrent = 1#(lf)#(tab)INNER JOIN IntelliHR.business_unit AS bu ON J.businessUnit_id = bu.business_unit_id#(lf)#(tab)#(tab)AND bu.ODSIsCurrent = 1#(lf)#(tab)WHERE J9.supervisorPerson_id IS NOT NULL#(lf)#(tab)),#(lf)additional_access_cte#(lf)AS (#(lf)#(tab)-- get dataset of staff who are allocated to other services from Datapay#(lf)#(tab)-- and then compare this data to the above dataset so that we get a list #(lf)#(tab)-- staff who are allocated to other service but have no staff reporting to them#(lf)#(tab)-- NOTE#(lf)#(tab)-- the staff must be flagged as supervisors in IntelliHR#(lf)#(tab)-- we must the Business Central code in the IntelliHR Business Unit which must match the Code in DataPay#(lf)#(tab)SELECT P.employeeNumber AS employee_number,#(lf)#(tab)#(tab)P.displayName AS employee_display_name,#(lf)#(tab)#(tab)J.name AS job_title,#(lf)#(tab)#(tab)P.primaryEmailAddress_email AS employee_email,#(lf)#(tab)#(tab)P.people_id,#(lf)#(tab)#(tab)J.[businessEntity_id] AS supervisor_businessEntity_id, --Added Change#(lf)#(tab)#(tab)J.[businessEntity_name] AS supervisor_businessEntity_name, --Added Change#(lf)#(tab)#(tab)P.employmentStatus AS employee_employment_status,#(lf)#(tab)#(tab)bu_cc.business_unit_id AS intellihr_business_unit_id,#(lf)#(tab)#(tab)cc.net_home_cost_box_sub_department AS business_unit_name, --Added Change#(lf)#(tab)#(tab)cc.net_home_cost_box_sub_department_code AS intellihr_bc_code#(lf)#(tab)FROM IntelliHR.jobs AS J#(lf)#(tab)INNER JOIN IntelliHR.people AS P ON J.person_id = P.people_id#(lf)#(tab)#(tab)AND J.ODSIsCurrent = 1#(lf)#(tab)#(tab)AND P.ODSIsCurrent = 1#(lf)#(tab)#(tab)AND J.isPrimaryJob = 1#(lf)#(tab)#(tab)AND P.employmentStatus IN (#(lf)#(tab)#(tab)#(tab)'current staff',#(lf)#(tab)#(tab)#(tab)'exiting staff'#(lf)#(tab)#(tab)#(tab))#(lf)#(tab)LEFT JOIN IntelliHR.people AS P1 ON J.supervisorPerson_id = P1.people_id#(lf)#(tab)#(tab)AND J.ODSIsCurrent = 1#(lf)#(tab)#(tab)AND P1.ODSIsCurrent = 1#(lf)#(tab)INNER JOIN IntelliHR.business_unit AS bu ON J.businessUnit_id = bu.business_unit_id#(lf)#(tab)#(tab)AND bu.ODSIsCurrent = 1#(lf)#(tab)INNER JOIN Datapay.cost_allocations AS cc ON cc.employee_code = P.employeeNumber#(lf)#(tab)#(tab)AND cc.home_costing_percentage > 0#(lf)#(tab)#(tab)AND cc.ODSIsCurrent = 1#(lf)#(tab)#(tab)AND bu.name <> cc.net_home_cost_box_sub_department#(lf)#(tab)#(tab)AND bu.code <> cc.net_home_cost_box_sub_department_code#(lf)#(tab)LEFT JOIN IntelliHR.business_unit AS bu_cc ON cc.net_home_cost_box_sub_department_code = bu_cc.code#(lf)#(tab)#(tab)AND bu_cc.ODSIsCurrent = 1#(lf)#(tab)#(tab)AND cc.ODSIsCurrent = 1#(lf)#(tab)WHERE P.isSupervisor = 1#(lf)#(tab)#(lf)#(tab)EXCEPT#(lf)#(tab)#(lf)#(tab)SELECT supervisor_employee_number AS employee_number,#(lf)#(tab)#(tab)supervisor_display_name AS employee_display_name,#(lf)#(tab)#(tab)supervisor_job_title AS job_title,#(lf)#(tab)#(tab)supervisor_email AS employee_email,#(lf)#(tab)#(tab)supervisor_person_id AS people_id,#(lf)#(tab)#(tab)intellihr_business_unit_id,#(lf)#(tab)#(tab)business_unit_name, --Added Change#(lf)#(tab)#(tab)intellihr_bc_code,#(lf)#(tab)#(tab)supervisor_employment_status,#(lf)#(tab)#(tab)supervisor_businessEntity_id, --Added Change#(lf)#(tab)#(tab)supervisor_businessEntity_name --Added Change#(lf)#(tab)FROM CTE#(lf)#(tab)),#(lf)additional_access_rls#(lf)AS (#(lf)#(tab)SELECT COALESCE(p.employeeNumber, aa.employee_number) AS [employee_number],#(lf)#(tab)#(tab)COALESCE(p.displayName, aa.employee_display_name) AS [employee_display_name],#(lf)#(tab)#(tab)COALESCE(p.primaryEmailAddress_email, aa.employee_email) AS [employee_email],#(lf)#(tab)#(tab)COALESCE(j.name, aa.job_title) AS [job_title],#(lf)#(tab)#(tab)COALESCE(p.people_id, aa.people_id) AS [people_id],#(lf)#(tab)#(tab)p.employmentStatus AS employee_employment_status,#(lf)#(tab)#(tab)aa.people_id AS [supervisor_person_id],#(lf)#(tab)#(tab)aa.employee_number AS [supervisor_employee_number],#(lf)#(tab)#(tab)aa.employee_display_name [supervisor_display_name],#(lf)#(tab)#(tab)aa.job_title AS [supervisor_job_title],#(lf)#(tab)#(tab)aa.employee_email AS [supervisor_email],#(lf)#(tab)#(tab)aa.supervisor_businessEntity_id,#(lf)#(tab)#(tab)aa.supervisor_businessEntity_name, --Added Change#(lf)#(tab)#(tab)aa.employee_employment_status AS supervisor_employment_status,#(lf)#(tab)#(tab)aa.intellihr_business_unit_id AS [intellihr_business_unit_id],#(lf)#(tab)#(tab)aa.business_unit_name AS [business_unit_name], --Added Change#(lf)#(tab)#(tab)aa.intellihr_bc_code AS [intellihr_bc_code],#(lf)#(tab)#(tab)99 AS hierarchy_level#(lf)#(tab)FROM additional_access_cte AS aa#(lf)#(tab)LEFT JOIN IntelliHR.jobs AS j ON j.businessUnit_id = aa.intellihr_business_unit_id#(lf)#(tab)#(tab)AND J.ODSIsCurrent = 1#(lf)#(tab)#(tab) AND j.isPrimaryJob = 1#(lf)#(tab)LEFT JOIN IntelliHR.people AS p ON p.people_id = j.person_id#(lf)#(tab)#(tab)AND p.ODSIsCurrent = 1#(lf)#(tab)),#(lf)#(tab)-- add the additional Row Level Security to the rest#(lf)row_level_security#(lf)AS (#(lf)#(tab)SELECT *#(lf)#(tab)FROM CTE#(lf)#(tab)#(lf)#(tab)UNION#(lf)#(tab)#(lf)#(tab)SELECT *#(lf)#(tab)FROM additional_access_rls#(lf)#(tab))#(lf)SELECT *#(lf)FROM row_level_security"]),
				    #"Lowercased Text" = Table.TransformColumns(
				        Source, {{"employee_email", Text.Lower, type text}, {"supervisor_email", Text.Lower, type text}}
				    ),
				    #"Current Supervisors" = Table.SelectRows(
				        #"Lowercased Text", each ([supervisor_employment_status] = "Current Staff") and ([supervisor_email] <> null)
				    ),
				    #"Removed Other Columns" = Table.SelectColumns(#"Current Supervisors", {"employee_number", "supervisor_email"}),
				    Original_ODS_Long_and_Thin = Table.Distinct(#"Removed Other Columns"),
				    //------------------------------------------------------
				    // Additional Access logic
				    //------------------------------------------------------
				    // Join AdditionalAccess to the final table on
				    //   "Person to Impersonate Email" = Original_ODS_Long_and_Thin.supervisor_email
				    // RightOuter ensures we keep all rows from Original_ODS_Long_and_Thin
				    JoinedTable = Table.Join(
				        #"Additional Access",
				        {"Person to Impersonate Email"},
				        Original_ODS_Long_and_Thin,
				        {"supervisor_email"},
				        JoinKind.RightOuter
				    ),
				    AddedConditionalColumn = Table.AddColumn(
				        JoinedTable, "supervisor_email_new", each
				            if [Requester Email] = null then
				                [supervisor_email]
				            else
				                [Requester Email]
				    ),
				    RemovedUnnecessaryColumns = Table.RemoveColumns(
				        AddedConditionalColumn, {"Requester Email", "Person to Impersonate Email", "supervisor_email"}
				    ),
				    RenamedColumns = Table.RenameColumns(RemovedUnnecessaryColumns, {{"supervisor_email_new", "supervisor_email"}}),
				    AppendedRows = Table.Combine({Original_ODS_Long_and_Thin, RenamedColumns}),
				    FinalDeduplicated = Table.Distinct(AppendedRows)
				in
				    FinalDeduplicated

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

