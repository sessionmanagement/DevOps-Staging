	column TenureDays =
			
			
			IF('intellihr jobs'[companyEndDate],
			//If they have an end Date, then use days from startDate until endDate
			    DATEDIFF('intellihr jobs'[companyStartDate], 'intellihr jobs'[companyEndDate] ,DAY),
			//If they are still here, count until today
			   DATEDIFF('intellihr jobs'[companyStartDate], TODAY(),DAY))
		formatString: 0
		lineageTag: 106ce812-e1d6-4b54-9eef-fdf047e5009f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column TenureMonths = CEILING([TenureDays]/30, 1) -1
		formatString: 0
		lineageTag: 8212cc2a-4a0c-4c34-8838-9242bfcd524b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Tenure Bins' = ```
			
			SWITCH (
			    TRUE (),
			    'intellihr jobs'[TenureMonths] < 0, " Haven't Started",
			    'intellihr jobs'[TenureMonths] < 12, " 0-1 Year",
			    'intellihr jobs'[TenureMonths] < 24, " 1-2 Years",
			    'intellihr jobs'[TenureMonths] < 36, " 2-3 Years",
			    'intellihr jobs'[TenureMonths] < 60, " 3-5 Years",
			    'intellihr jobs'[TenureMonths] < 120, " 5-10 Years",
			    'intellihr jobs'[TenureMonths] < 180, "10-15 Years",
			    'intellihr jobs'[TenureMonths] < 240, "15-20 Years",
			    'intellihr jobs'[TenureMonths] >= 240, "20+ Years"
			)
			
			```
		lineageTag: afe2054d-0b98-4899-940c-ced85da16000
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column FTE_Type = IF('intellihr jobs'[fte] > 0.99, "Full Time", "Part Time")
		lineageTag: 714aa810-d92d-4a2c-8722-35bf4ff8967f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column TenureYears = [TenureDays]/365
		formatString: 0.0
		lineageTag: 29dfc734-3a39-4326-8ca3-2cb0c75a09ee
		summarizeBy: sum

		changedProperty = FormatString

		annotation SummarizationSetBy = Automatic

