	column ActiveStatus = IF('intellihr jobs'[companyEndDate] = BLANK() || 'intellihr jobs'[companyEndDate]>TODAY(),"Active", "Not Active")
		lineageTag: 905760e0-a6d1-44c2-aca7-83154c72459f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Index
		dataType: int64
		formatString: 0
		lineageTag: e1541e35-f725-4ebf-a01b-548323a13bcd
		summarizeBy: sum
		sourceColumn: Index

		annotation SummarizationSetBy = Automatic

	column LatestJobRank = COUNTROWS(FILTER(ALL('intellihr jobs'),'intellihr jobs'[Index]<=EARLIER('intellihr jobs'[Index]) && 'intellihr jobs'[person_id]=EARLIER('intellihr jobs'[person_id])))
		formatString: 0
		lineageTag: 6ff0ac7d-6e78-47ea-a451-4612d8835222
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column NewRank =
			
			VAR R1 =
			    COUNTROWS(
			        FILTER(
			            ALL( 'intellihr jobs' ),
			            'intellihr jobs'[Index]
			                <= EARLIER( 'intellihr jobs'[Index] )
			                && 'intellihr jobs'[person_id]
			                    = EARLIER( 'intellihr jobs'[person_id] )
			                && 'intellihr jobs'[ActiveStatus] = "Not Active"
			        )
			    )
			RETURN
			    IF(
			        'intellihr jobs'[jobStatus] = "Active" && 'intellihr jobs'[ActiveStatus] = "Active",
			        0,
			        R1
			    )
		formatString: 0
		lineageTag: c2e95925-3e63-4f58-9f1a-687ed8da72bf
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

