	column DisplayAge = ```
			
			SWITCH(
			    TRUE(),
			    ISBLANK('intellihr people'[Total Years]), "Not Set",
			    TRUE(), FORMAT('intellihr people'[Total Years], "0")
			)
			
			```
		dataType: string
		lineageTag: 3162f2c6-cf77-4f96-996b-4acfd2e36273
