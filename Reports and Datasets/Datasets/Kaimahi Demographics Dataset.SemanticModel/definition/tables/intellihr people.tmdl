	column 'Age Ranges' =
			
			SWITCH (
			    /* Add in a clause for IF blank as Unknown */
			    TRUE (),
			    ISBLANK('intellihr people'[Total Years]), "Not set",
			    'intellihr people'[Total Years] >= 0 && 'intellihr people'[Total Years] < 21, " 0-20",
			    'intellihr people'[Total Years] < 31, " 21-30",
			    'intellihr people'[Total Years] < 41, " 31-40",
			    'intellihr people'[Total Years] < 51, " 41-50",
			    'intellihr people'[Total Years] < 61, " 51-60",
			    'intellihr people'[Total Years] < 71, " 61-70",
			    'intellihr people'[Total Years] >= 71, " 70+",
			    "Not set"
			)
		lineageTag: e594dd62-d5e0-4040-b3ce-c538ab48e8f3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column people_id
