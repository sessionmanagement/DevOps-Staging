	column 'Total Years'
		dataType: int64
		formatString: 0
		lineageTag: 25a488d0-95b6-4a83-ad37-282ecc047853
		summarizeBy: sum
		sourceColumn: Total Years

		annotation SummarizationSetBy = Automatic

	partition 'intellihr people-774f988c-6d84-44a4-81c8-685cf1cdf33c' = m
		mode: import
		queryGroup: 'Raw Intelli Data'
		source =
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="SELECT#(lf)    [people_id],#(lf)    [displayName],#(lf)    [dateOfBirth],#(lf)    [gender],#(lf)    [employeeNumber],#(lf)    [employmentStatus]#(lf)FROM [IntelliHR].[people]#(lf)WHERE [autoIncrementIntellihrId] <> 100412 AND ([ODSIsCurrent] = 1) AND (([employeeNumber] IS NOT NULL AND [employeeNumber] <> ''));"]),
				    #"Inserted Age" = Table.AddColumn(
				        Source,
				        "Total Years",
				        each
				            if [dateOfBirth] <> null then
				                let
				                    currentDate = DateTime.LocalNow(),
				                    birthDate = [dateOfBirth],
				                    ageYears = Date.Year(currentDate) - Date.Year(birthDate),
				                    // Adjust age if the current date has not yet reached the birthdate for the current year
				                    adjust = if Date.From(currentDate) < Date.AddYears(Date.From(birthDate), ageYears) then -1 else 0
				                in
				                    ageYears + adjust
				            else
				                // Return null if dateOfBirth is null
				                null,
				        Int64.Type
				    )
				in
				    #"Inserted Age"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

