            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Number of Housed Whānau",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This measure counts the ",
                    "textStyle": {
                      "fontSize": "8pt"
                    }
                  },
                  {
                    "value": "total number of whānau",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "8pt"
                    }
                  },
                  {
                    "value": " (families/households) we've housed across all our housing services. It combines five components:",
                    "textStyle": {
                      "fontSize": "8pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Primary Housed Whānau",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "8pt"
                    }
                  },
                  {
                    "value": " counts each unique primary person who has been accepted into our Transitional Housing services. A primary person is the main individual on the referral. This uses a distinct count of the primary person ID from our housing referrals data. ",
                    "textStyle": {
                      "fontSize": "8pt"
                    }
                  },
                  {
                    "value": "Secondary Housed Whānau",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "8pt"
                    }
                  },
                  {
                    "value": " counts each unique family member relationship linked to a primary person. For example, if a primary person has a partner and two children, this would count as three secondary relationships. The measure counts unique combinations of the primary person, linked person, relationship type, and relationship date range, filtered to only include people with a \"Secondary\" status.",
                    "textStyle": {
                      "fontSize": "8pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "EH Whānau (Emergency Housing)",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "8pt"
                    }
                  },
                  {
                    "value": ", ",
                    "textStyle": {
                      "fontSize": "8pt"
                    }
                  },
                  {
                    "value": "SH Whānau (Sustaining Tenancies)",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "8pt"
                    }
                  },
                  {
                    "value": ", and ",
                    "textStyle": {
                      "fontSize": "8pt"
                    }
                  },
                  {
                    "value": "Affordable Rental Whānau",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "8pt"
                    }
                  },
                  {
                    "value": " are manually sourced values from our Statement of Service (SOS) report. These represent whānau housed through services that aren't tracked in our main referrals database. The values are stored in a separate table and summed based on the measure name and source system. The total is calculated by adding all five components together. This gives us a complete picture of all whānau housed across our entire housing portfolio, regardless of which service or system tracks them.",
                    "textStyle": {
                      "fontSize": "8pt"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
