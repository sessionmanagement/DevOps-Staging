	column BusinessCentralIssueStatus = ```
			
			IF(
			    [datapay_status_overall] <> "OK" ||
			    [intellihr_status_overall] <> "OK" ||
			    [recordbase_status_overall] <> "OK" ||
			    [emplive_status_overall] <> "OK" ||
			    [waharoa_status_overall] <> "OK",
			    "One or more issues to resolve",
			    "No issues"
			)
			
			```
		lineageTag: 0c285168-64b2-492a-b112-64d0e7dab047
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column BusinessCentralColumnsToFix = ```
			
			VAR _DatapayStatus = IF([datapay_status_overall] <> "OK" && [datapay_status_overall] <> "N/A", business_central_exceptions[datapay_status], "")
			VAR _IntelliHRStatus = IF([intellihr_status_overall] <> "OK" && [intellihr_status_overall] <> "N/A", business_central_exceptions[intellihr_status], "")
			VAR _RecordbaseStatus = IF([recordbase_status_overall] <> "OK" && [recordbase_status_overall] <> "N/A", business_central_exceptions[recordbase_status], "")
			VAR _EmpliveStatus = IF([emplive_status_overall] <> "OK" && [emplive_status_overall] <> "N/A", business_central_exceptions[emplive_status], "")
			VAR _WaharoaStatus = IF([waharoa_status_overall] <> "OK" && [waharoa_status_overall] <> "N/A", business_central_exceptions[waharoa_status], "")
			VAR _Concatenated = 
			    _DatapayStatus & 
			    IF(_DatapayStatus <> "" && _IntelliHRStatus <> "", ", ", "") & 
			    _IntelliHRStatus & 
			    IF((_DatapayStatus <> "" || _IntelliHRStatus <> "") && _RecordbaseStatus <> "", ", ", "") & 
			    _RecordbaseStatus & 
			    IF((_DatapayStatus <> "" || _IntelliHRStatus <> "" || _RecordbaseStatus <> "") && _EmpliveStatus <> "", ", ", "") & 
			    _EmpliveStatus &
			    IF((_DatapayStatus <> "" || _IntelliHRStatus <> "" || _RecordbaseStatus <> "" || _EmpliveStatus <> "") && _WaharoaStatus <> "", ", ", "") &
			    _WaharoaStatus
			RETURN
			    IF(_Concatenated = "", "No issues", _Concatenated)
			
			```
		lineageTag: 1639452b-c964-4e76-ac2d-dde8b7cd906c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

