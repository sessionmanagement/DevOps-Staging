	column intellihr_status =
			
			//IF(ISBLANK(business_central_exceptions[business_central_code]) && ISBLANK(business_central_exceptions[intellihr_name]) && NOT(ISBLANK(business_central_exceptions[intellihr_name])),"No matching Business Central record",
