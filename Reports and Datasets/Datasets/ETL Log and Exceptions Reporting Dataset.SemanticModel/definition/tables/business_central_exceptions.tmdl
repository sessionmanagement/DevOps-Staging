		source =
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="WITH business_central_dimension_values AS (#(lf)SELECT DISTINCT#(lf)       [Company_Name] as business_central_company_name#(lf)      ,[code] AS business_central_code#(lf)      ,[name] AS business_central_name#(lf)#(tab)  ,CASE WHEN Company_Name LIKE '%Housing%' THEN 1 ELSE 0 END AS housing_flag#(lf)  FROM [BusinessCentral].[dimensionValues]#(lf)  WHERE dimensionCode = 'Service Name' #(lf)  AND ODSIsCurrent = 1#(lf)  ),#(lf)  datapay_cost_structures AS (#(lf)  SELECT DISTINCT#(lf)       [level3_code] AS datapay_code#(lf)      ,[level3_name] AS datapay_name#(lf)  FROM [DataPay].[cost_structures]#(lf)  WHERE ODSIsCurrent = 1#(lf)  ),#(lf)  intellihr_business_unit AS (#(lf)  SELECT DISTINCT#(lf)#(tab)   [code] AS intellihr_code#(lf)      ,[name] AS intellihr_name#(lf)  FROM [IntelliHR].[business_unit]#(lf)  WHERE ODSIsCurrent = 1#(lf)  ),#(lf)  recordbase_teams_codes AS (#(lf)  SELECT DISTINCT#(lf)#(tab)[teamUDF5] AS recordbase_code,#(lf)#(tab)[teamName] AS recordbase_name#(lf)#(tab)FROM [RBEAL].[dlDimTeam]#(lf)#(tab)WHERE (TeamEndDate > GETDATE() OR TeamEndDate IS NULL)#(lf)#(tab)UNION#(lf)  SELECT DISTINCT#(lf)#(tab)[teamUDF5],#(lf)#(tab)[teamName]#(lf)#(tab)FROM [RBMNB].[dlDimTeam]#(lf)#(tab)WHERE (TeamEndDate > GETDATE() OR TeamEndDate IS NULL)#(lf)#(tab)),#(lf)#(tab)emplive_services AS (#(lf)  SELECT DISTINCT#(lf)#(tab)[cost_code] AS emplive_code,#(lf)#(tab)[name] AS emplive_name#(lf)#(tab)FROM [EmpLive].[services]#(lf)#(tab)WHERE ODSIsCurrent = 1#(lf)#(tab))#(lf)#(lf)SELECT DISTINCT#(lf)#(tab)ISNULL(business_central_company_name,'**N/A**') AS business_central_company_name,#(lf)    ISNULL(business_central_name,'**N/A**') AS business_central_name,#(lf)#(tab)housing_flag,#(lf)    datapay_name,#(lf)    intellihr_name,#(lf)#(tab)recordbase_name,#(lf)#(tab)emplive_name,#(lf)    business_central_code,#(lf)    datapay_code,#(lf)    intellihr_code,#(lf)#(tab)recordbase_code,#(lf)#(tab)emplive_code#(lf)FROM#(lf)    business_central_dimension_values#(lf)FULL OUTER JOIN#(lf)    datapay_cost_structures ON business_central_dimension_values.business_central_code = datapay_cost_structures.datapay_code#(lf)FULL OUTER JOIN#(lf)    intellihr_business_unit ON business_central_dimension_values.business_central_code = intellihr_business_unit.intellihr_code#(lf)FULL OUTER JOIN#(lf)#(tab)recordbase_teams_codes ON business_central_dimension_values.business_central_code = recordbase_teams_codes.recordbase_code#(lf)FULL OUTER JOIN#(lf)#(tab)emplive_services ON business_central_dimension_values.business_central_code = emplive_services.emplive_code"]),
