	column datapay_status =
			
			//IF(ISBLANK(business_central_exceptions[business_central_code]) && ISBLANK(business_central_exceptions[datapay_name]) && NOT(ISBLANK(business_central_exceptions[datapay_name])),"No matching Business Central record",
			IF(ISBLANK(business_central_exceptions[business_central_code]) && ISBLANK(business_central_exceptions[datapay_code]),"N/A",
			IF(ISBLANK(business_central_exceptions[business_central_code]),"No matching Business Central record",
			IF(
			    NOT(ISBLANK(business_central_exceptions[business_central_code])) && ISBLANK(business_central_exceptions[datapay_code]),
			    "No match in Datapay for Business Central record",
			    IF(business_central_exceptions[business_central_name] <> business_central_exceptions[datapay_name], "Name in Datapay does not match Business Central",
			    "OK"
			    )
			)))
