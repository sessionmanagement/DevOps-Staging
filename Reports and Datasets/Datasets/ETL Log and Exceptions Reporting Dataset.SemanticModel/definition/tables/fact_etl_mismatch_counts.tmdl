	partition fact_etl_mismatch_counts = m
		mode: import
		queryGroup: Facts
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-manager", [Query="WITH rowNumberedMismatches#(lf)AS (#(lf)#(tab)SELECT mismatches_id#(lf)#(tab)#(tab),mm.table_name#(lf)#(tab)#(tab),mm.column_name#(lf)#(tab)#(tab),ROW_NUMBER() OVER (#(lf)#(tab)#(tab)#(tab)PARTITION BY schema_name#(lf)#(tab)#(tab)#(tab),mm.table_name#(lf)#(tab)#(tab)#(tab),mm.column_name#(lf)#(tab)#(tab)#(tab),CONVERT(CHAR(10), mismatches_date, 103) ORDER BY mismatches_date DESC#(lf)#(tab)#(tab)#(tab)) AS RN#(lf)#(tab)#(tab),CONVERT(CHAR(10), mismatches_date, 103) AS mismatches_date#(lf)#(tab)#(tab),mismatches_count#(lf)#(tab)#(tab),LAG(mismatches_count) OVER (#(lf)#(tab)#(tab)#(tab)PARTITION BY mm.table_name#(lf)#(tab)#(tab)#(tab),mm.column_name ORDER BY mismatches_date#(lf)#(tab)#(tab)#(tab)) AS yesterdays_mismatches#(lf)#(tab)#(tab),COALESCE(r.mismatch_reason, '') AS mismatch_reason#(lf)#(tab)#(tab),COALESCE(r.mismatch_business_data, '') AS examples#(lf)#(tab)FROM meta_data.mismatches mm#(lf)#(tab)LEFT JOIN meta_data.mismatch_reason r ON r.table_name = mm.table_name#(lf)#(tab)#(tab)AND r.column_name = mm.column_name#(lf)#(tab))#(lf)SELECT mismatches_id#(lf)#(tab),mismatches_date#(lf)#(tab),table_name#(lf)#(tab),column_name#(lf)#(tab),mismatches_count#(lf)#(tab),yesterdays_mismatches#(lf)#(tab),mismatch_reason#(lf)#(tab),examples#(lf)FROM rowNumberedMismatches#(lf)WHERE RN = 1#(lf)ORDER BY 4 DESC"]),
