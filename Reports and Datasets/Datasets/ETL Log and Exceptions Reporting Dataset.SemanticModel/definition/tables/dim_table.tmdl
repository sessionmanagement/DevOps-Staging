table dim_table
	lineageTag: 7f20840a-b08b-44c6-ab48-78c6f2afdaa3

	column table_key
		dataType: int64
		formatString: 0
		lineageTag: 4a3d7d1d-fb45-49d0-a722-ebf11d1716e1
		summarizeBy: none
		sourceColumn: table_key

		changedProperty = IsHidden

