	partition edw_unknown_keys = m
		mode: import
		queryGroup: EDW
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="SET NOCOUNT ON;#(lf)DECLARE @TableName NVARCHAR(255);#(lf)DECLARE @ColumnName NVARCHAR(255);#(lf)DECLARE @SQL NVARCHAR(MAX);#(lf)DECLARE @SchemaName NVARCHAR(255);#(lf)DECLARE @ErrorMessage NVARCHAR(4000);#(lf)#(lf)BEGIN TRY#(lf)    -- Create temporary table to store results#(lf)    CREATE TABLE #Results (#(lf)        SchemaName NVARCHAR(255),#(lf)        TableName NVARCHAR(255),#(lf)        ColumnName NVARCHAR(255),#(lf)        KeyCount INT,#(lf)        TotalRows BIGINT,#(lf)        TableType NVARCHAR(10)#(lf)    );#(lf)#(lf)    -- Cursor to iterate through tables and columns#(lf)    DECLARE TableCursor CURSOR FOR#(lf)    SELECT s.name AS SchemaName,#(lf)        t.name AS TableName,#(lf)        c.name AS ColumnName#(lf)    FROM sys.tables t#(lf)    INNER JOIN sys.schemas s ON t.schema_id = s.schema_id#(lf)    INNER JOIN sys.columns c ON t.object_id = c.object_id#(lf)    INNER JOIN sys.types ty ON c.user_type_id = ty.user_type_id#(lf)    WHERE c.name LIKE '%_key'#(lf)        AND ty.name IN ('int', 'bigint', 'smallint', 'tinyint')#(lf)        AND s.name = 'edw';#(lf)#(lf)    OPEN TableCursor;#(lf)    FETCH NEXT FROM TableCursor INTO @SchemaName, @TableName, @ColumnName;#(lf)#(lf)    WHILE @@FETCH_STATUS = 0#(lf)    BEGIN#(lf)        SET @SQL = N'#(lf)            INSERT INTO #Results (SchemaName, TableName, ColumnName, KeyCount, TotalRows, TableType)#(lf)            SELECT #(lf)                @SchemaName, #(lf)                @TableName, #(lf)                @ColumnName, #(lf)                SUM(CASE WHEN ' + QUOTENAME(@ColumnName) + ' = -1 THEN 1 ELSE 0 END),#(lf)                COUNT_BIG(*),#(lf)                CASE #(lf)                    WHEN LEFT(@TableName, 3) = ''dim'' THEN ''Dimension''#(lf)                    WHEN LEFT(@TableName, 4) = ''fact'' THEN ''Fact''#(lf)                    ELSE ''Other''#(lf)                END#(lf)            FROM ' + QUOTENAME(@SchemaName) + '.' + QUOTENAME(@TableName);#(lf)#(lf)        EXEC sp_executesql @SQL, #(lf)            N'@SchemaName NVARCHAR(255), @TableName NVARCHAR(255), @ColumnName NVARCHAR(255)', #(lf)            @SchemaName, @TableName, @ColumnName;#(lf)#(lf)        FETCH NEXT FROM TableCursor INTO @SchemaName, @TableName, @ColumnName;#(lf)    END#(lf)#(lf)    CLOSE TableCursor;#(lf)    DEALLOCATE TableCursor;#(lf)#(lf)    -- Display all results with survey date and table type#(lf)    SELECT #(lf)        SchemaName,#(lf)        TableName,#(lf)        ColumnName,#(lf)        KeyCount,#(lf)        TotalRows,#(lf)        TableType,#(lf)        CONVERT(datetime, SWITCHOFFSET(CONVERT(datetimeoffset, GETDATE()), DATEPART(TZOFFSET,GETDATE() AT TIME ZONE 'New Zealand Standard Time'))) AS Survey_Date#(lf)    FROM #Results#(lf)    ORDER BY SchemaName, TableName, ColumnName;#(lf)#(lf)END TRY#(lf)BEGIN CATCH#(lf)    SELECT @ErrorMessage = ERROR_MESSAGE();#(lf)    RAISERROR (@ErrorMessage, 16, 1);#(lf)END CATCH#(lf)#(lf)-- Clean up#(lf)IF OBJECT_ID('tempdb..#Results') IS NOT NULL#(lf)    DROP TABLE #Results;"]),
				    #"Added Custom" = Table.AddColumn(Source, "PercentageUnknown", each [KeyCount] / [TotalRows]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Added Custom",{{"PercentageUnknown", Percentage.Type}}),
				    #"Added Custom1" = Table.AddColumn(#"Changed Type", "dim_percentage_key", each if [PercentageUnknown] > 0 then Number.RoundUp([PercentageUnknown] * 100, 5) else 0),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Added Custom1",{{"dim_percentage_key", Int64.Type}}),
				    #"Replaced Errors" = Table.ReplaceErrorValues(#"Changed Type1", {{"dim_percentage_key", 0}})
				in
				    #"Replaced Errors"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

