	partition fact_index_rebuild_log_detail = m
		mode: import
		queryGroup: Facts
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-fk-01.database.windows.net", "Framework", [Query="SELECT#(lf)BatchID, #(lf)CONVERT(datetime, SWITCHOFFSET(CONVERT(datetimeoffset, BatchStartDate), DATEPART(TZOFFSET,BatchStartDate AT TIME ZONE 'New Zealand Standard Time'))) AS BatchStartDate,#(lf)CONVERT(datetime, SWITCHOFFSET(CONVERT(datetimeoffset, BatchEndDate), DATEPART(TZOFFSET,BatchEndDate AT TIME ZONE 'New Zealand Standard Time'))) AS BatchEndDate,#(lf)DATEDIFF(SECOND, BatchStartDate, BatchEndDate) AS BatchDurationSeconds,#(lf)ProcessName,#(lf)DFtriggerType,#(lf)DFTriggerName,#(lf)LogIndexRebuildID,#(lf)SchemaName,#(lf)TableName,#(lf)IndexName,#(lf)CONVERT(datetime, SWITCHOFFSET(CONVERT(datetimeoffset, IndexRebuildStartDate), DATEPART(TZOFFSET,IndexRebuildStartDate AT TIME ZONE 'New Zealand Standard Time'))) AS IndexRebuildStartDate,#(lf)CONVERT(datetime, SWITCHOFFSET(CONVERT(datetimeoffset, IndexRebuildFinishDate), DATEPART(TZOFFSET,IndexRebuildFinishDate AT TIME ZONE 'New Zealand Standard Time'))) AS IndexRebuildFinishDate,#(lf)DATEDIFF(SECOND, IndexRebuildStartDate, IndexRebuildFinishDate) AS IndexRebuildDurationSeconds,#(lf)StartFragmentation,#(lf)EndFragmentation,#(lf)StartPageCount,#(lf)EndPageCount,#(lf)CONVERT(datetime, SWITCHOFFSET(CONVERT(datetimeoffset, RecordLogDateTime), DATEPART(TZOFFSET,RecordLogDateTime AT TIME ZONE 'New Zealand Standard Time'))) AS RecordLogDateTime,#(lf)AdditionalDetails#(lf)FROM [ETL].[IndexRebuildLogDetail]"]),
				    #"Duplicated Column" = Table.DuplicateColumn(Source, "BatchStartDate", "BatchStartDate - Copy"),
				    #"Duplicated Column1" = Table.DuplicateColumn(#"Duplicated Column", "BatchEndDate", "BatchEndDate - Copy"),
				    #"Duplicated Column2" = Table.DuplicateColumn(#"Duplicated Column1", "IndexRebuildStartDate", "IndexRebuildStartDate - Copy"),
				    #"Duplicated Column3" = Table.DuplicateColumn(#"Duplicated Column2", "IndexRebuildFinishDate", "IndexRebuildFinishDate - Copy"),
				    #"Duplicated Column4" = Table.DuplicateColumn(#"Duplicated Column3", "RecordLogDateTime", "RecordLogDateTime - Copy"),
				    #"Changed Type" = Table.TransformColumnTypes(#"Duplicated Column4",{{"BatchStartDate - Copy", type date}, {"BatchEndDate - Copy", type date}, {"IndexRebuildStartDate - Copy", type date}, {"IndexRebuildFinishDate - Copy", type date}, {"RecordLogDateTime - Copy", type date}}),
				    #"Renamed Columns" = Table.RenameColumns(#"Changed Type",{{"BatchStartDate - Copy", "BatchStartDateAsDate"}, {"BatchEndDate - Copy", "BatchEndDateAsDate"}, {"IndexRebuildStartDate - Copy", "IndexRebuildStartDateAsDate"}, {"IndexRebuildFinishDate - Copy", "IndexRebuildFinishDateAsDate"}, {"RecordLogDateTime - Copy", "RecordLogDateTimeAsDate"}})
				in
				    #"Renamed Columns"

