	column FragmentationReductionPercentage =
			
			VAR StartFragmentation = fact_index_rebuild_log_detail[StartFragmentation]
			VAR EndFragmentation = fact_index_rebuild_log_detail[EndFragmentation]
			RETURN
			IF(
			    NOT ISBLANK(StartFragmentation) && StartFragmentation <> 0,
			    (StartFragmentation - EndFragmentation) / StartFragmentation,
			    BLANK()
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 954808c3-08ba-4999-9525-39e741e6bf68
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column SchemaAndTable =
			
			IF(
			    AND(
			        NOT(ISBLANK(fact_index_rebuild_log_detail[SchemaName])),
			        NOT(ISBLANK(fact_index_rebuild_log_detail[TableName]))
			    ),
			    fact_index_rebuild_log_detail[SchemaName] & "." & fact_index_rebuild_log_detail[TableName],
			    BLANK()
			)
		lineageTag: 0ce1b7ff-ff9d-498e-9c3b-d5c8a9a33dd4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

