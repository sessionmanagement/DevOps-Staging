	measure '(Exceptions) Applied Filters' = ```
			
			VAR __Company = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(dim_employee_hierarchy[employee_company_name]), NOT(ISBLANK(dim_employee_hierarchy[employee_company_name]))), dim_employee_hierarchy[employee_company_name], ASC),
			    "Company_display", dim_employee_hierarchy[employee_company_name]
			)
			VAR __CompanyCount = IF(ISFILTERED(dim_employee_hierarchy[employee_company_name]), COUNTROWS(VALUES(dim_employee_hierarchy[employee_company_name])), 0)
			VAR __MoreCompany = IF(__CompanyCount > 10, " and " & (__CompanyCount - 10) & " more", "")
			
			VAR __BusinessUnitLevel_1 = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_1]), NOT(ISBLANK(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_1]))), dim_employee_hierarchy[employee_people_leader_business_unit_name_level_1], ASC),
			    "BusinessUnitLevel_1_display", dim_employee_hierarchy[employee_people_leader_business_unit_name_level_1]
			)
			VAR __BusinessUnitLevel_1Count = IF(ISFILTERED(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_1]), COUNTROWS(VALUES(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_1])), 0)
			VAR __MoreBusinessUnitLevel_1 = IF(__BusinessUnitLevel_1Count > 10, " and " & (__BusinessUnitLevel_1Count - 10) & " more", "")
			
			VAR __BusinessUnitLevel_2 = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_2]), NOT(ISBLANK(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_2]))), dim_employee_hierarchy[employee_people_leader_business_unit_name_level_2], ASC),
			    "BusinessUnitLevel_2_display", dim_employee_hierarchy[employee_people_leader_business_unit_name_level_2]
			)
			VAR __BusinessUnitLevel_2Count = IF(ISFILTERED(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_2]), COUNTROWS(VALUES(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_2])), 0)
			VAR __MoreBusinessUnitLevel_2 = IF(__BusinessUnitLevel_2Count > 10, " and " & (__BusinessUnitLevel_2Count - 10) & " more", "")
			
			VAR __BusinessUnitLevel_3 = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_3]), NOT(ISBLANK(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_3]))), dim_employee_hierarchy[employee_people_leader_business_unit_name_level_3], ASC),
			    "BusinessUnitLevel_3_display", dim_employee_hierarchy[employee_people_leader_business_unit_name_level_3]
			)
			VAR __BusinessUnitLevel_3Count = IF(ISFILTERED(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_3]), COUNTROWS(VALUES(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_3])), 0)
			VAR __MoreBusinessUnitLevel_3 = IF(__BusinessUnitLevel_3Count > 10, " and " & (__BusinessUnitLevel_3Count - 10) & " more", "")
			
			VAR __BusinessUnitLevel_4 = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_4]), NOT(ISBLANK(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_4]))), dim_employee_hierarchy[employee_people_leader_business_unit_name_level_4], ASC),
			    "BusinessUnitLevel_4_display", dim_employee_hierarchy[employee_people_leader_business_unit_name_level_4]
			)
			VAR __BusinessUnitLevel_4Count = IF(ISFILTERED(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_4]), COUNTROWS(VALUES(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_4])), 0)
			VAR __MoreBusinessUnitLevel_4 = IF(__BusinessUnitLevel_4Count > 10, " and " & (__BusinessUnitLevel_4Count - 10) & " more", "")
			
			VAR __BusinessUnitLevel_5 = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_5]), NOT(ISBLANK(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_5]))), dim_employee_hierarchy[employee_people_leader_business_unit_name_level_5], ASC),
			    "BusinessUnitLevel_5_display", dim_employee_hierarchy[employee_people_leader_business_unit_name_level_5]
			)
			VAR __BusinessUnitLevel_5Count = IF(ISFILTERED(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_5]), COUNTROWS(VALUES(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_5])), 0)
			VAR __MoreBusinessUnitLevel_5 = IF(__BusinessUnitLevel_5Count > 10, " and " & (__BusinessUnitLevel_5Count - 10) & " more", "")
			
			VAR __BusinessUnitLevel_6 = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_6]), NOT(ISBLANK(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_6]))), dim_employee_hierarchy[employee_people_leader_business_unit_name_level_6], ASC),
			    "BusinessUnitLevel_6_display", dim_employee_hierarchy[employee_people_leader_business_unit_name_level_6]
			)
			VAR __BusinessUnitLevel_6Count = IF(ISFILTERED(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_6]), COUNTROWS(VALUES(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_6])), 0)
			VAR __MoreBusinessUnitLevel_6 = IF(__BusinessUnitLevel_6Count > 10, " and " & (__BusinessUnitLevel_6Count - 10) & " more", "")
			
			VAR __BusinessUnitLevel_7 = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_7]), NOT(ISBLANK(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_7]))), dim_employee_hierarchy[employee_people_leader_business_unit_name_level_7], ASC),
			    "BusinessUnitLevel_7_display", dim_employee_hierarchy[employee_people_leader_business_unit_name_level_7]
			)
			VAR __BusinessUnitLevel_7Count = IF(ISFILTERED(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_7]), COUNTROWS(VALUES(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_7])), 0)
			VAR __MoreBusinessUnitLevel_7 = IF(__BusinessUnitLevel_7Count > 10, " and " & (__BusinessUnitLevel_7Count - 10) & " more", "")
			
			VAR __BusinessUnitLevel_8 = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_8]), NOT(ISBLANK(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_8]))), dim_employee_hierarchy[employee_people_leader_business_unit_name_level_8], ASC),
			    "BusinessUnitLevel_8_display", dim_employee_hierarchy[employee_people_leader_business_unit_name_level_8]
			)
			VAR __BusinessUnitLevel_8Count = IF(ISFILTERED(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_8]), COUNTROWS(VALUES(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_8])), 0)
			VAR __MoreBusinessUnitLevel_8 = IF(__BusinessUnitLevel_8Count > 10, " and " & (__BusinessUnitLevel_8Count - 10) & " more", "")
			
			VAR __BusinessUnitLevel_9 = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_9]), NOT(ISBLANK(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_9]))), dim_employee_hierarchy[employee_people_leader_business_unit_name_level_9], ASC),
			    "BusinessUnitLevel_9_display", dim_employee_hierarchy[employee_people_leader_business_unit_name_level_9]
			)
			VAR __BusinessUnitLevel_9Count = IF(ISFILTERED(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_9]), COUNTROWS(VALUES(dim_employee_hierarchy[employee_people_leader_business_unit_name_level_9])), 0)
			VAR __MoreBusinessUnitLevel_9 = IF(__BusinessUnitLevel_9Count > 10, " and " & (__BusinessUnitLevel_9Count - 10) & " more", "")
			
			VAR __Issue = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(personaverse_exceptions_data[PersonaverseIssueStatus]), NOT(ISBLANK(personaverse_exceptions_data[PersonaverseIssueStatus]))), personaverse_exceptions_data[PersonaverseIssueStatus], ASC),
			    "Issue_display", personaverse_exceptions_data[PersonaverseIssueStatus]
			)
			VAR __IssueCount = IF(ISFILTERED(personaverse_exceptions_data[PersonaverseIssueStatus]), COUNTROWS(VALUES(personaverse_exceptions_data[PersonaverseIssueStatus])), 0)
			VAR __MoreIssue = IF(__IssueCount > 10, " and " & (__IssueCount - 10) & " more", "")
			
			VAR __PersonaverseStatus = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(personaverse_exceptions_data[PersonaverseStatusCalc]), NOT(ISBLANK(personaverse_exceptions_data[PersonaverseStatusCalc]))), personaverse_exceptions_data[PersonaverseStatusCalc], ASC),
			    "PersonaverseStatus_display", personaverse_exceptions_data[PersonaverseStatusCalc]
			)
			VAR __PersonaverseStatusCount = IF(ISFILTERED(personaverse_exceptions_data[PersonaverseStatusCalc]), COUNTROWS(VALUES(personaverse_exceptions_data[PersonaverseStatusCalc])), 0)
			VAR __MorePersonaverseStatus = IF(__PersonaverseStatusCount > 10, " and " & (__PersonaverseStatusCount - 10) & " more", "")
			
			VAR __Companies = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(dim_employee_hierarchy[employee_company_name]), NOT(ISBLANK(dim_employee_hierarchy[employee_company_name]))), dim_employee_hierarchy[employee_company_name], ASC),
			    "Company_display", dim_employee_hierarchy[employee_company_name]
			)
			VAR __CompaniesCount = IF(ISFILTERED(dim_employee_hierarchy[employee_company_name]), COUNTROWS(VALUES(dim_employee_hierarchy[employee_company_name])), 0)
			VAR __MoreCompanies = IF(__CompaniesCount > 10, " and " & (__CompaniesCount - 10) & " more", "")
			VAR _FC_Company = IF(__CompaniesCount > 0, "COMPANY: " & CONCATENATEX(__Companies, [Company_display], ", "), BLANK()) & __MoreCompanies
			
			VAR _FC_BusinessUnitLevel_1 = IF(__BusinessUnitLevel_1Count > 0, "BUSINESS UNIT LEVEL 1: " & CONCATENATEX(__BusinessUnitLevel_1, [BusinessUnitLevel_1_display], ", "), BLANK()) & __MoreBusinessUnitLevel_1
			VAR _FC_BusinessUnitLevel_2 = IF(__BusinessUnitLevel_2Count > 0, "BUSINESS UNIT LEVEL 2: " & CONCATENATEX(__BusinessUnitLevel_2, [BusinessUnitLevel_2_display], ", "), BLANK()) & __MoreBusinessUnitLevel_2
			VAR _FC_BusinessUnitLevel_3 = IF(__BusinessUnitLevel_3Count > 0, "BUSINESS UNIT LEVEL 3: " & CONCATENATEX(__BusinessUnitLevel_3, [BusinessUnitLevel_3_display], ", "), BLANK()) & __MoreBusinessUnitLevel_3
			VAR _FC_BusinessUnitLevel_4 = IF(__BusinessUnitLevel_4Count > 0, "BUSINESS UNIT LEVEL 4: " & CONCATENATEX(__BusinessUnitLevel_4, [BusinessUnitLevel_4_display], ", "), BLANK()) & __MoreBusinessUnitLevel_4
			VAR _FC_BusinessUnitLevel_5 = IF(__BusinessUnitLevel_5Count > 0, "BUSINESS UNIT LEVEL 5: " & CONCATENATEX(__BusinessUnitLevel_5, [BusinessUnitLevel_5_display], ", "), BLANK()) & __MoreBusinessUnitLevel_5
			VAR _FC_BusinessUnitLevel_6 = IF(__BusinessUnitLevel_6Count > 0, "BUSINESS UNIT LEVEL 6: " & CONCATENATEX(__BusinessUnitLevel_6, [BusinessUnitLevel_6_display], ", "), BLANK()) & __MoreBusinessUnitLevel_6
			VAR _FC_BusinessUnitLevel_7 = IF(__BusinessUnitLevel_7Count > 0, "BUSINESS UNIT LEVEL 7: " & CONCATENATEX(__BusinessUnitLevel_7, [BusinessUnitLevel_7_display], ", "), BLANK()) & __MoreBusinessUnitLevel_7
			VAR _FC_BusinessUnitLevel_8 = IF(__BusinessUnitLevel_8Count > 0, "BUSINESS UNIT LEVEL 8: " & CONCATENATEX(__BusinessUnitLevel_8, [BusinessUnitLevel_8_display], ", "), BLANK()) & __MoreBusinessUnitLevel_8
			VAR _FC_BusinessUnitLevel_9 = IF(__BusinessUnitLevel_9Count > 0, "BUSINESS UNIT LEVEL 9: " & CONCATENATEX(__BusinessUnitLevel_9, [BusinessUnitLevel_9_display], ", "), BLANK()) & __MoreBusinessUnitLevel_9
			VAR _FC_Issue = IF(__IssueCount > 0, "ISSUE STATUS: " & CONCATENATEX(__Issue, [Issue_display], ", "), BLANK()) & __MoreIssue
			VAR _FC_PersonaverseStatus = IF(__PersonaverseStatusCount > 0, "PERSONAVERSE STATUS: " & CONCATENATEX(__PersonaverseStatus, [PersonaverseStatus_display], ", "), BLANK()) & __MorePersonaverseStatus
			
			RETURN
			IF(
			    (ISBLANK(_FC_Company) || _FC_Company = "") &&
			    (ISBLANK(_FC_BusinessUnitLevel_1) || _FC_BusinessUnitLevel_1 = "") &&
			    (ISBLANK(_FC_BusinessUnitLevel_2) || _FC_BusinessUnitLevel_2 = "") &&
			    (ISBLANK(_FC_BusinessUnitLevel_3) || _FC_BusinessUnitLevel_3 = "") &&
			    (ISBLANK(_FC_BusinessUnitLevel_4) || _FC_BusinessUnitLevel_4 = "") &&
			    (ISBLANK(_FC_BusinessUnitLevel_5) || _FC_BusinessUnitLevel_5 = "") &&
			    (ISBLANK(_FC_BusinessUnitLevel_6) || _FC_BusinessUnitLevel_6 = "") &&
			    (ISBLANK(_FC_BusinessUnitLevel_7) || _FC_BusinessUnitLevel_7 = "") &&
			    (ISBLANK(_FC_BusinessUnitLevel_8) || _FC_BusinessUnitLevel_8 = "") &&
			    (ISBLANK(_FC_BusinessUnitLevel_9) || _FC_BusinessUnitLevel_9 = "") &&
			    (ISBLANK(_FC_Issue) || _FC_Issue = "") &&
			    (ISBLANK(_FC_PersonaverseStatus) || _FC_PersonaverseStatus = "")
			    ,"No filters are currently applied to this page.",
			    "Please note that the following filters are applied to this page: " & 
			    _FC_Issue & " " & 
			    _FC_PersonaverseStatus & " " & 
			    _FC_Company & " " & 
			    _FC_BusinessUnitLevel_1 & " " & 
			    _FC_BusinessUnitLevel_2 & " " & 
			    _FC_BusinessUnitLevel_3 & " " & 
			    _FC_BusinessUnitLevel_4 & " " & 
			    _FC_BusinessUnitLevel_5 & " " & 
			    _FC_BusinessUnitLevel_6 & " " & 
			    _FC_BusinessUnitLevel_7 & " " & 
			    _FC_BusinessUnitLevel_8 & " " & 
			    _FC_BusinessUnitLevel_9
			)
			```
		lineageTag: aca272c9-5308-49b9-a41e-d41fcaeb4e61

	measure '(ETL) - Applied Filters - Source and Table with Date Range' =
			
			VAR _MinDate = FORMAT(MIN(dim_date[calendar_date]), "dd/mm/yyyy")
			VAR _MaxDate = FORMAT(MAX(dim_date[calendar_date]), "dd/mm/yyyy")
			VAR _DateRangeDisplay = CONCATENATE("Selected date range: " & _MinDate & " - ", _MaxDate & ". ")
			RETURN
			CONCATENATE(
			    _DateRangeDisplay,
			    [(ETL) Applied Filters - Source and Table Only]
			)
		lineageTag: cc583291-09ef-44fd-9c3f-ae8049757424

