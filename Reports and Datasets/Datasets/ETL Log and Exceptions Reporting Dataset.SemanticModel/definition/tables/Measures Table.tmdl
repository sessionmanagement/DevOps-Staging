	measure 'Number of Tables Updated (28-day Avg)' =
			
			AVERAGEX(
			    FILTER(
			        ALL(dim_date),
			        dim_date[date_offset] >= -29 &&
			        dim_date[date_offset] <= -1
			    ),
			    CALCULATE(
			        DISTINCTCOUNT(fact_etl_log_overview_unpivot[table_key])
			    )
			)
		displayFolder: fact_etl_log_overview_unpivot
		lineageTag: b19366fc-09e0-4e61-9247-48370ba8ddc9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Duration in Mins (28-day Avg)' =
			
			AVERAGEX(
			    FILTER(
			        ALL(dim_date),
			        dim_date[calendar_date] >= MAX(dim_date[calendar_date]) - 29 &&
			        dim_date[calendar_date] <= MAX(dim_date[calendar_date]) - 1
			    ),
			    CALCULATE(
			        [Total Duration Minutes]
			    )
			)
		displayFolder: fact_etl_log_overview_simple
		lineageTag: e719bcf9-4e46-47b4-87cf-6c5c788375a8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Duration Minutes (For Display)' =
			
			VAR TotalSeconds = CALCULATE(SUM(fact_etl_log_overview_simple[DurationSeconds]))
			VAR Minutes = TRUNC(TotalSeconds / 60)
			VAR Seconds = MOD(TotalSeconds, 60)
			RETURN
			    IF(
			        ISBLANK(
			            TotalSeconds),
			            BLANK(),
			            FORMAT(Minutes, "00") & ":" & FORMAT(Seconds, "00")
			    )
		displayFolder: fact_etl_log_overview_simple
		lineageTag: 50d9aad0-a728-4d1c-9fe1-2d549333a6d7

