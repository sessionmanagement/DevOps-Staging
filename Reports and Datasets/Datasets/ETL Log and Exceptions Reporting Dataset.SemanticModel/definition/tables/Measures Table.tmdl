	measure '(ETL) Applied Filters' = ```
			
			VAR dim_action_action_type = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES('dim_action'[action_type]), NOT(ISBLANK('dim_action'[action_type]))), 'dim_action'[action_type], ASC),
			    "action_type_display", 'dim_action'[action_type]
			)
			VAR dim_action_action_typeCount = IF(ISFILTERED('dim_action'[action_type]), COUNTROWS(VALUES('dim_action'[action_type])), 0)
			VAR More_dim_action_action_type = IF(dim_action_action_typeCount > 5, " and " & (dim_action_action_typeCount - 5) & " more", "")
			VAR FC_dim_action_action_type = IF(dim_action_action_typeCount > 0, "ACTION TYPES CHOSEN: " & CONCATENATEX(dim_action_action_type, [action_type_display], ", "), BLANK()) & More_dim_action_action_type
			
			VAR dim_table_SourceSystem = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES('dim_table'[SourceSystem]), NOT(ISBLANK('dim_table'[SourceSystem]))), 'dim_table'[SourceSystem], ASC),
			    "SourceSystem_display", 'dim_table'[SourceSystem]
			)
			VAR dim_table_SourceSystemCount = IF(ISFILTERED('dim_table'[SourceSystem]), COUNTROWS(VALUES('dim_table'[SourceSystem])), 0)
			VAR More_dim_table_SourceSystem = IF(dim_table_SourceSystemCount > 5, " and " & (dim_table_SourceSystemCount - 5) & " more", "")
			VAR FC_dim_table_SourceSystem = IF(dim_table_SourceSystemCount > 0, "SOURCE SYSTEMS CHOSEN: " & CONCATENATEX(dim_table_SourceSystem, [SourceSystem_display], ", "), BLANK()) & More_dim_table_SourceSystem
			
			VAR dim_table_TableName = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES('dim_table'[TableName]), NOT(ISBLANK('dim_table'[TableName]))), 'dim_table'[TableName], ASC),
			    "TableName_display", 'dim_table'[TableName]
			)
			VAR dim_table_TableNameCount = IF(ISFILTERED('dim_table'[TableName]), COUNTROWS(VALUES('dim_table'[TableName])), 0)
			VAR More_dim_table_TableName = IF(dim_table_TableNameCount > 5, " and " & (dim_table_TableNameCount - 5) & " more", "")
			VAR FC_dim_table_TableName = IF(dim_table_TableNameCount > 0, "TABLES CHOSEN: " & CONCATENATEX(dim_table_TableName, [TableName_display], ", "), BLANK()) & More_dim_table_TableName
			
			VAR fact_index_rebuild_log_detail_SchemaAndTable = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES('fact_index_rebuild_log_detail'[SchemaAndTable]), NOT(ISBLANK('fact_index_rebuild_log_detail'[SchemaAndTable]))), 'fact_index_rebuild_log_detail'[SchemaAndTable], ASC),
			    "SchemaAndTable_display", 'fact_index_rebuild_log_detail'[SchemaAndTable]
			)
			VAR fact_index_rebuild_log_detail_SchemaAndTableCount = IF(ISFILTERED('fact_index_rebuild_log_detail'[SchemaAndTable]), COUNTROWS(VALUES('fact_index_rebuild_log_detail'[SchemaAndTable])), 0)
			VAR More_fact_index_rebuild_log_detail_SchemaAndTable = IF(fact_index_rebuild_log_detail_SchemaAndTableCount > 5, " and " & (fact_index_rebuild_log_detail_SchemaAndTableCount - 5) & " more", "")
			VAR FC_fact_index_rebuild_log_detail_SchemaAndTable = IF(fact_index_rebuild_log_detail_SchemaAndTableCount > 0, "SCHEMA AND TABLES CHOSEN: " & CONCATENATEX(fact_index_rebuild_log_detail_SchemaAndTable, [SchemaAndTable_display], ", "), BLANK()) & More_fact_index_rebuild_log_detail_SchemaAndTable
			
			VAR fact_index_rebuild_log_detail_IndexName = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES('fact_index_rebuild_log_detail'[IndexName]), NOT(ISBLANK('fact_index_rebuild_log_detail'[IndexName]))), 'fact_index_rebuild_log_detail'[IndexName], ASC),
			    "IndexName_display", 'fact_index_rebuild_log_detail'[IndexName]
			)
			VAR fact_index_rebuild_log_detail_IndexNameCount = IF(ISFILTERED('fact_index_rebuild_log_detail'[IndexName]), COUNTROWS(VALUES('fact_index_rebuild_log_detail'[IndexName])), 0)
			VAR More_fact_index_rebuild_log_detail_IndexName = IF(fact_index_rebuild_log_detail_IndexNameCount > 5, " and " & (fact_index_rebuild_log_detail_IndexNameCount - 5) & " more", "")
			VAR FC_fact_index_rebuild_log_detail_IndexName = IF(fact_index_rebuild_log_detail_IndexNameCount > 0, "INDEXES CHOSEN: " & CONCATENATEX(fact_index_rebuild_log_detail_IndexName, [IndexName_display], ", "), BLANK()) & More_fact_index_rebuild_log_detail_IndexName
			
			VAR fact_index_rebuild_log_detail_BatchID = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES('fact_index_rebuild_log_detail'[BatchID]), NOT(ISBLANK('fact_index_rebuild_log_detail'[BatchID]))), 'fact_index_rebuild_log_detail'[BatchID], ASC),
			    "BatchID_display", 'fact_index_rebuild_log_detail'[BatchID]
			)
			VAR fact_index_rebuild_log_detail_BatchIDCount = IF(ISFILTERED('fact_index_rebuild_log_detail'[BatchID]), COUNTROWS(VALUES('fact_index_rebuild_log_detail'[BatchID])), 0)
			VAR More_fact_index_rebuild_log_detail_BatchID = IF(fact_index_rebuild_log_detail_BatchIDCount > 5, " and " & (fact_index_rebuild_log_detail_BatchIDCount - 5) & " more", "")
			VAR FC_fact_index_rebuild_log_detail_BatchID = IF(fact_index_rebuild_log_detail_BatchIDCount > 0, "BATCH IDs CHOSEN: " & CONCATENATEX(fact_index_rebuild_log_detail_BatchID, [BatchID_display], ", "), BLANK()) & More_fact_index_rebuild_log_detail_BatchID
			
			VAR edw_unknown_keys_SchemaName = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES('edw_unknown_keys'[SchemaName]), NOT(ISBLANK('edw_unknown_keys'[SchemaName]))), 'edw_unknown_keys'[SchemaName], ASC),
			    "SchemaName_display", 'edw_unknown_keys'[SchemaName]
			)
			VAR edw_unknown_keys_SchemaNameCount = IF(ISFILTERED('edw_unknown_keys'[SchemaName]), COUNTROWS(VALUES('edw_unknown_keys'[SchemaName])), 0)
			VAR More_edw_unknown_keys_SchemaName = IF(edw_unknown_keys_SchemaNameCount > 5, " and " & (edw_unknown_keys_SchemaNameCount - 5) & " more", "")
			VAR FC_edw_unknown_keys_SchemaName = IF(edw_unknown_keys_SchemaNameCount > 0, "SCHEMAS CHOSEN: " & CONCATENATEX(edw_unknown_keys_SchemaName, [SchemaName_display], ", "), BLANK()) & More_edw_unknown_keys_SchemaName
			
			VAR edw_unknown_keys_TableName = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES('edw_unknown_keys'[TableName]), NOT(ISBLANK('edw_unknown_keys'[TableName]))), 'edw_unknown_keys'[TableName], ASC),
			    "TableName_display", 'edw_unknown_keys'[TableName]
			)
			VAR edw_unknown_keys_TableNameCount = IF(ISFILTERED('edw_unknown_keys'[TableName]), COUNTROWS(VALUES('edw_unknown_keys'[TableName])), 0)
			VAR More_edw_unknown_keys_TableName = IF(edw_unknown_keys_TableNameCount > 5, " and " & (edw_unknown_keys_TableNameCount - 5) & " more", "")
			VAR FC_edw_unknown_keys_TableName = IF(edw_unknown_keys_TableNameCount > 0, "TABLES CHOSEN: " & CONCATENATEX(edw_unknown_keys_TableName, [TableName_display], ", "), BLANK()) & More_edw_unknown_keys_TableName
			
			VAR edw_unknown_keys_ColumnName = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES('edw_unknown_keys'[ColumnName]), NOT(ISBLANK('edw_unknown_keys'[ColumnName]))), 'edw_unknown_keys'[ColumnName], ASC),
			    "ColumnName_display", 'edw_unknown_keys'[ColumnName]
			)
			VAR edw_unknown_keys_ColumnNameCount = IF(ISFILTERED('edw_unknown_keys'[ColumnName]), COUNTROWS(VALUES('edw_unknown_keys'[ColumnName])), 0)
			VAR More_edw_unknown_keys_ColumnName = IF(edw_unknown_keys_ColumnNameCount > 5, " and " & (edw_unknown_keys_ColumnNameCount - 5) & " more", "")
			VAR FC_edw_unknown_keys_ColumnName = IF(edw_unknown_keys_ColumnNameCount > 0, "COLUMNS CHOSEN: " & CONCATENATEX(edw_unknown_keys_ColumnName, [ColumnName_display], ", "), BLANK()) & More_edw_unknown_keys_ColumnName
			
			VAR edw_unknown_keys_PercentageUnknown = 
			    IF(
			        ISFILTERED('dim_percentage'[Value]),
			        VAR MinValue = MINX(VALUES('dim_percentage'[Value]), 'dim_percentage'[Value])/100
			        VAR MaxValue = MAXX(VALUES('dim_percentage'[Value]), 'dim_percentage'[Value])/100
			        RETURN
			            IF(
			                MinValue = MaxValue,
			                FORMAT(MinValue, "0%"),
			                FORMAT(MinValue, "0%") & " - " & FORMAT(MaxValue, "0%")
			            ),
			        BLANK()
			    )
			
			VAR FC_edw_unknown_keys_PercentageUnknown = 
			    IF(
			        NOT(ISBLANK(edw_unknown_keys_PercentageUnknown)),
			        "PERCENTAGE RANGE: " & edw_unknown_keys_PercentageUnknown,
			        BLANK()
			    )
			
			RETURN
			IF(
			    (ISBLANK(FC_dim_action_action_type) || FC_dim_action_action_type = "") && 
			    (ISBLANK(FC_dim_table_SourceSystem) || FC_dim_table_SourceSystem = "") && 
			    (ISBLANK(FC_dim_table_TableName) || FC_dim_table_TableName = "") && 
			    (ISBLANK(FC_fact_index_rebuild_log_detail_SchemaAndTable) || FC_fact_index_rebuild_log_detail_SchemaAndTable = "") && 
			    (ISBLANK(FC_fact_index_rebuild_log_detail_IndexName) || FC_fact_index_rebuild_log_detail_IndexName = "") && 
			    (ISBLANK(FC_fact_index_rebuild_log_detail_BatchID) || FC_fact_index_rebuild_log_detail_BatchID = "") && 
			    (ISBLANK(FC_edw_unknown_keys_SchemaName) || FC_edw_unknown_keys_SchemaName = "") && 
			    (ISBLANK(FC_edw_unknown_keys_TableName) || FC_edw_unknown_keys_TableName = "") && 
			    (ISBLANK(FC_edw_unknown_keys_ColumnName) || FC_edw_unknown_keys_ColumnName = "") &&
			    (ISBLANK(FC_edw_unknown_keys_PercentageUnknown) || FC_edw_unknown_keys_PercentageUnknown = ""),
			    "No filters are currently applied to this page.",
			    "Please note that the following filters are currently applied to this page: " &
			    CONCATENATEX(
			        FILTER(
			            { 
			                FC_dim_action_action_type, 
			                FC_dim_table_SourceSystem, 
			                FC_dim_table_TableName, 
			                FC_fact_index_rebuild_log_detail_SchemaAndTable, 
			                FC_fact_index_rebuild_log_detail_IndexName, 
			                FC_fact_index_rebuild_log_detail_BatchID, 
			                FC_edw_unknown_keys_SchemaName, 
			                FC_edw_unknown_keys_TableName, 
			                FC_edw_unknown_keys_ColumnName,
			                FC_edw_unknown_keys_PercentageUnknown
			            }, 
			            [Value] <> BLANK()
			        ), 
			        [Value], 
			        " | "
			    )
			)
			```
		lineageTag: 493598e2-0732-4479-9adf-f1392c917710

	measure '(ETL) Applied Filters - Source and Table Only' = ```
			
			VAR __SourceSystems = ADDCOLUMNS(
			    TOPN(10, ALLSELECTED(dim_table[SourceSystem]), dim_table[SourceSystem], ASC),
			    "SourceSystem_display", dim_table[SourceSystem]
			)
			VAR __SourceSystemsCount = IF(ISFILTERED(dim_table[SourceSystem]), COUNTROWS(VALUES(dim_table[SourceSystem])), 0)
			VAR __MoreSourceSystems = IF(__SourceSystemsCount > 10, " and " & (__SourceSystemsCount - 10) & " more", "")
			
			VAR __TableNames = ADDCOLUMNS(
			    TOPN(10, ALLSELECTED(dim_table[TableName]), dim_table[TableName], ASC),
			    "TableName_display", dim_table[TableName]
			)
			VAR __TableNamesCount = IF(ISFILTERED(dim_table[TableName]), COUNTROWS(VALUES(dim_table[TableName])), 0)
			VAR __MoreTableNames = IF(__TableNamesCount > 10, " and " & (__TableNamesCount - 10) & " more", "")
			
			VAR _FC_SourceSystems = IF(__SourceSystemsCount > 0, "SOURCE SYSTEMS CHOSEN: " & CONCATENATEX(__SourceSystems, [SourceSystem_display], ", "), BLANK()) & __MoreSourceSystems
			VAR _FC_TableNames = IF(__TableNamesCount > 0, "TABLE NAMES CHOSEN: " & CONCATENATEX(__TableNames, [TableName_display], ", "), BLANK()) & __MoreTableNames
			
			RETURN
			IF(
			    (ISBLANK(_FC_SourceSystems) || _FC_SourceSystems = "") && 
			    (ISBLANK(_FC_TableNames) || _FC_TableNames = ""),
			    "No filters are currently applied to this page.",
			    "This page will only show the last load status. Other filters currently applied: " & _FC_SourceSystems & " " & _FC_TableNames
			)
			
			```
		lineageTag: 211bf5be-04ab-4a57-a556-8635ed3c7c71

	measure 'Average Process Duration (s)' =
			
			AVERAGEX(
			    SUMMARIZE(
			        fact_index_rebuild_log_detail,
			        fact_index_rebuild_log_detail[BatchID],
			        "TotalDuration", SUM(fact_index_rebuild_log_detail[IndexRebuildDurationSeconds])
			    ),
