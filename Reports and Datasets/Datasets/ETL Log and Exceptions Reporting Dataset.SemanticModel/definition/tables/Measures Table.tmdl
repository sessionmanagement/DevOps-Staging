			VAR More_dim_recordbase_user_user_exists_in_intellihr = IF(dim_recordbase_user_user_exists_in_intellihrCount > 5, " and " & (dim_recordbase_user_user_exists_in_intellihrCount - 5) & " more", "")
			VAR FC_dim_recordbase_user_user_exists_in_intellihr = IF(dim_recordbase_user_user_exists_in_intellihrCount > 0, "USER EXISTS IN INTELLIHR: " & CONCATENATEX(dim_recordbase_user_user_exists_in_intellihr, [user_exists_in_intellihr_display], ", "), BLANK()) & More_dim_recordbase_user_user_exists_in_intellihr
			
			VAR dim_recordbase_user_EmailDomain = ADDCOLUMNS(
