			VAR FC_dim_recordbase_user_UserLicenceType = IF(dim_recordbase_user_UserLicenceTypeCount > 0, "LICENCE TYPES CHOSEN: " & CONCATENATEX(dim_recordbase_user_UserLicenceType, [UserLicenceType_display], ", "), BLANK()) & More_dim_recordbase_user_UserLicenceType
			
			VAR dim_recordbase_user_user_exists_in_intellihr = ADDCOLUMNS(
