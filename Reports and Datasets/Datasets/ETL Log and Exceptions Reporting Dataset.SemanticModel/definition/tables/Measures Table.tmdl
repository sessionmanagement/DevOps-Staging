			VAR dim_recordbase_user_EmailDomainCount = IF(ISFILTERED('dim_recordbase_user'[EmailDomain]), COUNTROWS(VALUES('dim_recordbase_user'[EmailDomain])), 0)
			VAR More_dim_recordbase_user_EmailDomain = IF(dim_recordbase_user_EmailDomainCount > 5, " and " & (dim_recordbase_user_EmailDomainCount - 5) & " more", "")
			VAR FC_dim_recordbase_user_EmailDomain = IF(dim_recordbase_user_EmailDomainCount > 0, "EMAIL DOMAINS CHOSEN: " & CONCATENATEX(dim_recordbase_user_EmailDomain, [EmailDomain_display], ", "), BLANK()) & More_dim_recordbase_user_EmailDomain
			
			VAR dim_recordbase_user_UserTypeName = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES('dim_recordbase_user'[UserTypeName]), NOT(ISBLANK('dim_recordbase_user'[UserTypeName]))), 'dim_recordbase_user'[UserTypeName], ASC),
			    "UserTypeName_display", 'dim_recordbase_user'[UserTypeName]
			)
			VAR dim_recordbase_user_UserTypeNameCount = IF(ISFILTERED('dim_recordbase_user'[UserTypeName]), COUNTROWS(VALUES('dim_recordbase_user'[UserTypeName])), 0)
			VAR More_dim_recordbase_user_UserTypeName = IF(dim_recordbase_user_UserTypeNameCount > 5, " and " & (dim_recordbase_user_UserTypeNameCount - 5) & " more", "")
			VAR FC_dim_recordbase_user_UserTypeName = IF(dim_recordbase_user_UserTypeNameCount > 0, "USER TYPES CHOSEN: " & CONCATENATEX(dim_recordbase_user_UserTypeName, [UserTypeName_display], ", "), BLANK()) & More_dim_recordbase_user_UserTypeName
			
			VAR fact_user_team_TeamFunctionName = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES('fact_user_team'[TeamFunctionName]), NOT(ISBLANK('fact_user_team'[TeamFunctionName]))), 'fact_user_team'[TeamFunctionName], ASC),
			    "TeamFunctionName_display", 'fact_user_team'[TeamFunctionName]
			)
			VAR fact_user_team_TeamFunctionNameCount = IF(ISFILTERED('fact_user_team'[TeamFunctionName]), COUNTROWS(VALUES('fact_user_team'[TeamFunctionName])), 0)
			VAR More_fact_user_team_TeamFunctionName = IF(fact_user_team_TeamFunctionNameCount > 5, " and " & (fact_user_team_TeamFunctionNameCount - 5) & " more", "")
			VAR FC_fact_user_team_TeamFunctionName = IF(fact_user_team_TeamFunctionNameCount > 0, "TEAM FUNCTIONS CHOSEN: " & CONCATENATEX(fact_user_team_TeamFunctionName, [TeamFunctionName_display], ", "), BLANK()) & More_fact_user_team_TeamFunctionName
			
			VAR fact_user_team_TeamName = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES('fact_user_team'[TeamName]), NOT(ISBLANK('fact_user_team'[TeamName]))), 'fact_user_team'[TeamName], ASC),
			    "TeamName_display", 'fact_user_team'[TeamName]
			)
			VAR fact_user_team_TeamNameCount = IF(ISFILTERED('fact_user_team'[TeamName]), COUNTROWS(VALUES('fact_user_team'[TeamName])), 0)
			VAR More_fact_user_team_TeamName = IF(fact_user_team_TeamNameCount > 5, " and " & (fact_user_team_TeamNameCount - 5) & " more", "")
			VAR FC_fact_user_team_TeamName = IF(fact_user_team_TeamNameCount > 0, "TEAMS CHOSEN: " & CONCATENATEX(fact_user_team_TeamName, [TeamName_display], ", "), BLANK()) & More_fact_user_team_TeamName
			
			RETURN
			IF(
			    (ISBLANK(FC_dim_recordbase_user_UserFullName) || FC_dim_recordbase_user_UserFullName = "") && (ISBLANK(FC_dim_recordbase_user_UserLicenceType) || FC_dim_recordbase_user_UserLicenceType = "") && (ISBLANK(FC_dim_recordbase_user_user_exists_in_intellihr) || FC_dim_recordbase_user_user_exists_in_intellihr = "") && (ISBLANK(FC_dim_recordbase_user_EmailDomain) || FC_dim_recordbase_user_EmailDomain = "") && (ISBLANK(FC_dim_recordbase_user_UserTypeName) || FC_dim_recordbase_user_UserTypeName = "") && (ISBLANK(FC_fact_user_team_TeamFunctionName) || FC_fact_user_team_TeamFunctionName = "") && (ISBLANK(FC_fact_user_team_TeamName) || FC_fact_user_team_TeamName = ""),
			    "No filters are currently applied to this page.",
			    "Please note that the following filters are currently applied to this page: " &
			    CONCATENATEX(FILTER({ FC_dim_recordbase_user_UserFullName, FC_dim_recordbase_user_UserLicenceType, FC_dim_recordbase_user_user_exists_in_intellihr, FC_dim_recordbase_user_EmailDomain, FC_dim_recordbase_user_UserTypeName, FC_fact_user_team_TeamFunctionName, FC_fact_user_team_TeamName }, [Value] <> BLANK()), [Value], " | ")
			)
		lineageTag: 5ba20351-c701-477c-b26e-20f8b3450ed0

