			VAR dim_recordbase_user_UserFullNameCount = IF(ISFILTERED('dim_recordbase_user'[UserFullName]), COUNTROWS(VALUES('dim_recordbase_user'[UserFullName])), 0)
			VAR More_dim_recordbase_user_UserFullName = IF(dim_recordbase_user_UserFullNameCount > 5, " and " & (dim_recordbase_user_UserFullNameCount - 5) & " more", "")
			VAR FC_dim_recordbase_user_UserFullName = IF(dim_recordbase_user_UserFullNameCount > 0, "USERS CHOSEN: " & CONCATENATEX(dim_recordbase_user_UserFullName, [UserFullName_display], ", "), BLANK()) & More_dim_recordbase_user_UserFullName
			
			VAR dim_recordbase_user_UserLicenceType = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES('dim_recordbase_user'[UserLicenceType]), NOT(ISBLANK('dim_recordbase_user'[UserLicenceType]))), 'dim_recordbase_user'[UserLicenceType], ASC),
			    "UserLicenceType_display", 'dim_recordbase_user'[UserLicenceType]
