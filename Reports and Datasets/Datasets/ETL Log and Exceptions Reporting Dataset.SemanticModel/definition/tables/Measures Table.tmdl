	measure 'Latest End Time' =
			
			MAX(
			    fact_etl_log_overview_simple[EndTime_TimeOnly]
			)
		formatString: h:nn:ss AM/PM
		displayFolder: fact_etl_log_overview_simple
		lineageTag: 7dbfe075-555d-4584-a44a-7e5618644a24

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	measure 'Time Between Process Start and End' =
			
			DATEDIFF(
			    [Min Start Time],
			    [Latest End Time],
			    SECOND
			)/60
		displayFolder: fact_etl_log_overview_simple
		lineageTag: abe43c2c-5359-43ce-b993-c7536bcfadbc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Time Between Process Start and End (28-day Avg)' =
			
			AVERAGEX(
			    FILTER(
			        ALL(dim_date),
			        dim_date[calendar_date] >= MAX(dim_date[calendar_date]) - 29 &&
			        dim_date[calendar_date] <= MAX(dim_date[calendar_date]) - 1
			    ),
			    CALCULATE(
			        [Time Between Process Start and End]
			    )
			)
		displayFolder: fact_etl_log_overview_simple
		lineageTag: 3b6878cc-73d7-4c2d-895f-3be0e7a77ff0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Deviation from 28-day Avg (Total Processing Time in Mins)' =
			
			DIVIDE(
			    ([Time Between Process Start and End (28-day Avg)]-[Time Between Process Start and End]),
			    [Time Between Process Start and End (28-day Avg)]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: fact_etl_log_overview_simple
		lineageTag: 0b2d1845-6bbb-4b5d-a2d7-653927945e4e

