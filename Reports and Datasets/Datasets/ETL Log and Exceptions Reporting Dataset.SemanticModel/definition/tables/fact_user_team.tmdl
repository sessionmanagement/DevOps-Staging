	partition fact_user_team = m
		mode: import
		queryGroup: RecordBase
		source =
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="SELECT#(lf)fut.UserTeamID,#(lf)CONCAT('E-',fut.UserID) AS UserID,#(lf)CONCAT('E-',dt.TeamID) AS TeamID,#(lf)dt.TeamCode,#(lf)dt.TeamName,#(lf)dt.TeamDescription,#(lf)dt.TeamUDF5,#(lf)dtf.TeamFunctionName#(lf)FROM [RBEAL].[dlFactUserTeam] fut#(lf)INNER JOIN [RBEAL].[dlDimTeam] dt ON fut.TeamID = dt.TeamID#(lf)INNER JOIN [RBEAL].[dlDimTeamFunction] dtf ON dt.TeamFunctionID = dtf.TeamFunctionID#(lf)WHERE fut.UserTeamDeletedDate IS NOT NULL AND dt.TeamEndDate IS NULL#(lf)UNION ALL#(lf)SELECT#(lf)fut.UserTeamID,#(lf)CONCAT('M-',fut.UserID) AS UserID,#(lf)CONCAT('M-',dt.TeamID) AS TeamID,#(lf)dt.TeamCode,#(lf)dt.TeamName,#(lf)dt.TeamDescription,#(lf)dt.TeamUDF5,#(lf)dtf.TeamFunctionName#(lf)FROM [RBMNB].[dlFactUserTeam] fut#(lf)INNER JOIN [RBMNB].[dlDimTeam] dt ON fut.TeamID = dt.TeamID#(lf)INNER JOIN [RBMNB].[dlDimTeamFunction] dtf ON dt.TeamFunctionID = dtf.TeamFunctionID#(lf)WHERE fut.UserTeamDeletedDate IS NOT NULL AND dt.TeamEndDate IS NULL"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

