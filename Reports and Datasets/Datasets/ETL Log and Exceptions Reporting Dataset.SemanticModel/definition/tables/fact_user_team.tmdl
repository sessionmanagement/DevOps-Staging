	hierarchy 'TeamFunctionName Hierarchy'
		lineageTag: 4baf1b6a-d2a4-4ad3-8cab-7885f75d3a9c

		level 'Team Function Name'
			lineageTag: 3cb313ca-afd9-40a1-ac61-7fc0d727ea3f
			column: TeamFunctionName

		level 'Team Name'
			lineageTag: 6e434e72-c0b5-46b9-907b-a245b3f58fca
