table fact_user_team
	lineageTag: b85e1d1d-8a6f-4f1d-8135-5221e1f270c4

	measure UserTeamsConcatenated =
			
			CONCATENATEX(
			    VALUES(fact_user_team[TeamFull]),
			    fact_user_team[TeamFull],
			    UNICHAR(10),
			    fact_user_team[TeamFull],
			    ASC
			)
		lineageTag: 0c1bbf37-68b3-438e-a8f7-fdde9cc4ea9b

	column UserTeamID
		dataType: int64
		formatString: 0
		lineageTag: 5db8a290-11be-405b-8161-651aa1bc484b
		summarizeBy: count
