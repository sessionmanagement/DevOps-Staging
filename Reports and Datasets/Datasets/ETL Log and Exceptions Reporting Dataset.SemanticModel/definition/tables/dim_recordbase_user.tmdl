	partition dim_recordbase_user = m
		mode: import
		queryGroup: RecordBase
		source =
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="SELECT#(lf)    CONCAT('E-', UserID) AS UserID,#(lf)    'EAL' AS RecordBaseInstance,#(lf)    LOWER(UserEmailAddress) AS UserEmailAddress,#(lf)    LOWER(SUBSTRING(UserEmailAddress, CHARINDEX('@', UserEmailAddress) + 1, LEN(UserEmailAddress) - CHARINDEX('@', UserEmailAddress))) AS EmailDomain,#(lf)    UserFirstName,#(lf)    UserLastName,#(lf)    UserLicenceType,#(lf)    CASE WHEN UserDisabledDate IS NULL THEN 1 ELSE 0 END AS UserIsActive,#(lf)    CAST(UserDisabledDate AS date) AS UserDisabledDate,#(lf)    COALESCE(UserFirstName, '') + ' ' + COALESCE(UserLastName, '') AS UserFullName,#(lf)#(tab)d2.UserTypeName#(lf)FROM [RBEAL].[dlDimUser] d1#(lf)LEFT OUTER JOIN [RBEAL].[dlDimUserType] d2 ON d1.UserTypeID = d2.UserTypeID#(lf)WHERE UserDisabledDate IS NULL#(lf)UNION#(lf)SELECT#(lf)    CONCAT('M-', UserID) AS UserID,#(lf)    'MNB' AS RecordBaseInstance,#(lf)    LOWER(UserEmailAddress) AS UserEmailAddress,#(lf)    LOWER(SUBSTRING(UserEmailAddress, CHARINDEX('@', UserEmailAddress) + 1, LEN(UserEmailAddress) - CHARINDEX('@', UserEmailAddress))) AS EmailDomain,#(lf)    UserFirstName,#(lf)    UserLastName,#(lf)    UserLicenceType,#(lf)    CASE WHEN UserDisabledDate IS NULL THEN 1 ELSE 0 END AS UserIsActive,#(lf)    CAST(UserDisabledDate AS date) AS UserDisabledDate,#(lf)    COALESCE(UserFirstName, '') + ' ' + COALESCE(UserLastName, '') AS UserFullName,#(lf)#(tab)d2.UserTypeName#(lf)FROM [RBMNB].[dlDimUser] d1#(lf)LEFT OUTER JOIN [RBMNB].[dlDimUserType] d2 ON d1.UserTypeID = d2.UserTypeID#(lf)WHERE UserDisabledDate IS NULL;"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source, {{"UserDisabledDate", type date}}),
				    #"Transformed Email Addresses" = Table.TransformColumns(#"Changed Type", {{"UserEmailAddress", Text.Lower}}),
				    #"Transformed Employee Emails" = Table.TransformColumns(dim_employee, {{"employee_primary_email_address", Text.Lower}}),
				    #"Merged Queries" = Table.NestedJoin(#"Transformed Email Addresses", {"UserEmailAddress"}, #"Transformed Employee Emails", {"employee_primary_email_address"}, "dim_employee", JoinKind.LeftOuter),
				    #"Expanded dim_employee" = Table.ExpandTableColumn(#"Merged Queries", "dim_employee", {"intelli_employee_id", "intelli_CleanEmployeeName", "intelli_employee_employment_status", "employee_end_date"}, {"dim_employee.intelli_employee_id", "dim_employee.intelli_CleanEmployeeName", "dim_employee.intelli_employee_employment_status", "dim_employee.employee_end_date"}),
				    #"Added Conditional Column" = Table.AddColumn(#"Expanded dim_employee", "user_exists_in_intellihr", each if [dim_employee.intelli_employee_id] <> null then "Yes" else "No"),
				    #"Added Conditional Column1" = Table.AddColumn(#"Added Conditional Column", "user_exists_in_intellihr_int", each if [dim_employee.intelli_employee_id] <> null then 1 else 0)
				in
				    #"Added Conditional Column1"

	annotation PBI_ResultType = Table

