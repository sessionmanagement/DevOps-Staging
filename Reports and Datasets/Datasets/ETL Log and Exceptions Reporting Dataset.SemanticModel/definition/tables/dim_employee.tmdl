	partition dim_employee = m
		mode: import
		queryGroup: Personaverse
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="SELECT DISTINCT#(lf)       de1.employee_primary_email_address,#(lf)       de1.[dim_employee_key],#(lf)       de1.[employee_id],#(lf)       LTRIM(RTRIM(REPLACE(#(lf)           CASE#(lf)               WHEN CHARINDEX('(', de1.[employee_name]) > 0 THEN#(lf)                   STUFF(#(lf)                       de1.[employee_name],#(lf)                       CHARINDEX('(', de1.[employee_name]),#(lf)                       CHARINDEX(')', de1.[employee_name]) - CHARINDEX('(', de1.[employee_name]) + 1,#(lf)                       ''#(lf)                   )#(lf)               ELSE de1.[employee_name]#(lf)           END#(lf)       , '  ', ' '))) AS CleanEmployeeName,#(lf)       de1.[employee_employment_status],#(lf)       de1.[employee_company_name],#(lf)       de1.[employee_job_name],#(lf)       LTRIM(RTRIM(REPLACE(#(lf)           CASE#(lf)               WHEN CHARINDEX('(', de1.employee_people_manager_name) > 0 THEN#(lf)                   STUFF(#(lf)                       de1.employee_people_manager_name,#(lf)                       CHARINDEX('(', de1.employee_people_manager_name),#(lf)                       CHARINDEX(')', de1.employee_people_manager_name) - CHARINDEX('(', de1.employee_people_manager_name) + 1,#(lf)                       ''#(lf)                   )#(lf)               ELSE de1.employee_people_manager_name#(lf)           END#(lf)       , '  ', ' '))) AS CleanPeopleManagerName,#(lf)       de1.employee_people_manager_id,#(lf)       LTRIM(RTRIM(REPLACE(#(lf)           CASE#(lf)               WHEN CHARINDEX('(', de2.employee_people_manager_name) > 0 THEN#(lf)                   STUFF(#(lf)                       de2.employee_people_manager_name,#(lf)                       CHARINDEX('(', de2.employee_people_manager_name),#(lf)                       CHARINDEX(')', de2.employee_people_manager_name) - CHARINDEX('(', de2.employee_people_manager_name) + 1,#(lf)                       ''#(lf)                   )#(lf)               ELSE de2.employee_people_manager_name#(lf)           END#(lf)       , '  ', ' '))) AS [1up_CleanPeopleManagerName],#(lf)       de2.employee_people_manager_id AS [1up_employee_people_manager_id]#(lf)#(tab)   ,deh.employee_Business_unit_name#(lf)#(tab)   ,de1.employee_work_type#(lf)#(tab)   ,de1.employee_emergency_contact_name#(lf)#(tab)   ,de1.employee_next_of_whanau_phone#(lf)#(tab)   ,de1.employee_next_of_whanau_email#(lf)#(tab)   ,de1.employee_next_of_whanau_relationship#(lf)#(tab)   ,de1.employee_end_date#(lf)FROM [edw].[vw_dim_employee] de1#(lf)INNER JOIN [edw].[vw_dim_employee_hierarchy] deh ON deh.dim_employee_key = de1.dim_employee_key AND deh.DWHIsCurrent = 1#(lf)LEFT JOIN [edw].[vw_dim_employee] de2 #(lf)    ON de1.employee_people_manager_id = de2.employee_id #(lf)    AND de2.DWHIsCurrent = 1#(lf)WHERE de1.DWHIsCurrent = 1 #(lf)AND de1.employee_employment_status IN ('Current Staff', 'Exiting Staff')"]),
				    #"Renamed Columns" = Table.RenameColumns(Source,{{"employee_id", "intelli_employee_id"}, {"CleanEmployeeName", "intelli_CleanEmployeeName"}, {"employee_employment_status", "intelli_employee_employment_status"}, {"employee_company_name", "intelli_employee_company_name"}, {"employee_job_name", "intelli_employee_job_name"}, {"CleanPeopleManagerName", "intelli_CleanPeopleManagerName"}, {"employee_people_manager_id", "intelli_employee_people_manager_id"}, {"1up_CleanPeopleManagerName", "intelli_1up_CleanPeopleManagerName"}, {"1up_employee_people_manager_id", "intelli_1up_employee_people_manager_id"}, {"employee_Business_unit_name", "intelli_business_unit_name"}, {"employee_work_type", "intelli_employee_work_type"}}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Renamed Columns",{{"employee_end_date", type date}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

