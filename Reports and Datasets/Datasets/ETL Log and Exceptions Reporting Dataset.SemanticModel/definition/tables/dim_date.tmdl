	partition dim_date = m
		mode: import
		queryGroup: Dimensions
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01", [Query="SELECT#(lf)#(tab)*,#(lf)#(tab)DATEDIFF(#(lf)#(tab)#(tab)DAY,#(lf)#(tab)#(tab)CONVERT(datetime, SWITCHOFFSET(CONVERT(datetimeoffset, GETDATE()), DATEPART(TZOFFSET,GETDATE() AT TIME ZONE 'New Zealand Standard Time'))),#(lf)                calendar_date)#(lf)#(tab)#(tab)AS date_offset#(lf)FROM edw.dim_date"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"calendar_date", type date}}),
				    #"Filtered Rows" = Table.SelectRows(#"Changed Type", each ([calendar_date] <> #date(1900, 1, 1)))
				in
