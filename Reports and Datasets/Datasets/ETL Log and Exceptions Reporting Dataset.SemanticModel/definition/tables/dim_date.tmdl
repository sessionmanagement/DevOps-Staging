	column formatted_calendar_date = ```
			
			IF(
			    dim_date[date_offset] = 0,
			    "Today",
			    IF(
			        dim_date[date_offset] = -1,
			        "Yesterday",
			        FORMAT(dim_date[calendar_date], "DD/MM/YYYY")
			    )
			)
			
			```
		lineageTag: e16602fe-f1b9-4864-8e2a-25350e59aaed
		summarizeBy: none
		sortByColumn: date_offset

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

