	column 'Days Since Last Load' =
			
			DATEDIFF(
			    fact_last_load_status_by_table[LastLoadClosedAtDate],
			    TODAY(),
			    DAY
			)
		formatString: 0
		lineageTag: a99a0edb-f0e8-4553-8b8a-58a481eedcf3
		summarizeBy: sum

