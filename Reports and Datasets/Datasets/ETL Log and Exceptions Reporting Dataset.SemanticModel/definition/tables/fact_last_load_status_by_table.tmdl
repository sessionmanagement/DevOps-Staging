	partition fact_last_load_status_by_table = m
		mode: import
		queryGroup: Facts
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-fk-01.database.windows.net", "Framework", [Query="SELECT #(lf)    CASE #(lf)        WHEN LEFT(TargetTableName, CHARINDEX('.', TargetTableName) - 1) = 'edw' THEN 'ODS' #(lf)        ELSE LEFT(TargetTableName, CHARINDEX('.', TargetTableName) - 1) #(lf)    END AS SourceSystem,#(lf)    [DataLoadId],#(lf)    [TargetTableName],#(lf)    SUBSTRING(#(lf)        TargetTableName, #(lf)        CHARINDEX('.', TargetTableName) + 1, #(lf)        LEN(TargetTableName) - CHARINDEX('.', TargetTableName)#(lf)    ) AS TableName,#(lf)    COALESCE(IsLoadDisabled,0) AS [IsLoadDisabled],#(lf)    [LoadPhase],#(lf)    [CurrentLoadStatus],#(lf)    [LastLoadParentBatchID],#(lf)    [LastLoadBatchID],#(lf)    CONVERT(datetime, SWITCHOFFSET(CONVERT(datetimeoffset, [LastLoadCreatedAt]), DATEPART(TZOFFSET, [LastLoadCreatedAt] AT TIME ZONE 'New Zealand Standard Time'))) AS LastLoadCreatedAt,#(lf)    CONVERT(datetime, SWITCHOFFSET(CONVERT(datetimeoffset, [LastLoadClosedAt]), DATEPART(TZOFFSET, [LastLoadClosedAt] AT TIME ZONE 'New Zealand Standard Time'))) AS LastLoadClosedAt,#(lf)    [LastLoadDuration],#(lf)    [LastErrorMessage],#(lf)    [ETLRowCount],#(lf)    [ETLErrorCount],#(lf)    [ETLWarningCount],#(lf)    [ETLInsertCount],#(lf)    [ETLUpdateCount],#(lf)    [ETLDeleteCount],#(lf)    [TotalSourceRecords],#(lf)    [TotalTargetRecords]#(lf)FROM #(lf)    [ETL].[DataLoadStatus]#(lf)WHERE #(lf)    TargetTableName IS NOT NULL#(lf)    AND CHARINDEX('.', TargetTableName) > 0;"]),
				    #"Merged Queries" = Table.NestedJoin(Source, {"SourceSystem", "TableName"}, dim_table, {"SourceSystem", "TableName"}, "dim_table", JoinKind.Inner),
				    #"Expanded dim_table" = Table.ExpandTableColumn(#"Merged Queries", "dim_table", {"table_key"}, {"table_key"}),
				    #"Duplicated Column" = Table.DuplicateColumn(#"Expanded dim_table", "LastLoadCreatedAt", "LastLoadCreatedAt - Copy"),
				    #"Duplicated Column1" = Table.DuplicateColumn(#"Duplicated Column", "LastLoadClosedAt", "LastLoadClosedAt - Copy"),
				    #"Changed Type" = Table.TransformColumnTypes(#"Duplicated Column1",{{"LastLoadCreatedAt - Copy", type date}, {"LastLoadClosedAt - Copy", type date}}),
				    #"Renamed Columns" = Table.RenameColumns(#"Changed Type",{{"LastLoadCreatedAt - Copy", "LastLoadCreatedAtDate"}, {"LastLoadClosedAt - Copy", "LastLoadClosedAtDate"}})
				in
				    #"Renamed Columns"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

