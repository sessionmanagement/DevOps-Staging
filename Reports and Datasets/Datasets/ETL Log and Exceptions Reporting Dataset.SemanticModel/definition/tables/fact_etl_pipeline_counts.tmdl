	partition fact_etl_pipeline_counts = m
		mode: import
		queryGroup: Facts
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-manager", [Query="-- Full history version#(lf)-- One row per (table, load_date) with deltas against the preceding load.#(lf)WITH rc_prev#(lf)AS (#(lf) SELECT rc.check_detail_id,#(lf)  rc.load_date,#(lf)  rc.source_load_count,#(lf)  rc.ods_load_count,#(lf)  rc.edw_load_count,#(lf)  -- Previous counts per table (NULL for first load)#(lf)  LAG(rc.source_load_count) OVER (#(lf)   PARTITION BY rc.check_detail_id ORDER BY rc.load_date#(lf)   ) AS prev_source_load_count,#(lf)  LAG(rc.ods_load_count) OVER (#(lf)   PARTITION BY rc.check_detail_id ORDER BY rc.load_date#(lf)   ) AS prev_ods_load_count,#(lf)  LAG(rc.edw_load_count) OVER (#(lf)   PARTITION BY rc.check_detail_id ORDER BY rc.load_date#(lf)   ) AS prev_edw_load_count#(lf) FROM load_check.row_count rc#(lf) )#(lf)-- Final (I hope)#(lf)SELECT ss.source_system_name AS SourceSystem,#(lf) cd.table_name AS TableName,#(lf) r.load_date,#(lf) r.source_load_count,#(lf) r.ods_load_count,#(lf) r.edw_load_count,#(lf) r.source_load_count - r.ods_load_count + COALESCE(cd.source_ods_acceptable_difference, 0) AS ods_load_difference,#(lf) r.ods_load_count - r.edw_load_count + COALESCE(cd.ods_edw_acceptable_difference, 0) AS edw_load_difference,#(lf) CASE #(lf)  WHEN r.prev_source_load_count IS NOT NULL#(lf)   AND r.prev_source_load_count > 0#(lf)   THEN ROUND((CAST(r.source_load_count - r.prev_source_load_count AS DECIMAL(20, 8)) / r.prev_source_load_count) * 100, 3)#(lf)  ELSE NULL#(lf)  END AS percent_daily_change,#(lf) r.ods_load_count - COALESCE(r.prev_ods_load_count, 0) AS ods_daily_change,#(lf) r.edw_load_count - COALESCE(r.prev_edw_load_count, 0) AS edw_daily_change#(lf)FROM rc_prev r#(lf)JOIN load_check.check_detail cd ON cd.check_detail_id = r.check_detail_id#(lf)JOIN meta_data.source_system ss ON ss.source_system_id = cd.source_system_id#(lf)WHERE cd.IsActive = 1#(lf)ORDER BY ss.source_system_name,#(lf) cd.source_load_dataset,#(lf) cd.table_name,#(lf) r.load_date;"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"load_date", type date}})
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

