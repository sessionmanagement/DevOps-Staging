	partition Teams-419fd425-1a35-4b43-b600-3dceefbe96a1 = m
		mode: import
		source = ```
				let
				    Source = Sql.Database(#"Server", #"Database", [Query="SELECT 
				    dt.TeamName,
				    dtf.TeamFunctionName,
				    dt.TeamID AS team_id,
				    CASE 
				        WHEN dt.TeamName LIKE '%adhb%' THEN 'Auckland'
				        WHEN dt.TeamName LIKE '%wdhb%' THEN 'Waitemata'
				        WHEN dt.TeamName LIKE 'easeup%west%' THEN 'Waitemata'
				        WHEN dt.TeamName LIKE 'easeup%north%' THEN 'Waitemata'
				        WHEN dt.TeamName LIKE '%waikato%' THEN 'Waikato'
				        ELSE 'Other Region'
				    END AS TeamRegion
				FROM RBEAL.dlDimTeam dt
				INNER JOIN RBEAL.dlDimTeamFunction dtf ON dt.TeamFunctionID = dtf.TeamFunctionID
				WHERE dt.TeamName LIKE '%ease%up%'"]),
				    #"Renamed Columns" = Table.RenameColumns(Source,{{"TeamName", "Team Name"}})
				in
				    #"Renamed Columns"
				```

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

