				    Source = Sql.Database(Server, Database, [Query="-- ============================================================#(lf)-- Model:  Ease Up Dataset#(lf)-- Table:  Joint Tables#(lf)-- Source: native query (complex CTE/window) - emitted in full#(lf)-- Used columns: 9 (mapped 9, unmapped 0)  [full query, not trimmed]#(lf)-- Auto-generated from pbi_complete_dump.csv + model M + EDW/ODS schema.#(lf)-- Review before use; verify joins/filters against the model.#(lf)-- ============================================================#(lf)-- USED model columns: ActivityEndDate; ActivityID; ActivityStartDate; ReferralID; ReferralReceivedDate; TeamID; activitystartmonth; referraldatepure; referralstatusstartdate#(lf)#(lf)WITH test AS (#(lf)    SELECT #(lf)        factreferralstatus.ReferralID,#(lf)        referralstatusstartdate,#(lf)        referralstatustypecode,#(lf)        referralstatustypegroup,#(lf)        referralstatustypestatusorder,#(lf)        factreferral.personid,#(lf)        factreferral.ReferralReceivedDate,#(lf)        dimTeam.TeamID,#(lf)        dimTeam.teamname,#(lf)        dimperson.personfirstname,#(lf)        dimperson.personlastname,#(lf)        ReferralStatusTypeReasonDescription#(lf)    FROM rbeal.dlFactReferralStatus factreferralstatus#(lf)    INNER JOIN rbeal.dlDimReferralStatusType ON factreferralstatus.ReferralStatusTypeID = dlDimReferralStatusType.ReferralStatusTypeID#(lf)    INNER JOIN rbeal.dlfactreferral factreferral ON factreferralstatus.referralid = factreferral.referralid#(lf)    INNER JOIN rbeal.dlDimPerson dimperson ON factreferral.PersonID = dimperson.personid#(lf)    INNER JOIN rbeal.dldimteam dimteam ON factreferral.teamid = dimteam.teamid#(lf)    INNER JOIN rbeal.dlDimTeamFunction dimteamfunction ON dimteam.TeamFunctionID = dimteamfunction.TeamFunctionID#(lf)    LEFT JOIN rbeal.dlDimReferralStatusTypeReason ON factreferralstatus.ReferralStatusTypeReasonID = dlDimReferralStatusTypeReason.ReferralStatusTypeReasonID#(lf)    WHERE teamname LIKE '%ease%up%'#(lf)    AND ReferralStatusStartDate > '2019-06-30'#(lf)),#(lf)#(lf)referralbystatus2 AS (#(lf)    SELECT * FROM test#(lf)),#(lf)#(lf)accepts2 AS (#(lf)    SELECT #(lf)        row_number() OVER (PARTITION BY personid ORDER BY personid, referralstatustypegroup, referralstatusstartdate DESC) AS referralno,#(lf)        *#(lf)    FROM referralbystatus2#(lf)    WHERE referralstatustypecode = 'accepted'#(lf)),#(lf)#(lf)createdpivot AS (#(lf)    SELECT #(lf)        personid,#(lf)        [1],#(lf)        [2],#(lf)        [3],#(lf)        [4],#(lf)        [5],#(lf)        datediff(month, [2], [1]) AS diff2and1,#(lf)        datediff(month, [3], [2]) AS diff3and2,#(lf)        datediff(month, [4], [3]) AS diff4and3,#(lf)        datediff(month, [5], [4]) AS diff5and4#(lf)    FROM (#(lf)        SELECT personid, referralno, referralstatusstartdate#(lf)        FROM accepts2#(lf)    ) AS data1#(lf)    PIVOT (max(referralstatusstartdate) FOR referralno IN ([1],[2],[3],[4],[5])) AS pvt#(lf)),#(lf)#(lf)testy2 AS (#(lf)    SELECT personid, [1] AS createddate FROM createdpivot WHERE [2] IS NULL#(lf)    UNION ALL#(lf)    SELECT personid, [1] FROM createdpivot WHERE [2] IS NOT NULL AND diff2and1 > 3 AND [3] IS NULL#(lf)    UNION ALL#(lf)    SELECT personid, [2] FROM createdpivot WHERE [2] IS NOT NULL AND diff2and1 > 3 AND [3] IS NULL#(lf)    UNION ALL#(lf)    SELECT personid, [2] FROM createdpivot WHERE [2] IS NOT NULL AND diff2and1 <= 3 AND [3] IS NULL#(lf)    UNION ALL#(lf)    SELECT personid, [3] FROM createdpivot WHERE [3] IS NOT NULL AND [4] IS NULL AND diff3and2 > 3 AND diff2and1 > 3#(lf)    UNION ALL#(lf)    SELECT personid, [2] FROM createdpivot WHERE [3] IS NOT NULL AND [4] IS NULL AND diff3and2 > 3 AND diff2and1 > 3#(lf)    UNION ALL#(lf)    SELECT personid, [1] FROM createdpivot WHERE [3] IS NOT NULL AND [4] IS NULL AND diff3and2 > 3 AND diff2and1 > 3#(lf)    UNION ALL#(lf)    SELECT personid, [3] FROM createdpivot WHERE [3] IS NOT NULL AND [4] IS NULL AND diff3and2 > 3 AND diff2and1 <= 3#(lf)    UNION ALL#(lf)    SELECT personid, [2] FROM createdpivot WHERE [3] IS NOT NULL AND [4] IS NULL AND diff3and2 > 3 AND diff2and1 <= 3#(lf)    UNION ALL#(lf)    SELECT personid, [3] FROM createdpivot WHERE [3] IS NOT NULL AND [4] IS NULL AND diff3and2 <= 3 AND diff2and1 <= 3#(lf)    UNION ALL#(lf)    SELECT personid, [4] FROM createdpivot WHERE [4] IS NOT NULL AND [5] IS NULL AND diff4and3 > 3 AND diff3and2 > 3 AND diff2and1 > 3#(lf)    UNION ALL#(lf)    SELECT personid, [3] FROM createdpivot WHERE [4] IS NOT NULL AND [5] IS NULL AND diff4and3 > 3 AND diff3and2 > 3 AND diff2and1 > 3#(lf)    UNION ALL#(lf)    SELECT personid, [2] FROM createdpivot WHERE [4] IS NOT NULL AND [5] IS NULL AND diff4and3 > 3 AND diff3and2 > 3 AND diff2and1 > 3#(lf)    UNION ALL#(lf)    SELECT personid, [1] FROM createdpivot WHERE [4] IS NOT NULL AND [5] IS NULL AND diff4and3 > 3 AND diff3and2 > 3 AND diff2and1 > 3#(lf)    UNION ALL#(lf)    SELECT personid, [4] FROM createdpivot WHERE [4] IS NOT NULL AND [5] IS NULL AND diff4and3 > 3 AND diff3and2 > 3 AND diff2and1 <= 3#(lf)    UNION ALL#(lf)    SELECT personid, [3] FROM createdpivot WHERE [4] IS NOT NULL AND [5] IS NULL AND diff4and3 > 3 AND diff3and2 > 3 AND diff2and1 <= 3#(lf)    UNION ALL#(lf)    SELECT personid, [2] FROM createdpivot WHERE [4] IS NOT NULL AND [5] IS NULL AND diff4and3 > 3 AND diff3and2 > 3 AND diff2and1 <= 3#(lf)    UNION ALL#(lf)    SELECT personid, [4] FROM createdpivot WHERE [4] IS NOT NULL AND [5] IS NULL AND diff4and3 > 3 AND diff3and2 <= 3 AND diff2and1 <= 3#(lf)    UNION ALL#(lf)    SELECT personid, [3] FROM createdpivot WHERE [4] IS NOT NULL AND [5] IS NULL AND diff4and3 > 3 AND diff3and2 <= 3 AND diff2and1 <= 3#(lf)    UNION ALL#(lf)    SELECT personid, [4] FROM createdpivot WHERE [4] IS NOT NULL AND [5] IS NULL AND diff4and3 <= 3 AND diff3and2 <= 3 AND diff2and1 <= 3#(lf)    UNION ALL#(lf)    SELECT personid, [5] FROM createdpivot WHERE [4] IS NOT NULL AND [5] IS NOT NULL AND diff5and4 > 3 AND diff4and3 > 3 AND diff3and2 > 3 AND diff2and1 > 3#(lf)    UNION ALL#(lf)    SELECT personid, [4] FROM createdpivot WHERE [4] IS NOT NULL AND [5] IS NOT NULL AND diff5and4 > 3 AND diff4and3 > 3 AND diff3and2 > 3 AND diff2and1 > 3#(lf)    UNION ALL#(lf)    SELECT personid, [3] FROM createdpivot WHERE [4] IS NOT NULL AND [5] IS NOT NULL AND diff5and4 > 3 AND diff4and3 > 3 AND diff3and2 > 3 AND diff2and1 > 3#(lf)    UNION ALL#(lf)    SELECT personid, [2] FROM createdpivot WHERE [4] IS NOT NULL AND [5] IS NOT NULL AND diff5and4 > 3 AND diff4and3 > 3 AND diff3and2 > 3 AND diff2and1 > 3#(lf)    UNION ALL#(lf)    SELECT personid, [1] FROM createdpivot WHERE [4] IS NOT NULL AND [5] IS NOT NULL AND diff5and4 > 3 AND diff4and3 > 3 AND diff3and2 > 3 AND diff2and1 > 3#(lf)    UNION ALL#(lf)    SELECT personid, [5] FROM createdpivot WHERE [4] IS NOT NULL AND [5] IS NOT NULL AND diff5and4 > 3 AND diff4and3 > 3 AND diff3and2 > 3 AND diff2and1 <= 3#(lf)    UNION ALL#(lf)    SELECT personid, [4] FROM createdpivot WHERE [4] IS NOT NULL AND [5] IS NOT NULL AND diff5and4 > 3 AND diff4and3 > 3 AND diff3and2 > 3 AND diff2and1 <= 3#(lf)    UNION ALL#(lf)    SELECT personid, [3] FROM createdpivot WHERE [4] IS NOT NULL AND [5] IS NOT NULL AND diff5and4 > 3 AND diff4and3 > 3 AND diff3and2 > 3 AND diff2and1 <= 3#(lf)    UNION ALL#(lf)    SELECT personid, [2] FROM createdpivot WHERE [4] IS NOT NULL AND [5] IS NOT NULL AND diff5and4 > 3 AND diff4and3 > 3 AND diff3and2 > 3 AND diff2and1 <= 3#(lf)    UNION ALL#(lf)    SELECT personid, [5] FROM createdpivot WHERE [4] IS NOT NULL AND [5] IS NOT NULL AND diff5and4 > 3 AND diff4and3 > 3 AND diff3and2 <= 3 AND diff2and1 <= 3#(lf)    UNION ALL#(lf)    SELECT personid, [4] FROM createdpivot WHERE [4] IS NOT NULL AND [5] IS NOT NULL AND diff5and4 > 3 AND diff4and3 > 3 AND diff3and2 <= 3 AND diff2and1 <= 3#(lf)    UNION ALL#(lf)    SELECT personid, [3] FROM createdpivot WHERE [4] IS NOT NULL AND [5] IS NOT NULL AND diff5and4 > 3 AND diff4and3 > 3 AND diff3and2 <= 3 AND diff2and1 <= 3#(lf)    UNION ALL#(lf)    SELECT personid, [5] FROM createdpivot WHERE [4] IS NOT NULL AND [5] IS NOT NULL AND diff5and4 > 3 AND diff4and3 <= 3 AND diff3and2 <= 3 AND diff2and1 <= 3#(lf)    UNION ALL#(lf)    SELECT personid, [4] FROM createdpivot WHERE [4] IS NOT NULL AND [5] IS NOT NULL AND diff5and4 > 3 AND diff4and3 <= 3 AND diff3and2 <= 3 AND diff2and1 <= 3#(lf)    UNION ALL#(lf)    SELECT personid, [5] FROM createdpivot WHERE [5] IS NOT NULL AND diff5and4 <= 3 AND diff4and3 <= 3 AND diff3and2 <= 3 AND diff2and1 <= 3#(lf)),#(lf)#(lf)lastdata AS (#(lf)    SELECT #(lf)        'Seen this Month' AS datatype,#(lf)        CASE WHEN createddate IS NOT NULL THEN 1 ELSE 0 END AS seen_count,#(lf)        0 AS discharged_count,#(lf)        accepts2.*,#(lf)        CASE WHEN createddate IS NULL THEN 'Seen in the last 3 months' ELSE 'Accept not Seen' END AS seenstatus#(lf)    FROM accepts2#(lf)    LEFT JOIN testy2 ON accepts2.personid = testy2.personid AND accepts2.ReferralStatusStartDate = testy2.createddate#(lf)    #(lf)    UNION ALL#(lf)    #(lf)    SELECT #(lf)        'Discharged this month',#(lf)        0 AS seen_count,#(lf)        1 AS discharged_count,#(lf)        '' AS referralno,#(lf)        ReferralID, referralstatusstartdate, referralstatustypecode, referralstatustypegroup,#(lf)        referralstatustypestatusorder, personid, ReferralReceivedDate, TeamID, teamname,#(lf)        personfirstname, personlastname, ReferralStatusTypeReasonDescription,#(lf)        '' AS seenstatus#(lf)    FROM test#(lf)    WHERE ReferralStatusTypeCode = 'Discharged'#(lf)    #(lf)    UNION ALL#(lf)    #(lf)    SELECT #(lf)        'Declined this month',#(lf)        0 AS seen_count,#(lf)        1 AS discharged_count,#(lf)        '' AS referralno,#(lf)        ReferralID, referralstatusstartdate, referralstatustypecode, referralstatustypegroup,#(lf)        referralstatustypestatusorder, personid, ReferralReceivedDate, TeamID, teamname,#(lf)        personfirstname, personlastname, ReferralStatusTypeReasonDescription,#(lf)        '' AS seenstatus#(lf)    FROM test#(lf)    WHERE ReferralStatusTypeCode = 'declined'#(lf)),#(lf)#(lf)lastdata2 AS (#(lf)    SELECT #(lf)        CASE #(lf)            WHEN teamname LIKE '%adhb%' THEN 'Auckland'#(lf)            WHEN teamname LIKE '%wdhb%' THEN 'Waitemata'#(lf)            WHEN teamname LIKE 'easeup%west%' THEN 'Waitemata'#(lf)            WHEN teamname LIKE 'easeup%north%' THEN 'Waitemata'#(lf)            WHEN teamname LIKE '%waikato%' THEN 'Waikato'#(lf)            ELSE 'Other Region'#(lf)        END AS TeamRegion,#(lf)        *,#(lf)        CAST(referralstatusstartdate AS DATE) AS referraldatepure#(lf)    FROM lastdata#(lf)),#(lf)#(lf)activity AS (#(lf)    SELECT #(lf)        CASE #(lf)            WHEN teamname LIKE '%adhb%' THEN 'Auckland'#(lf)            WHEN teamname LIKE '%wdhb%' THEN 'Waitemata'#(lf)            WHEN teamname LIKE 'easeup%west%' THEN 'Waitemata'#(lf)            WHEN teamname LIKE 'easeup%north%' THEN 'Waitemata'#(lf)            WHEN teamname LIKE '%waikato%' THEN 'Waikato'#(lf)            ELSE 'Other Region'#(lf)        END AS EaseUpRegion,#(lf)        FactActivity.ActivityID,#(lf)        DimPerson.PersonID,#(lf)        FactActivityParticipant.ReferralID,#(lf)        DimPerson.PersonReferenceNumber,#(lf)        DimPerson.PersonFirstName,#(lf)        DimPerson.PersonLastName,#(lf)        DATEADD(DAY, 1, EOMONTH(activitystartdate, -1)) AS activitystartmonth,#(lf)        FactActivity.ActivityStartDate,#(lf)        FactActivity.ActivityEndDate,#(lf)        DATEDIFF(MINUTE, FactActivity.ActivityStartDate, FactActivity.ActivityEndDate) AS activityduration,#(lf)        CASE #(lf)            WHEN DATEDIFF(MINUTE, FactActivity.ActivityStartDate, FactActivity.ActivityEndDate) < 10 THEN 'Under 10 Minutes'#(lf)            ELSE '10 Minutes and Over'#(lf)        END AS ActivityMinutes,#(lf)        FactActivity.ActivitySubject,#(lf)        DimTeam.TeamID,#(lf)        DimTeam.TeamName,#(lf)        DimActivityClassification.ActivityClassificationName,#(lf)        DimActivityType.ActivityTypeName,#(lf)        DimActivityType.ActivityTypeDescription,#(lf)        1 AS activity_count#(lf)    FROM rbeal.dlFactActivity FactActivity#(lf)    INNER JOIN rbeal.dlFactActivityParticipant FactActivityParticipant ON FactActivity.ActivityID = FactActivityParticipant.ActivityID#(lf)    INNER JOIN rbeal.dlDimActivityType DimActivityType ON FactActivity.ActivityTypeID = DimActivityType.ActivityTypeID#(lf)    INNER JOIN rbeal.dlDimActivityClassification DimActivityClassification ON FactActivity.ActivityClassificationID = DimActivityClassification.ActivityClassificationID#(lf)    INNER JOIN rbeal.dlDimTeam DimTeam ON FactActivity.TeamID = DimTeam.TeamID#(lf)    INNER JOIN rbeal.dlFactReferral FactReferral ON FactActivityParticipant.ReferralID = FactReferral.ReferralID#(lf)    INNER JOIN rbeal.dlDimPerson DimPerson ON FactActivityParticipant.EntityID = DimPerson.PersonID#(lf)    INNER JOIN rbeal.dlDimEthnicity DimEthnicity ON DimPerson.Ethnicity1ID = DimEthnicity.EthnicityID#(lf)    INNER JOIN rbeal.dlDimGender DimGender ON DimPerson.GenderID = DimGender.GenderID#(lf)    LEFT JOIN rbeal.dlFactGroupActivity FactGroupActivity ON FactActivity.ActivityID = FactGroupActivity.GroupActivityID#(lf)    WHERE Teamname LIKE '%Ease%Up%'#(lf)    AND ReferralCreatedDate > '2019-06-30'#(lf))#(lf)#(lf)SELECT #(lf)    lastdata2.*,#(lf)    activity.EaseUpRegion,#(lf)    activity.ActivityID,#(lf)    activity.PersonID AS PersonID_1,#(lf)    activity.ReferralID AS ReferralID_1,#(lf)    activity.PersonReferenceNumber,#(lf)    activity.PersonFirstName AS PersonFirstName_1,#(lf)    activity.PersonLastName AS PersonLastName_1,#(lf)    activity.activitystartmonth,#(lf)    activity.ActivityStartDate,#(lf)    activity.ActivityEndDate,#(lf)    activity.activityduration,#(lf)    activity.ActivityMinutes,#(lf)    activity.ActivitySubject,#(lf)    activity.TeamID AS TeamID_1,#(lf) 