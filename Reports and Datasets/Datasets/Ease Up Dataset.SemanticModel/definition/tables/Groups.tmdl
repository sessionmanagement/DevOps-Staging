	partition Groups-2815d49c-5b46-4f0b-9da5-f488f1006790 = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="WITH numbers AS (#(lf)    SELECT ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) - 1 AS n#(lf)    FROM RBEAL.dlDimEthnicity a#(lf)    CROSS JOIN RBEAL.dlDimEthnicity b#(lf)),#(lf)date_sequence AS (#(lf)    SELECT DATEADD(DAY, n, CAST('2016-07-01' AS DATE)) AS createddate#(lf)    FROM numbers#(lf)    WHERE DATEADD(DAY, n, CAST('2016-07-01' AS DATE)) <= CAST(GETDATE() AT TIME ZONE 'New Zealand Standard Time' AS DATE)#(lf)),#(lf)groups_base AS (#(lf)    SELECT #(lf)        fa.ActivityID,#(lf)        fa.ActivityStartDate,#(lf)        fa.ActivityEndDate,#(lf)        fa.ActivityCreatedDate,#(lf)        fa.ActivitySubject,#(lf)        fga.GroupActivityCreatedDate,#(lf)        dt.TeamName,#(lf)        dp.PersonID,#(lf)        CASE #(lf)            WHEN dt.TeamName LIKE '%wdhb%' THEN 'Waitemata'#(lf)            WHEN dt.TeamName LIKE '%adhb%' THEN 'Auckland'#(lf)            WHEN dt.TeamName LIKE '%waikato%' THEN 'Waikato'#(lf)            ELSE 'Undefined'#(lf)        END AS region,#(lf)        du.UserFirstName,#(lf)        du.UserLastName,#(lf)        u2.UserFirstName AS reportstofirstname,#(lf)        u2.UserLastName AS reportstosurname,#(lf)        fa.GroupActivityID#(lf)    FROM RBEAL.dlFactActivity fa#(lf)    INNER JOIN RBEAL.dlDimTeam dt ON fa.TeamID = dt.TeamID#(lf)    INNER JOIN RBEAL.dlFactGroupActivity fga ON fa.GroupActivityID = fga.GroupActivityID#(lf)    INNER JOIN RBEAL.dlFactActivityParticipant fap ON fa.ActivityID = fap.ActivityID#(lf)    INNER JOIN RBEAL.dlDimPerson dp ON fap.EntityID = dp.PersonID#(lf)    INNER JOIN RBEAL.dlDimUser du ON fa.ActivityCreatedUserID = du.UserID#(lf)    INNER JOIN RBEAL.dlDimUser u2 ON du.ReportsToUserID = u2.UserID#(lf)    WHERE dt.TeamName LIKE '%ease%'#(lf)),#(lf)groups_grouped AS (#(lf)    SELECT #(lf)        ActivityStartDate,#(lf)        GroupActivityID,#(lf)        COUNT(PersonID) AS number_attendees#(lf)    FROM groups_base#(lf)    GROUP BY ActivityStartDate, GroupActivityID#(lf)),#(lf)finaldata AS (#(lf)    SELECT #(lf)        ROW_NUMBER() OVER (PARTITION BY g.ActivityStartDate, g.region ORDER BY g.ActivityStartDate, g.region) AS countrows,#(lf)        g.ActivityID,#(lf)        g.GroupActivityID,#(lf)        g.PersonID,#(lf)        CAST(g.ActivityStartDate AS DATE) AS activitystartdatepure,#(lf)        g.ActivityStartDate,#(lf)        g.ActivityEndDate,#(lf)        g.ActivitySubject,#(lf)        g.TeamName,#(lf)        g.region,#(lf)        g.UserFirstName,#(lf)        g.UserLastName,#(lf)        g.reportstofirstname,#(lf)        g.reportstosurname,#(lf)        CASE #(lf)            WHEN gg.number_attendees = 1 THEN 'Only 1 attendee'#(lf)            WHEN gg.number_attendees BETWEEN 2 AND 14 THEN '2-14 Attendees'#(lf)            WHEN gg.number_attendees > 14 THEN '15 or More'#(lf)            ELSE 'Unknown'#(lf)        END AS group_status,#(lf)        CASE #(lf)            WHEN gg.number_attendees = 1 THEN 'Exclude'#(lf)            ELSE 'Include'#(lf)        END AS group_inclusion,#(lf)        1 AS group_count#(lf)    FROM groups_base g#(lf)    LEFT JOIN groups_grouped gg ON g.GroupActivityID = gg.GroupActivityID#(lf)),#(lf)finaldata2 AS (#(lf)    SELECT #(lf)        CASE WHEN countrows = 1 THEN 1 ELSE 0 END AS sum_sessions,#(lf)        ActivityID,#(lf)        GroupActivityID,#(lf)        PersonID,#(lf)        activitystartdatepure,#(lf)        ActivityStartDate,#(lf)        ActivityEndDate,#(lf)        ActivitySubject,#(lf)        TeamName,#(lf)        region,#(lf)        group_inclusion,#(lf)        group_status,#(lf)        UserFirstName AS usercreatedfirstname,#(lf)        UserLastName AS usercreatedlastname,#(lf)        reportstofirstname,#(lf)        reportstosurname AS reportstolastname#(lf)    FROM finaldata#(lf))#(lf)SELECT #(lf)    ds.createddate AS activitystartdatepure,#(lf)    ISNULL(f.sum_sessions, 0) AS sum_sessions,#(lf)    f.ActivityID,#(lf)    f.PersonID,#(lf)    f.ActivityStartDate,#(lf)    f.ActivityEndDate,#(lf)    f.ActivitySubject,#(lf)    f.TeamName,#(lf)    f.region,#(lf)    f.group_inclusion,#(lf)    f.group_status,#(lf)    concat(left(f.usercreatedfirstname,1),' ',left( f.usercreatedlastname,1)) as [User Created Initial],#(lf)    concat(left(f.reportstofirstname,1),' ',left(f.reportstolastname,1)) as [User Reports To Initial]#(lf)FROM date_sequence ds#(lf)LEFT JOIN finaldata2 f ON ds.createddate = f.activitystartdatepure"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"activitystartdatepure", type date}}),
				    #"Renamed Columns" = Table.RenameColumns(#"Changed Type",{{"group_inclusion", "Group Inclusion"}, {"group_status", "Group Status"}, {"region", "Region"}, {"TeamName", "Team Name"}, {"ActivityStartDate", "Activity Start Date"}, {"ActivityEndDate", "Activity End Date"}}),
				    #"Renamed Columns1" = Table.RenameColumns(#"Renamed Columns",{{"PersonID", "Person ID"}})
				in
				    #"Renamed Columns1"

