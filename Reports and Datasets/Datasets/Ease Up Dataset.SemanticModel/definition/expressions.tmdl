		    Source = Sql.Database("eal-sql01.database.windows.net", "Recordbase_EmergeAotearoa_Elite", [Query="#(lf)--drop table #age #(lf)#(lf)#(lf)declare @agestart smallint = -99#(lf)#(lf)declare @ageend smallint = 130#(lf)#(lf)#(lf)create table #age (age smallint)#(lf)#(lf)while @agestart <@ageend#(lf)begin #(lf)insert into #age (age)#(lf)select @agestart#(lf)set @agestart = @agestart+1#(lf)end#(lf)#(tab)#(lf)#(lf)select age,#(lf)case when age < 0 then 'Unknown'#(lf)when age <12 then '0-11'#(lf)when age <18 then '12-17'#(lf)when age <25 then '18-24'#(lf)when age <65 then '25-64'#(lf)when age <110 then '65 and Over'#(lf)when age <=130 then 'Unknown'#(lf)#(lf)else 'Unknown'#(lf)end as age_group#(lf)#(lf)from #age#(lf)#(tab)"]),
