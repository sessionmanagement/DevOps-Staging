#Ethnicity.EthnicityText#(lf)else #activity.EthnicityText#(lf)end as EthnicityText#(lf)--,activitybreakdownduration#(lf)--,activitybreakdowntypename#(lf),case when ActivityWhanauInvolvement is null then 0#(lf)when ActivityWhanauInvolvement = 0 then 0#(lf)else 1#(lf)end#(lf) as activitywhanauinvolvement#(lf)into #activity2#(lf)from #activity#(lf)left join #ethnicity on #activity.EthnicityParentId = #ethnicity.EthnicityID#(lf)order by personid , activitystartdate, session_inclusions desc#(lf)#(lf)--drop table #firstcount #(lf)#(lf)select easeupregion, personid, activitystartmonth, min(activitystartdate) as firstactivitydate#(lf)into #firstcount#(lf)from #activity2#(lf)where session_inclusions not like 'exclud%' --or activityclassificationname like '%group%'#(lf)group by easeupregion, personid, activitystartmonth#(lf)#(lf)#(lf)select #(lf)EaseUpRegion,#(lf)ActivityID,#(lf)PersonID,#(lf)Referralid,#(lf)PersonReferenceNumber,#(lf)PersonFirstName,#(lf)PersonLastName,#(lf)PersonDateOfBirth,#(lf)GenderText,#(lf)ageatreferral,#(lf)activitystartmonth,#(lf)ActivityStartDate,#(lf)ActivityEndDate,#(lf)activityduration,#(lf)ActivityMinutes,#(lf)ActivitySubject,#(lf)TeamID,#(lf)TeamName,#(lf)ActivityClassificationCode,#(lf)ActivityClassificationName,#(lf)ActivityTypeName,#(lf)ActivityTypeDescription,#(lf)activity_count,#(lf)session_inclusions,#(lf)EthnicityText,#(lf) activitywhanauinvolvement,#(lf) case when individualcountpermonth = 0 then 0#(lf) when individualcountpermonth = 1 and inds = 1 then 1#(lf) when individualcountpermonth = 1 and inds >1 then 0#(lf) end as individualcountpermonth,#(lf) Session_group#(lf)#(lf) from (#(lf)SELECT #(lf)ROW_NUMBER () OVER (PARTITION BY EASEUPREGION, PERSONID,ACTIVITYSTARTMONTH, individualcountpermonth ORDER BY EASEUPREGION, PERSONID, ACTIVITYSTARTMONTH,#(lf)individualcountpermonth desc)#(lf)AS Inds,#(lf)* #(lf)from #(lf)(#(lf)select #activity2.*, #(lf)case when #firstcount.personid is not null then 1#(lf)else 0#(lf)end as individualcountperm