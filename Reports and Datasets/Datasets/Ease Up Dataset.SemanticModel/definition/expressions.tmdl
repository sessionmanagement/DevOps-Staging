expression 'Date Table (Elite)' =
		let
		    Source = Sql.Database("eal-sql01.database.windows.net", "Recordbase_EmergeAotearoa_Elite", [Query="declare @startdate date = '2016-07-01'#(lf)#(lf)declare @enddate  date = #(lf)CONVERT(datetime, SWITCHOFFSET(getdate(), DATEPART(TZOFFSET, #(lf)Getdate() AT TIME ZONE 'New Zealand Standard Time')))#(lf)#(lf)#(lf)#(lf)create table #createddate (createddate date)#(lf)#(lf)while @startdate <= @enddate#(lf)begin #(lf)insert into #createddate (createddate)#(lf)select @startdate#(lf)set @startdate = dateadd(day,1,@startdate)#(lf)end#(lf)#(tab)#(lf)#(lf)#(tab)select createddate#(lf)#(tab), year(createddate) as calendar_year_createddate#(lf)#(tab), month(createddate) as month_createddate#(lf)#(tab), case when month(createddate) <=6 then month(createddate)+6#(lf)#(tab)  else month(createddate)-6#(lf)#(tab)  end as financial_month#(lf)#(tab)   ,case when month(createddate) <=6 then year(createddate)#(lf)#(tab)   ELSE YEAR(CREATEDDATE)+1#(lf)#(tab)   END AS Financial_Year_no#(lf)#(tab), row_number () over ( order by createddate desc) as date_number#(lf)#(tab),case when month(createddate) = 1 then 'Jan'#(lf)#(tab)when month(createddate) = 2 then 'Feb'#(lf)#(tab)when month(createddate) = 3 then 'Mar'#(lf)#(tab)when month(createddate) = 4 then 'Apr'#(lf)#(tab)when month(createddate) = 5 then 'May'#(lf)#(tab)when month(createddate) = 6 then 'Jun'#(lf)#(tab)when month(createddate) = 7 then 'Jul'#(lf)#(tab)when month(createddate) = 8 then 'Aug'#(lf)#(tab)when month(createddate) = 9 then 'Sep'#(lf)#(tab)when month(createddate) = 10 then 'Oct'#(lf)#(tab)when month(createddate) = 11 then 'Nov'#(lf)#(tab)when month(createddate) = 12 then 'Dec'#(lf)#(tab)end as Cal_month#(lf)#(tab)#(lf)#(tab)from #createddate "]),
