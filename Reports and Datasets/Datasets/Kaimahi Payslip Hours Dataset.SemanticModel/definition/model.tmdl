model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-NZ
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 'Final Tables'

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Working Tables'

	annotation PBI_QueryGroupOrder = 1

queryGroup 'Row Level Security'

	annotation PBI_QueryGroupOrder = 2

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["EmpLiveEmployees","IntelliJobs","IntelliPeople","_Measures","dim_date","WorkTypes","LastRefreshed","data_measure_definitions","dim_people","fact_pay_slips","Dim_Service","Row Level Security Employee","Additional Access","RLS with Additional Access"]

annotation PBI_ProTooling = ["DevMode","DaxQueryView_Desktop"]

ref table _Measures
ref table dim_date
ref table WorkTypes
ref table LastRefreshed
ref table data_measure_definitions
ref table 'Additional Access'
ref table dim_people
ref table fact_pay_slips
ref table Dim_Service
ref table 'Row Level Security Employee'
ref table 'RLS with Additional Access'

ref role Public
ref role 'Babu Test'
ref role 'Chris Test (2)'
ref role 'Elite - All Access'

ref cultureInfo en-US

