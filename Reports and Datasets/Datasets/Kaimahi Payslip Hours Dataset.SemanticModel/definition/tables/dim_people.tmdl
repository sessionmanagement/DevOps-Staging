	partition dim_people = m
		mode: import
		queryGroup: 'Final Tables'
		source =
				let
				    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="SELECT #(lf)#(tab)CONVERT(VARBINARY(16), HASHBYTES('MD5', CONCAT(DE.[company_id], IJ.[jobs_id], EE.[reference_number]))) AS UniqueKey,#(lf)#(tab)DE.[id]#(lf)   ,DE.[company_id]#(lf)   ,DE.[code] AS EmpID#(lf)   ,IP.[people_id]#(lf)   ,IP.[displayName] as Kaimahi#(lf)   ,IP.[dateOfBirth]#(lf)   ,IP.[gender]#(lf)   ,IP.[primaryEmailAddress_email]#(lf)   ,IP.[employmentStatus]#(lf)   ,IJ.jobs_id#(lf)   ,IJ.businessUnit_id#(lf)   ,IJ.supervisorPerson_displayName AS Supervisor#(lf)   ,IJ.workType AS 'Work Type'#(lf)   ,IJ.workClass AS 'Work Class'#(lf)   ,IJ.isPrimaryJob#(lf)   ,IJ.jobStatus AS 'Job Status'#(lf)   ,IJ.name AS 'Job Title'#(lf)   ,IJ.fte#(lf)   ,IJ.companyStartDate#(lf)   ,IJ.companyEndDate#(lf)   ,EE.id AS EmpLive_EmpID#(lf)   ,EE.is_active#(lf)#(lf)  FROM [Datapay].[employees] DE#(lf)  LEFT JOIN EmpLive.employees EE on CAST(DE.code AS NVARCHAR(20))  = EE.reference_number#(lf)#(tab)#(tab)LEFT JOIN IntelliHR.people IP ON  CAST(DE.code AS NVARCHAR(20))  = IP.employeeNumber#(lf)#(tab)#(tab)LEFT JOIN [IntelliHR].[jobs] IJ ON CAST(DE.code AS NVARCHAR(20))  = IJ.person_employeeNumber#(lf) WHERE #(lf) --EE.id <> null AND EE.id <>''AND#(lf) DE.ODSIsCurrent = 1 AND#(lf) EE.ODSIsCurrent = 1 AND#(lf) IP.ODSIsCurrent = 1 AND#(lf) IJ.ODSIsCurrent = 1"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"UniqueKey", type text}}),
				    #"Removed Duplicates" = Table.Distinct(#"Changed Type", {"EmpID"}),
				    #"Removed Columns" = Table.RemoveColumns(#"Removed Duplicates",{"UniqueKey"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

