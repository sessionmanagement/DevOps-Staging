	partition Dim_Service = m
		mode: import
		queryGroup: 'Final Tables'
		source =
				let
				    Source = Sql.Database("sql-prod-aus-svc-datawarehouse-01.database.windows.net", "sqldb-prod-datawarehouse-01"),
				    edw_dim_service = Source{[Schema="edw",Item="vw_dim_service"]}[Data],
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transformed Column Names" = Table.TransformColumnNames(edw_dim_service, each ApplyNamingConventions(_)),
				    #"Removed Columns" = Table.RemoveColumns(#"Transformed Column Names",{"DWH Source System", "DWH Dml Operation", "Finance Funder Code", "Finance Funder Name", "Finance Funding Agency Code", "Finance Funding Agency Name", "Finance Budget Holder Code", "Finance Budget Holder Name", "Finance Contract Code", "Finance Contract Name"}),
				    #"Replace nulls in Region" = Table.ReplaceValue(#"Removed Columns", null,"No Region",Replacer.ReplaceValue,{"Region Name"}),
				    #"Replace nulls in Service Name" = Table.ReplaceValue(#"Replace nulls in Region",null,"No ServiceName",Replacer.ReplaceValue,{"Service Name"}),
				    #"Replace nulls in Service Type" = Table.ReplaceValue(#"Replace nulls in Service Name",null,"No ServiceTypeName",Replacer.ReplaceValue,{"Service Type Name"}),
				    #"Replace nulls in Department" = Table.ReplaceValue(#"Replace nulls in Service Type",null,"No Department",Replacer.ReplaceValue,{"Department Name"}),
				    #"Replaced nulls in District" = Table.ReplaceValue(#"Replace nulls in Department",null,"No District",Replacer.ReplaceValue,{"District Name"})
				in
				    #"Replaced nulls in District"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

