	partition 'Additional Access' = m
		mode: import
		queryGroup: 'Row Level Security'
		source =
				let
				    // Load data from SharePoint
				    Source = SharePoint.Tables(
				        "https://emergeaotearoaltd.sharepoint.com/sites/OPS_ITServices/", [Implementation = "2.0", ViewMode = "All"]
				    ),
				    // Access specific table by ID
				    SelectedTable = Source{[Id = "27e19ae7-4448-4dfe-b172-3ee660e6e1df"]}[Items],
				    // Expand "Requester" List Column
				    ExpandedRequesterList = Table.ExpandListColumn(SelectedTable, "Requester"),
				    // Expand "Requester" Record Column to "email"
				    ExpandedRequesterEmail = Table.ExpandRecordColumn(
				        ExpandedRequesterList, "Requester", {"email"}, {"Requester Email"}
				    ),
				    // Expand "Person to Impersonate" List Column
				    ExpandedImpersonateList = Table.ExpandListColumn(ExpandedRequesterEmail, "Person to Impersonate"),
				    // Expand "Person to Impersonate" Record Column to "email"
				    ExpandedImpersonateEmail = Table.ExpandRecordColumn(
				        ExpandedImpersonateList, "Person to Impersonate", {"email"}, {"Person to Impersonate Email"}
				    ),
				    // Expand "Approved By" List Column
				    ExpandedApprovedList = Table.ExpandListColumn(ExpandedImpersonateEmail, "Approved By"),
				    // Expand "Approved By" Record Column to "email"
				    ExpandedApprovedEmail = Table.ExpandRecordColumn(
				        ExpandedApprovedList, "Approved By", {"email"}, {"Approved By Email"}
				    ),
				    // Remove unnecessary columns
				    RemovedUnnecessaryColumns = Table.RemoveColumns(
				        ExpandedApprovedEmail,
				        {
				            "Color Tag",
				            "Compliance Asset Id",
				            "ID",
				            "Content Type",
				            "Attachments",
				            "Edit",
				            "Type",
				            "Item Child Count",
				            "Folder Child Count",
				            "Label setting",
				            "Retention label",
				            "Retention label Applied",
				            "Label applied by",
				            "Item is a Record",
				            "App Created By",
				            "App Modified By"
				        }
				    ),
				    // Expand "Created By" List Column
				    ExpandedCreatedByList = Table.ExpandListColumn(RemovedUnnecessaryColumns, "Created By"),
				    // Expand "Created By" Record Column to "email"
				    ExpandedCreatedByEmail = Table.ExpandRecordColumn(
				        ExpandedCreatedByList, "Created By", {"email"}, {"Created By Email"}
				    ),
				    // Expand "Modified By" List Column
				    ExpandedModifiedByList = Table.ExpandListColumn(ExpandedCreatedByEmail, "Modified By"),
				    // Expand "Modified By" Record Column to "email"
				    ExpandedModifiedByEmail = Table.ExpandRecordColumn(
				        ExpandedModifiedByList, "Modified By", {"email"}, {"Modified By Email"}
				    ),
				    // Change data types of specified columns
				    ChangedColumnTypes = Table.TransformColumnTypes(
				        ExpandedModifiedByEmail,
				        {
				            {"Person to Impersonate Email", type text},
				            {"Requester Email", type text},
				            {"Expiry Date", type date},
				            {"Access Reason", type text},
				            {"Approved By Email", type text},
				            {"Approved Date", type date},
				            {"Modified", type date},
				            {"Created", type date},
				            {"Created By Email", type text},
				            {"Modified By Email", type text}
				        }
				    ),
				    // Filtering rows where "Expiry Date" is greater than or equal to today
				    ExpiryDateFilter = Table.SelectRows(ChangedColumnTypes, each [Expiry Date] >= Date.From(DateTime.LocalNow())),
				    // Filter rows where "Report" is the current report
				    ReportFilter = Table.SelectRows(ExpiryDateFilter, each ([Report] = "Kaimahi Payslip Hours"))
				in
				    ReportFilter

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

