)#(tab)e.jobs_id,#(lf)#(tab)#(tab)e.businessUnit_name,#(lf)#(tab)#(tab)e.IntellihrServiceID,#(lf)#(tab)#(tab)CASE #(lf)#(tab)#(tab)#(tab)WHEN psg.gross_name LIKE '%addtional%'#(lf)#(tab)#(tab)#(tab)#(tab)THEN 'Additional Hours'#(lf)#(tab)#(tab)#(tab)ELSE psg.gross_name#(lf)#(tab)#(tab)#(tab)END AS gross_name,#(lf)#(tab)#(tab)ps.pay_period_start_date,#(lf)#(tab)#(tab)ps.pay_period_end_date,#(lf)#(tab)#(tab)ps.pay_packet_type,#(lf)#(tab)#(tab)#(tab)#(tab)psg.gross_summary,#(lf)#(tab)#(tab)TRY_CAST(LEFT(psg.gross_summary, CHARINDEX(' ', psg.gross_summary) - 1) AS DECIMAL(18, 8)) AS numeric_value,#(lf)#(tab)#(tab)CASE #(lf)#(tab)#(tab)#(tab)WHEN psg.gross_summary LIKE '%hours%'#(lf)#(tab)#(tab)#(tab)#(tab)THEN 'hours'#(lf)#(tab)#(tab)#(tab)WHEN psg.gross_summary LIKE '%day%'#(lf)#(tab)#(tab)#(tab)#(tab)THEN 'days'#(lf)#(tab)#(tab)#(tab)WHEN psg.gross_summary LIKE '%weeks%'#(lf)#(tab)#(tab)#(tab)#(tab)THEN 'weeks'#(lf)#(tab)#(tab)#(tab)ELSE 'other'#(lf)#(tab)#(tab)#(tab)END AS unit_type,#(lf)#(tab)#(tab)ROW_NUMBER() OVER (#(lf)#(tab)#(tab)PARTITION BY psg.pay_packet_row_id ORDER BY psg.ODSEffectiveFrom desc#(lf)#(tab)#(tab)) AS duplicateRowID#(lf)#(tab)FROM Datapay.pay_slips_gross psg#(lf)#(tab)JOIN PaySlipData ps ON psg.pay_packet_id = ps.pay_packet_id#(lf)#(tab)JOIN EmployeeData e ON ps.employee_id = e.employee_id#(lf)#(tab)AND ps.pay_period_start_date <= e.PositionENDDate#(lf)#(tab)AND#(tab)ps.pay_period_end_date  >= e.PositionStartDate#(lf)#(tab)WHERE #(lf)#(tab)#(tab) psg.gross_name IN (#(lf)#(tab)#(tab)#(tab)'Addtional Hours',#(lf)#(tab)#(tab)#(tab)'Alternative Holiday Payment',#(lf)#(tab)#(tab)#(tab)'Annual Leave Payment',#(lf)#(tab)#(tab)#(tab)'Annual Leave Payment - Parental Rate',#(lf)#(tab)#(tab)#(tab)'Bereavement Leave Payment',#(lf)#(tab)#(tab)#(tab)'Birthday Leave Payment',#(lf)#(tab)#(tab)#(tab)'COVID-19 Leave Payment',#(lf)#(tab)#(tab)#(tab)'Cultural Contribution Payment',#(lf)#(tab)#(tab)#(tab)'Discretionary Leave Payment',#(lf)#(tab)#(tab)#(tab)'Discret