	column Month = ```
			
			VAR Month1 = MONTH('fact_pay_slips'[pay_period_start_date])
			
			VAR Month2 = MONTH('fact_pay_slips'[pay_period_end_date])
			
			VAR EndMonth1 = EOMONTH('fact_pay_slips'[pay_period_start_date], 0)
			VAR Month1Days = IF(Month1 <> Month2, DATEDIFF('fact_pay_slips'[pay_period_start_date], EndMonth1, DAY), 
			                        DATEDIFF('fact_pay_slips'[pay_period_start_date], 'fact_pay_slips'[pay_period_end_date], DAY))
			
			VAR Month2Days = DAY('fact_pay_slips'[pay_period_end_date])
			
			RETURN
			
			IF(Month1 = Month2, FORMAT(DATE(1,Month1, 1), "MMMM"),
			    IF(Month1Days >= Month2Days, 
			            FORMAT(DATE(1, Month1, 1), "MMMM"), FORMAT(DATE(1,Month2, 1), "MMMM")) )
			```
		dataType: string
		lineageTag: da2a410d-6e4e-4c8e-8273-faa203b21719
		summarizeBy: none
		sortByColumn: Month_No

		changedProperty = DataType

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column Month_No = ```
			
			VAR Month1 = MONTH('fact_pay_slips'[pay_period_start_date])
			
			VAR Month2 = MONTH('fact_pay_slips'[pay_period_end_date])
			
			VAR EndMonth1 = EOMONTH('fact_pay_slips'[pay_period_start_date], 0)
			VAR Month1Days = IF(Month1 <> Month2, DATEDIFF('fact_pay_slips'[pay_period_start_date], EndMonth1, DAY), 
			                        DATEDIFF('fact_pay_slips'[pay_period_start_date], 'fact_pay_slips'[pay_period_end_date], DAY))
			
			VAR Month2Days = DAY('fact_pay_slips'[pay_period_end_date])
			
			RETURN
			
			IF(Month1 = Month2, Month1,
			    IF(Month1Days >= Month2Days, 
			            Month1,Month2 ) )
			```
		formatString: 0
		lineageTag: 7074c0a5-0dca-4f48-948c-89d98a3354b5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

