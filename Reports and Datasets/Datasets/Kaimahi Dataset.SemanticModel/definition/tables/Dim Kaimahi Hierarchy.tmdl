	partition 'Dim Kaimahi Hierarchy' = m
		mode: import
		queryGroup: Dim
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="SELECT#(lf)    [dim_employee_key],#(lf)    [employee_id],#(lf)    [employee_people_leader_business_unit_name_level_1],#(lf)    [employee_people_leader_business_unit_name_level_2],#(lf)    [employee_people_leader_business_unit_name_level_3],#(lf)    [employee_people_leader_business_unit_name_level_4],#(lf)    [employee_people_leader_business_unit_name_level_5],#(lf)    [employee_people_leader_business_unit_name_level_6],#(lf)#(lf)    CASE#(lf)        WHEN [employee_primary_email_address] = [employee_people_leader_email_level_2]#(lf)            THEN [employee_people_leader_person_display_name_level_1]#(lf)#(lf)        WHEN [employee_primary_email_address] = [employee_people_leader_email_level_3]#(lf)            THEN [employee_people_leader_person_display_name_level_2]#(lf)#(lf)        WHEN [employee_primary_email_address] = [employee_people_leader_email_level_4]#(lf)            THEN [employee_people_leader_person_display_name_level_3]#(lf)#(lf)        WHEN [employee_primary_email_address] = [employee_people_leader_email_level_5]#(lf)            THEN [employee_people_leader_person_display_name_level_4]#(lf)#(lf)        WHEN [employee_primary_email_address] = [employee_people_leader_email_level_6]#(lf)            THEN [employee_people_leader_person_display_name_level_5]#(lf)#(lf)        WHEN [employee_primary_email_address] = [employee_people_leader_email_level_7]#(lf)            THEN [employee_people_leader_person_display_name_level_6]#(lf)#(lf)        WHEN [employee_primary_email_address] = [employee_people_leader_email_level_8]#(lf)            THEN [employee_people_leader_person_display_name_level_7]#(lf)#(lf)        WHEN [employee_primary_email_address] = [employee_people_leader_email_level_9]#(lf)            THEN [employee_people_leader_person_display_name_level_8]#(lf)#(lf)        ELSE NULL#(lf)    END AS [Supervisor Name],#(lf)#(lf)    [DWHEffectiveFrom],#(lf)    [DWHEffectiveTo]#(lf)#(lf)FROM [edw].[vw_dim_employee_hierarchy]#(lf)#(lf)WHERE [DWHIsCurrent] = 1#(lf)  AND [dim_employee_key] IS NOT NULL;"]),
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceKaimahi = Text.Replace(columnName, "employee_", "Kaimahi_"),
				            replaceClient = Text.Replace(replaceKaimahi, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, each ApplyNamingConventions(_))
				in
				    #"Transformed Column Names"

	annotation PBI_ResultType = Table

