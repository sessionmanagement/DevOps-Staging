  employee_people_leader_business_unit_name_level_9 AS child_bu#(lf)    FROM [edw].[vw_dim_employee_hierarchy]#(lf)    WHERE DWHIsCurrent = 1#(lf)      AND employee_people_leader_person_display_name_level_9 IS NOT NULL#(lf)),#(lf)Employee_Hierarchy_CTE AS (#(lf)    SELECT DISTINCT #(lf)        h.parent AS [Employee],#(lf)        h.child AS [Leader],#(lf)        h.parent_bu AS [Employee BU],#(lf)        h.child_bu AS [Leader BU],#(lf)        e.dim_employee_key AS [Employee Key],#(lf)        l.dim_employee_key AS [Leader Key],#(lf)        e.employee_id AS [Employee ID],#(lf)        l.employee_id AS [Leader ID],#(lf)        e.employee_primary_email_address AS [Employee Email],#(lf)        l.employee_primary_email_address AS [Leader Email],#(lf)        e.employee_company_name AS [Employee Company],#(lf)        l.employee_company_name AS [Leader Company]#(lf)    FROM hierarchy_cte h#(lf)    LEFT JOIN [edw].[vw_dim_employee_hierarchy] e #(lf)        ON h.parent = e.employee_displayname #(lf)        AND h.parent_bu = e.employee_Business_unit_name#(lf)    LEFT JOIN [edw].[vw_dim_employee_hierarchy] l #(lf)        ON h.child = l.employee_displayname #(lf)        AND h.child_bu = l.employee_Business_unit_name#(lf)    WHERE h.parent <> h.child#(lf)      AND e.DWHIsCurrent = 1#(lf)      AND l.DWHIsCurrent = 1#(lf))#(lf)SELECT DISTINCT#(lf)    [Employee],#(lf)    --[Leader],#(lf)    --[Leader BU],#(lf)    [Employee Key],#(lf)    --[Leader Key],#(lf)    [Employee ID],#(lf)    --[Leader ID],#(lf)    [Employee Email],#(lf)    --[Leader Email],#(lf)    [Employee Company],#(lf)   --, [Leader Company],#(lf)#(tab)ps.dim_service_key AS Dim_Service_Key,#(lf)    [Employee BU]#(lf)FROM Employee_Hierarchy_CTE as h#(lf)LEFT JOIN [edw].[vw_dim_service] ps ON h.[Employee BU] = ps.[service_name]#(lf)#(tab)#(tab)WHERE (ps.[DWHIsCurrent] = 1#(lf)#(tab)#(tab)OR ps.DWHIsCurrent IS NULL)#(lf)#(tab)#(tab)--AND Employee LIKE '%chatterji%'"]),
