	partition 'Den Kaimahi Core Training Progress' = m
		mode: import
		queryGroup: Fact
		source = ```
				let
				    Source = Sql.Database(Server, Database, [Query="-- Updated by GH to filter out part of certifications on courses (as the courses from Inductions are now in this table)#(lf)DECLARE @Today DATE = CAST(((GETUTCDATE() AT TIME ZONE 'UTC') AT TIME ZONE 'New Zealand Standard Time') AS DATE);#(lf)#(lf)-- Latest name per natural id, so renamed items always display their current name instead of splitting into separate history rows#(lf)WITH LatestProgramNames#(lf)AS (#(lf)#(tab)SELECT program_id#(lf)#(tab)#(tab),program_full_name#(lf)#(tab)#(tab),program_short_name#(lf)#(tab)FROM (#(lf)#(tab)#(tab)SELECT program_id#(lf)#(tab)#(tab)#(tab),program_full_name#(lf)#(tab)#(tab)#(tab),program_short_name#(lf)#(tab)#(tab)#(tab),ROW_NUMBER() OVER (#(lf)#(tab)#(tab)#(tab)#(tab)PARTITION BY program_id ORDER BY DWHIsCurrent DESC#(lf)#(tab)#(tab)#(tab)#(tab)#(tab),program_created_date DESC#(lf)#(tab)#(tab)#(tab)#(tab)#(tab),dim_program_key DESC#(lf)#(tab)#(tab)#(tab)#(tab)) AS rn#(lf)#(tab)#(tab)FROM edw.dim_program#(lf)#(tab)#(tab)WHERE DWHDMLOperation <> 'D'#(lf)#(tab)#(tab)) AS x#(lf)#(tab)WHERE rn = 1#(lf)#(tab))#(lf)#(tab),LatestCourseNames#(lf)AS (#(lf)#(tab)SELECT course_id#(lf)#(tab)#(tab),course_full_name#(lf)#(tab)#(tab),course_short_name#(lf)#(tab)FROM (#(lf)#(tab)#(tab)SELECT course_id#(lf)#(tab)#(tab)#(tab),course_full_name#(lf)#(tab)#(tab)#(tab),course_short_name#(lf)#(tab)#(tab)#(tab),ROW_NUMBER() OVER (#(lf)#(tab)#(tab)#(tab)#(tab)PARTITION BY course_id ORDER BY DWHIsCurrent DESC#(lf)#(tab)#(tab)#(tab)#(tab)#(tab),course_created_date DESC#(lf)#(tab)#(tab)#(tab)#(tab)#(tab),dim_course_key DESC#(lf)#(tab)#(tab)#(tab)#(tab)) AS rn#(lf)#(tab)#(tab)FROM edw.dim_course#(lf)#(tab)#(tab)WHERE DWHDMLOperation <> 'D'#(lf)#(tab)#(tab)) AS x#(lf)#(tab)WHERE rn = 1#(lf)#(tab))#(lf)#(tab),LatestCertificationNames#(lf)AS (#(lf)#(tab)SELECT certification_id#(lf)#(tab)#(tab),certification_full_name#(lf)#(tab)#(tab),certification_short_name#(lf)#(tab)FROM (#(lf)#(tab)#(tab)SELECT cert