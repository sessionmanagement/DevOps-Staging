us = 2#(lf)#(tab)#(tab)#(tab)THEN 'In Progress'#(lf)#(tab)#(tab)WHEN TrainingType = 'Certification'#(lf)#(tab)#(tab)#(tab)AND employee_program_exception_status = 1#(lf)#(tab)#(tab)#(tab)AND employee_status = 3#(lf)#(tab)#(tab)#(tab)THEN 'Certified'#(lf)#(tab)#(tab)WHEN TrainingType = 'Certification'#(lf)#(tab)#(tab)#(tab)AND employee_program_exception_status = 2#(lf)#(tab)#(tab)#(tab)AND employee_status = 2#(lf)#(tab)#(tab)#(tab)THEN 'In Progress'#(lf)#(tab)#(tab)WHEN TrainingType = 'Certification'#(lf)#(tab)#(tab)#(tab)AND employee_program_exception_status = 2#(lf)#(tab)#(tab)#(tab)AND employee_status = 4#(lf)#(tab)#(tab)#(tab)THEN 'Overdue'#(lf)#(tab)#(tab)#(tab)#(tab)-- Courses#(lf)#(tab)#(tab)WHEN TrainingType = 'Course'#(lf)#(tab)#(tab)#(tab)AND employee_status = 10#(lf)#(tab)#(tab)#(tab)THEN 'Assigned'#(lf)#(tab)#(tab)WHEN TrainingType = 'Course'#(lf)#(tab)#(tab)#(tab)AND employee_status = 25#(lf)#(tab)#(tab)#(tab)THEN 'In Progress'#(lf)#(tab)#(tab)WHEN TrainingType = 'Course'#(lf)#(tab)#(tab)#(tab)AND employee_status = 50#(lf)#(tab)#(tab)#(tab)THEN 'Completed'#(lf)#(tab)#(tab)WHEN TrainingType = 'Course'#(lf)#(tab)#(tab)#(tab)AND employee_status = 75#(lf)#(tab)#(tab)#(tab)THEN 'Completed'#(lf)#(tab)#(tab)#(tab)#(tab)-- Programs#(lf)#(tab)#(tab)WHEN TrainingType = 'Program'#(lf)#(tab)#(tab)#(tab)AND employee_status = 0#(lf)#(tab)#(tab)#(tab)THEN 'Not Started'#(lf)#(tab)#(tab)WHEN TrainingType = 'Program'#(lf)#(tab)#(tab)#(tab)AND employee_status = 1#(lf)#(tab)#(tab)#(tab)THEN 'Completed'#(lf)#(tab)#(tab)ELSE NULL#(lf)#(tab)#(tab)END AS TrainingStatus#(lf)#(tab),CASE #(lf)#(tab)#(tab)-- Certification Renewal Status (other training doesn't renew)#(lf)#(tab)#(tab)WHEN TrainingType = 'Certification'#(lf)#(tab)#(tab)#(tab)AND employee_program_exception_status = 0#(lf)#(tab)#(tab)#(tab)THEN 'Not Due For Renewal'#(lf)#(tab)#(tab)WHEN TrainingType = 'Certification'#(lf)#(tab)#(tab)#(tab)AND employee_program_exception_status = 1#(lf)#(tab)#(tab)#(tab)THEN 'Expiring Soon'#(lf)#(tab)#(tab)WHEN TrainingType = 'Certification'#(lf)#(tab)#(tab)#(tab)AND employee_program_exception_status = 2#(lf)#(tab)#(tab)#(tab)THEN 'Renewal Expired'#(lf)#(tab)#(tab)ELSE NULL#(lf)#(tab)#(tab)END AS RenewalFilter#(lf)#(tab),CASE #(lf)#(tab)#(tab)WHEN (#(lf)#(tab)#(tab)#(tab)#(tab)CAST(completed_date AS DATE) IN (#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)'1970-01-01'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab),'2999-12-31'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab),'1900-01-01'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab))#(lf)#(tab)#(tab)#(tab)#(tab)OR completed_date IS NULL#(lf)#(tab)#(tab)#(tab)#(tab))#(lf)#(tab)#(tab)#(tab)AND CONVERT(DATE, due_date, 103) < @Today#(lf)#(tab)#(tab)#(tab)AND CONVERT(DATE, due_date, 103) NOT IN (#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)'1970-01-01'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab),'2999-12-31'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab),'1900-01-01'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab))#(lf)#(tab)#(tab)#(tab)THEN 'Overdue'#(lf)#(tab)#(tab)WHEN (#(lf)#(tab)#(tab)#(tab)#(tab)CAST(completed_date AS DATE) IN (#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)'1970-01-01'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab),'2999-12-31'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab),'1900-01-01'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab))#(lf)#(tab)#(tab)#(tab)#(tab)OR completed_date IS NULL#(lf)#(tab)#(tab)#(tab)#(tab))#(lf)#(tab)#(tab)#(tab)AND (#(lf)#(tab)#(tab)#(tab)#(tab)due_date IN ('1970-01-01')#(lf)#(tab)#(tab)#(tab)#(tab)OR due_date IS NULL#(lf)#(tab)#(tab)#(tab)#(tab)OR CONVERT(DATE, due_date, 103) >= @Today#(lf)#(tab)#(tab)#(tab)#(tab))#(lf)#(tab)#(tab)#(tab)THEN 'Not Due'#(lf)#(tab)#(tab)ELSE 'Completed'#(lf)#(tab)#(tab)END AS TrainingOverdueStatus#(lf)#(tab),CASE #(lf)#(tab)#(tab)WHEN (#(lf)#(tab)#(tab)#(tab)#(tab)CAST(due_date AS DATE) IN (#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)'1970-01-01'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab),'2999-12-31'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab),'1900-01-01'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab))#(lf)#(tab)#(tab)#(tab)#(tab)OR due_date IS NULL#(lf)#(tab)#(tab)#(tab)#(tab))#(lf)#(tab)#(tab)#(tab)THEN 'No Due Date Set'#(lf)#(tab)#(tab)    WHEN due_date <= @Today#(lf)#(tab)#(tab)#(tab)THEN 'Past Due Date: ' + CONVERT(VARCHAR(10), due_date, 103)#(lf)#(tab)#(tab)ELSE 'Due Date: ' + CONVERT(VARCHAR(10), due_date, 103)#(lf)#(tab)#(tab)END AS OverdueTooltipStatus#(lf)FROM CombinedTrainingData#(lf)"]),
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceKaimahi = Text.Replace(columnName, "employee_", "Kaimahi_"),
				            replaceClient = Text.Replace(replaceKaimahi, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transform Column Names" = Table.TransformColumnNames(
				        Source, each ApplyNamingConventions(_)
				    ),
				    #"Added Conditional Column" = Table.AddColumn(
				    #"Transform Column Names", 
				    "Completion Flag", 
				    each 
				        if [Trainingtype] = "Program" and [Kaimahi Status] = 1 then "Completed" 
				        else if [Trainingtype] = "Course" and [Kaimahi Status] = 50 then "Completed" 
				        else if [Trainingtype] = "Course" and [Kaimahi Status] = 75 then "Completed" 
				        else if [Trainingtype] = "Certification" and [Kaimahi Status] = 3 then "Completed" 
				        else "Not Completed"
				),
				    #"Merged Queries" = Table.NestedJoin(
				        #"Transform Column Names",
				        {"Kaimahi ID"},
				        Table.Buffer(#"Employee Service Mapping"),
				        {"Employee ID"},
				        "Employee Service Mapping",
				        JoinKind.LeftOuter
				    ),
				    #"Expanded Employee Service Mapping" = Table.ExpandTableColumn(
				        #"Merged Queries",
				        "Employee Service Mapping",
				        {"Employee Company", "Dim Service KEY"},
				        {"Employee Service Mapping.Employee Company", "Employee Service Mapping.Dim Service KEY"}
				    ),
				    // Step to change the type of the relevant columns
				    #"Changed Type" = Table.TransformColumnTypes(#"Expanded Employee Service Mapping", {
				        {"Kaimahi Program Assigned Date", type date}, 
				        {"Kaimahi Program Window Opens Date", type date}, 
				        {"Completed Date", type date}, 
				        {"Kaimahi Certification Expiry Date", type date}, 
				        {"Due Date", type date}
				    }),
				    
				    // Conditional columns for display purposes
				    #"Added Conditional Column1" = Table.AddColumn(#"Changed Type", "Window Opens Date Display", each if [Kaimahi Program Window Opens Date] = #date(1900, 1, 1) then null else [Kaimahi Program Window Opens Date]),
				    
				    // Adjust Completed Date to account for both 2999-12-31 and 1970-01-01
				    #"Added Conditional Column2" = Table.AddColumn(#"Added Conditional Column1", "Completed Date Display", each if [Completed Date] = #date(2999, 12, 31) or [Completed Date] = #date(1970, 1, 1) or [Completed Date] = #date(1900, 1, 1) then null else [Completed Date]),
				    
				    #"Added Conditional Column3" = Table.AddColumn(#"Added Conditional Column2", "Due Date Display", each if [Due Date] = #datetime(1900, 1, 1, 0, 0, 0) or [Due Date] = #date(1970, 1, 1) or [Due Date] = #date(2999, 12, 31) then null else [Due Date]),
				    #"Added Conditional Column4" = Table.AddColumn(#"Added Conditional Column3", "Expiry Date Display", each if [Kaimahi Certification Expiry Date] = #date(1900, 1, 1) then null else [Kaimahi Certification Expiry Date])
				in
				    #"Added Conditional Column4"
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Exception

