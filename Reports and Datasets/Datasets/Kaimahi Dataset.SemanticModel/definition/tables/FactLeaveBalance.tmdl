	partition FactLeaveBalance = m
		mode: import
		queryGroup: Fact
		source = ```
				let
				    Source = Sql.Database(Server, Database, [Query="#(lf)#(lf)    WITH LeaveDetail AS (#(lf)        SELECT#(lf)        fel.employee_id,#(lf)        fel.dim_employee_key,#(lf)        fel.dim_business_unit_hierarchy_key,#(lf)        dbh.business_unit_name,#(lf)        ds.dim_service_key,#(lf)        de.employee_name                            AS Kaimahi,#(lf)        dlt.leave_type_id,#(lf)        dlt.leave_type_name                         AS leave_name,#(lf)        dd_eff.calendar_date                        AS effective_date,#(lf)        fel.employee_leave_unit                     AS unit,#(lf)        fel.employee_leave_entitlement              AS entitlement,#(lf)        fel.employee_leave_accrual                  AS accrual,#(lf)        fel.employee_leave_taken                    AS taken,#(lf)        fel.employee_leave_balance                  AS balance,#(lf)        fel.employee_leave_balance - fel.employee_leave_accrual AS [Entitled Leave Balance],#(lf)        dd_ann.calendar_date                        AS Anniversary,#(lf)        fel.employee_leave_next_entitlement_hours   AS next_entitlement,#(lf)        fel.datapay_company_id                      AS company_id,#(lf)        -- Hourly Balance: EDW stores the source-computed hours balance (handles Weeks & Days),#(lf)        -- replacing the DAX SWITCH on standard_hours_per_week / hours-per-day.#(lf)        CASE #(lf)    WHEN de.employee_work_type LIKE '%casual%' THEN 0#(lf)    ELSE fel.employee_leave_balance_hours#(lf)END AS [Hourly Balance],#(lf)        -- Hourly Entitled Balance = (balance - accrual) in hours#(lf)        fel.employee_leave_balance_hours - fel.employee_leave_accrual_hours AS [Hourly Entitled Balance],#(lf)#(lf)        -- AccrualAtAnnivesary = (next_entitlement - accrual) in hours#(lf)        fel.employee_leave_next_entitlement_hours - fel.employee_leave_accrual_hours AS [AccrualAtAnnivesary],#(lf)#(lf)        -- DaysUntilAnniversary = DATEDIFF(TODAY(NZ), anniversary, DAY)#(lf)        DATEDIFF(#(lf)            DAY,#(lf)            CAST(SYSDATETIMEOFFSET() AT TIME ZONE 'New Zealand Standard Time' AS DATE),#(lf)            dd_ann.calendar_date#(lf)        ) AS [DaysUntilAnniversary],#(lf)#(lf)        -- DaysUntilEOFY = DATEDIFF(TODAY(NZ), financial_last_day_of_year_date, DAY)#(lf)        DATEDIFF(#(lf)            DAY,#(lf)            CAST(SYSDATETIMEOFFSET() AT TIME ZONE 'New Zealand Standard Time' AS DATE),#(lf)            dd_eff.financial_last_day_of_year_date#(lf)        ) AS [DaysUntilEOFY]#(lf)    FROM edw.fact_employee_leave fel#(lf)    INNER JOIN edw.dim_leave_type dlt#(lf)        ON dlt.dim_leave_type_key = fel.dim_leave_type_key#(lf)       AND dlt.DWHDMLOperation <> 'D'#(lf)       #(lf)    LEFT JOIN edw.dim_employee de#(lf)        ON de.employee_id = fel.employee_id#(lf)       AND de.DWHIsCurrent = 1#(lf)       AND de.DWHDMLOperation <> 'D'#(lf)       AND fel.DWHIsCurrent = 1#(lf)       AND fel.DWHDMLOperation <> 'd'#(lf)    LEFT JOIN edw.dim_date dd_eff#(lf)        ON dd_eff.dim_date_key = fel.employee_leave_effective_date_key#(lf)    LEFT JOIN edw.dim_date dd_ann#(lf)        ON dd_ann.dim_date_key = fel.employee_leave_anniversary_date_key#(lf)    LEFT JOIN edw.dim_business_unit_hierarchy dbh#(lf)        ON dbh.dim_business_unit_hierarchy_key = fel.dim_business_unit_hierarchy_key#(lf)       AND fel.DWHIsCurrent = 1#(lf)       AND fel.DWHDMLOperation <> 'D'#(lf)       AND dbh.DWHDMLOperation <> 'D'#(lf)    LEFT JOIN edw.vw_dim_service ds#(lf)        ON ds.intellihr_service_id = dbh.business_unit_id#(lf)       AND ds.DWHIsCurrent = 1#(lf)       AND ds.DWHDMLOperation <> 'D'#(lf)       AND ds.dim_company_key <> 5#(lf)       AND dbh.DWHDMLOperation <> 'D'#(lf)    WHERE fel.DWHIsCurrent = 1#(lf)      AND fel.DWHDMLOperation <> 'D'#(lf)     AND (de.employee_concurrent_job IS NULL #(lf)    OR de.employee_concurrent_job <> 'BOARD MEMBER')#(lf)      AND de.dim_employee_key NOT IN (-1, 0, 1)#(lf)    AND de.employee_work_type <> 'Agency'#(lf)    AND employee_name NOT LIKE '%TEST%'#(lf)    AND de.employee_id < 999999 #(lf)#(lf)),#(lf)TotalLeave AS (#(lf)    SELECT#(lf)        employee_id,#(lf)        SUM([Hourly Balance]) AS [Total Leave]#(lf)    FROM LeaveDetail#(lf)    WHERE leave_name IN ('Annual Leave', 'Long Service Leave', 'Alternative Holidays')#(lf)    GROUP BY employee_id#(lf))#(lf)SELECT DISTINCT#(lf)    ld.employee_id,#(lf)    ld.Kaimahi,#(lf)    ld.leave_type_id,#(lf)    ld.leave_name,#(lf)    ld.effective_date,#(lf)    ld.unit,#(lf)    ld.entitlement,#(lf)    ld.accrual,#(lf)    ld.taken,#(lf)    ld.balance,#(lf)    ld.[Entitled Leave Balance],#(lf)    ld.Anniversary,#(lf)    ld.next_entitlement,#(lf)    ld.company_id,#(lf)    ld.dim_business_unit_hierarchy_key,#(lf)    ld.dim_employee_key,#(lf)    ld.dim_service_key,#(lf)    ld.[Hourly Balance],#(lf)    ld.[Hourly Entitled Balance],#(lf)    ld.[AccrualAtAnnivesary],#(lf)    ld.[DaysUntilAnniversary],#(lf)    ld.[DaysUntilEOFY],#(lf)#(lf)    -- AccrualAtEOFY = AccrualAtAnnivesary / DaysUntilAnniversary * DaysUntilEOFY#(lf)    ld.[AccrualAtAnnivesary]#(lf)        / NULLIF(ld.[DaysUntilAnniversary], 0)#(lf)        * ld.[DaysUntilEOFY]                        AS [AccrualAtEOFY],#(lf)#(lf)    tl.[Total Leave],#(lf)#(lf)    -- Total Leave Group (bucketing)#(lf)    CASE#(lf)        WHEN tl.[Total Leave] >= 0   AND tl.[Total Leave] <= 50  THEN '0-50 Hours'#(lf)        WHEN tl.[Total Leave] > 50   AND tl.[Total Leave] <= 100 THEN '51-100 Hours'#(lf)        WHEN tl.[Total Leave] > 100  AND tl.[Total Leave] <= 130 THEN '101-130 Hours'#(lf)        WHEN tl.[Total Leave] > 130  AND tl.[Total Leave] <= 160 THEN '131-160 Hours'#(lf)        WHEN tl.[Total Leave] > 160  AND tl.[Total Leave] <= 200 THEN '161-200 Hours'#(lf)        WHEN tl.[Total Leave] > 200                              THEN '200+ Hours'#(lf)    END                                             AS [Total Leave Group],#(lf)     -- Total Leave Group (for ordering)#(lf)    CASE#(lf)        WHEN tl.[Total Leave] >= 0   AND tl.[Total Leave] <= 50  THEN 1#(lf)        WHEN tl.[Total Leave] > 50   AND tl.[Total Leave] <= 100 THEN 2#(lf)        WHEN tl.[Total Leave] > 100  AND tl.[Total Leave] <= 130 THEN 3#(lf)        WHEN tl.[Total Leave] > 130  AND tl.[Total Leave] <= 160 THEN 4#(lf)        WHEN tl.[Total Leave] > 160  AND tl.[Total Leave] <= 200 THEN 5#(lf)        WHEN tl.[Total Leave] > 200                              THEN 6#(lf)    END                                             AS [Total Leave Group Number]#(lf)FROM LeaveDetail ld#(lf)LEFT JOIN TotalLeave tl#(lf)    ON tl.employee_id = ld.employee_id#(lf)    #(lf)"]),
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceKaimahi = Text.Replace(columnName, "employee_", "Kaimahi_"),
				            replaceClient = Text.Replace(replaceKaimahi, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, " Id", " ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, each ApplyNamingConventions(_)),
				    #"Added Conditional Column" = Table.AddColumn(
				    #"Transformed Column Names",
				    "New Key",
				    each
				         if 
				        //[Kaimahi] = "Laura Ashton" then 100
				        //else if 
				        [Kaimahi ID] = 6051 then 270
				       // else if [Kaimahi ID] = 603191 then 262
				        // else if List.Contains(
				        //     {602691, 601804, 602590, 602360, 600047, 600179, 602133, 7859, 601642, 601662},
				        //     [Kaimahi ID]
				        // ) then 116
				        // else if [Dim Business Unit Hierarchy KEY] = 120 then 100
				        // else if [Dim Business Unit Hierarchy KEY] = 290 then 161
				        else [Dim Business Unit Hierarchy KEY],
				    Int64.Type
				),
				    #"Removed Columns" = Table.RemoveColumns(#"Added Conditional Column",{"Dim Business Unit Hierarchy KEY"}),
				    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns",{{"New Key", "Dim Business Unit Hierarchy KEY"}})
				in
				    #"Renamed Columns"
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

