	column DWHiscurrent
		dataType: int64
		formatString: 0
		lineageTag: f44d29e8-82f1-471f-824b-77d22e4e4432
		summarizeBy: sum
		sourceColumn: DWHiscurrent

		annotation SummarizationSetBy = Automatic

	partition 'Fact Jobs' = m
		mode: import
		queryGroup: Fact
		source = ```
				let
				    Source = Sql.Database(Server, Database, [Query="WITH CurrentEmployee AS (#(lf)    SELECT#(lf)        de.*,#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY de.employee_id#(lf)            ORDER BY#(lf)                ISNULL(de.employee_is_primary_Job_flag, 0) DESC,#(lf)                de.DWHEffectiveFrom DESC,#(lf)                de.dim_employee_key DESC#(lf)        ) AS rn#(lf)    FROM edw.vw_dim_employee de#(lf)    WHERE de.DWHIsCurrent = 1#(lf)      AND de.DWHDMLOperation <> 'D'#(lf)      AND de.dim_employee_key NOT IN (-1, 0, 1)#(lf)),#(lf)#(lf)CurrentHierarchy AS (#(lf)    SELECT#(lf)        deh.*,#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY deh.employee_id#(lf)            ORDER BY deh.DWHEffectiveFrom DESC#(lf)        ) AS rn#(lf)    FROM edw.vw_dim_employee_hierarchy deh#(lf)    WHERE deh.DWHIsCurrent = 1#(lf)      AND deh.DWHDMLOperation <> 'D'#(lf)),#(lf)#(lf)BaseData AS (#(lf)    SELECT#(lf)        fer.dim_employee_key,#(lf)#(lf)        de.employee_id,#(lf)        de.employee_name,#(lf)        de.employee_company_name,#(lf)        de.employee_company_start_date,#(lf)        de.employee_company_end_date,#(lf)        de.employee_gender,#(lf)        #(lf)        de.employee_age_in_year,#(lf)        de.employee_work_type,#(lf)        de.employee_work_class,#(lf)        de.employee_job_name,#(lf)        de.employee_employment_status,#(lf)        de.employee_is_primary_Job_flag,#(lf)        de.DWHSourceSystem,#(lf)        de.DWHIsCurrent,#(lf)        de.primary_ethnicity_group,#(lf)        COALESCE(NULLIF(LTRIM(RTRIM(de.primary_ethnicity_section)), ''), 'Unknown')#(lf)    AS primary_ethnicity_section,#(lf)#(lf)        deh.employee_Business_unit_name,#(lf)#(lf)        de.extended_leave_start_date,#(lf)        de.extended_leave_end_date,#(lf)#(lf)        de.employee_people_manager_id AS supervisorPerson_id,#(lf)        de.employee_start_date AS startDate,#(lf)        de.employee_end_date AS endDate,#(lf)#(lf)        dln.intelliHR_location_name AS location_name,#(lf)#(lf)        /* Pay Grade & Compensation Details */#(lf)        fer.fact_employee_remuneration_pay_grade_name#(lf)            AS payGrade_name,#(lf)#(lf)        fer.fact_employee_remuneration_pay_grade_code#(lf)            AS payGrade_code,#(lf)#(lf)        fer.fact_employee_remuneration_schedule_base_hourly_rate#(lf)            AS base_hourly_rate,#(lf)#(lf)        fer.fact_employee_remuneration_schedule_base_annual_salary#(lf)            AS base_annual_salary,#(lf)#(lf)        fer.fact_employee_remuneration_schedule_annual_package#(lf)            AS annual_package,#(lf)#(lf)        fer.fact_employee_remuneration_schedule_hours_per_cycle#(lf)            AS hours_per_cycle,#(lf)#(lf)        fer.fact_employee_remuneration_schedule_pay_cycle#(lf)            AS pay_cycle,#(lf)#(lf)        /* Calculated Hourly Rate */#(lf)    CASE#(lf)    WHEN fer.fact_employee_remuneration_primary_job_indicator = 0#(lf)        THEN 0#(lf)#(lf)    WHEN fer.fact_employee_remuneration_schedule_type#(lf) = 'Hourly Rate'#(lf)        THEN fer.fact_employee_remuneration_schedule_base_hourly_rate#(lf)#(lf)    WHEN fer.fact_employee_remuneration_schedule_base_annual_salary <> 0#(lf)        THEN ROUND(#(lf)            fer.fact_employee_remuneration_schedule_base_annual_salary / 2080.0,#(lf)            2#(lf)        )#(lf)#(lf)    ELSE fer.fact_employee_remuneration_schedule_base_hourly_rate#(lf)END#(lf)            --fer.fact_employee_remuneration_schedule_base_hourly_rate,#(lf)            --CASE #(lf)            --    WHEN NULLIF(fer.fact_employee_remuneration_fte, 0) IS NOT NULL #(lf)            --     AND fer.fact_employee_remuneration_schedule_base_annual_salary > 0#(lf)            --    THEN ROUND(fer.fact_employee_remuneration_schedule_base_annual_salary / (2080.0 * fer.fact_employee_remuneration_fte), 2)#(lf)                #(lf)            --    WHEN fer.fact_employee_remuneration_schedule_base_annual_salary > 0#(lf)            --    THEN ROUND(fer.fact_employee_remuneration_schedule_base_annual_salary / 2080.0, 2)#(lf)           -- END#(lf)         AS calculated_hourly_rate,#(lf)#(lf)        fer.fact_employee_remuneration_businessunit_id#(lf)            AS businessUnit_id,#(lf)#(lf)        fer.dim_service_key,#(lf)#(lf)        fer.fact_employee_remuneration_businessentity_id#(lf)            AS businessEntity_id,#(lf)#(lf)        fer.fact_employee_remuneration_work_type#(lf)            AS work_Type,#(lf)#(lf)        fer.fact_employee_remuneration_primary_job_indicator#(lf)            AS isPrimaryJob,#(lf)#(lf)        fer.fact_employee_remuneration_job_status#(lf)            AS job_Status,#(lf)#(lf)        fer.fact_employee_remuneration_job_title#(lf)            AS Job_Title,#(lf)#(lf)        fer.fact_employee_remuneration_fte#(lf)            AS fte,#(lf)#(lf)        fer.fact_employee_remuneration_company_startdate#(lf)            AS companyStartDate,#(lf)#(lf)        fer.fact_employee_remuneration_company_enddate#(lf)            AS companyEndDate,#(lf)#(lf)        fer.fact_employee_remuneration_position_startdate#(lf)            AS positionStartDate,#(lf)#(lf)        /* Active Status */#(lf)        CASE#(lf)            WHEN fer.fact_employee_remuneration_company_enddate IS NULL#(lf)              OR fer.fact_employee_remuneration_company_enddate > CAST(GETDATE() AS DATE)#(lf)                THEN 'Active'#(lf)            ELSE 'Not Active'#(lf)        END AS ActiveStatus,#(lf)#(lf)        /* FTE Type */#(lf)        CASE#(lf)            WHEN fer.fact_employee_remuneration_fte > 0.99#(lf)                THEN 'Full Time'#(lf)            ELSE 'Part Time'#(lf)        END AS FTE_Type,#(lf)#(lf)        /* Tenure Days */#(lf)        DATEDIFF(#(lf)            DAY,#(lf)            fer.fact_employee_remuneration_company_startdate,#(lf)            COALESCE(#(lf)                fer.fact_employee_remuneration_company_enddate,#(lf)                CAST(GETDATE() AS DATE)#(lf)            )#(lf)        ) AS Tenure_Days,#(lf)#(lf)        /* Replacement for old IntelliHR Index */#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY fer.fact_employee_remuneration_employee_number#(lf)            ORDER BY#(lf)                fer.fact_employee_remuneration_position_startdate,#(lf)                fer.fact_employee_remuneration_company_startdate,#(lf)                fer.fact_employee_remuneration_company_enddate,#(lf)                fer.fact_employee_remuneration_key#(lf)        ) AS JobIndex#(lf)#(lf)    FROM edw.fact_employee_remuneration fer#(lf)#(lf)    LEFT JOIN CurrentEmployee de#(lf)        ON de.employee_id =#(lf)           fer.fact_employee_remuneration_employee_number#(lf)       AND de.rn = 1#(lf)#(lf)    LEFT JOIN CurrentHierarchy deh#(lf)        ON deh.employee_id = de.employee_id#(lf)       AND deh.rn = 1#(lf)#(lf)    LEFT JOIN edw.dim_location_new dln#(lf)        ON dln.dim_location_key = fer.dim_location_key#(lf)       AND dln.DWHIsCurrent = 1#(lf)       AND dln.DWHDMLOperation <> 'D'#(lf)#(lf)    WHERE fer.DWHIsCurrent = 1#(lf)      AND fer.DWHDMLOperation <> 'D'#(lf)      AND fer.dim_employee_key > 1#(lf)),#(lf)#(lf)RankedData AS (#(lf)    SELECT#(lf)        b.*,#(lf)#(lf)        COUNT(*) OVER (#(lf)            PARTITION BY b.employee_id#(lf)            ORDER BY b.JobIndex#(lf)            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW#(lf)        ) AS LatestJobRank,#(lf)#(lf)        SUM(#(lf)            CASE#(lf)                WHEN b.ActiveStatus = 'Not Active' THEN 1#(lf)                ELSE 0#(lf)            END#(lf)        ) OVER (#(lf)            PARTITION BY b.employee_id#(lf)            ORDER BY b.JobIndex#(lf)            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW#(lf)        ) AS InactiveJobRank#(lf)#(lf)    FROM BaseData b#(lf)),#(lf)#(lf)CalculatedData AS (#(lf)    SELECT#(lf)        r.*,#(lf)#(lf)        CASE#(lf)            WHEN r.job_Status = 'Active'#(lf)             AND r.ActiveStatus = 'Active'#(lf)                THEN 0#(lf)            ELSE r.InactiveJobRank#(lf)        END AS NewRank,#(lf)#(lf)        CEILING(r.Tenure_Days / 30.0) - 1#(lf)            AS Tenure_Months,#(lf)#(lf)        r.Tenure_Days / 365.0#(lf)            AS Tenure_Years#(lf)#(lf)    FROM RankedData r#(lf))#(lf)#(lf)SELECT#(lf)    dim_employee_key,#(lf)    dim_service_key,#(lf)    employee_id,#(lf)    employee_name,#(lf)    employee_company_name,#(lf)    employee_company_start_date,#(lf)    employee_company_end_date,#(lf)    employee_gender,#(lf)    #(lf)    employee_age_in_year,#(lf)    employee_work_type,#(lf)    employee_work_class,#(lf)    employee_job_name,#(lf)    employee_employment_status,#(lf)    employee_is_primary_Job_flag,#(lf)   #(lf)    primary_ethnicity_group,#(lf)    primary_ethnicity_section,#(lf)    employee_Business_unit_name,#(lf)#(lf)    extended_leave_start_date,#(lf)    extended_leave_end_date,#(lf)    supervisorPerson_id,#(lf)    startDate,#(lf)    endDate,#(lf)#(lf)    location_name,#(lf)    payGrade_name,#(lf)    payGrade_code,#(lf)   -- base_hourly_rate,#(lf)   -- base_annual_salary,#(lf)   -- annual_package,#(lf)    hours_per_cycle,#(lf)    pay_cycle,#(lf)    calculated_hourly_rate,#(lf)#(lf)    businessUnit_id,#(lf)    businessEntity_id,#(lf)    work_Type,#(lf)    isPrimaryJob,#(lf)    job_Status,#(lf)    Job_Title,#(lf)    fte,#(lf)    companyStartDate,#(lf)    companyEndDate,#(lf)    positionStartDate,#(lf)    DWHiscurrent,#(lf)    ActiveStatus,#(lf)    FTE_Type,#(lf)    LatestJobRank,#(lf)    NewRank,#(lf)    Tenure_Days,#(lf)    Tenure_Months,#(lf)    Tenure_Years,#(lf)#(lf)    CASE#(lf)        WHEN Tenure_Months < 0   THEN ' Haven''t Started'#(lf)        WHEN Tenure_Months < 12  THEN ' 0-1 Year'#(lf)        WHEN Tenure_Months < 24  THEN ' 1-2 Years'#(lf)        WHEN Tenure_Months < 36  THEN ' 2-3 Years'#(lf)        WHEN Tenure_Months < 60  THEN ' 3-5 Years'#(lf)        WHEN Tenure_Months < 120 THEN ' 5-10 Years'#(lf)        WHEN Tenure_Months < 180 THEN '10-15 Years'#(lf)        WHEN Tenure_Months < 240 THEN '15-20 Years'#(lf)        ELSE '20+ Years'#(lf)    END AS [Tenure_Bins]#(lf)#(lf)FROM CalculatedData#(lf)"]),
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceKaimahi = Text.Replace(columnName, "employee_", "Kaimahi_"),
				            replaceClient = Text.Replace(replaceKaimahi, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHisCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, " Id", " ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, each ApplyNamingConventions(_)),
				    #"Added Custom" = Table.AddColumn(
				        #"Transformed Column Names",
				        "Active Staff Flag",
				        each
				            if
				                [Kaimahi Name] <> "Test Employee" 
				                and [Kaimahi Work Type] <> "Unpaid"
				                and [DWHiscurrent] = 1
				                and ([Kaimahi Employment Status] = "Current Staff" or [Kaimahi Employment Status] = "Exiting Staff")
				            then
				                1
				            else
				                0
				    ),
				    #"Renamed Columns" = Table.RenameColumns(#"Added Custom", {{"Active Staff Flag", "Kaimahi is Active Flag"}}),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Renamed Columns", {{"Kaimahi is Active Flag", Int64.Type}}),
				    #"Inserted Merged Column" = Table.AddColumn(#"Changed Type1", "Employee Company Key", each Text.Combine({[Kaimahi Company Name], Text.From([Kaimahi ID], "en-NZ")}, "-"), type text),
				    #"Added Kaimahi Started within 3 months" = Table.AddColumn(
				        #"Inserted Merged Column",
				        "Kaimahi Started within 3 months",
				        each if [Kaimahi Company Start Date] <> null and Date.IsInPreviousNMonths([Kaimahi Company Start Date], 3) then 1 else 0,
				        Int64.Type
				    ),
				    #"Renamed Columns1" = Table.RenameColumns(#"Added Kaimahi Started within 3 months",{{"Kaimahi Age In Year", "Age"}}),
				    #"Inserted Range" = Table.AddColumn(#"Renamed Columns1", "Age Group", each 
				    let
				        age = [Age],
				        rangeSize = 10,
				        offset = 5,
				        inclusive = true,
				        group = 
				            if age = null then "Not Set"
				            else if age < 25 then "<25"
				            else if age >= 75 then "75+"
				            else 
				                let
				                    rangeIndex = Number.RoundDown((age - offset) / rangeSize),
				                    groupStart = rangeIndex * rangeSize + offset,
				                    groupEnd = (rangeIndex + 1) * rangeSize + offset - (if inclusive then 1 else 0)
				                in
				                    Text.From(groupStart, "en-NZ") & "-" & Text.From(groupEnd, "en-NZ")
				    in
				        group,
				    type text),
				    #"Changed Type" = Table.TransformColumnTypes(#"Inserted Range",{{"Tenure Days", Int64.Type}})
				in
				    #"Changed Type"
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

