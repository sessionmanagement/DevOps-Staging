	partition DimPayGrades = m
		mode: import
		queryGroup: Dim
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="    SELECT#(lf)      DISTINCT#(lf)        fer.fact_employee_remuneration_pay_grade_name#(lf)            AS payGrade_name,#(lf)#(lf)        fer.fact_employee_remuneration_pay_grade_code#(lf)            AS code#(lf)          --  fact_employee_remuneration_job_status#(lf)            #(lf)#(lf)     #(lf)#(lf)#(lf)    FROM edw.fact_employee_remuneration fer#(lf)#(lf)    WHERE fer.DWHIsCurrent = 1#(lf)      AND fer.DWHDMLOperation <> 'D'#(lf)      AND fer.dim_employee_key > 1#(lf)      AND fact_employee_remuneration_job_status IN ('Current Job', 'Ending Job')"]),
				    #"Duplicated Column" = Table.DuplicateColumn(Source, "code", "code - Copy"),
				    #"Split Column by Delimiter" = Table.SplitColumn(#"Duplicated Column", "code - Copy", Splitter.SplitTextByDelimiter("_", QuoteStyle.None), {"code - Copy.1", "code - Copy.2", "code - Copy.3"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Split Column by Delimiter",{{"code - Copy.1", type text}, {"code - Copy.2", type text}, {"code - Copy.3", type text}}),
				    #"Renamed Columns" = Table.RenameColumns(#"Changed Type",{{"code - Copy.1", "Job Family"}, {"code - Copy.2", "Grade"}, {"code - Copy.3", "Step"}}),
				    #"Replaced Value" = Table.ReplaceValue(#"Renamed Columns",null,"No Pay Grade",Replacer.ReplaceValue,{"Grade"})
				in
				    #"Replaced Value"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

