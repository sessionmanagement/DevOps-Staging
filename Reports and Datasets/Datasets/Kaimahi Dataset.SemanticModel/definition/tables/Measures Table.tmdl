	measure NewFiltersApplied =
			
			VAR __LeaveTypesCount = IF(ISFILTERED(FactLeaveBalance[Leave Name]), COUNTROWS(VALUES(FactLeaveBalance[Leave Name])), 0)
			VAR __LeaveType = IF(__LeaveTypesCount > 0, "| LEAVE TYPES CHOSEN: " & CONCATENATEX(FILTERS(FactLeaveBalance[Leave Name]), FactLeaveBalance[Leave Name], ", "), BLANK())
			
			VAR __BusinessEntityCount = IF(ISFILTERED('Dim Service Company Mapping'[Company Name]), COUNTROWS(VALUES('Dim Service Company Mapping'[Company Name])), 0)
			VAR __BusinessEntity = IF(__BusinessEntityCount > 0, "| BUSINESS ENTITIES CHOSEN: " & CONCATENATEX(FILTERS('Dim Service Company Mapping'[Company Name]), 'Dim Service Company Mapping'[Company Name], ", "), BLANK())
			
			VAR __KaimahiNames = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES('Dim Kaimahi'[Kaimahi Name]), NOT(ISBLANK('Dim Kaimahi'[Kaimahi Name]))), 'Dim Kaimahi'[Kaimahi Name], ASC),
			    "KaimahiName_Display", 'Dim Kaimahi'[Kaimahi Name]
			)
			VAR __KaimahiCount = IF(ISFILTERED('Dim Kaimahi'[Kaimahi Name]), COUNTROWS(VALUES('Dim Kaimahi'[Kaimahi Name])), 0)
			
			VAR __ParentAreas = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES('Dim Business Unit Hierarchy'[Business Unit Hierarchy Level1 Name]), NOT(ISBLANK('Dim Business Unit Hierarchy'[Business Unit Hierarchy Level1 Name]))), 'Dim Business Unit Hierarchy'[Business Unit Hierarchy Level1 Name], ASC),
			    "AreaParentName_display", 'Dim Business Unit Hierarchy'[Business Unit Hierarchy Level1 Name]
			)
			VAR __ParentAreasCount = IF(ISFILTERED('Dim Business Unit Hierarchy'[Business Unit Hierarchy Level1 Name]), COUNTROWS(VALUES('Dim Business Unit Hierarchy'[Business Unit Hierarchy Level1 Name])), 0)
			VAR __MoreParentAreas = IF(__ParentAreasCount > 10, " and " & (__ParentAreasCount - 10) & " more", "")
			
			VAR __Areas = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES('Dim Business Unit Hierarchy'[Business Unit Hierarchy Level2 Name]), NOT(ISBLANK('Dim Business Unit Hierarchy'[Business Unit Hierarchy Level2 Name]))), 'Dim Business Unit Hierarchy'[Business Unit Hierarchy Level2 Name], ASC),
			    "AreaName_display", 'Dim Business Unit Hierarchy'[Business Unit Hierarchy Level2 Name]
			)
			VAR __AreasCount = IF(ISFILTERED('Dim Business Unit Hierarchy'[Business Unit Hierarchy Level2 Name]), COUNTROWS(VALUES('Dim Business Unit Hierarchy'[Business Unit Hierarchy Level2 Name])), 0)
			VAR __MoreAreas = IF(__AreasCount > 10, " and " & (__AreasCount - 10) & " more", "")
			
			VAR __Services = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES('Dim Business Unit Hierarchy'[Business Unit Hierarchy Level3 Name]), NOT(ISBLANK('Dim Business Unit Hierarchy'[Business Unit Hierarchy Level3 Name]))), 'Dim Business Unit Hierarchy'[Business Unit Hierarchy Level3 Name], ASC),
			    "TeamName_display", 'Dim Business Unit Hierarchy'[Business Unit Hierarchy Level3 Name]
			)
			VAR __ServicesCount = IF(ISFILTERED('Dim Business Unit Hierarchy'[Business Unit Hierarchy Level3 Name]), COUNTROWS(VALUES('Dim Business Unit Hierarchy'[Business Unit Hierarchy Level3 Name])), 0)
			VAR __MoreServices = IF(__ServicesCount > 10, " and " & (__ServicesCount - 10) & " more", "")
			
			VAR _FC_ParentAreas = IF(__ParentAreasCount > 0, "| PARENT AREAS CHOSEN: " & CONCATENATEX(__ParentAreas, [AreaParentName_display], ", "), BLANK())
			VAR _FC_MoreParentAreas = IF(__ParentAreasCount > 10, " and " & (__ParentAreasCount - 10) & " more", "")
			VAR _FC_Areas = IF(__AreasCount > 0, "| AREAS CHOSEN: " & CONCATENATEX(__Areas, [AreaName_display], ", "), BLANK())
			VAR _FC_MoreAreas = IF(__AreasCount > 10, " and " & (__AreasCount - 10) & " more", "")
			VAR _FC_Services = IF(__ServicesCount > 0, "| SERVICES CHOSEN: " & CONCATENATEX(__Services, [TeamName_display], ", "), BLANK())
			VAR _FC_MoreServices = IF(__ServicesCount > 10, " and " & (__ServicesCount - 10) & " more", "")
			VAR _FC_KaimahiNames = IF(__KaimahiCount > 0, "| KAIMAHI CHOSEN: " & CONCATENATEX(__KaimahiNames, [KaimahiName_Display], ", "), BLANK())
			VAR _FC_MoreKaimahiNames = IF(__KaimahiCount > 10, " and " & (__KaimahiCount - 10) & " more", "")
			
			RETURN
			IF(
			    ISBLANK(_FC_ParentAreas) && ISBLANK(_FC_Areas) && ISBLANK(_FC_Services) && ISBLANK(__BusinessEntity) && ISBLANK(__LeaveType),
			    "",
			    "-- Summary of filters applied to page: " & _FC_ParentAreas & _FC_MoreParentAreas & _FC_Areas & _FC_MoreAreas & _FC_Services & _FC_MoreServices
			) &__BusinessEntity  & __LeaveType & _FC_KaimahiNames & _FC_MoreKaimahiNames
		displayFolder: Leave Liability
		lineageTag: 5c2a9653-dda8-4cba-8264-018e1797f927

