	measure 'Casual worked Flag' = IF( [Employee Hours] > 0, 1, 0 )
		formatString: 0
		displayFolder: Casual Analysis
		lineageTag: ec2b1532-d749-45b3-804b-4ae16006dbc2

	/// Count of active casual employees associated with the current service who worked in the selected pay periods
	measure 'Casuals Worked by Service' =
			VAR SelectedPayPeriodEndDates =
			    CALCULATETABLE ( VALUES ( fact_pay_run[pay_period_end_date] ), REMOVEFILTERS ( 'Dim Kaimahi' ) )
			VAR ActiveCasualEmployeesInDept =
			    FILTER (
			        CALCULATETABLE (
			            VALUES ( 'Dim Kaimahi'[Kaimahi ID] ),
			            KEEPFILTERS ( 'Dim Kaimahi'[Kaimahi Work Type] = "Temporary/Casual" )
			        ),
			        VAR EmployeeStartDate =
			            CALCULATE ( MIN ( 'Dim Kaimahi'[Kaimahi Company Start Date] ) )
			        VAR EmployeeEndDate =
			            CALCULATE ( MAX ( 'Dim Kaimahi'[Kaimahi Company End Date] ) )
			        RETURN
			            CALCULATE ( [Employee Matches Selected Service Filter] ) = 1
			                && COUNTROWS (
			                    FILTER (
			                        SelectedPayPeriodEndDates,
			                        fact_pay_run[pay_period_end_date] >= EmployeeStartDate
			                            && (
			                                ISBLANK ( EmployeeEndDate )
			                                    || fact_pay_run[pay_period_end_date] <= EmployeeEndDate
			                            )
			                    )
			                ) > 0
			    )
			VAR WorkedCasualEmployeesInDept =
			    FILTER (
			        ActiveCasualEmployeesInDept,
			        CALCULATE ( [Employee Hours] ) > 0
			    )
			RETURN
			    COALESCE ( COUNTROWS ( WorkedCasualEmployeesInDept ), 0 )
		formatString: #,##0
		displayFolder: Casual Analysis
		lineageTag: 11069bf5-0129-41f0-a0f9-88539565fe9f

	/// Count of active casual employees associated with the current service who did not work in the selected pay periods
	measure 'Casuals Not Worked by Service' =
			VAR SelectedPayPeriodEndDates =
			    CALCULATETABLE ( VALUES ( fact_pay_run[pay_period_end_date] ), REMOVEFILTERS ( 'Dim Kaimahi' ) )
			VAR ActiveCasualEmployeesInDept =
			    FILTER (
			        CALCULATETABLE (
			            VALUES ( 'Dim Kaimahi'[Kaimahi ID] ),
			            KEEPFILTERS ( 'Dim Kaimahi'[Kaimahi Work Type] = "Temporary/Casual" )
			        ),
			        VAR EmployeeStartDate =
			            CALCULATE ( MIN ( 'Dim Kaimahi'[Kaimahi Company Start Date] ) )
			        VAR EmployeeEndDate =
			            CALCULATE ( MAX ( 'Dim Kaimahi'[Kaimahi Company End Date] ) )
			        RETURN
			            CALCULATE ( [Employee Matches Selected Service Filter] ) = 1
			                && COUNTROWS (
			                    FILTER (
			                        SelectedPayPeriodEndDates,
			                        fact_pay_run[pay_period_end_date] >= EmployeeStartDate
			                            && (
			                                ISBLANK ( EmployeeEndDate )
			                                    || fact_pay_run[pay_period_end_date] <= EmployeeEndDate
			                            )
			                    )
			                ) > 0
			    )
			VAR WorkedCasualEmployeesInDept =
			    FILTER (
			        ActiveCasualEmployeesInDept,
			        CALCULATE ( [Employee Hours] ) > 0
			    )
			RETURN
			    COALESCE ( COUNTROWS ( EXCEPT ( ActiveCasualEmployeesInDept, WorkedCasualEmployeesInDept ) ), 0 )
		formatString: #,##0
		displayFolder: Casual Analysis
		lineageTag: 2225c460-b344-401c-bab1-7434e0daee3f

	measure 'Casual hours worked' =
			VAR SelectedBusinessUnits =
			    CALCULATETABLE (
			        VALUES ( 'Dim Kaimahi'[Kaimahi Business Unit Name] ),
			        ALLSELECTED ( 'Dim Kaimahi'[Kaimahi Business Unit Name] ),
			        REMOVEFILTERS ( 'Dim Kaimahi'[Kaimahi ID] ),
			        REMOVEFILTERS ( 'Dim Kaimahi'[Kaimahi Name] ),
			        REMOVEFILTERS ( 'Dim Kaimahi'[Kaimahi Job Name] )
			    )
			VAR AllBusinessUnitsInContext =
			    CALCULATETABLE (
			        VALUES ( 'Dim Kaimahi'[Kaimahi Business Unit Name] ),
			        REMOVEFILTERS ( 'Dim Kaimahi'[Kaimahi Business Unit Name] ),
			        REMOVEFILTERS ( 'Dim Kaimahi'[Kaimahi ID] ),
			        REMOVEFILTERS ( 'Dim Kaimahi'[Kaimahi Name] ),
			        REMOVEFILTERS ( 'Dim Kaimahi'[Kaimahi Job Name] )
			    )
			VAR HasBusinessUnitSelection =
			    COUNTROWS ( EXCEPT ( SelectedBusinessUnits, AllBusinessUnitsInContext ) ) > 0
			        || COUNTROWS ( EXCEPT ( AllBusinessUnitsInContext, SelectedBusinessUnits ) ) > 0
			RETURN
			    IF (
			        HasBusinessUnitSelection,
			        COALESCE (
			            CALCULATE (
			                SUM ( fact_pay_run[Total_Hours] ),
			                REMOVEFILTERS ( 'Dim Service' ),
			                REMOVEFILTERS ( 'Dim Kaimahi'[Kaimahi Business Unit Name] ),
			                REMOVEFILTERS ( fact_pay_run[sub_department] ),
			                REMOVEFILTERS ( fact_pay_run[sub_department_code] ),
			                TREATAS ( SelectedBusinessUnits, fact_pay_run[sub_department] )
			            ),
			            0
			        ),
			        COALESCE (
			            CALCULATE (
			                SUM ( fact_pay_run[Total_Hours] ),
			                REMOVEFILTERS ( 'Dim Service' ),
			                REMOVEFILTERS ( 'Dim Kaimahi'[Kaimahi Business Unit Name] ),
			                REMOVEFILTERS ( fact_pay_run[sub_department] ),
			                REMOVEFILTERS ( fact_pay_run[sub_department_code] )
			            ),
			            0
			        )
			    )
		displayFolder: Casual Analysis
		lineageTag: 606b9768-151c-437f-b916-92f25aabf890

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Last Shift Worked' =
			CALCULATE(
			    MAX(fact_pay_run[pay_period_end_date]),
			    REMOVEFILTERS('Dim Date'),
			    REMOVEFILTERS(fact_pay_run[pay_period_end_date]),
			    REMOVEFILTERS(fact_pay_run[pay_period_start_date]),
			    fact_pay_run[Total_Hours] > 0
			)
		formatString: Short Date
		displayFolder: Casual Analysis
		lineageTag: 1e89799f-2406-4a6f-b1c9-89a2d1af7dd7

	/// Visual filter helper for employee rows to match the selected Dim_Service hierarchy
	measure 'Employee Matches Selected Service Filter' =
			VAR CurrentEmployeeServiceName =
			    SELECTEDVALUE ( 'Dim Kaimahi'[Kaimahi Business Unit Name] )
			VAR HasServiceSelection =
			    ISCROSSFILTERED ( 'Dim Service'[Department Name] )
			        || ISCROSSFILTERED ( 'Dim Service'[Region Name] )
			        || ISCROSSFILTERED ( 'Dim Service'[District Name] )
			        || ISCROSSFILTERED ( 'Dim Service'[Service Name] )
			RETURN
			    IF (
			        NOT HasServiceSelection,
			        1,
			        INT (
			            NOT ISBLANK ( CurrentEmployeeServiceName )
			                && CONTAINS (
			                    VALUES ( 'Dim Service'[Service Name] ),
			                    'Dim Service'[Service Name], CurrentEmployeeServiceName
			                )
			        )
			    )
		formatString: 0
		displayFolder: Casual Analysis
		lineageTag: d4b3981d-7820-432c-a6f6-dfef2058964e

	measure 'Number of 88+ hour fortnights' =
			VAR SummaryTable =
			    SUMMARIZE (
			        fact_pay_run,
			        fact_pay_run[pay_period_start_date],
			        fact_pay_run[employee_id],
			        "TotalHoursWorked",
			            CALCULATE (
			                SUM ( fact_pay_run[Total_Hours] ),
			                fact_pay_run[pay_component_name] IN {
			                    "Ordinary Pay",
			                    "Addtional Hours",
			                    "Overtime"
			                }
			            )
			    )
			RETURN
			    COUNTROWS ( FILTER ( SummaryTable, [TotalHoursWorked] >= 88 && [TotalHoursWorked] < 96 ) )
		formatString: 0
		displayFolder: Hours Compliance
		lineageTag: dbac4cd2-dbb2-4a3e-ab1f-5744f76b27cd

	/// Total hours worked for the active casual employee set in the current service/sub-department context
	measure 'Casual Hours Worked by Sub Department' =
			VAR SelectedPayPeriodEndDates =
			    CALCULATETABLE ( VALUES ( fact_pay_run[pay_period_end_date] ), REMOVEFILTERS ( 'Dim Kaimahi' ) )
			VAR ActiveCasualEmployees =
			    FILTER (
			        CALCULATETABLE (
			            VALUES ( 'Dim Kaimahi'[Kaimahi ID] ),
			            KEEPFILTERS ( 'Dim Kaimahi'[Kaimahi Work Type] = "Temporary/Casual" )
			        ),
			        VAR EmployeeStartDate =
			            CALCULATE ( MIN ( 'Dim Kaimahi'[Kaimahi Company Start Date] ) )
			        VAR EmployeeEndDate =
			            CALCULATE ( MAX ( 'Dim Kaimahi'[Kaimahi Company End Date] ) )
			        RETURN
			            [Employee Matches Selected Service Filter] = 1
			                && COUNTROWS (
			                    FILTER (
			                        SelectedPayPeriodEndDates,
			                        fact_pay_run[pay_period_end_date] >= EmployeeStartDate
			                            && (
			                                ISBLANK ( EmployeeEndDate )
			                                    || fact_pay_run[pay_period_end_date] <= EmployeeEndDate
			                            )
			                    )
			                ) > 0
			    )
			VAR ActiveCasualEmployeeIds =
			    SELECTCOLUMNS ( ActiveCasualEmployees, "employee_id", 'Dim Kaimahi'[Kaimahi ID] )
			RETURN
			    COALESCE (
			        CALCULATE (
			            SUM ( fact_pay_run[Total_Hours] ),
			            TREATAS ( ActiveCasualEmployeeIds, fact_pay_run[employee_id] )
			        ),
			        0
			    )
		formatString: #,##0.0
		displayFolder: Casual Analysis
		lineageTag: 10b67d84-bbd1-4bf9-a957-fbdc8be1f9ef

