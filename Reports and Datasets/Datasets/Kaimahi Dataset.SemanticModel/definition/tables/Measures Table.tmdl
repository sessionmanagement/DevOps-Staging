	measure 'Annual Turnover Rate' =
			
			VAR sd =
			    LASTDATE(
			        DATEADD(
			            'Dim Date'[Calendar Date],
			            -1,
			            YEAR
			        )
			    )
			RETURN
			    CALCULATE(
			        SUMX(
			            SUMMARIZE(
			                'Fact Jobs',
			                "AnnualAttrition", [_MonthlyAttritionPercentage]
			            ),
			            [_MonthlyAttritionPercentage]
			        ),
			        FILTER(
			            ALL( 'Dim Date' ),
			            'Dim Date'[Calendar Date] > sd
			                && 'Dim Date'[Calendar Date]
			                    <= MAX( 'Dim Date'[Calendar Date] )
			        )
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Demographics
		lineageTag: d480063e-a6e1-4042-a739-b8a34d90e6f0

