			        'Den Kaimahi Core Training Progress'[TrainingType] = "Program",
			        'Den Kaimahi Core Training Progress'[Trainingoverduestatus] <> "Not Due",
			        -- Keeping filter on Program
			        'Den Kaimahi Core Training Progress'[Kaimahi Program Assigned Date] <= MaxDate,
			        'Den Kaimahi Core Training Progress'[Kaimahi Program Assigned Date] >= MinDate
			    )
			VAR CompletedPrograms =
			    CALCULATE (
			        COUNTROWS ( 'Den Kaimahi Core Training Progress' ),
			        REMOVEFILTERS ( 'Den Kaimahi Core Training Progress'[Item Full Name] ),
			        'Den Kaimahi Core Training Progress'[Kaimahi Program Assigned Date] <= MaxDate,
			        'Den Kaimahi Core Training Progress'[Kaimahi Program Assigned Date] >= MinDate,
			        ( 'Den Kaimahi Core Training Progress'[Completed Date] <= MaxDate
			            && 'Den Kaimahi Core Training Progress'[Completed Date] >= MinDate ),
			            'Den Kaimahi Core Training Progress'[Trainingoverduestatus] <> "Not Due",
			        'Den Kaimahi Core Training Progress'[Trainingoverduestatus] = "Completed",
			        'Den Kaimahi Core Training Progress'[TrainingType] = "Program" -- Keeping filter on Program
			    )
			RETURN
			    ROUND ( DIVIDE ( CompletedPrograms, TotalPrograms ), 2 )
		formatString: 0%;-0%;0%
		displayFolder: Core Training
		lineageTag: f19e785f-764f-4f5f-9ec6-79e6464c0006

	measure 'Overall Training Completion Percentage' =
			
			VAR CurrentDate = MAX ( 'Dim Date'[Calendar Date] )
			VAR TotalAssignedTrainings =
			    CALCULATE (
			        COUNTROWS ( 'Den Kaimahi Core Training Progress' ),
			        'Den Kaimahi Core Training Progress'[Kaimahi Program Assigned Date] <= CurrentDate,
			        'Den Kaimahi Core Training Progress'[Trainingoverduestatus] <> "Not Due"
			    )
			VAR CompletedTrainings =
			    CALCULATE (
			        COUNTROWS ( 'Den Kaimahi Core Training Progress' ),
			        'Den Kaimahi Core Training Progress'[Trainingoverduestatus] = "Completed",
			        'Den Kaimahi Core Training Progress'[Trainingoverduestatus] <> "Not Due",
			        'Den Kaimahi Core Training Progress'[Completed Date] <= CurrentDate
			    )
			RETURN
			    IF (
			        TotalAssignedTrainings = 0,
			        BLANK (),
			        DIVIDE ( CompletedTrainings, TotalAssignedTrainings, 0 )
			    )
		formatString: 0%;-0%;0%
		displayFolder: Core Training
		lineageTag: 0ecfdf93-4f94-441b-9f52-d61bb1af737e

