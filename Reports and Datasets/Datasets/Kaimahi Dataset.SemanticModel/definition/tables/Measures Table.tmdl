	measure 'Average Gender Pay Gap' = ```
			
			// Threshold for how many employees need to count for each Gender for the Pay Gap calculation to matter - i.e if only 1 employee then there's no point and if only 2, grain is too small
			VAR Threshold = [PayGapThreshold] // How many males are in the selected population
			VAR TotalMales = [# of Males]
			     // How many females are in the selected population
			VAR TotalFemales = [# of Females]
			    // Calculate Gender Pay Gap
			VAR GenderPayGap =
			    IF (
			        // Calculate the Gender Pay gap only if the amount of males or females exceeds the threshold set by the PX team
			        TotalMales < Threshold
			            || TotalFemales < Threshold,
			        0,
			        ( [Average Hourly Male Pay] - [Average Hourly Female Pay] )
			            / [Average Hourly Male Pay]
			    )
			RETURN
			    GenderPayGap
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Gender Pay Gap
		lineageTag: 953b2764-ae3d-4304-8e2b-908b57bb60f4

	measure 'Average Hourly Female Pay' = CALCULATE(AVERAGE('Fact Jobs'[Calculated Hourly Rate]), 'Dim Kaimahi'[Kaimahi Gender] = "Female", 'Fact Jobs'[Isprimaryjob]=1)
