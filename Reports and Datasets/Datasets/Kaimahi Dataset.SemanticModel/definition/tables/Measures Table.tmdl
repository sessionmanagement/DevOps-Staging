	measure 'Percentage of Kaimahi 160-200' = ```
			
			VAR Total160to200 = 
			    CALCULATE (
			        COUNTROWS ( 
			            FILTER (
			                SUMMARIZE (
			                    FactLeaveBalance,
			                    FactLeaveBalance[Kaimahi ID],
			                    "Total Leave", [Total Leave]
			                ),
			                [Total Leave] > 160
			                &&
			                [Total Leave] < 200
			            )
			        )
			    )
			VAR TotalKaimahi = 
			    DISTINCTCOUNT(FactLeaveBalance[Kaimahi ID])
			VAR Total160to200Percentage =
			    DIVIDE ( Total160to200, TotalKaimahi )
			RETURN
			    IF (
			        ISBLANK ( TotalKaimahi ) || ISBLANK ( Total160to200 ),
			        BLANK(),
			        Total160to200Percentage
			    )
			
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Leave Liability
		lineageTag: f0a0949d-26ff-4bf4-b60c-b18e84e0050f

