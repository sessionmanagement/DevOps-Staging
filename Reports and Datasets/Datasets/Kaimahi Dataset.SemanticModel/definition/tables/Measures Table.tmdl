table 'Measures Table'
	lineageTag: 8b33f859-573e-403c-816b-cab13343ff45

	measure 'Kaimahi Completed All Training' =
			
			VAR KaimahiWithCourses =
			    CALCULATETABLE (
			        VALUES ( 'Den Kaimahi Core Training Progress'[Kaimahi ID] ),
			        'Den Kaimahi Core Training Progress'[Trainingoverduestatus] = "Completed"
			        ,'Den Kaimahi Core Training Progress'[Trainingoverduestatus] <> "Not Due"
			    )
			VAR KaimahiAllCourses =
			    SUMMARIZE (
			        'Den Kaimahi Core Training Progress',
			        'Den Kaimahi Core Training Progress'[Kaimahi ID],
			        "TotalTraining", COUNTROWS ( 'Den Kaimahi Core Training Progress'),
			        "CompleteTraining",
			            CALCULATE (
			                COUNTROWS ( 'Den Kaimahi Core Training Progress'),
			                'Den Kaimahi Core Training Progress'[Trainingoverduestatus] = "Completed"
			                ,'Den Kaimahi Core Training Progress'[Trainingoverduestatus] <> "Not Due"
			            )
			    )
			VAR KaimahiWithAllTraining =
			    FILTER ( KaimahiAllCourses, [TotalTraining] = [CompleteTraining] )
			RETURN
			    IF (
			        ISBLANK ( COUNTROWS ( KaimahiWithAllTraining ) ),
			        0,
			        COUNTROWS ( KaimahiWithAllTraining )
			    )
		formatString: #,0
		displayFolder: Core Training
		lineageTag: e3c4bb68-4152-49d5-9740-627ddc3bfaba

	measure 'Number of Active Kaimahi with Training' = ```
			
			CALCULATE ( DISTINCTCOUNT ( 'Den Kaimahi Core Training Progress'[Kaimahi ID] ) )
			
			```
		formatString: #,0
		displayFolder: Core Training
		lineageTag: 71ff3b1d-2ad3-43b3-a64d-05d505d97d68

	measure 'Core Training FiltersApplied' = ```
			
			VAR __Companies =
			    ADDCOLUMNS (
			        TOPN (
			            5,
			            -- Show only the first 5 selected items
			            FILTER (
			                VALUES ( 'Dim Service'[Company Name] ),
			                NOT ( ISBLANK ( 'Dim Service'[Company Name] ) )
			            ),
			            'Dim Service'[Company Name], ASC
			        ),
			        "CompanyName_display", 'Dim Service'[Company Name]
			    )
			VAR __CompaniesCount =
			    IF (
			        ISFILTERED ( 'Dim Service'[Company Name] ),
			        COUNTROWS ( VALUES ( 'Dim Service'[Company Name] ) ),
			        0
			    )
			
			// Core Training Filters, for Programs, Certifications and Courses
			VAR __Courses =
			    ADDCOLUMNS (
			        TOPN (
			            5,
			            -- Show only the first 5 selected items
			            FILTER (
			                VALUES ( 'Den Kaimahi Core Training Progress'[Item Full Name] ),
			                NOT ( ISBLANK ( 'Den Kaimahi Core Training Progress'[Item Full Name] ) )
			            ),
			            'Den Kaimahi Core Training Progress'[Item Full Name], ASC
			        ),
			        "CourseName_display", 'Den Kaimahi Core Training Progress'[Item Full Name]
			    )
			VAR __CoursesCount =
			    IF (
			        ISFILTERED ( 'Den Kaimahi Core Training Progress'[Item Full Name] ),
			        COUNTROWS ( VALUES ( 'Den Kaimahi Core Training Progress'[Item Full Name] ) ),
			        0
			    )
			VAR __MoreCourses =
			    IF ( __CoursesCount > 5, " and " & ( __CoursesCount - 5 ) & " more", "" )
			VAR _FC_Courses =
			    IF (
			        __CoursesCount > 0,
			        "| Core Training: " & CONCATENATEX ( __Courses, [CourseName_display], ", " ) & __MoreCourses,
			        BLANK ()
			    )
			// Training Type
			
			VAR __TrainingTypes =
			    ADDCOLUMNS (
			        TOPN (
			            5,
			            -- Show only the first 5 selected items
			            FILTER (
			                VALUES ( 'Den Kaimahi Core Training Progress'[Trainingtype] ),
			                NOT ( ISBLANK ( 'Den Kaimahi Core Training Progress'[Trainingtype] ) )
			            ),
			            'Den Kaimahi Core Training Progress'[Trainingtype], ASC
			        ),
			        "TrainingType_display", 'Den Kaimahi Core Training Progress'[Trainingtype]
			    )
			VAR __TrainingTypeCount =
			IF (
			    ISFILTERED ( 'Den Kaimahi Core Training Progress'[Trainingtype] ),
			    COUNTROWS ( VALUES ( 'Den Kaimahi Core Training Progress'[Trainingtype] ) ),
			    0
			)
			VAR _FC_TrainingTypes =
			    IF (
			        __TrainingTypeCount > 0,
			        "| Training Types: " & CONCATENATEX ( __TrainingTypes, [TrainingType_display], ", " ),
			        BLANK ()
			    )
			
			// Kaimahi Filters
			VAR __Kaimahi =
			    ADDCOLUMNS (
			        TOPN (
			            5,
			            -- Show only the first 5 selected items
			            FILTER (
			                VALUES ( 'Dim Kaimahi'[Kaimahi Name] ),
			                NOT ( ISBLANK ( 'Dim Kaimahi'[Kaimahi Name] ) )
			            ),
			            'Dim Kaimahi'[Kaimahi Name], ASC
			        ),
			        "KaimahiName_display", 'Dim Kaimahi'[Kaimahi Name]
			    )
			VAR __KaimahiCount =
			    IF (
			        ISFILTERED ( 'Dim Kaimahi'[Kaimahi Name]),
			        DISTINCTCOUNT('Dim Kaimahi'[Kaimahi Name] ),
			        0
			    )
			    /*VAR __KaimahiCount =
			    IF (
			        ISFILTERED ( 'Dim Kaimahi'[Kaimahi Name]),
			        COUNTROWS ( VALUES ( 'Dim Kaimahi'[Kaimahi Name] ) ),
			        0
			    )*/
			VAR __MoreKaimahi =
			    IF ( __CoursesCount > 5, " and " & ( __KaimahiCount - 5 ) & " more", "" )
			VAR _FC_Kaimahi =
			    IF (
			        __KaimahiCount > 0,
			        "| Kaimahi: " & CONCATENATEX ( __Kaimahi, [KaimahiName_display], ", " ) & __MoreKaimahi,
			        BLANK ()
			    )
			VAR _FC_MoreKaimahi =
			    IF ( __KaimahiCount > 5, " and " & ( __KaimahiCount - 5 ) & " more", "" )
			VAR __Services =
			    ADDCOLUMNS (
			        TOPN (
			            5,
			            FILTER (
			                VALUES ( 'Dim Service'[Service Name]),
			                NOT ( ISBLANK ( 'Dim Service'[Service Name]) )
			            ),
			            'Dim Service'[Service Name], ASC
			        ),
			        "ServiceName_display", 'Dim Service'[Service Name]
			    )
			VAR __ServicesCount =
			    IF (
			        ISFILTERED ( 'Dim Service'[Service Name]),
			        COUNTROWS ( VALUES ( 'Dim Service'[Service Name]) ),
			        0
			    )
			VAR __MoreServices =
			    IF ( __ServicesCount > 5, " and " & ( __ServicesCount - 5 ) & " more", "" )
			VAR _FC_Companies =
			    IF (
			        __CompaniesCount > 0,
			        "| Company: " & CONCATENATEX ( __Companies, [CompanyName_display], ", " ),
			        BLANK ()
			    )
			VAR __ParentRegion =
			    ADDCOLUMNS (
			        TOPN (
			            5,
			            -- Show only the first 5 selected items
			            FILTER (
			                VALUES ( 'Dim Service'[Region Name] ),
			                NOT ( ISBLANK ( 'Dim Service'[Region Name] ) )
			            ),
			            'Dim Service'[Region Name], ASC
			        ),
			        "AreaParentRegionName_display", 'Dim Service'[Region Name]
			    )
			VAR __ParentRegionCount =
			    IF (
			        ISFILTERED ( 'Dim Service'[Region Name] ),
			        COUNTROWS ( VALUES ( 'Dim Service'[Region Name] ) ),
			        0
			    )
			VAR _FC_ParentRegion =
			    IF (
			        __ParentRegionCount > 0,
			        "| Region: "
			            & CONCATENATEX ( __ParentRegion, [AreaParentRegionName_display], ", " )
			            & IF (
			                __ParentRegionCount > 5,
			                " and " & ( __ParentRegionCount - 5 ) & " more",
			                ""
			            ),
			        BLANK ()
			    )
			VAR __ParentDistrict =
			    ADDCOLUMNS (
			        TOPN (
			            5,
			            -- Show only the first 5 selected items
			            FILTER (
			                VALUES ( 'Dim Service'[District Name] ),
			                NOT ( ISBLANK ( 'Dim Service'[District Name] ) )
			            ),
			            'Dim Service'[District Name], ASC
			        ),
			        "AreaParentDistrictName_display", 'Dim Service'[District Name]
			    )
			VAR __ParentDistrictCount =
			    IF (
			        ISFILTERED ( 'Dim Service'[District Name] ),
			        COUNTROWS ( VALUES ( 'Dim Service'[District Name] ) ),
			        0
			    )
			VAR _FC_ParentDistrict =
			    IF (
			        __ParentDistrictCount > 0,
			        "| District: "
			            & CONCATENATEX ( __ParentDistrict, [AreaParentDistrictName_display], ", " )
			            & IF (
			                __ParentDistrictCount > 5,
			                " and " & ( __ParentDistrictCount - 5 ) & " more",
			                ""
			            ),
			        BLANK ()
			    )
			VAR _FC_Services =
			    IF (
			        __ServicesCount > 0,
			        "| Services chosen: " & CONCATENATEX ( __Services, [Service Name], ", " ),
			        BLANK ()
			    )
			VAR _FC_MoreServices =
			    IF ( __ServicesCount > 5, " and " & ( __ServicesCount - 5 ) & " more", "" )
			RETURN
			    "Number of Active Kaimahi with Training: " & FORMAT([Number of Active Kaimahi with Training], "#,##0")
			        & UNICHAR ( 10 )
			        & UNICHAR ( 13 ) & " -- Summary of filters applied to page: " & _FC_TrainingTypes & " " & _FC_Courses & " " & _FC_Companies & " " & _FC_ParentRegion & " " & _FC_ParentDistrict & " " & _FC_Services & " " &  _FC_Kaimahi
			        & UNICHAR ( 10 ) 
			        & UNICHAR ( 13 )  & _FC_MoreServices & _FC_MoreKaimahi
			```
		displayFolder: Core Training\Filters
		lineageTag: dfaa0056-7def-42ec-a0fc-bd4d167ffc31

	measure RefreshedAt_forDisplay =
			
			"Data Last Refreshed: "
			    & FORMAT (
			        LASTDATE ( LastRefreshed[Date Last Refreshed] ),
			        "dd/MM/YYYY - hh:mm AM/PM"
			    )
		displayFolder: Demographics
		lineageTag: e6759229-2f43-4b2a-ba99-02e55082a86c

	measure 'Certification Completion Percentage' =
			
			VAR MinDate =
			    MIN ( 'Dim Date'[Calendar Date] )
			VAR MaxDate =
			    MAX ( 'Dim Date'[Calendar Date] )
			VAR TotalCertifications =
			    CALCULATE (
			        COUNTROWS ( 'Den Kaimahi Core Training Progress' ),
			        REMOVEFILTERS ( 'Den Kaimahi Core Training Progress'[Item Full Name] ),
			        'Den Kaimahi Core Training Progress'[TrainingType] = "Certification",
			        -- Keeping filter on Certification
			        'Den Kaimahi Core Training Progress'[Trainingoverduestatus] <> "Not Due",
			        'Den Kaimahi Core Training Progress'[Kaimahi Program Assigned Date] <= MaxDate,
			        'Den Kaimahi Core Training Progress'[Kaimahi Program Assigned Date] >= MinDate
			    )
			VAR CompletedCertifications =
			    CALCULATE (
			        COUNTROWS ( 'Den Kaimahi Core Training Progress' ),
			        REMOVEFILTERS ( 'Den Kaimahi Core Training Progress'[Item Full Name] ),
			        'Den Kaimahi Core Training Progress'[Kaimahi Program Assigned Date] <= MaxDate,
			        'Den Kaimahi Core Training Progress'[Kaimahi Program Assigned Date] >= MinDate,
			        ( 'Den Kaimahi Core Training Progress'[Completed Date] <= MaxDate
			            && 'Den Kaimahi Core Training Progress'[Completed Date] >= MinDate ),
			            'Den Kaimahi Core Training Progress'[Trainingoverduestatus] <> "Not Due",
			        'Den Kaimahi Core Training Progress'[Trainingoverduestatus] = "Completed",
			        'Den Kaimahi Core Training Progress'[TrainingType] = "Certification" -- Keeping filter on Certification
			    )
			RETURN
			    ROUND ( DIVIDE ( CompletedCertifications, TotalCertifications ), 2 )
		formatString: 0%;-0%;0%
		displayFolder: Core Training
		lineageTag: 0d3e6805-8dc0-47aa-9916-1c2efcb8a784

	measure 'Course Completion Percentage' =
			
			VAR MinDate =
			    MIN ( 'Dim Date'[Calendar Date] )
			VAR MaxDate =
			    MAX ( 'Dim Date'[Calendar Date] )
			VAR TotalCourses =
			    CALCULATE (
			        COUNTROWS ( 'Den Kaimahi Core Training Progress' ),
			        REMOVEFILTERS ( 'Den Kaimahi Core Training Progress'[Item Full Name] ),
			        'Den Kaimahi Core Training Progress'[TrainingType] = "Course",
			        -- Keeping filter on Course
			        'Den Kaimahi Core Training Progress'[Kaimahi Program Assigned Date] <= MaxDate,
			        'Den Kaimahi Core Training Progress'[Kaimahi Program Assigned Date] >= MinDate,
			        'Den Kaimahi Core Training Progress'[Trainingoverduestatus] <> "Not Due"
			    )
			VAR CompletedCourses =
			    CALCULATE (
			        COUNTROWS ( 'Den Kaimahi Core Training Progress' ),
			        REMOVEFILTERS ( 'Den Kaimahi Core Training Progress'[Item Full Name] ),
			        'Den Kaimahi Core Training Progress'[Kaimahi Program Assigned Date] <= MaxDate,
			        'Den Kaimahi Core Training Progress'[Kaimahi Program Assigned Date] >= MinDate,
			        ( 'Den Kaimahi Core Training Progress'[Completed Date] <= MaxDate
			            && 'Den Kaimahi Core Training Progress'[Completed Date] >= MinDate ),
			        'Den Kaimahi Core Training Progress'[Trainingoverduestatus] <> "Not Due",
			        'Den Kaimahi Core Training Progress'[Trainingoverduestatus] = "Completed",
			        'Den Kaimahi Core Training Progress'[TrainingType] = "Course" -- Keeping filter on Course
			    )
			RETURN
			    ROUND ( DIVIDE ( CompletedCourses, TotalCourses ), 2 )
		formatString: 0%;-0%;0%
		displayFolder: Core Training
		lineageTag: 36963b00-81db-4a12-a01b-f508812e36f9

	measure 'Program Completion Percentage' =
			
			VAR MinDate =
			    MIN ( 'Dim Date'[Calendar Date] )
