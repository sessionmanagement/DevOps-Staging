	measure FiltersApplied_PayRun = ```
			
			VAR __Year = IF(ISFILTERED('Dim Date'[Calendar Year]), CONCATENATEX(FILTERS('Dim Date'[Calendar Year]), 'Dim Date'[Calendar Year], ", "), BLANK())
			VAR __Month = IF(ISFILTERED('Dim Date'[Calendar Month Name Short]), CONCATENATEX(FILTERS('Dim Date'[Calendar Month Name Short]), 'Dim Date'[Calendar Month Name Short], ", "), BLANK())
			
			VAR __ContractType = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES('Dim Kaimahi'[Kaimahi Work Type]), NOT(ISBLANK('Dim Kaimahi'[Kaimahi Work Type]))), 'Dim Kaimahi'[Kaimahi Work Type], ASC),
			    "ContractType_Display", 'Dim Kaimahi'[Kaimahi Work Type]
			)
			
			
			VAR __ContractTypeCount = IF(ISFILTERED('Dim Kaimahi'[Kaimahi Work Type]), COUNTROWS(VALUES('Dim Kaimahi'[Kaimahi Work Type])), 0)
			
			VAR __ComponentType = ADDCOLUMNS(
			    TOPN(5, FILTER(VALUES(fact_pay_run[pay_component_name]), NOT(ISBLANK(fact_pay_run[pay_component_name]))), fact_pay_run[pay_component_name], ASC),
			    "ComponentType_Display", fact_pay_run[pay_component_name]
			)
			
			VAR __ComponentTypeCount = IF(ISFILTERED(fact_pay_run[pay_component_name]), COUNTROWS(VALUES(fact_pay_run[pay_component_name])), 0)
			
			VAR __PayPeriods = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES(fact_pay_run[pay_period_start_date]), NOT(ISBLANK(fact_pay_run[pay_period_start_date]))), fact_pay_run[pay_period_start_date], ASC),
			    "PayPeriods_Display", fact_pay_run[pay_period_start_date]
			)
			VAR __PayPeriodCount = IF(ISFILTERED(fact_pay_run[pay_period_start_date]), COUNTROWS(VALUES(fact_pay_run[pay_period_start_date])), 0)
			
			
			VAR __Region = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES('Dim Service'[Region Name]), NOT(ISBLANK('Dim Service'[Region Name]))), 'Dim Service'[Region Name], ASC),
			    "Region_display", 'Dim Service'[Region Name]
			)
			
			VAR __RegionCount = IF(ISFILTERED('Dim Service'[Region Name]), COUNTROWS(VALUES('Dim Service'[Region Name])), 0)
			
			VAR __District = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES('Dim Service'[District Name]), NOT(ISBLANK('Dim Service'[District Name]))), 'Dim Service'[District Name], ASC),
			    "District_display", 'Dim Service'[District Name]
			)
			
			VAR __DistrictCount = IF(ISFILTERED('Dim Service'[District Name]), COUNTROWS(VALUES('Dim Service'[District Name])), 0)
			
			VAR __Services = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES('Dim Service'[Service Name]), NOT(ISBLANK('Dim Service'[Service Name]))), 'Dim Service'[Service Name], ASC),
			    "Service_display", 'Dim Service'[Service Name]
			)
			
			VAR __ServiceCount = IF(ISFILTERED('Dim Service'[Service Name]), COUNTROWS(VALUES('Dim Service'[Service Name])), 0)
			
			
			VAR _FC_Year = IF(ISBLANK(__Year), BLANK(), "| YEAR(S) CHOSEN: " & __Year)
			VAR _FC_Month = IF(ISBLANK(__Month), BLANK(), "| MONTH(S) CHOSEN: " & __Month)
			
			VAR _FC_Regions = IF(__RegionCount > 0, "| REGIONS CHOSEN: " & CONCATENATEX(__Region, [Region_display], ", "), BLANK())
			VAR _FC_MoreRegions = IF(__RegionCount > 10, " and " & (__RegionCount - 10) & " more", "")
			
			VAR _FC_Districts = IF(__DistrictCount > 0, "| DISTRICTS CHOSEN: " & CONCATENATEX(__District, [District_display], ", "), BLANK())
			VAR _FC_MoreDistricts = IF(__DistrictCount > 10, " and " & (__DistrictCount - 10) & " more", "")
			
			VAR _FC_Services = IF(__ServiceCount > 0, "| SERVICES CHOSEN: " & CONCATENATEX(__Services, [Service_display], ", "), BLANK())
			VAR _FC_MoreServices = IF(__ServiceCount > 10, " and " & (__ServiceCount - 10) & " more", "")
			
			VAR _FC_ContractType = IF(__ContractTypeCount > 0, "| CONTRACT TYPES CHOSEN: " & CONCATENATEX(__ContractType, [ContractType_Display], ", "), BLANK())
			
			VAR _FC_ComponentType = IF(__ComponentTypeCount > 0, "| PAY COMPONENTS CHOSEN: " & CONCATENATEX(__ComponentType, [ComponentType_Display], ", "), BLANK())
			VAR _FC_MoreComponents= IF(__ComponentTypeCount > 5, " and " & (__ComponentTypeCount - 5) & " more", "")
			
			VAR _FC_PayPeriods = IF(__PayPeriodCount > 0, "| PAY PERIODS CHOSEN: " & CONCATENATEX(__PayPeriods, [PayPeriods_Display], ", "), BLANK())
			VAR _FC_MorePayPeriods = IF(__PayPeriodCount > 7, " and " & (__PayPeriodCount - 7) & " more", "")
			
			
			VAR _FirstDate = MIN('Dim Date'[Calendar Date])
			VAR _LastDate = MAX('Dim Date'[Calendar Date])
			
			RETURN
			 "Please note that all data shown is based on the following date range: " & FORMAT(_FirstDate, "dd/MM/YYYY") & " - " & FORMAT(_LastDate, "dd/MM/YYYY") 
			& " " &
			IF(
			    ISBLANK(_FC_Year) && ISBLANK(_FC_Month) && ISBLANK(_FC_Regions) && ISBLANK(_FC_Districts) && ISBLANK(_FC_Services),
			    "",
			    "-- Summary of filters applied to page: " & " " & _FC_Year & " " & _FC_Month & " " & _FC_Regions & _FC_MoreRegions & " " & _FC_Districts & _FC_MoreDistricts & " " & _FC_Services & _FC_MoreServices
			) & _FC_PayPeriods & _FC_MorePayPeriods & " " & _FC_ContractType & _FC_ComponentType & _FC_MoreComponents
			
			```
		displayFolder: Payrun
		lineageTag: 24f15127-fa80-4f90-bca0-efe6c56caec5

