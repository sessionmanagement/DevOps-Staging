	partition 'Dim Date' = m
		mode: import
		queryGroup: Dim
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="SELECT#(lf)    [calendar_date],#(lf)    [calendar_first_day_of_week_date],#(lf)    [calendar_last_day_of_week_date],#(lf)    [calendar_year_month],#(lf)    [calendar_month_name_short],#(lf)    [calendar_first_day_of_month_date],#(lf)    [calendar_last_day_of_month_date],#(lf)    [calendar_year],#(lf)    financial_year_desc,#(lf)    [calendar_first_day_of_year_date],#(lf)    [calendar_last_day_of_year_date],#(lf)    [financial_first_day_of_year_date],#(lf)    [financial_last_day_of_year_date],#(lf)    [financial_first_day_of_week_date],#(lf)    [financial_last_day_of_week_date],#(lf)    [financial_first_Day_of_month_date],#(lf)    [financial_last_day_of_month_date],#(lf)    [DWHModifiedOn]#(lf)FROM [edw].[vw_dim_date]#(lf)WHERE calendar_date >= '2020-01-01'#(lf)  AND calendar_date <= DATEADD(MONTH, 12, CAST(GETDATE() AS date))#(lf);"]),
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceClient = Text.Replace(columnName, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            capitaliseWords = Text.Proper(replaceUnderscore),
				            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY")
				        in
				            capitaliseKEY,
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, each ApplyNamingConventions(_))
				in
				    #"Transformed Column Names"

	changedProperty = IsHidden

	annotation PBI_ResultType = Exception

	annotation PBI_NavigationStepName = Navigation

