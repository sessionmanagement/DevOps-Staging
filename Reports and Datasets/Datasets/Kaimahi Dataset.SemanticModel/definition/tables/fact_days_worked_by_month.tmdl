table fact_days_worked_by_month
	lineageTag: a7fb9e73-c7f1-4efd-a3f6-1cba280f2cea

	column 'Kaimahi ID'
		dataType: int64
		formatString: 0
		lineageTag: dfc01cb4-ea47-4e0c-8ae0-063f0461100f
		summarizeBy: none
		sourceColumn: Kaimahi ID

		annotation SummarizationSetBy = Automatic

	column 'Month Start Date'
		dataType: dateTime
		formatString: General Date
		lineageTag: 2ca5d991-0e8d-4faf-80d5-2e96a996976e
		summarizeBy: none
		sourceColumn: Month Start Date

		annotation SummarizationSetBy = Automatic

