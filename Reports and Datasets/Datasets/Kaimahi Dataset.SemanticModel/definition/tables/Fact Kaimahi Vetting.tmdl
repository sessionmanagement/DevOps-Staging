	partition 'Fact Kaimahi Vetting' = m
		mode: import
		queryGroup: Fact
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="#(lf)    DECLARE @SnapshotDate DATE = CAST(SYSUTCDATETIME() AT TIME ZONE 'UTC' AT TIME ZONE 'New Zealand Standard Time' AS DATE);#(lf)    DECLARE @KPI_ID INT = 148;#(lf)    DECLARE @Entity_ID INT = 666;#(lf)#(lf)    --------------------------------------------------------------------------------#(lf)    -- Temp Table 1: CurrentEmployees#(lf)    --------------------------------------------------------------------------------#(lf)    IF OBJECT_ID('tempdb..#CurrentEmployees') IS NOT NULL DROP TABLE #CurrentEmployees;#(lf)#(lf)    ;WITH RankedCurrentEmployees AS (#(lf)        SELECT#(lf)            de.dim_employee_key,#(lf)            de.employee_id,#(lf)            de.employee_name,#(lf)            de.employee_job_name,#(lf)            'https://emergeaotearoa.intellihr.net/spa/people/' + de.[employee_profile_system_id] + '/qualifications/' AS humanforce_url,#(lf)            ROW_NUMBER() OVER (#(lf)                PARTITION BY de.employee_id#(lf)                ORDER BY de.dim_employee_key DESC#(lf)            ) AS rn#(lf)        FROM edw.dim_employee de#(lf)        WHERE de.employee_job_status IN ('Current Job', 'Ending Job')#(lf)            AND de.employee_job_name <> 'Cleaner'#(lf)            AND de.DWHIsCurrent = 1#(lf)            AND de.DWHDMLOperation <> 'D'#(lf)    )#(lf)    SELECT#(lf)        rce.dim_employee_key,#(lf)        rce.employee_id,#(lf)        rce.employee_name,#(lf)        rce.employee_job_name,#(lf)        rce.humanforce_url#(lf)    INTO #CurrentEmployees#(lf)    FROM RankedCurrentEmployees rce#(lf)    WHERE rce.rn = 1;#(lf)#(lf)    CREATE CLUSTERED INDEX CIX_CurrentEmployees_employee_id#(lf)        ON #CurrentEmployees (employee_id);#(lf)#(lf)    --------------------------------------------------------------------------------#(lf)    -- Temp Table 2: RelevantServices (Non-SS + Lived Experience Team + National Housing Management)#(lf)    --------------------------------------------------------------------------------#(lf)    IF OBJECT_ID('tempdb..#RelevantServices') IS NOT NULL DROP TABLE #RelevantServices;#(lf)#(lf)    SELECT#(lf)        ds.dim_service_key,#(lf)        ds.service_id,#(lf)        ds.dim_company_key,#(lf)        ds.service_name,#(lf)        ds.department_code#(lf)    INTO #RelevantServices#(lf)    FROM edw.dim_service ds#(lf)    WHERE ds.DWHIsCurrent = 1#(lf)        AND ds.DWHDMLOperation <> 'D'#(lf)        AND ISNULL(ds.is_inactive, 0) <> 1#(lf)        AND ds.dim_service_key > 0#(lf)        AND (#(lf)            ds.department_code NOT IN ('SS', 'WELLBEING')#(lf)            OR ds.service_name IN ('Lived Experience Team', 'National Housing Management')#(lf)        );#(lf)#(lf)    CREATE CLUSTERED INDEX CIX_RelevantServices_service_id#(lf)        ON #RelevantServices (service_id);#(lf)#(lf)    --------------------------------------------------------------------------------#(lf)    -- NEW EXCLUSION LOGIC BEGINS#(lf)    --------------------------------------------------------------------------------#(lf)#(lf)    --------------------------------------------------------------------------------#(lf)    -- Temp Table 3: QualificationBase#(lf)    -- Base qualification set used for employee-level exclusion logic#(lf)    --------------------------------------------------------------------------------#(lf)    IF OBJECT_ID('tempdb..#QualificationBase') IS NOT NULL DROP TABLE #QualificationBase;#(lf)#(lf)    SELECT#(lf)        fq.fact_employee_qualification_key,#(lf)        fq.dim_employee_key,#(lf)        rs.dim_service_key,#(lf)        rs.service_id,#(lf)        rs.dim_company_key,#(lf)        rs.service_name,#(lf)        fq.expiry_date,#(lf)        fq.issue_date,#(lf)        fq.issuing_organisation,#(lf)        qli.employee_qualification_library,#(lf)        qt.employee_qualification_type,#(lf)        fq.employee_id,#(lf)        fq.company_name,#(lf)        fq.qualification_status,#(lf)        UPPER(LTRIM(RTRIM(COALESCE(fq.qualification_status, '')))) AS qualification_status_normalized,#(lf)        CASE#(lf)            WHEN qli.employee_qualification_library IN (#(lf)                'Clean Slate Police Vetting',#(lf)                'Exception Police Vetting',#(lf)                'Ministry of Justice Check'#(lf)            ) THEN 1#(lf)            ELSE 0#(lf)        END AS is_scope_library,#(lf)        CASE#(lf)            WHEN qli.employee_qualification_library IN (#(lf)                'Clean Slate Police Vetting',#(lf)                'Exception Police Vetting'#(lf)            ) THEN 1#(lf)            ELSE 0#(lf)        END AS is_police_vetting_type,#(lf)        CASE#(lf)            WHEN qli.employee_qualification_library = 'Ministry of Justice Check' THEN 1#(lf)            ELSE 0#(lf)        END AS is_moj_type,#(lf)        CASE#(lf)            WHEN UPPER(LTRIM(RTRIM(COALESCE(fq.qualification_status, '')))) = 'EXPIRED' THEN 0#(lf)            ELSE 1#(lf)        END AS is_non_expired_for_exclusion#(lf)    INTO #QualificationBase#(lf)    FROM edw.fact_employee_qualification fq#(lf)    INNER JOIN #CurrentEmployees ce#(lf)        ON fq.employee_id = ce.employee_id#(lf)    INNER JOIN edw.dim_service ds_fq#(lf)        ON fq.dim_service_key = ds_fq.dim_service_key#(lf)        AND ds_fq.DWHDMLOperation <> 'D'#(lf)    INNER JOIN #RelevantServices rs#(lf)        ON ds_fq.service_id = rs.service_id#(lf)    INNER JOIN edw.dim_employee_qualification_library qli#(lf)        ON fq.employee_qualification_library_id = qli.employee_qualification_library_id#(lf)        AND qli.DWHIsCurrent = 1#(lf)    INNER JOIN edw.dim_employee_qualification_type qt#(lf)        ON fq.employee_qualification_type_id = qt.employee_qualification_type_id#(lf)        AND qt.DWHIsCurrent = 1#(lf)        AND qt.employee_qualification_type = 'Vetting'#(lf)    WHERE fq.DWHIsCurrent = 1#(lf)        AND fq.DWHDMLOperation <> 'D';#(lf)#(lf)    CREATE CLUSTERED INDEX CIX_QualificationBase_employee_library_dates#(lf)        ON #QualificationBase (#(lf)            employee_id,#(lf)            employee_qualification_library,#(lf)            expiry_date,#(lf)            issue_date,#(lf)            fact_employee_qualification_key#(lf)        );#(lf)#(lf)    --------------------------------------------------------------------------------#(lf)    -- Temp Table 4: QualificationExclusionAssessment#(lf)    -- Applies employee-level exclusion rules before KPI ranking:#(lf)    -- Rule 1: Like-for-like renewal#(lf)    -- Rule 2: All-expired, keep latest only#(lf)    -- Rule 3/4: Expired Police Vetting replaced by current Police Vetting or current MOJ#(lf)    --------------------------------------------------------------------------------#(lf)    IF OBJECT_ID('tempdb..#QualificationExclusionAssessment') IS NOT NULL DROP TABLE #QualificationExclusionAssessment;#(lf)#(lf)    ;WITH QualificationWindows AS (#(lf)        SELECT#(lf)            qb.fact_employee_qualification_key,#(lf)            qb.dim_employee_key,#(lf)            qb.dim_service_key,#(lf)            qb.service_id,#(lf)            qb.dim_company_key,#(lf)            qb.service_name,#(lf)            qb.expiry_date,#(lf)            qb.issue_date,#(lf)            qb.issuing_organisation,#(lf)            qb.employee_qualification_library,#(lf)            qb.employee_qualification_type,#(lf)            qb.employee_id,#(lf)            qb.company_name,#(lf)            qb.qualification_status,#(lf)            qb.qualification_status_normalized,#(lf)            qb.is_scope_library,#(lf)            qb.is_police_vetting_type,#(lf)            qb.is_moj_type,#(lf)            qb.is_non_expired_for_exclusion,#(lf)            SUM(#(lf)                CASE#(lf)                    WHEN qb.is_scope_library = 1#(lf)                        AND qb.is_non_expired_for_exclusion = 1#(lf)                        THEN 1#(lf)                    ELSE 0#(lf)                END#(lf)            ) OVER (#(lf)                PARTITION BY qb.employee_id, qb.employee_qualification_library#(lf)            ) AS same_library_non_expired_count,#(lf)            ROW_NUMBER() OVER (#(lf)                PARTITION BY qb.employee_id, qb.employee_qualification_library#(lf)                ORDER BY#(lf)                    COALESCE(CAST(qb.expiry_date AS DATE), CAST('1900-01-01' AS DATE)) DESC,#(lf)                    COALESCE(CAST(qb.issue_date AS DATE), CAST('1900-01-01' AS DATE)) DESC,#(lf)                    qb.fact_employee_qualification_key DESC#(lf)            ) AS same_library_keep_rank,#(lf)            MAX(#(lf)                CASE#(lf)                    WHEN qb.is_police_vetting_type = 1#(lf)                        AND qb.is_non_expired_for_exclusion = 1#(lf)                        THEN 1#(lf)                    ELSE 0#(lf)                END#(lf)            ) OVER (#(lf)                PARTITION BY qb.employee_id#(lf)            ) AS employee_has_non_expired_police,#(lf)            MAX(#(lf)                CASE#(lf)                    WHEN qb.is_moj_type = 1#(lf)                        AND qb.is_non_expired_for_exclusion = 1#(lf)                        THEN 1#(lf)                    ELSE 0#(lf)                END#(lf)            ) OVER (#(lf)                PARTITION BY qb.employee_id#(lf)            ) AS employee_has_non_expired_moj#(lf)        FROM #QualificationBase qb#(lf)    )#(lf)    SELECT#(lf)        qw.fact_employee_qualification_key,#(lf)        qw.dim_employee_key,#(lf)        qw.dim_service_key,#(lf)        qw.service_id,#(lf)        qw.dim_company_key,#(lf)        qw.service_name,#(lf)        qw.expiry_date,#(lf)        qw.issue_date,#(lf)        qw.issuing_organisation,#(lf)        qw.employee_qualification_library,#(lf)        qw.employee_qualification_type,#(lf)        qw.employee_id,#(lf)        qw.company_name,#(lf)        qw.qualification_status,#(lf)        qw.qualification_status_normalized,#(lf)        qw.is_scope_library,#(lf)        qw.is_police_vetting_type,#(lf)        qw.is_moj_type,#(lf)        qw.is_non_expired_for_exclusion,#(lf)        qw.same_library_non_expired_count,#(lf)        qw.same_library_keep_rank,#(lf)        qw.employee_has_non_expired_police,#(lf)        qw.employee_has_non_expired_moj,#(lf)        CASE#(lf)            WHEN qw.qualification_status_normalized <> 'EXPIRED' THEN 0#(lf)#(lf)            -- Rule 1: same qualification library has at least one non-expired record#(lf)            WHEN qw.is_scope_library = 1#(lf)                AND qw.same_library_non_expired_count > 0#(lf)                THEN 1#(lf)#(lf)            -- Rule 3 + Rule 4: expired Police Vetting replaced by any non-expired Police Vetting or non-expired MOJ#(lf)            WHEN qw.is_police_vetting_type = 1#(lf)                AND (#(lf)                    qw.employee_has_non_expired_police = 1#(lf)                    OR qw.employee_has_non_expired_moj = 1#(lf)                )#(lf)                THEN 1#(lf)#(lf)            -- Rule 2: all records for the same qualification library are expired, keep latest only#(lf)            WHEN qw.is_scope_library = 1#(lf)                AND qw.same_library_non_expired_count = 0#(lf)                AND qw.same_library_keep_rank > 1#(lf)                THEN 1#(lf)#(lf)            ELSE 0#(lf)        END AS is_excluded#(lf)    INTO #QualificationExclusionAssessment#(lf)    FROM QualificationWindows qw;#(lf)#(lf)    CREATE CLUSTERED INDEX CIX_QualificationExclusionAssessment_excluded_employee#(lf)        ON #QualificationExclusionAssessment (#(lf)            is_excluded,#(lf)            employee_id,#(lf)            employee_qualification_library,#(lf)            fact_employee_qualification_key#(lf)        );#(lf)#(lf)    --------------------------------------------------------------------------------#(lf)    -- Temp Table 5: QualificationFiltered#(lf)    -- Retains only rows not excluded by the new employee-level exclusion logic#(lf)    --------------------------------------------------------------------------------#(lf)    IF OBJECT_ID('tempdb..#QualificationFiltered') IS NOT NULL DROP TABLE #QualificationFiltered;#(lf)#(lf)    SELECT#(lf)        qea.fact_employee_qualification_key,#(lf)        qea.dim_employee_key,#(lf)        qea.dim_service_key,#(lf)        qea.service_id,#(lf)        qea.dim_company_key,#(lf)        qea.service_name,#(lf)        qea.expiry_date,#(lf)        qea.issue_date,#(lf)        qea.issuing_organisation,#(lf)        qea.employee_qualification_library,#(lf)        qea.employee_qualification_type,#(lf)        qea.employee_id,#(lf)        qea.company_name,#(lf)        qea.qualification_status#(lf)    INTO #QualificationFiltered#(lf)    FROM #QualificationExclusionAssessment qea#(lf)    WHERE qea.is_excluded = 0;#(lf)#(lf)    CREATE CLUSTERED INDEX CIX_QualificationFiltered_employee_library#(lf)        ON #QualificationFiltered (#(lf)            employee_id,#(lf)            employee_qualification_library,#(lf)            issue_date,#(lf)            expiry_date,#(lf)            fact_employee_qualification_key#(lf)        );#(lf)#(lf)    --------------------------------------------------------------------------------#(lf)    -- NEW EXCLUSION LOGIC ENDS#(lf)    --------------------------------------------------------------------------------#(lf)#(lf)    --------------------------------------------------------------------------------#(lf)    -- Temp Table 6: RankedQualifications#(lf)    -- Latest remaining record per employee per qualification library after exclusions#(lf)    --------------------------------------------------------------------------------#(lf)    IF OBJECT_ID('tempdb..#RankedQualifications') IS NOT NULL DROP TABLE #RankedQualifications;#(lf)#(lf)    SELECT#(lf)        qf.fact_employee_qualification_key,#(lf)        qf.dim_employee_key,#(lf)        qf.dim_service_key,#(lf)        qf.service_id,#(lf)        qf.dim_company_key,#(lf)        qf.service_name,#(lf)        qf.expiry_date,#(lf)        qf.issue_date,#(lf)        qf.issuing_organisation,#(lf)        qf.employee_qualification_library,#(lf)        qf.employee_qualification_type,#(lf)        qf.employee_id,#(lf)        qf.company_name,#(lf)        qf.qualification_status,#(lf)        ROW_NUMBER() OVER (#(lf)            PARTITION BY qf.employee_id, qf.employee_qualification_library#(lf)            ORDER BY#(lf)                COALESCE(CAST(qf.issue_date AS DATE), CAST(qf.expiry_date AS DATE), CAST('1900-01-01' AS DATE)) DESC,#(lf)                COALESCE(CAST(qf.expiry_date AS DATE), CAST('9999-12-31' AS DATE)) DESC,#(lf)                CASE UPPER(LTRIM(RTRIM(qf.qualification_status)))#(lf)                    WHEN 'CURRENT' THEN 1#(lf)                    WHEN 'EXPIRING_SOON' THEN 2#(lf)                    WHEN 'AWAITING_APPROVAL' THEN 3#(lf)                    WHEN 'FUTURE' THEN 4#(lf)                    WHEN 'DRAFT' THEN 5#(lf)                    WHEN 'EXPIRED' THEN 6#(lf)                    ELSE 7#(lf)                END,#(lf)                qf.fact_employee_qualification_key DESC#(lf)        ) AS rn#(lf)    INTO #RankedQualifications#(lf)    FROM #QualificationFiltered qf;#(lf)#(lf)    CREATE CLUSTERED INDEX CIX_RankedQualifications_rn_employee#(lf)        ON #RankedQualifications (rn, employee_id, dim_service_key);#(lf)#(lf)    --------------------------------------------------------------------------------#(lf)    -- Temp Table 7: QualificationStatus (row-level detail)#(lf)    --------------------------------------------------------------------------------#(lf)    IF OBJECT_ID('tempdb..#QualificationStatus') IS NOT NULL DROP TABLE #QualificationStatus;#(lf)#(lf)    SELECT#(lf)        rq.fact_employee_qualification_key,#(lf)        ce.dim_employee_key,#(lf)        rq.dim_service_key,#(lf)        rq.service_id,#(lf)        rq.dim_company_key,#(lf)        rq.service_name,#(lf)        rq.employee_id,#(lf)        ce.employee_name,#(lf)        ce.humanforce_url,#(lf)        rq.expiry_date,#(lf)        rq.issue_date,#(lf)        rq.issuing_organisation,#(lf)        rq.employee_qualification_library,#(lf)        rq.qualification_status,#(lf)        CASE#(lf)            WHEN rq.employee_qualification_library = 'Vetting Results and Criminal Conviction Approval'#(lf)                THEN NULL#(lf)            WHEN rq.expiry_date IS NULL#(lf)                THEN NULL#(lf)            ELSE DATEDIFF(DAY, @SnapshotDate, CAST(rq.expiry_date AS DATE))#(lf)        END AS days_until_expiry#(lf)    INTO #QualificationStatus#(lf)    FROM #RankedQualifications rq#(lf)    INNER JOIN #CurrentEmployees ce#(lf)        ON rq.employee_id = ce.employee_id#(lf)    WHERE rq.rn = 1#(lf)    #(lf)    CREATE NONCLUSTERED INDEX IX_QualificationStatus_service_employee#(lf)        ON #QualificationStatus (dim_service_key, employee_id)#(lf)        INCLUDE (employee_name, days_until_expiry, qualification_status, dim_company_key, service_id, service_name, dim_employee_key, employee_qualification_library);#(lf)#(lf)    --------------------------------------------------------------------------------#(lf)    -- Temp Table 8: KaimahiStatus (employee + qualification library level within service)#(lf)    --------------------------------------------------------------------------------#(lf)    IF OBJECT_ID('tempdb..#KaimahiStatus') IS NOT NULL DROP TABLE #KaimahiStatus;#(lf)#(lf)    SELECT#(lf)        qs.dim_company_key,#(lf)        qs.dim_service_key,#(lf)        qs.service_id,#(lf)        qs.service_name,#(lf)        qs.dim_employee_key,#(lf)        qs.employee_id,#(lf)        qs.employee_name,#(lf)        MAX(qs.humanforce_url) AS humanforce_url,#(lf)        qs.employee_qualification_library,#(lf)        MAX(#(lf)            CASE#(lf)                WHEN qs.employee_qualification_library = 'Vetting Results and Criminal Conviction Approval' THEN 1#(lf)                ELSE 0#(lf)            END#(lf)        ) AS has_no_expiry_expected,#(lf)        MAX(#(lf)            CASE#(lf)                WHEN qs.days_until_expiry IS NULL THEN 1#(lf)                ELSE 0#(lf)            END#(lf)        ) AS has_null_days_until_expiry,#(lf)        MAX(#(lf)            CASE#(lf)                WHEN qs.qualification_status = 'EXPIRED' THEN 1#(lf)                ELSE 0#(lf)            END#(lf)        ) AS has_status_expired,#(lf)        MAX(#(lf)            CASE#(lf)                WHEN qs.qualification_status IN ('CURRENT', 'EXPIRING_SOON') THEN 1#(lf)                ELSE 0#(lf)            END#(lf)        ) AS has_status_current_or_expiring,#(lf)        MIN(#(lf)            CASE#(lf)                WHEN qs.days_until_expiry IS NOT NULL#(lf)                    THEN qs.days_until_expiry#(lf)                ELSE NULL#(lf)            END#(lf)        ) AS kpi_value_days,#(lf)        MIN(CAST(qs.expiry_date AS DATE)) AS representative_expiry_date,#(lf)        MAX(qs.qualification_status) AS representative_qualification_status#(lf)    INTO #KaimahiStatus#(lf)    FROM #QualificationStatus qs#(lf)    GROUP BY#(lf)        qs.dim_company_key,#(lf)        qs.dim_service_key,#(lf)        qs.service_id,#(lf)        qs.service_name,#(lf)        qs.dim_employee_key,#(lf)        qs.employee_id,#(lf)        qs.employee_name,#(lf)        qs.employee_qualification_library;#(lf)#(lf)    --------------------------------------------------------------------------------#(lf)    -- Temp Table 9: Selected_KPI#(lf)    --------------------------------------------------------------------------------#(lf)    IF OBJECT_ID('tempdb..#Selected_KPI') IS NOT NULL DROP TABLE #Selected_KPI;#(lf)#(lf)    SELECT TOP 1#(lf)        dim_kpi.kpi_id,#(lf)        dim_kpi.dim_kpi_key,#(lf)        dim_kpi.what_is_measured,#(lf)        dim_kpi.kpi_g_value,#(lf)        dim_kpi.kpi_a_value,#(lf)        dim_kpi.kpi_g_sign,#(lf)        dim_kpi.kpi_a_sign#(lf)    INTO #Selected_KPI#(lf)    FROM edw.dim_kpi#(lf)    WHERE dim_kpi.DWHDMLOperation <> 'D'#(lf)        AND dim_kpi.DWHIsCurrent = 1#(lf)        AND dim_kpi.kpi_id = @KPI_ID#(lf)    ORDER BY dim_kpi.dim_kpi_key DESC;#(lf)#(lf)    --------------------------------------------------------------------------------#(lf)    -- Temp Table 10: final_table#(lf)    --------------------------------------------------------------------------------#(lf)    IF OBJECT_ID('tempdb..#final_table') IS NOT NULL DROP TABLE #final_table;#(lf)#(lf)    SELECT#(lf)        ks.dim_company_key,#(lf)        ks.dim_service_key,#(lf)        ks.service_id,#(lf)        ks.service_name,#(lf)        ks.dim_employee_key,#(lf)        ks.employee_id,#(lf)        ks.employee_name,#(lf)        ks.humanforce_url,#(lf)        ks.employee_qualification_library,#(lf)        ks.has_no_expiry_expected,#(lf)        ks.has_null_days_until_expiry,#(lf)        ks.has_status_expired,#(lf)        ks.has_status_current_or_expiring,#(lf)        ks.representative_expiry_date,#(lf)        ks.representative_qualification_status,#(lf)        CONCAT(@Entity_ID, '_', ks.employee_id, '_', ks.service_id, '_', ks.dim_company_key, '_', ks.employee_qualification_library) AS entity_key,#(lf)        ks.kpi_value_days AS kpi_value#(lf)    INTO #final_table#(lf)    FROM #KaimahiStatus ks;#(lf)#(lf)    CREATE NONCLUSTERED INDEX IX_final_table_service#(lf)        ON #final_table (service_id)#(lf)        INCLUDE (dim_company_key, dim_service_key, employee_id, dim_employee_key, employee_qualification_library, kpi_value, representative_expiry_date, representative_qualification_status);#(lf)#(lf)    --------------------------------------------------------------------------------#(lf)    -- Final SELECT#(lf)    --------------------------------------------------------------------------------#(lf)    SELECT#(lf)        sk.dim_kpi_key,#(lf)        ft.dim_company_key,#(lf)        ft.dim_employee_key,#(lf)        ft.dim_service_key,#(lf)        ft.entity_key,#(lf)        @KPI_ID AS kpi_id,#(lf)        ft.employee_id,#(lf)        ft.service_id,#(lf)        ft.humanforce_url,#(lf)        ft.service_name,#(lf)        ft.employee_qualification_library,#(lf)        ft.kpi_value,#(lf)        CASE#(lf)            WHEN kps.final_kpi_status = 3#(lf)                THEN CONCAT(ft.employee_qualification_library, ' is in date.')#(lf)#(lf)            WHEN kps.final_kpi_status = 2#(lf)                AND msg.is_current_or_expiring = 1#(lf)                AND msg.is_exception_type = 1#(lf)                AND msg.is_service_aligned = 1#(lf)                THEN CONCAT(#(lf)                    'Expiry of ',#(lf)                    ft.employee_qualification_library,#(lf)                    ' is ',#(lf)                    msg.days_until_expiry_text,#(lf)                    ' days away (Expires: ',#(lf)                    msg.expiry_date_text,#(lf)                    '). Check vetting is correct based on Service and request re-validation. Only kaimahi working with Youth services require Exception PV.'#(lf)                )#(lf)#(lf)            WHEN kps.final_kpi_status = 2#(lf)                AND msg.is_current_or_expiring = 1#(lf)                AND msg.is_exception_type = 1#(lf)                AND msg.is_service_aligned = 0#(lf)                THEN CONCAT(#(lf)                    'Expiry of ',#(lf)                    ft.employee_qualification_library,#(lf)                    ' is ',#(lf)                    msg.days_until_expiry_text,#(lf)                    ' days away (Expires: ',#(lf)                    msg.expiry_date_text,#(lf)                    '). Check vetting is correct for a role with incidental/no tangata whaiora contact and request re-validation (requirements changed Q1 2025).'#(lf)                )#(lf)#(lf)            WHEN kps.final_kpi_status = 2#(lf)                AND msg.is_awaiting_approval = 1#(lf)                THEN CONCAT(#(lf)                    'Expiry of ',#(lf)                    ft.employee_qualification_library,#(lf)                    ' is ',#(lf)                    msg.days_until_expiry_text,#(lf)                    ' days away (Expires: ',#(lf)                    msg.expiry_date_text,#(lf)                    '). Re-validation is in progress.'#(lf)                )#(lf)#(lf)            WHEN kps.final_kpi_status = 2#(lf)                THEN CONCAT(#(lf)                    'Expiry of ',#(lf)                    ft.employee_qualification_library,#(lf)                    ' is ',#(lf)                    msg.days_until_expiry_text,#(lf)                    ' days away (Expires: ',#(lf)                    msg.expiry_date_text,#(lf)                    '). Check vetting is correct based on role and request the appropriate validation/re-validation.'#(lf)                )#(lf)#(lf)            WHEN kps.final_kpi_status = 1#(lf)                AND msg.is_police_type = 1#(lf)                AND msg.is_service_aligned = 1#(lf)                AND msg.is_awaiting_approval = 0#(lf)                THEN CONCAT(#(lf)                    ft.employee_qualification_library,#(lf)                    ' has expired (Expired: ',#(lf)                    msg.expiry_date_text,#(lf)                    '). Immediate stand-down is required based on service alignment and request the appropriate validation/re-validation. Only kaimahi working with Youth services require Exception PV.'#(lf)                )#(lf)#(lf)            WHEN kps.final_kpi_status = 1#(lf)                AND msg.is_police_type = 1#(lf)                AND msg.is_service_aligned = 0#(lf)                AND msg.is_awaiting_approval = 0#(lf)                THEN CONCAT(#(lf)                    ft.employee_qualification_library,#(lf)                    ' has expired (Expired: ',#(lf)                    msg.expiry_date_text,#(lf)                    '). Check vetting is correct for a role with incidental/no tangata whaiora contact (requirements changed early 2025) and request the appropriate validation/re-validation.'#(lf)                )#(lf)#(lf)            WHEN kps.final_kpi_status = 1#(lf)                AND msg.is_awaiting_approval = 1#(lf)                AND msg.is_exception_type = 1#(lf)                AND msg.is_service_aligned = 1#(lf)                THEN CONCAT(#(lf)                    ft.employee_qualification_library,#(lf)                    ' has expired (Expired: ',#(lf)                    msg.expiry_date_text,#(lf)                    '). Immediate stand-down required if kaimahi is aligned to a Youth service. Re-validation is in progress.'#(lf)                )#(lf)#(lf)            WHEN kps.final_kpi_status = 1#(lf)                AND msg.is_awaiting_approval = 1#(lf)                AND msg.is_exception_type = 1#(lf)                AND msg.is_service_aligned = 0#(lf)                THEN CONCAT(#(lf)                    ft.employee_qualification_library,#(lf)                    ' has expired (Expired: ',#(lf)                    msg.expiry_date_text,#(lf)                    '). Re-validation is in progress.'#(lf)                )#(lf)#(lf)            WHEN kps.final_kpi_status = 1#(lf)                THEN CONCAT(#(lf)                    ft.employee_qualification_library,#(lf)                    ' has expired (Expired: ',#(lf)                    msg.expiry_date_text,#(lf)                    '). Check vetting is correct based on role and request the appropriate validation/re-validation.'#(lf)                )#(lf)#(lf)            ELSE CONCAT(#(lf)                'Expiry of ',#(lf)                ft.employee_qualification_library,#(lf)                ' is ',#(lf)                msg.days_until_expiry_text,#(lf)                ' days away (Expires: ',#(lf)                msg.expiry_date_text,#(lf)                '). Check vetting is correct based on role and request the appropriate validation/re-validation.'#(lf)            )#(lf)        END AS user_friendly_score_explanation,#(lf)        kps.final_kpi_status AS kpi_status,#(lf)        MIN(kps.final_kpi_status) OVER (#(lf)            PARTITION BY ft.employee_id#(lf)        ) AS overall_status#(lf)    FROM #final_table ft#(lf)    CROSS JOIN #Selected_KPI sk#(lf)    CROSS APPLY (#(lf)        SELECT#(lf)            CASE#(lf)                WHEN ft.has_no_expiry_expected = 1 THEN 3#(lf)                WHEN ft.kpi_value IS NULL THEN 3#(lf)                WHEN (sk.kpi_g_sign = '>=' AND ft.kpi_value >= sk.kpi_g_value)#(lf)                    OR (sk.kpi_g_sign = '>' AND ft.kpi_value > sk.kpi_g_value)#(lf)                    OR (sk.kpi_g_sign = '<=' AND ft.kpi_value <= sk.kpi_g_value)#(lf)                    OR (sk.kpi_g_sign = '<' AND ft.kpi_value < sk.kpi_g_value)#(lf)                    OR (sk.kpi_g_sign = '=' AND ft.kpi_value = sk.kpi_g_value)#(lf)                    THEN 3#(lf)                WHEN (sk.kpi_a_sign = '>=' AND ft.kpi_value >= sk.kpi_a_value)#(lf)                    OR (sk.kpi_a_sign = '>' AND ft.kpi_value > sk.kpi_a_value)#(lf)                    OR (sk.kpi_a_sign = '<=' AND ft.kpi_value <= sk.kpi_a_value)#(lf)                    OR (sk.kpi_a_sign = '<' AND ft.kpi_value < sk.kpi_a_value)#(lf)                    OR (sk.kpi_a_sign = '=' AND ft.kpi_value = sk.kpi_a_value)#(lf)                    THEN 2#(lf)                ELSE 1#(lf)            END AS final_kpi_status#(lf)    ) kps#(lf)    CROSS APPLY (#(lf)        SELECT#(lf)            COALESCE(CAST(ft.kpi_value AS VARCHAR(20)), '0') AS days_until_expiry_text,#(lf)            COALESCE(CONVERT(VARCHAR(10), ft.representative_expiry_date, 103), 'N/A') AS expiry_date_text,#(lf)            CASE#(lf)                WHEN UPPER(COALESCE(ft.representative_qualification_status, '')) IN ('CURRENT', 'EXPIRING_SOON') THEN 1#(lf)                ELSE 0#(lf)            END AS is_current_or_expiring,#(lf)            CASE#(lf)                WHEN UPPER(COALESCE(ft.representative_qualification_status, '')) IN ('AWAITING_APPROVAL') THEN 1#(lf)                ELSE 0#(lf)            END AS is_awaiting_approval,#(lf)            CASE#(lf)                WHEN UPPER(COALESCE(ft.employee_qualification_library, '')) LIKE '%POLICE%' THEN 1#(lf)                ELSE 0#(lf)            END AS is_police_type,#(lf)            CASE#(lf)                WHEN UPPER(COALESCE(ft.employee_qualification_library, '')) LIKE '%EXCEPTION%' THEN 1#(lf)                ELSE 0#(lf)            END AS is_exception_type,#(lf)            1 AS is_service_aligned#(lf)    ) msg#(lf)    ;#(lf)#(lf)    DROP TABLE #final_table;#(lf)    DROP TABLE #Selected_KPI;#(lf)    DROP TABLE #KaimahiStatus;#(lf)    DROP TABLE #QualificationStatus;#(lf)    DROP TABLE #RankedQualifications;#(lf)    DROP TABLE #QualificationFiltered;#(lf)    DROP TABLE #QualificationExclusionAssessment;#(lf)    DROP TABLE #QualificationBase;#(lf)    DROP TABLE #RelevantServices;#(lf)    DROP TABLE #CurrentEmployees;#(lf)"]),
				ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceKaimahi = Text.Replace(columnName, "employee_", "Kaimahi_"),
				            replaceClient = Text.Replace(replaceKaimahi, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, " Id", " ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, each ApplyNamingConventions(_))
				in
				    #"Transformed Column Names"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

