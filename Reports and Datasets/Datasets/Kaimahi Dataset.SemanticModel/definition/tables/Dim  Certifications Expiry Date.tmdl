	partition 'Dim  Certifications Expiry Date' = m
		mode: import
		queryGroup: Dim
		source =
				let
				    Source = #"Role Playing Template Dim Date",
				    ReplacePrefix = (columnName as text) as text =>
				        let
				            prefixedColumn =
				                if Text.Contains(columnName, "Role Playing") then
				                    Text.Replace(columnName, "Role Playing", "Certifications Expiry")
				                else
				                    columnName
				        in
				            prefixedColumn,
				    #"Updated Prefix" = Table.TransformColumnNames(Source, ReplacePrefix)
				in
				    #"Updated Prefix"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Exception

