	column 'Age Ranges'
		dataType: string
		lineageTag: d3d8a764-9997-42df-83f5-24c33390b695
		summarizeBy: none
		sourceColumn: Age Ranges

		annotation SummarizationSetBy = Automatic

	partition 'Dim Kaimahi' = m
		mode: import
		queryGroup: Dim
		source = ```
				let
				    Source = Sql.Database(Server, Database, [Query="SELECT#(lf)    de.[employee_id],#(lf)    de.[employee_name],#(lf)    de.[employee_company_name],#(lf)    de.[employee_company_start_date],#(lf)    de.[employee_company_end_date],#(lf)    de.[employee_gender],#(lf)    de.[employee_age_in_year],#(lf)#(lf)    /* Age Group */#(lf)    CASE#(lf)        WHEN de.[employee_age_in_year] IS NULL THEN 'Unknown'#(lf)        WHEN de.[employee_age_in_year] >= 0#(lf)         AND de.[employee_age_in_year] < 21 THEN ' 0-20'#(lf)        WHEN de.[employee_age_in_year] < 31 THEN ' 21-30'#(lf)        WHEN de.[employee_age_in_year] < 41 THEN ' 31-40'#(lf)        WHEN de.[employee_age_in_year] < 51 THEN ' 41-50'#(lf)        WHEN de.[employee_age_in_year] < 61 THEN ' 51-60'#(lf)        WHEN de.[employee_age_in_year] < 71 THEN ' 61-70'#(lf)        WHEN de.[employee_age_in_year] >= 71 THEN ' 70+'#(lf)        ELSE 'Unknown'#(lf)    END AS [Age Ranges],#(lf)#(lf)    de.[employee_work_type],#(lf)    de.[employee_work_class],#(lf)    de.[employee_job_name],#(lf)    de.[employee_employment_status],#(lf)    de.[employee_is_primary_Job_flag],#(lf)    de.[DWHisCurrent],#(lf)    de.[primary_ethnicity_group],#(lf)    de.[primary_ethnicity_section],#(lf)    deh.[employee_Business_unit_name]#(lf)#(lf)FROM [edw].[vw_dim_employee] de#(lf)#(lf)LEFT JOIN [edw].[vw_dim_employee_hierarchy] deh#(lf)    ON de.employee_id = deh.employee_id#(lf)    AND deh.DWHIsCurrent = 1#(lf)    AND deh.DWHDMLOperation <> 'D'#(lf)#(lf)WHERE#(lf)    de.DWHIsCurrent = 1#(lf)    AND de.DWHDMLOperation <> 'D'#(lf)    AND de.dim_employee_key NOT IN (-1, 0, 1)#(lf)    AND de.employee_work_type <> 'Agency'#(lf)    AND (de.employee_concurrent_job IS NULL #(lf)    OR de.employee_concurrent_job <> 'BOARD MEMBER')#(lf)    AND employee_name NOT LIKE '%TEST%'#(lf)    AND de.employee_id < 999999 ;"]),
				    ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceKaimahi = Text.Replace(columnName, "employee_", "Kaimahi_"),
				            replaceClient = Text.Replace(replaceKaimahi, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHisCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, " Id", " ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, each ApplyNamingConventions(_)),
				    #"Added Custom" = Table.AddColumn(
				        #"Transformed Column Names",
				        "Active Staff Flag",
				        each
				            if
				                [Kaimahi Name] <> "Test Employee" 
				                and [Kaimahi Work Type] <> "Unpaid"
				                and [DWH Is Current] = 1
				                and ([Kaimahi Employment Status] = "Current Staff" or [Kaimahi Employment Status] = "Exiting Staff")
				            then
				                1
				            else
				                0
				    ),
				    #"Renamed Columns" = Table.RenameColumns(#"Added Custom", {{"Active Staff Flag", "Kaimahi is Active Flag"}}),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Renamed Columns", {{"Kaimahi is Active Flag", Int64.Type}}),
				    #"Inserted Merged Column" = Table.AddColumn(#"Changed Type1", "Employee Company Key", each Text.Combine({[Kaimahi Company Name], Text.From([Kaimahi ID], "en-NZ")}, "-"), type text),
				    #"Added Kaimahi Started within 3 months" = Table.AddColumn(
				        #"Inserted Merged Column",
				        "Kaimahi Started within 3 months",
				        each if [Kaimahi Company Start Date] <> null and Date.IsInPreviousNMonths([Kaimahi Company Start Date], 3) then 1 else 0,
				        Int64.Type
				    ),
				    #"Inserted Range" = Table.AddColumn(#"Added Kaimahi Started within 3 months", "Age Group", each 
				    let
				        age = [Kaimahi Age In Year],
				        rangeSize = 10,
				        offset = 5,
				        inclusive = true,
				        group = 
				            if age = null then "Not Set"
				            else if age < 25 then "<25"
				            else if age >= 75 then "75+"
				            else 
				                let
				                    rangeIndex = Number.RoundDown((age - offset) / rangeSize),
				                    groupStart = rangeIndex * rangeSize + offset,
				                    groupEnd = (rangeIndex + 1) * rangeSize + offset - (if inclusive then 1 else 0)
				                in
				                    Text.From(groupStart, "en-NZ") & "-" & Text.From(groupEnd, "en-NZ")
				    in
				        group,
				    type text),
				    #"Tenure Days" = Table.AddColumn(#"Inserted Range", "Tenure Days", each DateTime.LocalNow() - [Kaimahi Company Start Date], type duration),
				    #"Changed Type" = Table.TransformColumnTypes(#"Tenure Days",{{"Tenure Days", Int64.Type}}),
				    #"Added Custom1" = Table.AddColumn(#"Changed Type", "TenureYears", each [Tenure Days] /  365),
				    #"Changed Type2" = Table.TransformColumnTypes(#"Added Custom1",{{"TenureYears", type number}})
				in
				    #"Changed Type2"
				```

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

