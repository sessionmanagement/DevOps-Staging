table Changelog
	lineageTag: 1f05e791-1ef1-4560-b78c-bfb1276ddf93

	measure 'Latest Version' =
			
			VAR LatestChangeID =
			    MAX ( 'Changelog'[Change ID] )
			VAR LatestVersion =
			    MAXX (
			        FILTER ( 'Changelog', 'Changelog'[Change ID] = LatestChangeID ),
			        'Changelog'[Version]
			    )
			RETURN
			    "Kaimahi Dataset - v" & LatestVersion
		lineageTag: 906d8428-5219-483b-a67b-3e3d8c66df79

	column 'Change ID'
		dataType: int64
		formatString: 0
		lineageTag: f7fc1538-5975-47b2-90da-0d77146f6b9f
		summarizeBy: count
		sourceColumn: Change ID

		annotation SummarizationSetBy = Automatic

	column Version
		dataType: string
		lineageTag: 81e4b6eb-11a0-4da5-b26e-92d67febb0a2
		summarizeBy: none
		sourceColumn: Version

		annotation SummarizationSetBy = Automatic

	column 'Change Date'
		dataType: string
		lineageTag: ea817ffe-53ea-4319-87dc-69bc40ed7116
		summarizeBy: none
		sourceColumn: Change Date

		annotation SummarizationSetBy = Automatic

	column 'Changed By'
		dataType: string
		lineageTag: 0ad1fd59-f03f-4175-bac2-70434e3cef9d
		summarizeBy: none
		sourceColumn: Changed By

		annotation SummarizationSetBy = Automatic

	column 'User Story ID'
		dataType: string
		lineageTag: 8a2d5618-6403-4e63-8e7a-edbbcf01c25b
		summarizeBy: none
		sourceColumn: User Story ID

		annotation SummarizationSetBy = Automatic

	column Description
		dataType: string
		lineageTag: 58ee8ad2-abe0-4661-bf20-7cabd0302e69
		summarizeBy: none
		sourceColumn: Description

		annotation SummarizationSetBy = Automatic

	partition Changelog = m
		mode: import
		queryGroup: Changelog
		source = ```
				let
				    // Define the table schema with the entries reversed
				    InitialTable = #table(
				        {"Version", "Change Date", "Changed By", "User Story ID", "Description"},
				        {
				            
				            // Add new entries at the top here
				            {
				                "3.1.0", /* Version */
				                #date(2026, 10, 9),  /* Change Date */
				                "Mike G",  /* Changed By */
				                "#13282",  /* User Story ID */
				                "Migrated RLS to edw.row_level_security_general (RLS_type 'Employee'), replacing the inline dim_employee_hierarchy leader query, and removed the unused RB Structure RLS query and three unsourced RLS columns. Cost-allocated managers gain kaimahi under leaders in their allocated business unit; depth-9 staff lose their own row, and past staff and non-current leaders drop out." /* Description */
				            },
				            {
				                "3.0.0", /* Version */
				                #date(2026, 10, 06),  /* Change Date */
				                "Thijs B",  /* Changed By */
				                "#14321",  /* User Story ID */
				                "NEW EDW based Kaimahi Dataset. " /* Description */
				            },
				            {
				                "2.0.4", /* Version */
				                #date(2026, 07, 14),  /* Change Date */
				                "Greg H",  /* Changed By */
				                "#14471",  /* User Story ID */
				                "Changed the Den table to only grab the latest name for a course, program etc as it was showing the historical name " /* Description */
				            },
				            {
				                "2.0.3", /* Version */
				                #date(2026, 07, 14),  /* Change Date */
				                "Greg H",  /* Changed By */
				                "#13874",  /* User Story ID */
				                "Removed unused tables and columns " /* Description */
				            },
				            {
				                "2.0.2", /* Version */
				                #date(2025, 05, 27),  /* Change Date */
				                "Greg H",  /* Changed By */
				                "#10313",  /* User Story ID */
				                "Removed references to edw from dwh change " /* Description */
				            },
				            {
				                "2.0.1", /* Version */
				                #date(2025, 03, 04),  /* Change Date */
				                "Greg H",  /* Changed By */
				                "#9736",  /* User Story ID */
				                "Added new 'Not Due' Status and implemented ino report " /* Description */
				            },
				            {
				                "2.0.0", /* Version */
				                #date(2024, 11, 27),  /* Change Date */
				                "Mike",  /* Changed By */
				                "#9367",  /* User Story ID */
				                "New IntelliHR Reporting Line RLS (using dim people hierarchy)"  /* Description */
				            },
				            {
				                "1.1.2", /* Version */
				                #date(2024, 11, 25),  /* Change Date */
				                "Mike",  /* Changed By */
				                "#9355",  /* User Story ID */
				                "dim_employee_key bypass and Mind and Body fix"  /* Description */
				            },
				            {
				                "1.1.1", /* Version */
				                #date(2024, 11, 25),  /* Change Date */
				                "Mike",  /* Changed By */
				                "#9355",  /* User Story ID */
				                "New RLS 2.0 - RLS - New RB Structure ALL services"  /* Description */
				            },
				            {
				                "1.1.0", /* Version */
				                #date(2024, 11, 22),  /* Change Date */
				                "Mike",  /* Changed By */
				                "#9355",  /* User Story ID */
				                "New RLS 2.0"  /* Description */
				            },
				            {
				                "1.0.7", /* Version */
				                #date(2024, 11, 18),  /* Date */
				                "Greg H",  /* Changed By */
				                "9329",  /* User Story */
				                "Fixing number of Kaimahi completed all training measure"  /* Description */
				            },
				            {
				                "1.0.6", /* Version */
				                #date(2024, 11, 05),  /* Date */
				                "Greg H",  /* Changed By */
				                "8584",  /* User Story */
				                "Renaming some tables for better consistency"  /* Description */
				            },
				            {
				                "1.0.5", /* Version */
				                #date(2024, 11, 04),  /* Date */
				                "Mike G",  /* Changed By */
				                "6671",  /* User Story */
				                "New RLS"  /* Description */
				            },
				            {
				                "1.0.4", /* Version */
				                #date(2024, 11, 04),  /* Date */
				                "Mike G",  /* Changed By */
				                "6671",  /* User Story */
				                "Thinning of Dataset"  /* Description */
				            },
				            {
				                "1.0.3", /* Version */
				                #date(2024, 7, 26),  /* Date */
				                "Greg H",  /* Changed By */
				                "6671",  /* User Story */
				                "Added FiltersApplied measure"  /* Description */
				            },
				            {
				                "1.0.2", /* Version */
				                #date(2024, 7, 26),  /* Date */
				                "Greg H",  /* Changed By */
				                "6671",  /* User Story */
				                "Brought in the Business Unit Hierarchy, program and certification dims and facts"  /* Description */
				            },
				            {
				                "1.0.1", /* Version */
				                #date(2024, 7, 26),  /* Date */
				                "Greg H",  /* Changed By */
				                "6671",  /* User Story */
				                "Started the Kaimahi Dataset bringing in Core Akoranga Dims and Facts from EDW"  /* Description */
				            }
				        }
				    ),
				
				    // Reverse the order of the rows so new entries are at the top
				    ReversedTable = Table.ReverseRows(InitialTable),
				
				    // Add an Index column to generate incremental numbers
				    TableWithIndex = Table.AddIndexColumn(ReversedTable, "Change ID", 1, 1, Int64.Type),
				
				    // Reorder the columns to place ChangeID first
				    ReorderedColumns = Table.ReorderColumns(TableWithIndex, {"Change ID", "Version", "Change Date", "Changed By", "User Story ID", "Description"})
				in
				    ReorderedColumns
				```

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

