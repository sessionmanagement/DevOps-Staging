	partition fact_pay_run = m
		mode: import
		queryGroup: Fact
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="#(lf)WITH pay_slip_items AS#(lf)(#(lf)    SELECT#(lf)        psi.fact_employee_pay_slip_item_key,#(lf)        psi.employee_id,#(lf)        psi.dim_employee_key,#(lf)        psi.company_code,#(lf)        ps.pay_period_start_date,#(lf)        ps.pay_period_end_date,#(lf)        UPPER(LTRIM(RTRIM(psi.item_type_detail))) AS item_type_detail_norm,#(lf)        CAST(ROUND(COALESCE(psi.item_amount, 0), 2) AS DECIMAL(18,2)) AS item_amount_2dp,#(lf)        psi.item_summary,#(lf)        ROW_NUMBER() OVER#(lf)        (#(lf)            PARTITION BY#(lf)                psi.employee_id,#(lf)                psi.company_code,#(lf)                ps.pay_period_start_date,#(lf)                ps.pay_period_end_date,#(lf)                UPPER(LTRIM(RTRIM(psi.item_type_detail))),#(lf)                CAST(ROUND(COALESCE(psi.item_amount, 0), 2) AS DECIMAL(18,2))#(lf)            ORDER BY#(lf)                psi.pay_packet_id,#(lf)                psi.pay_packet_row_id,#(lf)                psi.fact_employee_pay_slip_item_key#(lf)        ) AS match_seq#(lf)    FROM edw.fact_employee_pay_slip_item AS psi#(lf)    INNER JOIN edw.fact_employee_pay_slip AS ps#(lf)        ON ps.pay_packet_id = psi.pay_packet_id#(lf)       AND ps.employee_id = psi.employee_id#(lf)       AND ps.company_code = psi.company_code#(lf)    WHERE ISNULL(psi.DWHDMLOperation, '') <> 'D'#(lf)      AND ISNULL(ps.DWHDMLOperation, '') <> 'D'#(lf)),#(lf)pay_run_match_base AS#(lf)(#(lf)    SELECT#(lf)        pri.fact_employee_pay_run_item_key,#(lf)        pri.employee_id,#(lf)        pri.dim_employee_key,#(lf)        pri.company_code,#(lf)        pri.pay_period_start_date,#(lf)        pri.pay_period_end_date,#(lf)        UPPER(LTRIM(RTRIM(pri.pay_component_name))) AS pay_component_name_norm,#(lf)        CAST(ROUND(COALESCE(pri.total_amount, 0), 2) AS DECIMAL(18,2)) AS total_amount_2dp,#(lf)        ROW_NUMBER() OVER#(lf)        (#(lf)            PARTITION BY#(lf)                pri.employee_id,#(lf)                pri.company_code,#(lf)                pri.pay_period_start_date,#(lf)                pri.pay_period_end_date,#(lf)                UPPER(LTRIM(RTRIM(pri.pay_component_name))),#(lf)                CAST(ROUND(COALESCE(pri.total_amount, 0), 2) AS DECIMAL(18,2))#(lf)            ORDER BY#(lf)                pri.pay_run_id,#(lf)                pri.fact_employee_pay_run_item_key#(lf)        ) AS match_seq#(lf)    FROM edw.fact_employee_pay_run_item AS pri#(lf)),#(lf)matched_item_summary AS#(lf)(#(lf)    SELECT#(lf)        pri.fact_employee_pay_run_item_key,#(lf)        psi.item_summary#(lf)    FROM pay_run_match_base AS pri#(lf)    LEFT JOIN pay_slip_items AS psi#(lf)        ON psi.employee_id = pri.employee_id#(lf)       AND psi.company_code = pri.company_code#(lf)       AND psi.pay_period_start_date = pri.pay_period_start_date#(lf)       AND psi.pay_period_end_date = pri.pay_period_end_date#(lf)       AND psi.item_type_detail_norm = pri.pay_component_name_norm#(lf)       AND psi.item_amount_2dp = pri.total_amount_2dp#(lf)       AND psi.match_seq = pri.match_seq#(lf)),#(lf)base_result_raw AS#(lf)(#(lf)    SELECT#(lf)        pri.fact_employee_pay_run_item_key,#(lf)        pri.hours_amount,#(lf)        mis.item_summary#(lf)    FROM edw.fact_employee_pay_run_item AS pri#(lf)    LEFT JOIN matched_item_summary AS mis#(lf)        ON mis.fact_employee_pay_run_item_key = pri.fact_employee_pay_run_item_key#(lf)),#(lf)unit_resolved AS#(lf)(#(lf)    SELECT#(lf)        br.fact_employee_pay_run_item_key,#(lf)        br.hours_amount,#(lf)        br.item_summary,#(lf)        pv.hours_value,#(lf)        pv.days_value,#(lf)        pv.weeks_value,#(lf)        CASE#(lf)            WHEN mv.hours_matches = 1 THEN 'Hours'#(lf)            WHEN mv.days_matches = 1 THEN 'Days'#(lf)            WHEN mv.weeks_matches = 1 THEN 'Weeks'#(lf)            WHEN mv.unit_count = 1 AND pv.hours_value IS NOT NULL THEN 'Hours'#(lf)            WHEN mv.unit_count = 1 AND pv.days_value IS NOT NULL THEN 'Days'#(lf)            WHEN mv.unit_count = 1 AND pv.weeks_value IS NOT NULL THEN 'Weeks'#(lf)            ELSE ''#(lf)        END AS [Unit of time]#(lf)    FROM base_result_raw AS br#(lf)    OUTER APPLY#(lf)    (#(lf)        SELECT#(lf)            ' ' + LOWER(#(lf)                REPLACE(#(lf)                    REPLACE(#(lf)                        REPLACE(#(lf)                            REPLACE(#(lf)                                REPLACE(COALESCE(br.item_summary, ''), '(', ' '),#(lf)                            ')', ' '),#(lf)                        '@', ' '),#(lf)                    ',', ' '),#(lf)                CHAR(9), ' ')#(lf)            ) + ' ' AS summary_norm,#(lf)            CASE#(lf)                WHEN br.hours_amount IS NOT NULL#(lf)                    THEN CAST(ROUND(br.hours_amount, 5) AS DECIMAL(18,5))#(lf)                ELSE NULL#(lf)            END AS hours_amount_5dp#(lf)    ) AS n#(lf)    OUTER APPLY#(lf)    (#(lf)        SELECT#(lf)            COALESCE(NULLIF(CHARINDEX(' hours ', n.summary_norm), 0), NULLIF(CHARINDEX(' hour ', n.summary_norm), 0)) AS hours_pos,#(lf)            COALESCE(NULLIF(CHARINDEX(' days ',  n.summary_norm), 0), NULLIF(CHARINDEX(' day ',  n.summary_norm), 0)) AS days_pos,#(lf)            COALESCE(NULLIF(CHARINDEX(' weeks ', n.summary_norm), 0), NULLIF(CHARINDEX(' week ', n.summary_norm), 0)) AS weeks_pos#(lf)    ) AS p#(lf)    OUTER APPLY#(lf)    (#(lf)        SELECT#(lf)            LTRIM(RTRIM(LEFT(n.summary_norm, p.hours_pos - 1))) AS before_hours,#(lf)            LTRIM(RTRIM(LEFT(n.summary_norm, p.days_pos - 1)))  AS before_days,#(lf)            LTRIM(RTRIM(LEFT(n.summary_norm, p.weeks_pos - 1))) AS before_weeks#(lf)    ) AS b#(lf)    OUTER APPLY#(lf)    (#(lf)        SELECT#(lf)            TRY_CONVERT#(lf)            (#(lf)                DECIMAL(18,5),#(lf)                REVERSE#(lf)                (#(lf)                    LEFT#(lf)                    (#(lf)                        REVERSE(COALESCE(b.before_hours, '')),#(lf)                        CHARINDEX(' ', REVERSE(COALESCE(b.before_hours, '')) + ' ') - 1#(lf)                    )#(lf)                )#(lf)            ) AS hours_value,#(lf)            TRY_CONVERT#(lf)            (#(lf)                DECIMAL(18,5),#(lf)                REVERSE#(lf)                (#(lf)                    LEFT#(lf)                    (#(lf)                        REVERSE(COALESCE(b.before_days, '')),#(lf)                        CHARINDEX(' ', REVERSE(COALESCE(b.before_days, '')) + ' ') - 1#(lf)                    )#(lf)                )#(lf)            ) AS days_value,#(lf)            TRY_CONVERT#(lf)            (#(lf)                DECIMAL(18,5),#(lf)                REVERSE#(lf)                (#(lf)                    LEFT#(lf)                    (#(lf)                        REVERSE(COALESCE(b.before_weeks, '')),#(lf)                        CHARINDEX(' ', REVERSE(COALESCE(b.before_weeks, '')) + ' ') - 1#(lf)                    )#(lf)                )#(lf)            ) AS weeks_value#(lf)    ) AS pv#(lf)    OUTER APPLY#(lf)    (#(lf)        SELECT#(lf)            CASE WHEN pv.hours_value = n.hours_amount_5dp THEN 1 ELSE 0 END AS hours_matches,#(lf)            CASE WHEN pv.days_value  = n.hours_amount_5dp THEN 1 ELSE 0 END AS days_matches,#(lf)            CASE WHEN pv.weeks_value = n.hours_amount_5dp THEN 1 ELSE 0 END AS weeks_matches,#(lf)            CASE WHEN pv.hours_value IS NOT NULL THEN 1 ELSE 0 END#(lf)          + CASE WHEN pv.days_value  IS NOT NULL THEN 1 ELSE 0 END#(lf)          + CASE WHEN pv.weeks_value IS NOT NULL THEN 1 ELSE 0 END AS unit_count#(lf)    ) AS mv#(lf)),#(lf)latest_service AS#(lf)(#(lf)    SELECT#(lf)        ds.dim_service_key,#(lf)        ds.service_code,#(lf)        ds.service_name,#(lf)        ROW_NUMBER() OVER#(lf)        (#(lf)            PARTITION BY ds.service_code#(lf)            ORDER BY#(lf)                ds.dwheffectivefrom DESC,#(lf)                ds.dim_service_key DESC#(lf)        ) AS rn#(lf)    FROM edw.vw_dim_service AS ds#(lf)    WHERE ISNULL(ds.DWHDMLOperation, '') <> 'D'#(lf)),#(lf)#(lf)final_calc AS#(lf)(#(lf)    SELECT#(lf)        ur.fact_employee_pay_run_item_key,#(lf)        CASE#(lf)            WHEN NULLIF(ur.[Unit of time], '') IS NOT NULL THEN ur.[Unit of time]#(lf)            WHEN ur.hours_amount IS NOT NULL THEN 'Hours'#(lf)            ELSE ''#(lf)        END AS [Unit of time],#(lf)        ur.item_summary,#(lf)        CASE#(lf)            WHEN ur.[Unit of time] = 'Hours' THEN ur.hours_value#(lf)            WHEN ur.[Unit of time] = 'Days'  THEN ur.days_value * 8#(lf)            WHEN ur.[Unit of time] = 'Weeks' THEN ur.weeks_value * 40#(lf)            WHEN NULLIF(ur.[Unit of time], '') IS NULL#(lf)             AND ur.hours_amount IS NOT NULL THEN CAST(ur.hours_amount AS DECIMAL(18,5))#(lf)            ELSE NULL#(lf)        END AS Total_Hours#(lf)    FROM unit_resolved AS ur#(lf))#(lf)SELECT#(lf)    pri.dim_employee_key,#(lf)    pri.employee_id,#(lf)    pri.pay_component_name,#(lf)    pri.pay_component_category,#(lf)    pri.pay_period_start_date,#(lf)    pri.pay_period_end_date,#(lf)    pri.hours_amount,#(lf)    pri.sub_department,#(lf)    pri.sub_department_code,#(lf)    ds.dim_service_key,#(lf)    pri.remuneration_type,#(lf)    pri.work_class,#(lf)    pri.work_type,#(lf)    DATENAME(MONTH, pay_period_end_date) AS [Month],#(lf)    MONTH(pay_period_end_date) AS [Month Number],#(lf)#(lf)   -- Below Logic is removed on Jay's request. Pae Awhina 130247. Finance uses the month of the pay period end date to decide what month to report it in.#(lf)    #(lf)    --CASE#(lf)    --    WHEN MONTH(pay_period_start_date) = MONTH(pay_period_end_date) THEN#(lf)    --        DATENAME(MONTH, pay_period_start_date)#(lf)    --    ELSE#(lf)    --        CASE#(lf)    --            WHEN DATEDIFF(#(lf)    --                     DAY,#(lf)    --                     pay_period_start_date,#(lf)    --                     EOMONTH(pay_period_start_date)#(lf)    --                 )#(lf)    --                 >= DAY(pay_period_end_date)#(lf)    --            THEN DATENAME(MONTH, pay_period_start_date)#(lf)    --            ELSE DATENAME(MONTH, pay_period_end_date)#(lf)    --        END#(lf)    --END AS [Month],#(lf)    fc.[Unit of time],#(lf)    fc.Total_Hours,#(lf)    e.[employee_job_name]#(lf)FROM edw.fact_employee_pay_run_item AS pri#(lf)#(lf)LEFT JOIN final_calc AS fc#(lf)    ON fc.fact_employee_pay_run_item_key = pri.fact_employee_pay_run_item_key#(lf)#(lf)LEFT JOIN edw.vw_dim_employee AS e#(lf)    ON pri.dim_employee_key = e.dim_employee_key#(lf)#(lf)LEFT JOIN latest_service AS ds#(lf)    ON pri.sub_department_code = ds.service_code#(lf)   AND ds.rn = 1#(lf)#(lf)WHERE fc.Total_Hours IS NOT NULL#(lf)#(lf)ORDER BY#(lf)    pri.pay_run_id,#(lf)    pri.employee_id,#(lf)    pri.pay_component_code,#(lf)    pri.fact_employee_pay_run_item_key;#(lf)"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{ {"pay_period_start_date", type date}, {"pay_period_end_date", type date}})
				in
				    #"Changed Type"

