	partition fact_approved_shifts_non_leave = m
		mode: import
		source = ```
				let
				    Source = Sql.Database(Server, Database, [Query="DECLARE @StartDate DATE = '20230101';#(lf)-- Set @StartDate to NULL to return all available EDW history.#(lf)#(lf);WITH fact_candidates AS#(lf)(#(lf)    SELECT#(lf)        eh.time_sheet_entry_id AS timesheet_id,#(lf)#(lf)        -- Closest available EDW equivalents#(lf)        CAST(0 AS BIT) AS is_leave,#(lf)        CAST(NULL AS NVARCHAR(36)) AS role_id,#(lf)        eh.fact_hours_worked_role AS role_name,#(lf)        eh.fact_hours_worked_approval_status AS approval_status,#(lf)        eh.fact_hours_worked_employee_number AS employee_id,#(lf)        eh.fact_hours_worked_payroll_category_id AS work_type_id,#(lf)        pc.payroll_category_name AS work_type_name,#(lf)#(lf)        start_date.calendar_date AS start_date,#(lf)        end_date.calendar_date AS end_date,#(lf)#(lf)        CASE#(lf)            WHEN start_date.calendar_date IS NOT NULL#(lf)             AND start_time.[time] IS NOT NULL#(lf)            THEN DATEADD(#(lf)                SECOND,#(lf)                DATEDIFF(#(lf)                    SECOND,#(lf)                    CAST('00:00:00' AS TIME),#(lf)                    start_time.[time]#(lf)                ),#(lf)                CAST(start_date.calendar_date AS DATETIME2)#(lf)            )#(lf)        END AS start_datetime,#(lf)#(lf)        CASE#(lf)            WHEN end_date.calendar_date IS NOT NULL#(lf)             AND end_time.[time] IS NOT NULL#(lf)            THEN DATEADD(#(lf)                SECOND,#(lf)                DATEDIFF(#(lf)                    SECOND,#(lf)                    CAST('00:00:00' AS TIME),#(lf)                    end_time.[time]#(lf)                ),#(lf)                CAST(end_date.calendar_date AS DATETIME2)#(lf)            )#(lf)        END AS end_datetime,#(lf)#(lf)        MAX(#(lf)            CASE#(lf)                WHEN pc.payroll_category_hours_worked_flag = 1#(lf)                THEN 1#(lf)                ELSE 0#(lf)            END#(lf)        ) OVER#(lf)        (#(lf)            PARTITION BY eh.time_sheet_entry_id#(lf)        ) AS has_hours_worked_category,#(lf)#(lf)        ROW_NUMBER() OVER#(lf)        (#(lf)            PARTITION BY eh.time_sheet_entry_id#(lf)            ORDER BY#(lf)                CASE#(lf)                    WHEN pc.payroll_category_hours_worked_flag = 1#(lf)                    THEN 0#(lf)                    ELSE 1#(lf)                END,#(lf)                eh.fact_hours_worked_total_duration DESC,#(lf)                eh.fact_employee_hours_worked_key#(lf)        ) AS category_rank#(lf)    FROM [edw].[fact_employee_hours_worked] AS eh#(lf)#(lf)    LEFT JOIN [edw].[dim_payroll_category] AS pc#(lf)        ON pc.dim_payroll_category_key =#(lf)           eh.dim_payroll_category_key#(lf)       AND pc.DWHDMLOperation <> 'D'#(lf)#(lf)    LEFT JOIN [edw].[dim_date] AS start_date#(lf)        ON start_date.dim_date_key =#(lf)           eh.dim_shift_start_date_key#(lf)#(lf)    LEFT JOIN [edw].[dim_date] AS end_date#(lf)        ON end_date.dim_date_key =#(lf)           eh.dim_shift_end_date_key#(lf)#(lf)    LEFT JOIN [edw].[dim_time] AS start_time#(lf)        ON start_time.dim_time_key =#(lf)           eh.dim_shift_start_time_key#(lf)#(lf)    LEFT JOIN [edw].[dim_time] AS end_time#(lf)        ON end_time.dim_time_key =#(lf)           eh.dim_shift_end_time_key#(lf)#(lf)    WHERE eh.DWHIsCurrent = 1#(lf)      AND eh.DWHDMLOperation <> 'D'#(lf)      AND eh.fact_hours_worked_approval_status = 'APPROVED'#(lf)      AND#(lf)      (#(lf)          eh.fact_hours_worked_role NOT LIKE 'On Call%'#(lf)          OR eh.fact_hours_worked_role IS NULL#(lf)      )#(lf)      AND#(lf)      (#(lf)          eh.fact_hours_worked_role <> 'Test'#(lf)          OR eh.fact_hours_worked_role IS NULL#(lf)      )#(lf)      AND#(lf)      (#(lf)          @StartDate IS NULL#(lf)          OR start_date.calendar_date > @StartDate#(lf)      )#(lf)),#(lf)t1 AS#(lf)(#(lf)    SELECT#(lf)        timesheet_id,#(lf)        is_leave,#(lf)        role_id,#(lf)        role_name,#(lf)        approval_status,#(lf)        employee_id,#(lf)        work_type_id,#(lf)        work_type_name,#(lf)        start_date,#(lf)        end_date,#(lf)        start_datetime,#(lf)        end_datetime#(lf)    FROM fact_candidates#(lf)    WHERE category_rank = 1#(lf)      AND has_hours_worked_category = 1#(lf)),#(lf)t2 AS#(lf)(#(lf)    SELECT#(lf)        t1.*,#(lf)        LAG(end_datetime) OVER#(lf)        (#(lf)            PARTITION BY employee_id, work_type_id#(lf)            ORDER BY start_datetime, timesheet_id#(lf)        ) AS prev_end_datetime#(lf)    FROM t1#(lf)),#(lf)t3 AS#(lf)(#(lf)    SELECT#(lf)        t2.*,#(lf)#(lf)        DATEDIFF(#(lf)            MINUTE,#(lf)            start_datetime,#(lf)            end_datetime#(lf)        ) AS shift_length_mins,#(lf)#(lf)        DATEDIFF(#(lf)            MINUTE,#(lf)            prev_end_datetime,#(lf)            start_datetime#(lf)        ) AS time_since_last_shift_mins,#(lf)#(lf)        CEILING(#(lf)            CAST(#(lf)                DATEDIFF(#(lf)                    MINUTE,#(lf)                    start_datetime,#(lf)                    end_datetime#(lf)                ) AS FLOAT#(lf)            ) / 60#(lf)        ) AS shift_length_hours,#(lf)#(lf)        DATEDIFF(#(lf)            HOUR,#(lf)            prev_end_datetime,#(lf)            start_datetime#(lf)        ) AS time_since_last_shift_hours,#(lf)#(lf)        DATEPART(WEEKDAY, start_date) AS [day],#(lf)        CAST(1 AS INT) AS [count],#(lf)#(lf)        CASE#(lf)            WHEN prev_end_datetime IS NULL THEN 1#(lf)            WHEN DATEDIFF(#(lf)                    HOUR,#(lf)                    prev_end_datetime,#(lf)                    start_datetime#(lf)                 ) >= 2#(lf)            THEN 1#(lf)            ELSE 0#(lf)        END AS new_group_flag#(lf)    FROM t2#(lf)),#(lf)t4 AS#(lf)(#(lf)    SELECT#(lf)        t3.*,#(lf)#(lf)        SUM(new_group_flag) OVER#(lf)        (#(lf)            PARTITION BY employee_id, work_type_id#(lf)            ORDER BY start_datetime, timesheet_id#(lf)            ROWS BETWEEN UNBOUNDED PRECEDING#(lf)                     AND CURRENT ROW#(lf)        ) AS group_id#(lf)    FROM t3#(lf)),#(lf)t5 AS#(lf)(#(lf)    SELECT#(lf)        t4.*,#(lf)#(lf)        CONCAT(#(lf)            employee_id,#(lf)            '-',#(lf)            work_type_id,#(lf)            '-',#(lf)            group_id#(lf)        ) AS group_unique_id#(lf)    FROM t4#(lf))#(lf)SELECT#(lf)    t5.*,#(lf)#(lf)    SUM(shift_length_hours) OVER#(lf)    (#(lf)        PARTITION BY#(lf)            employee_id,#(lf)            work_type_id,#(lf)            group_id#(lf)        ORDER BY#(lf)            start_datetime,#(lf)            timesheet_id#(lf)        ROWS BETWEEN UNBOUNDED PRECEDING#(lf)                 AND CURRENT ROW#(lf)    ) AS shift_length_cumulative,#(lf)#(lf)    ROW_NUMBER() OVER#(lf)    (#(lf)        PARTITION BY#(lf)            employee_id,#(lf)            work_type_id,#(lf)            group_id#(lf)        ORDER BY#(lf)            start_datetime,#(lf)            timesheet_id#(lf)    ) AS number_of_shifts_in_cumulative_sum#(lf)FROM t5#(lf)ORDER BY#(lf)    group_id,#(lf)    employee_id,#(lf)    start_datetime,#(lf)    timesheet_id;"])
				, ApplyNamingConventions = (columnName as text) as text =>
				        let
				            replaceKaimahi = Text.Replace(columnName, "employee_", "Kaimahi_"),
				            replaceClient = Text.Replace(replaceKaimahi, "client_", "Tangata_Whaiora_"),
				            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
				            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
				            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
				            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
				            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
				            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
				            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHisCurrent", "DWH Is Current"),
				            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
				            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
				            capitaliseWords = Text.Proper(renameDWHSourceSystem),
				            capitaliseID = Text.Replace(capitaliseWords, " Id", " ID"),
				            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
				            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH")
				        in
				            capitaliseDWH,
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, each ApplyNamingConventions(_))
				
				   , #"Added Custom" = Table.AddColumn(
				    #"Transformed Column Names", 
				    "Start Date & Time", 
				    each DateTime.ToText([Start Datetime], "ddd dd MMM, yyyy (h:mm tt)", "en-US")
				),
				    #"Added Custom1" = Table.AddColumn(
				    #"Added Custom", 
				    "End Date Time", 
				    each DateTime.ToText([End Datetime], "ddd dd MMM, yyyy (h:mm tt)", "en-US")
				),
				    #"Merged Queries" = Table.NestedJoin(#"Added Custom1", {"Group Unique ID"}, working_longest_approved_shifts, {"Group Unique ID"}, "working_longest_approved_shifts", JoinKind.LeftOuter),
				    #"Expanded working_longest_approved_shifts" = Table.ExpandTableColumn(#"Merged Queries", "working_longest_approved_shifts", {"LongestShift"}, {"LongestShift"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Expanded working_longest_approved_shifts",{{"Kaimahi ID", Int64.Type}})
				in
				    #"Changed Type"
				```

