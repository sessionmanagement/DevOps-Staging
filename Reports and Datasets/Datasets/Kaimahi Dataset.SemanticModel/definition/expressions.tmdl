expression 'Role Playing Template Dim Date' =
		let
		    Source = #"Dim Date",
		    AddPrefixToColumns = (columnName as text) as text =>
		        let
		            prefixedColumn = "Role Playing " & columnName
		        in
		            prefixedColumn,
		    #"Prefixed Column Names" = Table.TransformColumnNames(Source, each AddPrefixToColumns(_))
		in
		    #"Prefixed Column Names"
	lineageTag: 6a8dc7fd-1ea8-4273-acb2-b146241ba9b7
	queryGroup: Dates

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression 'RLS - New Intelli Structure' =
		let
		    Source = Sql.Database(Server, Database, [Query="SELECT DISTINCT#(lf)    [mapped_employee_id] AS [Employee ID],#(lf)    [email] AS [User Principal Name],#(lf)    [employee_id] AS [Manager ID]#(lf)FROM [edw].[row_level_security_general]#(lf)WHERE [RLS_type] = 'Employee'#(lf)    AND [email] IS NOT NULL#(lf)    AND [mapped_employee_id] IS NOT NULL"]),
		    #"Lowercased Text" = Table.TransformColumns(Source, {{"User Principal Name", each Text.Trim(Text.Lower(_)), type text}}),
		    #"Changed Type" = Table.TransformColumnTypes(#"Lowercased Text", {{"Employee ID", Int64.Type}, {"Manager ID", Int64.Type}}),
		    #"Removed Duplicates" = Table.Distinct(#"Changed Type")
		in
		    #"Removed Duplicates"
	lineageTag: 98fa3334-5e91-4940-a2b1-59cdeb5b5266
	queryGroup: 'Row Level Security'

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

