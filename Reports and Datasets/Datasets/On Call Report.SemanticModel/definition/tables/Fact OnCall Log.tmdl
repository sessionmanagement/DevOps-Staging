	partition 'Fact OnCall Log' = m
		mode: import
		source =
				let
				    Source = FactOnCallLog,
				    // Add in Region
				    Merged1 = Table.NestedJoin(Source, {"ID"}, DimRegion, {"ID"}, "DimRegion", JoinKind.LeftOuter),
				    Expand1 = Table.ExpandTableColumn(Merged1, "DimRegion", {"Region"}, {"Region"}),
				    // Add in Service
				    Merged2 = Table.NestedJoin(Expand1, {"ID"}, DimService, {"ID"}, "DimService", JoinKind.LeftOuter),
				    Expand2 = Table.ExpandTableColumn(Merged2, "DimService", {"Service"}, {"Service"}),
				    // Add in Category
				    Merged3 = Table.NestedJoin(Expand2, {"ID"}, DimCategory, {"ID"}, "DimCategory", JoinKind.LeftOuter),
				    Expand3 = Table.ExpandTableColumn(Merged3, "DimCategory", {"Category"}, {"Category"}),
				    // Add in On Call Staff Member
				    Merged4 = Table.NestedJoin(Expand3, {"ID"}, DimOnCallStaffMember, {"ID"}, "DimOnCallStaffMember", JoinKind.LeftOuter),
				    Expand4 = Table.ExpandTableColumn(Merged4, "DimOnCallStaffMember", {"On Call Staff Member"}, {"On Call Staff Member"}),
				    // Add in Created By
				    Merged5 = Table.NestedJoin(Expand4, {"ID"}, DimCreatedBy, {"ID"}, "DimCreatedBy", JoinKind.LeftOuter),
				    Expand5 = Table.ExpandTableColumn(Merged5, "DimCreatedBy", {"Created By"}, {"Created By"}),
				    // Add in Escalated To
				    Merged6 = Table.NestedJoin(Expand5, {"ID"}, DimEscalatedTo, {"ID"}, "DimEscalatedTo", JoinKind.LeftOuter),
				    Expand6 = Table.ExpandTableColumn(Merged6, "DimEscalatedTo", {"Escalated To"}, {"Escalated To"})
				in
				    Expand6

