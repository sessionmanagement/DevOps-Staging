model Model
	culture: en-NZ
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-NZ
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Common Components'

	annotation PBI_QueryGroupOrder = 2

queryGroup 'Primary Datasets'

	annotation PBI_QueryGroupOrder = 2

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Dim Date","_Measures","_Report Components","Server","Database","LastRefreshed","Changelog","Fact OnCall Log","Fact OnCall Log (Dev)","DataEntry - OnCallLog","DimRegion","DimService","DimCategory","DimOnCallStaffMember","DimCreatedBy","FactOnCallLog","DimEscalatedTo"]

annotation PBI_ProTooling = ["TMDLView_Desktop","MCP-PBIModeling","DevMode"]

annotation __TEdtr = 1

ref table 'Dim Date'
ref table _Measures
ref table '_Report Components'
ref table LastRefreshed
ref table Changelog
ref table 'Fact OnCall Log'

ref cultureInfo en-NZ

