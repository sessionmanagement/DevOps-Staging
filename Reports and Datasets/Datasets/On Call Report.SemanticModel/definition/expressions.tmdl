/// Interim import of OnCallLog CSV export for Epic #12794 / User Story #13590.
expression 'Fact OnCall Log (Dev)' =
		let
		    Source = Csv.Document(
		        File.Contents("C:\\Users\\Chris.Negus\\Downloads\\OnCallLog.csv"),
		        [Delimiter=",", Columns=27, Encoding=65001, QuoteStyle=QuoteStyle.Csv]
		    ),
		    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
		    SelectedColumns = Table.SelectColumns(
		        PromotedHeaders,
		        {
		            "ID",
		            "CallDateTime",
		            "CallDuration",
		            "ExtraTime",
		            "TravelTime",
		            "Region",
		            "Service",
		            "Category",
		            "HoursCovered",
		            "ShiftCovered",
		            "ShiftService",
		            "Status",
		            "On Call Staff Member",
		            "Created",
		            "Created By",
		            "IncidentReportRequired",
		            "EscalatedAnotherTier",
		            "EscalatedTo",
		            "CallReceivedFrom",
		            "IssueDescription",
		            "Outcome"
		        }
		    ),
		    TypedBase = Table.TransformColumnTypes(
		        SelectedColumns,
		        {
		            {"ID", Int64.Type},
		            {"CallDuration", Int64.Type},
		            {"ExtraTime", Int64.Type},
		            {"TravelTime", Int64.Type},
		            {"Region", type text},
		            {"Service", type text},
		            {"Category", type text},
		            {"HoursCovered", type text},
		            {"ShiftCovered", type logical},
		            {"ShiftService", type text},
		            {"Status", type text},
		            {"On Call Staff Member", type text},
		            {"Created By", type text},
		            {"IncidentReportRequired", type logical},
		            {"EscalatedAnotherTier", type logical},
		            {"EscalatedTo", type text},
		            {"CallReceivedFrom", type text},
		            {"IssueDescription", type text},
		            {"Outcome", type text}
		        }
		    ),
		    TypedDates = Table.TransformColumnTypes(
		        TypedBase,
		        {
		            {"CallDateTime", type datetime},
		            {"Created", type datetime}
		        },
		        "en-NZ"
		    ),
		    AddedHoursCoveredDecimal = Table.AddColumn(
		        TypedDates,
		        "HoursCoveredDecimal",
		        each
		            let
		                hours = try Number.FromText(Text.BeforeDelimiter([HoursCovered], "hr")) otherwise 0,
		                minutes = try Number.FromText(Text.BetweenDelimiters([HoursCovered], "(s) ", "m")) otherwise 0
		            in
		                Number.From(hours) + (Number.From(minutes) / 60),
		        type number
		    ),
		    AddedDateKey = Table.AddColumn(
		        AddedHoursCoveredDecimal,
		        "DateKey",
		        each
		            let
		                callDate = Date.From([CallDateTime])
		            in
		                Date.Year(callDate) * 10000 + Date.Month(callDate) * 100 + Date.Day(callDate),
		        Int64.Type
		    )
		in
		    AddedDateKey
	lineageTag: 22ec8d49-022d-4082-8c2b-69e6d6e98f0a

