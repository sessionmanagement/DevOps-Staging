		    Expanded1 = Table.ExpandRecordColumn(Expanded, "Region", {"lookupValue"}, {"Region"}),
		    GroupedRows = Table.Group(Expanded1, {"ID"}, {{"Region", each Text.Combine([Region],"; "), type text}})
		in
