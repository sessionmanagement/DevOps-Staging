	partition 'Dim Date' = m
		mode: import
		source = ```
				let
				    Source = Sql.Database(Server, Database, [Query="SELECT#(lf)    [dim_date_key],#(lf)    [calendar_date],#(lf)    [calendar_days_in_month_num],#(lf)    [calendar_first_day_of_week_date],#(lf)    [calendar_last_day_of_week_date],#(lf)    [calendar_month_num],#(lf)    [calendar_month_name_long],#(lf)    [calendar_month_name_short],#(lf)    [calendar_year_month],#(lf)    [calendar_first_day_of_month_date],#(lf)    [calendar_last_day_of_month_date],#(lf)    [calendar_quarter_full],#(lf)    [calendar_year],#(lf)    [calendar_first_day_of_year_date],#(lf)    [calendar_last_day_of_year_date],#(lf)    [financial_first_day_of_year_date],#(lf)    [financial_last_day_of_year_date],#(lf)    [financial_first_day_of_week_date],#(lf)    [financial_last_day_of_week_date],#(lf)    [financial_month_num],#(lf)    [financial_first_Day_of_month_date],#(lf)    [financial_last_day_of_month_date],#(lf)    [financial_quarter_full],#(lf)    [financial_year_num],#(lf)    [financial_year_desc],#(lf)    [financial_year_month],#(lf)    [calendar_first_day_of_month_flag],#(lf)    [calendar_last_day_of_month_flag],#(lf)    [current_date_flag],#(lf)    [current_month_flag],#(lf)    [current_financial_year_flag],#(lf)    [current_date_rolling_year_offset],#(lf)    [current_date_rolling_month_offset],#(lf)    [current_date_rolling_day_offset],#(lf)    [current_date_rolling_financial_year_offset]#(lf)FROM [edw].[vw_dim_date]"]),
				    // Use shared naming function for consistency
				    #"Transformed Column Names" = Table.TransformColumnNames(Source, each fnApplyNamingConventions(_)),
				    
				    // Add offset flag for date filtering (1 = past/today, 0 = future)
				    #"Add Offset column" = Table.AddColumn(
				    #"Transformed Column Names",
				    "Offset Date",
				    each if [Calendar Date] <> null 
				        and Date.From([Calendar Date]) <= Date.From(DateTime.LocalNow()) 
				        then 1 
				        else 0,
				    Int64.Type
				)
				in
				    #"Add Offset column"
				```

	annotation PBI_ResultType = Table

