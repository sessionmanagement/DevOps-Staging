table 'RLS with Additional Access'
	lineageTag: fd1caa4f-ac07-4249-9274-b4762f1b907c

	column 'User Principal Name'
		dataType: string
		lineageTag: e9f37f53-7b68-4e1d-83bb-c969654b566c
		summarizeBy: none
		sourceColumn: User Principal Name

		annotation SummarizationSetBy = Automatic

	column 'Dim Service KEY'
		dataType: int64
		formatString: 0
		lineageTag: 7a913420-cf64-4b7a-b425-a0aebd768410
		summarizeBy: sum
		sourceColumn: Dim Service KEY

		annotation SummarizationSetBy = Automatic

	partition 'RLS with Additional Access' = m
		mode: import
		queryGroup: 'Row Level Security'
		source = ```
				let
				    // Load both source tables (removed unnecessary @ prefix)
				    RowLevelSecurity = #"Row Level Security Employee",
				    AdditionalAccess = #"Additional Access",
				    
				    // Right Outer Join: Keep all RLS employees, match with additional access permissions
				    JoinedTable = Table.Join(
				        AdditionalAccess, "Person to Impersonate Email", 
				        RowLevelSecurity, "User Principal Name", 
				        JoinKind.RightOuter
				    ),
				    
				    // For users with impersonation access, use requester's email instead
				    #"Added Conditional Column" = Table.AddColumn(
				        JoinedTable, "Effective User", 
				        each if [Requester Email] = null then [User Principal Name] else [Requester Email]
				    ),
				    
				    // Remove columns from Additional Access that are no longer needed
				    #"Removed Columns" = Table.RemoveColumns(
				        #"Added Conditional Column",
				        {"Report", "Requester Email", "Person to Impersonate Email", "Expiry Date", 
				         "Access Reason", "Approved By Email", "Approved Date", "Modified", "Created", 
				         "Created By Email", "Modified By Email", "Version", "User Principal Name"}
				    ),
				    
				    // Rename to standard column name
				    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns", {{"Effective User", "User Principal Name"}}),
				    
				    // Ensure correct column order
				    #"Reordered Columns" = Table.ReorderColumns(#"Renamed Columns", {"User Principal Name", "Dim Service KEY"}),
				    
				    // Ensure text type for User Principal Name
				    #"Changed Type" = Table.TransformColumnTypes(#"Reordered Columns", {{"User Principal Name", type text}}),
				    
				    // Remove any duplicates from the join results
				    #"Removed Duplicates" = Table.Distinct(#"Changed Type"),
				    
				    // Append original RLS Employee data (reuse loaded variable instead of re-querying)
				    #"Appended Query" = Table.Combine({#"Removed Duplicates", RowLevelSecurity}),
				    
				    // Final deduplication
				    #"Removed Duplicates Final" = Table.Distinct(#"Appended Query")
				in
				    #"Removed Duplicates Final"
				```

	annotation PBI_ResultType = Exception

	annotation PBI_NavigationStepName = Navigation

