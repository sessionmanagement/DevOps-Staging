table Changelog
	lineageTag: 7ed453e7-4252-434d-a754-418189b04f8f

	measure 'Latest Version' =
			
			VAR LatestChangeID =
			    MAX ( 'Changelog'[Change ID] )
			VAR LatestVersion =
			    MAXX (
			        FILTER ( 'Changelog', 'Changelog'[Change ID] = LatestChangeID ),
			        'Changelog'[Version]
			    )
			RETURN
			    "Quality Feedback Dataset - v" & LatestVersion
		lineageTag: cdf06246-844f-4d52-aa97-5475a5f5c43f

	column 'Change ID'
		dataType: int64
		formatString: 0
		lineageTag: 0a095911-a448-4e59-94b1-43f5e45a41c6
		summarizeBy: count
		sourceColumn: Change ID

		annotation SummarizationSetBy = Automatic

	column Version
		dataType: string
		lineageTag: acb5e612-e689-44f0-a2eb-615507cae400
		summarizeBy: none
		sourceColumn: Version

		annotation SummarizationSetBy = Automatic

	column 'Change Date'
		dataType: string
		lineageTag: 085f0a72-5bd9-4516-ac4c-9240bf731f3c
		summarizeBy: none
		sourceColumn: Change Date

		annotation SummarizationSetBy = Automatic

	column 'Changed By'
		dataType: string
		lineageTag: 068d3a61-e91d-4e94-84ea-f35ed81686c0
		summarizeBy: none
		sourceColumn: Changed By

		annotation SummarizationSetBy = Automatic

	column 'User Story ID'
		dataType: string
		lineageTag: 76be2fb2-0a78-429f-9e17-07128c5fbf1c
		summarizeBy: none
		sourceColumn: User Story ID

		annotation SummarizationSetBy = Automatic

	column Description
		dataType: string
		lineageTag: c20d23ee-daad-4a7b-a70c-a5401c239eab
		summarizeBy: none
		sourceColumn: Description

		annotation SummarizationSetBy = Automatic

	partition Changelog = m
		mode: import
		queryGroup: 'Change Log'
		source =
				let
				    // Define the table schema without the ChangeID column
				    InitialTable = #table(
				        {"Version", "Change Date", "Changed By", "User Story ID", "Description"},
				        {
				            {
				                "1.0.0",
				                #date(2025, 5, 02),
				                "Chris N",
				                "#",
				                "Initial release of Quality Feedback Report"
				            },
				            {
				                "1.0.1",
				                #date(2025, 6, 03),
				                "Chris N",
				                "#",
				                "Added in 2024 data and appended with 2025 data"
				            },
				            {
				                "1.0.2",
				                #date(2025, 6, 12),
				                "Chris N",
				                "#",
				                "Changed the 2024 data load logic to read from Q&I folder rather than my personal one."
				            },
				            {
				                "1.0.3",
				                #date(2026, 1, 05),
				                "Mike G",
				                "#",
				                "Fixed Feedback Register (2024): Updated SharePoint path from '/1. Feedback/2024 Archive Complaints/' to '/1. Feedback/Archives/z.2024 Archive Complaints/' to reflect file relocation."
				            },
				            {
				                "1.0.4",
				                #date(2026, 1, 05),
				                "Mike G",
				                "#",
				                "Fixed Feedback Register (2025): Updated SharePoint path and changed filter to use Text.Contains for folder path matching."
				            },
				            {
				                "1.1.0",
				                #date(2026, 1, 06),
				                "Mike G",
				                "#10105",
				                "[CRITICAL] Fixed Additional Access RLS filter - changed from 'Finance Reporting' to 'Quality Feedback'. RLS additional access was not working."
				            },
				            {
				                "1.1.1",
				                #date(2026, 1, 06),
				                "Mike G",
				                "#10105",
				                "Deleted orphaned 'Feedback Register (2024_original)' named expression that was loading data from wrong SharePoint site (OPS_ITServices instead of OPS_QI_Partners)."
				            },
				            {
				                "1.1.2",
				                #date(2026, 1, 06),
				                "Mike G",
				                "#10105",
				                "Created shared 'fnApplyNamingConventions' function to standardize column naming across queries. Handles underscore replacement, DWH column formatting, and ID/KEY capitalization."
				            },
				            {
				                "1.1.3",
				                #date(2026, 1, 06),
				                "Mike G",
				                "#10105",
				                "Refactored 'Dim Date' table to use shared fnApplyNamingConventions function. Fixed incorrect DWH column names in removal step."
				            },
				            {
				                "1.1.4",
				                #date(2026, 1, 06),
				                "Mike G",
				                "#10105",
				                "Refactored 'Row Level Security Employee' to use shared fnApplyNamingConventions function. Reduced query from 20+ lines to 6 lines."
				            },
				            {
				                "1.1.5",
				                #date(2026, 1, 06),
				                "Mike G",
				                "#10105",
				                "[PERFORMANCE] Optimized 'Feedback Register (2025)' - removed unnecessary Table.Sort before filter. Now filters SharePoint files first for better performance."
				            },
				            {
				                "1.1.6",
				                #date(2026, 1, 06),
				                "Mike G",
				                "#10105",
				                "[PERFORMANCE] Optimized 'Feedback Register (2024)' - removed unnecessary Table.Sort before filter. Now filters SharePoint files first for better performance."
				            },
				            {
				                "1.1.7",
				                #date(2026, 1, 06),
				                "Mike G",
				                "#10105",
				                "Cleaned up 'Feedback Register' table - removed 30+ lines of commented legacy code and added clear documentation comments."
				            },
				            {
				                "1.1.8",
				                #date(2026, 1, 06),
				                "Mike G",
				                "#10105",
				                "Removed unused 'Top N Rows' parameter that was defined but never referenced in any queries."
				            },
				            {
				                "1.1.9",
				                #date(2026, 1, 06),
				                "Mike G",
				                "#10105",
				                "[PERFORMANCE] Optimized 'RLS with Additional Access' - removed unnecessary @ prefix and refactored to reuse loaded RowLevelSecurity variable instead of querying 'Row Level Security Employee' twice."
				            },
				             {
				                "1.1.10",
				                #date(2026, 07, 08),
				                "Thijs",
				                "#13884",
				                "Remove unused columns"
				            },
				            {
				                "1.2.0",
				                #date(2026, 10, 8),
				                "Mike G",
				                "#15031",
				                "Migrated RLS to edw.row_level_security_general (RLS_type 'Service'), replacing edw.vw_row_level_security_employee. No visibility change: the RLS table is not related to the feedback data, so every Public user still sees all feedback."
				            }
				        }
				    ),
				
				    // Add an Index column to generate incremental numbers
				    TableWithIndex = Table.AddIndexColumn(InitialTable, "Change ID", 1, 1, Int64.Type),
				
				    // Reorder the columns to place ChangeID first
				    ReorderedColumns = Table.ReorderColumns(TableWithIndex, {"Change ID", "Version", "Change Date", "Changed By", "User Story ID", "Description"})
				in
				    ReorderedColumns

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

