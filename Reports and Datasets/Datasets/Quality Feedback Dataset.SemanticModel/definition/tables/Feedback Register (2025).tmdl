	partition 'Feedback Register (2025)' = m
		mode: import
		queryGroup: 'Quality Feedback'
		source = ```
				let
				    Source = SharePoint.Files("https://emergeaotearoaltd.sharepoint.com/sites/OPS_QI_Partners/", [ApiVersion = 15]),
				    
				    // Filter FIRST for better performance (no need to sort all files)
				    FilteredRows = Table.SelectRows(Source, each 
				        [Name] = "2025 Feedback Register.xlsx" and 
				        Text.Contains([Folder Path], "z.2025 Archive Complaints")
				    ),
				    
				    // Access file content using index (more robust than key lookup)
				    FileContent = FilteredRows{0}[Content],
				    
				    #"Imported Excel Workbook" = Excel.Workbook(FileContent),
				    #"2025 Feedback Register_Sheet" = #"Imported Excel Workbook"{[Item="2025 Feedback Register",Kind="Sheet"]}[Data],
				    
				    // Remove header row
				    #"Filtered Rows" = Table.SelectRows(#"2025 Feedback Register_Sheet", each ([Column1] <> "Feedback Receipt - enter these details upon receipt of the feedback item (within 2 working days)")),
				    #"Promoted Headers" = Table.PromoteHeaders(#"Filtered Rows", [PromoteAllScalars=true]),
				    
				    // Select required columns
				    #"Removed Other Columns" = Table.SelectColumns(#"Promoted Headers",{"Feedback ID", "Feedback Type", "Current Status", "Division", "Service Type / Location", "Service Name", "Feedback Source", "Mode of Feedback", "Source Name", "Client ID (if relevant)", "Client Ethnicity (Primary)", "Date of Receipt", "Month", "Feedback Subject", "Feedback Description (summary only)", "Date Acknowledgement Due", "Date Acknowledgement Sent", "Mode of Ack Comms", "Complaint Primary Class", "Complaint Secondary Class", "Complaint Risk Rating", "Complaint Manager", "Investigator", "Immediate Resolution Actions", "Improvements/Corrective Actions Identified - include plan to address", "Responsible Person for Improvements/Corrective Actions", "Date of extension required by Day 10 (usually allow 2-4 weeks past original OUTCOME due date)", "Extension Y | N", "Extension Reason", "Date Outcome Due (without ext)", "Outcome letter endorsed by QIP", "Mode of Outcome Comms", "Date Outcome Sent", "Feedback File completed", "Feedback Closure Date", "Processing Notes", "Completed By"}),
				    
				    // Filter out null IDs
				    #"Filtered Rows1" = Table.SelectRows(#"Removed Other Columns", each ([Feedback ID] <> null)),
				    
				    // Duplicate date columns for comment preservation
				    #"Duplicated Column" = Table.DuplicateColumn(#"Filtered Rows1", "Date Acknowledgement Sent", "Date Acknowledgement Sent - Copy"),
				    #"Duplicated Column1" = Table.DuplicateColumn(#"Duplicated Column", "Date Outcome Due (without ext)", "Date Outcome Due (without ext) - Copy"),
				    #"Duplicated Column2" = Table.DuplicateColumn(#"Duplicated Column1", "Date Outcome Sent", "Date Outcome Sent - Copy"),
				    #"Duplicated Column3" = Table.DuplicateColumn(#"Duplicated Column2", "Date of Receipt", "Date of Receipt - Copy"),
				    #"Duplicated Column4" = Table.DuplicateColumn(#"Duplicated Column3", "Date Acknowledgement Due", "Date Acknowledgement Due - Copy"),
				    #"Duplicated Column5" = Table.DuplicateColumn(#"Duplicated Column4", "Date of extension required by Day 10 (usually allow 2-4 weeks past original OUTCOME due date)", "Date of extension required by Day 10 (usually allow 2-4 weeks past original OUTCOME due date) - Copy"),
				    #"Duplicated ColumnFinal" = Table.DuplicateColumn(#"Duplicated Column5", "Feedback Closure Date", "Feedback Closure Date - Copy"),
				    
				    // Set column types
				    #"Changed Type" = Table.TransformColumnTypes(#"Duplicated ColumnFinal",{{"Feedback ID", type text}, {"Feedback Type", type text}, {"Current Status", type text}, {"Division", type text}, {"Service Type / Location", type text}, {"Service Name", type text}, {"Feedback Source", type text}, {"Mode of Feedback", type text}, {"Source Name", type text}, {"Client ID (if relevant)", type text}, {"Client Ethnicity (Primary)", type text}, {"Date of Receipt", type date}, {"Month", type text}, {"Feedback Subject", type text}, {"Feedback Description (summary only)", type text}, {"Date Acknowledgement Due", type date}, {"Date Acknowledgement Sent", type date}, {"Mode of Ack Comms", type text}, {"Complaint Primary Class", type text}, {"Complaint Secondary Class", type text}, {"Complaint Risk Rating", type text}, {"Complaint Manager", type text}, {"Investigator", type text}, {"Immediate Resolution Actions", type text}, {"Improvements/Corrective Actions Identified - include plan to address", type text}, {"Responsible Person for Improvements/Corrective Actions", type text}, {"Date of extension required by Day 10 (usually allow 2-4 weeks past original OUTCOME due date)", type date}, {"Extension Y | N", type text}, {"Extension Reason", type text}, {"Date Outcome Due (without ext)", type date}, {"Outcome letter endorsed by QIP", type text}, {"Mode of Outcome Comms", type text}, {"Date Outcome Sent", type date}, {"Feedback File completed", type text}, {"Feedback Closure Date", type date}, {"Processing Notes", type text}, {"Completed By", type text}}),
				    
				    // Replace date conversion errors with null
				    #"Replaced Errors" = Table.ReplaceErrorValues(#"Changed Type", {{"Date of Receipt", null}, {"Date Acknowledgement Due", null}, {"Date of extension required by Day 10 (usually allow 2-4 weeks past original OUTCOME due date)", null},{"Date Outcome Sent", null}, {"Feedback Closure Date", null}, {"Date Acknowledgement Sent", null}, {"Date Outcome Due (without ext)", null}})
				in
				    #"Replaced Errors"
