	partition 'Feedback Register (2024)' = m
		mode: import
		queryGroup: 'Quality Feedback'
		source = ```
				let
				    Source = SharePoint.Files("https://emergeaotearoaltd.sharepoint.com/sites/OPS_QI_Partners/", [ApiVersion = 15]),
				    
				    // Filter FIRST for better performance (no need to sort all files)
				    FilteredRows = Table.SelectRows(Source, each 
				        [Name] = "@@@Complaints Register.xlsx" and 
				        Text.Contains([Folder Path], "z.2024 Archive Complaints")
				    ),
				    
				    // Access file content using index (more robust than key lookup)
				    FileContent = FilteredRows{0}[Content],
				    
				    #"Imported Excel Workbook" = Excel.Workbook(FileContent),
				    #"ImportData" = Table.SelectRows(#"Imported Excel Workbook", each ([Hidden] = false)),
				    #"YearData" = #"ImportData"{[Item="2024",Kind="Sheet"]}[Data],
				    
				    // Select only needed columns (Column1 through Column32)
				    #"Removed Other Columns1" = Table.SelectColumns(YearData,{"Column1", "Column2", "Column3", "Column4", "Column5", "Column6", "Column7", "Column8", "Column9", "Column10", "Column11", "Column12", "Column13", "Column14", "Column15", "Column16", "Column17", "Column18", "Column19", "Column20", "Column21", "Column22", "Column23", "Column24", "Column25", "Column26", "Column27", "Column28", "Column29", "Column30", "Column31", "Column32"}),
				    
				    // Filter out null rows and promote headers
				    #"Filtered Rows" = Table.SelectRows(#"Removed Other Columns1", each ([Column1] <> null)),
				    #"Promoted Headers" = Table.PromoteHeaders(#"Filtered Rows", [PromoteAllScalars=true]),
				    
				    // Rename 2024 columns to match 2025 schema
				    #"Renamed Columns" = Table.RenameColumns(#"Promoted Headers",{
				        {"Complaint File No.", "Feedback ID"}, 
				        {"Complaint / Appeal / Feedback", "Feedback Type"}, 
				        {"Type", "Feedback Source"}, 
				        {"Client Ethnic Group", "Client Ethnicity (Primary)"}, 
				        {"Name of Client or Complainant", "Source Name"}, 
				        {"Date Complaint Received", "Date of Receipt"}, 
				        {"Month Raised (auto-fill)", "Month"}, 
				        {"Date acknowledgement sent", "Date Acknowledgement Sent"}, 
				        {"Primary Complaint Classification", "Complaint Primary Class"}, 
				        {"Secondary Classification (if required)", "Complaint Secondary Class"}, 
				        {"Risk Consequence (MANDATORY)", "Complaint Risk Rating"}, 
				        {"Region", "Division"}, 
				        {"Location / Service", "Service Name"}, 
				        {"Service Type (List to be confirmed 12.01 QP meeting)", "Service Type / Location"}, 
				        {"Complaint Description Summary ", "Feedback Description (summary only)"}, 
				        {"Complaint Manager", "Complaint Manager"}, 
				        {"Investigator(s)", "Investigator"}, 
				        {"Date of extension required by Day 10 (usually allow 2-4 weeks past original OUTCOME due date)", "Date of extension required by Day 10 (usually allow 2-4 weeks past original OUTCOME due date)"}, 
				        {"Corrective Actions Identified- Please add a description of the improvements and how learning is evidenced", "Improvements/Corrective Actions Identified - include plan to address"}, 
				        {"Complaint Closed", "Feedback Closure Date"}, 
				        {"Investigation documents filed", "Feedback File completed"}, 
				        {"Comments", "Processing Notes"}, 
				        {"Complaint entered by:", "Completed By"}
				    }),
				    
				    // Remove columns not needed from 2024 data
				    #"Removed Columns" = Table.RemoveColumns(#"Renamed Columns",{
				        "Client Ethnicity #(lf)(Compulsory Field - please copy from RecordBase or select from list)", 
				        "Client Ethnicity secondary", 
				        "Acknowledgement met guideline (auto-fill)", 
				        "Justified#(lf)", 
				        "Tenancy or Service ", 
				        "Date of lateset extension (Do not remove original due date)", 
				        "Date Outcome letter sent (Do not remove original due date)", 
				        "Investigation & Documentation completed in 20 days or extn provided",  
				        "RISK Matrix and Key Colour code#(lf)PURPLE Nthland, RED AKL, BLUE Midland, ORANGE Housing,LT GREEN Central DK GREEN Sthrn"
				    }),
				    
				    // Handle extension date errors
				    #"Replaced Errors1" = Table.ReplaceErrorValues(#"Removed Columns", {{"Date of extension required by Day 10 (usually allow 2-4 weeks past original OUTCOME due date)", null}}),
				    
				    // Duplicate date columns for comment preservation (only columns that exist in 2024)
				    #"Duplicated Column" = Table.DuplicateColumn(#"Replaced Errors1", "Date Acknowledgement Sent", "Date Acknowledgement Sent - Copy"),
				    #"Duplicated Column3" = Table.DuplicateColumn(#"Duplicated Column", "Date of Receipt", "Date of Receipt - Copy"),
				    #"Duplicated Column5" = Table.DuplicateColumn(#"Duplicated Column3", "Date of extension required by Day 10 (usually allow 2-4 weeks past original OUTCOME due date)", "Date of extension required by Day 10 (usually allow 2-4 weeks past original OUTCOME due date) - Copy"),
				    #"Duplicated ColumnFinal" = Table.DuplicateColumn(#"Duplicated Column5", "Feedback Closure Date", "Feedback Closure Date - Copy"),
				    
				    // Set column types
				    #"Changed Type" = Table.TransformColumnTypes(#"Duplicated ColumnFinal",{
				        {"Feedback ID", type text}, 
				        {"Feedback Type", type text}, 
				        {"Division", type text}, 
				        {"Service Name", type text}, 
				        {"Feedback Source", type text}, 
				        {"Source Name", type text}, 
				        {"Client Ethnicity (Primary)", type text}, 
				        {"Date of Receipt", type date}, 
				        {"Month", type text}, 
				        {"Feedback Description (summary only)", type text}, 
				        {"Date Acknowledgement Sent", type date}, 
				        {"Complaint Primary Class", type text}, 
				        {"Complaint Secondary Class", type text}, 
				        {"Complaint Risk Rating", type text}, 
				        {"Complaint Manager", type text}, 
				        {"Investigator", type text}, 
				        {"Improvements/Corrective Actions Identified - include plan to address", type text}, 
				        {"Date of extension required by Day 10 (usually allow 2-4 weeks past original OUTCOME due date)", type date}, 
				        {"Feedback File completed", type text}, 
				        {"Feedback Closure Date", type date}, 
				        {"Processing Notes", type text}, 
				        {"Completed By", type text}
				    }),
				    
				    // Replace date conversion errors with null
				    #"Replaced Errors" = Table.ReplaceErrorValues(#"Changed Type", {
				        {"Date of Receipt", null}, 
				        {"Date of extension required by Day 10 (usually allow 2-4 weeks past original OUTCOME due date)", null}, 
				        {"Feedback Closure Date", null}, 
				        {"Date Acknowledgement Sent", null}
				    }),
				    
				    // Standardize "Feedback " to "Feedback" in Feedback Type column
				    #"Replaced Value" = Table.ReplaceValue(#"Replaced Errors","Feedback ","Feedback",Replacer.ReplaceText,{"Feedback Type"})
				in
				    #"Replaced Value"
				```

	changedProperty = IsHidden

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

