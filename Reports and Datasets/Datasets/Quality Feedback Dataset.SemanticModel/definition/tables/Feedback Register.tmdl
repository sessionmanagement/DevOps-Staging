	partition 'Feedback Register' = m
		mode: import
		queryGroup: 'Quality Feedback'
		source = ```
				let
				    // Combine 2024 and 2025 feedback data
				    // Note: 2024 has fewer columns than 2025; Table.Combine will fill missing columns with null
				    Source = Table.Combine({#"Feedback Register (2025)", #"Feedback Register (2024)"}),
				    
				    // Remove columns that are either:
				    // - Not common to both years, OR
				    // - Not needed for the final combined report
				    #"Removed Columns" = Table.RemoveColumns(Source, {
				        // Columns only in 2025 or not needed for combined view
				        "Division", 
				        "Feedback Source", 
				        "Source Name", 
				        "Client ID (if relevant)", 
				        "Month", 
				        "Feedback Description (summary only)", 
				        "Date Acknowledgement Due", 
				        "Date Acknowledgement Sent", 
				        "Mode of Ack Comms", 
				        "Complaint Secondary Class", 
				        "Investigator", 
				        "Immediate Resolution Actions", 
				        "Improvements/Corrective Actions Identified - include plan to address", 
				        "Responsible Person for Improvements/Corrective Actions", 
				        "Date of extension required by Day 10 (usually allow 2-4 weeks past original OUTCOME due date)", 
				        "Extension Y | N", 
				        "Extension Reason", 
				        "Date Outcome Due (without ext)", 
				        "Outcome letter endorsed by QIP", 
				        "Mode of Outcome Comms", 
				        "Date Outcome Sent", 
				        "Feedback File completed", 
				        "Feedback Closure Date", 
				        "Processing Notes",
				        // Duplicate date columns used for Excel comment preservation
				        "Date Acknowledgement Sent - Copy", 
				        "Date Outcome Due (without ext) - Copy", 
				        "Date Outcome Sent - Copy", 
				        "Date of Receipt - Copy", 
				        "Date Acknowledgement Due - Copy", 
				        "Date of extension required by Day 10 (usually allow 2-4 weeks past original OUTCOME due date) - Copy", 
				        "Feedback Closure Date - Copy"
				    })
				in
				    #"Removed Columns"
				```

	annotation PBI_NavigationStepName = Navigation

