	column EthnicityGroups =
			SWITCH(
				TRUE,
				ISBLANK('Feedback Register'[Client Ethnicity (Primary)]),
				"(Blank)",
				'Feedback Register'[Client Ethnicity (Primary)] IN {"Asian"},
				"Asian",
				'Feedback Register'[Client Ethnicity (Primary)] IN {"British and Irish",
					"European",
					"European nfd",
					"N Z European Pakeha",
					"New Zealand European/Päkehä",
					"NZ Euro",
					"NZ European Pakeha",
					"Pakeha"},
				"European",
				'Feedback Register'[Client Ethnicity (Primary)] IN {"Maori",
					"Māori"},
				"Maori",
				'Feedback Register'[Client Ethnicity (Primary)] IN {"African"},
				"MELAA",
				'Feedback Register'[Client Ethnicity (Primary)] IN {"Pacifika",
					"Pasifika",
					"Samoan",
					"Tokelauan",
					"Tongan"},
				"Pasifika",
				"Other"
			)
		lineageTag: e51abc15-a7c5-46b7-911f-3c88defadfe2
		summarizeBy: none

