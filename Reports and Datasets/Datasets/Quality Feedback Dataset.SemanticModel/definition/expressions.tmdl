expression 'Row Level Security Employee' = ```
		let
		    // RLS source: edw.row_level_security_general, RLS_type 'Service' (replaces edw.vw_row_level_security_employee). Aliases keep the legacy column names.
		    Source = Sql.Database(Server, Database, [Query="SELECT DISTINCT#(lf)    LOWER([email]) AS [user_principal_name],#(lf)    [dim_service_key]#(lf)FROM [edw].[row_level_security_general]#(lf)WHERE [RLS_type] = 'Service'#(lf)    AND [email] IS NOT NULL#(lf)    AND [dim_service_key] > 0"]),
		    
		    // Use shared naming function for consistency
		    #"Transformed Column Names" = Table.TransformColumnNames(Source, each fnApplyNamingConventions(_)),
		    
		    // Lowercase and trim email for case-insensitive RLS matching
		    #"Lowercased Text" = Table.TransformColumns(#"Transformed Column Names", {{"User Principal Name", each Text.Lower(Text.Trim(_)), type text}}),
		    
		    // Remove duplicate rows
		    #"Removed Duplicates" = Table.Distinct(#"Lowercased Text")
		in
		    #"Removed Duplicates"
		```
	lineageTag: 19fcacc1-58c1-4e28-bb47-7c65b7b76b77
