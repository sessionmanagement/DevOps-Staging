	partition ALL_Work_AbsentDaysExplosion-51b183d2-76f5-4339-9c35-ceea5e3192cd = m
		mode: import
		queryGroup: 'All (Unioned Data)'
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="SELECT DISTINCT#(lf)'EAL' AS CompanyIdentifier,#(lf)CASE WHEN fr.PersonID IS NOT NULL THEN CONCAT('E',fr.PersonID) ELSE NULL END AS PersonID,#(lf)CASE WHEN fr.ID IS NOT NULL THEN CONCAT('E',fr.ID) ELSE NULL END AS ReferralID,#(lf)CASE WHEN dtf.TeamFunctionID IS NOT NULL THEN CONCAT('E',dtf.TeamFunctionID) ELSE NULL END AS TeamFunctionID,#(lf)CASE WHEN dt.TeamID IS NOT NULL THEN CONCAT('E',dt.TeamID) ELSE NULL END AS TeamID,#(lf)CASE WHEN PersonStatusTypeID IS NOT NULL THEN CONCAT('E',PersonStatusTypeID) ELSE NULL END AS PersonStatusTypeID,#(lf)--fr.AcceptedDate,#(lf)--fr.DischargeDate,#(lf)CAST(PersonStatusStartDate AS date) AS PersonStatusStartDate,#(lf)COALESCE(CAST(PersonStatusEndDate AS date),CAST(GETDATE() AS date)) AS PersonStatusEndDate#(lf)FROM #(lf)RBEAL.[dlFactPersonStatus] fps#(lf)INNER JOIN#(lf)RBEAL.[legacyFactReferral] fr ON fr.PersonID = fps.PersonID AND fps.PersonStatusStartDate BETWEEN fr.AcceptedDate AND COALESCE(fr.DischargeDate,GETDATE())#(lf)INNER JOIN RBEAL.[dlDimTeam] dt ON dt.TeamID = fr.TeamID#(lf)INNER JOIN RBEAL.[dlDimTeamFunction] dtf ON dtf.TeamFunctionID = dt.TeamFunctionID#(lf)WHERE PersonStatusTypeID IN (1,2)#(lf)AND fr.AcceptedDate IS NOT NULL#(lf)AND (dtf.TeamFunctionName LIKE '%Residential%' OR dtf.TeamFunctionName LIKE '%Respite%')"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"PersonStatusStartDate", Int64.Type}, {"PersonStatusEndDate", Int64.Type}}),
				    #"Appended Query" = Table.Combine({#"Changed Type", MNB_Work_AbsentDaysExplosion}),
				    #"Added Custom" = Table.AddColumn(#"Appended Query", "Explosion", each {[PersonStatusStartDate]..[PersonStatusEndDate]}),
				    #"Expanded Explosion" = Table.ExpandListColumn(#"Added Custom", "Explosion"),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Expanded Explosion",{{"PersonStatusStartDate", type date}, {"PersonStatusEndDate", type date}, {"Explosion", type date}}),
				    #"Inserted Merged Column" = Table.AddColumn(#"Changed Type1", "TeamKeyComposite", each Text.Combine({[TeamFunctionID], [TeamID]}), type text)
				in
				    #"Inserted Merged Column"

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

