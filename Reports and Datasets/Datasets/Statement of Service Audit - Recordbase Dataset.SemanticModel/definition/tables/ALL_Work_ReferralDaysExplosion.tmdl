	partition ALL_Work_ReferralDaysExplosion-38cfc9f9-d94e-4c46-beba-8a9a08eec564 = m
		mode: import
		queryGroup: 'All (Unioned Data)'
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="SELECT DISTINCT#(lf)'EAL' AS CompanyIdentifier,#(lf)CAST(lfr.AcceptedDate AS DATE) AS AcceptedDate,#(lf)CASE WHEN CAST(lfr.DischargeDate AS DATE) IS NULL THEN CAST(GETDATE() AS DATE) ELSE CAST(lfr.DischargeDate AS DATE) END AS DischargeDate,#(lf)CAST(lfr.DischargeDate AS DATE) AS DischargeDateTrue,#(lf)CASE WHEN lfr.ID IS NOT NULL THEN CONCAT('E',lfr.ID) ELSE NULL END AS ID,#(lf)CASE WHEN lfr.PersonID IS NOT NULL THEN CONCAT('E',lfr.PersonID) ELSE NULL END AS PersonID,#(lf)CASE WHEN lfr.TeamID IS NOT NULL THEN CONCAT('E',lfr.TeamID) ELSE NULL END AS TeamID,#(lf)CASE WHEN tf.TeamFunctionID IS NOT NULL THEN CONCAT('E',tf.TeamFunctionID) ELSE NULL END AS TeamFunctionID#(lf)FROM RBEAL.[legacyFactReferral] lfr#(lf)LEFT OUTER JOIN RBEAL.dlDimTeam t ON t.TeamID = lfr.TeamID#(lf)LEFT OUTER JOIN RBEAL.[dlDimTeamFunction] tf ON tf.TeamFunctionID = t.TeamFunctionID#(lf)WHERE ID IS NOT NULL#(lf)AND AcceptedDate IS NOT NULL"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"AcceptedDate", Int64.Type}, {"DischargeDate", Int64.Type}}),
				    #"Appended Query" = Table.Combine({#"Changed Type", MNB_Work_ReferralDaysExplosion}),
				    #"Filtered Rows" = Table.SelectRows(#"Appended Query", each true),
				    #"Added Custom" = Table.AddColumn(#"Filtered Rows", "Explosion", each {[AcceptedDate]..[DischargeDate]}),
				    #"Expanded Explosion" = Table.ExpandListColumn(#"Added Custom", "Explosion"),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Expanded Explosion",{{"AcceptedDate", type date}, {"DischargeDate", type date}, {"Explosion", type date}, {"DischargeDateTrue", type date}}),
				    #"Inserted Merged Column" = Table.AddColumn(#"Changed Type1", "Merged", each Text.Combine({[TeamFunctionID], [TeamID]}), type text),
				    #"Renamed Columns" = Table.RenameColumns(#"Inserted Merged Column",{{"Merged", "TeamKeyComposite"}})
				in
				    #"Renamed Columns"

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

