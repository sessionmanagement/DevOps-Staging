	column AgeAtFYEnd =
			
			// This measure will get the age of the person at the end of the FY, or if the end of the FY is after today, it will get their age as of today (in the case of the in progress financial year).
			IF(
			    SELECTEDVALUE(ALL_Work_ReferralDaysExplosion[FYEnd]) < TODAY(),
			    FLOOR(DATEDIFF(RELATED(Work_ALL_DimPerson[PersonDateOfBirth]),ALL_Work_ReferralDaysExplosion[FYEnd],DAY)/365,1),
			    FLOOR(DATEDIFF(RELATED(Work_ALL_DimPerson[PersonDateOfBirth]),TODAY(),DAY)/365,1)
			)
		isHidden
		formatString: 0
		lineageTag: 589bb7e0-cbc0-4937-be5d-721cbace2f53
		summarizeBy: sum

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column AgeAtFYEndBucket =
			
			IF(
			ALL_Work_ReferralDaysExplosion[AgeAtFYEnd] < 21, "0-20",
			IF(
			ALL_Work_ReferralDaysExplosion[AgeAtFYEnd] < 31, "21-30",
			IF(
			ALL_Work_ReferralDaysExplosion[AgeAtFYEnd] < 41, "31-40",
			IF(
			ALL_Work_ReferralDaysExplosion[AgeAtFYEnd] < 51, "41-50",
			IF(
			ALL_Work_ReferralDaysExplosion[AgeAtFYEnd] < 61, "51-60",
			IF(
			ALL_Work_ReferralDaysExplosion[AgeAtFYEnd] > 60, "61 and Over"
			))))))
		isHidden
		lineageTag: fe4bd5ea-d1a2-4e2c-bec5-ed65c168d0f1
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

