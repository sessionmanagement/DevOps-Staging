		sourceColumn: ALL_Work_AbsentDaysExplosion[TeamKeyComposite]

		annotation SummarizationSetBy = Automatic

	column AbsenceEndDateForFY =
			
			// Only counted if person is gone "overnight" i.e. if PersonStatusStartDate and PersonStatusEndDate are on the same day then it is not counted.
			IF(
			    FactAbsentDaysByFY[PersonStatusEndDate] > FactAbsentDaysByFY[FYEnd],
			        FactAbsentDaysByFY[FYEnd],
			        FactAbsentDaysByFY[PersonStatusEndDate]
			)
		formatString: Short Date
		lineageTag: 70969338-e306-497d-a8a1-b8143d27ad4b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition FactAbsentDaysByFY-ee1d1b72-a23c-4018-8b6f-af65982ddbac = calculated
		mode: import
		source =
				
				// This table splits each person into the FYs over they have absent days. It then calculates the number of days the absence occurred for in that FY. Each PersonID will have as many rows as financial years that it spans.
				// You can generally disregard PersonStatusStartDate and PersonStatusEndDate - they are better used as a reference for understanding how the table works.
				SUMMARIZECOLUMNS(
				    ALL_Work_AbsentDaysExplosion[CompanyIdentifier],
				    ALL_Work_AbsentDaysExplosion[PersonID],
				    ALL_Work_AbsentDaysExplosion[ReferralID],
				    ALL_Work_AbsentDaysExplosion[TeamFunctionID],
				    ALL_Work_AbsentDaysExplosion[TeamID],
				    ALL_Work_AbsentDaysExplosion[TeamKeyComposite],
				    ALL_Work_AbsentDaysExplosion[PersonStatusTypeID],
				    ALL_Work_AbsentDaysExplosion[PersonStatusStartDate],
				    ALL_Work_AbsentDaysExplosion[PersonStatusEndDate],
				    ALL_Work_AbsentDaysExplosion[FinancialYear],
				    ALL_Work_AbsentDaysExplosion[FYEnd],
				    "AbsenceBeginDateForFY", MIN(ALL_Work_AbsentDaysExplosion[Explosion])
				)

	annotation PBI_Id = 2247a1a34e3143d0a0aa5f49f2c69d55

