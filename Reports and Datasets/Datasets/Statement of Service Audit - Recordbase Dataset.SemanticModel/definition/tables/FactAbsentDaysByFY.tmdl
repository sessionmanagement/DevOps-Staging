	column FYEnd
		formatString: Short Date
		lineageTag: c020d5ca-13a3-4e52-bcfd-8736c4bd89cc
		summarizeBy: none
		isNameInferred
		sourceColumn: ALL_Work_AbsentDaysExplosion[FYEnd]

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column AbsenceNightsInFY =
			
			// Only counted if person is gone "overnight" i.e. if PersonStatusStartDate and PersonStatusEndDate are on the same day then it is not counted.
			IF(
			    FactAbsentDaysByFY[PersonStatusEndDate] > FactAbsentDaysByFY[FYEnd],
			        DATEDIFF(FactAbsentDaysByFY[AbsenceBeginDateForFY],FactAbsentDaysByFY[FYEnd],DAY),
			        DATEDIFF(FactAbsentDaysByFY[AbsenceBeginDateForFY],FactAbsentDaysByFY[PersonStatusEndDate],DAY)
			)
		formatString: 0
		lineageTag: a225f0a0-dd95-4c50-b3d5-987f3a68e59e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column PersonStatusTypeID
		lineageTag: 5e79d3b5-87f8-4990-a7b2-38fa3f491f4e
		summarizeBy: none
		isNameInferred
		sourceColumn: ALL_Work_AbsentDaysExplosion[PersonStatusTypeID]

		annotation SummarizationSetBy = Automatic

	column ReferralID
		lineageTag: 2b57707a-206f-4e78-b87b-0f6e52e75314
		summarizeBy: none
		isNameInferred
