	column CompanyIdentifier
		lineageTag: 46e25e24-2f9f-43db-b9a3-d73f655b8f19
		summarizeBy: none
		isNameInferred
		sourceColumn: ALL_Work_AbsentDaysExplosion[CompanyIdentifier]

