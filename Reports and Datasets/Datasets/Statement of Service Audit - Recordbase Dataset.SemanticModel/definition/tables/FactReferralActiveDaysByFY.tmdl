	column ReferralBeginDateForFY
		formatString: Short Date
		lineageTag: 850466f2-7d87-4bcf-b3f2-86360020aed2
		summarizeBy: none
		isNameInferred
		sourceColumn: [ReferralBeginDateForFY]

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column ReferralDaysInFY =
			
			IF(
			    FactReferralActiveDaysByFY[DischargeDate] > FactReferralActiveDaysByFY[FYEnd],
			        DATEDIFF(FactReferralActiveDaysByFY[ReferralBeginDateForFY],FactReferralActiveDaysByFY[FYEnd],DAY),
			        DATEDIFF(FactReferralActiveDaysByFY[ReferralBeginDateForFY],FactReferralActiveDaysByFY[DischargeDate],DAY)
			)+1
		formatString: 0
		lineageTag: a490ce8b-138b-4f5b-b74e-0994dc6e1b91
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column TeamFunctionID
		lineageTag: f6c26bbf-8461-4a67-b736-9327bb49378e
		summarizeBy: none
		isNameInferred
		sourceColumn: ALL_Work_ReferralDaysExplosion[TeamFunctionID]

		annotation SummarizationSetBy = Automatic

	column ID
		lineageTag: 0819c5a3-4766-4f62-804f-b43c2612d822
		summarizeBy: none
		isNameInferred
