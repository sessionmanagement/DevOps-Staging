	partition MNB_DimTeam-780e7a1c-bb8d-463f-b4d7-749bc512fda9 = m
		mode: import
		queryGroup: MNB
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="SELECT#(lf)'MNB' AS CompanyIdentifier,#(lf)CASE WHEN [TeamID]IS NOT NULL THEN CONCAT('M',[TeamID]) ELSE NULL END AS [TeamID],#(lf)CASE WHEN [CompanyID]IS NOT NULL THEN CONCAT('M',[CompanyID]) ELSE NULL END AS [CompanyID],#(lf)CASE WHEN [ContractID]IS NOT NULL THEN CONCAT('M',[ContractID]) ELSE NULL END AS [ContractID],#(lf)CASE WHEN [TeamFunctionID]IS NOT NULL THEN CONCAT('M',[TeamFunctionID]) ELSE NULL END AS [TeamFunctionID],#(lf)CASE WHEN [OldTeamID]IS NOT NULL THEN CONCAT('M',[OldTeamID]) ELSE NULL END AS [OldTeamID],#(lf)CASE WHEN [OldSupportLevelID]IS NOT NULL THEN CONCAT('M',[OldSupportLevelID]) ELSE NULL END AS [OldSupportLevelID],#(lf)CASE WHEN [SupportLevelTypeID]IS NOT NULL THEN CONCAT('M',[SupportLevelTypeID]) ELSE NULL END AS [SupportLevelTypeID],#(lf)CASE WHEN [TaskProcessID]IS NOT NULL THEN CONCAT('M',[TaskProcessID]) ELSE NULL END AS [TaskProcessID],#(lf)CASE WHEN [EmploymentPlanTemplateID]IS NOT NULL THEN CONCAT('M',[EmploymentPlanTemplateID]) ELSE NULL END AS [EmploymentPlanTemplateID],#(lf)CASE WHEN [AreaID]IS NOT NULL THEN CONCAT('M',[AreaID]) ELSE NULL END AS [AreaID],#(lf)CASE WHEN [DynamicFormID]IS NOT NULL THEN CONCAT('M',[DynamicFormID]) ELSE NULL END AS [DynamicFormID],#(lf)[TeamCode],#(lf)[TeamName],#(lf)[TeamDescription],#(lf)[TeamAutoAccept],#(lf)[TeamCapacity],#(lf)[TeamStartDate],#(lf)[TeamEndDate],#(lf)[TeamUDF1],#(lf)[TeamUDF2],#(lf)[TeamUDF3],#(lf)[TeamUDF4],#(lf)[TeamUDF5],#(lf)[TeamUDF6],#(lf)[TeamUDF7],#(lf)[TeamUDF8],#(lf)[TeamUDF9],#(lf)[TeamUDF10],#(lf)[TeamLUDF1],#(lf)[TeamLUDF2],#(lf)[TeamLUDF3],#(lf)[TeamLUDF4],#(lf)[TeamLUDF5],#(lf)[TeamRecentlyDischargedPeriodDaysOverride],#(lf)[TeamIsEmploymentTeam],#(lf)[TeamIsAllocatedSupportTimeTeam],#(lf)[TeamReferenceNumberRequired],#(lf)[TeamIsFosterCarerTeam],#(lf)[TeamIsFosterChildTeam],#(lf)[TeamShowGlobalActivityTemplate]#(lf)FROM RBMNB.dlDimTeam"])
				in
				    Source

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

