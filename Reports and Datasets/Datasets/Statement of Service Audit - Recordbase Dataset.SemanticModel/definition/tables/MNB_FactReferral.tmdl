	partition MNB_FactReferral-b9d952ea-9b0d-4ffa-b047-1c2d57c946d1 = m
		mode: import
		queryGroup: MNB
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="SELECT#(lf)'MNB' AS CompanyIdentifier,#(lf)CASE WHEN [lfr].[ID] IS NOT NULL THEN CONCAT('M',[lfr].[ID]) ELSE NULL END AS [ID],#(lf)CASE WHEN [lfr].[PersonID] IS NOT NULL THEN CONCAT('M',[lfr].[PersonID]) ELSE NULL END#(tab)AS [PersonID],#(lf)CASE WHEN [lfr].[SourceReferrerID] IS NOT NULL THEN CONCAT('M',[lfr].[SourceReferrerID]) ELSE NULL END AS [SourceReferrerID],#(lf)CASE WHEN [lfr].[SourceReferralID] IS NOT NULL THEN CONCAT('M',[lfr].[SourceReferralID]) ELSE NULL END AS [SourceReferralID],#(lf)CASE WHEN [lfr].[TeamID] IS NOT NULL THEN CONCAT('M',[lfr].[TeamID]) ELSE NULL END AS [TeamID],#(lf)CASE WHEN [lfr].[OrganisationID] IS NOT NULL THEN CONCAT('M',[lfr].[OrganisationID]) ELSE NULL END AS [OrganisationID],#(lf)CASE WHEN [lfr].[CurrentReferralStatusTypeID] IS NOT NULL THEN CONCAT('M',[lfr].[CurrentReferralStatusTypeID]) ELSE NULL END AS [CurrentReferralStatusTypeID],#(lf)CASE WHEN [lfr].[ReferralPriorityID] IS NOT NULL THEN CONCAT('M',[lfr].[ReferralPriorityID]) ELSE NULL END AS [ReferralPriorityID],#(lf)CASE WHEN [lfr].[CreatedUserID] IS NOT NULL THEN CONCAT('M',[lfr].[CreatedUserID]) ELSE NULL END AS [CreatedUserID],#(lf)CASE WHEN [lfr].[InterviewUserID] IS NOT NULL THEN CONCAT('M',[lfr].[InterviewUserID]) ELSE NULL END AS [InterviewUserID],#(lf)CASE WHEN [dt].[TeamFunctionID] IS NOT NULL THEN CONCAT('M',[dt].[TeamFunctionID]) ELSE NULL END AS [TeamFunctionID],#(lf)[lfr].[ServiceStartDate],#(lf)[lfr].[ServiceEndDate],#(lf)[lfr].[ReceivedDate],#(lf)[lfr].[ExpectedArrivalDate],#(lf)[lfr].[ExpectedDepartureDate],#(lf)[lfr].[ActualArrivalDate],#(lf)[lfr].[ActualDepartureDate],#(lf)[lfr].[EndDate],#(lf)[lfr].[Notes], #(lf)[lfr].[InterviewDate], #(lf)[lfr].[CreatedDate], #(lf)[lfr].[IsInbound], #(lf)[lfr].[PendingDate], #(lf)[lfr].[PendingReason],#(lf)[lfr].[WaitlistDate],#(lf)[lfr].[WaitlistReason],#(lf)[lfr].[AcceptedDate],#(lf)[lfr].[AcceptedReason],#(lf)[lfr].[DischargeDate],#(lf)[lfr].[DischargeReason],#(lf)[lfr].[DeclineDate],#(lf)[lfr].[DeclineReason],#(lf)[lfr].[DischargeComments]#(lf)FROM#(lf)RBMNB.[legacyFactReferral] lfr#(lf)LEFT OUTER JOIN RBMNB.[dlDimTeam] dt ON dt.TeamID = lfr.TeamID"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"DischargeDate", type date}, {"AcceptedDate", type date}, {"PendingDate", type date}, {"CreatedDate", type date}, {"EndDate", type date}, {"ServiceStartDate", type date}, {"ServiceEndDate", type date}, {"ReceivedDate", type date}, {"ExpectedArrivalDate", type date}, {"ExpectedDepartureDate", type date}, {"ActualArrivalDate", type date}, {"ActualDepartureDate", type date}, {"InterviewDate", type date}, {"DeclineDate", type date}})
				in
				    #"Changed Type"

	changedProperty = IsHidden

