	partition MNB_Work_ReferralDaysExplosion-f9988d10-65a1-4544-91fa-055525ef40a1 = m
		mode: import
		queryGroup: MNB
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="SELECT DISTINCT#(lf)'MNB' AS CompanyIdentifier,#(lf)CAST(lfr.AcceptedDate AS DATE) AS AcceptedDate,#(lf)CASE WHEN CAST(lfr.DischargeDate AS DATE) IS NULL THEN CAST(GETDATE() AS DATE) ELSE CAST(lfr.DischargeDate AS DATE) END AS DischargeDate,#(lf)CAST(lfr.DischargeDate AS DATE) AS DischargeDateTrue,#(lf)CASE WHEN lfr.ID IS NOT NULL THEN CONCAT('M',lfr.ID) ELSE NULL END AS ID,#(lf)CASE WHEN lfr.PersonID IS NOT NULL THEN CONCAT('M',lfr.PersonID) ELSE NULL END AS PersonID,#(lf)CASE WHEN lfr.TeamID IS NOT NULL THEN CONCAT('M',lfr.TeamID) ELSE NULL END AS TeamID,#(lf)CASE WHEN tf.TeamFunctionID IS NOT NULL THEN CONCAT('M',tf.TeamFunctionID) ELSE NULL END AS TeamFunctionID#(lf)FROM RBMNB.[legacyFactReferral] lfr#(lf)LEFT OUTER JOIN RBMNB.[dlDimTeam] t ON t.TeamID = lfr.TeamID#(lf)LEFT OUTER JOIN RBMNB.[dlDimTeamFunction] tf ON tf.TeamFunctionID = t.TeamFunctionID#(lf)WHERE ID IS NOT NULL#(lf)AND AcceptedDate IS NOT NULL"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"AcceptedDate", Int64.Type}, {"DischargeDate", Int64.Type}, {"DischargeDateTrue", type date}})
				in
				    #"Changed Type"

	changedProperty = IsHidden

