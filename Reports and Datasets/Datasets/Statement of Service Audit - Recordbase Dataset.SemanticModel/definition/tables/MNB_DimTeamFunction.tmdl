	partition MNB_DimTeamFunction-76e962c1-1ab0-42d5-b46a-d267845929fe = m
		mode: import
		queryGroup: MNB
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="SELECT#(lf)'MNB' AS CompanyIdentifier,#(lf)CASE WHEN [TeamFunctionID]IS NOT NULL THEN CONCAT('M',[TeamFunctionID]) ELSE NULL END AS [TeamFunctionID],#(lf)CASE WHEN [TeamConfigurationID]IS NOT NULL THEN CONCAT('M',[TeamConfigurationID]) ELSE NULL END AS [TeamConfigurationID],#(lf)CASE WHEN [DefaultTaskProcessID]IS NOT NULL THEN CONCAT('M',[DefaultTaskProcessID]) ELSE NULL END AS [DefaultTaskProcessID],#(lf)[TeamFunctionCode],#(lf)[TeamFunctionName],#(lf)[TeamFunctionDescription],#(lf)[TeamFunctionAllowConcurrentReferrals],#(lf)[TeamFunctionIsAccomodationBased],#(lf)[TeamFunctionRecentlyDischargedPeriodDays],#(lf)[TeamFunctionAllowExitWithoutDischarge],#(lf)CASE WHEN TeamFunctionName LIKE '%Residential%' THEN 'Residential' WHEN TeamFunctionName LIKE '%Respite%' THEN 'Respite' ELSE TeamFunctionName END AS TeamFunctionNameBucket#(lf)FROM RBMNB.dlDimTeamFunction"])
				in
				    Source

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

