	partition ALL_DimGender-bdc6d3c7-8d08-4722-ab0e-74d5a5feca82 = m
		mode: import
		queryGroup: 'All (Unioned Data)'
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="SELECT#(lf)'EAL' AS CompanyIdentifier,#(lf)CASE WHEN GenderID IS NOT NULL THEN CONCAT('E',GenderID) ELSE NULL END AS GenderID,#(lf)GenderValue,#(lf)GenderText,#(lf)CASE WHEN GenderParentID IS NOT NULL THEN CONCAT('E',GenderParentID) ELSE NULL END AS GenderParentID,#(lf)GenderIsActive#(lf)FROM RBEAL.[dlDimGender]"]),
				    #"Appended Query" = Table.Combine({Source, MNB_DimGender})
				in
				    #"Appended Query"

