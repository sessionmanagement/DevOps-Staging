	partition MNB_Work_AbsentDaysExplosion-f20ea649-5a82-4f3c-abbd-78f981d1bda5 = m
		mode: import
		queryGroup: MNB
		source =
				let
				    Source = Sql.Database(Server, Database, [Query="SELECT DISTINCT#(lf)'MNB' AS CompanyIdentifier,#(lf)CASE WHEN fr.PersonID IS NOT NULL THEN CONCAT('M',fr.PersonID) ELSE NULL END AS PersonID,#(lf)CASE WHEN fr.ID IS NOT NULL THEN CONCAT('M',fr.ID) ELSE NULL END AS ReferralID,#(lf)CASE WHEN dtf.TeamFunctionID IS NOT NULL THEN CONCAT('M',dtf.TeamFunctionID) ELSE NULL END AS TeamFunctionID,#(lf)CASE WHEN dt.TeamID IS NOT NULL THEN CONCAT('M',dt.TeamID) ELSE NULL END AS TeamID,#(lf)CASE WHEN PersonStatusTypeID IS NOT NULL THEN CONCAT('M',PersonStatusTypeID) ELSE NULL END AS PersonStatusTypeID,#(lf)--fr.AcceptedDate,#(lf)--fr.DischargeDate,#(lf)PersonStatusStartDate,#(lf)COALESCE(PersonStatusEndDate,GETDATE()) AS PersonStatusEndDate#(lf)FROM #(lf)RBMNB.[dlFactPersonStatus] fps#(lf)INNER JOIN#(lf)RBMNB.[legacyFactReferral] fr ON fr.PersonID = fps.PersonID AND fps.PersonStatusStartDate BETWEEN fr.AcceptedDate AND COALESCE(fr.DischargeDate,GETDATE())#(lf)INNER JOIN RBMNB.[dlDimTeam] dt ON dt.TeamID = fr.TeamID#(lf)INNER JOIN RBMNB.[dlDimTeamFunction] dtf ON dtf.TeamFunctionID = dt.TeamFunctionID#(lf)WHERE PersonStatusTypeID IN (1,2)#(lf)AND fr.AcceptedDate IS NOT NULL#(lf)AND (dtf.TeamFunctionName LIKE '%Residential%' OR dtf.TeamFunctionName LIKE '%Respite%')"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"PersonStatusStartDate", Int64.Type}, {"PersonStatusEndDate", Int64.Type}})
				in
				    #"Changed Type"

	changedProperty = IsHidden

	annotation PBI_ResultType = Exception

	annotation PBI_NavigationStepName = Navigation

