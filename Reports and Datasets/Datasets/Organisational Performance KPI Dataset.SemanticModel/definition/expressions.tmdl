expression 'New KPI Template Old' = ```
		let
		    // Parameters
		    KPI_Rollup_Area = "OK - 2. Kaimahi are enabled / supported / resourced to deliver services in an evidence-based, effective & safe manner",
		    Specific_Measure = "Hours worked in fortnights < 96hrs",
		    KPI_Description = "Hours worked in fortnights < 96hrs [including external hrs]",
		    
		    // Source KPI SharePoint List
		    SourceKPIList = #"KPI SharePoint List",
		    
		    // Filter KPI SharePoint List
		    FilteredKPIList = Table.SelectRows(SourceKPIList, each 
		        [#"SFA Rollup Area"] = KPI_Rollup_Area and
		        [#"Specific measure"] = Specific_Measure and
		        [#"What is measured?"] = KPI_Description
		    ),
		    
		    // Get KPI thresholds and signs
		    KPIInfo = Table.FirstN(FilteredKPIList, 1),
		    GreenThreshold = KPIInfo{0}[#"KPI-G Value"],
		    AmberThreshold = KPIInfo{0}[#"KPI-A Value"],
		    GreenSign = KPIInfo{0}[#"KPI-G Sign"],
		    AmberSign = KPIInfo{0}[#"KPI-A Sign"],
		    KPIName = KPIInfo{0}[#"What is measured?"],
		    
		    // Get additional KPI Rollup values
		    RollupGreenThreshold = KPIInfo{0}[#"KPI-RU-G Value"],
		    RollupGreenSign = KPIInfo{0}[#"KPI-RU-G Sign"],
		    RollupAmberThreshold = KPIInfo{0}[#"KPI-RU-A Value"],
		    RollupAmberSign = KPIInfo{0}[#"KPI-RU-A Sign"],
		    
		    // Source Fact Table: Change to the appropriate fact table
		    SourceFactTable = #"ODS Employee with Payslips (< 96hrs)",
		    
		    // Process Fact Data: Adjust grouping and operations as needed
		    ProcessedFactData = Table.Group(SourceFactTable, {"Dim Company KEY", "Dim Kaimahi KEY", "gross_name"}, {{"KPI Value", each List.Sum([Total_Hours]), type nullable number}}),
		    
		    // Add KPI details
		    AddKPIDetails = Table.AddColumn(ProcessedFactData, "KPI Name", each KPIName),
		    AddGreenThreshold = Table.AddColumn(AddKPIDetails, "Green Threshold", each GreenThreshold),
		    AddAmberThreshold = Table.AddColumn(AddGreenThreshold, "Amber Threshold", each AmberThreshold),
		    AddGreenSign = Table.AddColumn(AddAmberThreshold, "Green Sign", each GreenSign),
		    AddAmberSign = Table.AddColumn(AddGreenSign, "Amber Sign", each AmberSign),
		    
		    // Add Rollup KPI details
		    AddRollupGreenThreshold = Table.AddColumn(AddAmberSign, "Rollup Green Threshold", each RollupGreenThreshold),
		    AddRollupGreenSign = Table.AddColumn(AddRollupGreenThreshold, "Rollup Green Sign", each RollupGreenSign),
		    AddRollupAmberThreshold = Table.AddColumn(AddRollupGreenSign, "Rollup Amber Threshold", each RollupAmberThreshold),
		    AddRollupAmberSign = Table.AddColumn(AddRollupAmberThreshold, "Rollup Amber Sign", each RollupAmberSign),
		    
		    // Calculate KPI Status
		    AddKPIStatus = Table.AddColumn(AddRollupAmberSign, "KPI Status", each 
		        let
		            CurrentValue = [#"KPI Value"],
		            GreenCheck = if GreenSign = ">=" then CurrentValue >= GreenThreshold else
		                         if GreenSign = ">" then CurrentValue > GreenThreshold else
		                         if GreenSign = "<=" then CurrentValue <= GreenThreshold else
		                         if GreenSign = "<" then CurrentValue < GreenThreshold else
		                         if GreenSign = "=" then CurrentValue = GreenThreshold else false,
		            AmberCheck = if AmberSign = ">=" then CurrentValue >= AmberThreshold else
		                         if AmberSign = ">" then CurrentValue > AmberThreshold else
		                         if AmberSign = "<=" then CurrentValue <= AmberThreshold else
		                         if AmberSign = "<" then CurrentValue < AmberThreshold else
		                         if AmberSign = "=" then CurrentValue = AmberThreshold else false
		        in
		            if CurrentValue = null then null else
		            if GreenCheck then "Green" else
		            if AmberCheck then "Amber" else "Red"
		    ),
		    
		    ChangeType = Table.TransformColumnTypes(AddKPIStatus,{{"KPI Status", type text}, {"Rollup Amber Sign", type text}, {"Rollup Amber Threshold", type number}, {"Rollup Green Sign", type text}, {"Rollup Green Threshold", type number}, {"Amber Sign", type text}, {"Green Sign", type text}, {"Amber Threshold", type number}, {"Green Threshold", type number}, {"KPI Name", type text}})
		in
		    ChangeType
		```
