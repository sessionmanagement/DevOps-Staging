expression 'New KPI Template New' =
		let
		    // Parameters
		    SFA_Rollup_ID = "OK2",
		    SFA_Rollup_Area = "OUR KAIMAHI",
		    KPI_Description = "Leave balance does not exceed 200hrs",
		    Leave_Type_ID = "hzr623_8QIrUXJcOpKO36g",
		    // Additional Parameter
		    // Source KPI SharePoint List
		    SourceKPIList = #"KPI SharePoint List",
		    // Filter KPI SharePoint List
		    FilteredKPIList = Table.SelectRows(
		        SourceKPIList,
		        each
		            [#"SFA Rollup Areas: Rollup ID"] = SFA_Rollup_ID
		            and [#"SFA Rollup Areas: Strategic Focus Area (SFA)"] = SFA_Rollup_Area
		            and [#"What is measured?"] = KPI_Description
		    ),
		    // Get KPI thresholds and signs
		    KPIInfo = Table.FirstN(FilteredKPIList, 1),
		    GreenThreshold = KPIInfo{0}[#"KPI-G Value"],
		    AmberThreshold = KPIInfo{0}[#"KPI-A Value"],
		    GreenSign = KPIInfo{0}[#"KPI-G Sign"],
		    AmberSign = KPIInfo{0}[#"KPI-A Sign"],
		    KPIName = KPIInfo{0}[#"What is measured?"],
		    DimKpiKey = KPIInfo{0}[#"Dim KPI Key"],
		    // Get additional KPI Rollup values
		    RollupGreenThreshold = KPIInfo{0}[#"KPI-RU-G Value"],
		    RollupGreenSign = KPIInfo{0}[#"KPI-RU-G Sign"],
		    RollupAmberThreshold = KPIInfo{0}[#"KPI-RU-A Value"],
		    RollupAmberSign = KPIInfo{0}[#"KPI-RU-A Sign"],
		    // Source Fact Table: Change to the appropriate fact table
		    SourceFactTable = #"Fact Kaimahi Leave",
		    // Process Fact Data: Adjust grouping and operations as needed
		    ProcessedFactData = Table.Group(
		        Table.SelectRows(SourceFactTable, each [#"Leave Type ID"] = Leave_Type_ID),
		        {"Dim Company KEY", "Kaimahi ID"},
		        {{"KPI Value", each List.Sum([#"Kaimahi Leave Balance Hours"]), type number}}
		    ),
		    // Add KPI details
		    AddKPIDetails = Table.AddColumn(ProcessedFactData, "KPI Name", each KPIName),
		    AddGreenThreshold = Table.AddColumn(AddKPIDetails, "Green Threshold", each GreenThreshold),
		    AddAmberThreshold = Table.AddColumn(AddGreenThreshold, "Amber Threshold", each AmberThreshold),
		    AddGreenSign = Table.AddColumn(AddAmberThreshold, "Green Sign", each GreenSign),
		    AddAmberSign = Table.AddColumn(AddGreenSign, "Amber Sign", each AmberSign),
		    // Add Rollup KPI details
		    AddRollupGreenThreshold = Table.AddColumn(AddAmberSign, "Rollup Green Threshold", each RollupGreenThreshold),
		    AddRollupGreenSign = Table.AddColumn(AddRollupGreenThreshold, "Rollup Green Sign", each RollupGreenSign),
		    AddRollupAmberThreshold = Table.AddColumn(
		        AddRollupGreenSign, "Rollup Amber Threshold", each RollupAmberThreshold
		    ),
		    AddRollupAmberSign = Table.AddColumn(AddRollupAmberThreshold, "Rollup Amber Sign", each RollupAmberSign),
		    // Calculate KPI Status
		    AddKPIStatus = Table.AddColumn(
		        AddRollupAmberSign,
		        "KPI Status",
		        each
		            let
		                CurrentValue = [#"KPI Value"],
		                GreenCheck =
		                    if GreenSign = ">=" then
		                        CurrentValue >= GreenThreshold
		                    else if GreenSign = ">" then
		                        CurrentValue > GreenThreshold
		                    else if GreenSign = "<=" then
		                        CurrentValue <= GreenThreshold
		                    else if GreenSign = "<" then
		                        CurrentValue < GreenThreshold
		                    else if GreenSign = "=" then
		                        CurrentValue = GreenThreshold
		                    else
		                        false,
		                AmberCheck =
		                    if AmberSign = ">=" then
		                        CurrentValue >= AmberThreshold
		                    else if AmberSign = ">" then
		                        CurrentValue > AmberThreshold
		                    else if AmberSign = "<=" then
		                        CurrentValue <= AmberThreshold
		                    else if AmberSign = "<" then
		                        CurrentValue < AmberThreshold
		                    else if AmberSign = "=" then
		                        CurrentValue = AmberThreshold
		                    else
		                        false
		            in
		                if CurrentValue = null then
		                    null
		                else if GreenCheck then
		                    "Green"
		                else if AmberCheck then
		                    "Amber"
		                else
		                    "Red"
		    ),
		    AddDimKPIKEY = Table.AddColumn(AddKPIStatus, "Dim KPI Key", each DimKpiKey),
		    ChangeType = Table.TransformColumnTypes(
		        AddDimKPIKEY,
		        {
		            {"KPI Status", type text},
		            {"Rollup Amber Sign", type text},
		            {"Rollup Amber Threshold", type number},
		            {"Rollup Green Sign", type text},
		            {"Rollup Green Threshold", type number},
		            {"Amber Sign", type text},
		            {"Green Sign", type text},
		            {"Amber Threshold", type number},
		            {"Green Threshold", type number},
		            {"KPI Name", type text},
		            {"Dim KPI Key", Int64.Type}
		        }
		    ),
		    #"Added Custom" = Table.AddColumn(ChangeType, "Entity KEY", each "K" & Text.From([Kaimahi ID])),
		    #"Removed Columns" = Table.RemoveColumns(#"Added Custom", {"Kaimahi ID"})
		in
		    #"Removed Columns"
	lineageTag: 685aef8a-0f7f-45db-ba8b-28f42688de63
	queryGroup: 'KPI Templates'

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression Entity_backup_pre_Kaimahi_addition =
		let
		    Source = Sql.Database(Server, Database, [Query="WITH hierarchy_cte AS (#(lf)    -- Level 1 to Level 2#(lf)    SELECT #(lf)        business_unit_hierarchy_level1_name AS parent,#(lf)        business_unit_hierarchy_level2_name AS child,#(lf)#(tab)#(tab)'Business Unit' AS type#(lf)    FROM [edw].[vw_dim_business_unit_hierarchy]#(lf)    WHERE [EDWDMLOperation] <> 'D'#(lf)        AND [dim_business_unit_hierarchy_key] > 0#(lf)        AND business_unit_hierarchy_level2_name IS NOT NULL#(lf)    #(lf)    UNION ALL#(lf)    #(lf)    -- Level 2 to Level 3#(lf)    SELECT #(lf)        business_unit_hierarchy_level2_name AS parent,#(lf)        business_unit_hierarchy_level3_name AS child,#(lf)#(tab)#(tab)'Business Unit' AS type#(lf)    FROM [edw].[vw_dim_business_unit_hierarchy]#(lf)    WHERE [EDWDMLOperation] <> 'D'#(lf)        AND [dim_business_unit_hierarchy_key] > 0#(lf)        AND business_unit_hierarchy_level3_name IS NOT NULL#(lf)    #(lf)    UNION ALL#(lf)    #(lf)    -- Level 3 to Level 4#(lf)    SELECT #(lf)        business_unit_hierarchy_level3_name AS parent,#(lf)        business_unit_hierarchy_level4_name AS child,#(lf)#(tab)#(tab)'Business Unit' AS type#(lf)    FROM [edw].[vw_dim_business_unit_hierarchy]#(lf)    WHERE [EDWDMLOperation] <> 'D'#(lf)        AND [dim_business_unit_hierarchy_key] > 0#(lf)        AND business_unit_hierarchy_level4_name IS NOT NULL#(lf)    #(lf)    UNION ALL#(lf)    #(lf)    -- Level 4 to Level 5#(lf)    SELECT #(lf)        business_unit_hierarchy_level4_name AS parent,#(lf)        business_unit_hierarchy_level5_name AS child,#(lf)#(tab)#(tab)'Business Unit' AS type#(lf)    FROM [edw].[vw_dim_business_unit_hierarchy]#(lf)    WHERE [EDWDMLOperation] <> 'D'#(lf)        AND [dim_business_unit_hierarchy_key] > 0#(lf)        AND business_unit_hierarchy_level5_name IS NOT NULL#(lf)    #(lf)    UNION ALL#(lf)    #(lf)    -- Level 5 to Level 6#(lf)    SELECT #(lf)        business_unit_hierarchy_level5_name AS parent,#(lf)        business_unit_hierarchy_level6_name AS child,#(lf)#(tab)#(tab)'Business Unit' AS type#(lf)    FROM [edw].[vw_dim_business_unit_hierarchy]#(lf)    WHERE [EDWDMLOperation] <> 'D'#(lf)        AND [dim_business_unit_hierarchy_key] > 0#(lf)        AND business_unit_hierarchy_level6_name IS NOT NULL#(lf)    #(lf)    UNION ALL#(lf)    #(lf)    -- Level 6 to Level 7#(lf)    SELECT #(lf)        business_unit_hierarchy_level6_name AS parent,#(lf)        business_unit_hierarchy_level7_name AS child,#(lf)#(tab)#(tab)'Business Unit' AS type#(lf)    FROM [edw].[vw_dim_business_unit_hierarchy]#(lf)    WHERE [EDWDMLOperation] <> 'D'#(lf)        AND [dim_business_unit_hierarchy_key] > 0#(lf)        AND business_unit_hierarchy_level7_name IS NOT NULL#(lf)    #(lf)    UNION ALL#(lf)    #(lf)    -- Level 7 to Final Business Unit#(lf)    SELECT #(lf)        business_unit_hierarchy_level7_name AS parent,#(lf)        business_unit_name AS child,#(lf)#(tab)#(tab)'Business Unit' AS type#(lf)    FROM [edw].[vw_dim_business_unit_hierarchy]#(lf)    WHERE [EDWDMLOperation] <> 'D'#(lf)        AND [dim_business_unit_hierarchy_key] > 0#(lf)        AND business_unit_name IS NOT NULL#(lf))#(lf),Business_Hierarchy_CTE AS (#(lf)    SELECT DISTINCT #(lf)        h.parent AS [Parent BU],#(lf)        h.child AS [Child BU],#(lf)        ps.dim_service_key AS [Parent Dim Service Key],#(lf)        cs.dim_service_key AS [Child Dim Service Key],#(lf)#(tab)#(tab)type AS Type#(lf)    FROM hierarchy_cte h#(lf)    LEFT JOIN [edw].[vw_dim_service] ps ON h.parent = ps.[service_name]#(lf)    LEFT JOIN [edw].[vw_dim_service] cs ON h.child = cs.[service_name]#(lf)    WHERE h.parent <> h.child#(lf)        AND (ps.[DWHIsCurrent] = 1 OR ps.[DWHIsCurrent] IS NULL)#(lf)        AND (cs.[DWHIsCurrent] = 1 OR cs.[DWHIsCurrent] IS NULL)#(lf))#(lf)SELECT DISTINCT#(lf)    [Child BU] AS EntityName,#(lf)    [Parent Dim Service Key] AS ParentEntityKey,#(lf)    [Child Dim Service Key] AS EntityKey,#(lf)#(tab)Type#(lf)FROM Business_Hierarchy_CTE#(lf)WHERE [Parent BU] <> 'Previous Business Unit/s'#(lf)#(lf)UNION ALL#(lf)#(lf)-- Include top-level nodes with no parent#(lf)SELECT DISTINCT#(lf)    business_unit_hierarchy_level1_name AS [Child BU],#(lf)    NULL AS [Parent Dim Service Key],#(lf)    cs.dim_service_key AS [Child Dim Service Key],#(lf)#(tab)'Business Unit' AS Type#(lf)FROM [edw].[vw_dim_business_unit_hierarchy] buh#(lf)LEFT JOIN [edw].[vw_dim_service] cs ON buh.business_unit_hierarchy_level1_name = cs.[service_name]#(lf)WHERE [EDWDMLOperation] <> 'D'#(lf)    AND [dim_business_unit_hierarchy_key] > 0#(lf)    AND business_unit_hierarchy_level1_name IS NOT NULL#(lf)    AND (cs.[DWHIsCurrent] = 1)#(lf)#(lf)UNION ALL#(lf)#(lf)-- Include employees at the bottom level of the hierarchy#(lf)SELECT DISTINCT#(lf)    employee_displayname AS EntityName,#(lf)    cs.dim_service_key AS ParentEntityKey,#(lf)    dim_employee_key AS EntityKey,#(lf)#(tab)'Kaimahi' AS Type#(lf)FROM (#(lf)    SELECT DISTINCT#(lf)        COALESCE(#(lf)            employee_people_leader_business_unit_name_level_9,#(lf)            employee_people_leader_business_unit_name_level_8,#(lf)            employee_people_leader_business_unit_name_level_7,#(lf)            employee_people_leader_business_unit_name_level_6,#(lf)            employee_people_leader_business_unit_name_level_5,#(lf)            employee_people_leader_business_unit_name_level_4,#(lf)            employee_people_leader_business_unit_name_level_3,#(lf)            employee_people_leader_business_unit_name_level_2,#(lf)            employee_people_leader_business_unit_name_level_1#(lf)        ) AS last_non_null,#(lf)        deh.employee_displayname,#(lf)#(tab)#(tab)deh.dim_employee_key#(lf)    FROM [edw].[vw_dim_employee_hierarchy] deh#(lf)#(tab)INNER JOIN [edw].[vw_dim_employee] de ON deh.[dim_employee_key] = de.[dim_employee_key]#(lf)    WHERE #(lf)#(tab)#(tab)de.employee_employment_status IN ('Current Staff', 'Exiting Staff')#(lf)#(tab)#(tab)AND deh.DWHDMLOperation <> 'D'#(lf)        AND deh.DWHIsCurrent = 1#(lf)        AND deh.dim_employee_key > 0#(lf)#(tab)#(tab)AND de.DWHDMLOperation <> 'D'#(lf)        AND de.DWHIsCurrent = 1#(lf)        AND de.dim_employee_key > 0#(lf)) AS EmployeeHierarchy#(lf)INNER JOIN [edw].[vw_dim_service] cs ON EmployeeHierarchy.last_non_null = cs.[service_name]#(lf)WHERE cs.[DWHIsCurrent] = 1;"]),
		    #"Removed Duplicates" = Table.Distinct(Source, {"EntityName"}),
		    #"Filtered Rows" = Table.SelectRows(#"Removed Duplicates", each ([EntityKey] <> null))
		in
