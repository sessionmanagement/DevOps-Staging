expression 'ODS Employee with Payslips (< 96hrs)' =
		let
		    Source = Sql.Database("synapseausprod-ondemand.sql.azuresynapse.net", "ODS", [Query="-- CTE for dim_people#(lf)WITH dim_people AS (#(lf)    SELECT DE.[id]#(lf)        ,DE.[company_id]#(lf)        ,DE.[code] AS EmpID#(lf)        ,IP.[people_id]#(lf)        ,IP.[displayName] AS Kaimahi#(lf)        ,IP.[dateOfBirth]#(lf)        ,IP.[gender]#(lf)        ,IP.[primaryEmailAddress_email]#(lf)        ,IP.[employmentStatus]#(lf)        ,IJ.jobs_id#(lf)        ,IJ.businessUnit_id#(lf)        ,IJ.supervisorPerson_displayName AS Supervisor#(lf)        ,IJ.workType AS 'Work Type'#(lf)        ,IJ.workClass AS 'Work Class'#(lf)        ,IJ.isPrimaryJob#(lf)        ,IJ.jobStatus AS 'Job Status'#(lf)        ,IJ.name AS 'Job Title'#(lf)        ,IJ.fte#(lf)        ,IJ.companyStartDate#(lf)        ,IJ.companyEndDate#(lf)        ,EE.id AS EmpLive_EmpID#(lf)        ,EE.is_active#(lf)        ,IJ.remunerationSchedule_type#(lf)    FROM [Datapay].[employees] DE#(lf)    LEFT JOIN EmpLive.employees EE ON CAST(DE.code AS NVARCHAR(20)) = EE.reference_number#(lf)    LEFT JOIN IntelliHR.people IP ON CAST(DE.code AS NVARCHAR(20)) = IP.employeeNumber#(lf)    LEFT JOIN [IntelliHR].[jobs] IJ ON CAST(DE.code AS NVARCHAR(20)) = IJ.person_employeeNumber#(lf)    WHERE#(lf)        DE.ODSIsCurrent = 1#(lf)        AND EE.ODSIsCurrent = 1#(lf)        AND IP.ODSIsCurrent = 1#(lf)        AND IJ.ODSIsCurrent = 1#(lf)),#(lf)#(lf)-- CTEs for fact_pay_slips#(lf)JobsData AS (#(lf)    SELECT e.id AS employee_id#(lf)        ,e.code AS employee_code#(lf)        ,e.company_id#(lf)        ,i.businessUnit_name#(lf)        ,i.businessUnit_id AS IntellihrServiceID#(lf)        ,i.jobs_id#(lf)        ,i.positionStartDate#(lf)        ,ROW_NUMBER() OVER (#(lf)            PARTITION BY e.id ORDER BY i.positionStartDate#(lf)            ) AS JobNo#(lf)    FROM [DataPay].[employees] e#(lf)    LEFT JOIN [IntelliHR].[jobs] i ON e.code = i.person_employeeNumber#(lf)    WHERE e.ODSIsCurrent = 1#(lf)    GROUP BY e.id#(lf)        ,e.code#(lf)        ,e.company_id#(lf)        ,i.businessUnit_name#(lf)        ,i.businessUnit_id#(lf)        ,i.jobs_id#(lf)        ,i.positionStartDate#(lf)),#(lf)#(lf)EmployeeData AS (#(lf)    SELECT employee_id#(lf)        ,employee_code#(lf)        ,company_id#(lf)        ,businessUnit_name#(lf)        ,IntellihrServiceID#(lf)        ,jobs_id#(lf)        ,CAST(positionStartDate AS DATE) AS PositionStartDate#(lf)        ,JobNo#(lf)        ,COALESCE(CAST(LEAD(positionStartDate) OVER (#(lf)                    PARTITION BY employee_id ORDER BY JobNo#(lf)                    ) AS DATE), CAST(GETDATE() AS DATE)) AS PositionEndDate#(lf)    FROM JobsData#(lf)),#(lf)#(lf)PaySlipData AS (#(lf)    SELECT ps.pay_packet_id#(lf)        ,ps.employee_id#(lf)        ,ps.pay_period_start_date#(lf)        ,ps.pay_period_end_date#(lf)        ,ps.pay_packet_type#(lf)    FROM Datapay.pay_slips ps#(lf)    WHERE ps.pay_packet_type IN (#(lf)            'main'#(lf)            ,'manual'#(lf)            )#(lf)),#(lf)#(lf)GrossData AS (#(lf)    SELECT DISTINCT psg.pay_packet_row_id#(lf)        ,psg.pay_packet_id#(lf)        ,psg.employee_id#(lf)        ,e.employee_code#(lf)        ,e.company_id#(lf)        ,e.jobs_id#(lf)        ,e.businessUnit_name#(lf)        ,e.IntellihrServiceID#(lf)        ,CASE #(lf)            WHEN psg.gross_name LIKE '%addtional%'#(lf)                THEN 'Additional Hours'#(lf)            ELSE psg.gross_name#(lf)            END AS gross_name#(lf)        ,ps.pay_period_start_date#(lf)        ,ps.pay_period_end_date#(lf)        ,ps.pay_packet_type#(lf)        ,psg.gross_summary#(lf)        ,TRY_CAST(LEFT(psg.gross_summary, CHARINDEX(' ', psg.gross_summary) - 1) AS DECIMAL(18, 8)) AS numeric_value#(lf)        ,CASE #(lf)            WHEN psg.gross_summary LIKE '%hours%'#(lf)                THEN 'hours'#(lf)            WHEN psg.gross_summary LIKE '%day%'#(lf)                THEN 'days'#(lf)            WHEN psg.gross_summary LIKE '%weeks%'#(lf)                THEN 'weeks'#(lf)            ELSE 'other'#(lf)            END AS unit_type#(lf)        ,ROW_NUMBER() OVER (#(lf)            PARTITION BY psg.pay_packet_row_id ORDER BY psg.ODSEffectiveFrom DESC#(lf)            ) AS duplicateRowID#(lf)    FROM Datapay.pay_slips_gross psg#(lf)    JOIN PaySlipData ps ON psg.pay_packet_id = ps.pay_packet_id#(lf)    JOIN EmployeeData e ON ps.employee_id = e.employee_id#(lf)        AND ps.pay_period_start_date <= e.PositionENDDate#(lf)        AND ps.pay_period_end_date >= e.PositionStartDate#(lf)    WHERE psg.gross_name IN (#(lf)            'Addtional Hours'#(lf)            ,'Alternative Holiday Payment'#(lf)            ,'Annual Leave Payment'#(lf)            ,'Annual Leave Payment - Parental Rate'#(lf)            ,'Bereavement Leave Payment'#(lf)            ,'Birthday Leave Payment'#(lf)            ,'COVID-19 Leave Payment'#(lf)            ,'Cultural Contribution Payment'#(lf)            ,'Discretionary Leave Payment'#(lf)            ,'Discretionary Payment'#(lf)            ,'Disturbed Hours'#(lf)            ,'Domestic Violence Leave Payment'#(lf)            ,'In Lieu Of Notice - Extra Pay'#(lf)            ,'Long Service Leave Payment'#(lf)            ,'Meeting Hours'#(lf)            ,'Ordinary Pay'#(lf)            ,'Overtime x0.5'#(lf)            ,'Public Holiday Payment'#(lf)            ,'Sick Leave Payment'#(lf)            ,'Study Leave Payment'#(lf)            ,'Union Leave Payment'#(lf)            ,'Well Being Leave Payment'#(lf)            )#(lf)),#(lf)#(lf)GrossPayData AS (#(lf)    SELECT pay_packet_row_id#(lf)        ,pay_packet_id#(lf)        ,employee_id#(lf)        ,employee_code#(lf)        ,company_id#(lf)        ,jobs_id#(lf)        ,businessUnit_name#(lf)        ,IntellihrServiceID#(lf)        ,gross_name#(lf)        ,gross_summary#(lf)        ,numeric_value#(lf)        ,unit_type#(lf)        ,pay_period_start_date#(lf)        ,pay_period_end_date#(lf)        ,pay_packet_type#(lf)        ,NULL AS home_costing_percentage#(lf)        ,'Primary Cost Center' AS allocation_type#(lf)    FROM GrossData gd#(lf)    WHERE duplicateRowID = 1#(lf)),#(lf)#(lf)PaySlipAllocations AS (#(lf)    SELECT psg.pay_packet_row_id#(lf)        ,ps.pay_packet_id#(lf)        ,e.id AS employee_id#(lf)        ,e.code AS employee_code#(lf)        ,ca.home_cost_box_division AS company_id#(lf)        ,ca.home_cost_box_sub_department_code AS jobs_id#(lf)        ,ib.name AS businessUnit_name#(lf)        ,ib.business_unit_id AS IntellihrServiceID#(lf)        ,psg.gross_name#(lf)        ,psg.gross_summary#(lf)        ,TRY_CAST(LEFT(psg.gross_summary, CHARINDEX(' ', psg.gross_summary) - 1) AS DECIMAL(18, 8)) AS numeric_value#(lf)        ,CASE #(lf)            WHEN psg.gross_summary LIKE '%hours%'#(lf)                THEN 'hours'#(lf)            WHEN psg.gross_summary LIKE '%day%'#(lf)                THEN 'days'#(lf)            WHEN psg.gross_summary LIKE '%weeks%'#(lf)                THEN 'weeks'#(lf)            ELSE 'other'#(lf)            END AS unit_type#(lf)        ,ps.pay_period_start_date#(lf)        ,ps.pay_period_end_date#(lf)        ,ps.pay_packet_type#(lf)        ,ca.home_costing_percentage#(lf)        ,'Allocated Cost Center' AS allocation_type#(lf)    FROM Datapay.employees e#(lf)    JOIN Datapay.pay_slips ps ON e.id = ps.employee_id#(lf)    JOIN Datapay.pay_slips_gross psg ON ps.pay_packet_id = psg.pay_packet_id#(lf)    RIGHT JOIN [Datapay].[cost_allocations] ca ON e.code = ca.employee_code#(lf)        AND ps.pay_period_start_date <= ca.ODSEffectiveTo#(lf)        AND ps.pay_period_end_date >= ca.ODSEffectiveFrom#(lf)    LEFT JOIN [IntelliHR].[business_unit] ib ON ca.net_home_cost_box_sub_department_code = ib.code#(lf)    WHERE e.ODSIsCurrent = 1#(lf)        AND ps.pay_packet_type = 'Main'#(lf)        AND psg.gross_name IN (#(lf)            'Addtional Hours'#(lf)            ,'Alternative Holiday Payment'#(lf)            ,'Annual Leave Payment'#(lf)            ,'Annual Leave Payment - Parental Rate'#(lf)            ,'Bereavement Leave Payment'#(lf)            ,'Birthday Leave Payment'#(lf)            ,'COVID-19 Leave Payment'#(lf)            ,'Cultural Contribution Payment'#(lf)            ,'Discretionary Leave Payment'#(lf)            ,'Discretionary Payment'#(lf)            ,'Disturbed Hours'#(lf)            ,'Domestic Violence Leave Payment'#(lf)            ,'In Lieu Of Notice - Extra Pay'#(lf)            ,'Long Service Leave Payment'#(lf)            ,'Meeting Hours'#(lf)            ,'Ordinary Pay'#(lf)            ,'Overtime x0.5'#(lf)            ,'Public Holiday Payment'#(lf)            ,'Sick Leave Payment'#(lf)            ,'Study Leave Payment'#(lf)            ,'Union Leave Payment'#(lf)            ,'Well Being Leave Payment'#(lf)            )#(lf)),#(lf)#(lf)JOINED AS (#(lf)    SELECT *#(lf)    FROM GrossPayData#(lf)    #(lf)    UNION#(lf)    #(lf)    SELECT *#(lf)    FROM PaySlipAllocations#(lf)),#(lf)#(lf)HoursConversion AS (#(lf)    SELECT jd.pay_packet_row_id#(lf)        ,jd.pay_packet_id#(lf)        ,jd.employee_id#(lf)        ,jd.employee_code#(lf)        ,jd.company_id#(lf)        ,jd.jobs_id#(lf)        ,jd.businessUnit_name#(lf)        ,jd.IntellihrServiceID#(lf)        ,jd.gross_name#(lf)        ,jd.gross_summary#(lf)        ,CASE #(lf)            WHEN jd.unit_type = 'hours'#(lf)                THEN jd.numeric_value#(lf)            WHEN jd.unit_type = 'days'#(lf)                THEN jd.numeric_value * 8#(lf)            WHEN jd.unit_type = 'weeks'#(lf)                THEN jd.numeric_value * 40#(lf)            ELSE 0#(lf)            END AS Total_Hours#(lf)        ,jd.pay_period_start_date#(lf)        ,jd.pay_period_end_date#(lf)        ,COUNT(*) OVER (PARTITION BY jd.pay_packet_row_id) AS allocation_count#(lf)        ,ROW_NUMBER() OVER (#(lf)            PARTITION BY jd.pay_packet_row_id ORDER BY jd.home_costing_percentage#(lf)            ) AS rn#(lf)        ,jd.pay_packet_type#(lf)        ,jd.home_costing_percentage AS OLD_home_costing_percentage#(lf)        ,CASE #(lf)            WHEN jd.home_costing_percentage IS NULL#(lf)                THEN 1 - SUM(home_costing_percentage) OVER (PARTITION BY jd.pay_packet_row_id)#(lf)            ELSE jd.home_costing_percentage#(lf)            END AS NEW_home_costing_percentage#(lf)        ,'PAYE' AS deductions_name#(lf)        ,jd.allocation_type#(lf)    FROM JOINED jd#(lf)),#(lf)#(lf)fact_pay_slips AS (#(lf)    SELECT pay_packet_row_id#(lf)        ,pay_packet_id#(lf)        ,employee_id#(lf)        ,employee_code#(lf)        ,company_id#(lf)        ,jobs_id#(lf)        ,businessUnit_name#(lf)        ,IntellihrServiceID#(lf)        ,gross_name#(lf)        ,gross_summary#(lf)        ,Total_Hours#(lf)        ,COALESCE(Total_Hours * NEW_home_costing_percentage, CASE #(lf)                WHEN rn = 1#(lf)                    THEN Total_Hours#(lf)                ELSE 0#(lf)                END) AS allocated_hours#(lf)        ,pay_period_start_date#(lf)        ,pay_period_end_date#(lf)        ,allocation_count#(lf)        ,rn#(lf)        ,pay_packet_type#(lf)        ,OLD_home_costing_percentage#(lf)        ,NEW_home_costing_percentage#(lf)        ,deductions_name#(lf)    FROM HoursConversion#(lf))#(lf)#(lf)-- Main query joining dim_people and fact_pay_slips#(lf)SELECT #(lf)    dp.*,#(lf)    fps.*#(lf)FROM #(lf)    dim_people dp#(lf)JOIN #(lf)    fact_pay_slips fps ON dp.EmpID = fps.employee_code AND dp.company_id = fps.company_id#(lf)WHERE #(lf)    fps.pay_period_start_date = (SELECT MAX(pay_period_start_date) FROM fact_pay_slips)#(lf)#(tab)AND (gross_name = 'Ordinary Pay'#(lf)#(tab)OR gross_name like '%hours%')#(tab);"]),
		    #"Merged Queries" = Table.NestedJoin(Source, {"company_id"}, #"Dim Company", {"Dim Company Datapay KEY"}, "Dim Company", JoinKind.LeftOuter),
		    #"Expanded Dim Company" = Table.ExpandTableColumn(#"Merged Queries", "Dim Company", {"Dim Company KEY", "Company Name"}, {"Dim Company KEY", "Company Name"})
		in
		    #"Expanded Dim Company"
	lineageTag: 730875d7-2826-480e-b729-65aadec7da6b
	queryGroup: 'Work In Progress\ODS'

