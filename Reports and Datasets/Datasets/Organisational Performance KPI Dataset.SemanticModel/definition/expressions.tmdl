expression 'work_all households have an occupancy agreement' =
		let
		    Source = Sql.Database("sql-dev-aue-svc-datawarehouse-01.database.windows.net", "sqldb-dev-datawarehouse-01", [Query="SELECT DISTINCT#(lf)         fpt.dim_property_key#(lf)#(tab),ds.dim_service_key#(lf)    ,CASE WHEN [property_tenant_tenancy_lease_agreement_date_key] > 0 THEN 1 ELSE  0 END AS ""KPI Value""#(lf)FROM #(lf)    [edw].[vw_fact_property_tenant] fpt#(lf)INNER JOIN [edw].[vw_dim_property] dp#(lf)#(tab)ON fpt.dim_property_key = fpt.dim_property_key#(lf)INNER JOIN [edw].[vw_dim_service] ds#(lf)#(tab)ON ds.service_name = dp.property_bc_service_name#(lf)WHERE fpt.DWHDMLOperation <> 'D'#(lf)#(tab)AND dp.DWHIsCurrent = 1#(lf)#(tab)AND dp.DWHDMLOperation <> 'D'#(lf)#(tab)AND ds.DWHIsCurrent = 1#(lf)#(tab)AND ds.DWHDMLOperation <> 'D'"]),
		        ApplyNamingConventions = (columnName as text) as text =>
		        let
		            replaceKaimahi = Text.Replace(columnName, "employee_", "Kaimahi_"),
		            replaceClient = Text.Replace(replaceKaimahi, "client_", "Tangata_Whaiora_"),
		            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
		            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
		            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
		            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
		            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
		            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
		            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
		            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
		            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
		            capitaliseWords = Text.Proper(renameDWHSourceSystem),
		            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
		            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
		            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH"),
		            capitaliseKPI = Text.Replace(capitaliseDWH, "Kpi", "KPI")
		        in
		            capitaliseKPI,
		    #"Transform Column Names" = Table.TransformColumnNames(Source, each ApplyNamingConventions(_))
		in
		    #"Transform Column Names"
	lineageTag: 35186552-9e76-4c5d-9a15-e9faacaef616
	queryGroup: 'Work In Progress\EDW\dev'

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression 'Time since last leave < 6 months' =
		let
		    // Parameters
		    SFA_Rollup_ID = "OK2",
		    SFA_Rollup_Area = "OUR KAIMAHI",
		    KPI_Description = "Time since last leave taken < 6 months",
		    // Additional Parameter
		    // Source KPI SharePoint List
		    SourceKPIList = #"KPI SharePoint List",
		    // Filter KPI SharePoint List
		    FilteredKPIList = Table.SelectRows(
		        SourceKPIList,
		        each
		            [#"SFA Rollup Areas: Rollup ID"] = SFA_Rollup_ID
		            and [#"SFA Rollup Areas: Strategic Focus Area (SFA)"] = SFA_Rollup_Area
		            and [#"What is measured?"] = KPI_Description
		    ),
		    // Get KPI thresholds and signs
		    KPIInfo = Table.FirstN(FilteredKPIList, 1),
		    GreenThreshold = KPIInfo{0}[#"KPI-G Value"],
		    AmberThreshold = KPIInfo{0}[#"KPI-A Value"],
		    GreenSign = KPIInfo{0}[#"KPI-G Sign"],
		    AmberSign = KPIInfo{0}[#"KPI-A Sign"],
		    KPIName = KPIInfo{0}[#"What is measured?"],
		    DimKpiKey = KPIInfo{0}[#"Dim KPI Key"],
		    // Get additional KPI Rollup values
		    RollupGreenThreshold = KPIInfo{0}[#"KPI-RU-G Value"],
		    RollupGreenSign = KPIInfo{0}[#"KPI-RU-G Sign"],
		    RollupAmberThreshold = KPIInfo{0}[#"KPI-RU-A Value"],
		    RollupAmberSign = KPIInfo{0}[#"KPI-RU-A Sign"],
		    // Source Fact Table: Change to the appropriate fact table
		    SourceFactTable = #"work_time since last leave < 6 months",
		    // Add KPI details
		    AddKPIDetails = Table.AddColumn(SourceFactTable, "KPI Name", each KPIName),
		    AddGreenThreshold = Table.AddColumn(AddKPIDetails, "Green Threshold", each GreenThreshold),
		    AddAmberThreshold = Table.AddColumn(AddGreenThreshold, "Amber Threshold", each AmberThreshold),
		    AddGreenSign = Table.AddColumn(AddAmberThreshold, "Green Sign", each GreenSign),
		    AddAmberSign = Table.AddColumn(AddGreenSign, "Amber Sign", each AmberSign),
		    // Add Rollup KPI details
		    AddRollupGreenThreshold = Table.AddColumn(AddAmberSign, "Rollup Green Threshold", each RollupGreenThreshold),
		    AddRollupGreenSign = Table.AddColumn(AddRollupGreenThreshold, "Rollup Green Sign", each RollupGreenSign),
		    AddRollupAmberThreshold = Table.AddColumn(
		        AddRollupGreenSign, "Rollup Amber Threshold", each RollupAmberThreshold
		    ),
		    AddRollupAmberSign = Table.AddColumn(AddRollupAmberThreshold, "Rollup Amber Sign", each RollupAmberSign),
		    // Calculate KPI Status
		    AddKPIStatus = Table.AddColumn(
		        AddRollupAmberSign,
		        "KPI Status",
		        each
		            let
		                CurrentValue = [#"KPI Value"],
		                GreenCheck =
		                    if GreenSign = ">=" then
		                        CurrentValue >= GreenThreshold
		                    else if GreenSign = ">" then
		                        CurrentValue > GreenThreshold
		                    else if GreenSign = "<=" then
		                        CurrentValue <= GreenThreshold
		                    else if GreenSign = "<" then
		                        CurrentValue < GreenThreshold
		                    else if GreenSign = "=" then
		                        CurrentValue = GreenThreshold
		                    else
		                        false,
		                AmberCheck =
		                    if AmberSign = ">=" then
		                        CurrentValue >= AmberThreshold
		                    else if AmberSign = ">" then
		                        CurrentValue > AmberThreshold
		                    else if AmberSign = "<=" then
		                        CurrentValue <= AmberThreshold
		                    else if AmberSign = "<" then
		                        CurrentValue < AmberThreshold
		                    else if AmberSign = "=" then
		                        CurrentValue = AmberThreshold
		                    else
		                        false
		            in
		                if CurrentValue = null then
		                    null
		                else if GreenCheck then
		                    "Green"
		                else if AmberCheck then
		                    "Amber"
		                else
		                    "Red"
		    ),
		    AddDimKPIKEY = Table.AddColumn(AddKPIStatus, "Dim KPI Key", each DimKpiKey),
		    ChangeType = Table.TransformColumnTypes(
		        AddDimKPIKEY,
		        {
		            {"KPI Status", type text},
		            {"Rollup Amber Sign", type text},
		            {"Rollup Amber Threshold", type number},
		            {"Rollup Green Sign", type text},
		            {"Rollup Green Threshold", type number},
		            {"Amber Sign", type text},
		            {"Green Sign", type text},
		            {"Amber Threshold", type number},
		            {"Green Threshold", type number},
		            {"KPI Name", type text},
		            {"Dim KPI Key", Int64.Type}
		        }
		    ),
		    #"Added Conditional Column" = Table.AddColumn(ChangeType, "Entity KEY", each "K" & Text.From([Kaimahi ID])),
		    #"Removed Columns" = Table.RemoveColumns(#"Added Conditional Column", {"Kaimahi ID"})
		    // Add K to Dim Kaimahi Key to correctly join on Entity Key
		in
		    #"Removed Columns"
	lineageTag: faf14ff6-281b-4f43-b353-37095034e8ab
	queryGroup: 'KPI Calculations'

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression 'work_time since last leave < 6 months' =
		let
		    Source = Sql.Database(Server, Database, [Query="WITH employees AS (#(lf)    SELECT DISTINCT#(lf)        deh.employee_displayname AS EntityName,#(lf)        deh.dim_employee_key,#(lf)        de.employee_employment_status,#(lf)        de.employee_id,#(lf)        de.employee_start_date,  -- Included employee_start_date#(lf)        'Kaimahi' AS Type#(lf)    FROM [edw].[vw_dim_employee_hierarchy] deh#(lf)    INNER JOIN [edw].[vw_dim_employee] de ON deh.dim_employee_key = de.dim_employee_key#(lf)    INNER JOIN [edw].[vw_dim_service] cs ON COALESCE(#(lf)        deh.employee_people_leader_business_unit_name_level_9,#(lf)        deh.employee_people_leader_business_unit_name_level_8,#(lf)        deh.employee_people_leader_business_unit_name_level_7,#(lf)        deh.employee_people_leader_business_unit_name_level_6,#(lf)        deh.employee_people_leader_business_unit_name_level_5,#(lf)        deh.employee_people_leader_business_unit_name_level_4,#(lf)        deh.employee_people_leader_business_unit_name_level_3,#(lf)        deh.employee_people_leader_business_unit_name_level_2,#(lf)        deh.employee_people_leader_business_unit_name_level_1#(lf)    ) = cs.service_name#(lf)    WHERE #(lf)        de.employee_employment_status IN ('Current Staff', 'Exiting Staff')#(lf)        AND deh.DWHDMLOperation <> 'D'#(lf)        AND deh.DWHIsCurrent = 1#(lf)        AND deh.dim_employee_key > 0#(lf)        AND de.DWHDMLOperation <> 'D'#(lf)        AND de.DWHIsCurrent = 1#(lf)        AND de.dim_employee_key > 0#(lf)        AND cs.DWHIsCurrent = 1#(lf))#(lf)#(lf), cte_leave AS (#(lf)    SELECT#(lf)        fel.fact_employee_leave_key,#(lf)        dpc.payroll_category_name,#(lf)        fel.employee_leave_effective_date_key,#(lf)        fel.employee_id,#(lf)        fel.employee_leave_taken_hours#(lf)    FROM [edw].[vw_fact_employee_leave] fel#(lf)    INNER JOIN [edw].[vw_dim_payroll_category] dpc ON fel.dim_payroll_category_key = dpc.dim_payroll_category_key#(lf)    WHERE dpc.payroll_category_name = 'Annual leave'#(lf)        AND fel.employee_leave_taken_hours > 0  -- Directly consider records where leave was taken#(lf)        AND CONVERT(DATE, CONVERT(VARCHAR(8), fel.employee_leave_effective_date_key), 112) <= GETDATE()  -- Exclude future dates#(lf))#(lf)#(lf), last_leave AS (#(lf)    SELECT#(lf)        cl.employee_id,#(lf)        MAX(cl.employee_leave_effective_date_key) AS last_leave_effective_date_key#(lf)    FROM cte_leave cl#(lf)    GROUP BY cl.employee_id#(lf))#(lf)#(lf)SELECT #(lf)    --e.dim_employee_key,#(lf)    e.employee_id,#(lf)    --e.employee_employment_status,#(lf)    --e.employee_start_date,#(lf)    -- Calculate last_leave_date#(lf)   -- COALESCE(#(lf)   --     CONVERT(DATE, CONVERT(VARCHAR(8), l.last_leave_effective_date_key), 112), #(lf)   --     --CASE #(lf)   --     --    WHEN DATEDIFF(month, e.employee_start_date, GETDATE()) <= 6 THEN#(lf)#(tab)#(tab)#(tab)--e.employee_start_date#(lf)   --         --ELSE NULL END#(lf)   -- ) AS last_leave_date,#(lf)    -- Identify employees who haven't taken leave within the last 6 months#(lf)     DATEDIFF(MONTH, #(lf)            COALESCE(#(lf)                CONVERT(DATE, CONVERT(VARCHAR(8), l.last_leave_effective_date_key), 112), #(lf)                e.employee_start_date#(lf)            ), GETDATE()#(lf)#(tab)#(tab)#(tab)) AS [KPI Value]#(lf)FROM employees e#(lf)LEFT JOIN last_leave l ON e.employee_id = l.employee_id#(lf)ORDER BY e.employee_id;"]),
		        ApplyNamingConventions = (columnName as text) as text =>
		        let
		            replaceKaimahi = Text.Replace(columnName, "employee_", "Kaimahi_"),
		            replaceClient = Text.Replace(replaceKaimahi, "client_", "Tangata_Whaiora_"),
		            replaceUnderscore = Text.Replace(replaceClient, "_", " "),
		            renameDWHBatchId = Text.Replace(replaceUnderscore, "DWHBatchId", "DWH Batch Id"),
		            renameDWHCreatedAt = Text.Replace(renameDWHBatchId, "DWHCreatedAt", "DWH Created At"),
		            renameDWHDMLOperation = Text.Replace(renameDWHCreatedAt, "DWHDMLOperation", "DWH DML Operation"),
		            renameDWHEffectiveFrom = Text.Replace(renameDWHDMLOperation, "DWHEffectiveFrom", "DWH Effective From"),
		            renameDWHEffectiveTo = Text.Replace(renameDWHEffectiveFrom, "DWHEffectiveTo", "DWH Effective To"),
		            renameDWHIsCurrent = Text.Replace(renameDWHEffectiveTo, "DWHIsCurrent", "DWH Is Current"),
		            renameDWHModifiedOn = Text.Replace(renameDWHIsCurrent, "DWHModifiedOn", "DWH Modified On"),
		            renameDWHSourceSystem = Text.Replace(renameDWHModifiedOn, "DWHSourceSystem", "DWH Source System"),
		            capitaliseWords = Text.Proper(renameDWHSourceSystem),
		            capitaliseID = Text.Replace(capitaliseWords, "Id", "ID"),
		            capitaliseKEY = Text.Replace(capitaliseID, "Key", "KEY"),
		            capitaliseDWH = Text.Replace(capitaliseKEY, "Dwh", "DWH"),
		            capitaliseKPI = Text.Replace(capitaliseDWH, "Kpi", "KPI")
		        in
		            capitaliseKPI,
		    #"Transform Column Names" = Table.TransformColumnNames(Source, each ApplyNamingConventions(_))
		in
		    #"Transform Column Names"
	lineageTag: 1ae5dc94-2775-422e-b628-a1bcdf1e2f12
	queryGroup: 'Work In Progress\EDW\prod'

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

