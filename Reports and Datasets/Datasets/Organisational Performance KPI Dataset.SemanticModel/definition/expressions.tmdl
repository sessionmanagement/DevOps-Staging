expression Load_Entity_Data =
		let
		    Source = Sql.Database(Server, Database, [Query="WITH CurrentServices AS (#(lf)    SELECT#(lf)        service_id,#(lf)        dim_service_key#(lf)    FROM [edw].[vw_dim_service]#(lf)    WHERE DWHIsCurrent = 1#(lf)    AND DWHDMLOperation <> 'D'#(lf)),#(lf)#(lf)-- Define the hierarchy of business units#(lf)hierarchy_cte AS (#(lf)    -- Level 1 to Level 2#(lf)    SELECT #(lf)        business_unit_hierarchy_level1_name AS parent,#(lf)        business_unit_hierarchy_level2_name AS child,#(lf)        'Business Unit' AS type#(lf)    FROM [edw].[vw_dim_business_unit_hierarchy]#(lf)    WHERE [EDWDMLOperation] <> 'D'#(lf)        AND [dim_business_unit_hierarchy_key] > 0#(lf)        AND business_unit_hierarchy_level2_name IS NOT NULL#(lf)    #(lf)    UNION ALL#(lf)    #(lf)    -- Continue for levels 2 to 7#(lf)    SELECT #(lf)        business_unit_hierarchy_level2_name AS parent,#(lf)        business_unit_hierarchy_level3_name AS child,#(lf)        'Business Unit' AS type#(lf)    FROM [edw].[vw_dim_business_unit_hierarchy]#(lf)    WHERE [EDWDMLOperation] <> 'D'#(lf)        AND [dim_business_unit_hierarchy_key] > 0#(lf)        AND business_unit_hierarchy_level3_name IS NOT NULL#(lf)    #(lf)    UNION ALL#(lf)    #(lf)    SELECT #(lf)        business_unit_hierarchy_level3_name AS parent,#(lf)        business_unit_hierarchy_level4_name AS child,#(lf)        'Business Unit' AS type#(lf)    FROM [edw].[vw_dim_business_unit_hierarchy]#(lf)    WHERE [EDWDMLOperation] <> 'D'#(lf)        AND [dim_business_unit_hierarchy_key] > 0#(lf)        AND business_unit_hierarchy_level4_name IS NOT NULL#(lf)    #(lf)    UNION ALL#(lf)    #(lf)    SELECT #(lf)        business_unit_hierarchy_level4_name AS parent,#(lf)        business_unit_hierarchy_level5_name AS child,#(lf)        'Business Unit' AS type#(lf)    FROM [edw].[vw_dim_business_unit_hierarchy]#(lf)    WHERE [EDWDMLOperation] <> 'D'#(lf)        AND [dim_business_unit_hierarchy_key] > 0#(lf)        AND business_unit_hierarchy_level5_name IS NOT NULL#(lf)    #(lf)    UNION ALL#(lf)    #(lf)    SELECT #(lf)        business_unit_hierarchy_level5_name AS parent,#(lf)        business_unit_hierarchy_level6_name AS child,#(lf)        'Business Unit' AS type#(lf)    FROM [edw].[vw_dim_business_unit_hierarchy]#(lf)    WHERE [EDWDMLOperation] <> 'D'#(lf)        AND [dim_business_unit_hierarchy_key] > 0#(lf)        AND business_unit_hierarchy_level6_name IS NOT NULL#(lf)    #(lf)    UNION ALL#(lf)    #(lf)    SELECT #(lf)        business_unit_hierarchy_level6_name AS parent,#(lf)        business_unit_hierarchy_level7_name AS child,#(lf)        'Business Unit' AS type#(lf)    FROM [edw].[vw_dim_business_unit_hierarchy]#(lf)    WHERE [EDWDMLOperation] <> 'D'#(lf)        AND [dim_business_unit_hierarchy_key] > 0#(lf)        AND business_unit_hierarchy_level7_name IS NOT NULL#(lf)    #(lf)    UNION ALL#(lf)    #(lf)    SELECT #(lf)        business_unit_hierarchy_level7_name AS parent,#(lf)        business_unit_name AS child,#(lf)        'Business Unit' AS type#(lf)    FROM [edw].[vw_dim_business_unit_hierarchy]#(lf)    WHERE [EDWDMLOperation] <> 'D'#(lf)        AND [dim_business_unit_hierarchy_key] > 0#(lf)        AND business_unit_name IS NOT NULL#(lf)),#(lf)#(lf)-- Existing Housing Records CTE#(lf)ExistingHousingRecords AS (#(lf)    SELECT DISTINCT#(lf)        dp.property_name AS EntityName,#(lf)        CONCAT('BU', ds.dim_service_key) AS ParentEntityKey,#(lf)        CONCAT('H', dp.dim_property_key) AS EntityKey,#(lf)        'Housing' AS Type#(lf)    FROM #(lf)        [edw].[vw_dim_property] dp#(lf)    INNER JOIN [edw].[vw_dim_service] ds#(lf)        ON ds.service_name = dp.property_bc_service_name#(lf)    WHERE #(lf)        dp.DWHIsCurrent = 1#(lf)        AND dp.DWHDMLOperation <> 'D'#(lf)        AND ds.DWHIsCurrent = 1#(lf)        AND ds.DWHDMLOperation <> 'D'#(lf)),#(lf)#(lf)-- Additional Housing Records CTE#(lf)AdditionalHousingRecords AS (#(lf)    SELECT#(lf)        ds.service_name AS EntityName,#(lf)        NULL AS ParentEntityKey,#(lf)        CONCAT('BU', ds.dim_service_key) AS EntityKey,#(lf)        'Housing' AS Type#(lf)    FROM#(lf)        [edw].[vw_dim_service] ds#(lf)    WHERE #(lf)        ds.dim_company_key = 2#(lf)        AND ds.DWHIsCurrent = 1#(lf)        AND ds.DWHDMLOperation <> 'D'#(lf)        AND NOT EXISTS (#(lf)            SELECT 1#(lf)            FROM ExistingHousingRecords ehr#(lf)            WHERE ehr.EntityKey = CONCAT('H', ds.dim_service_key)#(lf)        )#(lf)),#(lf)#(lf)-- Business Hierarchy CTE#(lf)Business_Hierarchy_CTE AS (#(lf)    SELECT DISTINCT #(lf)        h.parent AS [Parent BU],#(lf)        h.child AS [Child BU],#(lf)        ps.dim_service_key AS [Parent Dim Service Key],#(lf)        cs.dim_service_key AS [Child Dim Service Key],#(lf)        type AS Type#(lf)    FROM hierarchy_cte h#(lf)    LEFT JOIN [edw].[vw_dim_service] ps ON h.parent = ps.[service_name]#(lf)    LEFT JOIN [edw].[vw_dim_service] cs ON h.child = cs.[service_name]#(lf)    WHERE h.parent <> h.child#(lf)        AND (ps.[DWHIsCurrent] = 1 OR ps.[DWHIsCurrent] IS NULL)#(lf)        AND (cs.[DWHIsCurrent] = 1 OR cs.[DWHIsCurrent] IS NULL)#(lf))#(lf)#(lf)-- Main Query#(lf)SELECT DISTINCT#(lf)    [Child BU] AS EntityName,#(lf)    CONCAT('BU',[Parent Dim Service Key]) AS ParentEntityKey,#(lf)    CONCAT('BU',[Child Dim Service Key]) AS EntityKey,#(lf)    Type#(lf)FROM Business_Hierarchy_CTE#(lf)WHERE [Parent BU] <> 'Previous Business Unit/s'#(lf)#(lf)UNION ALL#(lf)#(lf)-- Include top-level nodes with no parent#(lf)SELECT DISTINCT#(lf)    business_unit_hierarchy_level1_name AS [Child BU],#(lf)    NULL AS [Parent Dim Service Key],#(lf)    CONCAT('BU',cs.dim_service_key) AS [Child Dim Service Key],#(lf)    'Business Unit' AS Type#(lf)FROM [edw].[vw_dim_business_unit_hierarchy] buh#(lf)LEFT JOIN [edw].[vw_dim_service] cs ON buh.business_unit_hierarchy_level1_name = cs.[service_name]#(lf)WHERE [EDWDMLOperation] <> 'D'#(lf)    AND [dim_business_unit_hierarchy_key] > 0#(lf)    AND business_unit_hierarchy_level1_name IS NOT NULL#(lf)    AND (cs.[DWHIsCurrent] = 1)#(lf)#(lf)UNION ALL#(lf)#(lf)-- Include employees at the bottom level of the hierarchy#(lf)SELECT DISTINCT#(lf)    employee_displayname AS EntityName,#(lf)    CONCAT('BU',cs.dim_service_key) AS ParentEntityKey,#(lf)    CONCAT('K',employee_id) AS EntityKey,#(lf)    'Kaimahi' AS Type#(lf)FROM (#(lf)    SELECT DISTINCT#(lf)        COALESCE(#(lf)            employee_people_leader_business_unit_name_level_9,#(lf)            employee_people_leader_business_unit_name_level_8,#(lf)            employee_people_leader_business_unit_name_level_7,#(lf)            employee_people_leader_business_unit_name_level_6,#(lf)            employee_people_leader_business_unit_name_level_5,#(lf)            employee_people_leader_business_unit_name_level_4,#(lf)            employee_people_leader_business_unit_name_level_3,#(lf)            employee_people_leader_business_unit_name_level_2,#(lf)            employee_people_leader_business_unit_name_level_1#(lf)        ) AS last_non_null,#(lf)        deh.employee_displayname,#(lf)        deh.employee_id#(lf)    FROM [edw].[vw_dim_employee_hierarchy] deh#(lf)    INNER JOIN [edw].[vw_dim_employee] de ON deh.[dim_employee_key] = de.[dim_employee_key]#(lf)    WHERE #(lf)        de.employee_employment_status IN ('Current Staff', 'Exiting Staff')#(lf)        AND deh.DWHDMLOperation <> 'D'#(lf)        AND deh.DWHIsCurrent = 1#(lf)        AND deh.dim_employee_key > 0#(lf)        AND de.DWHDMLOperation <> 'D'#(lf)        AND de.DWHIsCurrent = 1#(lf)        AND de.dim_employee_key > 0#(lf)) AS EmployeeHierarchy#(lf)INNER JOIN [edw].[vw_dim_service] cs ON EmployeeHierarchy.last_non_null = cs.[service_name]#(lf)WHERE cs.[DWHIsCurrent] = 1#(lf)#(lf)UNION ALL#(lf)#(lf)-- Include Kaimahi based on service for currently active referrals#(lf)SELECT DISTINCT#(lf)CONCAT('PersonID:',dc.client_id) AS EntityName,#(lf)CONCAT('BU',cs.dim_service_key) AS ParentEntityKey,#(lf)CONCAT('TW',fcr.client_id) AS EntityKey,#(lf)'Tangata Whaiora' AS Type#(lf)FROM#(lf)    [edw].[vw_fact_client_referral] fcr#(lf)INNER JOIN #(lf)    [edw].[vw_dim_client_referral] dcr#(lf)    ON fcr.dim_client_referral_key = dcr.dim_client_referral_key#(lf)INNER JOIN#(lf)    [edw].[vw_dim_client] dc#(lf)    ON dc.client_id = fcr.client_id#(lf)LEFT JOIN#(lf)    [edw].[vw_dim_service] ds_original#(lf)    ON ds_original.dim_service_key = fcr.dim_service_key#(lf)LEFT JOIN#(lf)    CurrentServices cs#(lf)    ON cs.service_id = ds_original.service_id#(lf)WHERE#(lf)    dcr.client_referral_status = 'Accepted'#(lf)    AND dcr.client_referral_type = 'InboundReferral'#(lf)    AND dc.DWHDMLOperation <> 'D'#(lf)    AND dc.DWHIsCurrent = 1#(lf)    AND dcr.DWHDMLOperation <> 'D'#(lf)    AND fcr.DWHDMLOperation <> 'D'#(lf)#(tab)--AND dc.client_id = 111257;#(lf)#(lf)UNION ALL#(lf)-- Select housing data from CTEs#(lf)SELECT#(lf)EntityName,#(lf)ParentEntityKey,#(lf)EntityKey,#(lf)Type#(lf)FROM ExistingHousingRecords#(lf)#(lf)UNION ALL#(lf)#(lf)SELECT#(lf)EntityName,#(lf)'EAHT',#(lf)EntityKey,#(lf)Type#(lf)FROM AdditionalHousingRecords#(lf)#(lf)UNION ALL#(lf)#(lf)SELECT #(lf)'EAHT' AS EntityName,#(lf)NULL AS ParentEntityKey,#(lf)'EAHT' AS EntityKey,#(lf)'Housing' AS Type"]),
		    #"Removed Duplicates" = Table.Distinct(Source, {"EntityKey"})
		in
		    #"Removed Duplicates"
