	column 'Percentage Achieved' = DIVIDE('Fact KPI'[KPI Value], 'Fact KPI'[Green Threshold], 0)
		dataType: double
		lineageTag: fa15b54f-bc39-438e-be4b-9eba9312c2df
		summarizeBy: sum
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition 'Fact KPI' = m
		mode: import
		queryGroup: 'Dataset Fact Tables'
		source =
				let
				    Source = Table.Combine(
				        {
				            #"Leave balance does not exceed 200hrs",
				            #"Hours worked in fortnights < 96hrs [including external hrs]",
				            #"All households have an occupancy agreement",
				            #"Time since last leave < 6 months"
				        }
				    ),
				    #"Added Index" = Table.AddIndexColumn(Source, "Fact KPI Key", 1, 1, Int64.Type),
				    #"Added Conditional Column" = Table.AddColumn(
				        #"Added Index",
				        "ColourOrder",
				        each if [KPI Status] = "Green" then 1 else if [KPI Status] = "Amber" then
				            2
				        else if [KPI Status] = "Red" then
				            3
				        else
				            null
				    ),
				    #"Changed Type" = Table.TransformColumnTypes(#"Added Conditional Column", {{"ColourOrder", Int64.Type}})
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

