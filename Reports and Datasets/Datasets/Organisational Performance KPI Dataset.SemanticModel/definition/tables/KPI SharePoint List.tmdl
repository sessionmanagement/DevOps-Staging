	partition 'KPI SharePoint List' = m
		mode: import
		queryGroup: 'KPI SharePoint List'
		source =
				let
				    // Load data from SharePoint
				    Source = SharePoint.Tables(
				        "https://emergeaotearoaltd.sharepoint.com/sites/OrganisationalPerformance/",
				        [
				            Implementation = "2.0",
				            ViewMode = "All"
				        ]
				    ),
				    // Access specific table by ID
				    SelectedTable = Source{[Id = "e40f82b0-4664-4b93-b9c2-5ed737e450ad"]}[Items],
				    #"Removed Columns" = Table.RemoveColumns(
				        SelectedTable,
				        {
				            "Content Type",
				            "Modified",
				            "Created",
				            "Created By",
				            "Modified By",
				            "Version",
				            "Attachments",
				            "Edit",
				            "Type",
				            "Item Child Count",
				            "Folder Child Count",
				            "Label setting",
				            "Retention label",
				            "Retention label Applied",
				            "Label applied by",
				            "Item is a Record",
				            "App Created By",
				            "App Modified By",
				            "Relevant BU"
				        }
				    ),
				    #"Expanded Related KPI outcome" = Table.ExpandListColumn(#"Removed Columns", "Related KPI outcome"),
				    #"Expanded Related KPI outcome1" = Table.ExpandRecordColumn(
				        #"Expanded Related KPI outcome",
				        "Related KPI outcome",
				        {"lookupId", "lookupValue", "isSecretFieldValue"},
				        {"Related KPI outcome.lookupId", "Related KPI outcome.lookupValue", "Related KPI outcome.isSecretFieldValue"}
				    ),
				    #"Expanded SFA Rollup Areas" = Table.ExpandListColumn(#"Expanded Related KPI outcome1", "SFA Rollup Areas"),
				    #"Expanded SFA Rollup Areas1" = Table.ExpandRecordColumn(
				        #"Expanded SFA Rollup Areas",
				        "SFA Rollup Areas",
				        {"lookupId", "lookupValue", "isSecretFieldValue"},
				        {"SFA Rollup Areas.lookupId", "SFA Rollup Areas.lookupValue", "SFA Rollup Areas.isSecretFieldValue"}
				    ),
				    #"Renamed Columns" = Table.RenameColumns(#"Expanded SFA Rollup Areas1", {{"ID", "Dim KPI Key"}})
				    //#"Filtered Rows" = Table.SelectRows(#"Renamed Columns", each ([#"SFA Rollup Areas: Rollup ID"] = "OK2"))
				in
				    #"Renamed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

