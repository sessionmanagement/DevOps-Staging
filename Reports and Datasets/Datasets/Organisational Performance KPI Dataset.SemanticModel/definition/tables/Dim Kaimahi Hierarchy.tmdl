	column FinalBusinessUnit = ```
			
			IF(
			    NOT(ISBLANK('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 9])),
			    'Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 9],
			    IF(
			        NOT(ISBLANK('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 8])),
			        'Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 8],
			        IF(
			            NOT(ISBLANK('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 7])),
			            'Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 7],
			            IF(
			                NOT(ISBLANK('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 6])),
			                'Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 6],
			                IF(
			                    NOT(ISBLANK('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 5])),
			                    'Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 5],
			                    IF(
			                        NOT(ISBLANK('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 4])),
			                        'Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 4],
			                        IF(
			                            NOT(ISBLANK('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 3])),
			                            'Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 3],
			                            IF(
			                                NOT(ISBLANK('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 2])),
			                                'Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 2],
			                                IF(
			                                    NOT(ISBLANK('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 1])),
			                                    'Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 1],
			                                    BLANK()
			                                )
			                            )
			                        )
			                    )
			                )
			            )
			        )
			    )
			)
			
			```
