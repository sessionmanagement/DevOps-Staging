	measure 'Colour Formatting (Display Measure)' =
			
			VAR _DisplayMeasure = CALCULATE([Display Measure],REMOVEFILTERS('Dim RAG Status'), REMOVEFILTERS('Fact KPI'[KPI Status]))
			//VAR _DisplayMeasure = [Display Measure]
			RETURN
			IF(_DisplayMeasure = "3. Green", "#018DB1",
			IF(_DisplayMeasure = "1. Red", "#f47c20",
			IF(_DisplayMeasure = "2. Amber", "#FFD40B"
			)))
		lineageTag: 4c470a79-03a3-4ec1-af91-1106f781af7c

	measure 'Strategic Focus Area KPI BACKUP - MIKE G ORIGINAL' =
			
			VAR _kpi =
			    DISTINCTCOUNT ( 'Fact KPI'[Fact KPI Key] )
			VAR _countgreen =
			    CALCULATE (
			        COUNTROWS (
			            SUMMARIZECOLUMNS (
			                'Fact KPI'[Fact KPI Key],
			                'Fact KPI'[KPI Value],
			                "Distinct", DISTINCT ( 'Fact KPI'[Fact KPI Key] )
			            )
			        ),
			        'Fact KPI'[KPI Status] = "Green"
			    )
			VAR _countamber =
			    CALCULATE (
			        COUNTROWS (
			            SUMMARIZECOLUMNS (
			                'Fact KPI'[Fact KPI Key],
			                'Fact KPI'[KPI Value],
			                "Distinct", DISTINCT ( 'Fact KPI'[Fact KPI Key] )
			            )
			        ),
			        'Fact KPI'[KPI Status] = "Amber"
			    )
			VAR _countred =
			    CALCULATE (
			        COUNTROWS (
			            SUMMARIZECOLUMNS (
			                'Fact KPI'[Fact KPI Key],
			                'Fact KPI'[KPI Value],
			                "Distinct", DISTINCT ( 'Fact KPI'[Fact KPI Key] )
			            )
			        ),
			        'Fact KPI'[KPI Status] = "Red"
			    )
			VAR _rollupGreenThreshold =
			    CALCULATE (
			        MAXX (
			            SUMMARIZECOLUMNS (
			                'Fact KPI'[Fact KPI Key],
			                'Fact KPI'[Rollup Green Threshold],
			                "Distinct", DISTINCT ( 'Fact KPI'[Fact KPI Key] )
			            ),
			            VALUE ( [Rollup Green Threshold] )
			        )
			    )
			VAR _rollupAmberThreshold =
			    CALCULATE (
			        MAXX (
			            SUMMARIZECOLUMNS (
			                'Fact KPI'[Fact KPI Key],
			                'Fact KPI'[Rollup Amber Threshold],
			                "Distinct", DISTINCT ( 'Fact KPI'[Fact KPI Key] )
			            ),
			            VALUE ( [Rollup Amber Threshold] )
			        )
			    )
			RETURN
			    IF (
			        _kpi > 0,
			        SWITCH (
			            TRUE (),
			            DIVIDE ( _countgreen, _kpi, 0 ) >= _rollupGreenThreshold, "Green",
			            DIVIDE ( _countgreen + _countamber, _kpi, 0 ) > _rollupAmberThreshold
			                && DIVIDE ( _countgreen, _kpi, 0 ) < _rollupGreenThreshold, "Amber",
			            "Red"
			        ),
			        BLANK ()
			    )
