	measure 'Strategic Focus Area KPI' = ```
			
			VAR _kpi =
			    DISTINCTCOUNT ( 'Fact KPI'[Fact KPI Key] )
			VAR _countgreen =
			    CALCULATE (
			        COUNTROWS (
			            SUMMARIZE (
			                'Fact KPI',
			                'Fact KPI'[Fact KPI Key],
			                'Fact KPI'[KPI Value]
			            )
			        ),
			        'Fact KPI'[KPI Status] = "Green"
			    )
			VAR _countamber =
			    CALCULATE (
			        COUNTROWS (
			            SUMMARIZE (
			                'Fact KPI',
			                'Fact KPI'[Fact KPI Key],
			                'Fact KPI'[KPI Value]
			            )
			        ),
			        'Fact KPI'[KPI Status] = "Amber"
			    )
			VAR _countred =
			    CALCULATE (
			        COUNTROWS (
			            SUMMARIZE (
			                'Fact KPI',
			                'Fact KPI'[Fact KPI Key],
			                'Fact KPI'[KPI Value]
			            )
			        ),
			        'Fact KPI'[KPI Status] = "Red"
			    )
			VAR _rollupGreenThreshold =
			    CALCULATE (
			        MAXX (
			            SUMMARIZE (
			                'Fact KPI',
			                'Fact KPI'[Fact KPI Key],
			                "Rollup Green Threshold", MAX('Fact KPI'[Rollup Green Threshold])
			            ),
			            [Rollup Green Threshold]
			        )
			    )
			VAR _rollupAmberThreshold =
			    CALCULATE (
			        MAXX (
			            SUMMARIZE (
			                'Fact KPI',
			                'Fact KPI'[Fact KPI Key],
			                "Rollup Amber Threshold", MAX('Fact KPI'[Rollup Amber Threshold])
			            ),
			            [Rollup Amber Threshold]
			        )
			    )
			RETURN
			    IF (
			        _kpi > 0,
			        SWITCH (
			            TRUE (),
			            DIVIDE ( _countgreen, _kpi, 0 ) >= _rollupGreenThreshold, "3. Green",
			            DIVIDE ( _countgreen + _countamber, _kpi, 0 ) > _rollupAmberThreshold
			                && DIVIDE ( _countgreen, _kpi, 0 ) < _rollupGreenThreshold, "2. Amber",
			            "1. Red"
			        ),
			        "No data"
			        //BLANK ()
			    )
			
			```
		lineageTag: 367d96c4-f18c-4a63-aa6b-7d6a52c0f03e

	measure 'Kaimahi Hierarchy Display Measure' =
			
			SWITCH(
			    TRUE(),
			    ISINSCOPE('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 1]), MAX('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 1]),
			    ISINSCOPE('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 2]), MAX('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 2]),
			    ISINSCOPE('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 3]), MAX('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 3]),
