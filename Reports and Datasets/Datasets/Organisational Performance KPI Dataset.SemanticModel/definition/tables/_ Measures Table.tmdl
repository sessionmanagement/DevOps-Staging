	measure 'Non-Blank Hierarchy' =
			
			VAR Level1 = MAX('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 1])
			VAR Level2 = MAX('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 2])
			VAR Level3 = MAX('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 3])
			VAR Level4 = MAX('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 4])
			VAR Level5 = MAX('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 5])
			VAR Level6 = MAX('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 6])
			VAR Level7 = MAX('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 7])
			RETURN
			    CONCATENATE(
			        CONCATENATE(
			            CONCATENATE(
			                CONCATENATE(
			                    CONCATENATE(
			                        CONCATENATE(
			                            IF(NOT(ISBLANK(Level1)), Level1 & " > ", ""),
			                            IF(NOT(ISBLANK(Level2)), Level2 & " > ", "")
			                        ),
			                        IF(NOT(ISBLANK(Level3)), Level3 & " > ", "")
			                    ),
			                    IF(NOT(ISBLANK(Level4)), Level4 & " > ", "")
			                ),
			                IF(NOT(ISBLANK(Level5)), Level5 & " > ", "")
			            ),
			            IF(NOT(ISBLANK(Level6)), Level6 & " > ", "")
			        ),
			        IF(NOT(ISBLANK(Level7)), Level7, "")
			    )
		lineageTag: 270e1826-2630-4a97-9cdd-d594f0555c78

	measure 'Display Measure' =
			
			VAR Val = [Strategic Focus Area KPI]
			VAR EntityShowRow =
			    [EntityBrowseDepth] <= [EntityRowDepth]
			VAR Result =
			    IF ( EntityShowRow, Val )
			RETURN
			    Result
