			    ISINSCOPE('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 5]), MAX('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 5]),
			    ISINSCOPE('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 6]), MAX('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 6]),
			    ISINSCOPE('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 7]), MAX('Dim Kaimahi Hierarchy'[Kaimahi People Leader Business Unit Name Level 7]),
			    BLANK()
			)
