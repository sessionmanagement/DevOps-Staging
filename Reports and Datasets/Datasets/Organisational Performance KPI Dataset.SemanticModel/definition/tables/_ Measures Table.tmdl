	measure 'Fact KPI Key Percentage Green' = ```
			
			VAR _Green = 
			CALCULATE(
			    DISTINCTCOUNT('Fact KPI'[Fact KPI Key]),
			    ALLSELECTED('Dim Kaimahi'),
			    ALLSELECTED('Dim KPI'),
			    'Fact KPI'[KPI Status] = "Green"
			)
			VAR _Amber = 
			CALCULATE(
			    DISTINCTCOUNT('Fact KPI'[Fact KPI Key]),
			    ALLSELECTED('Dim Kaimahi'),
			    ALLSELECTED('Dim KPI'),
			    'Fact KPI'[KPI Status] = "Amber"
			)
			VAR _Red = 
			CALCULATE(
			    DISTINCTCOUNT('Fact KPI'[Fact KPI Key]),
			    ALLSELECTED('Dim Kaimahi'),
			    ALLSELECTED('Dim KPI'),
			    'Fact KPI'[KPI Status] = "Red"
			)
			RETURN
			DIVIDE(_Green,(_Green+_Amber+_Red))
			```
		formatString: 0%;-0%;0%
		lineageTag: c904303b-f25c-4020-a49c-c86f19a154d1

