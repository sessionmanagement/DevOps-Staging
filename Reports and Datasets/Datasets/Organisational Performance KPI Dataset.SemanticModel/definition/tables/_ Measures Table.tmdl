	measure 'Filters Applied' =
			
			VAR Entity_Service_Name = ADDCOLUMNS(
			    TOPN(10, FILTER(VALUES('Entity'[Service Name]), NOT(ISBLANK('Entity'[Service Name]))), 'Entity'[Service Name], ASC),
			    "Service Name_display", 'Entity'[Service Name]
			)
			VAR Entity_Service_NameCount = IF(ISFILTERED('Entity'[Service Name]), COUNTROWS(VALUES('Entity'[Service Name])), 0)
			VAR More_Entity_Service_Name = IF(Entity_Service_NameCount > 10, " and " & (Entity_Service_NameCount - 10) & " more", "")
			VAR FC_Entity_Service_Name = IF(Entity_Service_NameCount > 0, "SERVICES CHOSEN: " & CONCATENATEX(Entity_Service_Name, [Service Name_display], ", "), BLANK()) & More_Entity_Service_Name
			
			RETURN
			IF(
			    (ISBLANK(FC_Entity_Service_Name) || FC_Entity_Service_Name = ""),
			    "No filters are currently applied to this page.",
			    "Please note that the following filters are currently applied to this page: " &
			    CONCATENATEX(FILTER({ FC_Entity_Service_Name }, [Value] <> BLANK()), [Value], " | ")
			)
		lineageTag: 4ca52c30-ed4c-4969-9418-0e6a57250844

	partition '_ Measures Table' = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

