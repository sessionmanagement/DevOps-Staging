	column ServiceKeyForRLS =
			
			VAR EntityKeyTrimmed = IF(LEN(Entity[EntityKey]) > 2, MID(Entity[EntityKey], 3, LEN(Entity[EntityKey]) - 2), Entity[EntityKey])
			VAR ParentEntityKeyTrimmed = IF(LEN(Entity[ParentEntityKey]) > 2, MID(Entity[ParentEntityKey], 3, LEN(Entity[ParentEntityKey]) - 2), Entity[ParentEntityKey])
			
			RETURN
			IFERROR(
			    IF(
			        Entity[Type] = "Business Unit" || Entity[ParentEntityKey] = "EAHT",
			        VALUE(EntityKeyTrimmed),
			        VALUE(ParentEntityKeyTrimmed)
			    ),
			    BLANK()
			)
		dataType: double
		lineageTag: a916482d-6778-42f9-b488-b097d0d10d6a
		summarizeBy: none
		isDataTypeInferred

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

