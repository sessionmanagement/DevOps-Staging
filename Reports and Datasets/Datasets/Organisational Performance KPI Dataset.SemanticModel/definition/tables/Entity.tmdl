	partition Entity = m
		mode: import
		queryGroup: 'EDW Dim Tables'
		source = ```
				let
				    Source = Load_Entity_Data,
				    #"Filtered Rows" = Table.SelectRows(Source, each ([EntityKey] <> null)),
				    
				    // Step 3: Create a list of all EntityKey values
				    EntityKeys = #"Filtered Rows"[EntityKey],
				    
				    // Step 4: Filter rows where ParentEntityKey is null OR exists in EntityKeys
				    #"Filtered ParentEntityKey" = Table.SelectRows(
				        #"Filtered Rows", 
				        each ([ParentEntityKey] = null) or List.Contains(EntityKeys, [ParentEntityKey])
				    )
				in
				    #"Filtered ParentEntityKey"
				```

