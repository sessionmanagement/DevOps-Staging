  <DataSets>
    <DataSet Name="ClientsNotSeenLastWeek">
      <Query>
        <DataSourceName>RB_EAL_Elite</DataSourceName>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT *
FROM (
	SELECT t.TeamID,
		t.TeamName,
		t.TeamEndDate,
		t.CompanyID,
		p.PersonID,
		p.PersonFirstName + ' ' + p.PersonLastName ClientName,
		p.PersonPreferredName,
		p.PersonDateOfBirth,
		r.ReferralID,
		r.ReferralEndDate,
		r.ReferralReferralType
		-- bring back a CaseWorker for the Client
		,
		(
			SELECT TOP 1 du.UserFirstName + ' ' + du.UserLastName
			FROM RBEAL.dlFactPersonRelationship pr --- find (top 1) case workers for a client
			INNER JOIN RBEAL.dlDimRelationshipType rt ON pr.RelationshipTypeID = rt.RelationshipTypeID
			INNER JOIN RBEAL.dlDimUser du ON pr.UserID = du.UserID
			WHERE pr.PersonID = p.PersonID
				-- for the Client who is in the outer query
				AND pr.PersonRelationshipEndDate IS NULL
				AND pr.PersonID IN -- give me only the Active Referrals
				(
					SELECT r.PersonID
					FROM RBEAL.dlFactReferral r
					WHERE r.ReferralEndDate IS NULL
						AND r.ReferralReferralType = 'InboundReferral'
					) -- list of active Referrals
				AND rt.RelationshipTypeText IN -- give me only following Staff Client Relationships
				(
					'Support Worker',
					'Keyworker',
					'Health Professional',
					'Peer Support Worker'
					--'Navigator'
					--'Senior Navigator'
					,
					'Employment Consultant'
					)
			) AS CaseWorker,
		(
			-- pick the MAX date of FactActivity
			--=====changed to make the maximum activity date related to a specific referral.  Piyush's original code did not make it referral specific.
			SELECT maxactivitystartdate
			--Above selected the maximum activity date but below I've put in a joins on referral id as well as person id.
			FROM (
				--take the maximum activity date per referral per person.
				--==created a temporary piece called data1
				SELECT MAX(a1.ActivityStartDate) AS maxActivityStartDate,
					fr.referralid,
					pc1.entityid
				FROM RBEAL.dlFactActivity AS a1
				INNER JOIN RBEAL.dlFactActivityParticipant AS pC1 ON a1.ActivityID = pC1.ActivityID
				INNER JOIN RBEAL.dlDimActivityType AS dat1 ON a1.ActivityTypeID = dat1.ActivityTypeID
				INNER JOIN RBEAL.dlFactActivityBreakdown AS fAb1 ON a1.ActivityID = fAb1.ActivityID
				INNER JOIN RBEAL.dlDimActivityBreakdownType AS bT1 ON fAb1.ActivityBreakdownTypeID = bT1.ActivityBreakdownTypeID
				INNER JOIN RBEAL.dlfactreferral AS fr ON pC1.EntityID = fr.personid
					AND activitystartdate BETWEEN referralcreateddate
						AND isnull(fr.ReferralEndDate, '2099-12-31')
				WHERE dat1.ActivityTypeName = 'Face-to-face'
					AND bT1.ActivityBreakdownTypeName NOT IN ('Other contact (non face to face)')
					AND bT1.ActivityBreakdownTypeParentID = 10108 -- This relates to the DHB Non-contact
				GROUP BY fr.referralid,
					pc1.entityid
				) AS data1
			--===adding the join here based on personid and referralid 
			WHERE p.personid = data1.entityid
				AND r.referralid = data1.referralid
			) AS LastSeenDate
	FROM RBEAL.dlDimTeam AS t
	INNER JOIN RBEAL.dlFactReferral AS r ON t.TeamID = r.TeamID
	INNER JOIN RBEAL.dlDimPerson AS p ON r.PersonID = p.PersonID
	INNER JOIN RBEAL.dlDimReferralStatusType AS st ON r.CurrentReferralStatusTypeID = st.ReferralStatusTypeID
	INNER JOIN RBEAL.dlDimTeamFunction f ON f.TeamFunctionID = t.TeamFunctionID
	WHERE t.CompanyID = 3
		AND t.TeamEndDate IS NULL
		AND r.ReferralEndDate IS NULL
		AND r.ReferralReferralType = 'InboundReferral'
		AND st.ReferralStatusTypeCode = 'Accepted'
		AND f.TeamFunctionCode &lt;&gt; 'HS'
		AND p.PersonID NOT IN -- not in the list of Clients seen in the last 8 days
		(
			SELECT pC.EntityID
			FROM RBEAL.dlFactActivity AS a
			INNER JOIN RBEAL.dlFactActivityParticipant AS pC ON a.ActivityID = pC.ActivityID
			INNER JOIN RBEAL.dlDimActivityType AS dat ON a.ActivityTypeID = dat.ActivityTypeID
			INNER JOIN RBEAL.dlFactActivityBreakdown AS fAb ON a.ActivityID = fAb.ActivityID
			INNER JOIN RBEAL.dlDimActivityBreakdownType AS bT ON fAb.ActivityBreakdownTypeID = bT.ActivityBreakdownTypeID
			INNER JOIN RBEAL.dlDimPerson AS dP ON pC.EntityID = dP.PersonID
			INNER JOIN RBEAL.dlDimTeam AS dT ON a.TeamID = dT.TeamID
			INNER JOIN RBEAL.dlFactReferral AS fR ON pC.ReferralID = fR.ReferralID
			INNER JOIN RBEAL.dlDimReferralStatusType AS stInr ON fR.CurrentReferralStatusTypeID = stInr.ReferralStatusTypeID
			WHERE a.ActivityStartDate &gt; GETDATE() - 8
				AND pc.ActivityParticipantEntityType = 'Person'
				AND dat.ActivityTypeName = 'Face-to-face'
				AND bT.ActivityBreakdownTypeName NOT IN ('Other contact (non face to face)')
				AND bT.ActivityBreakdownTypeParentID = 10108 -- This relates to the DHB Non-contact
				AND stInr.ReferralStatusTypeCode = 'Accepted'
				AND fR.ReferralEndDate IS NOT NULL --only using open referrals
			)
	) AS data
WHERE lastseendate IS NULL
	OR datediff(day, lastseendate, getdate()) &gt; 8</CommandText>
      </Query>
      <Fields>
        <Field Name="TeamID">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>TeamID</DataField>
        </Field>
        <Field Name="TeamName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>TeamName</DataField>
        </Field>
        <Field Name="TeamEndDate">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>TeamEndDate</DataField>
        </Field>
        <Field Name="CompanyID">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>CompanyID</DataField>
        </Field>
        <Field Name="PersonID">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>PersonID</DataField>
        </Field>
        <Field Name="ClientName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ClientName</DataField>
        </Field>
        <Field Name="PersonPreferredName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>PersonPreferredName</DataField>
        </Field>
        <Field Name="PersonDateOfBirth">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>PersonDateOfBirth</DataField>
        </Field>
        <Field Name="ReferralID">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>ReferralID</DataField>
        </Field>
        <Field Name="ReferralEndDate">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>ReferralEndDate</DataField>
        </Field>
        <Field Name="ReferralReferralType">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ReferralReferralType</DataField>
        </Field>
        <Field Name="CaseWorker">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CaseWorker</DataField>
        </Field>
        <Field Name="LastSeenDate">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>LastSeenDate</DataField>
        </Field>
        <Field Name="DaysSinceLastSeen">
          <Value>=
   Iif(
        IsNothing( Fields!LastSeenDate.Value ) , 
        "Never Seen",

        DateDiff(
                "d",
                Fields!LastSeenDate.Value,
                Today()
               )

        )</Value>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="F2FActivities">
      <Query>
        <DataSourceName>RB_EAL_Elite</DataSourceName>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT a.ActivityStartDate,
	dat.ActivityTypeCode,
	dat.ActivityTypeName,
	dP.PersonID,
	dP.PersonFirstName + ' ' + dP.PersonLastName PersonName,
	dP.PersonPreferredName,
	bT.ActivityBreakdownTypeCode,
	bT.ActivityBreakdownTypeName,
	dT.TeamName
FROM RBEAL.dlFactActivity AS a
INNER JOIN RBEAL.dlFactActivityParticipant AS pC ON a.ActivityID = pC.ActivityID
INNER JOIN RBEAL.dlDimActivityType AS dat ON a.ActivityTypeID = dat.ActivityTypeID
INNER JOIN RBEAL.dlFactActivityBreakdown AS fAb ON a.ActivityID = fAb.ActivityID
INNER JOIN RBEAL.dlDimActivityBreakdownType AS bT ON fAb.ActivityBreakdownTypeID = bT.ActivityBreakdownTypeID
INNER JOIN RBEAL.dlDimPerson AS dP ON pC.EntityID = dP.PersonID
INNER JOIN RBEAL.dlDimTeam AS dT ON a.TeamID = dT.TeamID
INNER JOIN RBEAL.dlFactReferral AS fR ON pC.ReferralID = fR.ReferralID
INNER JOIN RBEAL.dlDimReferralStatusType AS st ON fR.CurrentReferralStatusTypeID = st.ReferralStatusTypeID
WHERE a.ActivityStartDate &gt; GETDATE() - 8
	AND pc.ActivityParticipantEntityType = 'Person'
	AND dat.ActivityTypeName = 'Face-to-face'
	AND bT.ActivityBreakdownTypeName NOT IN ('Other contact (non face to face)')
	AND bT.ActivityBreakdownTypeParentID = 10108 -- This relates to the NHB Non-contact
	AND st.ReferralStatusTypeCode = 'Accepted'</CommandText>
      </Query>
      <Fields>
        <Field Name="ActivityStartDate">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>ActivityStartDate</DataField>
        </Field>
        <Field Name="ActivityTypeCode">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ActivityTypeCode</DataField>
        </Field>
        <Field Name="ActivityTypeName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ActivityTypeName</DataField>
        </Field>
        <Field Name="PersonID">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>PersonID</DataField>
        </Field>
        <Field Name="PersonName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>PersonName</DataField>
        </Field>
        <Field Name="PersonPreferredName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>PersonPreferredName</DataField>
        </Field>
        <Field Name="ActivityBreakdownTypeCode">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ActivityBreakdownTypeCode</DataField>
        </Field>
        <Field Name="ActivityBreakdownTypeName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>ActivityBreakdownTypeName</DataField>
        </Field>
        <Field Name="TeamName">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>TeamName</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
