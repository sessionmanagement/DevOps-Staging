  <DataSources>
    <DataSource Name="RB_EAL_Elite">
      <rd:SecurityType>DataBase</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQLAZURE</DataProvider>
        <ConnectString>Data Source=synapseausprod-ondemand.sql.azuresynapse.net;Initial Catalog=ODS;Authentication=ActiveDirectoryInteractive</ConnectString>
        <Prompt>Specify a user name and password for data source RB_EAL_Elite:</Prompt>
