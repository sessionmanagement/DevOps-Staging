"&lt;br&gt;" +

"Department: " + "&lt;b&gt;" + IIf(Parameters!DimServiceDepartmentName.Count &gt; 4, "more than 4 values selected", Join(Parameters!DimServiceDepartmentName.Value, " ,"))  + "&lt;/b&gt;"+

