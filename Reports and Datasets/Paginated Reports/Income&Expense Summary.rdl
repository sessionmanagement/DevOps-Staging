  <Code>Public Function SortJoin(ByVal items As Object(), ByVal delimiter As String) As String
    If items Is Nothing OrElse items.Length = 0 Then Return ""
    Dim arr As String() = New String(items.Length - 1) {}
    For i As Integer = 0 To items.Length - 1
        arr(i) = CStr(items(i))
    Next
    System.Array.Sort(arr)
    Return String.Join(delimiter, arr)
End Function

Public Function LastSorted(ByVal items As Object()) As String
    If items Is Nothing OrElse items.Length = 0 Then Return ""
    Dim arr As String() = New String(items.Length - 1) {}
    For i As Integer = 0 To items.Length - 1
        arr(i) = CStr(items(i))
    Next
    System.Array.Sort(arr)
    Return arr(arr.Length - 1)
End Function</Code>
