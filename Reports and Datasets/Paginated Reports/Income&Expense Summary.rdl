                    <Value>=  "Other filters selected: " + 
 "&lt;br&gt;" +
"Financial Year: " + "&lt;b&gt;" +
 Join(Parameters!DimDateFinancialYearDesc.Value, " ,")  + "&lt;/b&gt;"
+
 "&lt;br&gt;" +

"Months: " + "&lt;b&gt;" + Code.SortJoin(Parameters!DimDateCalendarYearMonth.Value, " ,")  + "&lt;/b&gt;" +

